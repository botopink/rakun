// A spread on an element takes its props record (decision 351); the attribute pairs left.
import {html, isRaw} from "rakun-bpp";
import {Element, Node, div, p, span, article, form, button} from "rakun-bpp";

pub fn Page(pairs: Array<#(string, string)>) -> Element {
    return html @`<form {...pairs}></form>`;
}
