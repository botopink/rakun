// A template is a component (decision 117): a `Async<Element>` return (a
// server component that only loads data) is refused, located at the annotation.
import {template, jhTemplate, LayoutProps, Element, div} from "rakun-bpp";

#[template("")]
pub async fn Shell(props: LayoutProps) -> Async<Element> {
    return div([props.children], attrs: []);
}
