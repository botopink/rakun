// `<style>` in markup is refused — a component's style is its `.bpp` file's
// `--- style ---` section, or `use styled """…""";` in its body (decision 338).
import {html} from "jhonstart-html";
import {Element, div, style} from "jhonstart";

pub fn Page() -> Element {
    return html "<div><style>h1 { color: red; }</style></div>";
}
