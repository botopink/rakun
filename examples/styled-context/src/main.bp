// Front 119 step 1: a `styled` component computed at render registers its
// class and rules in the sheet the render provides through `StyledContext`
// (decisions 352, 354). `Page` is the render's root: it provides a sheet whose
// writer prints what it is handed, so each registration is a line. A `${p}`
// splice registers nothing, a literal computed at build registers nothing, a
// property standing on its own registers itself. Run on erlang and commonJS by
// the repository stage; `styled-context-unbound` is the same literal with no
// provider above it.

import styled, {styledProperty, StyledView, StyledPropertyView, StyledContext, StyledSheet, Styled} from "styled";
import {context.provide} from "std";

fn padAll(n: i32) -> StyledPropertyView {
    return styledProperty "padding: --spacing(${n});";
}

// A parameter in a value hole: computed at render.
fn badge(c: string) -> StyledView {
    return styled "color: ${c}; ${padAll(2)}";
}

pub val tab4 = styledProperty "tab-size: 4;";

// Every hole known at build: computed at build (decision 355).
fn tabbed() -> StyledView {
    return styled "${tab4} color: red;";
}

fn write(layer: string, item: Styled) -> void {
    @println("registered " + layer + " " + item.rules);
}

fn Page() -> @Component<Styled> {
    use provide(StyledContext, StyledSheet(layer: "components", add: write));
    val first = badge("red");
    val again = badge("red");
    val other = badge("blue");
    val constant = tabbed();
    val alone = padAll(4);
    @println(
        "classes "
            + first.className
            + " "
            + again.className
            + " "
            + other.className
            + " "
            + constant.className
            + " "
            + alone.className,
    );
    return first;
}

pub fn main() -> @Task<void> {
    val page = await Page();
    @println("page " + page.className);
}
