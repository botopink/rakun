// Front 119 step 1: a `styled` component computed at render reads the sheet
// with `use context(StyledContext)` (decisions 352, 354); rendered with no
// provider above it, it is `context-unbound` at run time, naming the
// context. What prints before it stands. The repository stage runs it on
// erlang and commonJS and reads the abort.

import styled, {StyledView} from "styled";

fn badge(c: string) -> StyledView {
    return styled "color: ${c};";
}

pub fn main() -> @Task<void> {
    @println("before");
    val b = await badge("red");
    @println(b.className);
}
