// islands/page — one like island per post, numbered in render order, and the
// root layout that puts the whole server tree inside the theme provider's
// slot. Front 30's render assigns the ordinals in a real render
// (`mountIsland`); outside one the page takes the first ordinal it numbers
// from, so the provider can be `i0` and the posts after it.

import {Element, ul, li, h2, text, clientMount, serverSlot} from "rakun-bpp";
import {like_button.LikeProps, like_button.likeIsland};
import {theme.themeIsland};

pub type Post(id: string, title: string, likes: i32)

fn postRow(post: Post, ordinal: i32) -> Element {
    val island = likeIsland("i"
        + ordinal.toString(), LikeProps(postId: post.id, likes: post.likes));
    return li([h2([text(post.title)]), clientMount(island, [])]);
}

// The list with its islands numbered from `first`.
pub fn PostListFrom(posts: array<Post>, first: i32) -> Element {
    var rows: array<Element> = [];
    var ordinal = first;
    for (posts) { post ->
        rows = rows.append([postRow(post, ordinal)]);
        ordinal = ordinal + 1;
    }
    return ul(rows, attrs: [#("class", "posts")]);
}

pub fn PostList(posts: array<Post>) -> Element {
    return PostListFrom(posts, 0);
}

// The provider is `i0`; `page` is the server tree, in its slot.
pub fn RootLayout(theme: string, page: Element) -> Element {
    return clientMount(themeIsland("i0", theme), [serverSlot([page])]);
}
