// islands/like_button — a client component (front 29): `#[client]` marks it,
// `#[clientProps]` checks the record its props travel in, and the server
// render contributes only the placeholder and the payload `i` row.

import {Element, Island, button, text, client, clientProps} from "rakun-bpp";

#[clientProps]
pub type LikeProps(postId: string, likes: i32)

// What the browser paints inside the island once it starts.
#[client]
pub fn LikeButton(props: LikeProps) -> Element {
    return button([text("♥ "
        + props.likes.toString())], attrs: [#("class", "like"), #("data-post", props.postId)]);
}

// The island for one post: its id, the component, the props encoded.
pub fn likeIsland(id: string, props: LikeProps) -> Island {
    return Island(id: id, component: "LikeButton", props: [#("postId", props.postId), #("likes", props.likes.toString())]);
}
