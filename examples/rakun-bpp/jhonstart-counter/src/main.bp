// jhonstart-counter — the React-core showcase, as a pure SSR client.
//
// `counterView` is a PURE view: given a count it builds the markup, so it renders
// synchronously with `renderToString` and is directly testable. `Counter` is the
// stateful, idiomatic form — a `fn … -> Component<Element>` component whose
// body activates `state` with `use` (decisions 88, 118 and 128 of 1.0.10-beta — the
// return is the effect). `use state(0)`
// lowers to `state(0)` on every backend: called here it is the server pass (the
// initial cell); in the browser the client build resolves `rakun-bpp/hooks` to
// `rakun-bpp/client_runtime`, whose `state` re-renders on `set` (see rakun-bpp's
// `client_runtime.bp`). Interactivity (buttons / event handlers) is host-bound
// and lives outside this pure core.

import {Element, ElementBase, div, p, span, text, state, renderToString} from "rakun-bpp";
import {io.terminal.print, context.run} from "std";

// Pure view: the counter markup for a given count.
fn counterView(count: i32) -> Element {
    val sign = if (count >= 0) "non-negative" else "negative";
    return div([
        p([text("count: " + count.toString(), [])], []),
        span([text(sign, [])], []),
    ], []);
}

// Stateful component (idiomatic hooks): the `Component<Element>`
// return lets the body activate a hook; every `use` sits in the static prefix. Rendered below as the server pass.
pub component fn Counter() -> Component<Element> {
    val c = use state(0);
    return counterView(c.value);
}

// A second stateful component: a hook is a component, so it is resolved with
// `use` inside a component body — never awaited (decision 791 (4)); a root
// outside every body runs it with std's `run` (822). Its value is the
// first-render value.
component fn StatefulBadge() -> Component<Element> {
    val c = use state(7);
    val doubled = c.value + c.value;
    return div([
        p([text("count: " + c.value.toString(), [])], []),
        span([text("x2=" + doubled.toString(), [])], []),
    ], []);
}

fn main() -> void {
    print(renderToString(counterView(0)));
}

test "the counter view renders its count and sign" {
    assert renderToString(counterView(0))
        == "<div><p>count: 0</p><span>non-negative</span></div>";
    assert renderToString(counterView(-2))
        == "<div><p>count: -2</p><span>negative</span></div>";
}

test "the state hook seeds the initial count and exposes a setter" {
    val c = await run(state(0));
    assert c.value == 0;
    c.set(5);
}

test "renderToString of a component consuming a hook produces the SSR string" {
    assert renderToString(await run(StatefulBadge()))
        == "<div><p>count: 7</p><span>x2=14</span></div>";
}

test "a @Component component activating `use state` renders the server pass" {
    assert renderToString(await run(Counter()))
        == "<div><p>count: 0</p><span>non-negative</span></div>";
}

// LIMITATION (recorded, not a forced test): a builder called with a LONE child
// (`div(text("x"))`) or a BARE string (`div("x")`) type-checks via the `Children`
// coercion (G4) but does NOT render — `renderToString` walks `children` as an
// array (`for (e.children)`), and a single Element / string is not iterable, so
// rendering throws `e.children is not iterable`. Normalizing a lone child / bare
// string to a one-element list needs a runtime type tag the value doesn't carry
// (there is nothing to branch single-vs-list on). Closing it is a renderer/
// normalization-intrinsic change outside this test-audit's scope; the list form
// (`div([…])`) is the rendering contract and is covered throughout.
