// blog-ssr/app/blog/slug/metadata — the page's metadata, generated from the
// post (front 32's `generateMetadata`), merged onto the root layout's.

import {Metadata, OpenGraph, TwitterCard, Icons} from "rakun-bpp";
import {repo.Post, repo.loadPost};

fn slugOf(params: array<#(string, string)>) -> string {
    val hit = params.filter({ kv -> kv._0 == "slug" });
    return (hit.at(0) ?? #("", ""))._1;
}

pub async fn generateMetadata(params: array<#(string, string)>, parent: Metadata) -> Async<Metadata> {
    val slug = slugOf(params);
    val found = await loadPost(slug);
    val post = case found {
        Ok(p) -> p;
        Error(m) -> Post(id: "", slug: slug, title: "", body: "");
    };
    return Metadata(
        title: post.title,
        titleTemplate: "",
        description: post.body,
        openGraph: OpenGraph(title: post.title, description: "", url: "https://blog.botopink.dev/blog/"
            + slug, ogType: "article", siteName: "", images: ["/og/"
            + slug
            + ".png"]),
        twitter: TwitterCard(card: "", title: "", description: "", images: []),
        icons: Icons(icon: "", apple: ""),
    );
}
