// blog-ssr/repo — pure fixtures standing in for a data layer: one post with two
// comments, a slug with no post, and a post whose comment service is down.

pub type Post(id: string, slug: string, title: string, body: string)

pub type Comment(author: string, text: string)

pub fn findPost(slug: string) -> Result<Post, string> {
    if (slug == "hello")
        return Post(id: "p-hello", slug: "hello", title: "Hello", body: "The first post, with a <tag> in it.");
    if (slug == "broken-comments")
        return Post(id: "p-broken", slug: "broken-comments", title: "Broken", body: "Its comments cannot load.");
    throw "no post " + slug;
}

pub fn findComments(postId: string) -> Result<array<Comment>, string> {
    if (postId == "p-broken") throw "comment service down";
    val comments: array<Comment> = [Comment(author: "ana", text: "welcome"), Comment(author: "bob", text: "<3")];
    return comments;
}

// The two loaders a page awaits in sequence: the post, then its comments.
pub async fn loadPost(slug: string) -> Async<Result<Post, string>> {
    return findPost(slug);
}

pub async fn loadComments(postId: string) -> Async<Result<array<Comment>, string>> {
    return findComments(postId);
}
