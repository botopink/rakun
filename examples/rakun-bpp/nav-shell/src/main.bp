// nav-shell — prints the sidebar for one route.

pub mod sidebar;
pub mod index;
pub mod checkout;

import {RouterState, renderToString} from "rakun-bpp";
import {sidebar.Sidebar};
import {io.terminal.print} from "std";

fn main() -> void {
    val r = RouterState(path: "/docs/guides/intro", params: [], search: [], pattern: "/docs/guides/[page]", selected: 1);
    print(renderToString(Sidebar(r)));
}
