// nav-shell/checkout — a link that shows its own navigation in flight (front
// 27's `LinkStatus`): busy only while the pending navigation is to its href.

import {Element, span, text} from "rakun-bpp";
import {Link, linkProps, withClass, LinkStatus} from "rakun-bpp";

pub fn CheckoutLink(status: LinkStatus) -> Element {
    val busy = status.pending && status.href == "/checkout";
    if (busy)
        return Link(withClass(linkProps("/checkout"), "cta busy"), [span([], attrs: [#("class", "spinner")]), text("Checking out…")]);
    return Link(withClass(linkProps("/checkout"), "cta"), [text("Checkout")]);
}
