// document-shell/main — a module that declares `fn main()` builds its `<main>`
// with `el("main", …)`: the `main` constructor would collide with the entry
// point, and a package import alias is parsed and then ignored.

pub mod shell;
pub mod shell_dsl;

import {Element, el, p, text, renderToString} from "rakun-bpp";
import {shell.documentShell, shell.doctype};
import {io.terminal.print} from "std";

fn page() -> Element {
    return el("main", [p([text("entry")])], []);
}

fn main() -> void {
    print(doctype()
        + renderToString(documentShell("en", "botopink", "/app.css", page())));
}
