// document-shell — `test-snap-examples.md` § `examples/document-shell/`.

import {Element, text, p, main, h2, el, renderToString} from "rakun-bpp";
import {shell.documentShell, shell.doctype};
import {shell_dsl.documentBody};
import {assertHtml, assertHtmlLines} from "rakun-bpp";
import {assertText} from "snap";
import {compiler} from "std";

test "shell: constructors ---- head before body" {
    val content = main([h2([text("Welcome")])]);
    try assertHtmlLines(comptime compiler.src(), documentShell("en", "botopink", "/app.css", content));
}

test "shell: the doctype is a string prefix, not an element" {
    val content = main([]);
    try assertText(comptime compiler.src(), doctype()
        + renderToString(documentShell("en", "x", "/a.css", content)));
}

test "shell: the dsl body equals the constructor body" {
    val fromDsl = renderToString(documentBody("Welcome"));
    val fromCtor = renderToString(main([h2([text("Welcome")])], attrs: [#("class", "page")]));
    try assertText(comptime compiler.src(), fromDsl + "\n" + fromCtor);
}

test "shell: the main caveat ---- el keeps a module that declares main" {
    val tree = el("main", [p([text("entry")])], []);
    try assertHtml(comptime compiler.src(), tree);
}
