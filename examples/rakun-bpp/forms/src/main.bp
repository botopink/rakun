// forms — prints the empty create-post form and the search form.

pub mod create_post;
pub mod like;
pub mod search;

import {renderToString} from "rakun-bpp";
import {formAction} from "rakun-bpp";
import {state.newActionState} from "actions";
import {create_post.createPostForm};
import {search.SearchForm};
import {io.terminal.print} from "std";

fn main() -> void {
    print(renderToString(createPostForm(formAction("a_9f31c0d7a4b2e5081c6fa3d2", "/blog/new", "__bp_action"), newActionState(""), false)));
