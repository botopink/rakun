// forms/create_post — a form bound to a server action (front 67, contract 3):
// the binding's attributes and hidden field, and the returned state's field
// message beside its field, re-rendered in place.

import {Element, ElementBase, label, input, button, p, text} from "rakun-bpp";
import {FormBinding, actionForm, actionState} from "rakun-bpp";
import {state.ActionState, state.newActionState} from "actions";

fn field(name: string, caption: string, state: ActionState) -> Array<Element> {
    var out: Array<Element> = [
        label([text(caption)], attrs: [#("for", name)]),
        input([], attrs: [#("id", name), #("name", name), #("required", "required")]),
    ];
    val message = state.fieldError(name);
    if (message != "")
        out.push(p([text(message)], attrs: [#("class", "field-error")]));
    return out;
}

fn submit(pending: bool) -> Element {
    if (pending)
        return button([text("Creating…")], attrs: [#("type", "submit"), #("disabled", "disabled")]);
    return button([text("Create post")], attrs: [#("type", "submit")]);
}

// The form for one state: the title and content fields, each with its
// message, and the submit — disabled and renamed while `pending`.
pub fn createPostForm(binding: FormBinding, state: ActionState, pending: bool) -> Element {
    val fields = field("title", "Title", state)
        .append(field("content", "Content", state))
        .append([submit(pending)]);
    return actionForm(binding, fields);
}

// The component: the state, the binding and the pending flag from the hook.
pub fn CreatePostForm(actionId: string) -> Component<Element> {
    val s = use actionState(actionId, newActionState(""));
    return createPostForm(s._1, s._0, s._2);
}
