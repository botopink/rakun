// forms/like — an optimistic like: the count shown is the fold of the pending
// actions over the server's count, and the nested button reads its own
// form's status.

import {Element, ElementBase, span, button, text} from "rakun-bpp";
import {FormBinding, FormStatus, actionForm, formAction, formStatusOf, optimistic} from "rakun-bpp";

pub fn addLike(count: i32, action: i32) -> i32 {
    return count + action;
}

fn likeButton(status: FormStatus) -> Element {
    if (status.pending)
        return button([text("♥")], attrs: [#("type", "submit"), #("disabled", "disabled")]);
    return button([text("♥")], attrs: [#("type", "submit")]);
}

pub fn likeWidget(binding: FormBinding, shown: i32, status: FormStatus) -> Element {
    return actionForm(binding, [span([text(shown.toString())], attrs: [#("class", "count")]), likeButton(status)]);
}

pub component fn LikeWidget(actionId: string, pathname: string, serverCount: i32) -> Component<Element> {
    val o = use optimistic(serverCount, { c, a -> addLike(c, a) });
    return likeWidget(formAction(actionId, pathname, "__bp_action"), o._0, formStatusOf(actionId));
}
