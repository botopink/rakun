// emilia-effects — `§ 12`, and the one place emilia shipped CSS a browser
// throws away.
//
// `.Effect.Shadow.Md` used to emit `box-shadow:md`. That is the TAILWIND CLASS
// SUFFIX in the position a CSS value belongs; every browser discards the whole
// declaration, so a card that asked for a shadow rendered flat and the only
// test that touched the token pinned the wrong string. Four leaves, four wrong
// values, and nothing in the suite said so. The leaf NAMES did not move in
// front 41 — every call site still type-checks — and what they emit is the fix.
//
// Beyond those four, most of `§ 12` had no token at all: no inset shadow, no
// text-shadow, ten of the fifteen opacity steps, neither blend-mode family and
// nothing from the mask family. A developer who wanted a translucent overlay,
// a dimmed photo caption or a fade-to-transparent image edge had to leave
// emilia and hand-write a stylesheet, which defeats the point of the library.
//
// THREE THINGS THIS FILE IS HERE TO SHOW, beyond the catalogue:
//
//   - the shadow scale is a THEME REFERENCE. `--tw-shadow:var(--shadow-md)` and
//     never the literal behind it, so a project that redefines `--shadow-md`
//     moves every card in the application and not one byte of any rule body.
//   - `inset` is part of the VALUE, on the `box-shadow` property. There is no
//     inset-shadow longhand in CSS; an inset shadow is `box-shadow: inset …`.
//   - an arbitrary value is a TOP-LEVEL variant with a payload, reached through
//     `rawShadow(…)`. A payload leaf nested inside an enum section cannot be
//     constructed by any spelling, so `Effect.Shadow.Raw("…")` does not exist.
//
// THIS FILE IS A CONSUMER PACKAGE, not a test inside the library: a consumer
// re-emits its own copy of the enum classes, so a `case` that crossed the
// package boundary used to fall through every arm (§ Maintainer rules).
// Asserting the full class bodies from outside is what catches that.
//
// Upstream: https://tailwindcss.com/docs/box-shadow · /text-shadow · /opacity ·
// /mix-blend-mode · /background-blend-mode · /mask-image

import {emilia, emiliaWith, flushWith, Token} from "emilia";
import {rawShadow, rawTextShadow, rawMaskImage} from "emilia";
import {Theme, ThemeEntry, DarkMode, defaultTheme, extendTheme} from "emilia";
import {Rule, Block, Sheet, Options} from "emilia";
import {defaultOptions, withTheme, emptyTheme} from "emilia";

// A document with no theme in it, so the assertions below read as the rules
// this example registered rather than as the stock theme's hundred variables.
fn bareOptions() -> Options {
    return withTheme(defaultOptions(), emptyTheme());
}

// ── the box-shadow scale, which is the defect ────────────────────────────────

// THE FOUR LEAVES THAT SHIPPED WRONG, in the spelling they have always had.
pub fn theFourThatShippedWrong() -> string {
    val tokens: Token[] = [
        .Effect.Shadow.Sm,
        .Effect.Shadow.Md,
        .Effect.Shadow.Lg,
        .Effect.Shadow.Xl,
    ];
    return emilia(tokens);
}

// The three steps the scale did not have, plus the two that are not scale
// steps at all. `None` is a keyword; `Inner` is the one literal in the whole
// front, because upstream has no `--shadow-inner` variable and `§ 12.1` prints
// its value inline.
pub fn theRestOfTheScale() -> string {
    val tokens: Token[] = [.Effect.Shadow.X2xs, .Effect.Shadow.Xs, .Effect.Shadow.X2xl];
    return emilia(tokens);
}

pub fn noShadow() -> string {
    val tokens: Token[] = [.Effect.Shadow.None];
    return emilia(tokens);
}

pub fn innerShadow() -> string {
    val tokens: Token[] = [.Effect.Shadow.Inner];
    return emilia(tokens);
}

// AN INSET SHADOW IS `box-shadow`, NOT A LONGHAND. The property is the same
// one the scale above sets; `inset` leads the value.
pub fn insetShadows() -> string {
    val tokens: Token[] = [.Effect.InsetShadow.Sm];
    return emilia(tokens);
}

// ── text-shadow ──────────────────────────────────────────────────────────────

pub fn textShadow() -> string {
    val tokens: Token[] = [.Effect.TextShadow.Sm];
    return emilia(tokens);
}

// The `--text-shadow-*` entries are a PROJECT's, the way front 33's palette
// is: emilia's stock theme carries `--shadow-*` and not these.
pub fn projectTextShadow() -> string {
    val mine: ThemeEntry[] = [
        ThemeEntry(name: "--text-shadow-sm", value: "0px 1px 0px rgb(0 0 0 / 0.075)"),
    ];
    val th = extendTheme(defaultTheme(), mine);
    val tokens: Token[] = [.Effect.TextShadow.Sm];
    return emiliaWith(tokens, th);
}

// ── opacity ──────────────────────────────────────────────────────────────────

// Upstream v4's percentage: `opacity-60` is `opacity:60%`, where the reference
// prints the v3 fraction `0.6`.
pub fn translucentOverlay() -> string {
    val tokens: Token[] = [.Effect.Opacity.__60];
    return emilia(tokens);
}

pub fn opacityEnds() -> string {
    val tokens: Token[] = [.Effect.Opacity.__0, .Effect.Opacity.__100];
    return emilia(tokens);
}

// ── blend modes ──────────────────────────────────────────────────────────────

// `mix-blend-mode` blends an element with what is BEHIND it;
// `background-blend-mode` blends an element's own background layers with each
// other. Same seventeen values, two different jobs.
pub fn dimmedCaption() -> string {
    val tokens: Token[] = [.Blend.Mix.Multiply];
    return emilia(tokens);
}

pub fn tintedBackdrop() -> string {
    val tokens: Token[] = [.Blend.Bg.Overlay];
    return emilia(tokens);
}

pub fn additiveGlow() -> string {
    val tokens: Token[] = [.Blend.Mix.PlusLighter];
    return emilia(tokens);
}

// ── masks ────────────────────────────────────────────────────────────────────

// THE CLASS SUFFIX IS NOT THE CSS VALUE: `mask-clip-border` sets `border-box`.
pub fn maskBox() -> string {
    val tokens: Token[] = [.Mask.Clip.Padding, .Mask.Origin.Border];
    return emilia(tokens);
}

pub fn maskPaint() -> string {
    val tokens: Token[] = [
        .Mask.Mode.Alpha,
        .Mask.Composite.Intersect,
        .Mask.Repeat.NoRepeat,
        .Mask.Size.Cover,
        .Mask.Position.Center,
    ];
    return emilia(tokens);
}

// `mask-type` is the only member of the family that declares on the MASK
// element rather than on the masked one.
pub fn maskElement() -> string {
    val tokens: Token[] = [.Mask.Type.Luminance];
    return emilia(tokens);
}

// ── arbitrary values ─────────────────────────────────────────────────────────

// THE FADE-TO-TRANSPARENT IMAGE EDGE the library had no way to spell. It is an
// arbitrary value, so it is a TOP-LEVEL variant with a payload — a payload leaf
// nested inside a section cannot be constructed by any spelling — and it is
// reached through the wrapper, because a leading-dot path followed by a payload
// call does not carry the typed-array context either.
pub fn fadedEdge() -> string {
    val tokens: Token[] = [
        rawMaskImage("linear-gradient(to bottom, black 60%, transparent)"),
        .Mask.Repeat.NoRepeat,
    ];
    return emilia(tokens);
}

pub fn hairlineShadow() -> string {
    val tokens: Token[] = [rawShadow("0 0 0 1px rgb(0 0 0 / 0.08)")];
    return emilia(tokens);
}

pub fn engravedLabel() -> string {
    val tokens: Token[] = [rawTextShadow("0 1px 0 rgb(255 255 255 / 0.6)")];
    return emilia(tokens);
}

// The fully qualified spelling, which is what a list holds when no wrapper is
// in reach. `[.EffectShadowRaw("…")]` does NOT parse.
pub fn hairlineShadowQualified() -> string {
    val tokens: Token[] = [Token.EffectShadowRaw(value: "0 0 0 1px rgb(0 0 0 / 0.08)")];
    return emilia(tokens);
}

// ── the component ────────────────────────────────────────────────────────────

// A PHOTO CARD. At rest it sits on the small shadow with its image multiplied
// into the page; on hover it lifts to the extra-large shadow and the image
// comes back to full opacity. Three families in one list and a fourth in the
// modifier, and the hover half is front 34's wrapping around this front's
// declarations.
pub fn photoCard() -> string {
    val lifted: Token[] = [.Effect.Shadow.Xl, .Effect.Opacity.__100];
    val tokens: Token[] = [
        .Effect.Shadow.Sm,
        .Blend.Mix.Multiply,
        .Effect.Opacity.__90,
        Token.Hover(lifted),
    ];
    return emilia(tokens);
}

// The same card with a masked image edge, which is the one thing in this file
// that needs an arbitrary value.
pub fn fadedPhotoCard() -> string {
    val tokens: Token[] = [
        .Effect.Shadow.Md,
        .Mask.Repeat.NoRepeat,
        rawMaskImage("linear-gradient(to bottom, black 70%, transparent)"),
    ];
    return emilia(tokens);
}

pub fn main() -> void {
    return;
}

// ── tests ────────────────────────────────────────────────────────────────────

// THE DEFECT, from OUTSIDE the library. `box-shadow:md` is asserted absent by
// name: it is the string the four leaves used to emit, and a consumer package
// is where a cross-package `case` fall-through would have shown up.

// The composed `box-shadow` every shadow and ring token writes beside its own
// channel (emilia front 40/41: upstream's five channels, each with its null
// shadow as a fallback), spelled once for this example's assertions.
fn chain() -> string {
    return "var(--tw-inset-shadow, 0 0 transparent), var(--tw-inset-ring-shadow, 0 0 transparent), var(--tw-ring-offset-shadow, 0 0 transparent), var(--tw-ring-shadow, 0 0 transparent), var(--tw-shadow, 0 0 transparent)";
}

test "the four pre-41 leaves emit theme references, and the class suffix is gone" {
    val cls = theFourThatShippedWrong();
    val doc = await flushWith(bareOptions());
    // FOUR TOKENS, ONE CLASS, ONE RULE BODY: the declarations join with `;`
    // in list order, which is why the class is a function of the ORDER too.
    assert doc.indexOf("."
        + cls
        + "{--tw-shadow:var(--shadow-sm);box-shadow:"
        + chain()
        + ";"
        + "--tw-shadow:var(--shadow-md);box-shadow:"
        + chain()
        + ";--tw-shadow:var(--shadow-lg);box-shadow:"
        + chain()
        + ";"
        + "--tw-shadow:var(--shadow-xl);box-shadow:"
        + chain()
        + "}")
        != -1;
    assert doc.indexOf("--tw-shadow:var(--shadow-lg);box-shadow:" + chain())
        != -1;
    assert doc.indexOf("--tw-shadow:var(--shadow-xl);box-shadow:" + chain())
        != -1;
    assert doc.indexOf("box-shadow:sm") == -1;
    assert doc.indexOf("box-shadow:md") == -1;
    assert doc.indexOf("box-shadow:lg") == -1;
    assert doc.indexOf("box-shadow:xl") == -1;
}

test "the rest of the scale, the keyword and the one literal" {
    val a = theRestOfTheScale();
    val b = noShadow();
    val c = innerShadow();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("--tw-shadow:var(--shadow-2xs);box-shadow:" + chain())
        != -1;
    assert doc.indexOf("--tw-shadow:var(--shadow-xs);box-shadow:" + chain())
        != -1;
    assert doc.indexOf("--tw-shadow:var(--shadow-2xl);box-shadow:" + chain())
        != -1;
    assert doc.indexOf("."
        + b
        + "{--tw-shadow:0 0 transparent;box-shadow:"
        + chain()
        + "}")
        != -1;
    assert doc.indexOf("."
        + c
        + "{--tw-shadow:inset 0 2px 4px 0 rgb(0 0 0 / 0.05);box-shadow:"
        + chain()
        + "}")
        != -1;
    assert a != b;
}

test "an inset shadow is the box-shadow property with `inset` leading the value" {
    val cls = insetShadows();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + "{--tw-inset-shadow:inset var(--inset-shadow-sm);box-shadow:"
        + chain()
        + "}")
        != -1;
    // and never a longhand CSS does not have
    assert doc.indexOf("inset-box-shadow") == -1;
}

// THE REFERENCE FORM IS WHY THE CLASS DOES NOT MOVE. The class name is a hash
// of the ENCODED SHEET, and the sheet is `text-shadow:var(--text-shadow-sm)`
// under either theme — so the stock theme and the project's produce the SAME
// class, and the project's value reaches the page through the theme layer
// instead of through a second rule. A dispatcher that resolved the scale would
// have given two classes here, and every themed project would ship two copies
// of every rule.
test "text-shadow references the theme, and a project supplies the value" {
    val stock = textShadow();
    val mine = projectTextShadow();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("." + stock + "{text-shadow:var(--text-shadow-sm)}")
        != -1;
    assert stock == mine;
    assert doc.indexOf("0px 1px 0px") == -1;
}

test "opacity is upstream's percentage, both ends of the scale included" {
    val a = translucentOverlay();
    val b = opacityEnds();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("." + a + "{opacity:60%}") != -1;
    assert doc.indexOf("opacity:0.6") == -1;
    assert doc.indexOf("." + b + "{opacity:0%;opacity:100%}") != -1;
}

test "the two blend families are two properties over the same values" {
    val a = dimmedCaption();
    val b = tintedBackdrop();
    val c = additiveGlow();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("." + a + "{mix-blend-mode:multiply}") != -1;
    assert doc.indexOf("." + b + "{background-blend-mode:overlay}") != -1;
    assert doc.indexOf("." + c + "{mix-blend-mode:plus-lighter}") != -1;
    // the class name never reaches the declaration
    assert doc.indexOf("bg-blend-") == -1;
}

test "the mask family — nine properties, and the value is never the class suffix" {
    val a = maskBox();
    val b = maskPaint();
    val c = maskElement();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + a
        + "{mask-clip:padding-box;mask-origin:border-box}")
        != -1;
    assert doc.indexOf("."
        + b
        + "{mask-mode:alpha;mask-composite:intersect;"
        + "mask-repeat:no-repeat;mask-size:cover;mask-position:center}")
        != -1;
    assert doc.indexOf("." + c + "{mask-type:luminance}") != -1;
    assert doc.indexOf("mask-clip:border}") == -1;
    assert doc.indexOf("mask-clip-padding") == -1;
}

test "an arbitrary value reaches its own top-level arm, through the wrapper" {
    val a = fadedEdge();
    val b = hairlineShadow();
    val c = engravedLabel();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("mask-image:linear-gradient(to bottom, black 60%, transparent)")
        != -1;
    assert doc.indexOf("."
        + b
        + "{--tw-shadow:0 0 0 1px rgb(0 0 0 / 0.08);box-shadow:"
        + chain()
        + "}")
        != -1;
    assert doc.indexOf("." + c + "{text-shadow:0 1px 0 rgb(255 255 255 / 0.6)}")
        != -1;
    assert a != b;
}

// THE WRAPPER AND THE FULLY QUALIFIED SPELLING ARE THE SAME TOKEN, which is
// what makes the wrapper a convenience and not a second surface.
test "the wrapper and the qualified spelling produce the same class" {
    assert hairlineShadow() == hairlineShadowQualified();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("--tw-shadow:0 0 0 1px rgb(0 0 0 / 0.08)") != -1;
}

test "end to end — a photo card that lifts on hover" {
    val cls = photoCard();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + "{--tw-shadow:var(--shadow-sm);box-shadow:"
        + chain()
        + ";"
        + "mix-blend-mode:multiply;opacity:90%}")
        != -1;
    // the hover half is front 34's wrapping around this front's declarations
    assert doc.indexOf("@media (hover: hover){."
        + cls
        + ":hover{--tw-shadow:var(--shadow-xl);box-shadow:"
        + chain()
        + ";opacity:100%}}")
        != -1;
}

test "end to end — the same card with a faded image edge" {
    val cls = fadedPhotoCard();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + "{--tw-shadow:var(--shadow-md);box-shadow:"
        + chain()
        + ";"
        + "mask-repeat:no-repeat;"
        + "mask-image:linear-gradient(to bottom, black 70%, transparent)}")
        != -1;
}

// NOTHING IN THIS EXAMPLE RESOLVES A SHADOW SCALE, and the probe is shown to
// discriminate: the document is not empty and does carry the references those
// literals would have replaced. The two `rgb(` strings that ARE here are the
// reference's own `shadow-inner` literal and the author's own arbitrary
// values — neither is a scale step a theme owns — so this walk names them
// rather than pretending the document has none.
test "no token in this example resolves a step of the shadow scale" {
    val _a = theFourThatShippedWrong();
    val _b = theRestOfTheScale();
    val _c = insetShadows();
    val _d = textShadow();
    val _e = translucentOverlay();
    val _f = dimmedCaption();
    val _g = maskPaint();
    val _h = photoCard();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("0 4px 6px") == -1;
    assert doc.indexOf("0 10px 15px") == -1;
    assert doc.indexOf("0 25px 50px") == -1;
    assert doc.indexOf("var(--shadow-md)") != -1;
    assert doc.indexOf("var(--shadow-lg)") != -1;
    assert doc.indexOf("var(--inset-shadow-sm)") != -1;
}
