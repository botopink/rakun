{
  "name": "blog-ssr",
  "version": "0.0.1",
  "description": "jhonstart example — the server-rendered blog: a root layout, a post page with two sequential loaders, the loading, error, not-found and global-error conventions, static and dynamic metadata (fronts 26, 28, 30, 31, 32, 94)",
  "src": "src/",
  "entry": "main.bp",
  "target": "erlang",
  "targets": [
    "commonJS",
    "erlang"
  ],
  "files": [
    "main.bp",
    "repo.bp",
    "app/mod.bp",
    "app/layout.bp",
    "app/loading.bp",
    "app/error.bp",
    "app/not_found.bp",
    "app/global_error.bp",
    "app/blog/mod.bp",
    "app/blog/slug/mod.bp",
    "app/blog/slug/page.bp",
    "app/blog/slug/metadata.bp"
  ],
  "dependencies": {
    "jhonstart": {
      "workspace": true
    },
    "jhonstart-test": {
      "workspace": true
    },
    "snap": {
      "git": "https://github.com/botopink/snap.git",
      "branch": "feat"
    }
  }
