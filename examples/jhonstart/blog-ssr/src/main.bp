// blog-ssr — renders the post page inside the root layout.

pub mod repo;
pub mod app;

import {renderNode} from "jhonstart";
import {fixtureRouter} from "jhonstart-test";
import {app.layout.RootLayout};
import {app.blog.slug.page.PostPage};

fn main() -> @Task<void> {
    val r = fixtureRouter("/blog/hello", "/blog/[slug]", "slug=hello", "");
    val page = await PostPage(r.params);
    @print(renderNode(RootLayout(r, page)));
}
