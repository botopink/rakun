// blog-ssr/app/error — the segment error page. It receives only the digest
// (`infoFor` blanks the message), and its retry control is the comments
// panel's reset (`data-jh-reset`, front 31).

import {Element, section, h2, p, button, text, ErrorInfo, resetAttr} from "jhonstart";

pub fn ErrorPage(info: ErrorInfo) -> Element {
    return section([
        h2([text("This section is unavailable")]),
        p([text("Reference: " + info.digest)]),
        button([text("Retry")], attrs: [resetAttr("comments")]),
    ], attrs: [#("class", "segment-error")]);
}
