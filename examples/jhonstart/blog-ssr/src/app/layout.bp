// blog-ssr/app/layout — the root layout: the site header with the section the
// route is in marked active, the page inside `main`, and the root segment's
// metadata and viewport. The document head is front 30's render's.

import {Element, div, header, nav, a, main, text, RouterState, Metadata, Viewport, OpenGraph, TwitterCard, Icons} from "jhonstart";

fn navLink(href: string, label: string, active: bool) -> Element {
    val cls = if (active) "nav active" else "nav";
    return a([text(label)], attrs: [#("href", href), #("class", cls)]);
}

pub fn RootLayout(r: RouterState, page: Element) -> Element {
    val section = r.segments().at(0) ?? "";
    return div([
        header([nav([
            navLink("/", "Home", section == ""),
            navLink("/blog", "Blog", section == "blog"),
            navLink("/docs", "Docs", section == "docs"),
        ])], attrs: [#("class", "site-header")]),
        main([page]),
    ], attrs: [#("class", "site")]);
}

pub fn metadata() -> Metadata {
    return Metadata(
        title: "botopink blog",
        titleTemplate: "%s | botopink blog",
        description: "",
        openGraph: OpenGraph(title: "", description: "", url: "", ogType: "website", siteName: "botopink blog", images: []),
        twitter: TwitterCard(card: "summary_large_image", title: "", description: "", images: []),
        icons: Icons(icon: "/favicon.ico", apple: ""),
    );
}

pub fn viewport() -> Viewport {
    return Viewport(width: "device-width", initialScale: "1", themeColor: "#111111");
}
