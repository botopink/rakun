// islands — prints a post list inside the theme provider.

pub mod like_button;
pub mod theme;
pub mod page;

import {renderToString} from "jhonstart";
import {page.Post, page.PostListFrom, page.RootLayout};

fn main() {
    val posts = [Post(id: "p1", title: "One", likes: 3), Post(id: "p2", title: "Two", likes: 0)];
    @print(renderToString(RootLayout("dark", PostListFrom(posts, 1))));
}
