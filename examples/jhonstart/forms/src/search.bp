// forms/search — a plain GET form (§ 25 `<Form>`): `data-jh-sf`, never an
// action; the URL it produces is `searchHref`'s.

import {Element, form, input, select, option, button, text} from "jhonstart";
import {SearchFormProps, searchFormProps, searchFormAttrs} from "jhonstart-forms";

pub fn searchForm(props: SearchFormProps) -> Element {
    return form([
        input([], attrs: [#("name", "q")]),
        select([option([text("Newest")], attrs: [#("value", "new")]), option([text("Top")], attrs: [#("value", "top")])], attrs: [#("name", "sort")]),
        button([text("Search")], attrs: [#("type", "submit")]),
    ], attrs: searchFormAttrs(props));
}

pub fn SearchForm() -> Element {
    return searchForm(searchFormProps("/search"));
}
