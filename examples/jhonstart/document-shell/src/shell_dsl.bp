// document-shell/shell_dsl — the body written as markup over the same tags.
//
// `<html>` itself cannot be authored in the DSL (the tag resolves to the
// template fn `html`), which is why only the body has a DSL twin.

import {html} from "jhonstart-html";
import {Element, main, h2, text, bracketPair} from "jhonstart";

pub fn documentBody(pageTitle: string) -> Element {
    val cls = "page";
    return html """<main class={cls}><h2>${pageTitle}</h2></main>""";
}
