// document-shell/shell — a whole document with the constructors (front 94).
//
// `<html>` is `htmlTag`: `html` is the `html """…"""` DSL, imported beside it
// by `shell_dsl.bp`. `meta` and `link` are void; the frozen `renderToString`
// still closes them (`</meta>`), front 30's `renderNode` does not.

import {Element, htmlTag, head, body, meta, title, link, text} from "jhonstart";

pub fn documentShell(lang: string, pageTitle: string, styleHref: string, content: Element) -> Element {
    return htmlTag([
        head([
            meta([], attrs: [#("charset", "utf-8")]),
            title([text(pageTitle)]),
            link([], attrs: [#("rel", "stylesheet"), #("href", styleHref)]),
        ]),
        body([content]),
    ], attrs: [#("lang", lang)]);
}

// The doctype is not an element — an `Element` always renders as a tag — so it
// is a string prefix.
pub fn doctype() -> string {
    return "<!doctype html>";
}
