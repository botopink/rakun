// jhonstart-todo — lists + a custom hook, as a pure SSR client.
//
// List rendering is ordinary data: `items.map({ it -> li([text(it)]) })`
// produces an `Element[]` the `ul` builder accepts (the `Children` coercion).
// `todoView` is pure and directly testable; `toggle` is a custom hook — a noun,
// no `use` prefix (the keyword is the activation), a `@Component<_>`
// return (the return is the effect) — used by the idiomatic `TodoApp` component
// (decisions 88, 118 and 128 of 1.0.10-beta).

import {Element, ElementBase, div, ul, li, span, text, state, renderToString} from "jhonstart";

// Pure view: render a todo list (and a count) from plain data.
fn todoView(items: string[]) -> Element {
    val rows = items.map({ it -> li([text(it, [])], []) });
    return div([
        span([text("todos: " + items.length.toString(), [])], []),
        ul(rows, []),
    ], []);
}

// A custom hook composing the primitive `state` hook.
fn toggle(initial: bool) -> @Component<State<bool>> {
    val s = use state(initial);
    return s;
}

// Idiomatic stateful component: every `use` in the static prefix, before the
// `if`. Called plainly it is the server pass (the initial cells).
pub fn TodoApp() -> @Component<Element> {
    val items = use state(["buy milk", "write docs"]);
    val open = use toggle(true);
    if (open.value) return todoView(items.value);
    return span([text("(hidden)", [])], []);
}

fn main() {
    @print(renderToString(todoView(["buy milk", "write docs"])));
}

test "the todo view renders one li per item plus a count" {
    val out = renderToString(todoView(["a", "b", "c"]));
    assert out
        == "<div><span>todos: 3</span><ul><li>a</li><li>b</li><li>c</li></ul></div>";
}

test "an empty list renders an empty ul" {
    assert renderToString(todoView([]))
        == "<div><span>todos: 0</span><ul></ul></div>";
}

test "the @Component component and its custom hook render the server pass" {
    assert renderToString(await TodoApp())
        == "<div><span>todos: 2</span><ul><li>buy milk</li><li>write docs</li></ul></div>";
}
