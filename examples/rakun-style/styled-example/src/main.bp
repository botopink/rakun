// Front 119's `styled-example.bp` as an application: `` styled @`…` `` and
// `` styledProperty @`…` `` from "rakun-style", the theme declared once, a layered
// sheet. Built on erlang and commonJS by the pre-commit gate; the repository
// stage reads its emitted module for `tab4`'s constant class and `code`'s
// computed call.
//
// Every piece resolves under ONE shared root (decisions 969, 809; mt-0410):
// `code()`, `padAll(2)`, `tabRed` and `sheet.render()` all run inside
// `renderAll`'s own tree, under the ONE provider it sets up at its top — never
// four independent `run()` calls each opening its own disconnected root,
// which left `tabRed` and `sheet.render()` with no provider at all and
// panicked `no StyledContext provider`.

import styled, {styledProperty, StyledSheet, Styled, StyledProperty, Sheet, layer} from "rakun-style";
import {context.createContext, context.provide, context.run, context.Scope, io.terminal.print} from "std";
import {theme.theme, extendTheme, baseTheme, entry, clear, Ns, ThemeValue} from "rakun-style";

// LANGUAGE GAP: a library's template function cannot read the program's catalogue (`@TypeInfo.all(with: theme)` in an imported module), so the literals below read the base theme (md 48rem), not this one; and `comptime` cannot build it (an enum variant in a comptime block).
#[theme]
pub val appTheme = extendTheme(
    baseTheme(),
    [entry(.Breakpoint, "md", ThemeValue.Rem(52.0)), clear(.Breakpoint, "2xl")],
);

pub val tab4 = styledProperty @`tab-size: 4;`;

// Every hole known at build — `tab4` is a `val` whose literal has none —
// computed at render all the same: the template never reads a hole's value
// (decision 577 (5)).
pub val tabRed = styled @`${tab4} color: red;`;

// Tailwind: @utility p-* { padding: --spacing(--value(integer)); }
fn padAll(n: i32) -> Component<StyledProperty> {
    return styledProperty @`padding: --spacing(${n});`;
}

// `${padAll(2)}` is a call, so `code` is computed at render (decision 355):
// a function, run below the render's provider — a `val` is evaluated outside
// every render.
fn code() -> Component<Styled> {
    return styled @`
  ${tab4}
  font-family: var(--font-mono);
  &:hover { ${padAll(
        2,
    )} }
  @variant md { max-width: --theme(--breakpoint-md); }
`;
}

// The render's root: whoever renders provides `StyledSheet`'s context — rakun-bpp's
// render, emilia's `flush()` (decision 354 (7)). This one keeps nothing: the
// sheet below is built by hand.
component fn Render(view: fn() -> Component<Styled>) -> Component<Styled> {
    use provide(createContext(StyledSheet(layer: "components", add: dropped)));
    val out = use view();
    return out;
}

component fn RenderProperty(
    view: fn() -> Component<StyledProperty>,
) -> Component<StyledProperty> {
    use provide(createContext(StyledSheet(layer: "components", add: dropped)));
    val out = use view();
    return out;
}

fn dropped(layer: string, item: Styled) -> void {}

// Every piece of the page, resolved in the ONE tree `main` opens below —
// `Render`/`RenderProperty` are placed here, so their own `use provide(…)`
// reaches `code()`, `padAll(2)` and `tabRed` without a fresh root apiece.
component fn renderAll() -> Component<string> {
    val c = use Render({ -> code() });
    val p = use RenderProperty({ -> padAll(2) });
    val red = use Render({ -> tabRed });
    val sheet = Sheet
        .of([layer("base"), layer("components")])
        .add("components", c)
        .add("components", red)
        .add("base", p);
    val out = use sheet.render();
    return out;
}

pub async fn main() -> Async<void> {
    print(await run(renderAll(), Scope.root()));
}
