// Front 119 step 1: a `styled` component computed at render reads the sheet
// with `use context(styledContext)` (decisions 352, 354, 379); rendered with no
// provider above it, it reads the declared default, whose writer aborts
// naming the missing provider (378 (3)). What prints before it stands. The
// repository stage runs it on erlang and commonJS and reads the abort.

import styled, {StyledView} from "rakun-style";
import {io.terminal.print} from "std";

fn badge(c: string) -> StyledView {
    return styled @`color: ${c};`;
}

pub async fn main() -> Async<void> {
    print("before");
    val b = await badge("red");
    print(b.className);
}
