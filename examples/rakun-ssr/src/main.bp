// rakun example — the page path, from a CONSUMER's side (front 23).
//
// Everything here is reached through `from "rakun-app"`, which is what makes this
// example the proof that the page seam is exported and that both of its host
// files ship with a consumer's build. rakun builds NO HTML (decision 113): a
// page's markup is the HTML library's, handed in by the application's
// orchestrator as an opaque `PageRenderer`. So this example's renderers write
// plain text through the `ChunkWriter` — which is all rakun ever sees.
//
// It shows, in order: a page registered through `page(pattern, render)`, a
// renderer that answers its own 307, the page path installed as the core
// router's fallback, and three requests dispatched through it — a page, a
// redirect and a URL no page claims.
//
//   GET /                -> 200  hello from the page path
//   GET /private         -> 307  (location: /login)
//   GET /missing         -> 404
//
// `botopink build` from this directory builds it. A BUILT erlang program does
// not yet ship its sidecars (front 04 § Blocked), so the requests are asserted
// by `modules/rakun-app/test/ssr_test.bp` until it does.

// `Request` is imported although this file never spells it: the imported
// `PageRenderer` alias names it, and an imported fn-type alias resolves its
// names in the IMPORTER's scope today (`language-gaps.md`).
import {Request, Response, rkDispatchHttp} from "rakun";
import {ChunkWriter, PageRenderer, page, servePages, writeTo, setStatusOn, setHeaderOn, closeOut} from "rakun-app";

fn helloBody(out: ChunkWriter) -> @Task<@Result<void, string>> {
    await writeTo(out, "hello ");
    await writeTo(out, "from the page path");
    return;
}

fn privateBody(out: ChunkWriter) -> @Task<@Result<void, string>> {
    val _s = setStatusOn(out, 307);
    val _h = setHeaderOn(out, "location", "/login");
    await closeOut(out);
    return;
}

fn hello() -> PageRenderer {
    return { req, out -> helloBody(out) };
}

fn privatePage() -> PageRenderer {
    return { req, out -> privateBody(out) };
}

fn show(path: string) -> i32 {
    val res: Response = rkDispatchHttp("GET", path, "{}", "{}", "");
    @print("GET " + path + " -> " + res.status.toString() + " " + res.body);
    return res.status;
}

fn main() {
    val _a = page("", hello());
    val _b = page("private", privatePage());
    val _s = servePages();
    val _one = show("/");
    val _two = show("/private");
    val _three = show("/missing");
}
