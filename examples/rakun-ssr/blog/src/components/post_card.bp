//// A post in the list — front 48's attribute slot carrying one emilia class
//// built from palette, spacing and border tokens (fronts 33, 35, 40).

import {Element, article, h2, p, text, timeTag} from "rakun-bpp";
import {Link, linkProps} from "rakun-bpp";
import {emilia.emilia, Token} from "rakun-stylesheet";
import {lib.db.Post};

// Token order is class identity (`contracts.md § 4`), so the list lives in
// one function.
pub fn cardTokens() -> Token[] {
    return [.Gap.All.4];
}

pub fn PostCard(post: Post) -> Element {
    val cls = emilia(cardTokens());
    return article([
        h2([Link(linkProps("/blog/"
            + post.slug), [text(post.title, attrs: [])])], attrs: []),
        timeTag([text(post.published, attrs: [])], attrs: [#("datetime", post.published)]),
        p([text(post.excerpt, attrs: [])], attrs: []),
    ], attrs: [#("class", cls)]);
}
