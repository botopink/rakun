//// The like button (front 29): a client component. The server renders its
//// placeholder through rakun-bpp's `mountIsland` (the post page); the browser
//// starts it from the bundle's entry, which decodes `LikeProps` from the
//// payload's `i` row. It imports nothing server-only: `lib/db.bp` in its
//// graph would fail `rakun-ssr build` (front 68's refusal 1).

import {Element, button, text, client.client, clientProps} from "rakun-bpp";

#[clientProps]
pub type LikeProps(postId: string, likes: i32)

#[client]
pub fn LikeButton(props: LikeProps) -> Element {
    return button([text("♥ "
        + props.likes.toString(), attrs: [])], attrs: [#("class", "like"), #("data-post", props.postId)]);
}
