//// The dashboard's gate inside the render (decision 117): a request with no
//// `session` cookie is redirected to `/login` by this layout — through
//// rakun-bpp's `Response`, before any chunk — and no page under
//// `/dashboard` checks the session itself.

import {layout, jhLayout, LayoutProps, Element, ElementBase, main, cookies, redirect} from "rakun-bpp";

pub fn hasSession(jar: array<#(string, string)>) -> bool {
    return jar.filter({ c -> c._0 == "session" && c._1 != "" }).length > 0;
}

#[layout("dashboard")]
pub component fn dashboardLayout(props: LayoutProps) -> Component<Element> {
    if (hasSession(cookies()) == false) redirect("/login");
    return main([props.children], attrs: [#("class", "dashboard")]);
}
