//// The root layout (front 30): the nav, then the page. emilia's sheet
//// reaches the head through the rakun-stylesheet plugin rakun-ssr registers.

import {page, layout, jhPage, jhLayout, ctxParam, ctxRest, PageContext, LayoutProps, Element, ElementBase, main, section, article, h1, h2, p, text, notFound} from "rakun-bpp";
import {emilia.emilia, Token} from "rakun-stylesheet";
import {components.nav.siteNav};

#[layout("")]
pub fn rootLayout(props: LayoutProps) -> @Component<Element> {
    val shell = emilia([.Gap.All.2]);
    return main([siteNav(), props.children], attrs: [#("class", shell)]);
}
