//// `/blog/[slug]` — one post; a missing slug is rakun-bpp's notFound()
//// (404 before the first chunk). Imports through the app's aliases: only
//// `rakun-ssr build` rewrites them, which is the point (front 49's alias map).

import {page, layout, jhPage, jhLayout, pageParams, PageContext, LayoutProps, Element, ElementBase, main, section, article, h1, h2, p, text, notFound, mountIsland} from "rakun-bpp";
import {readPost, parsePost} from "@/lib.db";
import {LikeButton} from "@/components.like_button";

#[page("blog/[slug]")]
pub fn post(route: PageContext) -> @Component<Element> {
    val slug = pageParams(route).get("slug");
    val found = readPost(slug);
    if (found.isError()) notFound();
    val one = found.unwrapOr(parsePost(slug, ""));
    val like = mountIsland("LikeButton", [#("postId", one.slug), #("likes", "0")], []);
    return article([h1([text(one.title, attrs: [])], attrs: []), p([text(one.body, attrs: [])], attrs: []), like], attrs: []);
}
