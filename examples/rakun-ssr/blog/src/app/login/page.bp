//// `/login` — where the dashboard's gate sends a request with no session.

import {page, jhPage, ctxParam, ctxRest, PageContext, Element, ElementBase, section, h1, text} from "rakun-bpp";

#[page("login")]
pub component fn login(route: PageContext) -> Component<Element> {
    return section([h1([text("Sign in", attrs: [])], attrs: [])], attrs: []);
}
