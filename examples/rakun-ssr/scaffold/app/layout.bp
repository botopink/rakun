import {layout, jhLayout, LayoutProps, Element, ElementBase, main} from "rakun-bpp";
import {emilia.emilia, Token} from "rakun-stylesheet";

// The root layout: every page renders inside it.
#[layout("")]
pub component fn rootLayout(props: LayoutProps) -> Component<Element> {
    val shell = emilia([.Gap.All.4]);
    return main([props.children], attrs: [#("class", shell)]);
}
