// The nine tags the app needs beyond `div` / `p` / `span` (front 53 step 1):
// front 94's `elements.bp` provides them, so the app builds none of its own.
// Rendered through the render's `renderNode`, which knows the void elements
// (`element.bp`'s frozen `renderToString` still writes `<input></input>`).

import {Element, text, renderNode} from "jhonstart";
import {nav, article, h2, a, form, label, input, button, timeTag} from "jhonstart";
import {loadAliases, resolveAlias} from "onze";
import {io.fs} from "std";

test "tags: the nine tags render from jhonstart's element surface" {
    val t = [text("x", attrs: [])];
    val html = [
        nav(t, attrs: []),
        article(t, attrs: []),
        h2(t, attrs: []),
        a(t, attrs: [#("href", "/blog")]),
        form(t, attrs: []),
        label(t, attrs: []),
        input([], attrs: [#("name", "title")]),
        button(t, attrs: []),
        timeTag(t, attrs: [#("datetime", "2026-01-10")]),
    ]
        .map({ e -> renderNode(e) })
        .join("");
    assert html.contains("<nav>x</nav>");
    assert html.contains("<article>x</article>");
    assert html.contains("<h2>x</h2>");
    assert html.contains("<a href=\"/blog\">x</a>");
    assert html.contains("<form>x</form>");
    assert html.contains("<label>x</label>");
    assert html.contains("<input name=\"title\">");
    assert html.contains("</input>") == false;
    assert html.contains("<button>x</button>");
    assert html.contains("<time datetime=\"2026-01-10\">x</time>");
}

fn resolvedFromManifest(spec: string) -> @Result<string, string> {
    val manifest = try fs.readText("botopink.json");
    val map = try loadAliases(manifest);
    return resolveAlias(map, spec);
}

test "alias: the app's map sends @/lib.db and @/components.post_card to their modules" {
    assert resolvedFromManifest("@/lib.db").unwrapOr("") == "lib.db";
    assert resolvedFromManifest("@/components.post_card").unwrapOr("")
        == "components.post_card";
}
