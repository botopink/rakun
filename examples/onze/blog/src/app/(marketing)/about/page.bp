//// `/about` — the route group contributes no URL segment (front 22).

import {page, layout, jhPage, jhLayout, ctxParam, ctxRest, PageContext, LayoutProps, Element, ElementBase, main, section, article, h1, h2, p, text, notFound} from "jhonstart";

#[page("(marketing)/about")]
pub fn about(route: PageContext) -> @Component<Element> {
    return section([h1([text("About", attrs: [])], attrs: []), p([text("A blog that exercises every onze seam at once.", attrs: [])], attrs: [])], attrs: []);
}
