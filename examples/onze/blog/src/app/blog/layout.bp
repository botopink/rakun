//// The blog shell: wraps every `/blog/*` route.

import {page, layout, jhPage, jhLayout, ctxParam, ctxRest, PageContext, LayoutProps, Element, ElementBase, main, section, article, h1, h2, p, text, notFound} from "jhonstart";

#[layout("blog")]
pub fn blogLayout(props: LayoutProps) -> @Component<Element> {
    return section([h2([text("The blog", attrs: [])], attrs: []), props.children], attrs: [#("class", "blog-shell")]);
}
