//// `/blog/[slug]`'s not-found boundary: a slug with no post (front 31). The
//// nearest boundary wins, so a missing post shows this and not the root's.

import {Element, p, text} from "jhonstart";

pub fn NotFound() -> Element {
    return p([text("No such post.", attrs: [])], attrs: [#("class", "post-missing")]);
}
