//// The site navigation — front 27's `Link`, so client navigation needs no
//// document load once front 68's entry mounts the links.

import {Element, nav, text} from "jhonstart";
import {Link, linkProps} from "jhonstart-link";

pub fn siteNav() -> Element {
    return nav([
        Link(linkProps("/"), [text("Home", attrs: [])]),
        Link(linkProps("/blog"), [text("Blog", attrs: [])]),
        Link(linkProps("/about"), [text("About", attrs: [])]),
    ], attrs: []);
}
