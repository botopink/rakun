// Front 119 step 1: `styled`'s reader keeps source order (decision 368 (1)).
// The padding written after the `&:focus` block opens a new rule of the
// class, as CSS Nesting's nested-declarations rule does in a browser. Every
// hole is a `val` known at build, so the class and the rules are constants of
// the emitted module (decision 355) — the repository stage reads them there on
// erlang and commonJS.

import styled, {styledProperty} from "styled";

pub val bg = styledProperty "background: #ffffff;";

pub val gray = styledProperty "background: var(--color-gray-100);";

pub val pad = styledProperty "padding: --spacing(4);";

pub val focusPad = styled "${bg} &:focus { ${gray} } ${pad}";

pub fn main() -> @Task<void> {
    val s = await focusPad;
    @println(s.rules);
}
