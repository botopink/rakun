// emilia-typography — `§ 9`'s font half, end to end, in a real package.
//
// Before front 38 this part of emilia covered four of `§ 9`'s thirty-two
// property groups and three of the four emitted CSS that is not what Tailwind
// v4.3 emits. Four things here could not be written at all:
//
//   - a size that CHANGES THE LEADING — `text-lg` in Tailwind sets a
//     font-size AND its paired line-height; emilia set a literal `1.125rem`
//     and dropped the leading on the floor;
//   - a weight below 300 or between 500 and 900 — `font-thin`, `font-semibold`;
//   - font-smoothing, font-style as a token, font-stretch, font-variant-numeric,
//     tracking, leading, line-clamp, text-transform, text-overflow and
//     text-wrap — ten property groups with no token;
//   - a font FAMILY a project could override, because the three stacks were
//     spelled into the dispatcher rather than read from the theme.
//
// THIS FILE IS A CONSUMER PACKAGE, not a test inside the library: a consumer
// re-emits its own copy of the enum classes, so a `case` that crossed the
// package boundary used to fall through every arm (§ Maintainer rules).
// Asserting the full class bodies from outside is what catches that.
//
// Upstream: https://tailwindcss.com/docs/font-size · /font-weight ·
// /font-smoothing · /font-stretch · /font-variant-numeric · /letter-spacing ·
// /line-height · /line-clamp · /text-transform · /text-overflow · /text-wrap

import {emilia, emiliaWith, flushWith, Token} from "rakun-stylesheet";
import {Theme, ThemeEntry, DarkMode, defaultTheme, extendTheme} from "rakun-stylesheet";
import {Rule, Block, Sheet, Options} from "rakun-stylesheet";
import {defaultOptions, withTheme, emptyTheme, typographyEntries} from "rakun-stylesheet";

// A document with no theme in it, so the assertions below read as the rules
// this example registered rather than as the stock theme's hundred variables.
fn bareOptions() -> Options {
    return withTheme(defaultOptions(), emptyTheme());
}

// ── the three families, now a theme reference ────────────────────────────────

pub fn families() -> string[] {
    val a: Token[] = [.Font.Sans];
    val b: Token[] = [.Font.Serif];
    val c: Token[] = [.Font.Mono];
    val out: string[] = [emilia(a), emilia(b), emilia(c)];
    return out;
}

// ── the type scale: one token, TWO declarations ──────────────────────────────

pub fn scale() -> string {
    val tokens: Token[] = [.Text.Size.X7xl];
    return emilia(tokens);
}

// The five sizes the section stopped short of before this front.
pub fn newSizes() -> string {
    val tokens: Token[] = [.Text.Size.X9xl];
    return emilia(tokens);
}

// ── the nine weights ─────────────────────────────────────────────────────────

pub fn weights() -> string[] {
    val a: Token[] = [.Font.Weight.Thin];
    val b: Token[] = [.Font.Weight.Semibold];
    val c: Token[] = [.Font.Weight.Extrabold];
    val out: string[] = [emilia(a), emilia(b), emilia(c)];
    return out;
}

// ── smoothing, style, stretch, variant-numeric ───────────────────────────────
//
// `antialiased` is two VENDOR properties from one token, and the token is the
// only place that pair is written.

pub fn smoothing() -> string {
    val tokens: Token[] = [.Font.Smoothing.Antialiased];
    return emilia(tokens);
}

// `not-italic` is the utility name; `normal` is the CSS value. The token is
// named for the value.
pub fn notItalic() -> string {
    val tokens: Token[] = [.Font.Style.Normal];
    return emilia(tokens);
}

pub fn stretch() -> string {
    val tokens: Token[] = [.Font.Stretch.SemiCondensed];
    return emilia(tokens);
}

// A price table wants figures that line up and a zero that cannot be read as
// an O: tabular figures plus a slashed zero, in one class.
pub fn figures() -> string {
    val tokens: Token[] = [.Font.Mono, .Font.Nums.Tabular, .Font.Nums.SlashedZero];
    return emilia(tokens);
}

// ── tracking and leading ─────────────────────────────────────────────────────

pub fn tracking() -> string {
    val tokens: Token[] = [.Text.Tracking.Widest, .Text.Transform.Uppercase];
    return emilia(tokens);
}

pub fn leading() -> string {
    val tokens: Token[] = [.Text.Leading.Loose];
    return emilia(tokens);
}

// The one leaf of the family that is a literal: `§ 9.11` prints `leading-none`
// as `line-height: 1`, with no `--leading-none` entry behind it.
pub fn leadingNone() -> string {
    val tokens: Token[] = [.Text.Leading.None];
    return emilia(tokens);
}

// ── clamp, overflow, wrap ────────────────────────────────────────────────────

pub fn clamped() -> string {
    val tokens: Token[] = [.Text.Clamp.3];
    return emilia(tokens);
}

// The reset, which is four declarations and not the absence of a token.
pub fn unclamped() -> string {
    val tokens: Token[] = [.Text.Clamp.None];
    return emilia(tokens);
}

// A single-line label that ends in an ellipsis: three declarations from ONE
// token, which is what `truncate` is.
pub fn truncated() -> string {
    val tokens: Token[] = [.Text.Truncate];
    return emilia(tokens);
}

pub fn wrapping() -> string {
    val tokens: Token[] = [.Text.Wrap.Balance];
    return emilia(tokens);
}

// ── THE COMPOSITION THIS FRONT EXISTS FOR ────────────────────────────────────
//
// An article header over a clamped excerpt. Every property below is a token
// this front added or corrected: the header's size carries its own leading,
// its tracking is negative because a display size needs it, and the excerpt is
// cut to three lines with an ellipsis the browser draws.

pub fn articleHeader() -> string {
    val tokens: Token[] = [
        .Font.Sans,
        .Text.Size.X4xl,
        .Font.Weight.Extrabold,
        .Text.Tracking.Tight,
        .Text.Wrap.Balance,
        .Font.Smoothing.Antialiased,
    ];
    return emilia(tokens);
}

pub fn articleExcerpt() -> string {
    val tokens: Token[] = [
        .Font.Serif,
        .Text.Size.Lg,
        .Text.Leading.Relaxed,
        .Text.Clamp.3,
    ];
    return emilia(tokens);
}

// ── tests ────────────────────────────────────────────────────────────────────

test "a family is a theme reference, so a project can move all three" {
    val cls = families();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("." + cls[0] + "{font-family:var(--font-sans)}") != -1;
    assert doc.indexOf("." + cls[1] + "{font-family:var(--font-serif)}") != -1;
    assert doc.indexOf("." + cls[2] + "{font-family:var(--font-mono)}") != -1;
    assert doc.indexOf("ui-sans-serif") == -1;
}

test "a size token is TWO declarations — the pair emilia used to drop" {
    val cls = scale();
    val big = newSizes();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + "{font-size:var(--text-7xl);line-height:var(--text-7xl--line-height)}")
        != -1;
    assert doc.indexOf("."
        + big
        + "{font-size:var(--text-9xl);line-height:var(--text-9xl--line-height)}")
        != -1;
}

test "the four weights the ladder was missing" {
    val cls = weights();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("." + cls[0] + "{font-weight:100}") != -1;
    assert doc.indexOf("." + cls[1] + "{font-weight:600}") != -1;
    assert doc.indexOf("." + cls[2] + "{font-weight:800}") != -1;
}

test "antialiased is two vendor properties, and not-italic is the value normal" {
    val a = smoothing();
    val b = notItalic();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + a
        + "{-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}")
        != -1;
    assert doc.indexOf("." + b + "{font-style:normal}") != -1;
    assert doc.indexOf("not-italic") == -1;
}

test "font-stretch and the figure set a price table wants" {
    val a = stretch();
    val b = figures();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("." + a + "{font-stretch:semi-condensed}") != -1;
    assert doc.indexOf("."
        + b
        + "{font-family:var(--font-mono);"
        + "font-variant-numeric:tabular-nums;font-variant-numeric:slashed-zero}")
        != -1;
}

test "tracking and leading reference the theme; leading-none is the exception" {
    val a = tracking();
    val b = leading();
    val c = leadingNone();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + a
        + "{letter-spacing:var(--tracking-widest);text-transform:uppercase}")
        != -1;
    assert doc.indexOf("." + b + "{line-height:var(--leading-loose)}") != -1;
    assert doc.indexOf("." + c + "{line-height:1}") != -1;
}

test "line-clamp is four declarations, and line-clamp-none undoes all four" {
    val a = clamped();
    val b = unclamped();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + a
        + "{overflow:hidden;display:-webkit-box;"
        + "-webkit-box-orient:vertical;-webkit-line-clamp:3}")
        != -1;
    assert doc.indexOf("."
        + b
        + "{overflow:visible;display:block;"
        + "-webkit-box-orient:horizontal;-webkit-line-clamp:none}")
        != -1;
}

test "truncate is three declarations from one token" {
    val a = truncated();
    val b = wrapping();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + a
        + "{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}")
        != -1;
    assert doc.indexOf("." + b + "{text-wrap:balance}") != -1;
}

test "end to end — an article header over a clamped excerpt" {
    val head = articleHeader();
    val body = articleExcerpt();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + head
        + "{font-family:var(--font-sans);"
        + "font-size:var(--text-4xl);line-height:var(--text-4xl--line-height);"
        + "font-weight:800;letter-spacing:var(--tracking-tight);text-wrap:balance;"
        + "-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}")
        != -1;
    assert doc.indexOf("."
        + body
        + "{font-family:var(--font-serif);"
        + "font-size:var(--text-lg);line-height:var(--text-lg--line-height);"
        + "line-height:var(--leading-relaxed);overflow:hidden;display:-webkit-box;"
        + "-webkit-box-orient:vertical;-webkit-line-clamp:3}")
        != -1;
}

// ── the front's argument, asserted from OUTSIDE the library ──────────────────

test "a project's own type scale reaches every size token, and the class does not move" {
    val brand: ThemeEntry[] = [
        ThemeEntry(name: "--text-4xl", value: "2rem"),
        ThemeEntry(name: "--font-sans", value: "Inter,sans-serif"),
    ];
    val th = extendTheme(extendTheme(defaultTheme(), typographyEntries()), brand);
    // The rule is a REFERENCE, so the header renders byte-identically under
    // the project's theme and under the stock one — SAME class, SAME
    // declarations; only the `:root` block moves. That is the whole argument
    // of this front, and before it the same override reached nothing at all.
    val tokens: Token[] = [
        .Font.Sans,
        .Text.Size.X4xl,
        .Font.Weight.Extrabold,
        .Text.Tracking.Tight,
        .Text.Wrap.Balance,
        .Font.Smoothing.Antialiased,
    ];
    val stock = emilia(tokens);
    val themed = emiliaWith(tokens, th);
    assert stock == themed;
    val doc = await flushWith(withTheme(defaultOptions(), th));
    assert doc.indexOf("." + themed + "{font-family:var(--font-sans);") != -1;
    // and the project's values ARE in the document — in the theme layer.
    assert doc.indexOf("--text-4xl:2rem") != -1;
    assert doc.indexOf("--font-sans:Inter,sans-serif") != -1;
}

test "nothing in this example resolves a size, a leading or a font stack" {
    val _a = families();
    val _b = scale();
    val _c = newSizes();
    val _d = weights();
    val _e = smoothing();
    val _f = stretch();
    val _g = figures();
    val _h = tracking();
    val _i = leading();
    val _j = clamped();
    val _k = truncated();
    val _l = articleHeader();
    val _m = articleExcerpt();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("rem") == -1;
    assert doc.indexOf("ui-sans-serif") == -1;
    assert doc.indexOf("0.025em") == -1;
    assert doc.indexOf("#") == -1;
    // and the probe discriminates: the document is not empty and does carry
    // the references those literals were replaced by.
    assert doc.indexOf("var(--text-4xl)") != -1;
    assert doc.indexOf("var(--tracking-tight)") != -1;
}
