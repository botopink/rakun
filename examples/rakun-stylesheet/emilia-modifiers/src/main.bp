// emilia-modifiers — what the other eighty are for.
//
// Six modifiers used to exist: Hover, Focus, Active, Md, Lg, Xl. With those
// six you can build a demo. You cannot build a stylesheet: there is no `Sm`
// and no `2xl`, so the smallest and largest breakpoints are unreachable; no
// `max-*`, so a range is inexpressible; no `Dark`, so a dark theme cannot be
// written at all; no `Disabled`, `Checked`, `Required` or `Invalid`, so a form
// cannot be styled; no `Group*` or `Peer*`, so a parent's or a sibling's state
// cannot reach a child; and no `Before`, `Placeholder` or `Marker`, so no
// pseudo-element can be reached.
//
// Two things are worth watching in this file, because they are where a reader
// is most likely to expect something else:
//
//   - A MODIFIER IS NOT A BLOCK. It is a `Variant` — an at-rule and a selector
//     template — and the tokens it carries become SIBLING rules hoisted out of
//     the class. `Token.Hover([…])` is not `.e_x{…:hover{…}}`; it is
//     `@media (hover: hover){.e_x:hover{…}}`.
//   - A RANGE AND A CHAIN ARE BOTH NESTING. There is no `MdMaxXl` and no
//     `DarkHover`: `Token.Md([Token.MaxXl([…])])` is the range and
//     `Token.Dark([Token.Hover([…])])` is the chain, and the OUTER one is
//     outermost in the selector and in the at-rule list alike.
//
// `.group` and `.peer` are classes THIS FILE'S MARKUP would carry; emilia
// emits the selector that reads them and never the class itself.

import {emilia.emilia, emiliaWith, flushWith, Token} from "rakun-stylesheet";
import {Theme, ThemeEntry, DarkMode, Options, defaultTheme, withDarkMode} from "rakun-stylesheet";
import {Rule, Block, Sheet} from "rakun-stylesheet";
import {defaultOptions, withTheme, emptyTheme} from "rakun-stylesheet";
import {io.terminal.print} from "std";

// ── a navigation bar, eight modifier families in one token list ────────────
//
// Stacked and dark-surfaced on a phone, a row from `md:` up; the links pick up
// their state from the bar they sit in, which is what `Group*` is for.

fn navTokens() -> Token[] {
    val row: Token[] = [.Flex.Row, .Pad.X.__8];
    val wide: Token[] = [.Pad.X.__4];
    val dark: Token[] = [.Bg.Color.Slate.900, .Color.White];
    val print: Token[] = [.Layout.Hidden];
    val out: Token[] = [
        .Layout.Flex,
        .Flex.Col,
        .Bg.Color.White,
        .Pad.All.__4,
        Token.Md(row),
        Token.MaxSm(wide),
        Token.Dark(dark),
        Token.Print(print),
    ];
    return out;
}

pub fn nav() -> string {
    return emilia(navTokens());
}

// A link inside that bar. `GroupHover` reads the BAR's hover state, `Hover`
// its own; `FocusVisible` is the keyboard-only ring; `First`/`Last` trim the
// ends of the list; `Marker` reaches a pseudo-element no state modifier can.
fn navLinkTokens() -> Token[] {
    val groupHover: Token[] = [.Color.Black];
    val hover: Token[] = [.Text.Underline];
    val focus: Token[] = [.Border.W.__2];
    val first: Token[] = [.Margin.L.__0];
    val last: Token[] = [.Margin.R.__0];
    val marker: Token[] = [.Color.Gray.__500];
    val out: Token[] = [
        .Color.Gray.__700,
        .Margin.X.__2,
        Token.GroupHover(groupHover),
        Token.Hover(hover),
        Token.FocusVisible(focus),
        Token.First(first),
        Token.Last(last),
        Token.Marker(marker),
    ];
    return out;
}

pub fn navLink() -> string {
    return emilia(navLinkTokens());
}

// ── a form field whose error state is peer-driven ──────────────────────────
//
// The input carries `.peer`; the message beside it is hidden until the input
// is invalid. Nothing about that is a script — it is one selector.

fn inputTokens() -> Token[] {
    val placeholder: Token[] = [.Color.Gray.__500];
    val disabled: Token[] = [.Effect.Opacity.__50];
    val invalid: Token[] = [.Border.Color.Red.__500];
    val required: Token[] = [.Border.W.__2];
    val out: Token[] = [
        .Border.W.__1,
        .Pad.All.__2,
        Token.Placeholder(placeholder),
        Token.Disabled(disabled),
        Token.Invalid(invalid),
        Token.Required(required),
    ];
    return out;
}

pub fn input() -> string {
    return emilia(inputTokens());
}

fn errorTokens() -> Token[] {
    val shown: Token[] = [.Layout.Block, .Color.Red.__600];
    val before: Token[] = [.Color.Red.__600];
    val out: Token[] = [
        .Layout.Hidden,
        Token.PeerInvalid(shown),
        Token.Before(before),
    ];
    return out;
}

pub fn errorMessage() -> string {
    return emilia(errorTokens());
}

// ── a table whose rows stripe themselves ───────────────────────────────────
//
// `Odd`/`Even` are the structural rows, `Nth` the indexed one, and `Important`
// the flag upstream spells as a trailing `!`.

fn rowTokens() -> Token[] {
    val odd: Token[] = [.Bg.Color.Gray.__100];
    val even: Token[] = [.Bg.Color.White];
    val third: Token[] = [.Text.Bold];
    val pinned: Token[] = [.Layout.Block];
    val out: Token[] = [
        Token.Odd(odd),
        Token.Even(even),
        Token.Nth(index: 3, inner: third),
        Token.Important(pinned),
    ];
    return out;
}

pub fn row() -> string {
    return emilia(rowTokens());
}

// ── the three dark-mode strategies, as three project options ───────────────
//
// The token list never changes. Which of the three a project uses is a field
// on its theme, and `Token.Dark` reads it through front 54's
// `darkAtRule`/`darkSelector` without learning which one it got.

fn panelTokens() -> Token[] {
    val dark: Token[] = [.Bg.Color.Slate.900];
    val out: Token[] = [.Bg.Color.White, Token.Dark(dark)];
    return out;
}

pub fn panelUnder(th: Theme) -> string {
    return emiliaWith(panelTokens(), th);
}

pub fn bareOptions() -> Options {
    return withTheme(defaultOptions(), emptyTheme());
}

pub fn byClass() -> Theme {
    return withDarkMode(defaultTheme(), DarkMode.Class(name: "dark"));
}

pub fn byAttribute() -> Theme {
    return withDarkMode(defaultTheme(), DarkMode.Attribute(name: "data-theme", value: "dark"));
}

fn main() -> Task<void> {
    print(nav());
    print(navLink());
    print(input());
    print(errorMessage());
    print(row());
    print(await flushWith(bareOptions()));
}

// ── tests ──────────────────────────────────────────────────────────────────
// emilia is comptime and has no target split, so every assertion below runs on
// `--target commonJS` and on `--target erlang`. A modifier that differed
// between them would be a `tokensToSheet` bug, since the wrappers are pure
// string work.

test "a modifier is a SIBLING rule — the bar's dark surface leaves its class" {
    val cls = nav();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("@media (prefers-color-scheme: dark){."
        + cls
        + "{background-color:var(--color-slate-900);color:var(--color-white)}}")
        != -1;
    // The pre-front-56 nested form would put the at-rule inside the class body.
    assert doc.indexOf(";@media") == -1;
}

test "the bar addresses both ends of the ladder, in rem and in both directions" {
    val cls = nav();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("@media (width >= 48rem){."
        + cls
        + "{flex-direction:row")
        != -1;
    assert doc.indexOf("@media (width < 40rem){." + cls + "{padding-left")
        != -1;
    assert doc.indexOf("min-width") == -1;
    assert doc.indexOf("768px") == -1;
}

test "`print:` is the modifier that has nothing to do with a screen" {
    val cls = nav();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("@media print{." + cls + "{display:none}}") != -1;
}

test "a link reads the BAR's hover through .group, and its own through :hover" {
    val cls = navLink();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + ":is(:where(.group):hover *){color:var(--color-black)}")
        != -1;
    assert doc.indexOf("@media (hover: hover){."
        + cls
        + ":hover{text-decoration-line:underline}}")
        != -1;
}

test "the two ends of the link list are trimmed structurally, not by an index" {
    val cls = navLink();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("." + cls + ":first-child{margin-left:0}") != -1;
    assert doc.indexOf("." + cls + ":last-child{margin-right:0}") != -1;
}

test "`marker` reaches the element's own marker and its descendants', as upstream does" {
    val cls = navLink();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("." + cls + " *::marker{color:var(--color-gray-500)}")
        != -1;
    assert doc.indexOf("." + cls + "::marker{color:var(--color-gray-500)}")
        != -1;
    assert doc.indexOf("." + cls + " ::marker") == -1;
}

test "the input's four form states are four sibling rules of one class" {
    val cls = input();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("." + cls + "::placeholder{color:var(--color-gray-500)}")
        != -1;
    assert doc.indexOf("." + cls + ":disabled{opacity:50%}") != -1;
    // The palette reference and not `border-color:red`: front 40 rewrote
    // `Border.Color` onto front 33's grid, so the shade this token always
    // carried finally reaches the output. What this test pins is the SELECTOR,
    // which is this front's.
    assert doc.indexOf("."
        + cls
        + ":invalid{border-color:var(--color-red-500)}")
        != -1;
    assert doc.indexOf("." + cls + ":required{border-width:2px}") != -1;
}

test "the error message is shown by its SIBLING's state, with no script" {
    val cls = errorMessage();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("." + cls + "{display:none}") != -1;
    assert doc.indexOf("."
        + cls
        + ":is(:where(.peer):invalid ~ *){display:block")
        != -1;
    assert doc.indexOf("." + cls + "::before{color:var(--color-red-600)}")
        != -1;
}

test "the striped row — two structural rows, one indexed, and the flag" {
    val cls = row();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + ":nth-child(odd){background-color:var(--color-gray-100)}")
        != -1;
    assert doc.indexOf("."
        + cls
        + ":nth-child(even){background-color:var(--color-white)}")
        != -1;
    assert doc.indexOf("." + cls + ":nth-child(3){font-weight:bold}") != -1;
    assert doc.indexOf("." + cls + "{display:block!important}") != -1;
}

test "dark — the `Media` strategy, which is the stock theme's" {
    val cls = panelUnder(defaultTheme());
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("@media (prefers-color-scheme: dark){."
        + cls
        + "{background-color:var(--color-slate-900)}}")
        != -1;
}

test "dark — the `Class` strategy, same token list, no at-rule at all" {
    val cls = panelUnder(byClass());
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + ":where(.dark, .dark *){background-color:var(--color-slate-900)}")
        != -1;
    assert doc.indexOf("prefers-color-scheme") == -1;
}

test "dark — the `Attribute` strategy, same token list again" {
    val cls = panelUnder(byAttribute());
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + ":where([data-theme=dark], [data-theme=dark] *){background-color:var(--color-slate-900)}")
        != -1;
    assert doc.indexOf("prefers-color-scheme") == -1;
}

test "the strategy is a project decision, so the three give three classes" {
    val a = panelUnder(defaultTheme());
    val b = panelUnder(byClass());
    val c = panelUnder(byAttribute());
    assert a != b;
    assert b != c;
    assert a != c;
    val _drop = await flushWith(bareOptions());
}

test "a range is nesting — there is no MdMaxXl, and there does not need to be" {
    val inner: Token[] = [.Text.Bold];
    val mid: Token[] = [Token.MaxXl(inner)];
    val tokens: Token[] = [Token.Md(mid)];
    val cls = emilia(tokens);
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("@media (width >= 48rem){@media (width < 80rem){."
        + cls
        + "{font-weight:bold}}}")
        != -1;
}

test "a chain is nesting too, and the outer modifier is outermost" {
    val inner: Token[] = [.Text.Bold];
    val hover: Token[] = [Token.Hover(inner)];
    val tokens: Token[] = [Token.Dark(hover)];
    val cls = emilia(tokens);
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("@media (prefers-color-scheme: dark){@media (hover: hover){."
        + cls
        + ":hover{font-weight:bold}}}")
        != -1;
}

test "every class this example builds is one class, whatever it reaches" {
    val a = nav();
    val b = navLink();
    val c = input();
    val d = errorMessage();
    val e = row();
    assert a.startsWith("e_");
    assert b.startsWith("e_");
    assert c.startsWith("e_");
    assert d.startsWith("e_");
    assert e.startsWith("e_");
    val doc = await flushWith(bareOptions());
    assert doc.startsWith("<style>@layer theme, base, components, utilities;");
    assert doc.endsWith("</style>");
}
