// emilia-spacing — padding, margin, size and the space between children.
//
// The three utilities every component reaches for first. What this example is
// really showing is ONE rule, stated four ways:
//
//     EMILIA NEVER RESOLVES A SPACING VALUE.
//
// `.Pad.All.4` is `padding:calc(var(--spacing) * 4)` and never `padding:1rem`;
// `.Size.MaxW.X3xl` is `max-width:var(--container-3xl)` and never
// `max-width:48rem`. Every length this file produces lives in the theme's
// `:root` block, so a project that redefines `--spacing` or `--container-3xl`
// moves every utility that names it — WITHOUT emilia re-emitting a byte. The
// last test proves exactly that: the same token list under a theme with twice
// the spacing base is the same class, with the same declarations, and only the
// `:root` moves.
//
// Before front 35 this was not true and could not be: `padTokenToCss` emitted
// `padding-x:`, which is not a CSS property, and `Margin.X` emitted `m-1`,
// which is a Tailwind class name. Both were discarded by the browser in
// silence.
//
// Upstream: https://tailwindcss.com/docs/padding · /margin · /width · /height

import {emilia.emilia, emiliaWith, flushWith, Token} from "rakun-stylesheet";
import {Theme, ThemeEntry, DarkMode, defaultTheme, extendTheme} from "rakun-stylesheet";
import {Rule, Block, Sheet, Options} from "rakun-stylesheet";
import {defaultOptions, withTheme, emptyTheme} from "rakun-stylesheet";

// A document with no theme in it, so an assertion below reads as the rules the
// example registered rather than as the stock theme's hundred variables.
fn bareOptions() -> Options {
    return withTheme(defaultOptions(), emptyTheme());
}

// ── the scale ────────────────────────────────────────────────────────────────
//
// Thirty multipliers, the pixel step, and four half steps. `0.5` cannot be an
// enum leaf — a numeric leaf is a run of digits — so `Half.1` reads "one and a
// half" and covers upstream's `p-1.5`.

pub fn scaleLadder() -> Token[] {
    val out: Token[] = [
        .Pad.All.0,
        .Pad.All.1,
        .Pad.All.4,
        .Pad.All.12,
        .Pad.All.96,
        .Pad.All.Half.0,
        .Pad.All.Half.1,
        .Pad.All.Px,
    ];
    return out;
}

// ── nine directions ──────────────────────────────────────────────────────────
//
// `All`, the two axes, the four sides, and the logical pair `S`/`E` —
// `padding-inline-start` / `padding-inline-end` — which follow the writing
// direction where left and right do not. An AXIS IS TWO PROPERTIES: CSS has no
// `padding-x`, so `.Pad.X.6` is `padding-left` and `padding-right`, `;`-joined
// inside the one token.

pub fn paddingDirections() -> Token[] {
    val out: Token[] = [
        .Pad.All.4,
        .Pad.X.6,
        .Pad.Y.2,
        .Pad.T.1,
        .Pad.R.2,
        .Pad.B.3,
        .Pad.L.4,
        .Pad.S.5,
        .Pad.E.5,
    ];
    return out;
}

pub fn marginDirections() -> Token[] {
    val out: Token[] = [
        .Margin.All.Auto,
        .Margin.X.Auto,
        .Margin.Y.8,
        .Margin.T.1,
        .Margin.R.2,
        .Margin.B.3,
        .Margin.L.4,
        .Margin.S.5,
        .Margin.E.5,
    ];
    return out;
}

// ── the centred article shell ────────────────────────────────────────────────
//
// A max width from the theme's container ladder, `mx-auto`, and horizontal
// padding. Three tokens, one class, and — all three sitting in the same
// context — one rule.

pub fn articleShell() -> string {
    val tokens: Token[] = [.Size.MaxW.X3xl, .Margin.X.Auto, .Pad.X.6];
    return emilia(tokens);
}

// The header that escapes it: full viewport width, and a negative horizontal
// margin that cancels the shell's own padding. `-mx-6` has no alternative
// spelling upstream and none here either — `.Margin.X.Neg.6`.
pub fn fullBleedHeader() -> string {
    val tokens: Token[] = [.Size.W.Screen, .Margin.X.Neg.6, .Pad.Y.8];
    return emilia(tokens);
}

// ── sizing ───────────────────────────────────────────────────────────────────
//
// Four kinds of leaf: a NUMBER on the spacing ladder, a FRACTION carried by
// name (`1/2` is neither an identifier nor a run of digits), a KEYWORD that is
// an intrinsic size or a viewport unit, and a NAMED width read from the theme.
// The viewport unit DIFFERS BY AXIS — `w-screen` is `100vw`, `h-screen` is
// `100vh`.

pub fn mediaObject() -> string {
    val tokens: Token[] = [.Size.W.Frac.Third, .Size.MinH.Screen, .Size.MaxW.Md];
    return emilia(tokens);
}

// `size-12` — one leaf, two declarations.
pub fn avatar() -> string {
    val tokens: Token[] = [.Size.Both.12, .Size.MaxW.None];
    return emilia(tokens);
}

// The six logical forms, which a right-to-left document needs and which
// width/height cannot express.
pub fn logicalBox() -> string {
    val tokens: Token[] = [.Size.Inline.64, .Size.Block.32, .Size.MaxInline.Md];
    return emilia(tokens);
}

// ── the space between children ───────────────────────────────────────────────
//
// `space-y-*` is not a declaration on the element: it is a margin on its
// CHILDREN, so the rule it produces carries its own selector,
// `& > :not(:last-child)`. A stacked comment thread is the canonical use, and
// the last reply is pulled back up by a negative margin.

pub fn commentThread() -> string {
    val tokens: Token[] = [.Space.Y.4, .Pad.All.6, .Size.MaxW.X2xl];
    return emilia(tokens);
}

pub fn pulledReply() -> string {
    val tokens: Token[] = [.Margin.T.Neg.2, .Pad.L.8];
    return emilia(tokens);
}

// ── a project that halves the spacing base ───────────────────────────────────
//
// The point of the whole front, in one function: the theme moves, the
// utilities do not.

pub fn tightTheme() -> Theme {
    val tighter: ThemeEntry[] = [ThemeEntry(name: "--spacing", value: "0.125rem")];
    return extendTheme(defaultTheme(), tighter);
}

fn main() -> @Task<void> {
    @print(articleShell());
    @print(fullBleedHeader());
    @print(commentThread());
    @print(await flushWith(defaultOptions()));
}

// ── tests ────────────────────────────────────────────────────────────────────
// emilia is target-independent, so every assertion runs on `--target commonJS`
// and on `--target erlang`.

test "the scale is a ladder of multipliers, and `p-0` is a bare zero" {
    val cls = emilia(scaleLadder());
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("." + cls + "{padding:0;") != -1;
    assert doc.indexOf("padding:calc(var(--spacing) * 1);") != -1;
    assert doc.indexOf("padding:calc(var(--spacing) * 96);") != -1;
    assert doc.indexOf("padding:calc(var(--spacing) * 0.5);") != -1;
    assert doc.indexOf("padding:calc(var(--spacing) * 1.5);") != -1;
    assert doc.indexOf("padding:1px}") != -1;
}

test "an axis is two properties, because CSS has no `padding-x`" {
    val cls = emilia(paddingDirections());
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("padding-left:calc(var(--spacing) * 6);padding-right:calc(var(--spacing) * 6)")
        != -1;
    assert doc.indexOf("padding-top:calc(var(--spacing) * 2);padding-bottom:calc(var(--spacing) * 2)")
        != -1;
    assert doc.indexOf("padding-inline-start:calc(var(--spacing) * 5)") != -1;
    assert doc.indexOf("padding-inline-end:calc(var(--spacing) * 5)") != -1;
    assert doc.indexOf("padding-x") == -1;
    assert doc.indexOf("." + cls) != -1;
}

test "`m-auto` and `mx-auto` are the same value on two different expansions" {
    val _cls = emilia(marginDirections());
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("margin:auto;margin-left:auto;margin-right:auto") != -1;
    assert doc.indexOf("margin-inline-start:calc(var(--spacing) * 5)") != -1;
    assert doc.indexOf("margin-auto") == -1;
    assert doc.indexOf("m-1") == -1;
}

test "the centred shell is one class and one rule" {
    val cls = articleShell();
    val doc = await flushWith(bareOptions());
    assert doc
        == "<style>@layer theme, base, components, utilities;@layer utilities{."
            + cls
            + "{max-width:var(--container-3xl);margin-left:auto;margin-right:auto;"
            + "padding-left:calc(var(--spacing) * 6);padding-right:calc(var(--spacing) * 6)}}</style>";
}

test "the full-bleed header cancels the shell's padding with a negative margin" {
    val cls = fullBleedHeader();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + "{width:100vw;margin-left:calc(var(--spacing) * -6);"
        + "margin-right:calc(var(--spacing) * -6);padding-top:calc(var(--spacing) * 8);"
        + "padding-bottom:calc(var(--spacing) * 8)}")
        != -1;
}

test "sizing — a fraction, a viewport unit that knows its axis, and a named width" {
    val cls = mediaObject();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + "{width:calc(1 / 3 * 100%);min-height:100vh;max-width:var(--container-md)}")
        != -1;
}

test "sizing — `size-12` is one leaf and two declarations" {
    val cls = avatar();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + "{width:calc(var(--spacing) * 12);height:calc(var(--spacing) * 12);max-width:none}")
        != -1;
}

test "sizing — the six logical forms a right-to-left document needs" {
    val cls = logicalBox();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + "{inline-size:calc(var(--spacing) * 64);block-size:calc(var(--spacing) * 32);"
        + "max-inline-size:var(--container-md)}")
        != -1;
}

test "the thread spaces its CHILDREN, which is a second rule and a second selector" {
    val cls = commentThread();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + "{padding:calc(var(--spacing) * 6);max-width:var(--container-2xl)}")
        != -1;
    assert doc.indexOf(":where(."
        + cls
        + " > :not(:last-child)){--tw-space-y-reverse:0;margin-block-start:calc(calc(var(--spacing) * 4) * var(--tw-space-y-reverse));margin-block-end:calc(calc(var(--spacing) * 4) * calc(1 - var(--tw-space-y-reverse)))}")
        != -1;
}

test "the pulled reply is a negative margin, the one form with no alternative" {
    val cls = pulledReply();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + "{margin-top:calc(var(--spacing) * -2);padding-left:calc(var(--spacing) * 8)}")
        != -1;
}

// THE POINT OF THE FRONT. The same token list under a theme whose `--spacing`
// is half the stock value is the SAME CLASS with the SAME DECLARATIONS — the
// rule references the variable, it does not resolve it — and only the `:root`
// block moves. A `rem` ladder in the dispatcher would have made this override
// silently do nothing, which is exactly what emilia did before front 35.
test "halving the spacing base moves the theme and not one byte of the rule" {
    val tokens: Token[] = [.Pad.All.4, .Margin.X.Auto];
    val stock = emiliaWith(tokens, defaultTheme());
    val tight = emiliaWith(tokens, tightTheme());
    assert stock == tight;
    val doc = await flushWith(withTheme(defaultOptions(), tightTheme()));
    assert doc.indexOf("--spacing:0.125rem") != -1;
    assert doc.indexOf("."
        + stock
        + "{padding:calc(var(--spacing) * 4);margin-left:auto;margin-right:auto}")
        != -1;
}

test "no token in this example emits a resolved length or a class fragment" {
    val _a = emilia(scaleLadder());
    val _b = emilia(paddingDirections());
    val _c = emilia(marginDirections());
    val _d = articleShell();
    val _e = commentThread();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("rem") == -1;
    assert doc.indexOf("padding-x") == -1;
    assert doc.indexOf("margin-y") == -1;
    assert doc.indexOf("margin-auto") == -1;
}
