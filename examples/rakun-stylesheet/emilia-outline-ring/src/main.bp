// emilia-outline-ring — the three families that had no token at all.
//
// `outline-*` is how a focus ring is drawn WITHOUT MOVING LAYOUT: an outline
// is painted outside the border box and takes no space, where a border pushes
// everything beside it. `ring-*` is the other half of the same story, drawn as
// a box-shadow. `divide-*` separates a list's rows without putting a border on
// every child. None of the three existed before front 40, and the first and
// the third are how a real component shows focus and separation.
//
// Two of them cannot be a bare declaration, which is why they are the front's
// two `…ToSheet` dispatchers:
//
//   - `Divide` declares on the element's CHILDREN, so it needs a selector
//     outside the class. That selector is front 35's `siblingSelector()` —
//     the same one `space-y-*` uses — and front 40 CALLS it rather than
//     spelling `& > :not(:last-child)` a second time.
//   - `Ring` is a box-shadow that must COMPOSE with `Effect.Shadow` rather
//     than overwrite it, so its `box-shadow` lists `var(--tw-shadow)` instead
//     of writing a shadow of its own.
//
// The trap in this file is `outline-none`. Upstream prints it as a TRANSPARENT
// outline plus an offset, never as `outline-style:none`: a design that removes
// the ring still shows one in a high-contrast mode. A transcription that wrote
// `outline-style:none` would be silently inaccessible.

import {emilia, flushWith, Token} from "rakun-stylesheet";
import {Theme, ThemeEntry, DarkMode, Options} from "rakun-stylesheet";
import {Rule, Block, Sheet} from "rakun-stylesheet";
import {defaultOptions, withTheme, emptyTheme} from "rakun-stylesheet";

fn bareOptions() -> Options {
    return withTheme(defaultOptions(), emptyTheme());
}

// ── outline ──────────────────────────────────────────────────────────────────

pub fn outlineBasics() -> string {
    val tokens: Token[] = [
        .Outline.W.__2,
        .Outline.Style.Dashed,
        .Outline.Color.Indigo.__500,
        .Outline.Offset.__2,
    ];
    return emilia(tokens);
}

// A NEGATIVE offset pulls the outline inside the element — upstream's
// `-outline-offset-2`. It is a leaf on a `Neg` sub-section and not a sign on a
// number, because a numeric enum leaf is a run of digits.
pub fn insetOutline() -> string {
    val tokens: Token[] = [.Outline.W.__1, .Outline.Offset.Neg.__2];
    return emilia(tokens);
}

// THE TRAP. Two declarations of the SHORTHAND, and never `outline-style:none`.
pub fn removedOutline() -> string {
    val tokens: Token[] = [.Outline.Style.None];
    return emilia(tokens);
}

// ── ring ─────────────────────────────────────────────────────────────────────

pub fn ring() -> string {
    val tokens: Token[] = [.Ring.W.__2, .Ring.Color.Blue.__500];
    return emilia(tokens);
}

pub fn offsetRing() -> string {
    val tokens: Token[] = [
        .Ring.W.__2,
        .Ring.Offset.W.__2,
        .Ring.Offset.Color.White,
    ];
    return emilia(tokens);
}

pub fn insetRing() -> string {
    val tokens: Token[] = [.Ring.W.__4, .Ring.Inset];
    return emilia(tokens);
}

// A ring and a shadow in ONE list. The ring's `box-shadow` lists
// `var(--tw-shadow)`, which is the channel `Effect.Shadow` sets, so the two
// compose rather than the later one winning. `Effect.Shadow` is front 41's and
// is still a stub, so what this composition proves today is the CHANNEL — the
// ring writes no shadow of its own and therefore cannot clobber one.
pub fn ringAndShadow() -> string {
    val tokens: Token[] = [.Ring.W.__2, .Effect.Shadow.Md];
    return emilia(tokens);
}

pub fn shadowAndRing() -> string {
    val tokens: Token[] = [.Effect.Shadow.Md, .Ring.W.__2];
    return emilia(tokens);
}

// ── divide ───────────────────────────────────────────────────────────────────

pub fn dividedRows() -> string {
    val tokens: Token[] = [
        .Divide.Y.__1,
        .Divide.Color.Gray.__200,
    ];
    return emilia(tokens);
}

pub fn dividedColumns() -> string {
    val tokens: Token[] = [.Divide.X.__2, .Divide.Style.Dashed];
    return emilia(tokens);
}

// ── THE COMPOSITION THIS FRONT EXISTS FOR ────────────────────────────────────
//
// A form control whose focus ring is an OUTLINE — so focusing it moves nothing
// — above a segmented list whose rows are separated by a border on every child
// but the last.

pub fn formControl() -> string {
    val focus: Token[] = [
        .Outline.W.__2,
        .Outline.Color.Indigo.__500,
        .Outline.Offset.__2,
    ];
    val tokens: Token[] = [
        .Border.W.__1,
        .Border.Color.Slate.__300,
        .Border.Rounded.Md,
        Token.FocusVisible(focus),
    ];
    return emilia(tokens);
}

pub fn segmentedList() -> string {
    val tokens: Token[] = [
        .Border.W.__1,
        .Border.Color.Slate.__200,
        .Border.Rounded.Lg,
        .Divide.Y.__1,
        .Divide.Color.Slate.__200,
    ];
    return emilia(tokens);
}

// ── tests ────────────────────────────────────────────────────────────────────

// The composed `box-shadow` every shadow and ring token writes beside its own
// channel (emilia front 40/41: upstream's five channels, each with its null
// shadow as a fallback), spelled once for this example's assertions.
fn chain() -> string {
    return "var(--tw-inset-shadow, 0 0 transparent), var(--tw-inset-ring-shadow, 0 0 transparent), var(--tw-ring-offset-shadow, 0 0 transparent), var(--tw-ring-shadow, 0 0 transparent), var(--tw-shadow, 0 0 transparent)";
}

test "the four outline properties, each with its own token" {
    val cls = outlineBasics();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + "{outline-width:2px;outline-style:dashed;"
        + "outline-color:var(--color-indigo-500);outline-offset:2px}")
        != -1;
}

test "a negative outline offset is a leaf, not a sign on a number" {
    val cls = insetOutline();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("." + cls + "{outline-width:1px;outline-offset:-2px}")
        != -1;
}

// THE TRAP, asserted in both directions: the two declarations are present AND
// `outline-style:none` is absent. Only the second half catches a regression
// back to the obvious-but-wrong transcription.
test "outline-none is a transparent outline, never outline-style:none" {
    val cls = removedOutline();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + "{outline:2px solid transparent;"
        + "outline-offset:2px}")
        != -1;
    assert doc.indexOf("outline-style:none") == -1;
}

test "a ring is a custom property and a composed box-shadow" {
    val cls = ring();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + "{--tw-ring-shadow:var(--tw-ring-inset, ) 0 0 0 "
        + "calc(2px + var(--tw-ring-offset-width, 0px)) var(--tw-ring-color, currentcolor);"
        + "box-shadow:"
        + chain()
        + ";--tw-ring-color:var(--color-blue-500)}")
        != -1;
}

test "the ring offset is two custom properties, width and colour" {
    val cls = offsetRing();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("--tw-ring-offset-width:2px") != -1;
    assert doc.indexOf("--tw-ring-offset-color:var(--color-white)") != -1;
    assert doc.indexOf("." + cls) != -1;
}

test "ring-inset sets the inset flag and nothing else" {
    val cls = insetRing();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("--tw-ring-inset:inset") != -1;
    assert doc.indexOf("." + cls) != -1;
}

// COMPOSITION, NOT CLOBBERING — and CONTRACT 4 in the same test. The ring
// never writes a literal shadow, so `Effect.Shadow`'s value survives beside it;
// and swapping the two changes the class, because token order IS class
// identity.
test "a ring composes with a shadow, and swapping them is a different class" {
    val a = ringAndShadow();
    val b = shadowAndRing();
    assert a != b;
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("var(--tw-shadow, 0 0 transparent)") != -1;
    assert doc.indexOf("--tw-shadow:var(--shadow-") != -1;
    assert doc.indexOf("." + a) != -1;
    assert doc.indexOf("." + b) != -1;
}

// DIVIDE DECLARES ON THE CHILDREN. The class body itself is empty — there is
// no `.cls{…}` rule at all — and everything lands under the sibling selector.
test "a divided list declares on its children, not on itself" {
    val cls = dividedRows();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf(":where(."
        + cls
        + " > :not(:last-child)){"
        + "--tw-divide-y-reverse:0;border-top-width:calc(1px * var(--tw-divide-y-reverse));border-bottom-width:calc(1px * calc(1 - var(--tw-divide-y-reverse)));"
        + "border-color:var(--color-gray-200)}")
        != -1;
    assert doc.indexOf("." + cls + "{") == -1;
}

test "divide-x is the logical pair, and a style joins the same child rule" {
    val cls = dividedColumns();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf(":where(."
        + cls
        + " > :not(:last-child)){"
        + "--tw-divide-x-reverse:0;border-inline-start-width:calc(2px * var(--tw-divide-x-reverse));border-inline-end-width:calc(2px * calc(1 - var(--tw-divide-x-reverse)));"
        + "border-style:dashed}")
        != -1;
}

test "end to end — a form control whose focus ring moves no layout" {
    val cls = formControl();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + "{border-width:1px;"
        + "border-color:var(--color-slate-300);"
        + "border-radius:var(--radius-md)}")
        != -1;
    assert doc.indexOf("."
        + cls
        + ":focus-visible{outline-width:2px;"
        + "outline-color:var(--color-indigo-500);outline-offset:2px}")
        != -1;
    // The focus state adds NO width and NO shadow, so focusing the control
    // reflows nothing. That is the whole reason `outline-*` exists.
    assert doc.indexOf(":focus-visible{border") == -1;
    assert doc.indexOf(":focus-visible{box-shadow") == -1;
}

test "end to end — a segmented list borders itself and divides its rows" {
    val cls = segmentedList();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + "{border-width:1px;"
        + "border-color:var(--color-slate-200);"
        + "border-radius:var(--radius-lg)}")
        != -1;
    assert doc.indexOf(":where(."
        + cls
        + " > :not(:last-child)){"
        + "--tw-divide-y-reverse:0;border-top-width:calc(1px * var(--tw-divide-y-reverse));border-bottom-width:calc(1px * calc(1 - var(--tw-divide-y-reverse)));"
        + "border-color:var(--color-slate-200)}")
        != -1;
}

// The cross-front invariant, asserted from a CONSUMER package: `divide-*` and
// `space-y-*` separate the same children, so they must use the same selector.
// Front 35 shipped `siblingSelector()` and could not write this test, because
// `Divide` did not exist.
test "divide and space use the same child selector, seen from outside" {
    val d: Token[] = [.Divide.Y.__1];
    val s: Token[] = [.Space.Y.__4];
    val dCls = emilia(d);
    val sCls = emilia(s);
    val doc = await flushWith(bareOptions());
    assert doc.indexOf(":where(." + dCls + " > :not(:last-child)){") != -1;
    assert doc.indexOf(":where(." + sCls + " > :not(:last-child)){") != -1;
}

test "no token in this example resolves a colour or a length" {
    val _a = outlineBasics();
    val _b = insetOutline();
    val _c = ring();
    val _d = offsetRing();
    val _e = dividedRows();
    val _f = dividedColumns();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("rem") == -1;
    assert doc.indexOf("#") == -1;
    assert doc.indexOf("oklch(") == -1;
}
