// emilia-text-decoration — `§ 9`'s text half, end to end, in a real package.
//
// Before front 38, `underline` and `line-through` emitted the
// `text-decoration` SHORTHAND, and the other four groups of the decoration
// family — style, thickness, colour and underline-offset — had no token at
// all. The shorthand is what made the family inexpressible: a `text-decoration`
// OVERWRITES a sibling `text-decoration-style`, so `underline` +
// `decoration-dotted` could never be one rule. Everything below the first
// section — lists, whitespace, word-breaking, hyphens, indent, vertical-align
// and `content` — had no token either.
//
// THIS FILE IS A CONSUMER PACKAGE. The decoration colour is asserted from
// outside the library on purpose: it goes through front 33's `paletteVar`, so
// a decoration colour and a text colour reference ONE custom property, and the
// eleven shades of a family are eleven distinct classes rather than one.
//
// Upstream: https://tailwindcss.com/docs/text-decoration-line ·
// /text-decoration-color · /text-decoration-style · /text-decoration-thickness ·
// /text-underline-offset · /list-style-type · /white-space · /word-break ·
// /hyphens · /text-indent · /vertical-align · /content

import {emilia.emilia, flushWith, Token} from "rakun-stylesheet";
import {Theme, ThemeEntry, DarkMode, defaultTheme, extendTheme} from "rakun-stylesheet";
import {Rule, Block, Sheet, Options} from "rakun-stylesheet";
import {defaultOptions, withTheme, emptyTheme} from "rakun-stylesheet";

fn bareOptions() -> Options {
    return withTheme(defaultOptions(), emptyTheme());
}

// ── the four decoration LINES, on the longhand ───────────────────────────────

pub fn lines() -> string[] {
    val a: Token[] = [.Text.Underline];
    val b: Token[] = [.Text.Overline];
    val c: Token[] = [.Text.LineThrough];
    val d: Token[] = [.Text.NoUnderline];
    val out: string[] = [emilia(a), emilia(b), emilia(c), emilia(d)];
    return out;
}

// THE COMPOSITION THE SHORTHAND MADE IMPOSSIBLE: a line and a style in one
// rule, on two different properties.
pub fn dottedUnderline() -> string {
    val tokens: Token[] = [.Text.Underline, .Text.Decoration.Style.Dotted];
    return emilia(tokens);
}

// ── style, thickness, offset ─────────────────────────────────────────────────

pub fn styles() -> string {
    val tokens: Token[] = [.Text.Underline, .Text.Decoration.Style.Wavy];
    return emilia(tokens);
}

pub fn thickness() -> string {
    val tokens: Token[] = [.Text.Underline, .Text.Decoration.Thickness.4];
    return emilia(tokens);
}

// `from-font` asks the typeface for its own thickness, which is the one value
// on the ladder that is not a length.
pub fn fromFont() -> string {
    val tokens: Token[] = [.Text.Underline, .Text.Decoration.Thickness.FromFont];
    return emilia(tokens);
}

pub fn offset() -> string {
    val tokens: Token[] = [.Text.Underline, .Text.Decoration.Offset.4];
    return emilia(tokens);
}

// ── the colour, through front 33's palette ───────────────────────────────────

pub fn colouredUnderline() -> string {
    val tokens: Token[] = [.Text.Underline, .Text.Decoration.Color.Sky.500];
    return emilia(tokens);
}

// Three shades of one family are THREE classes. They would be one if the
// dispatcher discarded the shade — the defect `Border.Color` carried for two
// milestones — because the class name hashes the rule body.
pub fn shades() -> string[] {
    val a: Token[] = [.Text.Decoration.Color.Rose.100];
    val b: Token[] = [.Text.Decoration.Color.Rose.500];
    val c: Token[] = [.Text.Decoration.Color.Rose.900];
    val out: string[] = [emilia(a), emilia(b), emilia(c)];
    return out;
}

// ── lists ────────────────────────────────────────────────────────────────────

pub fn bulletList() -> string {
    val tokens: Token[] = [.List.Disc, .List.Inside];
    return emilia(tokens);
}

pub fn barefootList() -> string {
    val tokens: Token[] = [.List.None, .List.ImageNone];
    return emilia(tokens);
}

// ── whitespace, breaking, hyphens ────────────────────────────────────────────

// A code sample keeps its newlines and does not wrap.
pub fn codeBlock() -> string {
    val tokens: Token[] = [.Font.Mono, .Text.Whitespace.Pre];
    return emilia(tokens);
}

// A long URL in a narrow column: `break-all` cuts anywhere, `wrap-anywhere`
// lets the box shrink to the smallest word first. The two are DIFFERENT
// properties, which is why `Break` and `OverflowWrap` are two sections.
pub fn longUrl() -> string {
    val tokens: Token[] = [.Text.Break.All];
    return emilia(tokens);
}

pub fn anywhere() -> string {
    val tokens: Token[] = [.Text.OverflowWrap.Anywhere];
    return emilia(tokens);
}

pub fn justified() -> string {
    val tokens: Token[] = [.Text.Justify, .Text.Hyphens.Auto];
    return emilia(tokens);
}

// ── indent, vertical-align, tab, content ─────────────────────────────────────

// The indent is a MULTIPLIER of `--spacing`, the same one `.Pad.All.8` reads.
pub fn indented() -> string {
    val tokens: Token[] = [.Text.Indent.8];
    return emilia(tokens);
}

pub fn footnoteMarker() -> string {
    val tokens: Token[] = [.Text.Align.Super, .Text.Size.Xs];
    return emilia(tokens);
}

pub fn tabbed() -> string {
    val tokens: Token[] = [.Text.Tab.4];
    return emilia(tokens);
}

// `content-['']` on a pseudo-element: two quote characters inside a CSS value,
// carried through the host cell's codec unharmed.
pub fn emptyContent() -> string {
    val inner: Token[] = [.Text.Content.Empty];
    val tokens: Token[] = [Token.Before(inner)];
    return emilia(tokens);
}

// ── THE COMPOSITION THIS FRONT EXISTS FOR ────────────────────────────────────
//
// A footnote-bearing paragraph: justified and hyphenated body text, a
// superscript marker, and links underlined with a wavy sky rule set a little
// below the baseline. Four of the paragraph's properties and all four of the
// link's are tokens this front added.

pub fn footnoteParagraph() -> string {
    val tokens: Token[] = [
        .Text.Justify,
        .Text.Hyphens.Auto,
        .Text.Indent.8,
        .Text.Leading.Relaxed,
    ];
    return emilia(tokens);
}

pub fn wavyLink() -> string {
    val tokens: Token[] = [
        .Text.Underline,
        .Text.Decoration.Style.Wavy,
        .Text.Decoration.Color.Sky.500,
        .Text.Decoration.Thickness.2,
        .Text.Decoration.Offset.4,
    ];
    return emilia(tokens);
}

// ── tests ────────────────────────────────────────────────────────────────────

test "the four lines are the LONGHAND, and the shorthand is gone" {
    val cls = lines();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("." + cls[0] + "{text-decoration-line:underline}") != -1;
    assert doc.indexOf("." + cls[1] + "{text-decoration-line:overline}") != -1;
    assert doc.indexOf("." + cls[2] + "{text-decoration-line:line-through}")
        != -1;
    assert doc.indexOf("." + cls[3] + "{text-decoration-line:none}") != -1;
    assert doc.indexOf("{text-decoration:") == -1;
}

test "a line COMPOSES with a style, which the shorthand made impossible" {
    val cls = dottedUnderline();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + "{text-decoration-line:underline;text-decoration-style:dotted}")
        != -1;
}

test "style, thickness and offset" {
    val a = styles();
    val b = thickness();
    val c = fromFont();
    val d = offset();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + a
        + "{text-decoration-line:underline;text-decoration-style:wavy}")
        != -1;
    assert doc.indexOf("."
        + b
        + "{text-decoration-line:underline;text-decoration-thickness:4px}")
        != -1;
    assert doc.indexOf("."
        + c
        + "{text-decoration-line:underline;text-decoration-thickness:from-font}")
        != -1;
    assert doc.indexOf("."
        + d
        + "{text-decoration-line:underline;text-underline-offset:4px}")
        != -1;
}

test "a decoration colour is the palette's reference, with its shade" {
    val a = colouredUnderline();
    val cls = shades();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + a
        + "{text-decoration-line:underline;text-decoration-color:var(--color-sky-500)}")
        != -1;
    // Three shades, three classes — asserted from a CONSUMER package, which is
    // what catches a dispatcher that discards its payload.
    assert cls[0] != cls[1];
    assert cls[1] != cls[2];
    assert doc.indexOf("."
        + cls[0]
        + "{text-decoration-color:var(--color-rose-100)}")
        != -1;
    assert doc.indexOf("."
        + cls[1]
        + "{text-decoration-color:var(--color-rose-500)}")
        != -1;
    assert doc.indexOf("."
        + cls[2]
        + "{text-decoration-color:var(--color-rose-900)}")
        != -1;
}

test "lists answer three properties over six leaves" {
    val a = bulletList();
    val b = barefootList();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + a
        + "{list-style-type:disc;list-style-position:inside}")
        != -1;
    assert doc.indexOf("." + b + "{list-style-type:none;list-style-image:none}")
        != -1;
}

test "whitespace, breaking and hyphens are four distinct properties" {
    val a = codeBlock();
    val b = longUrl();
    val c = anywhere();
    val d = justified();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + a
        + "{font-family:var(--font-mono);white-space:pre}")
        != -1;
    assert doc.indexOf("." + b + "{word-break:break-all}") != -1;
    assert doc.indexOf("." + c + "{overflow-wrap:anywhere}") != -1;
    assert doc.indexOf("." + d + "{text-align:justify;hyphens:auto}") != -1;
    // `wrap-anywhere` has no `break-*` spelling: merging the two sections
    // would have lost this class entirely.
    assert b != c;
}

test "indent is a spacing multiplier; align, tab and content are their own" {
    val a = indented();
    val b = footnoteMarker();
    val c = tabbed();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("." + a + "{text-indent:calc(var(--spacing) * 8)}")
        != -1;
    assert doc.indexOf("."
        + b
        + "{vertical-align:super;"
        + "font-size:var(--text-xs);line-height:var(--text-xs--line-height)}")
        != -1;
    assert doc.indexOf("." + c + "{tab-size:4}") != -1;
}

test "content-[''] survives the codec with both quote characters" {
    val cls = emptyContent();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("." + cls + "::before{content:\"\"}") != -1;
}

test "end to end — a footnoted paragraph whose links are wavy-underlined" {
    val para = footnoteParagraph();
    val link = wavyLink();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + para
        + "{text-align:justify;hyphens:auto;"
        + "text-indent:calc(var(--spacing) * 8);line-height:var(--leading-relaxed)}")
        != -1;
    assert doc.indexOf("."
        + link
        + "{text-decoration-line:underline;"
        + "text-decoration-style:wavy;text-decoration-color:var(--color-sky-500);"
        + "text-decoration-thickness:2px;text-underline-offset:4px}")
        != -1;
}

// ── the front's argument, asserted from OUTSIDE the library ──────────────────

test "a decoration colour and a text colour are ONE custom property" {
    val dec: Token[] = [.Text.Decoration.Color.Sky.500];
    val txt: Token[] = [.Color.Sky.500];
    val a = emilia(dec);
    val b = emilia(txt);
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("." + a + "{text-decoration-color:var(--color-sky-500)}")
        != -1;
    assert doc.indexOf("." + b + "{color:var(--color-sky-500)}") != -1;
    // A project override moves both, because there is one reference and not
    // two transcriptions.
    val brand: ThemeEntry[] = [ThemeEntry(name: "--color-sky-500", value: "#0ea5e9")];
    val th = extendTheme(defaultTheme(), brand);
    val doc2 = await flushWith(withTheme(defaultOptions(), th));
    assert doc2.indexOf("--color-sky-500:#0ea5e9") != -1;
}

test "nothing in this example resolves a colour or a length that upstream does not" {
    val _a = lines();
    val _b = dottedUnderline();
    val _c = colouredUnderline();
    val _d = bulletList();
    val _e = codeBlock();
    val _f = justified();
    val _g = indented();
    val _h = footnoteParagraph();
    val _i = wavyLink();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("rem") == -1;
    assert doc.indexOf("#") == -1;
    assert doc.indexOf("oklch(") == -1;
    assert doc.indexOf("decoration-wavy") == -1;
    assert doc.indexOf("list-disc") == -1;
    // The two `px` counts are upstream's own (`§ 9.20`, `§ 9.21`) and are
    // asserted by name, so a front that made them theme entries would have to
    // change this line.
    assert doc.indexOf("text-decoration-thickness:2px") != -1;
    assert doc.indexOf("text-underline-offset:4px") != -1;
}
