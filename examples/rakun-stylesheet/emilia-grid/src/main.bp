// emilia-grid — how a box lays its children out, in one dimension and in two.
//
// Before front 37 emilia could say `display:flex` and then almost nothing. A
// flex item could not grow, could not shrink, could not be reordered and could
// not be given a basis, so the single most common reason to reach for flexbox
// — "this one takes the remaining space" — had no spelling. Grid had no token
// at all: `display:grid` declared a box and there was nothing to put in it. Two
// thirds of the alignment vocabulary was missing, and `gap` lived under `Flex`
// although it belongs to both. This example is the other side of that.
//
// ONE RULE GOVERNS THE TWO NUMERIC FAMILIES THAT ARE LENGTHS. `Gap` and
// `Flex.Basis` are MULTIPLIERS of `--spacing` and reach the same `spacing(n)`
// front 35's `Pad` reaches: `.Gap.All.4`, `.Flex.Basis.4` and `.Pad.All.4`
// carry the same length text because they call the same function. Everything
// else here — a grow factor, an order, a column count, a span, a line number —
// is a bare integer and has nothing in it for a theme to resolve. The last test
// in this file is the whole argument: nothing here emits a `rem`.
//
// `Gap` IS TOP LEVEL, because `gap` separates the items of a grid exactly as it
// separates the items of a flex row. The pre-37 `.Flex.Gap.N` paths still work
// and now emit the same declaration.
//
// Upstream: https://tailwindcss.com/docs/flex-direction · /flex · /flex-basis ·
// /order · /justify-content · /align-items · /place-items ·
// /grid-template-columns · /grid-column · /grid-auto-flow · /gap

import {emilia.emilia, emiliaWith, flushWith, Token} from "rakun-stylesheet";
import {Theme, ThemeEntry, DarkMode, defaultTheme, extendTheme} from "rakun-stylesheet";
import {Rule, Block, Sheet, Options} from "rakun-stylesheet";
import {defaultOptions, withTheme, emptyTheme} from "rakun-stylesheet";
import {io.terminal.print} from "std";

fn bareOptions() -> Options {
    return withTheme(defaultOptions(), emptyTheme());
}

pub fn directionValues() -> Token[] {
    val out: Token[] = [
        .Flex.Row,
        .Flex.RowReverse,
        .Flex.Col,
        .Flex.ColReverse,
        .Flex.Wrap,
        .Flex.WrapReverse,
        .Flex.NoWrap,
    ];
    return out;
}

pub fn itemSizing() -> Token[] {
    val out: Token[] = [
        .Flex.Value.One,
        .Flex.Basis.0,
        .Flex.Grow.1,
        .Flex.Shrink.0,
        .Flex.Order.First,
    ];
    return out;
}

pub fn alignmentGroups() -> Token[] {
    val out: Token[] = [
        .Flex.Justify.Between,
        .Flex.Items.Baseline,
        .Flex.AlignSelf.Start,
        .Flex.Content.Evenly,
        .Flex.JustifyItems.Start,
        .Flex.JustifySelf.Center,
        .Flex.PlaceContent.Between,
        .Flex.PlaceItems.Center,
        .Flex.PlaceSelf.Stretch,
    ];
    return out;
}

pub fn templates() -> Token[] {
    val out: Token[] = [
        .Grid.Cols.12,
        .Grid.Rows.3,
        .Grid.Cols.None,
        .Grid.Rows.Subgrid,
    ];
    return out;
}

pub fn placement() -> Token[] {
    val out: Token[] = [
        .Grid.Col.Span.2,
        .Grid.Col.Span.Full,
        .Grid.Col.Start.13,
        .Grid.Row.Span.Full,
        .Grid.Row.End.3,
    ];
    return out;
}

pub fn flowAndTracks() -> Token[] {
    val out: Token[] = [
        .Grid.Flow.RowDense,
        .Grid.Flow.ColDense,
        .Grid.AutoCols.Fr,
        .Grid.AutoRows.Min,
    ];
    return out;
}

pub fn gapValues() -> Token[] {
    val out: Token[] = [
        .Gap.All.0,
        .Gap.All.4,
        .Gap.All.Px,
        .Gap.X.2,
        .Gap.Y.6,
    ];
    return out;
}

pub fn toolbarBar() -> string {
    val stackUnderSm: Token[] = [.Flex.Col, .Flex.Items.Start];
    val bar: Token[] = [
        .Layout.Flex,
        .Flex.Row,
        .Flex.Wrap,
        .Flex.Items.Center,
        .Flex.Justify.Between,
        .Gap.All.3,
        .Pad.X.4,
        .Pad.Y.2,
        Token.MaxSm(stackUnderSm),
    ];
    return emilia(bar);
}

pub fn toolbarHeading() -> string {
    val heading: Token[] = [.Flex.Value.One, .Flex.Basis.0, .Text.Bold];
    return emilia(heading);
}

pub fn toolbarAction() -> string {
    val trailing: Token[] = [
        .Flex.Shrink.0,
        .Flex.Order.Last,
        .Flex.AlignSelf.Center,
        .Pad.X.3,
    ];
    return emilia(trailing);
}

pub fn dashboardShell() -> string {
    val sixFromMd: Token[] = [.Grid.Cols.6];
    val twelveFromLg: Token[] = [.Grid.Cols.12];
    val shell: Token[] = [
        .Layout.Grid,
        .Grid.Cols.1,
        .Gap.All.4,
        .Pad.All.6,
        Token.Md(sixFromMd),
        Token.Lg(twelveFromLg),
    ];
    return emilia(shell);
}

pub fn dashboardChart() -> string {
    val spanFromLg: Token[] = [.Grid.Col.Span.8];
    val chart: Token[] = [.Grid.Col.Span.Full, .Pad.All.4, Token.Lg(spanFromLg)];
    return emilia(chart);
}

pub fn dashboardAside() -> string {
    val spanFromLg: Token[] = [.Grid.Col.Span.4];
    val aside: Token[] = [
        .Grid.Col.Span.Full,
        .Grid.AutoRows.Min,
        .Gap.Y.3,
        .Pad.All.4,
        Token.Lg(spanFromLg),
    ];
    return emilia(aside);
}

pub fn dashboardFooter() -> string {
    val footer: Token[] = [
        .Grid.Col.Span.Full,
        .Grid.Flow.ColDense,
        .Flex.PlaceItems.Center,
    ];
    return emilia(footer);
}

async fn main() -> Async<void> {
    print(toolbarBar());
    print(toolbarHeading());
    print(toolbarAction());
    print(dashboardShell());
    print(dashboardChart());
    print(dashboardAside());
    print(dashboardFooter());
    print(await flushWith(defaultOptions()));
}

// A theme whose spacing base is half the stock value. Nothing in this file
// resolves a length, so every rule below is byte-identical under it.
pub fn tightTheme() -> Theme {
    val tighter: ThemeEntry[] = [ThemeEntry(name: "--spacing", value: "0.125rem")];
    return extendTheme(defaultTheme(), tighter);
}

// ── tests ────────────────────────────────────────────────────────────────────
// emilia is target-independent, so every assertion runs on `--target commonJS`
// and on `--target erlang`.

test "direction and wrap — the three reverse rows beside the four that predate 37" {
    val cls = emilia(directionValues());
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + "{flex-direction:row;flex-direction:row-reverse;"
        + "flex-direction:column;flex-direction:column-reverse;"
        + "flex-wrap:wrap;flex-wrap:wrap-reverse;flex-wrap:nowrap}")
        != -1;
}

test "the item properties — a shorthand of three components and two sentinels" {
    val cls = emilia(itemSizing());
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + "{flex:1 1 0%;flex-basis:0;flex-grow:1;"
        + "flex-shrink:0;order:-9999}")
        != -1;
    assert doc.indexOf("flex:1 1 0%") != -1;
    assert doc.indexOf("order:first") == -1;
}

// All nine groups of `§ 6.16`–`§ 6.24` in ONE rule, which is also the proof
// that a grid container reaches every one of them: five of the nine are
// grid-only properties and they are spelled `.Flex.*` like the rest.
test "the alignment family — nine property groups in one rule" {
    val cls = emilia(alignmentGroups());
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + "{justify-content:space-between;"
        + "align-items:baseline;align-self:flex-start;align-content:space-evenly;"
        + "justify-items:start;justify-self:center;place-content:space-between;"
        + "place-items:center;place-self:stretch}")
        != -1;
}

// The asymmetry upstream documents and emilia copies: the same leaf name is
// `flex-start` on four properties and `start` on five.
test "`Justify.Start` is `flex-start` and `JustifyItems.Start` is `start`" {
    val cls = emilia([.Flex.Justify.Start, .Flex.JustifyItems.Start]);
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + "{justify-content:flex-start;justify-items:start}")
        != -1;
    assert doc.indexOf("justify-items:flex-start") == -1;
}

test "templates — a repeat built from the leaf, and two keywords beside it" {
    val cls = emilia(templates());
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + "{grid-template-columns:repeat(12, minmax(0, 1fr));"
        + "grid-template-rows:repeat(3, minmax(0, 1fr));"
        + "grid-template-columns:none;grid-template-rows:subgrid}")
        != -1;
    assert doc.indexOf("repeat(12,minmax(0,1fr))") == -1;
}

test "placement — a span is doubled, `full` is line-based, and line 13 exists" {
    val cls = emilia(placement());
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + "{grid-column:span 2 / span 2;grid-column:1 / -1;"
        + "grid-column-start:13;grid-row:1 / -1;grid-row-end:3}")
        != -1;
}

test "flow and implicit tracks — two words keep one space" {
    val cls = emilia(flowAndTracks());
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + "{grid-auto-flow:row dense;"
        + "grid-auto-flow:column dense;grid-auto-columns:minmax(0, 1fr);"
        + "grid-auto-rows:min-content}")
        != -1;
    assert doc.indexOf("grid-auto-flow:row-dense") == -1;
}

test "gap — one shorthand, two axes, and the pixel step" {
    val cls = emilia(gapValues());
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + "{gap:0;gap:calc(var(--spacing) * 4);gap:1px;"
        + "column-gap:calc(var(--spacing) * 2);row-gap:calc(var(--spacing) * 6)}")
        != -1;
}

// The pendency this front closed: `Flex.Gap` used to answer a hand-written
// `rem` ladder — `gap-4` was `gap:1rem`. The two spellings are compared to EACH
// OTHER rather than each to an expected string, so they cannot drift again.
test "the pre-37 `.Flex.Gap.4` and the new `.Gap.All.4` are one declaration" {
    val legacy = emilia([.Flex.Gap.4]);
    val current = emilia([.Gap.All.4]);
    val doc = await flushWith(bareOptions());
    assert legacy == current;
    assert doc.indexOf("." + legacy + "{gap:calc(var(--spacing) * 4)}") != -1;
    assert doc.indexOf("gap:1rem") == -1;
}

// THE COMPOSITION THE FLEX GAP WAS BLOCKING. A toolbar that is a row from `sm`
// up and a stack below it, whose title takes the remaining space (`flex:1 1 0%`
// with `flex-basis:0`) and whose action neither shrinks nor moves from the end.
test "the toolbar gives its heading the remaining space" {
    val bar = toolbarBar();
    val heading = toolbarHeading();
    val action = toolbarAction();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + bar
        + "{display:flex;flex-direction:row;flex-wrap:wrap;"
        + "align-items:center;justify-content:space-between;"
        + "gap:calc(var(--spacing) * 3);")
        != -1;
    assert doc.indexOf("@media (width < 40rem){."
        + bar
        + "{flex-direction:column;align-items:flex-start}}")
        != -1;
    assert doc.indexOf("."
        + heading
        + "{flex:1 1 0%;flex-basis:0;font-weight:bold}")
        != -1;
    assert doc.indexOf("."
        + action
        + "{flex-shrink:0;order:9999;align-self:center;")
        != -1;
}

// THE COMPOSITION GRID WAS BLOCKING ENTIRELY. One column on a phone, six from
// `md`, twelve from `lg`; the chart panel is full width until `lg` and then
// eight of the twelve; the sidebar takes the other four and sizes its rows to
// content.
test "the dashboard reflows from one column to twelve" {
    val shell = dashboardShell();
    val chart = dashboardChart();
    val aside = dashboardAside();
    val footer = dashboardFooter();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + shell
        + "{display:grid;"
        + "grid-template-columns:repeat(1, minmax(0, 1fr));"
        + "gap:calc(var(--spacing) * 4);padding:calc(var(--spacing) * 6)}")
        != -1;
    assert doc.indexOf("@media (width >= 48rem){."
        + shell
        + "{grid-template-columns:repeat(6, minmax(0, 1fr))}}")
        != -1;
    assert doc.indexOf("@media (width >= 64rem){."
        + shell
        + "{grid-template-columns:repeat(12, minmax(0, 1fr))}}")
        != -1;
    assert doc.indexOf("@media (width >= 64rem){."
        + chart
        + "{grid-column:span 8 / span 8}}")
        != -1;
    assert doc.indexOf("."
        + aside
        + "{grid-column:1 / -1;grid-auto-rows:min-content;"
        + "row-gap:calc(var(--spacing) * 3);")
        != -1;
    assert doc.indexOf("."
        + footer
        + "{grid-column:1 / -1;"
        + "grid-auto-flow:column dense;place-items:center}")
        != -1;
}

// THE POINT OF THE FRONT'S TWO LENGTH FAMILIES. The same token list under a
// theme whose `--spacing` is half the stock value is the SAME CLASS with the
// SAME DECLARATIONS — the rule references the variable, it does not resolve it
// — and only the `:root` block moves.
test "halving the spacing base moves the theme and not one byte of the rule" {
    val tokens: Token[] = [.Layout.Grid, .Grid.Cols.12, .Gap.All.4, .Flex.Basis.8];
    val stock = emiliaWith(tokens, defaultTheme());
    val tight = emiliaWith(tokens, tightTheme());
    assert stock == tight;
    val doc = await flushWith(withTheme(defaultOptions(), tightTheme()));
    assert doc.indexOf("--spacing:0.125rem") != -1;
    assert doc.indexOf("."
        + stock
        + "{display:grid;"
        + "grid-template-columns:repeat(12, minmax(0, 1fr));"
        + "gap:calc(var(--spacing) * 4);flex-basis:calc(var(--spacing) * 8)}")
        != -1;
}

// Every token in this example references the theme or emits an integer. The
// document below carries no `rem` at all — not in a gap, not in a basis, not in
// a template — and no Tailwind class fragment either.
//
// The two compositions are left out of the walk on purpose: a BREAKPOINT QUERY
// reads its width from the theme's `--breakpoint-md`, which IS a `rem`
// (`@media (width >= 48rem)`). That is front 34's at-rule and front 54's
// ladder, and it is not a declaration — no rule this front writes carries it.
test "no token in this example resolves a length" {
    val _a = emilia(directionValues());
    val _b = emilia(itemSizing());
    val _c = emilia(alignmentGroups());
    val _d = emilia(templates());
    val _e = emilia(placement());
    val _f = emilia(flowAndTracks());
    val _g = emilia(gapValues());
    val _h = emilia([.Grid.Col.Span.8, .Grid.AutoRows.Min, .Gap.Y.3, .Flex.Basis.Frac.Third]);
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("rem") == -1;
    assert doc.indexOf("gap-4") == -1;
    assert doc.indexOf("basis-") == -1;
    assert doc.indexOf("grid-cols-") == -1;
    assert doc.indexOf("col-span-") == -1;
    assert doc.indexOf("order-first") == -1;
}
