import {service, profile, autoConfiguration, rkScan, rkSingleton, rkEnter, rkDone, rkResolve, rkRegisterBean, rkAutoRegister, rkAutoProvides, rkAutoGate} from "rakun";
import {autoConfigure, isAutoConfigured, autoConfigurationReport, rkAddBean, rkInstallBeans} from "rakun";
import {collections.Dict, io.terminal.print} from "std";

pub type MailSender(host: string)

#[service]
#[profile("prod")]
pub type MailAuditService(
    sender: MailSender,
)

fn beans() -> Dict<string, unknown> {
    return comptime {
        var d: Dict<string, unknown> = Dict.empty();
        for (@TypeInfo.all(with: [service], member: "make")) { b ->
            d = rkAddBean(d, b.name, b.value);
        }
        d
    };
}

fn main() {
    val _beans = rkInstallBeans(beans());
    val _ = autoConfigure();
    // Off its profile the component is left unbuilt and reported.
    print(isAutoConfigured("MailAuditService").toString());
    print(autoConfigurationReport());
}
