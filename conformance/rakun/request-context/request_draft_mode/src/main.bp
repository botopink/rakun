import {RequestPhase, RequestScope, beginRequest, endRequest, draftMode, connection, isDynamic, dynamicReason, DraftMode} from "rakun";
import {io.terminal.print} from "std";

fn main() -> void {
    val _e = beginRequest(RequestScope(
        id: "req-1",
        phase: RequestPhase.Handler,
        method: "GET",
        path: "/",
        query: "",
        headersWire: "",
        strict: false,
    ));
    print(isDynamic().toString());
    // `connection()` marks and reads nothing: the way a route declares itself
    // dynamic without pretending to need a header.
    val _c = connection();
    print(isDynamic().toString());
    print(dynamicReason());
    val draft: DraftMode = draftMode();
    if (draft.isEnabled()) print("draft") else print("published");
    val _x = endRequest();
}
