import {RequestPhase, RequestScope, beginRequest, endRequest, requestPhase, requestId, requestPath, requestQuery, phaseName, requestLive} from "rakun";
import {io.terminal.print} from "std";

fn runHandler() -> string {
    return phaseName(requestPhase())
        + " "
        + requestId()
        + " "
        + requestPath()
        + "?"
        + requestQuery();
}

fn main() {
    val wire = "accept\ttext/html";
    val epoch = beginRequest(RequestScope(
        id: "req-77",
        phase: RequestPhase.Handler,
        method: "GET",
        path: "/api/posts",
        query: "page=2",
        headersWire: wire,
        strict: false,
    ));
    val body = runHandler();
    val setCookies = endRequest();
    print(body);
    print("[" + setCookies + "]");
    // Reading outside a request is a hard failure, so the program asks first.
    print(requestLive().toString());
}
