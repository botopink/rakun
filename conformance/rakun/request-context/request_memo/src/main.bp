import {RequestPhase, RequestScope, beginRequest, endRequest, memoKey, memoize, preload, rkReqShareBump, rkReqShareCount, rkReqShareReset} from "rakun";
import {io.terminal.print} from "std";

fn loadPost(id: string) -> string {
    val _n = rkReqShareBump("loads");
    return "post " + id;
}

fn getPost(id: string) -> string {
    return memoize(memoKey("post", [id]), { -> loadPost(id) });
}

fn request(id: string) -> RequestScope {
    return RequestScope(
        id: id,
        phase: RequestPhase.Render,
        method: "GET",
        path: "/blog/hello",
        query: "",
        headersWire: "",
        strict: false,
    );
}

fn main() {
    val _z = rkReqShareReset();
    val _e1 = beginRequest(request("a"));
    // a miss runs the loader, a hit does not evaluate it at all
    print(getPost("7"));
    print(getPost("7"));
    print(rkReqShareCount("loads").toString());
    val _x1 = endRequest();
    // two requests with the same key run it twice
    val _e2 = beginRequest(request("b"));
    print(getPost("7"));
    print(rkReqShareCount("loads").toString());
    val _x2 = endRequest();
    print(memoKey("post", ["7", "en"]));
}
