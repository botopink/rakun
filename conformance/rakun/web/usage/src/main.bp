import {Request, Response, HttpMethod} from "rakun";
import {service, restController, route, getMapping, rkAddBean, rkInstallBeans} from "rakun";
import {rkScan, rkSingleton, rkEnter, rkDone, rkRegisterRoute, rkResolve, rkDispatch} from "rakun";
import {collections.Dict, io.terminal.print} from "std";

#[service]
pub type GreetingService() {
    pub fn greet(self: Self, name: string) -> string {
        return "Hello, " + name + "!";
    }
}

#[restController]
#[route("/api")]
pub type GreetingController(
    // injected by type
    greeting: GreetingService,
) {
    #[getMapping("/hello/:name")]
    pub fn hello(self: Self, req: Request) -> Response {
        return Response.ok(self.greeting.greet(req.param("name")));
    }
}

fn beans() -> Dict<string, unknown> {
    return comptime {
        var d: Dict<string, unknown> = Dict.empty();
        for (@TypeInfo.all(with: [service, restController], member: "make")) { b ->
            d = rkAddBean(d, b.name, b.value);
        }
        d
    };
}

fn main() -> void {
    val _beans = rkInstallBeans(beans());
    val res = rkDispatch("GET", "/api/hello/ana");
    print(res.status.toString());
    print(res.body);
    print(rkDispatch("GET", "/api/nope").status.toString());
}
