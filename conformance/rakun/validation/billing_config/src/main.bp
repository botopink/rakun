import {derived} from "validation";
import {json.Json, io.clock, collections.Dict, collections.Set} from "std";
import {decorators.validated, decorators.notBlank, decorators.minValue, decorators.maxValue} from "validation";
import {report.ValidationReport, report.Violation} from "validation";
import {table.constraintTableJson} from "validation";
import {constraints.vNotBlank, constraints.vMinValueI32, constraints.vMaxValueI32} from "validation";
import {configurationProperties, rkSetProp, refuseInvalidConfig, configProblemOf} from "rakun";
import {rkConfigCheckRegister, rkSingleton, rkEnter, rkDone, rkResolve, rkScan, rkPropBool, rkPropIntOr, rkPropFloat, rkPropList, rkPropDuration, rkPropSize, rkValue, rkValueOr, rkRegisterConfigKeys} from "rakun";

#[validated]
#[configurationProperties("app.billing")]
pub type BillingConfig(
    #[notBlank] endpoint: string,
    #[minValue(1)] #[maxValue(10)] retryLimit: i32,
)

fn main() {
    val _e = rkSetProp("app.billing.endpoint", "https://pay.example.com");
    val _r = rkSetProp("app.billing.retry-limit", "99");
    val cfg = BillingConfig.bindProperties("app.billing");
    // One line per violation, each naming its property key.
    @print(configProblemOf("BillingConfig", "app.billing", cfg.validate()));
    val _ok = rkSetProp("app.billing.retry-limit", "3");
    val good = BillingConfig.bindProperties("app.billing");
    // A valid record passes through; an invalid one halts the boot.
    @print(refuseInvalidConfig("BillingConfig", "app.billing", good.validate()).toString());
}
