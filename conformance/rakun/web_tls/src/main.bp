import {tls.tlsEnabled, tls.peerSubject, tls.peerCommonName, tls.registerTls, tls.listenerSummary, tls.tlsEntryName} from "rakun-service";
import {filter.chainNames} from "rakun-service";
import {rkSetProp} from "rakun";

fn main() {
    // With no bundle named, the listener is plaintext.
    @print(tlsEnabled().toString());
    @print(listenerSummary());
    // `peerSubject()` is "" when there was no verified certificate.
    @print("[" + peerSubject() + "]");
    @print("[" + peerCommonName() + "]");
    // `registerTls()` adds one chain entry in the late band (+300).
    val _r = registerTls();
    @print(chainNames().join(","));
}
