import {RequestPhase, RequestScope, beginRequest, endRequest, requestId, after, drainAfter, afterStarted, afterCompleted, afterFailed, afterKilled, afterLog} from "rakun";

fn writeAnalytics(id: string) -> i32 {
    return 0;
}

fn main() {
    val _e = beginRequest(RequestScope(
        id: "req-5",
        phase: RequestPhase.Handler,
        method: "GET",
        path: "/",
        query: "",
        headersWire: "",
        strict: false,
    ));
    val _ = after({ ->
        writeAnalytics(requestId());
        0;
    });
    // The work runs once the response is sent: the dispatcher calls
    // `endRequest()`, writes the response, then `drainAfter(budget)`.
    val _x = endRequest();
    val _d = drainAfter(30000);
    @print(afterStarted().toString()
        + " "
        + afterCompleted().toString()
        + " "
        + afterFailed().toString()
        + " "
        + afterKilled().toString());
    @print("[" + afterLog() + "]");
}
