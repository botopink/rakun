import {readDocument, rkConfigApply, entryAt, rkProp} from "rakun";
import {io.terminal.print} from "std";

fn main() -> void {
    val docs = try readDocument("application.yaml");
    for d in docs {
        val _ = rkConfigApply(d.entries);
    }
    print(rkProp("server.port"));
    print(rkProp("server.name"));
    print(rkProp("fruits[1]"));
}
