import {exitCode, shutdown, rkRegisterExitCode, processExitCode} from "rakun";
import {io.terminal.print} from "std";

#[exitCode]
pub fn drainExitCode() -> i32 {
    return 3;
}

fn main() -> void {
    // The highest value any `#[exitCode]` function returns.
    print(processExitCode().toString());
    val _a = rkRegisterExitCode("high", { -> 9 });
    val status = shutdown();
    print(status.toString());
}
