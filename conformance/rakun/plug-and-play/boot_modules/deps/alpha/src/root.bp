//// A package over `zeta`: `web` starts at boot and injects `store`, so
//// `store` starts first; `warmup` starts a millisecond after boot began;
//// `admin` waits for `rakun.start("admin")`.

import {rakun} from "rakun";
import {rakun.Service, rakun.Lifecycle, rakun.inject, rakun.onStop} from "rakun";

#[rakun.module]
pub component fn web() -> @Component<Service> {
    val store = use inject("store");
    use onStop({ -> @print("web stops") });
    @print("web starts over " + store.name);
    return Service(name: "web");
}

#[rakun.module(lifecycle: Lifecycle.Lazy(afterMs: 1))]
pub component fn warmup() -> @Component<Service> {
    @print("warmup starts");
    return Service(name: "warmup");
}

#[rakun.module(lifecycle: Lifecycle.Manual)]
pub component fn admin() -> @Component<Service> {
    @print("admin starts");
    return Service(name: "admin");
}
