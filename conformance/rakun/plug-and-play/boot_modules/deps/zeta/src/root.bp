//// The base package: its module `store` starts only on demand, and reads the
//// program's override of its config, else its own defaults.

import {rakun} from "rakun";
import {rakun.Service, rakun.Lifecycle, rakun.onStop, rakun.configOf} from "rakun";
import {io.terminal.print} from "std";

pub type ZetaConfig(path: string = "data/default")

#[rakun.module(lifecycle: Lifecycle.Manual)]
pub component fn store() -> Component<Service> {
    val cfg = configOf("ZetaConfig", ZetaConfig());
    use onStop({ -> print("store stops") });
    print("store starts on " + cfg.path);
    return Service(name: "store");
}
