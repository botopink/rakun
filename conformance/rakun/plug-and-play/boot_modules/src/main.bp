import {rakun} from "rakun";
import {zeta.ZetaConfig} from "zeta";
import {alpha.web} from "alpha";

// The program's override: a typed record of `zeta`'s config.
#[rakun.config]
pub val zetaConfig: ZetaConfig = ZetaConfig(path: "data/prod");

pub fn main() {
    rakun.boot();
    val _admin = rakun.start("admin");
    @print(rakun.start("billing"));
    val store = rakun.registry.find("store");
    if (store != null) @print(store.name);
    rakun.stop();
}
