import {RequestPhase, RequestScope, beginRequest, endRequest, headers, headerOf, isDynamic, dynamicReason, Headers} from "rakun";

fn userAgent() -> string {
    val ua = headerOf(headers(), "User-Agent", "");
    return ua;
}

fn main() {
    val _e = beginRequest(RequestScope(
        id: "req-1",
        phase: RequestPhase.Handler,
        method: "GET",
        path: "/",
        query: "",
        headersWire: "user-agent\tcurl/8\naccept\ttext/html\naccept\tapplication/json",
        strict: false,
    ));
    @print(userAgent());
    // an absent header: the fallback, not an error
    @print("[" + headerOf(headers(), "x-missing", "") + "]");
    // a header sent twice answers both values joined with ", "
    @print(headerOf(headers(), "Accept", ""));
    // reading a header in phase `Handler` marks the render dynamic
    @print(isDynamic().toString());
    @print(dynamicReason());
    val h: Headers = headers();
    val got: ?string = h.get("x-missing");
    @print((got == null).toString());
    val _x = endRequest();
}
