//// Decision 397 — A database query in a method body is written on the database context — `self.db.query "select * from User where active = true"` —, and `from User` names an entity whose table and columns erika reads from the type at build.

import {io.terminal} from "std";
import {service} from "rakun";
import {orm.entity.entity, DbContext, StoreError} from "rakun-data";

#[entity("users")]
pub type User(id: i32, name: string, active: bool)

#[service]
pub type Report(db: DbContext) {
    pub fn active(self: Self) -> Result<User[], StoreError> {
        return self.db.query @`select * from User where active = true`;
    }
}

pub fn main() -> void {
    val report = Report.make();
    case report.active() {
        Ok(users) -> terminal.print(users
            .map({ u -> u.name })
            .join(", "), "\n");
        Error(e) -> terminal.print("store error: ", e, "\n");
    }
}
