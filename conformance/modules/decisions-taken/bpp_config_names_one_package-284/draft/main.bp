//// Decision 284 — Configuration in JSON, case by case.

import {io.terminal.print} from "std";
import {Element, div, p, text, renderToString, routes.page, routes.PageContext} from "rakun-bpp";

// The manifest names the bpp package once (`"bpp": "rakun-bpp"`); the page's
// role is found by the annotation that package declares, not by the manifest.
#[page("")]
pub fn Home(route: PageContext) -> Component<Element> {
    return div([p([text("home at "
        + route.pathname, attrs: [])], attrs: [])], attrs: []);
}

pub fn main() -> Task<void> {
    val ctx = PageContext(pathname: "/", pattern: "", params: [], rest: []);
    print(renderToString(await Home(ctx)));
}
