//// Decision 425 — A template call expands wherever an expression may stand.

import {io.terminal, compiler, compiler.Tuple, compiler.Lit} from "std";
import {html.html.html, element.Element, element.renderToString} from "rakun-bpp";
// The builders the markup's tags call.
import {element.ul, element.li, element.p, element.span} from "rakun-bpp";

// A template answering a tuple: `"3,12"` is `#(3, 12)`.
fn stats(syntax q: string) -> anyvalue {
    val parts = compiler.text(q).split(",");
    return compiler.ast(Tuple([Lit(parts.at(0)!
        .parseInt()
        .unwrapOr(0)), Lit(parts.at(1)!.parseInt().unwrapOr(0))]));
}

pub type Menu(items: string[]) {
    // A type's method body.
    pub fn render(self: Self) -> Element {
        // A lambda.
        val lis = self.items.map({ i -> html @`<li>${i}</li>` });
        return html @`<ul>${lis}</ul>`;
    }
}

// A field default.
pub type Slot(name: string, fallback: Element = html @`<span>empty</span>`)

// A `case` arm.
fn badge(level: i32) -> Element {
    return case level {
        0 -> html @`<span>new</span>`;
        _ -> html @`<span>level ${level}</span>`;
    };
}

pub fn main() -> void {
    // A destructuring initializer.
    val #(n, total) = stats @`3,12`;
    terminal.print(n, " ", total, "\n");
    terminal.print(renderToString(Menu(items: ["a", "b"]).render()), "\n");
    terminal.print(renderToString(Slot(name: "side").fallback), "\n");
    // An argument.
    terminal.print(renderToString(html @`<p>${n} of ${total}</p>`), "\n");
    terminal.print(renderToString(badge(0)), " ", renderToString(badge(2)), "\n");
}
