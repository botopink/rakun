//// Decision 381 — The `styledProperty "…"` literal answers the record `StyledProperty` — declarations as a value, never a `@Component`.

import {io.terminal} from "std";
import {styled, styled.styledProperty, styled.StyledProperty} from "rakun-style";
import {theme.theme, theme.baseTheme} from "rakun-style";

// The application's one theme, which every `styled` literal reads.
#[theme]
pub val appTheme = comptime baseTheme();

// A family: a function answering the record, `Any`, computed at build.
fn padAll(n: i32) -> StyledProperty {
    return styledProperty @`padding: --spacing(${n});`;
}

// A property value of build.
pub val tab4 = styledProperty @`tab-size: 4;`;

// A `${p}` hole of a `StyledProperty` inlines its declarations, as `@apply`.
pub val codeBlock = styled @`
  .block { ${padAll(2)} ${tab4} font-family: monospace; }
`;

pub fn main() -> void {
    // Declarations as a value: no class, nothing registered.
    terminal.print(tab4.declarations);
    terminal.print(padAll(2).declarations);
}
