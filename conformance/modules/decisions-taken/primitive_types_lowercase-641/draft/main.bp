//// Decision 641 — (b) for the names, and no contract with one implementor: every primitive type is written lowercase — `i32`, `i64`, `u32`, `u64`, `f32`, `f64`, `bool`, `string`, `bigint`, `bytes`, `array<T>` — and a capitalised name is a contract shared by several types (`Number`, `Integer`, `Signed`, `Float`); `String`, `Bool`, `BigInt`, `Bytes` and `Array` dissolve into their types, which hold their methods and statics.

import {io.terminal} from "std";
import {http.Response} from "rakun";

// Each primitive type holds its own methods: `toString` is `i64`'s.
fn label(epoch: i64, ready: bool) -> string {
    val state = if (ready) " ready" else " waiting";
    return epoch.toString() + state;
}

// A reply's body as bytes: the static is the type's own.
fn payload(r: Response) -> bytes {
    return bytes.fromUtf8(r.body);
}

pub fn main() -> void {
    val r: Response = Response.ok(string.fromCodepoint(65) + "ok");
    val size: i32 = payload(r).length;
    val ids: array<i32> = array.range(0, 3);
    val same: i32[] = ids;
    val ready: bool = r.status == 200;
    val ratio: f64 = size.toF64() / 2.0;
    terminal.print(r.body, size, same.length, ratio, label(4_000_000_000, ready));
}
