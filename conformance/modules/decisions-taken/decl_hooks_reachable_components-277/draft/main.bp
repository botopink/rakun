//// Decision 277 — The shape of 186's checker capability.

import {pages.Page, pages.Graph};
import {compiler, io.terminal.print} from "std";
import {renderToString} from "rakun-bpp";

// `#[graph]` reads `.hooks`, so it runs after `pages`' bodies: its meta is
// read from this module.
pub fn main() -> Task<void> {
    val nodes: string[] = comptime compiler
        .typeInfo(Page)
        .meta(Graph)?.nodes ?? [];
    print(nodes.join(" "));
    print(renderToString(await Page()));
}
