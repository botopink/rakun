//// Decision 563 — An `FsError` carries its own text: std's `io/fs` gives it `message()`

import {io.fs, io.terminal.print} from "std";

// What a library writes when it carries an `io.fs` failure into a string error.
fn readOr(path: string) -> string {
    return case fs.readText(path) {
        Ok(text) -> text;
        Error(e) -> e.message();
    };
}

pub fn main() -> void {
    val dir = "fs-error-563";
    val _clean = fs.removeTree(dir);
    print(readOr(dir + "/missing.md"));
    val _made = fs.mkdir(dir);
    print(readOr(dir));
    print(case fs.mkdir(dir) {
        Ok(_) -> "made";
        Error(e) -> e.message();
    });
    val _written = fs.writeText(dir + "/page.md", "# hello");
    print(readOr(dir + "/page.md"));
    print(readOr(dir + "/page.md/child.md"));
    val _done = fs.removeTree(dir);
}
