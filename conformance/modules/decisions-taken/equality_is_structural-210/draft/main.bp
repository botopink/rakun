//// Decision 210 — `==` is structural on every target: records, tuples, lists and enum variants compare by value, recursively; two values o

import {io.terminal} from "std";
import {http.Response, http.HttpMethod} from "rakun";

pub type Route(method: HttpMethod, path: string, tags: string[])

pub fn main() -> void {
    // Two records built apart, field for field the same: equal.
    val a = Response.ok("hello");
    val b = Response(status: 200, body: "hello");
    terminal.print(a == b, " ", a != Response.notFound(), "\n");

    // Recursively: a record holding a list and an enum variant.
    val r1 = Route(method: HttpMethod.Get, path: "/api", tags: ["public", "v1"]);
    val r2 = Route(method: HttpMethod.Get, path: "/api", tags: ["public", "v1"]);
    val r3 = Route(method: HttpMethod.Post, path: "/api", tags: ["public", "v1"]);
    terminal.print(r1 == r2, " ", r1 == r3, "\n");

    // Tuples and lists of records compare by value too.
    val t1 = #(a, 1);
    val t2 = #(b, 1);
    val pair = [r1, r2];
    val swapped = [r2, r1];
    terminal.print(t1 == t2, " ", pair == swapped, " ", [r1] == [r3], "\n");
}
