//// Decision 604 — No bodyless declaration but two: one with `#[compiler.external(…)]`, and `compiler.bp`'s `declare val compiler` (579). A marker is a decorator with an empty body.

import {compiler} from "std";
import {io.terminal} from "std";
import {runtime.rkProp, runtime.rkSetProp} from "rakun";

// A marker: a decorator whose body does nothing; `compiler.find` reads it.
pub fn healthCheck(syntax decl: unknown) -> void {}

#[healthCheck]
pub fn database() -> bool {
    return rkProp("app.db.url") != "";
}

#[healthCheck]
pub fn disk() -> bool {
    return true;
}

// The checks the program declares, found at build.
val checks: string[] = comptime compiler
    .find(with: healthCheck)
    .map({ d -> compiler.name(d)! });

pub fn main() -> void {
    val _set = rkSetProp("app.db.url", "postgres://localhost/app");
    terminal.print(checks.join(", "));
    terminal.print(database() && disk());
}
