//// Decision 379 — A context is named by its value's type: `createContext(value)` declares or makes one, `use provide(ctx)` takes the context alone, `use context(T)` reads by type

import {io.terminal, context.createContext, context.provide, context.context} from "std";
import {html.html.html, element.Element, element.renderToString} from "rakun-bpp";
import {hooks.memo} from "std";
// The builders the markup's tags call.
import {elements.main, element.span} from "rakun-bpp";

pub type Theme(primary: string, radius: i32)

pub type Idioma(code: string)

pub type Moeda(code: string)

// One declaration per type: its default, at build.
pub val themeContext = comptime createContext(Theme(primary: "#e11d48", radius: 4));

pub val idiomaContext = comptime createContext(Idioma(code: "pt-BR"));

pub val moedaContext = comptime createContext(Moeda(code: "BRL"));

component fn Price(cents: i32) -> Component<Element> {
    val t = use context(themeContext);
    val lang = use context(idiomaContext);
    val m = use context(moedaContext);
    return html @`<span style="color: ${t.primary}" lang="${lang.code}">${cents} ${m.code}</span>`;
}

component fn Page(acceptLanguage: string) -> Component<Element> {
    // A build value, then a run-time one memoised with the component.
    val dark = comptime createContext(Theme(primary: "#111", radius: 4));
    val lang = use memo({ -> createContext(Idioma(code: acceptLanguage)) }, [acceptLanguage]);
    use provide(dark);
    use provide(lang);
    return html @`<main>${Price(1250)}</main>`;
}

pub async fn main() -> Async<void> {
    terminal.print(renderToString(await Page("en")), "\n");
    terminal.print(renderToString(await Price(990)), "\n");
}
