//// Decision 618 — `Implementation.Node` is renamed `JavaScript`: a source names the language the template is written in, not a runtime.

import {compiler} from "std";
import {io.terminal} from "std";

// A source names the language its template is written in: `JavaScript` for
// the commonJS target, `Erlang` for erlang and beam.
#[compiler.external(
    .JavaScript("encodeURIComponent($0)"),
    .Erlang("uri_string:quote($0)"),
)]
declare fn encodeSegment(segment: string) -> string;

pub fn main() -> void {
    terminal.print("/search/" + encodeSegment("rakun bpp"));
}
