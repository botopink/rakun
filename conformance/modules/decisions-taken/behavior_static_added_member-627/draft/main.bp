//// Decision 627 — (a): a `behavior` takes a static member through `compiler.addMember` as a type does, and inside an added member `decl` names the owner in a type position too — `fn() -> decl` is the annotated behavior.

import {io.terminal} from "std";
import {exchange.httpExchange, exchange.getExchange, exchange.postExchange} from "rakun-restclient";
import {client.RestClient} from "rakun-restclient";
import {runtime.rkSetProp} from "rakun";

// `#[httpExchange]` adds the static `http()` to the behavior through
// `compiler.addMember`; inside the member, `decl` is `EchoService` itself, so
// `http()` answers an `EchoService`.
#[httpExchange("echo")]
pub behavior EchoService {
    #[getExchange("/users/:id")]
    fn user(self: Self, id: string) -> string;

    #[postExchange("/echo")]
    fn echo(self: Self, body: string) -> string;
}

fn describe(api: EchoService) -> string {
    return "an EchoService for the group echo";
}

pub fn main() -> void {
    val _base = rkSetProp("rakun.http.serviceclient.echo.base-url", "http://localhost:8089");
    val api: EchoService = EchoService.http();
    terminal.print(describe(api));
}
