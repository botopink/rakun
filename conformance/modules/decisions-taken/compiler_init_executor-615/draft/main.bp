//// Decision 615 — `compiler.compile` is renamed `compiler.init`: `init(syntax executor: fn())` puts the executor in the program's init list, at the annotated declaration's position (580), to run once before `main`.

import {compiler, io.terminal.print} from "std";
import {service} from "rakun";

fn step(syntax decl: unknown, comptime label: string) -> void {
    val declName = compiler.name(decl)!;
    compiler.init({ -> print(label + " " + declName); });
    compiler.init({ -> print("  then " + declName); });
}

fn hello() -> void {
    print("hello from a named executor");
}

fn greeted(syntax decl: unknown) -> void {
    compiler.init(hello);
}

// Executors run once before `main`: declarations in source order, the
// calls of one body in order.
#[step("first")]
pub fn boot() -> string {
    return "boot";
}

#[service]
#[step("second")]
pub type MailService()

#[greeted]
pub val banner = "banner";

pub fn main() -> void {
    print("main");
    print(boot());
    print(banner);
}
