//// Decision 391 — The snapshot engine is a library of its own — `snap`, `botopink/snap` at `repository/snap` (326's rule) — and std provides only the general primitives it is written over.

import {io.terminal, compiler} from "std";
import {element.Element, element.div, element.h1, element.text, element.renderToString} from "rakun-bpp";
import {testing.assert_html.assertHtml, testing.assert_html.htmlLinesText} from "rakun-bpp";

fn Greeting(name: string) -> Element {
    return div([h1([text("Hello, " + name)])], [#("class", "greeting")]);
}

// rakun-bpp's `assertHtml` writes its snapshot through the `snap` library:
// `__snapshots__/<suite>/<slug>.snap` beside this file, `<path>.new` on a mismatch.
test "greeting renders its name" {
    try assertHtml(comptime compiler.src(), Greeting("ana"));
}

pub fn main() -> void {
    terminal.print(renderToString(Greeting("ana")), "\n");
    terminal.print(htmlLinesText(Greeting("bia")), "\n");
}
