//// Decision 562 — A function whose body reads a `comptime` parameter's `.value` is expanded at its call site: what depends on build data runs at build, what reaches a run-time value is emitted there as run-time code

import {io.terminal} from "std";
import {rakun} from "rakun";
import {rakun.Service, rakun.Lifecycle} from "rakun";

#[rakun.module(.Manual)]
pub component fn web() -> Component<Service> {
    return Service(name: "web");
}

#[rakun.module(.Manual)]
pub component fn admin() -> Component<Service> {
    return Service(name: "admin");
}

// Every parameter is `comptime`, so each call is expanded where it stands:
// the loop and the label run at build; the two calls reach run-time values
// and are emitted once per name, the name written in as a constant.
fn startAll(comptime names: string[]) -> void {
    for n in names {
        val label = "starting " + n;
        terminal.print(label);
        val _started = rakun.start(n);
    }
}

pub fn main() -> void {
    rakun.boot();
    startAll(["web", "admin"]);
    terminal.print(rakun.registry.all().length);
    rakun.stop();
}
