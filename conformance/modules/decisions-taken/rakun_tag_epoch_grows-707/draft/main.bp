//// Decision 707 — rakun's tag epoch only grows (`rkResetContext` leaves the tags table), is an `i64`, and `""` is refused in `rkBumpTag` / `rkTagEpoch` (`rakun: a tag is a non-empty string (rkBumpTag)`).

import {io.terminal} from "std";
import {runtime.rkBumpTag, runtime.rkTagEpoch, runtime.rkResetContext} from "rakun";

// What a cached response keeps beside its body: the tag's epoch when it was
// stored. A later epoch reads the entry as a miss.
pub type Cached(body: string, epoch: i64)

fn fresh(c: Cached, tag: string) -> bool {
    return rkTagEpoch(tag) == c.epoch;
}

pub fn main() -> void {
    terminal.print(rkTagEpoch("users"));
    val stored = Cached(body: "[ana, bia]", epoch: rkTagEpoch("users"));
    terminal.print(fresh(stored, "users"));

    val bumped: i64 = rkBumpTag("users");
    terminal.print(bumped, fresh(stored, "users"));

    // A reset drops the registrations, never the tags: the epoch stays where
    // it was, so the entry stored before the bump stays a miss.
    val _r = rkResetContext();
    terminal.print(rkTagEpoch("users"), fresh(stored, "users"));
    terminal.print(rkBumpTag("users"));
}
