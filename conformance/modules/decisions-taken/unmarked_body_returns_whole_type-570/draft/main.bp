//// Decision 570 — Without a marker a body returns the whole type: an unmarked `-> Async<T>` / `-> Component<R>` body returning the bare value is a type error; the codemod marks today's such bodies

import {io.terminal} from "std";
import {html, Element, state, renderToString} from "rakun-bpp";
// The builders the markup's tags call.
import {element.ul} from "rakun-bpp";

// Marked: `return` takes the value, the compiler wraps it.
async fn loadPosts() -> Async<string[]> {
    return ["first", "second"];
}

// Unmarked: an ordinary function that returns the `Async` itself.
fn cachedPosts() -> Async<string[]> {
    return Async.resolve(["cached"]);
}

component fn PostList(posts: string[]) -> Component<Element> {
    val open = use state(true);
    val label = if (open.value) posts.join(", ") else "";
    return html @`<ul data-open="${open.value}">${label}</ul>`;
}

// Unmarked: returns the component value a call makes.
component fn Shell(posts: string[]) -> Component<Element> {
    return PostList(posts);
}

pub async fn main() -> Async<void> {
    val fresh = await loadPosts();
    val cached = await cachedPosts();
    terminal.print(renderToString(await PostList(fresh)), "\n");
    terminal.print(renderToString(await Shell(cached)), "\n");
}
