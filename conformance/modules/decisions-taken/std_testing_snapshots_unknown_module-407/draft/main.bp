//// Decision 407 — For now, `import {testing.snapshots} from "std"` keeps the checker's plain unknown-module error; the pointer to `snap` is documentation.

import {testing.snapshots} from "std";
import {describeAppFiles} from "rakun-ssr";

pub fn main() -> void {
    snapshots.assertAs("app-files", describeAppFiles("app", ["app/page.bp", "app/layout.bp"]));
}
