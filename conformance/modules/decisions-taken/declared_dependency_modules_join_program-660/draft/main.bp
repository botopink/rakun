//// Decision 660 — (a): every module of every declared dependency is part of the program — it joins the build and its `compiler.init` executors join the init list whether or not anything imports it — and the init list is ordered by dependency resolution: a package that depends on nothing first, a package after every package it depends on, the ones with most dependencies last; two packages at the same level in the order their dependant's `botopink.json` lists them; inside a package, 580's order (modules in dependency order, declarations in source order).

import {service, rkScan, rkSingleton, rkEnter, rkDone, rkResolve, rkScannedNames} from "rakun";
import {io.terminal.print} from "std";

// The application's own component: its `#[service]` executor joins the init
// list after every executor of the packages this one depends on.
#[service]
pub type Greeter() {
    pub fn greet(self: Self, who: string) -> string {
        return "hello, " + who;
    }
}

pub fn main() -> void {
    // `rakun-metrics` is declared in the manifest and imported nowhere: its
    // `#[component] MeterRegistry` registered anyway, before this package's.
    val scanned = rkScannedNames();
    val metrics = scanned.indexOf("MeterRegistry");
    val app = scanned.indexOf("Greeter");
    print(metrics >= 0);
    print(app >= 0);
    print(metrics < app);
    print(Greeter.make().greet("rakun"));
}
