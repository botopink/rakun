//// Decision 200 — `html` is the `pub default fn` of the core member `jhonstart`, carrying `bpp`'s `#[html]` (`#[bpp.html]`, 361) — `import

import html, {Element, renderToString} from "rakun-bpp";
import {nav, a, span, text} from "rakun-bpp";
import {io.terminal.print} from "std";

val name = "world";

val bar: Element = html @`<nav><a href="/">home</a><span>hello, ${name}</span></nav>`;

pub fn main() -> void {
    print(renderToString(bar));
}
