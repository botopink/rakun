//// Decision 169 — Codepoints on erlang: `indexOf` / `lastIndexOf` answer the codepoint index, as `at` / `slice` / `length` do there, so an

import {io.terminal.print} from "std";

pub fn main() -> void {
    val path = "/café/☕/menu";
    // Codepoint indexes on every target: `é` and `☕` count one each.
    val at = path.indexOf("menu");
    val last = path.lastIndexOf("/");
    print(at);
    print(last);
    // The index goes back to `at` and `slice`, which count codepoints too.
    print(path.at(at) ?? "");
    print(path.slice(last + 1));
    print(path.slice(0, path.indexOf("☕")));
    print(path.length);
}
