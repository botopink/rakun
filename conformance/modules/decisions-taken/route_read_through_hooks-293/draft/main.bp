//// Decision 293 — A page reads its route through hooks, never a parameter.

import {page, params, pageData, StaticPath, fill} from "rakun-bpp";
import {Element, article, h1, p, text, renderToString} from "rakun-bpp";
import {io.terminal.print} from "std";

pub type BlogParams(slug: string)

pub type Post(title: string, body: string)

// The paths to prerender, each with the data its page reads.
pub fn allPosts() -> StaticPath<BlogParams, Post>[] {
    return [
        StaticPath(params: BlogParams(slug: "hello"), data: Post(title: "Hello", body: "First post.")),
        StaticPath(params: BlogParams(slug: "again"), data: Post(title: "Again", body: "Second post.")),
    ];
}

// Below the page: reads the route the same way, no prop threaded through.
fn Byline() -> Component<Element> {
    val ps = use params<BlogParams>();
    return p([text("filed under " + ps.slug, attrs: [])], attrs: []);
}

#[page("blog/[slug]", paths: allPosts)]
pub fn post() -> Component<Element> {
    val ps = use params<BlogParams>();
    val data = use pageData<Post>();
    return article([h1([text(data.title, attrs: [])], attrs: []), p([text(data.body
        + " ("
        + ps.slug
        + ")", attrs: [])], attrs: []), await Byline()], attrs: []);
}

pub fn main() -> Task<void> {
    fill("/blog/hello", "slug=hello", "", "/blog/[slug]", 1);
    print(renderToString(await post()));
}
