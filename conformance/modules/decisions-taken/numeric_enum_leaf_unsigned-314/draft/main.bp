//// Decision 314 — A numeric enum leaf has no sign; a negative value is a `Neg { … }` sub-section.

import {io.terminal} from "std";
import {html.html.html, element.renderToString} from "rakun-bpp";
import {emilia.emilia, emilia.className, tokens.Token} from "rakun-stylesheet";
// The builders the markup's tags call.
import {element.span} from "rakun-bpp";

// A numeric leaf is written `__N`; a negative value is the `Neg` sub-section.
val tilt = comptime className(.Transform.Rotate.__12);

val tiltBack = comptime className(.Transform.Rotate.Neg.__12);

// A pattern reads the same leaves, one section at a time.
fn rotation(r: Token.Transform.Rotate) -> string {
    return case r {
        __12 -> "rotate 12deg";
        Neg(n) -> case n {
            __12 -> "rotate -12deg";
            _ -> "rotate, negative";
        };
        _ -> "rotate";
    };
}

val badge = html @`<span #[emilia(.Margin.T.Neg.__4, .Transform.Rotate.Neg.__12)]>new</span>`;

pub fn main() -> void {
    terminal.print(tilt != tiltBack, "\n");
    terminal.print(rotation(.Neg.__12), " ", rotation(.__12), "\n");
    terminal.print(renderToString(badge), "\n");
}
