//// Decision 503 — `testing.asserts` imports on wasm, its API unchanged; `matches` waits on std's regex there, a located refusal until then. Amends 146.

import {io.terminal} from "std";
import {testing.asserts} from "std";
import {http.Response} from "rakun";

fn notFound() -> Response {
    return Response.notFound();
}

fn explode() -> i32 {
    val parts: i32[] = [];
    return parts.at(3)!;
}

fn report(r: Result<void, string>) -> string {
    return case r {
        Ok(_) -> "ok";
        Error(message) -> "failed: " + message;
    };
}

pub fn main() -> void {
    terminal.print(report(asserts.equals(notFound().status, 404)), "\n");
    terminal.print(report(asserts.deepEquals(notFound(), Response(status: 404, body: ""))), "\n");
    terminal.print(report(asserts.throws({ -> explode() })), "\n");
    terminal.print(report(asserts.contains(Response.badRequest("bad id").body, "id")), "\n");
}
