//// Decision 178 — † A dangling link under `fs.walk` is an `Error` naming the link, on both targets — not skipped

import {io.fs, io.process, io.terminal.print} from "std";

pub fn main() -> void {
    val dir = "walk-178";
    val _clean = fs.removeTree(dir);
    val _made = fs.mkdir(dir);
    val _page = fs.writeText(dir + "/page.md", "# page");
    // A link to nothing: `walk` names it in its error, never skips it.
    val _link = process.run("ln", ["-s", "nowhere.md", dir + "/dangling.md"]);
    print(case fs.walk(dir) {
        Ok(files) -> "walked " + files.join(",");
        Error(e) -> e.message();
    });
    val _done = fs.removeTree(dir);
}
