//// Decision 593 — (c), and a type may be a component — every form behaves and is called as a `fn` component.

import {io.terminal} from "std";
import {context.createContext, context.context, context.RenderScope} from "std";
import {element.Element, element.renderToString, element.div, element.ul, element.li, element.p, element.h2} from "rakun-bpp";
import {elements.nav} from "rakun-bpp";
import {render.renderComponent} from "rakun-bpp";
import {html.html.html} from "rakun-bpp";
import {credits};

pub type Theme(cls: string)

pub val themeContext = comptime createContext(Theme(cls: "menu"));

// A type as a component: its fields are its props, `render` is its body.
pub type Menu(items: string[], title: string = "Menu") implement Component<Element> {
    component fn render(self: Self) -> Component<Element> {
        val t = use context(themeContext);
        return html @`<nav class={t.cls}><h2>{self.title}</h2><ul>{self.items.map({ i -> self.item(i) })}</ul></nav>`;
    }

    // Not a component: an ordinary helper of the type.
    fn item(self: Self, i: string) -> Element {
        return html @`<li>{i}</li>`;
    }
}

// A method answering `Component<Element>`.
pub type Shop(name: string) {
    pub component fn banner(self: Self) -> Component<Element> {
        val t = use context(themeContext);
        return html @`<p class={t.cls}>{self.name}</p>`;
    }
}

component fn App() -> Component<Element> {
    // A lambda answering `Component<Element>`.
    val badge: fn(string) -> Component<Element> = { component label ->
        html @`<p>{label}</p>`
    };
    val shop = Shop(name: "Rakun Store");
    return html @`<div>
  {shop.banner()}
  <Menu items={["tea", "bread"]} />
  <Menu items={["help"]} title="Footer" />
  {badge("new")}
  {credits(2026)}
</div>`;
}

pub async fn main() -> Async<void> {
    val page = await renderComponent(App(), RenderScope.root());
    terminal.print(renderToString(page.tree));
}
