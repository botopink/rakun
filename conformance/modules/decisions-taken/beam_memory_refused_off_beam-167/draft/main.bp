//// Decision 167 — A target that is not the BEAM (commonJS, wasm) refuses `#[@BeamMemory]`: a module-level `var` carrying `#[@BeamMemory.<m

import {io.terminal, async, compiler} from "std";

// One counter shared by every request process: an ETS-backed module `var`.
// It means something only on the BEAM; rakun builds for erlang alone.
#[compiler.beamMemory(.Ets)]
var served: i32 = 0;

async fn handle() -> Async<i32> {
    served += 1;
    return served;
}

pub async fn main() -> Async<void> {
    val _done = await async.runAll([{ -> handle() }, { -> handle() }, { -> handle() }]);
    terminal.print(served, "\n");
}
