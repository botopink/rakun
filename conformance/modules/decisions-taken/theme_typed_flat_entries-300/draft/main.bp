//// Decision 300 — The theme keeps CSS's flat entry list, typed, and is declared once with `#[theme]`

import {compiler, io.terminal.print} from "std";
import {theme.theme, theme.extendTheme, theme.baseTheme, theme.entry, theme.clear, theme.themeValue, theme.wasCleared, theme.Ns, theme.ThemeValue} from "rakun-style";

// The application's one theme: typed entries over the base, a breakpoint
// moved, one cleared, a colour added.
#[theme]
pub val appTheme = comptime extendTheme(baseTheme(), [
    entry(.Breakpoint, "md", .Rem(40.0)),
    clear(.Breakpoint, "lg"),
    entry(.Color, "brand", .Raw("#e11d48")),
]);

pub fn main() -> void {
    print(themeValue(appTheme, "--breakpoint-md"));
    print(themeValue(appTheme, "--color-brand"));
    print(wasCleared(appTheme, "--breakpoint-lg"));
    print(themeValue(appTheme, "--breakpoint-sm"));
    val declared = comptime compiler.find(with: theme).length;
    print(declared);
}
