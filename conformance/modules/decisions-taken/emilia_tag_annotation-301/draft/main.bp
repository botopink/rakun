//// Decision 301 — emilia reaches markup as a tag annotation of its own:

import {io.terminal} from "std";
import {html.html.html, element.renderToString, styled_sheet.styled} from "rakun-bpp";
import {emilia.emilia} from "rakun-stylesheet";
import {buttons.primary};
// The builders the markup's tags call.
import {elements.button, element.h1, elements.section} from "rakun-bpp";

// Two tag annotations on one tag: the application's rakun-style component
// through rakun-bpp's `#[styled(…)]`, and rakun-stylesheet's tokens through
// `#[emilia(…)]`. Both are read at build.
val page = html @`
<section>
  <h1 #[emilia(.Text.Size.X3xl, .Text.Bold)]>Orders</h1>
  <button class="send" #[styled(primary)] #[emilia(.Pad.All.__4)]>Send</button>
</section>
`;

pub fn main() -> void {
    terminal.print(renderToString(page), "\n");
}
