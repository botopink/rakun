//// Decision 109 — A module atom starts with its package, and the declaration boundary is `@@`

import {io.terminal, compiler} from "std";
import {http.Response} from "rakun";

// The tag a record carries on the BEAM: its declaration's atom, as text.
#[compiler.external(.Erlang("atom_to_binary(element(1, $0), utf8)"))]
declare fn tagOf(value: unknown) -> string;

// The module atom of the code that runs, as text.
#[compiler.external(.Erlang("atom_to_binary(?MODULE, utf8)"))]
declare fn moduleOf() -> string;

pub type Greeting(name: string)

pub fn main() -> void {
    // A dependency's type: package `rakun`, path `http`, declaration `Response`.
    terminal.print(tagOf(Response.ok("hi")), "\n");
    // This package's own type, its case kept after the `@@`.
    terminal.print(tagOf(Greeting(name: "ana")), "\n");
    // The file's own module: the package, then the path.
    terminal.print(moduleOf(), "\n");
}
