//// Decision 319 — `i64` is a real 64-bit integer on every target.

import {io.terminal.print} from "std";
import {Response} from "rakun";

// A byte count past 2^53: an `i64` on every target.
fn contentLength(chunks: i64, chunkSize: i64) -> i64 {
    return chunks * chunkSize;
}

pub fn main() -> void {
    val total: i64 = contentLength(4503599627370497, 2);
    val res = Response.ok(total.toString());
    print(res.body);
    print(total + 1);
    print(total == 9007199254740994);
    val max: i64 = 9223372036854775807;
    print(max);
    print(case "9223372036854775808".parseInt() {
        Ok(n) -> n.toString();
        Error(e) -> "past i64";
    });
}
