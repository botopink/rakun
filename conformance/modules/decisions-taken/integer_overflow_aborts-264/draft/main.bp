//// Decision 264 — Integer overflow is a program error on every target: `+`, `-`, `*`, unary `-` and the compound assignments of every inte

import {io.terminal} from "std";
import {failure.attempt} from "std";
import {http.Response} from "rakun";

// A request counter that a long-running server could push to its type's edge.
fn next(count: i32) -> i32 {
    return count + 1;
}

pub fn main() -> void {
    terminal.print(next(41), "\n");
    // 2147483647 is i32's largest value: one more is a program error, never a wrap.
    val r = attempt({ -> next(2147483647) });
    val shown = case r {
        Ok(v) -> v.toString();
        Error(f) -> f.kind;
    };
    terminal.print(shown, "\n");
    terminal.print(Response.withStatus(500, shown).status, "\n");
}
