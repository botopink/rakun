//// Decision 193 — A component's content is its default slot, read with `<Slot />` (360) — no `children` field in a component's props; the

import {io.terminal} from "std";
import {context.RenderScope} from "std";
import {element.Element, element.renderToString, element.div, element.h2, element.p} from "rakun-bpp";
import {elements.section} from "rakun-bpp";
import {render.renderComponent} from "rakun-bpp";
import {html.html.html} from "rakun-bpp";
import {slot.Slot} from "rakun-bpp";

// A card's props: its title alone — no `children` field.
component fn Card(title: string) -> Component<Element> {
    return html @`<section><h2>{title}</h2><Slot /></section>`;
}

// A component that writes no default slot takes no content.
component fn Divider(label: string) -> Component<Element> {
    return html @`<p>— {label} —</p>`;
}

component fn App() -> Component<Element> {
    return html @`<div>
  <Card title="Welcome">
    <p>The content between the tags is the card's default slot.</p>
    <p>It may hold several nodes.</p>
  </Card>
  <Divider label="end" />
</div>`;
}

pub async fn main() -> Async<void> {
    val page = await renderComponent(App(), RenderScope.root());
    terminal.print(renderToString(page.tree));
}
