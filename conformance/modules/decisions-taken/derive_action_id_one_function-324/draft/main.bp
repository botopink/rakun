//// Decision 324 — One function derives an action id: `actions.id.deriveActionId(secret, module, name, buildId)`; rakun-app keeps no wrapper.

import {io.terminal} from "std";
import {id.deriveActionId, id.isActionId} from "actions";
import {config} from "rakun";
import {actions.serverAction, actions.actionIdOf, actions.ActionResult, actions.FormData} from "rakun-app";

#[config("rakun.actions")]
pub type ActionsConfig(secret: string, field: string = "$action", header: string = "rakun-action")

#[serverAction]
pub async fn createPost(form: FormData) -> Async<ActionResult> {
    return ActionResult.done();
}

pub fn main() -> void {
    val cfg = use config(ActionsConfig);
    val a = deriveActionId(cfg.secret, "app@posts", "createPost", "build-1");
    val again = deriveActionId(cfg.secret, "app@posts", "createPost", "build-1");
    val next = deriveActionId(cfg.secret, "app@posts", "createPost", "build-2");
    terminal.print(a == again, " ", a == next, "\n");
    terminal.print(isActionId(actionIdOf("createPost")), "\n");
    terminal.print(isActionId(a), " ", isActionId("createPost"), "\n");
}
