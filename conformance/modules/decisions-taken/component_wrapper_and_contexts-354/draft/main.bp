//// Decision 354 — A component is `@Component<R>`; what a body reads from above it is a context, provided by a hook — React's context in botopink's spelling.

import {io.terminal} from "std";
import {context.createContext, context.provide, context.context, context.RenderScope} from "std";
import {element.Element, element.renderToString, element.div, element.span, elements.section} from "rakun-bpp";
import {render.renderComponent} from "rakun-bpp";
import {html.html.html} from "rakun-bpp";

pub type Theme(mode: string, cls: string)

// The context's default, named by its value's type: a page with no provider
// above it reads a light theme.
pub val themeContext = comptime createContext(Theme(mode: "light", cls: "bg-white"));

// A hook: a `Component<R>` whose `R` is not renderable, read with `use`.
component fn themeClass() -> Component<string> {
    val t = use context(themeContext);
    return t.mode + ":" + t.cls;
}

// A component: `R` is `Element`, which implements `Renderable`, so it is
// called as a tag.
component fn Badge(label: string) -> Component<Element> {
    val cls = use themeClass();
    return html @`<span class={cls}>{label}</span>`;
}

// Provides a dark theme to everything it renders below it — never to itself.
component fn DarkPanel() -> Component<Element> {
    val own = use context(themeContext);
    val dark = comptime createContext(Theme(mode: "dark", cls: "bg-black"));
    use provide(dark);
    return html @`<section data-own={own.mode}><Badge label="inside" /></section>`;
}

component fn App() -> Component<Element> {
    return html @`<div><Badge label="outside" /><DarkPanel /></div>`;
}

pub async fn main() -> Async<void> {
    val page = await renderComponent(App(), RenderScope.root());
    terminal.print(renderToString(page.tree));
}
