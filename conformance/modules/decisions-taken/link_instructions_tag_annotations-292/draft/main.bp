//// Decision 292 — The string instructions left after 278 go, each to its own place.

import {io.terminal} from "std";
import {context.RenderScope} from "std";
import {element.Element, element.renderToString, element.div, element.p} from "rakun-bpp";
import {elements.a, elements.nav} from "rakun-bpp";
import {client.client} from "rakun-bpp";
import {link.link.reload, link.link.history, link.link.onBeforeSwap, link.link.onPageLoad} from "rakun-bpp";
import {render.renderComponent} from "rakun-bpp";
import {html.html.html} from "rakun-bpp";
import {bundler.script.Script} from "rakun-ssr";

// The navigation events are `#[clientOnly]` hooks, so they live in a
// `#[client]` component.
#[client]
component fn SwapLogger() -> Component<Element> {
    use onBeforeSwap({ e -> terminal.print("swapping to " + e.url) });
    use onPageLoad({ e -> terminal.print("loaded " + e.url) });
    return html @`<p>navigation log</p>`;
}

component fn Nav() -> Component<Element> {
    return html @`<div>
  <nav>
    <a href="/">Home</a>
    <a href="/legacy" #[reload]>Legacy (a document load)</a>
    <a href="/search?q=bpp" #[history(.Replace)]>Search (replaces the entry)</a>
  </nav>
  <SwapLogger />
  <Script src="/analytics.js" strategy={.LazyOnload} />
</div>`;
}

pub async fn main() -> Async<void> {
    val page = await renderComponent(Nav(), RenderScope.root());
    terminal.print(renderToString(page.tree));
}
