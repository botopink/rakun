//// Decision 403 — `@Decl` carries no source location: a decorator's output never depends on where its file sits.

import {io.terminal} from "std";
import {element.Element, element.div, element.h1, element.p, element.text, element.renderToString} from "rakun-bpp";
import {routes.PageContext, routes.page, routes.pageParams, routes.jhPage} from "rakun-bpp";

// The route is an argument the author writes: nothing of it comes from the
// directory this file sits in.
#[page("blog/[slug]")]
pub component fn BlogPost(route: PageContext) -> Component<Element> {
    val slug = pageParams(route).get("slug");
    return div([h1([text("Post " + slug)])]);
}

// A page with no annotation reaches the router as the generated route table
// passes it: its route is again an argument.
pub component fn About(route: PageContext) -> Component<Element> {
    return div([p([text("About " + route.pathname)])]);
}

pub async fn main() -> Async<void> {
    val _r = jhPage("about", About);
    val post = PageContext(
        pathname: "/blog/hello",
        pattern: "blog/[slug]",
        params: [#("slug", "hello")],
        rest: [],
    );
    val about = PageContext(pathname: "/about", pattern: "about", params: [], rest: []);
    terminal.print(renderToString(await BlogPost(post)));
    terminal.print(renderToString(await About(about)));
}
