//// Decision 610 — (b), with one rule more: `body:` is the one name of the botopink-body cell, on `Erlang`, `JavaScript` and `Wasm` alone, its two checks written as the cell's rule, and an annotation whose every source is a `body:` is refused.

import {compiler} from "std";
import {io.terminal} from "std";

// The botopink body wasm runs: a private `fn` of this module whose parameters
// and return are the declaration's.
fn reverseBody(xs: i32[]) -> i32[] {
    var out: i32[] = [];
    var i = xs.length - 1;
    while (i >= 0) {
        out.push(xs.at(i)!);
        i = i - 1;
    }
    return out;
}

// One source per target: a host template on erlang and JavaScript, the
// botopink body on wasm.
#[compiler.external(
    .Erlang("lists:reverse($0)"),
    .JavaScript("[...$0].reverse()"),
    .Wasm(body: reverseBody),
)]
declare fn backwards(xs: i32[]) -> i32[];

pub fn main() -> void {
    terminal.print(backwards([1, 2, 3]).map({ x -> x.toString() }).join(" "));
}
