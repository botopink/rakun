//// Decision 177 — † `fs.glob`, one rule on both targets: `*` and `**` do not match a name that starts with `.` unless the pattern writes t

import {io.terminal} from "std";
import {io.fs} from "std";

// An app directory as rakun-app's i18n loader walks it: the dictionaries of
// each locale, one of them inside a hidden directory.
fn seed(root: string) -> Result<i32, fs.FsError> {
    val _a = try fs.mkdirRecursive(root + "/en/dictionaries");
    val _b = try fs.mkdirRecursive(root + "/.cache/dictionaries");
    val _c = try fs.writeText(root + "/en/dictionaries/home.bp", "");
    val _d = try fs.writeText(root + "/en/dictionaries/.draft.bp", "");
    val _e = try fs.writeText(root + "/.cache/dictionaries/old.bp", "");
    return 0;
}

pub fn main() -> void {
    val root = "glob-app";
    val _r = fs.removeTree(root);
    val _s = try seed(root) catch -1;

    // rakun-app's pattern: `**` and `*` skip every name that starts with `.`.
    terminal.print(try fs.glob("**/dictionaries/*.bp", root) catch []);
    // The pattern writes the dot, so the dotted name matches.
    terminal.print(try fs.glob("**/dictionaries/.*.bp", root) catch []);
    terminal.print(try fs.glob(".cache/dictionaries/*.bp", root) catch []);
    val _d = fs.removeTree(root);
}
