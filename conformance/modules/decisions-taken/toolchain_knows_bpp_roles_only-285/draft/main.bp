//// Decision 285 — The toolchain knows these things about `.bpp`:

import {io.terminal} from "std";
import {compiler} from "std";
import {element.Element, element.h1} from "rakun-bpp";
import {routes.page, routes.layout, routes.RouteSegment} from "rakun-bpp";
import {html.html.html} from "rakun-bpp";

// The role is the decorator written here; the function's name and its file's
// name say nothing.
#[page("blog/[slug]")]
pub component fn Whatever() -> Component<Element> {
    return html @`<h1>A post</h1>`;
}

#[layout("blog")]
pub component fn Shell() -> Component<Element> {
    return html @`<h1>The blog</h1>`;
}

pub fn main() -> void {
    // What the decorators recorded, read at build.
    terminal.print(comptime compiler.meta<RouteSegment>(Whatever)?.seg ?? "no role");
    terminal.print(comptime compiler.meta<RouteSegment>(Shell)?.seg ?? "no role");
}
