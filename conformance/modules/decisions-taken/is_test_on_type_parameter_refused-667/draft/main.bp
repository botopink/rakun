//// Decision 667 — `v is T` with `T` a type parameter is refused; a type to test against travels as a `comptime t: type<T>` parameter, and `v is t` is the concrete type's test in the function specialised for it.

import {io.terminal} from "std";
import {rakun.Service} from "rakun";

pub type Users(count: i32)

// A registry of values of any type. The type to look for travels as a
// `comptime t: type<T>` parameter, and `e is t` tests the concrete type in
// the copy compiled for it.
pub type Registry(entries: unknown[]) {
    pub fn get<T>(self: Self, comptime t: type<T>) -> ?T {
        for e in self.entries {
            if (e is t) return e;
        }
        return null;
    }
}

pub fn main() -> void {
    val r = Registry(entries: [Service(name: "web"), Users(count: 3)]);
    terminal.print(r.get(Service)?.name ?? "none");
    terminal.print(r.get(Users)?.count ?? 0);
}
