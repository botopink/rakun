//// Decision 217 — † `Array.unique` removes every duplicate, keeping each value's first occurrence in order — `[1, 2, 1, 3, 2].unique()` is

import {io.terminal} from "std";
import {profiles.matches, profiles.setResolved, profiles.active} from "rakun";

pub fn main() -> void {
    // Profiles named on the command line, by the environment and by a group,
    // with repeats: `unique` keeps each name's first place.
    val named = ["prod", "eu", "prod", "metrics", "eu"];
    val resolved = named.unique();
    terminal.print(resolved);
    val _s = setResolved(resolved);
    terminal.print(active());
    terminal.print(matches("prod & metrics", active()));

    terminal.print([1, 2, 1, 3, 2].unique());
    val none: string[] = [];
    terminal.print(none.unique().length);
}
