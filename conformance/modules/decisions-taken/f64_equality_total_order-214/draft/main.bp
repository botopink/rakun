//// Decision 214 — `f64` under `==` is a total order (Java's `Double.compare`): `0.0 == -0.0` is `false` and `NaN == NaN` is `true`, bare o

import {io.terminal} from "std";
import {config.rkPropFloat} from "rakun";

// A sampling weight, as a record and as a variant.
type Weight(value: f64)

type Reading {
    Sampled(value: f64),
    Missing,
}

pub fn main() -> void {
    // The key is not set, so rakun answers the fallback: `+0.0`.
    val configured = rkPropFloat("rakun.probe.weight", 0.0);
    // `-0.0`, built at run time so no backend folds it.
    val negated = configured * -1.0;

    terminal.print(configured == negated);
    terminal.print(configured != negated);
    terminal.print(configured == rkPropFloat("rakun.probe.weight", 0.0));
    terminal.print(negated == negated);

    // The ordering operators keep IEEE's answers.
    terminal.print(negated < configured);
    terminal.print(negated <= configured);

    // The same equality inside every structure.
    terminal.print(Weight(value: configured) == Weight(value: negated));
    val pos = #(configured, "p");
    val neg = #(negated, "p");
    terminal.print(pos == neg);
    terminal.print([configured, 1.5] == [negated, 1.5]);
    terminal.print(Reading.Sampled(value: configured)
        == Reading.Sampled(value: negated));
    terminal.print(Reading.Sampled(value: configured)
        == Reading.Sampled(value: 0.0));
}
