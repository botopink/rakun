//// Decision 637 — Neither option: `code.bp` is built first, inside B-149, and a template answers the code it builds through `code` — the caller's holes are `syntax` values it splices, so no `Hole(index)` node exists.

import {io.terminal, compiler, code} from "std";
import {Element, text, renderToString} from "rakun-bpp";

pub type User(name: string)

// The caller's holes are `syntax` values; `code` splices them as written.
fn badge(syntax t: string) -> anyvalue {
    val h = compiler.holes(t);
    val tag = if (compiler.text(t).length() > 20) "div" else "span";
    return code @`Element(tag: ${tag}, value: "", children: [text(${h[0]})], attrs: [#("class", "badge")])`;
}

pub fn main() -> void {
    val user = User(name: "ana");
    terminal.print(renderToString(badge @`${user.name}`), "\n");
}
