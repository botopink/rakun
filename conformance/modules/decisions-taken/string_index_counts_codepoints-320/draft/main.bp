//// Decision 320 — A string index counts codepoints on every target — the same value everywhere.

import {io.terminal} from "std";
import {http.Response} from "rakun";

// The last path segment of a request path, cut by index.
fn lastSegment(path: string) -> string {
    val cut = path.lastIndexOf("/");
    return path.slice(cut + 1, path.length);
}

pub fn main() -> void {
    // `e` then U+0301 (combining acute): two codepoints, one grapheme.
    val accented = "cafe\u{301}";
    terminal.print(accented.length, " ", accented.at(4) == "\u{301}", "\n");
    // One emoji is one codepoint.
    terminal.print("👍".length, "\n");

    val path = "/menu/café/👍";
    terminal.print(path.length, " ", path.indexOf("é"), " ", path.lastIndexOf("/"), "\n");
    terminal.print(lastSegment(path), " ", path.slice(6, 10), "\n");
    terminal.print(Response.ok(lastSegment(path)).body.length, "\n");
}
