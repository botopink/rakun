//// Decision 27 — Who declares `behavior Display`?

import {io.terminal} from "std";
import {collections.Dict} from "std";
import {http.HttpMethod} from "rakun";

// A route as rakun's `routes` listing would show it: the type says how it
// reads, once, by implementing std's `Display` — no import, it is ambient.
pub type RouteLine(method: HttpMethod, path: string, handler: string) implement Display {
    pub fn display(self: Self) -> string {
        val verb = case self.method {
            Get -> "GET";
            Post -> "POST";
            Put -> "PUT";
            Patch -> "PATCH";
            Delete -> "DELETE";
            Head -> "HEAD";
            Options -> "OPTIONS";
        };
        return verb + " " + self.path + " -> " + self.handler;
    }
}

pub fn main() -> void {
    val hello = RouteLine(method: HttpMethod.Get, path: "/api/hello/:name", handler: "GreetingController.hello");
    // `print` reads the value's own `display` before any per-type formatter.
    terminal.print(hello, "\n");
    terminal.print(hello.display()
        == "GET /api/hello/:name -> GreetingController.hello", "\n");

    // std's own `Dict` implements the same declaration: `Dict("a": 1, …)`.
    val hits = Dict.ofEntries([#("/api/hello", 3), #("/api/bye", 1)]);
    terminal.print(hits, "\n");
}
