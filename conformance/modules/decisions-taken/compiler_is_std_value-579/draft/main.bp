//// Decision 579 — `compiler` is not a keyword: it is a value std declares, imported like any name.

import {compiler, io.terminal.print} from "std";
import {service} from "rakun";

// `compiler` is the value std's module declares, imported above.
fn named(syntax decl: unknown) -> void {
    val declName = compiler.name(decl)!;
    compiler.init({ -> print("named " + declName) });
}

// Everywhere else `compiler` is an ordinary name: a field, a parameter.
pub type Toolchain(compiler: string, target: string)

fn describe(compiler: string) -> string {
    return "built by " + compiler;
}

// rakun's decorators read `compiler` in rakun's own module.
#[service]
#[named]
pub type BuildService(tools: Toolchain)

pub fn main() -> void {
    val tools = Toolchain(compiler: "botopink", target: "erlang");
    print(describe(tools.compiler));
    print(comptime compiler.module);
}
