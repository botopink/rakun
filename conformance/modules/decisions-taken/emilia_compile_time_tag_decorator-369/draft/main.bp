//// Decision 369 — emilia runs at compile time only: a tag decorator of its own, `#[emilia(…)]`, over tokens typed `Token`; class and rules computed at build — no `@Component`, no `@Task` at run time.

import {io.terminal} from "std";
import {html.html.html, element.renderToString, styled_sheet.renderedStyles} from "rakun-bpp";
import {emilia.emilia, emilia.className, tokens.Token} from "rakun-stylesheet";
// The builders the markup's tags call.
import {element.div, elements.h2, element.span} from "rakun-bpp";

// A class outside a template: computed at build, a constant in the program.
val badgeClass = comptime className(.Pad.X.__2, .Bg.Gray.__100);

// Tokens on tags: `Token` is the element type, so the leading-dot paths resolve.
val card = html @`
<div #[emilia(.Pad.All.__4, .Bg.White)]>
  <h2 #[emilia(.Text.Size.Lg, .Text.Bold)]>Today</h2>
  <span class="${badgeClass}">3 new</span>
</div>
`;

pub fn main() -> void {
    // No emilia call runs here: the classes and their rules were computed at build.
    terminal.print(renderToString(card), "\n");
    terminal.print(badgeClass.startsWith("e_"), "\n");
    terminal.print(renderedStyles() != "", "\n");
}
