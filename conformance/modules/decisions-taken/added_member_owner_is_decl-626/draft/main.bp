//// Decision 626 — (a): inside a member a decorator adds, the owner is `decl` — the annotated declaration as code (613), so `decl.make()` is `ServerConfig.make()` —; and a decorator's `syntax decl` is typed by what the decorator requires of the declaration.

import {io.terminal} from "std";
import {compiler} from "std";
import {decorators.service, decorators.value} from "rakun";
import {runtime.rkSetProp} from "rakun";

// What the decorator needs of the declaration: a `make()` answering it.
pub behavior Configurable {
    fn make() -> Self;
}

pub fn checked(syntax decl: Configurable, comptime prefix: string) -> void {
    // Inside the added member the owner is `decl`: `decl.make()` is `ServerConfig.make()`.
    compiler.addMember("check", fn() -> string {
        val c = decl.make();
        return if (c.host == "")
            prefix + ".host is not set"
        else
            prefix + " ok: " + c.host;
    });
}

#[service]
#[checked("server")]
pub type ServerConfig(#[value("server.host")] host: string)

pub fn main() -> void {
    val _p = rkSetProp("server.host", "0.0.0.0");
    terminal.print(ServerConfig.check(), "\n");
}
