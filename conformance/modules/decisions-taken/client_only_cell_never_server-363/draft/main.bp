//// Decision 363 — A browser-only cell is `#[clientOnly]`: called only where the client runs, never given a server twin.

import {io.terminal, compiler} from "std";
import {html, Element, renderToString, client.client, clientOnly, link.Link, link.linkProps} from "rakun-bpp";
// The builders the markup's tags call.
import {elements.button, elements.header, element.span} from "rakun-bpp";

// Bound only for the browser: no server twin.
#[compiler.external(.JavaScript("require('./link_runtime.mjs').linkStatus()"))]
declare fn linkStatus() -> string;

// The one way to the cell: a hook legal only inside a `#[client]` component.
#[clientOnly]
component fn status() -> Component<string> {
    return linkStatus();
}

#[client]
component fn LikeButton(likes: i32) -> Component<Element> {
    val s = use status();
    return html @`<button data-status="${s}">${likes} likes</button>`;
}

// Server-rendered: its pending state is an attribute the client router sets.
fn NavLink(href: string, label: string) -> Element {
    return Link(linkProps(href), [html @`<span>${label}</span>`]);
}

component fn Header() -> Component<Element> {
    return html @`<header>${NavLink("/posts", "Posts")} ${LikeButton(3)}</header>`;
}

pub async fn main() -> Async<void> {
    terminal.print(renderToString(await Header()), "\n");
}
