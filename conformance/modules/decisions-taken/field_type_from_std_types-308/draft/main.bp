//// Decision 308 — `Field<T>` is std's `compiler.Field<T>`, and `Type.keys(T)` names it:

import {types.Type, compiler.Field, io.terminal.print} from "std";

pub type Recipe(title: string, minutes: i32, serves: i32)

// The keys of `Recipe` are `Field<Recipe>` itself, not a second enum.
pub val RecipeKey = Type.keys(Recipe);

fn describe(recipe: Recipe, key: Field<Recipe>) -> string {
    // Exhaustive over the fields of `Recipe`, in any order.
    return case key {
        .title -> recipe.title;
        .minutes -> recipe.minutes.toString() + " min";
        .serves -> "serves " + recipe.serves.toString();
    };
}

pub fn main() -> void {
    val feijoada = Recipe(title: "Feijoada", minutes: 180, serves: 6);
    // `all()` answers the fields in declaration order; `name` is the field's.
    for (RecipeKey.all()) { key ->
        print(key.name + " = " + describe(feijoada, key));
    }
    // `of(text)` answers `?RecipeKey`: a field by its name, `null` for any other text.
    print(RecipeKey.of("minutes")?.name ?? "none");
    print(RecipeKey.of("salt")?.name ?? "none");
}
