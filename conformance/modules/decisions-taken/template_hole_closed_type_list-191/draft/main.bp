//// Decision 191 — jhonstart's templates accept in `{expr}` a closed list: a `string`; a number of any numeric type and a `bool`, each writ

import {io.terminal} from "std";
import {html, Element, Node, renderToString} from "rakun-bpp";
// The builders the markup's tags call.
import {element.div, element.p, element.span} from "rakun-bpp";

component fn Badge(label: string) -> Component<Element> {
    return html @`<span class="badge">${label}</span>`;
}

// A helper that may answer any member of the set declares `Node`.
fn mark(urgent: bool) -> Node {
    return if (urgent) "!" else 0;
}

component fn Summary(name: string, count: i32, ratio: f64, active: bool) -> Component<Element> {
    val badges = [Badge("new"), Badge("sale")];
    val extra = mark(true);
    return html @`
<div>
  <p>${name}</p>
  <p>${count} items, ${ratio} full, active: ${active}</p>
  ${Badge("featured")}
  ${badges}
  ${extra}
</div>
`;
}

pub async fn main() -> Async<void> {
    terminal.print(renderToString(await Summary("cart", 3, 0.5, true)), "\n");
}
