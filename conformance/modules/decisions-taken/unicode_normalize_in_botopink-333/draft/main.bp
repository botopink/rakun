//// Decision 333 — `unicode.normalize` is a botopink normalizer on the four targets, its tables generated by a Zig build step; a prebuilt wasm library is a further `@External.Wasm` form, for later uses.

import {io.terminal, unicode, unicode.NormalizationForm} from "std";

fn codes(s: string) -> string {
    return s
        .chars()
        .map({ c -> (unicode.firstCodepoint(c) ?? 0).toString() })
        .join(" ");
}

// Two spellings of one user name compare equal once both are NFC.
fn sameUser(a: string, b: string) -> bool {
    return unicode.normalize(a, NormalizationForm.NFC)
        == unicode.normalize(b, NormalizationForm.NFC);
}

pub fn main() -> void {
    val composed = "José";
    val decomposed = "Jose\u{301}";
    terminal.print(composed
        == decomposed, " ", sameUser(composed, decomposed), "\n");
    terminal.print(codes(unicode.normalize(composed, NormalizationForm.NFD)), "\n");
    // ǅ (U+01C5) under NFKD: D, z, and the combining caron.
    terminal.print(codes(unicode.normalize("ǅ", NormalizationForm.NFKD)), "\n");
    // Hangul is composed algorithmically: 한 is U+D55C under NFC.
    terminal.print(codes(unicode.normalize("\u{1112}\u{1161}\u{11AB}", NormalizationForm.NFC)), "\n");
}
