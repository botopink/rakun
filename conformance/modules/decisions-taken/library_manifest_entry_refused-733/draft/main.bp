//// Decision 733 — (a): a library has no `"entry"` — the key is an executable's alone, refused in a library's manifest.

import {io.terminal} from "std";
import {http.Response} from "rakun";
import {version_set.rakunVersion} from "rakun";

// `rakun` is a library: no `main`, no `"entry"`. Each of its files is a
// module reached by its path — `http`, `version_set` — and this program's
// own `"entry"` is the only one: `main` starts here.
pub fn main() -> void {
    val r = Response.ok("hello");
    terminal.print(r.status, r.body);
    terminal.print(rakunVersion());
}
