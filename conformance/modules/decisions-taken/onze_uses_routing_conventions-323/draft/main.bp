//// Decision 323 — `chainFor(patterns)` keeps taking the ancestor patterns rakun's layout chain names for the matched route — onze derives

import {describeAppFiles, chainFor} from "rakun-ssr";
import {io.terminal.print} from "std";

pub fn main() -> void {
    // What an app file is: `routing`'s conventions, read through rakun-ssr's table.
    print(
        describeAppFiles(
            "app",
            [
                "app/page.bp",
                "app/layout.bp",
                "app/blog/[slug]/page.bp",
                "app/blog/[slug]/loading.bp",
                "app/_components/card.bp",
                "app/utils.bp",
            ],
        ),
    );
    // The chain is the ancestor patterns rakun names for the matched route.
    print(chainFor(["/", "/blog", "/blog/[slug]"]).length);
}
