//// Decision 218 — onze's `@/` alias goes: an application writes `import {lib.db.findPost};`; staging no longer rewrites `from "@/…"`, whic

import {io.terminal} from "std";
import {context.RenderScope} from "std";
import {element.Element, element.renderToString, element.h1, element.p} from "rakun-bpp";
import {elements.article} from "rakun-bpp";
import {render.renderComponent} from "rakun-bpp";
import {html.html.html} from "rakun-bpp";
import {lib.db.findPost};

// A page of the application reads its own module by its path, in braces.
component fn PostPage(slug: string) -> Component<Element> {
    val post = findPost(slug);
    return html @`<article><h1>{post?.title ?? "Not found"}</h1><p>{post?.body ?? ""}</p></article>`;
}

pub async fn main() -> Async<void> {
    val page = await renderComponent(PostPage("hello"), RenderScope.root());
    terminal.print(renderToString(page.tree));
}
