//// The application's data module, `lib.db`, imported by its path.

pub type Post(slug: string, title: string, body: string)

val posts = [
    Post(slug: "hello", title: "Hello, rakun", body: "The first post."),
    Post(slug: "second", title: "Second", body: "Another post."),
];

pub fn findPost(slug: string) -> ?Post {
    return posts.find({ p -> p.slug == slug });
}
