//// Decision 148 — A lambda's write to a captured `var` is refused at check time on every target, located at the write, unless the lambda i

import {io.terminal.print} from "std";
import {Response} from "rakun";

pub fn main() -> void {
    val responses = [Response.ok("a"), Response.notFound(), Response.ok("b")];
    var served = 0;
    // A `forEach` body may write the captured `var`.
    for r in responses {
        if (r.status == 200) served = served + 1;
    }
    // A lambda handed to `map` may not: refused at `missing = …`.
    var missing = 0;
    val statuses = responses.map({ r ->
        if (r.status == 404) missing = missing + 1;
        r.status;
    });
    print(served);
    print(missing);
    print(statuses.length);
}
