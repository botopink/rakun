//// Decision 358 — The theme is always declared: an application that expands a `styled` literal has exactly one `#[theme]`, and none is a compile error — no implicit default.

import styled, {StyledSheet, Styled} from "rakun-style";
import {context.createContext, context.provide, io.terminal.print} from "std";

// No `#[theme]` anywhere in the application: there is no implicit default.

// The first literal that reads the theme — `@variant md` and `--theme(--breakpoint-md)` —
// is refused here at compile time, naming the fix:
// `#[theme] pub val appTheme = comptime baseTheme();` (or `= comptime defaultTheme();`).
fn wide() -> Component<Styled> {
    return styled @`
  width: 100%;
  @variant md { max-width: --theme(--breakpoint-md); }
`;
}

fn dropped(layer: string, item: Styled) -> void {}

fn Render() -> Component<Styled> {
    use provide(createContext(StyledSheet(layer: "components", add: dropped)));
    val out = use wide();
    return out;
}

pub fn main() -> Task<void> {
    val s = await Render();
    print(s.rules);
}
