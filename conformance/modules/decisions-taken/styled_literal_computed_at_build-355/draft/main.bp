//// Decision 355 — A `styled` literal is computed at build when every hole is known at build; at render only when a hole is not.

import {io.terminal} from "std";
import {context.createContext, context.provide} from "std";
import styled, {styled.styledProperty, styled.Styled, styled.StyledProperty, styled.StyledSheet} from "rakun-style";

// Every hole known at build: `tab4` is a `val` whose literal has no hole.
pub val tab4 = styledProperty @`tab-size: 4;`;

pub val code = styled @`${tab4} color: red;`;

// A hole naming a parameter: built at build as a template with a slot, filled at render.
component fn badge(c: string) -> Component<Styled> {
    return styled @`color: ${c};`;
}

// The render's sheet: here it prints what a literal computed at render registers.
fn printing(layer: string, item: Styled) -> void {
    terminal.print("registered ", item.rules, "\n");
}

component fn Page() -> Component<string> {
    use provide(createContext(StyledSheet(layer: "components", add: printing)));
    val a = await code;
    val b = await badge("teal");
    val c = await badge("teal");
    return a.className
        + " "
        + b.className
        + " "
        + (b.className == c.className).toString();
}

pub async fn main() -> Async<void> {
    terminal.print(await Page(), "\n");
}
