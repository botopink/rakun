//// Decision 259 — wasm's `std/math` agrees with commonJS bit for bit, `pow` included: std ports glibc's `pow` (the algorithm since glibc 2

import {math, io.terminal.print} from "std";

pub fn main() -> void {
    // std's own `pow` body: the same bits on every target.
    print(math.pow(158.42161580281933, 2.853827476501465));
    print(math.pow(2.0, 0.5));
    print(math.pow(10.0, -3.0));
}
