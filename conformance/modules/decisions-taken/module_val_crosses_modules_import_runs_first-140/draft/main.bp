//// Decision 140 — A module-level `pub val` crosses modules, and an imported module's body runs first

import {io.terminal} from "std";
import {settings.defaults, settings.Defaults};
import {settings.greet as hello};

pub fn main() -> void {
    // `settings`' body ran before this line: its `_` statement printed first.
    terminal.print(defaults.port, " ", defaults.paths.join(","), "\n");
    terminal.print(hello("ana"), "\n");
    val d: Defaults = defaults;
    terminal.print(d.banner(), "\n");
}
