import {io.terminal} from "std";
import {http.Response} from "rakun";

pub type Defaults(port: i32, paths: string[], notFound: Response) {
    pub fn banner(self: Self) -> string {
        return "listening on " + self.port.toString();
    }
}

// Module-level values: a record, and a function value, each `pub`.
pub val defaults = Defaults(port: 8080, paths: ["/api", "/health"], notFound: Response.notFound());

pub val greet = { name -> "Hello, " + name + "!" };

// The body runs once, when the module loads, before the importer's `main`.
val _loaded = terminal.print("settings loaded", "\n");
