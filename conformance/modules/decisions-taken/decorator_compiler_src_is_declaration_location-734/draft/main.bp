//// Decision 734 — (a): `compiler.src()` in a decorator body is legal and answers the annotated declaration's location (718, 575 (3)); 403 survives as "no route from a file's location".

import {compiler, io.terminal.print} from "std";

// What a page decorator records: the route it is given as an argument, and
// where the annotated declaration is written — for a diagnostic, never a route.
pub type PageAt(route: string, file: string, line: i32)

fn page(syntax decl: unknown, comptime route: string) -> void {
    val at = compiler.src();
    compiler.setMeta(PageAt(route: route, file: at.file, line: at.line));
}

#[page("/")]
pub fn home() -> string {
    return "home";
}

#[page("/about")]
pub fn about() -> string {
    return "about";
}

fn show(meta: ?PageAt) -> void {
    val route = meta?.route ?? "no page";
    val file = meta?.file ?? "";
    val line = meta?.line ?? 0;
    print(route + " " + file + ":" + line.toString());
}

pub fn main() -> void {
    show(comptime compiler.typeInfo(home).meta(PageAt));
    show(comptime compiler.typeInfo(about).meta(PageAt));
}
