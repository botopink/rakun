//// Decision 359 — A spread copies a record's fields — in a record's construction and on a tag alike, typed.

import {io.terminal.print} from "std";
import {Response} from "rakun";

pub fn main() -> void {
    val base = Response.ok("hello");
    // A new record: every field of `base`, then `status` written after it.
    val created = Response(..base, status: 201);
    // Several spreads mix with labelled fields, left to right, the later
    // winning.
    val missing = Response.notFound();
    val explained = Response(..missing, ..base, status: 404);
    print(created.status);
    print(created.body);
    print(explained.status);
    print(explained.body);
    // `base` is unchanged.
    print(base.status);
}
