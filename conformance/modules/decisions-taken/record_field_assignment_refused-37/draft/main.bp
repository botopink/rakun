//// Decision 37 — Is a record immutable?

import {io.terminal.print} from "std";
import {Response} from "rakun";

fn markMissing(res: Response) -> void {
    res.status = 404;
}

pub fn main() -> void {
    val res = Response.ok("hello");
    val alias = res;
    res.status = 201;
    markMissing(res);
    print(alias.status);
}
