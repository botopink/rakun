//// Decision 715 — A record constructor's arguments are evaluated in the order written, a spread's source included, each once; a spread copies field values only — the new record's methods are its type's, nothing of the source's behaviour travels.

import {io.terminal} from "std";

pub type Pessoa(nome: string, idade: i32) {
    pub fn saudacao(self: Self) -> string {
        return "Olá, " + self.nome;
    }
}

// Another record with the same fields and a method of its own.
pub type Visitante(nome: string, idade: i32) {
    pub fn saudacao(self: Self) -> string {
        return "Welcome, " + self.nome;
    }
}

fn say(text: string) -> string {
    terminal.print(text);
    return text;
}

fn make() -> Visitante {
    terminal.print("make");
    return Visitante(nome: "Bia", idade: 30);
}

pub fn main() -> void {
    // `say("n")` is written first, so it runs first; `make()` runs once.
    val p = Pessoa(nome: say("n"), ..make());
    terminal.print(p.nome, p.idade);

    // The spread copies `velho`'s values; `saudacao` is `Pessoa`'s.
    val velho = Visitante(nome: "Caio", idade: 41);
    val novo = Pessoa(..velho, idade: 42);
    terminal.print(velho.saudacao());
    terminal.print(novo.saudacao(), novo.idade);
    terminal.print(velho.idade);
}
