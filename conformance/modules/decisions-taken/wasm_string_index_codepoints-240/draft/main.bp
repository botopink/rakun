//// Decision 240 — wasm counts a string's index in codepoints, as erlang and beam: `length`, `at`, `slice`, `indexOf`, `lastIndexOf` walk U

import {io.terminal} from "std";

// A slug as a page route takes it: every index below counts codepoints.
fn shorten(title: string, max: i32) -> string {
    if (title.length <= max) return title;
    return title.slice(0, max - 1) + "…";
}

pub fn main() -> void {
    val title = "Olá, señor 👋 — ünïcode";
    terminal.print(title.length, "\n");
    terminal.print(title.at(2) ?? "", " ", title.at(11) ?? "", "\n");
    terminal.print(title.indexOf("👋"), " ", title.lastIndexOf("ü"), "\n");
    terminal.print(shorten(title, 12), "\n");
}
