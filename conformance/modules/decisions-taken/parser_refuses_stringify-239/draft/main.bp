//// Decision 239 — The parser refuses `$stringify` in every template, std included; std's `Array.join` Erlang template is written without i

import {compiler, io.terminal.print} from "std";
import {Response} from "rakun";

#[compiler.external(
    .Erlang("""iolist_to_binary([<<"status ">>, $stringify($0)])"""),
    .JavaScript("'status ' + $stringify($0)"),
)]
declare fn statusLine(code: i32) -> string;

pub fn main() -> void {
    print(statusLine(Response.ok("hi").status));
}
