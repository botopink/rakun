//// Decision 671 — A field's default travels with the field into every derived type and resolves where it was written (669); there is no "closed" default.

import {links.Link};
import {types.Type, io.terminal.print} from "std";

// A link with no target of its own, derived in another module: `rel` comes
// along with its default, whose code stays `links.bp`'s.
val NoHref = Type.omit(Link, .href);

// A link whose `rel` must be written: the default is kept, the field is not.
val RelOnly = Type.pick(Link, .rel);

fn anchor(link: Link) -> string {
    return "<a href=\"${link.href}\" rel=\"${link.rel}\">";
}

pub fn main() -> void {
    print(anchor(Link(href: "/x")));
    print(NoHref().rel);
    print(RelOnly().rel);
    print(NoHref(rel: "nofollow").rel);
}
