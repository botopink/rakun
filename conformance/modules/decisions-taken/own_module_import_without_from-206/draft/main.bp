//// Decision 206 — `import {…} from "<name>"` resolves only to a package — std, a bundled package or a declared dependency.

import {io.terminal.print} from "std";
import {Response} from "rakun";
import {greeting.welcome};
import {greeting.farewell as bye};

pub fn main() -> void {
    // `Response` comes from the dependency `rakun`, `welcome` and `bye` from
    // this package's own module `greeting`, named by its path with no `from`.
    val res: Response = welcome("ana");
    print(res.status);
    print(res.body);
    print(bye("ana").body);
}
