//// Decision 337 — The shorthand import goes; `mod m;` binds the namespace `m` in the module that declares it.

import {io.terminal} from "std";
import {http.Response} from "rakun";
import {routes.greet};
import {routes};

pub fn main() -> void {
    val r: Response = greet("ana");
    terminal.print(r.status, r.body);
    terminal.print(routes.greet("bia").body);
}
