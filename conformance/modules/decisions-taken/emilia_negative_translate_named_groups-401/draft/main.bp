//// Decision 401 — emilia adds negative translate and named groups / peers; the named `has` / `not` / ARIA / data / `in` variants and `@theme inline` stay deviations, written with `arbSel`.

import {io.terminal} from "std";
import {html.html.html, element.renderToString, styled_sheet.renderedStyles} from "rakun-bpp";
import {emilia.emilia, arbitrary.arbSel} from "rakun-stylesheet";
// The builders the markup's tags call.
import {element.div, element.p, elements.a, elements.input, elements.section, elements.img} from "rakun-bpp";

// `group/card` on the card, and a link that underlines while that card is
// hovered and lifts by `-translate-y-2`.
val card = html @`
<div class="group/card" #[emilia(.Pad.All.__4)]>
  <a #[emilia(.GroupNamed("card", [.GroupHover([.Text.Underline])]), .Transform.TranslateY.Neg.__2)] href="/menu">Menu</a>
  <input class="peer/agree" type="checkbox" />
  <p #[emilia(.PeerNamed("agree", [.PeerChecked([.Text.Bold])]))]>Agreed</p>
  <section #[emilia(arbSel("&:has(img)", [.Pad.All.__2]))]><img src="/a.png" /></section>
</div>
`;

pub fn main() -> void {
    terminal.print(renderToString(card), "\n");
    terminal.print(renderedStyles(), "\n");
}
