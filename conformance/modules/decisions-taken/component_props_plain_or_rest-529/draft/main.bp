//// Decision 529 — A component's props are plain parameters or one record parameter `..props: R`; `..` is the one spelling of the rest; a `.bpp` unfolds to `(..props: Props)`.

import {Element, div, p, text, renderToString} from "rakun-bpp";
import {html} from "rakun-bpp";
import {io.terminal.print} from "std";

pub type CardProps(title: string, featured: bool = false)

// Plain parameters: a tag passes each attribute as the labelled argument.
pub fn Badge(label: string, tone: string = "info") -> Element {
    return p([text(tone + ": " + label)], []);
}

// A record parameter beside a plain one: `CardProps`'s fields are `Card`'s
// parameters from outside, and the body reads them as the record `props`.
pub fn Card(..props: CardProps, footer: string) -> Element {
    val mark = if (props.featured) "* " else "";
    return div([p([text(mark + props.title)], []), Badge(label: footer)], []);
}

val base = CardProps(title: "Olá");

val tagged = html @`<Card title="Olá" featured footer="tag" />`;

val spread = html @`<Card {..base} featured footer="spread" />`;

pub fn main() -> void {
    print(renderToString(Card(title: "Plain", footer: "call")));
    print(renderToString(Card(..base, featured: true, footer: "call spread")));
    print(renderToString(tagged));
    print(renderToString(spread));
    print(renderToString(Badge(label: "alone", tone: "warn")));
}
