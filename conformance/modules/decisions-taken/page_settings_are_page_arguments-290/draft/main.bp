//// Decision 290 — No segment configuration; a page's settings are `#[page]` arguments.

import {io.terminal, io.clock.hours, compiler} from "std";
import {page, RouteSegment, PageContext, ctxParam, html, Element, renderToString} from "rakun-bpp";
// The builders the markup's tags call.
import {elements.article, element.h1} from "rakun-bpp";

#[page("blog/[slug]", paths: ["hello", "second"], revalidate: hours(1), dynamicParams: true)]
component fn Post(route: PageContext) -> Component<Element> {
    val slug = ctxParam(route, "slug");
    return html @`<article><h1>${slug}</h1></article>`;
}

pub async fn main() -> Async<void> {
    val seg = comptime compiler.typeInfo(Post).meta(RouteSegment)?.seg ?? "";
    terminal.print(seg, "\n");
    val route = PageContext(pathname: "/blog/hello", pattern: seg, params: [#("slug", "hello")], rest: []);
    terminal.print(renderToString(await Post(route)), "\n");
}
