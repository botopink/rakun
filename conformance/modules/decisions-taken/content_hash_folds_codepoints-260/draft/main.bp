//// Decision 260 — `hash.contentHash` folds code points: `contentHash("🎉")` is `djb2([127881])` on every target; the Node cell folds `Array

import {io.terminal, hash} from "std";
import {hash.classHash} from "rakun-style";

// djb2 over codepoints, written out: what `contentHash` folds, as lowercase hex.
fn djb2Hex(cps: i32[]) -> string {
    var h: i64 = 5381;
    for c in cps {
        h = (h * 33 + c.toI64()) % 4294967296;
    }
    val digits = "0123456789abcdef";
    var out = "";
    while (h > 0) {
        out = (digits.at((h % 16).toI32()) ?? "") + out;
        h = h / 16;
    }
    return out;
}

pub fn main() -> void {
    // One codepoint, U+1F389, whatever the host's string encoding.
    val party = hash.contentHash("🎉");
    terminal.print(party, " ", party == djb2Hex([127881]), "\n");
    terminal.print(party
        == hash.contentHash(string.fromCodepoint(127881)), "\n");
    // rakun-style names a component's class by the same fold.
    terminal.print(classHash("🎉") == party, "\n");
}
