//// Decision 628 — In a `behavior`, a member without `self` is a static of the behavior and is written `fn`, never `default fn`: `fn unit() -> Self { … }` with a body is the behavior's own function, called `Shape.unit()`; `fn make() -> Self;` without a body is a static each implementor provides (626's `Configurable`); `default fn` is an instance member with an overridable default body, and nothing else.

import {io.terminal.print} from "std";

// What a rakun configuration record answers (626's `Configurable`).
pub behavior Configurable {
    // A static each implementor provides: no `self`, no body.
    fn make() -> Self;

    // The behavior's own static: one function with one owner, called
    // `Configurable.prefixOf(…)`; no implementor overrides it.
    fn prefixOf(key: string) -> string {
        return key.split(".").at(0) ?? "";
    }

    // The property key the record is bound to.
    fn key(self: Self) -> string;

    // An instance member with an overridable default body.
    default fn describe(self: Self) -> string {
        return "configured";
    }
}

pub type ServerConfig(host: string, port: i32) implement Configurable {
    pub fn make() -> Self {
        return ServerConfig(host: "localhost", port: 8080);
    }

    pub fn key(self: Self) -> string {
        return "server.port";
    }

    pub fn describe(self: Self) -> string {
        return self.host + ":" + self.port.toString();
    }
}

pub type MailConfig(from: string) implement Configurable {
    pub fn make() -> Self {
        return MailConfig(from: "noreply@example.com");
    }

    pub fn key(self: Self) -> string {
        return "mail.from";
    }
}

fn line(c: Configurable) -> string {
    return Configurable.prefixOf(c.key()) + " -> " + c.describe();
}

pub fn main() -> void {
    print(line(ServerConfig.make()));
    print(line(MailConfig.make()));
}
