//// Decision 315 — No module-level annotation.

import {io.terminal} from "std";
import {rakun, rakun.Service, rakun.Lifecycle} from "rakun";

// What both modules share is bound once, in a module-level `val` each calls.
val banner: fn(string) -> string = { name -> "[" + name + "] starts" };

// Each module carries its own annotation; nothing annotates the file.
#[rakun.module]
pub component fn store() -> Component<Service> {
    terminal.print(banner("store"));
    return Service(name: "store");
}

#[rakun.module(lifecycle: Lifecycle.Manual)]
pub component fn admin() -> Component<Service> {
    terminal.print(banner("admin"));
    return Service(name: "admin");
}

pub fn main() -> void {
    rakun.boot();
    terminal.print(rakun.registry.all().length);
    val _admin = rakun.start("admin");
    rakun.stop();
}
