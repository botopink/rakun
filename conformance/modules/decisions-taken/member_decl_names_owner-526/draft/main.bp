//// Decision 526 — A member's `@Decl` names its owner: `owner: ?Declared<unknown>` (`null` at module level), set by the checker when it runs a member's decorator.

import {io.terminal} from "std";
import {compiler} from "std";
import {decorators.repository} from "rakun";
import {sql.query.query, sql.query.rkRegisteredQueries} from "rakun-data";

// Two methods named `findById`, on two types: each registration is named by its owner.
#[repository]
pub type UserRepository() {
    #[query("select id, name from users where id = :id")]
    pub fn findById(self: Self, id: i64) -> string[] {
        return [];
    }
}

#[repository]
pub type OrderRepository() {
    #[query("select id, total from orders where id = :id")]
    pub fn findById(self: Self, id: i64) -> string[] {
        return [];
    }
}

// The same reading in a decorator of the program: a member's owner is a handle,
// a module-level function has none.
var seen: string[] = [];

pub fn traced(syntax decl: unknown) -> void {
    val owner = compiler.owner(decl);
    val label = if (owner == null)
        compiler.name(decl)!
    else
        compiler.name(owner)! + "." + compiler.name(decl)!;
    compiler.init({ -> seen.push(label) });
}

#[traced]
pub fn audit() -> void {}

pub type Ledger() {
    #[traced]
    pub fn audit(self: Self) -> void {}
}

pub fn main() -> void {
    terminal.print(rkRegisteredQueries().join(","), "\n");
    terminal.print(seen.join(","), "\n");
}
