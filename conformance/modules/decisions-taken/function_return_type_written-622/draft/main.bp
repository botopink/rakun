//// Decision 622 — Every function writes its return type, `-> void` included: `fn m(self: Self) -> void { … }`, `pub fn main() -> void { … }`; a `fn` with no `->` is refused at its name, `fn-return-missing`, `write -> void, or the type it answers`.

import {io.terminal.print} from "std";
import {Request, Response} from "rakun";
import {testing.fake_request.fakeGet} from "rakun";

pub type Greeter(prefix: string) {
    // A method answering a value writes its type.
    pub fn greet(self: Self, name: string) -> string {
        return self.prefix + ", " + name + "!";
    }

    // A method answering nothing writes `-> void`.
    pub fn announce(self: Self, name: string) -> void {
        print(self.greet(name));
    }
}

fn hello(req: Request) -> Response {
    return Response.ok(Greeter(prefix: "Hello").greet(req.param("name")));
}

pub fn main() -> void {
    Greeter(prefix: "Hi").announce("ana");
    val res = hello(fakeGet("/hello/bob").withParam("name", "bob").toRequest());
    print(res.body);
    val shout = fn(s: string) -> string { s.toUpper() };
    print(shout(res.body));
}
