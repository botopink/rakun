//// Decision 112 — DSL hygiene: each name resolves in the scope of whoever wrote it

import {io.terminal} from "std";
import {html.html.html, element.p, element.renderToString} from "rakun-bpp";

// A function of this module named like the private helper `html`'s expansion
// writes: the expansion never reaches it.
fn htmlText(value: string) -> string {
    return "captured: " + value;
}

pub fn main() -> void {
    val who = "ana";
    // `<p>` and `${who}` are this module's words, resolved here; the
    // `htmlText(…)` around the hole is rakun-bpp's, resolved there.
    val page = html @`<p>hello, ${who}</p>`;
    terminal.print(renderToString(page));
    terminal.print(htmlText(who));
}
