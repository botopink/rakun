//// Decision 356 — A decorator on a `val` runs, and the `val` is catalogued.

import {io.terminal} from "std";
import {rakun} from "rakun";
import {rakun.configOf} from "rakun";

// A package's config: the defaults it runs with when the program says nothing.
pub type MailConfig(host: string = "localhost", port: i32 = 25)

// The program's override: a decorated `val`, its type written.
#[rakun.config]
pub val mail: MailConfig = MailConfig(host: "smtp.example.com", port: 587);

pub fn main() -> void {
    val cfg = configOf("MailConfig", MailConfig());
    terminal.print(cfg.host, cfg.port);
    terminal.print(mail.host == cfg.host);
}
