//// Decision 170 — std takes the natural name and a library's copy goes (`clock.parseDuration`, `async.RetryPolicy`, `async.nextDelay`; rak

import {io.terminal} from "std";
import {regex.matches as patternMatches} from "std";
import {profiles.matches as profileMatches} from "rakun";

pub fn main() -> void {
    val actives = ["prod", "eu"];
    // rakun's profile expression, through its alias.
    terminal.print(profileMatches("prod & !dev", actives));
    terminal.print(profileMatches("dev | test", actives));
    // std's regular expression, through its own.
    terminal.print(patternMatches("^/api/", "/api/users"));
    terminal.print(patternMatches("^/api/", "/health"));
}
