//// Decision 378 — A context always declares its default; a read answers the nearest provider above or the default; `context-unbound` goes.

import {context.createContext, context.provide, context.context, io.terminal.print} from "std";
import {Element, div, p, text, renderToString} from "rakun-bpp";

pub type Theme(primary: string, radius: i32)

// The one declaration of `Theme`'s default, computed at build.
pub val themeContext = comptime createContext(Theme(primary: "#e11d48", radius: 4));

fn Swatch() -> Component<Element> {
    val theme = use context(Theme);
    return p([text(theme.primary
        + "/"
        + theme.radius.toString(), attrs: [])], attrs: []);
}

fn DarkPanel() -> Component<Element> {
    use provide(createContext(Theme(primary: "#111827", radius: 0)));
    return div([await Swatch()], attrs: []);
}

pub fn main() -> Task<void> {
    // No provider above: the declared default.
    print(renderToString(await Swatch()));
    // The nearest provider above.
    print(renderToString(await DarkPanel()));
}
