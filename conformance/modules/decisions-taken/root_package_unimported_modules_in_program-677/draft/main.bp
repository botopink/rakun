//// Decision 677 — The root package is a package like any other: every module under its `src/` is in the program, imported or not, and the manifest's `"entry"` says only where execution starts.

import {io.terminal} from "std";
import {rakun} from "rakun";

// Nothing here imports `jobs`: it is in the program because it sits under
// `src/`, and its `#[rakun.module]` executor has run before `main`.
pub fn main() -> void {
    rakun.boot();
    terminal.print(rakun.registry.find("cleaner")?.name ?? "no cleaner");
    rakun.stop();
}
