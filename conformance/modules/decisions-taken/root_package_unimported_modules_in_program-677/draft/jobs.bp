//// A module of the root package that no file imports.

import {io.terminal} from "std";
import {rakun} from "rakun";
import {rakun.Service, rakun.onStop} from "rakun";

#[rakun.module]
pub component fn cleaner() -> Component<Service> {
    use onStop({ -> terminal.print("cleaner stops") });
    terminal.print("cleaner starts");
    return Service(name: "cleaner");
}
