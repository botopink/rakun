//// Decision 663 — A decorator is always a function, and `Annotation` goes: no type or enum is an annotation by implementing a behavior; `#[name(…)]` names a function whose first parameter is `syntax decl`, and the data an annotation carries is a record the decorator records with `compiler.setMeta`. There is no `Decorator` type (666): a decorator's name at build is a declaration handle.

import {compiler} from "std";
import {io.terminal} from "std";
import {decorators.service} from "rakun";
import {runtime.rkScan, runtime.rkSingleton, runtime.rkEnter, runtime.rkDone} from "rakun";

// The data the annotation carries: a plain record.
pub type Owner(team: string)

// The decorator: a function whose first parameter is the declaration; it
// records the data with `compiler.setMeta`.
pub fn owner(syntax decl: unknown, comptime team: string) -> void {
    compiler.setMeta(Owner(team: team));
}

#[service]
#[owner(team: "billing")]
pub type Invoices() {
    pub fn total(self: Self) -> i32 {
        return 42;
    }
}

#[service]
#[owner(team: "mail")]
pub type Mailer()

// What was annotated, read back at build with `compiler.meta<Owner>`.
val owners: string[] = comptime compiler
    .find(with: owner)
    .map({ d -> compiler.name(d)! + " -> " + (compiler.meta<Owner>(d)?.team ?? "?") });

pub fn main() -> void {
    terminal.print(owners.join(", "));
    terminal.print(Invoices.make().total());
}
