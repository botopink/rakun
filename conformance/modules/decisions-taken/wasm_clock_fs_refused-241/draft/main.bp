//// Decision 241 — `io/clock.offsetMinutes`, `io/fs.workingDir` and `io/fs.scratchDir` have no wasm binding, so under 146 `io/clock` and `i

import {io.terminal} from "std";
import {io.clock, io.fs} from "std";

// What rakun's logging stamps and its config loader looks for, read on wasm:
// the local offset of the clock and a file under the working directory.
pub fn main() -> void {
    val now = clock.nowMillis();
    terminal.print(clock.offsetMinutes(now));
    terminal.print(fs.exists("config/application.json"));
}
