//// Decision 327 — `#[validated]`'s parse half are members of the type, named without the type's name:

import {io.terminal} from "std";
import {decorators.validated, decorators.minValue} from "validation";
import {report.ValidationReport} from "validation";
import {Json, decode, encode} from "json";

#[validated]
pub type Player(name: string, #[minValue(0)] score: i32)

fn codes(r: Result<Player, ValidationReport>) -> string {
    return case r {
        Ok(p) -> "ok " + p.name + " " + p.score.toString();
        Error(report) -> report.violations
            .map({ v -> v.field + ":" + v.code })
            .join(",");
    };
}

pub fn main() -> void {
    // JSON text, as a request body arrives.
    terminal.print(codes(Player.decode("""{"name": "ana", "score": 12}""")));
    // A `Json` already read: the same parse, and the same parse under a path.
    val doc = try decode("""{"name": "bo", "score": -1}""") catch Json.Null;
    terminal.print(codes(Player.parse(doc)));
    terminal.print(codes(Player.parseAt(doc, "players[1]")));
    // Form pairs, as a query string or a posted form arrives.
    terminal.print(codes(Player.bind([#("name", "cy"), #("score", "7")])));
    // Back to JSON, and the type's JSON Schema.
    val out = try Player.encode(Player(name: "di", score: 3)) catch Json.Null;
    terminal.print(encode(out));
    terminal.print(Player.jsonSchema().contains("\"score\""));
}
