// The decorator's module: the names its code uses resolve here, where they are written.
import {io.clock} from "std";
import {compiler} from "std";

pub type AuditEntry(owner: string, at: i64)

var entries: AuditEntry[] = [];

fn record(owner: string) -> void {
    entries.push(AuditEntry(owner: owner, at: clock.nowMillis()));
}

pub fn audited() -> AuditEntry[] {
    return entries;
}

// `record` and `AuditEntry` are this module's: the annotated module imports neither.
pub fn auditable(syntax decl: unknown) -> void {
    val owner = compiler.name(decl)!;
    compiler.init({ -> record(owner) });
    compiler.addMember("lastAudit", fn() -> ?AuditEntry {
        return entries.at(entries.length - 1);
    });
}
