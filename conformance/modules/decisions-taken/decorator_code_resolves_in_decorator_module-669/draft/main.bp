//// Decision 669 — Code a decorator writes resolves in the decorator's module, a type it builds included; the one way to a caller's names is `compiler.lookup`.

import {io.terminal} from "std";
import {decorators.service} from "rakun";
import {audit.auditable, audit.audited};

// This module imports `auditable` and nothing else of the decorator's module.
#[service]
#[auditable]
pub type PaymentService() {
    pub fn charge(self: Self, cents: i64) -> string {
        return "charged " + cents.toString();
    }
}

pub fn main() -> void {
    terminal.print(PaymentService.make().charge(990), "\n");
    terminal.print(audited().length, " ", PaymentService.lastAudit()?.owner ?? "-", "\n");
}
