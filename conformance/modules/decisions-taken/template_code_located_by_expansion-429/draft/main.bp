//// Decision 429 — The compiler locates template-built code by its expansion — every loc-keyed plan keyed by (expansion, offset); this fix lands first and pauses the fronts that would add a padded expansion.

import {html} from "rakun-bpp";
import {Element, ul, li, text, renderToString} from "rakun-bpp";
import {io.terminal.print} from "std";

pub type Item(label: string)

// Two expansions of one literal in one module: no padding tells them apart.
fn Tags(items: Item[]) -> Element {
    return html @`<ul>${items.map({ it -> li([text(it.label, attrs: [])], attrs: []) })}</ul>`;
}

fn Labels(items: Item[]) -> Element {
    return html @`<ul>${items.map({ it -> li([text(it.label, attrs: [])], attrs: []) })}</ul>`;
}

pub fn main() -> void {
    print(renderToString(Tags([Item(label: "a"), Item(label: "b")])));
    print(renderToString(Labels([Item(label: "c")])));
}
