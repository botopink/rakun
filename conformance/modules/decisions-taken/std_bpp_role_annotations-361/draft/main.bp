//// Decision 361 — std's module `bpp` holds the four role annotations; jhonstart is one package; the manifest names it alone.

import {io.terminal, bpp, compiler, compiler.Call, compiler.Name, compiler.Arg, compiler.List, compiler.Lit} from "std";
import {Element, div, text, renderToString} from "rakun-bpp";
import {Styled, styledConstant} from "rakun-style";

// The markup's unfold target.
#[bpp.html]
pub fn html(syntax t: string) -> anyvalue {
    val inner = Call(callee: Name("text"), args: [Arg(name: "value", value: Lit(compiler
        .text(t)
        .trim()))]);
    return compiler.ast(Call(callee: Name("div"), args: [Arg(name: "children", value: List([inner]))]));
}

// The style section's unfold target.
#[bpp.style]
pub fn style(syntax css: string) -> anyvalue {
    val rules = ".s_card{" + compiler.text(css).trim() + "}";
    return compiler.ast(Call(callee: Name("styledConstant"), args: [
        Arg(name: "className", value: Lit("s_card")),
        Arg(name: "rules", value: Lit(rules)),
    ]));
}

// A prelude is a module: its marker `val` carries the role, its imports are the prelude.
#[bpp.htmlPrelude]
pub val prelude = bpp.Prelude();

#[bpp.stylePrelude]
pub val stylePrelude = bpp.Prelude();

pub async fn main() -> Async<void> {
    val markup = html @`hello`;
    val card = await style @`color: red;`;
    terminal.print(renderToString(markup), "\n");
    terminal.print(card.className, "\n");
}
