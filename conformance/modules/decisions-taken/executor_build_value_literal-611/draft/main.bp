//// Decision 611 — A build value an executor needs may be read in the decorator's body and enter the executor as a literal — `val declName = compiler.name(decl); compiler.init({ -> rkRegisterX(declName, decl); });` (cells `compile_executor_before_main`, `compile_executor_handle_typed`).

import {compiler, io.terminal.print} from "std";
import {component} from "rakun";

// The build value is read in the decorator's body and enters the executor
// as a literal.
fn registered(syntax decl: unknown) -> void {
    val declName = compiler.name(decl)!;
    compiler.init({ -> print("registered " + declName); });
}

// The same read written inside the executor: `compiler.*` there is
// evaluated at build too (614).
fn announced(syntax decl: unknown) -> void {
    compiler.init({ -> print("announced " + compiler.name(decl)!); });
}

#[component]
#[registered]
pub type Clock(zone: string)

#[announced]
pub type Calendar(year: i32)

pub fn main() -> void {
    print(Clock(zone: "UTC").zone);
    print(Calendar(year: 2026).year.toString());
}
