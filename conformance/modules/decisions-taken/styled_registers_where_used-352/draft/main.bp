//// Decision 352 — A `styled` value registers in the render's sheet through the root context `StyledContext` (354), where it is used — `use x`, `#[styled(x)]` —, never where it is made (377).

import styled, {styledProperty, StyledProperty, StyledSheet, Styled} from "rakun-style";
import {context.createContext, context.provide, io.terminal.print} from "std";

fn padAll(n: i32) -> StyledProperty {
    return styledProperty @`padding: --spacing(${n});`;
}

// Making a `styled` value reads no context and registers nothing.
component fn badge(c: string) -> Component<Styled> {
    return styled @`color: ${c}; ${padAll(2)}`;
}

// The sheet's writer: each registration is a line.
fn write(layer: string, item: Styled) -> void {
    print("registered " + layer + " " + item.rules);
}

// Made on the first line, registered on the second: `use look` adds its class and
// rules to the sheet of the nearest `StyledContext`. The `${padAll(2)}` splice adds
// nothing of its own.
component fn Card(c: string) -> Component<Styled> {
    val look = badge(c);
    val s = use look;
    return s;
}

// The render's root provides `StyledContext`: whoever renders owns the sheet.
component fn Page() -> Component<Styled> {
    use provide(createContext(StyledSheet(layer: "components", add: write)));
    val first = await Card("red");
    val second = await Card("blue");
    print("classes " + first.className + " " + second.className);
    return first;
}

pub async fn main() -> Async<void> {
    val _made = badge("green");
    print("made, not used");
    val page = await Page();
    print("page " + page.className);
}
