//// Decision 174 — † `Dict.ofEntries(entries: Array<#(K, V)>) -> Dict<K, V>` in `libs/std/src/collections.bp`; a key that repeats keeps its

import {io.terminal} from "std";
import {collections.Dict} from "std";
import {config.Entry, config.cliEntries} from "rakun";

pub fn main() -> void {
    // Two sources of rakun's configuration, the lower first.
    val defaults = cliEntries(["--server.port=8080", "--rakun.web.base-path=/api"]);
    val overrides = cliEntries(["--server.port=9090"]);
    val all: array<Entry> = defaults.append(overrides);

    // One table of them: a key that repeats keeps its last value.
    val table = Dict.ofEntries(all.map({ e -> #(e.key, e.value) }));
    terminal.print(table.get("server.port") ?? "unset");
    terminal.print(table.get("rakun.web.base-path") ?? "unset");
    terminal.print(table.size());

    // Built entry by entry with `insert`, the same table.
    var byInsert: Dict<string, string> = Dict.empty();
    for e in all {
        byInsert = byInsert.insert(e.key, e.value);
    }
    terminal.print(byInsert == table);
}
