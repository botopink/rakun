//// Decision 310 — Two same-named types from two modules may be imported under aliases — 170 holds for types as for values:

import {io.terminal} from "std";
import {io.http.Response as Upstream} from "std";
import {http.Response as Served} from "rakun";

// A proxy's last step: what the upstream answered, as rakun's response.
fn relay(upstream: Upstream) -> Served {
    if (upstream.status >= 500) return Served.withStatus(502, "bad gateway");
    return Served(status: upstream.status, body: upstream.body);
}

fn kind(v: unknown) -> string {
    if (v is Upstream) return "upstream";
    if (v is Served) return "served";
    return "other";
}

pub fn main() -> void {
    val ok: Upstream = Upstream(status: 200, body: "{\"id\": 1}");
    val down = Upstream(status: 503, body: "");
    val a: Served = relay(ok);
    val b = relay(down);
    terminal.print(a.status, a.body);
    terminal.print(b.status, b.body);
    terminal.print(kind(ok), kind(a));
    terminal.print(Served.notFound().status);
}
