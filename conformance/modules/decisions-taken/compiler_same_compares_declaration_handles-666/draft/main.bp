//// Decision 666 — The `Decorator` type goes: a decorator is a function (663) and its name at build is a declaration handle; two declarations are compared with `compiler.same(a, b)`.

import {io.terminal} from "std";
import {compiler} from "std";
import {decorators.restController, decorators.getMapping, decorators.postMapping, decorators.postMapping as post} from "rakun";
import {http.Request, http.Response} from "rakun";

var routes: string[] = [];

// A decorator is a function; at build its name is a declaration handle, and two handles
// are compared with `compiler.same`.
pub fn inventory(syntax decl: unknown) -> void {
    var reads = 0;
    var writes = 0;
    for (compiler.methods(decl)) { m ->
        for (m.annotations) { a ->
            if (compiler.same(a.decorator, getMapping)) reads = reads + 1;
            if (compiler.same(a.decorator, postMapping)) writes = writes + 1;
        }
    }
    val line = compiler.name(decl)!
        + ": "
        + reads.toString()
        + " read, "
        + writes.toString()
        + " write";
    compiler.init({ -> routes.push(line) });
}

#[restController]
#[inventory]
pub type NoteController() {
    #[getMapping("/notes")]
    pub fn list(self: Self, req: Request) -> Response {
        return Response.ok("[]");
    }

    #[getMapping("/notes/:id")]
    pub fn one(self: Self, req: Request) -> Response {
        return Response.ok("{}");
    }

    // Written through an alias: still rakun's `postMapping`.
    #[post("/notes")]
    pub fn add(self: Self, req: Request) -> Response {
        return Response.created("{}");
    }
}

pub fn main() -> void {
    terminal.print(routes.join("\n"), "\n");
}
