//// Decision 367 — Contract 4 follows 338: an emilia class is the layer's prefix plus `contentHash` over the class's rules, as `styled` renders them — one class rule for every component.

import {io.terminal} from "std";
import {hash.contentHash} from "std";
import {emilia.className, tokens.Token, theme.defaultTheme} from "rakun-stylesheet";

// Contract 4's shared fixture: a card's tokens.
fn cardTokens() -> Token[] {
    return [.Bg.White, .Pad.All.__4, .Text.Bold, Token.Hover([.Bg.Color.Gray.__100])];
}

// The class's rules as `styled` renders them, the class written `\u{1}`.
val cardRules = "\u{1}{background:#ffffff;padding:calc(var(--spacing) * 4);font-weight:bold}@media (hover: hover){\u{1}:hover{background-color:var(--color-gray-100)}}";

pub fn main() -> void {
    val c = comptime className(cardTokens(), defaultTheme());
    terminal.print(c); // e_f51c2501
    // The layer's prefix plus `contentHash` over the rules, as for every component.
    terminal.print(c == "e_" + contentHash(cardRules));
    // The same tokens in another order are other rules, so another class.
    val reordered = comptime className([.Text.Bold, .Bg.White, .Pad.All.__4, Token.Hover([.Bg.Color.Gray.__100])], defaultTheme());
    terminal.print(reordered == c);
}
