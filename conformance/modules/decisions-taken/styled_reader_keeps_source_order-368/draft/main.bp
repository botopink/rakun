//// Decision 368 — `styled`'s reader keeps source order, and emilia's `flush()` keeps the document frame around `styled`'s sheet.

import styled, {styledProperty, StyledSheet, Styled} from "rakun-style";
import {emilia.flush} from "rakun-stylesheet";
import {context.createContext, context.provide, io.terminal.print} from "std";

pub val bg = styledProperty @`background: #ffffff;`;

pub val gray = styledProperty @`background: var(--color-gray-100);`;

pub val pad = styledProperty @`padding: --spacing(4);`;

// The padding is written after the nested rule: it opens a new rule.
pub val focusPad = styled @`${bg} &:focus { ${gray} } ${pad}`;

// The same declarations, the padding first: another order, another class.
pub val padFocus = styled @`${bg} ${pad} &:focus { ${gray} }`;

fn dropped(layer: string, item: Styled) -> void {}

fn Render() -> Component<Styled> {
    use provide(createContext(StyledSheet(layer: "components", add: dropped)));
    val a = use focusPad;
    val b = use padFocus;
    print(a.rules);
    print(a.className == b.className);
    return a;
}

pub fn main() -> Task<void> {
    val _page = await Render();
    val doc = await flush();
    val frame = doc.indexOf("@layer theme, base, components, utilities;");
    print(frame >= 0 && frame < doc.indexOf(":root{"));
}
