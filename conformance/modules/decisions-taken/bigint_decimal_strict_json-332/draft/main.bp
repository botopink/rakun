//// Decision 332 — Big numbers, and `Json` read like Jackson's strict configuration.

import {io.terminal} from "std";
import {decimal.Decimal, decimal.Rounding} from "std";
import {http.Response} from "rakun";

// An invoice line: an exact amount, never an f64.
pub type Line(item: string, amount: Decimal)

fn total(lines: Line[]) -> Decimal {
    var sum = Decimal(unscaled: 0n, scale: 2);
    for l in lines {
        sum = sum.add(l.amount);
    }
    return sum;
}

pub fn main() -> void {
    // `bigint`: any size, the `n` suffix, every integer operator.
    val big = 123456789012345678901234567890n;
    terminal.print(big * 10n + 1n, "\n");

    // `Decimal`: add exactly; divide only with a scale and a rounding mode.
    val lines = [
        Line(item: "coffee", amount: Decimal
            .parse("0.10")
            .unwrapOr(Decimal(unscaled: 0n, scale: 0))),
        Line(item: "tea", amount: Decimal
            .parse("0.20")
            .unwrapOr(Decimal(unscaled: 0n, scale: 0))),
    ];
    val sum = total(lines);
    terminal.print(sum.toString(), "\n");
    val third = sum.div(Decimal(unscaled: 3n, scale: 0), scale: 2, rounding: Rounding.HalfEven);
    terminal.print(third.toString(), "\n");

    // `==` is the numeric value; the scale is kept for printing.
    val one = Decimal(unscaled: 10n, scale: 1);
    val oneAgain = Decimal(unscaled: 100n, scale: 2);
    terminal.print(one
        == oneAgain, " ", one.toString(), " ", oneAgain.toString(), "\n");

    terminal.print(Response.json("{\"total\":"
        + sum.toString()
        + "}").body, "\n");
}
