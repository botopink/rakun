//// Decision 187 — rakun's 25 members become 16 (a module another always needs is not a plugin): the core absorbs `rakun-actuator-api` and

import {io.terminal} from "std";
// The core holds what every member needs: the logger and the span API.
import {logging.logging.logger} from "rakun";
import {actuator_api.span.startSpan, actuator_api.span.endSpan, actuator_api.span.traceparentOf} from "rakun";
import {actuator_api.contract.healthUp} from "rakun";
// HATEOAS is part of the web layer, not a member of its own.
import {hateoas.hal.link, hateoas.hal.linksObject} from "rakun-service";

pub fn main() -> void {
    val log = logger("orders");
    val span = startSpan("orders.list", "{}");
    val _l = log.info("listing orders");
    val links = linksObject([link("self", "/orders"), link("next", "/orders?page=2")]);
    terminal.print(links);
    terminal.print(healthUp().status);
    terminal.print(traceparentOf(span).startsWith("00-"));
    val _e = endSpan(span, "ok");
}
