//// Decision 38 — A `val` is immutable

import {io.terminal} from "std";
import {http.Response} from "rakun";

// The status a handler answers, chosen once.
fn status(found: bool) -> i32 {
    val code = 200;
    if (!found) code = 404;
    return code;
}

pub fn main() -> void {
    terminal.print(Response.withStatus(status(false), "").status, "\n");
}
