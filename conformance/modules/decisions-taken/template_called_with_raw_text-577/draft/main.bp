//// Decision 577 — A template is called one way: its name before a template text `` @`…` ``, raw.

import {io.terminal, compiler} from "std";
import {html, Element, renderToString} from "rakun-bpp";
// The builders the markup's tags call.
import {elements.article, elements.h2, element.p} from "rakun-bpp";

pub type Statement(sql: string)

// A template: the text first; a second `syntax` parameter makes it an annotation too.
fn sql(syntax q: string, syntax decl: unknown) -> anyvalue {
    compiler.setMeta(Statement(sql: compiler.text(q)));
    return compiler.ast(compiler.Lit(""));
}

#[sql @`select * from posts where id = ${id}`]
fn findPost(id: i32) -> string {
    return "post " + id.toString();
}

component fn Card(title: string) -> Component<Element> {
    return html @`
<article>
  <h2>${title}</h2>
  <p>line one\nstill line one</p>
  <p>quoted with \`backticks\`</p>
</article>
`;
}

pub async fn main() -> Async<void> {
    terminal.print(renderToString(await Card("raw text")), "\n");
    val stmt = comptime compiler.typeInfo(findPost).meta(Statement);
    terminal.print(stmt?.sql ?? "none", "\n");
    terminal.print(findPost(7), "\n");
}
