//// Decision 350 — emilia renders what Tailwind 4.3.2 compiles, as close as it can, written with `styled` (338).

import {io.terminal} from "std";
import {emilia.styleRule, tokens.Token, theme.defaultTheme} from "rakun-stylesheet";
import {styled.styledProperty, styled.StyledProperty} from "rakun-style";

// A family in Tailwind's own CSS syntax, upstream's `@utility` quoted beside it:
//   @utility p-* { padding: --spacing(--value(integer)); }
fn padAll(n: i32) -> StyledProperty {
    return styledProperty @`padding: --spacing(${n});`;
}

// Upstream 4.3.2 compiles `p-4` to this; the family's literal must match it.
val upstreamP4 = "padding: calc(var(--spacing) * 4);";

fn declarations(tokens: Token[]) -> string {
    return styleRule(tokens, defaultTheme())._1;
}

pub fn main() -> void {
    // One helper per shape, each upstream's form:
    terminal.print(declarations([.Size.W.Frac.Half])); // width: calc(1 / 2 * 100%)
    terminal.print(declarations([.Effect.Opacity.__60])); // opacity: 60%
    terminal.print(declarations([.Transform.Rotate.Neg.__12])); // rotate: calc(12deg * -1)
    terminal.print(comptime padAll(4).declarations == upstreamP4);
}
