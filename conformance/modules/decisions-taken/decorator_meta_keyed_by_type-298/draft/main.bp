//// Decision 298 — A decorator's meta is a typed value keyed by its type:

import {io.terminal} from "std";
import {compiler} from "std";
import {orm.entity.entity, orm.entity.id, orm.entity.EntityMapping} from "rakun-data";

// An index the program declares: one value per `#[index]`, so it is added, never set.
pub type Index(columns: string[], unique: bool)

pub fn index(syntax decl: unknown, comptime unique: bool, comptime ..columns: string[]) -> void {
    compiler.addMeta(Index(columns: columns, unique: unique));
}

// `#[entity]` sets one `EntityMapping` on `City`; the two `#[index]` add two `Index` values.
#[entity("cities")]
#[index(true, "name", "state_name")]
#[index(false, "state_name")]
pub type City(#[id] id: i64, name: string, stateName: string)

pub fn main() -> void {
    // Read at build, by the meta's type — not by the name of the decorator that wrote it.
    val table = comptime compiler
        .typeInfo(City)
        .meta(EntityMapping)?.table ?? "";
    val indexes = comptime compiler.typeInfo(City).metaAll(Index);
    terminal.print(table, "\n");
    for (indexes) { ix ->
        terminal.print(ix.columns.join("+"), if (ix.unique)
            " unique"
        else
            "", "\n");
    }
}
