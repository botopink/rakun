//// Decision 222 — A route handler is always server: a `#[route]` handler (`route.bp`, answering a `Response`, every method, `GET` included

import {io.terminal, io.clock} from "std";
import {Request, rkDispatch} from "rakun";
import {route_handler.getRoute, route_handler.HandlerResponse, route_handler.serveApp} from "rakun-app";
import {page, PageContext, html, Element} from "rakun-bpp";
// The builders the markup's tags call.
import {element.li, element.ul} from "rakun-bpp";

// Prerendered once at build: it reads nothing per request.
#[page("posts")]
component fn Posts(route: PageContext) -> Component<Element> {
    return html @`<ul><li>first post</li></ul>`;
}

// Always server: run per request, `GET` included, never at build.
#[getRoute("api/now")]
pub async fn now(req: Request) -> Async<HandlerResponse> {
    return HandlerResponse.json("{\"now\":"
        + clock.nowMillis().toString()
        + "}");
}

pub fn main() -> void {
    val _app = serveApp();
    val first = rkDispatch("GET", "/api/now");
    val second = rkDispatch("GET", "/api/now");
    terminal.print(first.status, " ", second.status, "\n");
    terminal.print(first.body != "" && second.body != "", "\n");
}
