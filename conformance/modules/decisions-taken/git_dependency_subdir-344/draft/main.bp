//// Decision 344 — A git dependency may name a package inside its repository: `"subdir"`.

import {io.terminal.print} from "std";
import {Response} from "rakun";
import {cors.corsPolicy, cors.allowsOrigin} from "rakun-service";

// `rakun` and `rakun-service` are two packages of one repository, each
// declared with `"git"`, one `"ref"` and its own `"subdir"`: one checkout.
pub fn main() -> void {
    val policy = corsPolicy(["https://example.com"], ["GET"], [], [], false, 600);
    val res = Response.ok("hello");
    print(res.status);
    print(allowsOrigin(policy, "https://example.com"));
    print(allowsOrigin(policy, "https://evil.example"));
}
