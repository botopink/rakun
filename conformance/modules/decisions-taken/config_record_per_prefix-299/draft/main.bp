//// Decision 299 — rakun's configuration is a typed record per prefix:

import {io.terminal} from "std";
import {component, config, key, env} from "rakun";

pub type BootstrapMode {
    Eager,
    Lazy,
}

// Everything under `rakun.data` in the config file, as one typed record: the
// prefix is a string, each key a field's exact name, each default the field's.
#[config("rakun.data")]
pub type DataConfig(
    poolSize: i32 = 10,
    bootstrapMode: BootstrapMode = .Eager,
    // read from `rakun.data.connect-timeout` instead of `connectTimeout`
    #[key("connect-timeout")] connectTimeout: i32 = 5000,
    // read from the environment variable `DB_URL`
    #[env("DB_URL")] url: string = "postgres://localhost/app",
)

// The record is injected by its type, like any other bean.
#[component]
pub type Pool(cfg: DataConfig) {
    pub fn describe(self: Self) -> string {
        val mode = case self.cfg.bootstrapMode {
            Eager -> "eager";
            Lazy -> "lazy";
        };
        return self.cfg.url
            + " pool="
            + self.cfg.poolSize.toString()
            + " "
            + mode
            + " timeout="
            + self.cfg.connectTimeout.toString();
    }
}

pub fn main() -> void {
    terminal.print(Pool.make().describe());
}
