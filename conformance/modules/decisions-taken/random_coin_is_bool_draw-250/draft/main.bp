//// Decision 250 — † std's `io.random.bool()` is dropped, not renamed; `coin()` is the boolean draw

import {io.random, io.terminal.print} from "std";

// A feature flag flipped per request: the draw is a `bool`, so it stands
// where a condition is expected with no comparison around it.
fn variant(flag: bool) -> string {
    return if (flag) "B" else "A";
}

pub fn main() -> void {
    var heads = 0;
    var seen = "";
    for (0..200) { i ->
        val flag: bool = random.coin();
        if (flag) heads = heads + 1;
        val v = variant(flag);
        if (!seen.contains(v)) seen = seen + v;
    }
    print(heads >= 0 && heads <= 200);
    print(seen.length >= 1);
}
