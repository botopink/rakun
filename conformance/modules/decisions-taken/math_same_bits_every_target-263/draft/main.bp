//// Decision 263 — `std/math` answers the same bits on every target and OS: its transcendental functions call std's private botopink bodies

import {math, io.terminal.print} from "std";

// A backoff curve the way a retry policy computes it: the same numbers on
// every target and OS.
fn backoff(attempt: i32) -> f64 {
    return math.floor(100.0 * math.exp(attempt.toF64() * 0.5));
}

pub fn main() -> void {
    print(math.sin(1.0));
    print(math.tan(0.5));
    print(math.exp(1.0));
    print(math.log10(2.0));
    print(math.pow(1.5, 2.25));
    print(math.sqrt(2.0));
    for attempt in [1, 2, 3] {
        print(backoff(attempt));
    }
}
