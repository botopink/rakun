//// Decision 46 — `d["k"]` on a `Dict` routes to `lookup`

import {collections.Dict, io.terminal.print} from "std";
import {Response} from "rakun";

fn routes() -> Dict<string, Response> {
    return Dict
        .empty()
        .insert("/", Response.ok("home"))
        .insert("/about", Response.ok("about"));
}

fn serve(table: Dict<string, Response>, path: string) -> Response {
    return table[path] ?? Response.notFound();
}

pub fn main() -> void {
    val table = routes();
    print(serve(table, "/about").body);
    print(serve(table, "/about").status);
    print(serve(table, "/missing").status);
    print(table["/"]?.body ?? "none");
    print(table["/nope"]?.body ?? "none");
}
