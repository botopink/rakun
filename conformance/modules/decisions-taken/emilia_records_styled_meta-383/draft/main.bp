//// Decision 383 — `#[emilia(…)]` records `styled`'s `StyledMeta(layer: Layer, className: string, rules: string)`, one per tag.

import {io.terminal, compiler} from "std";
import {html.html.html, element.renderToString, styled_sheet.renderedStyles} from "rakun-bpp";
import {emilia.emilia} from "rakun-stylesheet";
import {styled.StyledMeta} from "rakun-style";
// The builders the markup's tags call.
import {elements.a, elements.nav} from "rakun-bpp";

// A second style library may record the same meta type for its own layer:
// `html` reads it by type and names neither library.
pub fn outline(syntax decl: unknown, comptime width: i32) -> void {
    val c = "ol_" + width.toString();
    compiler.setMeta(StyledMeta(layer: .Components, className: c, rules: "."
        + c
        + "{outline-width:"
        + width.toString()
        + "px}"));
}

val page = html @`
<nav>
  <a #[emilia(.Pad.X.__4, .Text.Underline)] #[outline(2)] href="/">Home</a>
</nav>
`;

pub fn main() -> void {
    terminal.print(renderToString(page), "\n");
    terminal.print(renderedStyles(), "\n");
}
