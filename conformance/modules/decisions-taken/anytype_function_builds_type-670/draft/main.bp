//// Decision 670 — Any function declared `-> anytype` builds a type; std's `Type` functions are the first of them, not a privilege.

import {compiler} from "std";
import {io.terminal} from "std";
import {types.Type} from "std";

pub type User(name: string, email: string, password: string)

// A function of the program's own that builds a type: every field of `t` but
// the password.
pub fn view<T>(comptime t: type<T>) -> anytype {
    return compiler.buildTypeInline(fields: compiler
        .fields(t)
        .filter({ f -> f.name != "password" }));
}

// Each `val` is a type, evaluated at build: one from the program, one from std.
pub val PublicUser = view(User);

pub val UserPatch = Type.partial(User);

fn publicOf(u: User) -> PublicUser {
    return PublicUser(name: u.name, email: u.email);
}

pub fn main() -> void {
    val ana = User(name: "ana", email: "ana@example.com", password: "s3cret");
    val shown = publicOf(ana);
    val patch = UserPatch(name: null, email: "ana@rakun.dev", password: null);
    terminal.print(shown.name + " " + shown.email);
    terminal.print(patch.email ?? "unchanged");
}
