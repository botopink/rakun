//// Decision 661 — (b), read with 504: everything in rakun-style is a component — `Styleable.toStyled(self: Self) -> Component<Styled>` stays — and being a component asks no `await` of its callers: calling a component only makes its lambda (388, 504), so `Sheet.add(self: Self, layerName: string, item: Styleable) -> Sheet` stays a plain function, keeps its chain, and stores `item.toStyled()` — a component value — in the entry; the renderer runs the stored components when the sheet is rendered.

import {io.terminal} from "std";
import styled, {styled.styledProperty, styled.Styled, styled.StyledProperty, layers.Sheet, layers.layer} from "rakun-style";

pub val card = styled @`border-radius: 4px; padding: 1rem;`;

pub val tab4 = styledProperty @`tab-size: 4;`;

component fn badge(c: string) -> Component<Styled> {
    return styled @`color: ${c};`;
}

// Building the sheet is plain: `add` stores each component value, nothing awaits.
fn appSheet() -> Sheet {
    return Sheet
        .of([layer("base"), layer("components")])
        .add("components", card)
        .add("components", badge("teal"))
        .add("base", tab4);
}

pub async fn main() -> Async<void> {
    val sheet = appSheet();
    terminal.print(sheet.entries.length, "\n");
    // The sheet's render is the component that runs every stored entry.
    val css: string = await sheet.render();
    terminal.print(css, "\n");
}
