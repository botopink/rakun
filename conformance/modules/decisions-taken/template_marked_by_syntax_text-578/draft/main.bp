//// Decision 578 — No `-> expr`: a template is marked by its `syntax` text parameter and returns a type, `anyvalue` or `anytype`; `anytype` is the bare `type`.

import {compiler, compiler.Call, compiler.Member, compiler.Name, compiler.Lit} from "std";
import {io.terminal} from "std";
import {http.Response} from "rakun";

// A template answering an ordinary type: the path is checked at build and the
// call is a `string`.
pub fn path(syntax q: string) -> string {
    val text = compiler.text(q);
    if (!text.startsWith("/"))
        compiler.fail("a route path starts with `/`", at: q);
    return text;
}

// A template answering `anyvalue`: the call takes the type of the code it
// builds — here `Response.ok("…")`, a rakun `Response`.
pub fn reply(syntax q: string) -> anyvalue {
    return compiler.ast(Call(
        callee: Member(target: Name(name: "Response"), member: "ok"),
        args: [Lit(value: compiler.text(q))],
    ));
}

pub fn main() -> void {
    val p = path @`/users/:id`;
    val r: Response = reply @`hello`;
    terminal.print(p);
    terminal.print(r.status.toString() + " " + r.body);
}
