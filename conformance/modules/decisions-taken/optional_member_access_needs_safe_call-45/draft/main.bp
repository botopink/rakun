//// Decision 45 — A member access on a `?T` is an error naming `?.`

import {io.terminal} from "std";
import {rakun, rakun.Service} from "rakun";

#[rakun.module]
pub component fn web() -> Component<Service> {
    return Service(name: "web");
}

pub fn main() -> void {
    rakun.boot();
    // `registry.find` answers `?Module`: a member read on it is refused,
    // naming `?.`.
    terminal.print(rakun.registry.find("web").name);
    rakun.stop();
}
