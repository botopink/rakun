//// Decision 338 — CSS is built in three layers — `css`, `styled`, emilia — none of which knows `.bpp`; jhonstart integrates them, and a `.bpp` file's style is a section of its own.

import {io.terminal} from "std";
import styled, {styled.styledProperty, styled.Styled, styled.StyledProperty, layers.Sheet, layers.Layer, layers.layer} from "rakun-style";
import {theme.theme, theme.extendTheme, theme.baseTheme, theme.entry, theme.ThemeValue} from "rakun-style";
import {html.html.html, element.renderToString} from "rakun-bpp";
import {emilia.emilia} from "rakun-stylesheet";
// The builders the markup's tags call.
import {elements.article, element.h1} from "rakun-bpp";

// rakun-style's theme, declared once by the application.
#[theme]
pub val appTheme = extendTheme(baseTheme(), [entry(.Breakpoint, "md", ThemeValue.Rem(52.0))]);

// A family as rakun-stylesheet writes one: declarations as a value, a hole for the value.
component fn padAll(n: i32) -> Component<StyledProperty> {
    return styledProperty @`padding: --spacing(${n});`;
}

// A variant wraps another component; `@apply` is a `${p}` hole of a property.
component fn onHover(inner: Component<StyledProperty>) -> Component<Styled> {
    return styled @`&:hover { ${inner} }`;
}

// An application component, with a theme read resolved at build.
pub val card = styled @`
  border-radius: 4px;
  @variant md { max-width: --theme(--breakpoint-md); }
`;

// rakun-bpp integrates them: the markup names rakun-stylesheet's tag decorator.
val page = html @`
<article>
  <h1 #[emilia(.Text.Size.X3xl, .Text.Bold)]>Menu</h1>
</article>
`;

pub async fn main() -> Async<void> {
    terminal.print(renderToString(page), "\n");
    val sheet = Sheet
        .of([layer("components"), Layer(name: "utilities", prefix: "e_")])
        .add("components", card)
        .add("utilities", onHover(padAll(2)));
    terminal.print(await sheet.render(), "\n");
}
