//// Decision 176 — † `string.parseInt()` of an integer beyond the `i64` range (−2^63 … 2^63 − 1, 319) is `Error` on every target

import {io.terminal} from "std";
import {http.Response} from "rakun";

// A path parameter read as an id: a number the client wrote, so it may be anything.
fn byId(raw: string) -> Response {
    return case raw.parseInt() {
        Ok(id) -> Response.ok("item " + id.toString());
        Error(message) -> Response.badRequest(message);
    };
}

pub fn main() -> void {
    // i64's largest value reads; one more is an `Error`, not a wrapped or rounded number.
    terminal.print(byId("9223372036854775807").body, "\n");
    terminal.print(byId("9223372036854775808").status, "\n");
    terminal.print(byId("-9223372036854775808").body, "\n");
    terminal.print(byId("-9223372036854775809").status, "\n");
}
