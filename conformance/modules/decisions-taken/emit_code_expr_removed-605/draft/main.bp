//// Decision 605 — `@emit`, `@code` and `@expr` are removed now, with `builtins.d.bp`, in B-139; nothing is parked and 604 gains no exception; 165 s10 lands before B-139.

import {compiler, io.terminal.print} from "std";
import {service} from "rakun";

// A registration: no `@emit`, the marker registers through the init list.
fn catalogued(syntax decl: unknown, comptime area: string) -> void {
    val declName = compiler.name(decl)!;
    compiler.init({ -> print("catalogue " + area + ": " + declName) });
    // A generated function beside the type: a static member, typed.
    compiler.addMember("area", { -> area });
}

// rakun's `#[service]` registers its scan the same way and adds `make()`.
#[service]
#[catalogued("billing")]
pub type InvoiceService() {
    pub fn total(self: Self, cents: i32) -> string {
        return (cents / 100).toString() + "." + (cents % 100).toString();
    }
}

pub fn main() -> void {
    print(InvoiceService.area());
    print(InvoiceService.make().total(1250));
}
