//// Decision 668 — A function's type parameter is always bound by a parameter, never by the return type alone.

import {io.terminal.print} from "std";

// A registry of beans by name, the shape rakun's container answers.
pub type Registry(names: string[]) {
    // Refused at the declaration, `type-parameter-unbound`, naming `T`: `T`
    // occurs in no parameter, so nothing at a call fixes it but the caller's
    // wish, and the body cannot act on it.
    pub fn get<T>(self: Self, name: string) -> ?T {
        return null;
    }
}

pub fn main() -> void {
    val registry = Registry(names: ["DataSource"]);
    val found: ?string = registry.get("DataSource");
    print(found ?? "none");
}
