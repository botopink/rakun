//// Decision 382 — `#[emilia(…)]`'s tokens are an expression, as every `comptime` parameter (364): `pub fn emilia(comptime decl: @Decl, comptime ..tokens: @Expr<Token[]>)`.

import {emilia.emilia, flush, Token} from "rakun-stylesheet";
import {Element, div, text, renderToString} from "rakun-bpp";
import {io.terminal.print} from "std";

// The tokens are the annotation's arguments: an expression of `Token[]`,
// each leading-dot path resolved against `Token`.
#[emilia(.Pad.All.4, .Bg.White, .Color.Black, Token.Hover([.Color.Red.600]))]
fn Card() -> Component<Element> {
    return div([text("card", attrs: [])], attrs: []);
}

pub fn main() -> Task<void> {
    print(renderToString(await Card()));
    print(await flush());
}
