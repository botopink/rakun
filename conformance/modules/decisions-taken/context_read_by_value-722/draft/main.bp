//// Decision 722 — A context is read through a context value the reader imports — `use context(themeContext)`, never a bare type name — answering the nearest context of that type provided above, else the default the handle carries; the handle is imported as any name, so the default is found through the import graph and nothing is searched

import {io.terminal, context.createContext, context.provide, context.context} from "std";
import {html, Element, renderToString} from "rakun-bpp";
import {theme.Theme, theme.themeContext};
// The builders the markup's tags call.
import {element.div, elements.main} from "rakun-bpp";

component fn Card(title: string) -> Component<Element> {
    val t = use context(themeContext);
    return html @`<div style="color: ${t.primary}; border-radius: ${t.radius}px">${title}</div>`;
}

component fn Page() -> Component<Element> {
    val dark = comptime createContext(Theme(primary: "#111", radius: 8));
    use provide(dark);
    return html @`<main>${Card("inside")}</main>`;
}

pub async fn main() -> Async<void> {
    terminal.print(renderToString(await Page()), "\n");
    terminal.print(renderToString(await Card("alone")), "\n");
}
