//// Decision 175 — † `hash.pbkdf2Sha256(password, salt, iterations, length)` derives over the salt's UTF-8 bytes, the same on node and erla

import {hash, io.terminal.print} from "std";
import {password.pbkdf2Encoder} from "rakun-security";

pub fn main() -> void {
    // Derived over the salt's UTF-8 bytes, the same on node and erlang.
    print(hash.pbkdf2Sha256("password", "salt", 1, 32));
    // rakun-security's encoder stores `{pbkdf2}<iterations>$<salt>$<hash>`.
    val encoder = pbkdf2Encoder();
    val stored = encoder.encode("s3cret");
    print(stored.startsWith("{pbkdf2}"));
    print(encoder.matches("s3cret", stored));
    print(encoder.matches("guess", stored));
}
