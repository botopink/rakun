//// Decision 704 — No cancellation in std's async: a losing racer and an expired timeout run to completion and their results are dropped; `raceOf` / `timeout` document it.

import {async, io.terminal.print} from "std";
import {rkCtxNote, rkCtxNotes} from "rakun";

async fn fast() -> Async<string> {
    return await async.delay(1, "fast");
}

// The loser: nothing stops it once the race is decided.
async fn slow() -> Async<string> {
    val v = await async.delay(50, "slow");
    val _n = rkCtxNote("slow ran to completion");
    return v;
}

// The task a timeout gives up on: it keeps running too.
async fn report() -> Async<string> {
    val v = await async.delay(80, "report");
    val _n = rkCtxNote("report ran to completion");
    return v;
}

async fn run() -> Async<void> {
    val won = await async.raceOf([{ -> slow() }, { -> fast() }]);
    print("won " + won);
    val budget = await async.timeout({ -> report() }, 10);
    val answer = case budget {
        Ok(v) -> v;
        Error(e) -> e;
    };
    print("timeout " + answer);
    print("noted before: [" + rkCtxNotes() + "]");
    val _w = await async.delay(300, 0);
    print("noted after: [" + rkCtxNotes() + "]");
}

pub fn main() -> void {
    run();
}
