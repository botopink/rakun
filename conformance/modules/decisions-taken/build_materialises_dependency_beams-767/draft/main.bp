//// Decision 767 — `botopink build` materialises the dependencies' cached `.beam` into the output (509 (4)'s materialisation, for `build` as for `run`), and rakun-ssr's `compileBeam` runs `erlc` only over the `.erl` with no `.beam` beside them — the app's own modules.

import {Request, Response, controller, route, getMapping, rkDispatch} from "rakun";
import {io.terminal.print} from "std";

#[controller]
#[route("/api")]
pub type HelloController() {
    #[getMapping("/hello/:name")]
    pub fn hello(self: Self, req: Request) -> Response {
        return Response.ok("hello, " + req.param("name"));
    }
}

pub fn main() -> void {
    val res = rkDispatch("GET", "/api/hello/ana");
    print(res.status.toString() + " " + res.body);
}
