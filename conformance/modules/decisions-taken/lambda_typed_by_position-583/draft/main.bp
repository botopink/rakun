//// Decision 583 — Every function is typed where it is written.

import {io.terminal} from "std";
import {rakun, rakun.Service, rakun.onStop} from "rakun";
import {http.Response} from "rakun";

// A typed return fixes the lambda's type: `status` is a `Response`.
fn statusOf() -> fn(Response) -> i32 {
    return { status -> status.status };
}

#[rakun.module]
pub component fn web() -> Component<Service> {
    // The parameter `onStop` takes fixes the lambda's type.
    use onStop({ -> terminal.print("web stops") });
    return Service(name: "web");
}

pub fn main() -> void {
    rakun.boot();
    val answers = [Response.ok("a"), Response.created("b"), Response.notFound()];

    // A lambda passed to `map`: its position types `r`.
    terminal.print(answers.map({ r -> r.status }));

    // An annotated `val` types its lambda.
    val isError: fn(Response) -> bool = { r -> r.status >= 400 };
    terminal.print(answers.filter(isError).length);

    terminal.print(answers.map(statusOf()));

    // Nothing would type a bare `val twice = { n -> n * 2 }`: the typed form.
    val twice = fn(n: i32) -> i32 {
        return n * 2;
    };
    terminal.print(twice(21));
    rakun.stop();
}
