//// Decision 342 — `@embedFile(comptime path: @Expr<string>) -> string` reads a file at compile time, in any context

import {compiler, asset.Asset, failure.panic, io.terminal.print} from "std";

// The link is made at build: the path is relative to this package's
// `botopink.json`, and the file's hash enters the build's cache key.
val banner = comptime Asset(compiler.embed("src/banner.txt"));

pub fn main() -> void {
    // Read at build: the text is a constant of the compiled program.
    val atBuild = comptime {
        val f = try banner.open() catch panic("banner");
        try f.text() catch panic("banner")
    };
    // Read when the program runs: the file is deployed with it.
    val f = try banner.open() catch panic("banner");
    val atRun = try f.text() catch panic("banner");
    print(atBuild.trim());
    print(atBuild == atRun);
}
