//// Decision 362 — `05-jhonstart/26` rewrites the native builders into 351's props form, in place, and the hand-written callers with them — one builder per tag, never two.

import {Element, nav, ul, li, a, text, renderToString} from "rakun-bpp";
import {io.terminal.print} from "std";

fn link(href: string, label: string) -> Element {
    return li(children: [a(href: href, children: [text(label)])]);
}

pub fn main() -> void {
    val menu = nav(
        children: [
            ul(
                children: [
                    li(
                        children: [
                            a(
                                href: "/blog",
                                className: "active",
                                ariaCurrent: "page",
                                dataTrack: "nav-blog",
                                children: [text("Blog")],
                            ),
                        ],
                    ),
                    link("/about", "About"),
                ],
            ),
        ],
    );
    print(renderToString(menu));
}
