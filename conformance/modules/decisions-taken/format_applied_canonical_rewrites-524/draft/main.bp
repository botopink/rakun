//// Decision 524 — `botopink format` is applied, never checked: the commit hook formats the commit's `.bp` files; the seven rewrites are the canonical form; C-13 becomes formatting.

import {Response} from "rakun";
import {io.terminal.print} from "std";

fn greet(name: string) -> Response {
    if (name == "") return Response.withStatus(400, "a name is required");
    return Response.ok("Hello, " + name + "!");
}

pub fn main() -> void {
    for (["ana", ""]) { name ->
        val res = greet(name);
        print(res.status.toString() + " " + res.body);
    }
}
