//// Decision 580 — An executor is a statement of its module's body at its declaration's position: one init list, source order.

import {io.terminal} from "std";
import {rakun} from "rakun";
import {rakun.Service} from "rakun";

fn names() -> string[] {
    var out: string[] = [];
    for (rakun.registry.all()) { m ->
        out.push(m.name);
    }
    return out;
}

// One init list, in source order: each executor runs where its declaration stands,
// between the module's `val`s.
val atStart = names();

#[rakun.module]
pub component fn store() -> Component<Service> {
    return Service(name: "store");
}

val afterStore = names();

#[rakun.module]
pub component fn web() -> Component<Service> {
    return Service(name: "web");
}

val afterWeb = names();

pub fn main() -> void {
    terminal.print(atStart.length, " ", afterStore.join(","), " ", afterWeb.join(","), "\n");
    rakun.boot();
}
