//// Decision 614 — Both forms are valid: a `compiler.*` call inside an executor is evaluated at build and enters the executor as a literal, exactly as a `val` read before it does — `compiler` exists only at build, so where it runs is never ambiguous; the refusal `syntax-captures-build` goes.

import {compiler} from "std";
import {io.terminal} from "std";
import {runtime.rkScan, runtime.rkScannedCount, runtime.rkScannedNames} from "rakun";

// The `compiler.*` call inside the executor: evaluated at build, it enters
// the executor as the literal it answered.
pub fn scanned(syntax decl: unknown) -> void {
    compiler.init({ -> rkScan(compiler.name(decl)!); });
}

// The same name read into a `val` first: the same init statement.
pub fn scannedByVal(syntax decl: unknown) -> void {
    val name = compiler.name(decl)!;
    compiler.init({ -> rkScan(name); });
}

#[scanned]
pub type Orders()

#[scannedByVal]
pub type Invoices()

pub fn main() -> void {
    terminal.print(rkScannedCount());
    terminal.print(rkScannedNames());
}
