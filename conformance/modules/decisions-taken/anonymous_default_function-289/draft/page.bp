import {page} from "rakun-bpp";
import {Element, article, h1, text} from "rakun-bpp";

// What a `.bpp` route file unfolds to: the module's default, with no name.
#[page("blog/[slug]")]
pub default component fn () -> Component<Element> {
    return article([h1([text("post", attrs: [])], attrs: [])], attrs: []);
}
