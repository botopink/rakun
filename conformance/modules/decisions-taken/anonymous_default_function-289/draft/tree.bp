import {Element, ul, li, text} from "rakun-bpp";

// Called by name inside itself, so it is named, then made the default.
fn Tree(depth: i32) -> Element {
    if (depth == 0) return li([text("leaf", attrs: [])], attrs: []);
    return ul([li([text("node", attrs: [])], attrs: []), Tree(depth
        - 1)], attrs: []);
}

pub default Tree;
