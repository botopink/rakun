//// Decision 676 — Every declared dependency's `"targets"` holds every target of the package that declares it, checked at the manifest; 660's order is depth-first by the manifests and by the deepest chain, as built.

import {io.terminal} from "std";
import {http.Response} from "rakun";
import {layers.Sheet, layers.layer} from "rakun-style";

// A server package built for erlang: `rakun` declares erlang, `rakun-style`
// declares erlang and commonJS, so each dependency holds every target of this one.
pub fn main() -> void {
    val sheet = Sheet.of([layer("base"), layer("components")]);
    terminal.print(sheet.layers.length, "\n");
    terminal.print(Response.ok(sheet.render()).status, "\n");
}
