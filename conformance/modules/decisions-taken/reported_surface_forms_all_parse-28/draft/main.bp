//// Decision 28 — What decision 14 left unassigned

import {io.terminal} from "std";
import {http.Response} from "rakun";

// A module-level `var`: one count per execution context — the process on the
// BEAM, where rakun's own registries (`rakun.bp`'s `modules`) live too.
var built: i32 = 0;

fn respond(body: string) -> Response {
    built = built + 1;
    return Response.ok(body);
}

// A function answering a function: `adder(3)(4)` calls the call's result.
fn adder(a: i32) -> fn(i32) -> i32 {
    return { b -> a + b };
}

pub fn main() -> void {
    // A labelled tuple's array type.
    val routes: #(path: string, status: i32)[] = [#("/", 200), #("/old", 301)];

    // A bare `if` that is not its block's last statement, with no `;` after it.
    if (routes.length > 1) terminal.print("two routes");

    terminal.print(adder(3)(4));

    // A method and a member read off a parenthesised expression.
    terminal.print((respond("hi")).status.toString());
    terminal.print(("ab").length());

    // `??` gives an optional its default.
    terminal.print(routes.at(5)?.status ?? 404);
    terminal.print(routes.at(1)?.status ?? 404);

    terminal.print(built);
}
