//// Decision 346 — A `Bytes` primitive:

import {io.terminal} from "std";
import {http.Response} from "rakun";

// An upload as it enters: bytes, never a string carrying them.
pub type Upload(name: string, content: bytes)

fn describe(u: Upload) -> Response {
    return case u.content.toUtf8() {
        Ok(text) -> Response.ok(u.name
            + ": "
            + text.length.toString()
            + " characters");
        Error(message) -> Response.badRequest(u.name + ": " + message);
    };
}

pub fn main() -> void {
    val note = Upload(name: "note.txt", content: bytes.fromUtf8("olá"));
    terminal.print(note.content.length, "\n");
    terminal.print(describe(note).body, "\n");

    // A payload that is not UTF-8 (a lead byte with no continuation) stays bytes; reading it as text is an `Error`.
    val binary = Upload(name: "pixel.bin", content: bytes
        .fromUtf8("GIF")
        .concat(note.content.slice(2, 3)));
    terminal.print(describe(binary).status, "\n");
    terminal.print(note.content == bytes.fromUtf8("olá"), "\n");
}
