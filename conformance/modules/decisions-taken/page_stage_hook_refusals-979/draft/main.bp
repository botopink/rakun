//// Decision 979 — The stage a page renders in is a compile-time fact read off the hooks list: a page that reaches a `#[serverOnly]` hook renders per request, one that reaches none is prerendered, and no page declares its stage; `#[page]` refuses a `#[serverOnly]` hook inside a `#[client]` component and a `#[clientOnly]` hook outside one — two refusals, no third; restates 186 with 947 folded in (202 read with it), replacing 186 and 947.

import {page, client.client, serverOnly, clientOnly, searchParams, pairValue} from "rakun-bpp";
import {Element, div, p, span, text, renderToString} from "rakun-bpp";
import {io.terminal.print} from "std";

// Request time only: reading the query makes a page that reaches it dynamic.
#[serverOnly]
component fn sortOrder() -> Component<string> {
    val q = use searchParams();
    return pairValue(q, "sort");
}

// The browser only: legal inside a `#[client]` component.
#[clientOnly]
component fn viewportWidth() -> Component<i32> {
    return 1024;
}

// No marker: any stage.
component fn greeting() -> Component<string> {
    return "hello";
}

#[client]
pub component fn SizeBadge() -> Component<Element> {
    val w = use viewportWidth();
    return span([text(w.toString() + "px", attrs: [])], attrs: []);
}

// Reaches no marked hook: prerendered at build (kind `S`).
#[page("about")]
pub component fn about() -> Component<Element> {
    val hi = use greeting();
    return div([p([text(hi
        + " from about", attrs: [])], attrs: [])], attrs: []);
}

// Reaches a `#[serverOnly]` hook: rendered per request (kind `D`).
#[page("search")]
pub component fn search() -> Component<Element> {
    val order = use sortOrder();
    return div([p([text("sorted by "
        + order, attrs: [])], attrs: []), await SizeBadge()], attrs: []);
}

pub async fn main() -> Async<void> {
    print(renderToString(await about()));
    print(renderToString(await search()));
}
