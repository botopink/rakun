//// Decision 737 — (a): a component takes its props as plain parameters or as one record parameter `..props: R` — 529 (1), (2) stand whole.

import {io.terminal} from "std";
import {html, Element, renderToString} from "rakun-bpp";
// The builders the markup's tags call.
import {element.div, elements.main, elements.section} from "rakun-bpp";

// Plain parameters: each attribute is the labelled argument.
component fn Card(title: string, featured: bool = false) -> Component<Element> {
    val mark = if (featured) " *" else "";
    return html @`<div class="card">${title}${mark}</div>`;
}

pub type PanelProps(title: string, featured: bool = false)

// One record parameter: its fields are the props, the body reads the record.
component fn Panel(..props: PanelProps) -> Component<Element> {
    val mark = if (props.featured) " *" else "";
    return html @`<section>${props.title}${mark}</section>`;
}

component fn Page() -> Component<Element> {
    val base = PanelProps(title: "Resumo");
    return html @`
<main>
  <Card title="Olá" featured />
  <Card title="Tchau" />
  <Panel {..base} featured />
</main>
`;
}

pub async fn main() -> Async<void> {
    terminal.print(renderToString(await Page()), "\n");
}
