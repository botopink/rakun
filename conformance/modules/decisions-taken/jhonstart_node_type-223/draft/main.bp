//// Decision 223 — jhonstart's node type — what a slot holds and what a hole accepts (191) — is `Node`, imported `import {Node} from "jhons

import {io.terminal} from "std";
import {html, Element, Node, renderToString} from "rakun-bpp";
// The builders the markup's tags call.
import {elements.h2, element.li, elements.section} from "rakun-bpp";

component fn Card(title: string, children: Node) -> Component<Element> {
    return html @`<section><h2>${title}</h2>${children}</section>`;
}

fn item(label: string) -> Element {
    return html @`<li>${label}</li>`;
}

fn pick(rich: bool) -> Node {
    return if (rich) item("rich") else "plain";
}

pub async fn main() -> Async<void> {
    terminal.print(renderToString(await Card("greeting", "Hello")), "\n");
    terminal.print(renderToString(await Card("list", [item("one"), item("two")])), "\n");
    terminal.print(renderToString(await Card("answer", 42)), "\n");
    terminal.print(renderToString(await Card("chosen", pick(false))), "\n");
}
