//// Decision 262 — A primitive `String.fromCodepoint(cp: i32) -> string` in `primitives.bp` (Node `String.fromCodePoint`, erlang `<<Cp/utf8

import {io.terminal} from "std";
import {element.p, element.text, element.renderToString} from "rakun-bpp";

// A word built from its code points: one, two, three and four UTF-8 bytes.
fn word(points: i32[]) -> string {
    return points.map({ cp -> string.fromCodepoint(cp) }).join("");
}

pub fn main() -> void {
    val greeting = word([79, 108, 225]);
    val price = word([8364, 32, 53]);
    val party = string.fromCodepoint(127881);
    terminal.print(renderToString(p([text(greeting), text(" " + party)])));
    terminal.print(price, price.length());
    terminal.print(string.fromCodepoint("é".charCodeAt(0)) == "é");
}
