//// Decision 296 — `cardume` is a library of its own

import {atom, selector} from "cardume";
import {atomValue, atomSetter} from "rakun-cardume";
import {Element, span, text, renderToString, RequestData, enterRequest, leaveRequest} from "rakun-bpp";
import {io.terminal.print} from "std";

// Declared once, no string key: the declaration is the identity.
pub val cartCount = atom(0);

pub val cartLabel = selector({ get -> get(cartCount).toString() + " items" });

// Reads the request's store through the bridge's hook.
component fn CartBadge() -> Component<Element> {
    val label = use atomValue(cartLabel);
    return span([text(label, attrs: [])], attrs: []);
}

component fn addToCart() -> Component<void> {
    val set = use atomSetter(cartCount);
    val n = use atomValue(cartCount);
    set(n + 1);
}

fn request() -> RequestData {
    return RequestData(method: "GET", path: "/cart", params: [], query: [], headers: [], cookies: []);
}

pub async fn main() -> Async<void> {
    enterRequest(request());
    print(renderToString(await CartBadge()));
    await addToCart();
    await addToCart();
    print(renderToString(await CartBadge()));
    leaveRequest();
    enterRequest(request());
    print(renderToString(await CartBadge()));
    leaveRequest();
}
