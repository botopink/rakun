//// Decision 351 — A native tag's attributes are typed the way React types its intrinsic elements, in botopink's own shapes, and `prelude.bp` is the intrinsic table.

import {io.terminal} from "std";
import {context.RenderScope} from "std";
import {element.Element, element.renderToString, element.div} from "rakun-bpp";
import {elements.a, elements.nav, elements.form, elements.input, elements.label, elements.AnchorProps} from "rakun-bpp";
import {render.renderComponent} from "rakun-bpp";
import {html.html.html} from "rakun-bpp";

// A value of the anchor's own props type, spread onto an element.
val docsLink = AnchorProps(href: "/docs", target: .Blank, rel: "noopener");

component fn Header() -> Component<Element> {
    return html @`<div>
  <nav ariaLabel="Main">
    <a href="/" data-track="home">Home</a>
    <a {..docsLink} class="external">Docs</a>
  </nav>
  <form action="/subscribe">
    <label>E-mail <input id="email" type={.Email} tabIndex={2} required /></label>
  </form>
</div>`;
}

pub async fn main() -> Async<void> {
    val page = await renderComponent(Header(), RenderScope.root());
    terminal.print(renderToString(page.tree));
}
