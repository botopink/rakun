//// Decision 599 — The run-time field key goes; `compiler.Field<T>` is a build-time value; what is built at comptime is built through `compiler.*`, in botopink.

import {io.terminal} from "std";
import {compiler} from "std";
import {orm.entity.entity, orm.entity.id, orm.entity.index, orm.entity.unique} from "rakun-data";

// `.state` and `.name` are build-time field keys, checked against `City`'s fields.
#[entity("cities")]
#[index(.state)]
#[unique(.name, .state)]
pub type City(#[id] id: i64, name: string, state: string, population: i64)

// What a decorator or a build step reads, it reads through `compiler.*`, in botopink.
fn columns() -> string[] {
    return comptime {
        var out: string[] = [];
        for f in compiler.fields(City) {
            out.push(f.name);
        }
        out
    };
}

pub fn main() -> void {
    terminal.print(columns().join(","), "\n");
}
