//// Decision 594 — Every library runs at build on the wasm comptime runtime (434), jhonstart first; a function only Erlang or Node can run is a located error there.

import {div, p, text, renderToString} from "rakun-bpp";
import {io.terminal.print} from "std";

fn footer(year: i32) -> string {
    return renderToString(div([p([text("© "
        + year.toString()
        + " rakun")], [])], []));
}

pub fn main() -> void {
    // Rendered at build, on the wasm comptime runtime, whatever `--target` is.
    val atBuild = comptime footer(2026);
    // The same render at run time, on the program's target.
    val atRun = footer(2026);
    print(atBuild);
    print(atBuild == atRun);
}
