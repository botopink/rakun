//// Decision 725 — A component is never asynchronous because of its children: 375's mark counts the node's own body only.

import {Element, article, section, h1, p, text, state, renderToString} from "rakun-bpp";
import {io.terminal.print} from "std";

pub type Post(title: string)

fn loadPost(slug: string) -> Task<Post> {
    return Post(title: slug);
}

// Asynchronous: its own body writes `await`.
fn PostBody(slug: string) -> Component<Element> {
    val post = await loadPost(slug);
    return article([h1([text(post.title, attrs: [])], attrs: [])], attrs: []);
}

// Not asynchronous: its own body uses a synchronous hook and composes the
// asynchronous child, which only puts the child's lambda in the tree.
fn PostPage(slug: string) -> Component<Element> {
    val views = use state(1);
    return section(
        [PostBody(slug), p([text("views "
            + views.value.toString(), attrs: [])], attrs: [])],
        attrs: [],
    );
}

// Not asynchronous either: a call of a function answering a task, with no
// `await` written, marks nothing.
fn Shell(slug: string) -> Component<Element> {
    val _pending = loadPost(slug);
    return section([PostPage(slug)], attrs: []);
}

pub fn main() -> Task<void> {
    // The root is always asynchronous: the render walks the tree and awaits
    // only the marked lambda, `PostBody`'s.
    print(await renderToString(Shell("hello")));
}
