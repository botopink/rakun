//// Decision 274 — Pulsar is not split: it stays in `rakun-messaging/src/pulsar/` and rakun keeps 16 members (a split would remove no edge)

import {io.terminal} from "std";
import {service} from "rakun";
import {pulsarListener, startMessaging, Message} from "rakun-messaging";
import {pulsar.pulsar.parseTopic, pulsar.pulsar.renderTopic} from "rakun-messaging";

#[service]
pub type OrderEvents() {
    #[pulsarListener("persistent://public/default/orders", subscription: "billing")]
    pub fn onOrder(self: Self, msg: Message) -> i32 {
        return 0;
    }
}

pub fn main() -> void {
    terminal.print(renderTopic(parseTopic("orders")), "\n");
    // Refused: the listener names the deferred data plane.
    val _started = startMessaging();
    terminal.print("not reached", "\n");
}
