//// Decision 384 — A member a library's decorator writes resolves each name where it was written: the library's names in the decorator's module, the annotation's arguments in the annotated module — 112's hygiene for members.

import {configurationProperties, rkSetProp} from "rakun";
import {io.terminal.print} from "std";

// A function of this program with the name of one of rakun's readers: the
// member `#[configurationProperties]` writes never calls it.
fn rkValueOr(key: string, fallback: string) -> string {
    return "the application's own rkValueOr";
}

#[configurationProperties("app.mail")]
pub type MailConfig(host: string, port: i32)

pub fn main() -> void {
    val _host = rkSetProp("app.mail.host", "smtp.example.com");
    val _port = rkSetProp("app.mail.port", "2525");
    // `bindProperties` is the member the decorator added; its readers
    // resolve in rakun's module, the prefix where the annotation wrote it.
    val mail = MailConfig.bindProperties("app.mail");
    print(mail.host);
    print(mail.port.toString());
    print(rkValueOr("app.mail.host", ""));
}
