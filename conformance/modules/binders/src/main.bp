import {binding.bindInt, binding.bindRequired, binding.bindingReport} from "validation";
import {report.ValidationReport, report.Violation} from "validation";
import {Response} from "rakun";

fn handle(nameRaw: string, ageRaw: string) -> Response {
    val name = bindRequired("name", nameRaw);
    val age = bindInt("age", ageRaw);
    val bound = bindingReport();          // every violation, and the accumulator is now empty
    if (bound.isValid() == false) return Response.withStatus(400, bound.toProblemDetail());
    return Response.ok(name + " " + age.toString());
}

fn main() {
    // `Request.query` answers "" when absent; the binders tell absent from zero.
    val ok = handle("ana", "12");
    @print(ok.status.toString() + " " + ok.body);
    val bad = handle("", "12x");
    @print(bad.status.toString());
    @print(bad.body);
    // the accumulator was emptied by `bindingReport()`
    @print(bindingReport().isValid().toString());
}
