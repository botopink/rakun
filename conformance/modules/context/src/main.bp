import {service, repository, managed, Context, rootContext, rkAddBean, rkInstallBeans, rkResolve, rkFind} from "rakun";
import {rkScan, rkSingleton, rkEnter, rkDone, rkRegisterBean} from "rakun";
import {collections.Dict} from "std";

#[repository]
#[managed]
pub type OrderRepository() {
    pub fn ids(self: Self) -> string[] {
        return ["o-1", "o-2", "o-3"];
    }
}

#[service]
#[managed]
pub type OrderCache(repo: OrderRepository) {
    pub fn size(self: Self) -> i32 {
        return self.repo.ids().length;
    }
}

#[service]
#[managed]
pub type OrderReader(ctx: Context) {
    pub fn size(self: Self) -> i32 {
        val cache: ?OrderCache = self.ctx.resolve("OrderCache");
        var n = 0;
        if (cache != null) n = cache.size();
        return n;
    }
}

fn beans() -> Dict<string, unknown> {
    return comptime {
        var d: Dict<string, unknown> = Dict.empty();
        for (@TypeInfo.all(with: [service, repository], member: "make")) { b ->
            d = rkAddBean(d, b.name, b.value);
        }
        break d;
    };
}

fn main() {
    val _beans = rkInstallBeans(beans());
    @print(OrderReader.make().size().toString());
    // Bind the receiver to an ANNOTATED local.
    val ctx: Context = rootContext();
    val cache: ?OrderCache = ctx.resolve("OrderCache");
    if (cache != null) @print(cache.size().toString());
    // `Context` is not a bean of its own registry.
    @print(ctx.has("Context").toString());
    @print(ctx.beanNames().join(","));
    // A child looks in its own registry and delegates upward on a miss.
    val kid: Context = ctx.child("request");
    @print("[" + ctx.path() + "] " + kid.path());
    @print(kid.has("OrderCache").toString());
}
