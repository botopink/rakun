import {context, bootSequence, Event, eventListener, rkRegisterListener, service, managed, rkAddBean, rkInstallBeans} from "rakun";
import {rkScan, rkSingleton, rkEnter, rkDone, rkResolve, rkRegisterBean} from "rakun";
import {collections.Dict} from "std";

// One listener per event of the sequence, to make its order visible.
#[service]
#[managed]
pub type BootWatch() {
    #[eventListener("ApplicationStarting")]
    pub fn starting(self: Self, ev: Event) { @print(ev.name); }

    #[eventListener("ApplicationEnvironmentPrepared")]
    pub fn environment(self: Self, ev: Event) { @print(ev.name); }

    #[eventListener("ApplicationContextInitialized")]
    pub fn initialized(self: Self, ev: Event) { @print(ev.name); }

    #[eventListener("ApplicationPrepared")]
    pub fn prepared(self: Self, ev: Event) { @print(ev.name); }

    #[eventListener("ApplicationStarted")]
    pub fn started(self: Self, ev: Event) { @print(ev.name); }

    #[eventListener("AvailabilityChanged")]
    pub fn availability(self: Self, ev: Event) { @print(ev.name + ":" + ev.payload); }

    #[eventListener("ApplicationReady")]
    pub fn ready(self: Self, ev: Event) { @print(ev.name); }
}

fn beans() -> Dict<string, unknown> {
    return comptime {
        var d: Dict<string, unknown> = Dict.empty();
        for (@TypeInfo.all(with: [service], member: "make")) { b ->
            d = rkAddBean(d, b.name, b.value);
        }
        break d;
    };
}

fn main() {
    val _beans = rkInstallBeans(beans());
    // The reference's `main` followed this call with `Rakun.run(App(...))`,
    // which listens on a port and never returns; a cell stops at the sequence.
    val published = bootSequence();
    @print(published.toString());
}
