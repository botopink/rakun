// What the fence called `middleware.bp, at the project root`: one function
// marked `#[middleware]`, registered at band -50 with its matcher.
import {Response, rkScan, rkSingleton, rkEnter, rkDone, toI32} from "rakun";
import {convention.middleware, convention.matcher, middleware.Next, filter.Chain, filter.WebRequest} from "rakun-web";
import {middleware.registerMiddleware, middleware.gateByMatcher, middleware.skip} from "rakun-web";
import {filter.runChain, filter.headerValue, filter.rkChainSetTerminal, filter.chainOrdering} from "rakun-web";

#[middleware]
#[matcher("/dashboard/:path*")]
pub fn appMiddleware(req: WebRequest, chain: Chain) -> Response {
    val token = req.header("authorization");
    return if (token == "") Next.redirect("/login") else chain.next(req);
}

fn main() {
    val _s = rkChainSetTerminal({ method, path, headersWire, queryWire, body ->
        Response.ok("handled " + path);
    });
    @print(chainOrdering());
    val gated: Response = runChain("GET", "/dashboard/settings", "", "", "");
    @print(gated.status.toString());
    @print(headerValue("Location"));
    val authorized: Response = runChain("GET", "/dashboard/settings", "authorization\tBearer x", "", "");
    @print(authorized.status.toString());
    val outside: Response = runChain("GET", "/public", "", "", "");
    @print(outside.status.toString());
}
