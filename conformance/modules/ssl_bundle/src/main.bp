fn writeFile(p: string, body: string) -> i32 {
    return try fs.writeText(p, body) catch 0;
}

fn main() {
    val _w1 = writeFile("server.pem", certPem());
    val _w2 = writeFile("server.key", keyPem());
    val _w3 = writeFile("ca.pem", certPem());
    val _n = rkSetProp("rakun.ssl.bundle.pem", "mybundle,internal-ca");
    val _c = rkSetProp("rakun.ssl.bundle.pem.mybundle.keystore.certificate", "server.pem");
    val _k = rkSetProp("rakun.ssl.bundle.pem.mybundle.keystore.private-key", "server.key");
    val _t = rkSetProp("rakun.ssl.bundle.pem.mybundle.truststore.certificate", "ca.pem");
    val _a = rkSetProp("rakun.ssl.bundle.pem.mybundle.client-auth", "need");

    val names: string[] = sslBundleNames();
    @print(names.join(","));

    val b = sslBundle("mybundle");
    if (b) { bundle ->
        @print("presenting " + bundle.certificateFile + " with client-auth " + bundle.clientAuth);
    };

    // `sslBundle("absent")` is the empty optional, NOT a bundle with empty fields:
    // "no TLS configured" and "TLS misconfigured" must not have the same shape.
    var seen = false;
    val absent = sslBundle("absent");
    if (absent) { bundle -> seen = true; };
    @print(seen.toString());

    // Rotation without a restart.
    @print(sslReload("mybundle").toString());   // true when the new material resolved
    @print(sslPoll().toString());               // reloads every bundle with reload-on-update whose files moved
    @print("[" + sslLastError("mybundle") + "]");
    @print(sslSubject("mybundle"));
}
