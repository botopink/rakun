import {autoConfiguration, conditionalOnModule, conditionalOnProperty} from "rakun";
import {conditionalOnMissingBean, autoConfigureAfter, profile} from "rakun";
import {bean, value, service} from "rakun";
import {rkScan, rkSingleton, rkEnter, rkDone, rkProp, rkPropInt} from "rakun";
import {rkAutoRegister, rkAutoProvides, rkAutoGate, rkRegisterBean, rkResolve} from "rakun";
import {autoConfigure, isAutoConfigured, autoConfigurationReport, rkAddBean, rkInstallBeans, rkSetProp} from "rakun";
import {collections.Dict} from "std";

pub type MailSender(host: string, port: i32)

pub type DemoClock(zone: string)

#[autoConfiguration]
pub type RakunCoreAutoConfiguration() {
    #[bean]
    pub fn demoClock(self: Self) -> DemoClock {
        return DemoClock(zone: "UTC");
    }
}

#[autoConfiguration]
#[conditionalOnModule("rakun-mail")]
#[conditionalOnProperty("rakun.mail.host", "*")]
#[autoConfigureAfter("RakunCoreAutoConfiguration")]
pub type RakunMailAutoConfiguration(
    #[value("rakun.mail.host")] host: string,
    #[value("rakun.mail.port")] port: i32,
) {
    #[bean]
    #[conditionalOnMissingBean("MailSender")]
    pub fn mailSender(self: Self) -> MailSender {
        return MailSender(host: self.host, port: self.port);
    }
}

fn beans() -> Dict<string, unknown> {
    return comptime {
        var d: Dict<string, unknown> = Dict.empty();
        for (@TypeInfo.all(with: [service, autoConfiguration], member: "make")) { b ->
            d = rkAddBean(d, b.name, b.value);
        }
        break d;
    };
}

fn main() {
    val _beans = rkInstallBeans(beans());
    // The application runs the pass itself, once, before `Rakun.run`.
    val _ = autoConfigure();
    @print(isAutoConfigured("RakunMailAutoConfiguration").toString());
    @print(autoConfigurationReport());
}
