import {RequestPhase, RequestScope, beginRequest, endRequest, cookies, cookieOf, cookieDefaults, Cookies, CookieAttrs} from "rakun";

fn main() {
    val _e = beginRequest(RequestScope(
        id: "req-1",
        phase: RequestPhase.Handler,
        method: "GET",
        path: "/",
        query: "",
        headersWire: "cookie\tsession=abc; theme=dark",
        strict: false,
    ));
    val theme = cookieOf(cookies(), "theme", "light");
    @print(theme);
    @print(cookieOf(cookies(), "absent", "light"));

    val jar: Cookies = cookies();
    val _ = jar.set("theme", "dark", cookieDefaults());
    val queued = endRequest();
    // `cookieDefaults()` carries `Max-Age=0`: pass your own `maxAge`.
    @print(queued);
}
