import {provides, qualifier, primary, managed, Context, rootContext, rkRegisterBean, rkInstallBeans, rkAddBean, rkResolve, rkResolveNamed, rkSingleton, rkEnter, rkDone, rkScan} from "rakun";
import {collections.Dict} from "std";

pub type Clock(zone: string) {
    pub fn stamp(self: Self) -> string {
        return "<now@" + self.zone + ">";
    }
}

#[provides]
#[qualifier("system")]
#[primary]
pub fn systemClock() -> Clock {
    return Clock(zone: "UTC");
}

#[provides]
#[qualifier("fixed")]
pub fn fixedClock() -> Clock {
    return Clock(zone: "fixed");
}

fn main() {
    val _beans = rkInstallBeans(Dict.empty());
    val ctx: Context = rootContext();
    // `Clock` is injectable by type; the unqualified lookup gets the #[primary] one.
    val any: ?Clock = ctx.resolve("Clock");
    val fixed: ?Clock = ctx.resolveNamed("Clock", "fixed");
    if (any != null) @print(any.stamp());
    if (fixed != null) @print(fixed.stamp());
}
