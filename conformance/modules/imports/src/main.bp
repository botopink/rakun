import {service, configuration, bean, managed, imports, Context, rootContext, rkAddBean, rkInstallBeans} from "rakun";
import {rkScan, rkSingleton, rkEnter, rkDone, rkResolve, rkRegisterBean} from "rakun";
import {collections.Dict} from "std";

pub type Wallet(owner: string)

// A stereotyped type no `#[managed]` registers: it has a factory, no bean.
#[service]
pub type Vault() {
    pub fn kind(self: Self) -> string {
        return "vault";
    }
}

#[configuration]
#[managed]
#[imports("Vault")]
pub type WalletConfig() {
    #[bean]
    pub fn wallet(self: Self) -> Wallet {
        return Wallet(owner: "treasury");
    }
}

fn beans() -> Dict<string, unknown> {
    return comptime {
        var d: Dict<string, unknown> = Dict.empty();
        for (@TypeInfo.all(with: [configuration, service], member: "make")) { b ->
            d = rkAddBean(d, b.name, b.value);
        }
        d
    };
}

fn main() {
    val _beans = rkInstallBeans(beans());
    val ctx: Context = rootContext();
    @print(ctx.has("Wallet").toString());
    @print(ctx.has("Vault").toString());
    val w: ?Wallet = ctx.resolve("Wallet");
    if (w != null) @print(w.owner);
    val v: ?Vault = ctx.resolve("Vault");
    if (v != null) @print(v.kind());
}
