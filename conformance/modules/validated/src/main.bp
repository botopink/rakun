import {decorators.validated, decorators.notBlank, decorators.sizeBetween, decorators.email, decorators.minValue, decorators.maxValue, decorators.pattern} from "validation";
import {derived} from "validation";
import {json.Json, io.clock, collections.Dict, collections.Set} from "std";
import {report.ValidationReport, report.Violation} from "validation";
import {table.constraintTableJson} from "validation";
import {constraints.vNotBlank, constraints.vSizeBetween, constraints.vEmail, constraints.vMinValueI32, constraints.vMaxValueI32, constraints.vPattern} from "validation";
import {Response} from "rakun";

#[validated]
pub type CreateUserRequest(
    #[notBlank]
    #[sizeBetween(2, 50)]
    name: string,

    #[notBlank]
    #[email]
    email: string,

    #[minValue(18)]
    #[maxValue(120)]
    age: i32,
)

fn handle(v: CreateUserRequest) -> Response {
    val report = v.validate();
    if (report.isValid() == false) return Response.withStatus(400, report.toProblemDetail());
    return Response.created("ok");
}

fn main() {
    // Every constraint on a field runs: a three-field form reports three errors.
    val bad = CreateUserRequest(name: "", email: "nope", age: 7).validate();
    @print(bad.isValid().toString());
    @print(bad.violations.map({ v -> v.field + ":" + v.code }).join(","));
    @print(CreateUserRequest.constraints());
    @print(handle(CreateUserRequest(name: "Ana", email: "ana@example.com", age: 30)).status.toString());
    @print(handle(CreateUserRequest(name: "", email: "nope", age: 7)).status.toString());
}
