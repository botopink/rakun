import {Response} from "rakun";
import {filter.withHeader, filter.withHeaders, filter.headerValue, filter.headerLines, filter.headerCount} from "rakun-service";
import {io.terminal.print} from "std";

fn main() {
    val res = withHeader(Response.ok("{}"), "Content-Type", "application/json");
    val two = withHeaders(res, [#("X-A", "1"), #("X-B", "2")]);
    print(two.status.toString());
    print(headerValue("content-type"));
    print(headerValue("X-B"));
    print(headerCount().toString());
    // replaces by name, case-insensitively
    val again = withHeader(two, "CONTENT-TYPE", "text/plain");
    print(headerValue("Content-Type"));
    print(headerCount().toString());
    // `Vary` is unioned rather than replaced
    val v1 = withHeader(again, "Vary", "Origin");
    val v2 = withHeader(v1, "Vary", "Accept");
    print(headerValue("Vary"));
}
