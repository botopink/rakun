import {convention.filter, convention.order, filter.Chain, filter.WebRequest} from "rakun-service";
import {Response, rkScan, rkSingleton, rkEnter, rkDone, rkProp, rkPropInt, toI32} from "rakun";
import {filter.registerFilter, filter.runChain, filter.chainOrdering, filter.rkChainSetTerminal, filter.rkTrace, filter.rkTraceLog} from "rakun-service";
import {io.terminal.print} from "std";

#[filter]
#[order("-10")]
pub type TimingFilter() {
    pub fn handle(self: Self, req: WebRequest, chain: Chain) -> Response {
        val _in = rkTrace("timing>");
        val res: Response = chain.next(req);
        val _out = rkTrace("<timing");
        return res;
    }
}

// A filter that does not call `chain.next(req)` short-circuits.
#[filter]
pub type GateFilter() {
    pub fn handle(self: Self, req: WebRequest, chain: Chain) -> Response {
        if (req.path == "/secret") return Response.withStatus(401, "");
        return chain.next(req);
    }
}

fn main() -> void {
    val _s = rkChainSetTerminal({ method, path, headersWire, queryWire, body ->
        val _h = rkTrace("handler:" + path);
        Response.ok("handled " + path)
    });
    print(chainOrdering());
    val ok: Response = runChain("GET", "/public", "", "", "");
    print(ok.status.toString());
    print(rkTraceLog());
    val denied: Response = runChain("GET", "/secret", "", "", "");
    print(denied.status.toString());
}
