import {Response, rkScan, rkSingleton, rkEnter, rkDone} from "rakun";
import {convention.controllerAdvice, convention.exceptionHandler, error.ProblemDetail, error.raiseProblem, error.renderProblem, error.adviceTags, error.registerAdvice} from "rakun-service";

#[controllerAdvice]
pub type OrderAdvice() {
    #[exceptionHandler("order.not-found")]
    pub fn notFound(self: Self, detail: string) -> ProblemDetail {
        return ProblemDetail(
            typeUri: "https://example.com/problems/not-found",
            title: "Order not found",
            status: 404,
            detail: detail,
            instance: "/api/orders",
        );
    }
}

fn main() {
    @print(adviceTags().join(","));
    // `raiseProblem` is what a handler calls; the chain turns it into the
    // response `renderProblem` builds.
    val found: Response = renderProblem("order.not-found", "no order 42", "/api/orders/42");
    @print(found.status.toString());
    @print(found.body);
}
