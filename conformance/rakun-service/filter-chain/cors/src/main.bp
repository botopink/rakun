import {Response, provides, route, restController, rkScan, rkSingleton, rkEnter, rkDone, rkRegisterRoute, rkResolve, rkRegisterBean} from "rakun";
import {cors.CorsPolicy, cors.corsPolicy, cors.allowsOrigin, cors.allowsMethod, cors.policyFor, cors.mappingFor, cors.registerCorsMapping} from "rakun-service";
import {convention.crossOrigin} from "rakun-service";
import {io.terminal.print} from "std";

// The deployment-wide policy. (The reference's fence named this function
// `corsPolicy` too, which shadows the constructor it calls.)
#[provides]
pub fn applicationCors() -> CorsPolicy {
    return corsPolicy(["https://example.com"], ["GET", "POST"], [], [], false, 600);
}

// or, per controller:
#[crossOrigin("https://example.com", "GET,POST")]
#[route("/api")]
#[restController]
pub type ApiController()

fn main() {
    val global = applicationCors();
    print(allowsOrigin(global, "https://example.com").toString());
    print(allowsOrigin(global, "https://evil.test").toString());
    print(allowsMethod(global, "DELETE").toString());
    print(mappingFor("/api/orders"));
    print(policyFor("/api/orders").allowedOrigins.join(","));
    print(policyFor("/other").allowedOrigins.length.toString());
}
