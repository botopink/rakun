import {RequestData, enterRequest, leaveRequest, request, cookies, headers, pairValue} from "rakun-bpp";

pub fn main() -> @Task<void> {
    enterRequest(RequestData(
        method: "GET",
        path: "/blog/hi",
        params: [#("slug", "hi")],
        query: [#("sort", "new")],
        headers: [#("accept", "text/html")],
        cookies: [#("session", "abc")],
    ));
    val r = await request();
    @println(r.method + " " + r.path);
    @println(pairValue(r.params, "slug"));
    @println(pairValue(cookies(), "session"));
    @println(pairValue(headers(), "accept"));
    leaveRequest();
}
