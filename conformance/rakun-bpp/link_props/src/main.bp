import {text, renderToString} from "rakun-bpp";
import {Link, linkProps, withPrefetch} from "rakun-bpp";

pub fn main() {
    val slug = "hi";
    val title = "Hi";
    @println(renderToString(Link(linkProps("/about"), [text("About", attrs: [])])));
    @println(renderToString(Link(withPrefetch(linkProps("/blog/"
        + slug), false), [text(title, attrs: [])])));
}
