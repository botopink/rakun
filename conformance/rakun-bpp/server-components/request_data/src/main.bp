import {RequestData, enterRequest, leaveRequest, request, cookies, headers, pairValue} from "rakun-bpp";
import {io.terminal.print} from "std";

pub async fn main() -> Async<void> {
    enterRequest(RequestData(
        method: "GET",
        path: "/blog/hi",
        params: [#("slug", "hi")],
        query: [#("sort", "new")],
        headers: [#("accept", "text/html")],
        cookies: [#("session", "abc")],
    ));
    val r = await request();
    print(r.method + " " + r.path);
    print(pairValue(r.params, "slug"));
    print(pairValue(cookies(), "session"));
    print(pairValue(headers(), "accept"));
    leaveRequest();
}
