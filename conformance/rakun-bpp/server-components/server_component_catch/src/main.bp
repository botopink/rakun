import {Element, h1, text, renderServerComponent, pairValue} from "rakun-bpp";
import {io.terminal.print} from "std";

pub type Post(id: string, title: string)

fn loadPost(slug: string) -> Task<Result<Post, string>> {
    if (slug == "hi") return Post(id: "1", title: "Hello");
    throw "no such post";
}

pub fn PostPage(params: Array<#(string, string)>) -> Task<Element> {
    val post = try await loadPost(pairValue(params, "slug")) catch Post(id: "", title: "not found");
    return h1([text(post.title, attrs: [])], attrs: []);
}

pub fn main() -> Task<void> {
    print(await renderServerComponent({ -> PostPage([#("slug", "hi")]) }));
    print(await renderServerComponent({ -> PostPage([#("slug", "nope")]) }));
}
