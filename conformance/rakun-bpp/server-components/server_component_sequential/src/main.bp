import {Element, article, h1, ul, li, text, renderServerComponent, pairValue} from "rakun-bpp";
import {io.terminal.print} from "std";

pub type Post(id: string, title: string)

async fn loadPost(slug: string) -> Async<Post> {
    return Post(id: "7", title: slug);
}

async fn loadComments(postId: string) -> Async<array<string>> {
    return ["first", "second"];
}

fn commentRow(c: string) -> Element {
    return li([text(c, attrs: [])], attrs: []);
}

pub async fn PostPage(params: array<#(string, string)>) -> Async<Element> {
    val post = await loadPost(pairValue(params, "slug"));
    val comments = await loadComments(post.id);
    return article([
        h1([text(post.title, attrs: [])], attrs: []),
        ul(comments.map({ c -> commentRow(c); }), attrs: []),
    ], attrs: []);
}

pub async fn main() -> Async<void> {
    print(await renderServerComponent({ -> PostPage([#("slug", "hi")]) }));
}
