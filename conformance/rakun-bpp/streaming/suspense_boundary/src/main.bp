import {Element, p, text, renderToString, Boundary, Suspense, holeId, resolve, fillHtml} from "rakun-bpp";
import {io.terminal.print} from "std";

fn Slow() -> Component<Element> {
    return p([text("loaded", attrs: [])], attrs: []);
}

pub fn main() -> Task<void> {
    val b = Boundary(id: holeId(1), fallback: text("loading", attrs: []), child: { -> Slow() });
    print(renderToString(Suspense(b)));
    print(holeId(1));
    print(fillHtml(await resolve(b), ""));
}
