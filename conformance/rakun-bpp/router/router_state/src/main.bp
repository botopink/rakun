import {RouterState, fill, snapshot, pairValue} from "rakun-bpp";
import {io.terminal.print} from "std";

pub fn main() {
    fill("/blog/hi", "slug=hi", "sort=new", "/blog/[slug]", 1);
    val s = snapshot();
    print(s.path);
    print(s.pattern);
    print(s.selected.toString());
    print(pairValue(s.params, "slug"));
    print(pairValue(s.search, "sort"));
    print(pairValue(s.params, "missing"));
}
