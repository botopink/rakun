import {text, renderToString} from "rakun-bpp";
import {Link, linkProps, withPrefetch} from "rakun-bpp";
import {io.terminal.print} from "std";

pub fn main() -> void {
    val slug = "hi";
    val title = "Hi";
    print(renderToString(Link(linkProps("/about"), [text("About", attrs: [])])));
    print(renderToString(Link(withPrefetch(linkProps("/blog/"
        + slug), false), [text(title, attrs: [])])));
}
