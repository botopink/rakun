import {Element, State, div, p, text, state, renderToString} from "rakun-bpp";
import {io.terminal.print} from "std";

component fn counter(start: i32) -> Component<State<i32>> {
    val s = use state(start);
    return s;
}

component fn Widget() -> Component<Element> {
    val c = use counter(5); // `use` + the noun; never `use useCounter()`
    return p([text(c.value.toString(), [])], []);
}

pub async fn main() -> Async<void> {
    print(renderToString(await Widget()));
}
