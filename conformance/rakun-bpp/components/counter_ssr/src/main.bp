import {Element, ElementBase, div, p, text, state, renderToString} from "rakun-bpp";
import {io.terminal.print} from "std";

component fn Counter() -> Component<Element> {
    val c = use state(0);
    return div([
        p([text("count: " + c.value.toString(), [])], []),
    ], []);
}

async fn main() -> Async<void> {
    print(renderToString(await Counter())); // SSR — a pure string
}
