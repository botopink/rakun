import {Island, clientProps} from "rakun-bpp";
import {io.terminal.print} from "std";

#[clientProps]
pub type LikeProps(postId: string, likes: i32)

pub fn main() {
    val props = LikeProps(postId: "p1", likes: 3);
    val island = Island(id: "i1", component: "LikeButton", props: [#("postId", props.postId), #("likes", props.likes.toString())]);
    print(island.component);
    print(island.props.length.toString());
}
