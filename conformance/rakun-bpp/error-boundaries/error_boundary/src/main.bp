import {Element, div, p, text, renderToString, ErrorInfo, catchError, renderBoundary, infoFor, serverInfoFor} from "rakun-bpp";

fn fine() -> @Result<Element, string> {
    return p([text("fine", attrs: [])], attrs: []);
}

fn broken() -> @Result<Element, string> {
    throw "db down";
}

fn fallback(info: ErrorInfo) -> Element {
    return div([text("something went wrong", attrs: [])], attrs: []);
}

pub fn main() {
    @println(renderToString(renderBoundary(catchError("b1", fallback, { -> fine() }))));
    @println(renderToString(renderBoundary(catchError("b2", fallback, { -> broken() }))));
    @println(infoFor("db down").message == "");
    @println(serverInfoFor("db down").message);
    @println(infoFor("db down").digest == serverInfoFor("db down").digest);
}
