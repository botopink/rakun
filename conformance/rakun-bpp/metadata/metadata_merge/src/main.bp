import {emptyMetadata, mergeMetadata, renderHead, Metadata} from "rakun-bpp";
import {io.terminal.print} from "std";

pub fn main() {
    val base = emptyMetadata();
    val parent = Metadata(..base, titleTemplate: "%s | site", description: "the site");
    val child = Metadata(..base, title: "Post");
    print(renderHead(mergeMetadata(parent, child)));
}
