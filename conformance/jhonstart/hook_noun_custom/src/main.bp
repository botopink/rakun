import {Element, State, div, p, text, state, renderToString} from "jhonstart";

fn counter(start: i32) -> @Component<State<i32>> {
    val s = use state(start);
    return s;
}

fn Widget() -> @Component<Element> {
    val c = use counter(5); // `use` + the noun; never `use useCounter()`
    return p([text(c.value.toString(), [])], []);
}

pub fn main() -> @Task<void> {
    @print(renderToString(await Widget()));
}
