import {Element, p, text, renderToString, Boundary, Suspense, holeId, resolve, fillHtml} from "jhonstart";

fn Slow() -> @Component<Element> {
    return p([text("loaded", attrs: [])], attrs: []);
}

pub fn main() -> @Task<void> {
    val b = Boundary(id: holeId(1), fallback: text("loading", attrs: []), child: { -> Slow() });
    @println(renderToString(Suspense(b)));
    @println(holeId(1));
    @println(fillHtml(await resolve(b), ""));
}
