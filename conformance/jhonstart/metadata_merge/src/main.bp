import {emptyMetadata, mergeMetadata, renderHead, Metadata} from "jhonstart";

pub fn main() {
    val base = emptyMetadata();
    val parent = Metadata(..base, titleTemplate: "%s | site", description: "the site");
    val child = Metadata(..base, title: "Post");
    @println(renderHead(mergeMetadata(parent, child)));
}
