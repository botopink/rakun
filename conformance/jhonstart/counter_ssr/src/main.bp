import {Element, ElementBase, div, p, text, state, renderToString} from "jhonstart";

fn Counter() -> @Component<Element> {
    val c = use state(0);
    return div([
        p([text("count: " + c.value.toString(), [])], []),
    ], []);
}

fn main() -> @Task<void> {
    @print(renderToString(await Counter())); // SSR — a pure string
}
