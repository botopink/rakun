botopink-cell 1
out Gradient.To.T -> background-image:linear-gradient(to top, var(--tw-gradient-stops))
out Gradient.To.Tr -> background-image:linear-gradient(to top right, var(--tw-gradient-stops))
out Gradient.To.R -> background-image:linear-gradient(to right, var(--tw-gradient-stops))
out Gradient.To.Br -> background-image:linear-gradient(to bottom right, var(--tw-gradient-stops))
out Gradient.To.B -> background-image:linear-gradient(to bottom, var(--tw-gradient-stops))
out Gradient.To.Bl -> background-image:linear-gradient(to bottom left, var(--tw-gradient-stops))
out Gradient.To.L -> background-image:linear-gradient(to left, var(--tw-gradient-stops))
out Gradient.To.Tl -> background-image:linear-gradient(to top left, var(--tw-gradient-stops))
