botopink-cell 1
out y1
out <style>@layer theme, base, components, utilities;@layer utilities{:where(.e_d7b09a8f > :not(:last-child)){--tw-divide-y-reverse:0;border-top-width:calc(1px * var(--tw-divide-y-reverse));border-bottom-width:calc(1px * calc(1 - var(--tw-divide-y-reverse)))}}</style>
out x2
out <style>@layer theme, base, components, utilities;@layer utilities{:where(.e_b5c25543 > :not(:last-child)){--tw-divide-x-reverse:0;border-inline-start-width:calc(2px * var(--tw-divide-x-reverse));border-inline-end-width:calc(2px * calc(1 - var(--tw-divide-x-reverse)))}}</style>
out color
out <style>@layer theme, base, components, utilities;@layer utilities{:where(.e_c962e859 > :not(:last-child)){border-color:var(--color-slate-200)}}</style>
out style
out <style>@layer theme, base, components, utilities;@layer utilities{:where(.e_484e403c > :not(:last-child)){border-style:dashed}}</style>
out x-reverse
out <style>@layer theme, base, components, utilities;@layer utilities{:where(.e_2f0caa1d > :not(:last-child)){--tw-divide-x-reverse:1}}</style>
