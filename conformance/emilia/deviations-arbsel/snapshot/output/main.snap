botopink-cell 1
out has
out <style>@layer theme, base, components, utilities;@layer utilities{.e_511aaae:has(img){padding:calc(var(--spacing) * 4)}}</style>
out not
out <style>@layer theme, base, components, utilities;@layer utilities{.e_57d10af1:not(.on){padding:calc(var(--spacing) * 4)}}</style>
out aria
out <style>@layer theme, base, components, utilities;@layer utilities{.e_9cb220bd[aria-sort=ascending]{padding:calc(var(--spacing) * 4)}}</style>
out data
out <style>@layer theme, base, components, utilities;@layer utilities{.e_7538c085[data-active]{padding:calc(var(--spacing) * 4)}}</style>
out in
out <style>@layer theme, base, components, utilities;@layer utilities{:where(.card) .e_4abe3958{padding:calc(var(--spacing) * 4)}}</style>
