import {Token, styleRule, decodeSheet, declarationsOf, defaultTheme} from "emilia";

fn show(name: string, tokens: Token[]) {
    val sheet = decodeSheet(styleRule(tokens, defaultTheme())._1);
    @print(name + " -> " + declarationsOf(sheet).join(" | "));
}

pub fn main() {
    show("Flex.Row", [.Flex.Row]);
    show("Flex.RowReverse", [.Flex.RowReverse]);
    show("Flex.Col", [.Flex.Col]);
    show("Flex.ColReverse", [.Flex.ColReverse]);
    show("Flex.Wrap", [.Flex.Wrap]);
    show("Flex.WrapReverse", [.Flex.WrapReverse]);
    show("Flex.NoWrap", [.Flex.NoWrap]);
}
