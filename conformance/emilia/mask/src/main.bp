import {Token, styleRule, decodeSheet, declarationsOf, defaultTheme} from "emilia";

fn show(name: string, tokens: Token[]) {
    val sheet = decodeSheet(styleRule(tokens, defaultTheme())._1);
    @print(name + " -> " + declarationsOf(sheet).join(" | "));
}

pub fn main() {
    show("Mask.Clip.Padding", [.Mask.Clip.Padding]);
    show("Mask.Composite.Intersect", [.Mask.Composite.Intersect]);
    show("Mask.Image.None", [.Mask.Image.None]);
    show("Mask.Mode.Alpha", [.Mask.Mode.Alpha]);
    show("Mask.Origin.Border", [.Mask.Origin.Border]);
    show("Mask.Position.Center", [.Mask.Position.Center]);
    show("Mask.Repeat.NoRepeat", [.Mask.Repeat.NoRepeat]);
    show("Mask.Size.Cover", [.Mask.Size.Cover]);
    show("Mask.Type.Luminance", [.Mask.Type.Luminance]);
}
