import {Token, styleRule, decodeSheet, declarationsOf, defaultTheme} from "rakun-stylesheet";
import {io.terminal.print} from "std";

fn show(name: string, tokens: Token[]) -> void {
    val sheet = decodeSheet(styleRule(tokens, defaultTheme())._1);
    print(name + " -> " + declarationsOf(sheet).join(" | "));
}

pub fn main() -> void {
    show("Border.Rounded.None", [.Border.Rounded.None]);
    show("Border.Rounded.Sm", [.Border.Rounded.Sm]);
    show("Border.Rounded.Lg", [.Border.Rounded.Lg]);
    show("Border.Rounded.X2xl", [.Border.Rounded.X2xl]);
    show("Border.Rounded.Full", [.Border.Rounded.Full]);
    show("Border.Rounded.T.Lg", [.Border.Rounded.T.Lg]);
    show("Border.Rounded.Tl.Lg", [.Border.Rounded.Tl.Lg]);
    show("Border.Rounded.B.None", [.Border.Rounded.B.None]);
    show("Border.Rounded.Ss.Md", [.Border.Rounded.Ss.Md]);
}
