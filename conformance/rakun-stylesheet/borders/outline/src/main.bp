import {Token, styleRule, decodeSheet, declarationsOf, defaultTheme} from "rakun-stylesheet";
import {io.terminal.print} from "std";

fn show(name: string, tokens: Token[]) -> void {
    val sheet = decodeSheet(styleRule(tokens, defaultTheme())._1);
    print(name + " -> " + declarationsOf(sheet).join(" | "));
}

pub fn main() -> void {
    show("Outline.W.2", [.Outline.W.2]);
    show("Outline.Style.Solid", [.Outline.Style.Solid]);
    show("Outline.Style.Dashed", [.Outline.Style.Dashed]);
    show("Outline.Color.Blue.500", [.Outline.Color.Blue.500]);
    show("Outline.Offset.2", [.Outline.Offset.2]);
    show("Outline.Offset.Neg.1", [.Outline.Offset.Neg.1]);
    show("Outline.Style.None", [.Outline.Style.None]);
}
