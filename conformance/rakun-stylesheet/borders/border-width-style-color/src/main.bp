import {Token, styleRule, decodeSheet, declarationsOf, defaultTheme} from "rakun-stylesheet";
import {io.terminal.print} from "std";

fn show(name: string, tokens: Token[]) -> void {
    val sheet = decodeSheet(styleRule(tokens, defaultTheme())._1);
    print(name + " -> " + declarationsOf(sheet).join(" | "));
}

pub fn main() -> void {
    show("Border.W.1", [.Border.W.1]);
    show("Border.W.0", [.Border.W.0]);
    show("Border.W.8", [.Border.W.8]);
    show("Border.W.X.1", [.Border.W.X.1]);
    show("Border.W.Y.2", [.Border.W.Y.2]);
    show("Border.W.T.4", [.Border.W.T.4]);
    show("Border.W.S.1", [.Border.W.S.1]);
    show("Border.W.E.1", [.Border.W.E.1]);
    show("Border.Style.Solid", [.Border.Style.Solid]);
    show("Border.Style.Dashed", [.Border.Style.Dashed]);
    show("Border.Style.Hidden", [.Border.Style.Hidden]);
    show("Border.Style.None", [.Border.Style.None]);
    show("Border.Color.Slate.200", [.Border.Color.Slate.200]);
    show("Border.Color.White", [.Border.Color.White]);
    show("Border.Color.Transparent", [.Border.Color.Transparent]);
    show("Border.Color.Current", [.Border.Color.Current]);
}
