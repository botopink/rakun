import {Token, emilia.emilia, flushWith, defaultOptions, withTheme, emptyTheme} from "rakun-stylesheet";
import {io.terminal.print} from "std";

async fn doc(name: string, tokens: Token[]) -> Async<void> {
    emilia(tokens);
    print(name);
    print(await flushWith(withTheme(defaultOptions(), emptyTheme())));
}

pub async fn main() -> Async<void> {
    val a = emilia([.Bg.White]);
    val b = emilia([.Bg.White]);
    print(a == b); // same content-derived hash
    print(await flushWith(withTheme(defaultOptions(), emptyTheme()))); // exactly ONE rule
}
