import {Variant, declSheet, nestVariant, renderRule, defaultOptions} from "rakun-stylesheet";
import {io.terminal.print} from "std";

pub fn main() -> void {
    val hover = Variant(atRule: "", selector: "&:hover");
    val before = Variant(atRule: "", selector: "&::before");

    val a = nestVariant(nestVariant(declSheet("content:\"\""), before), hover); // &:hover::before
    val b = nestVariant(nestVariant(declSheet("content:\"\""), hover), before); // &::before:hover
    print(a.rules.map({ r -> r.selector }).join(""));
    print(b.rules.map({ r -> r.selector }).join(""));
    print(a.rules.map({ r -> renderRule("c", r, defaultOptions()) }).join(""));
    print(b.rules.map({ r -> renderRule("c", r, defaultOptions()) }).join(""));
}
