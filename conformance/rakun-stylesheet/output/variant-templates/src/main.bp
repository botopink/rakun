import {Variant, Sheet, declSheet, nestVariant, renderRule, defaultOptions} from "rakun-stylesheet";

fn show(name: string, v: Variant) {
    val sheet = nestVariant(declSheet("color:red"), v);
    @print(name
        + " -> "
        + sheet.rules
            .map({ r -> renderRule("c", r, defaultOptions()) })
            .join(""));
}

pub fn main() {
    show("hover", Variant(atRule: "@media (hover: hover)", selector: "&:hover"));
    show("trailing", Variant(atRule: "", selector: ".dark &")); // a trailing `&`
    show("md", Variant(atRule: "@media (width >= 48rem)", selector: "&"));
    show("group-hover", Variant(atRule: "", selector: "&:is(:where(.group):hover *)"));
}
