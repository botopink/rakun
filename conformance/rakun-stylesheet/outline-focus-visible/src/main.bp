import {Token, emilia, flushWith, defaultOptions, withTheme, emptyTheme} from "rakun-stylesheet";

fn doc(name: string, tokens: Token[]) -> @Task<void> {
    emilia(tokens);
    @print(name);
    @print(await flushWith(withTheme(defaultOptions(), emptyTheme())));
}

pub fn main() -> @Task<void> {
    val focus: Token[] = [.Outline.W.2, .Outline.Color.Indigo.500];
    val tokens: Token[] = [.Border.W.1, Token.FocusVisible(focus)];
    await doc("focus-ring", tokens);
}
