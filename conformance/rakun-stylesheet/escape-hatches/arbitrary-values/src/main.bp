import {Token, emilia.emilia, flushWith, defaultOptions, withTheme, emptyTheme, arbValue, arbProp, arbSel, arbAt, arbMin, arbMax, cssValue} from "rakun-stylesheet";
import {io.terminal.print} from "std";

async fn doc(name: string, tokens: Token[]) -> Async<void> {
    emilia(tokens);
    print(name);
    print(await flushWith(withTheme(defaultOptions(), emptyTheme())));
}

pub async fn main() -> Async<void> {
    await doc("brand", [arbValue("background-color", cssValue @`#316ff6`)]);
    await doc("gutter", [arbProp("--gutter-width", "1rem")]);
    val dragging: Token[] = [.Interact.Cursor.Grabbing];
    await doc("handle", [.Interact.Cursor.Grab, arbSel("&.is-dragging", dragging)]);
    val gridOnly: Token[] = [.Layout.Grid];
    await doc("layout", [arbAt("supports(display:grid)", gridOnly), arbMin("320px", gridOnly)]);
    await doc("max", [arbMax("640px", gridOnly)]);
}
