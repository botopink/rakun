import {Token, emilia, flushWith, defaultOptions, withTheme, emptyTheme, arbSel} from "rakun-stylesheet";

fn doc(name: string, tokens: Token[]) -> @Task<void> {
    emilia(tokens);
    @print(name);
    @print(await flushWith(withTheme(defaultOptions(), emptyTheme())));
}

pub fn main() -> @Task<void> {
    // has-[img]:p-4
    await doc("has", [arbSel("&:has(img)", [.Pad.All.4])]);
    // not-[.on]:p-4 · aria-[sort=ascending]:p-4 · data-[active]:p-4 · in-[.card]:p-4
    await doc("not", [arbSel("&:not(.on)", [.Pad.All.4])]);
    await doc("aria", [arbSel("&[aria-sort=ascending]", [.Pad.All.4])]);
    await doc("data", [arbSel("&[data-active]", [.Pad.All.4])]);
    await doc("in", [arbSel(":where(.card) &", [.Pad.All.4])]);
}
