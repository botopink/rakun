import {defaultTheme, extendTheme, paletteEntries, themeValue, flushWith, withTheme, defaultOptions} from "rakun-stylesheet";
import {io.terminal.print} from "std";

pub async fn main() -> Async<void> {
    val th = extendTheme(defaultTheme(), paletteEntries());
    val doc = await flushWith(withTheme(defaultOptions(), th));
    assert themeValue(th, "--color-red-500") == "oklch(63.7% 0.237 25.331)";
    print(themeValue(th, "--color-red-500"));
    print(paletteEntries().length);
    print(doc.contains("--color-red-500:oklch(63.7% 0.237 25.331)"));
}
