import {Theme, ThemeEntry, Ns, DarkMode, defaultTheme, emptyTheme, extendTheme, clearNamespace, namespace, themeValue, themeVar, nsPrefix, allNamespaces} from "rakun-stylesheet";
import {io.terminal.print} from "std";

pub fn main() {
    val th = defaultTheme();
    print(nsPrefix(Ns.Color));
    print(nsPrefix(Ns.Spacing));
    print(nsPrefix(Ns.Keyframes));
    print(allNamespaces().length);
    print(namespace(emptyTheme(), Ns.Color).length);
    print(themeValue(th, "--color-white"));
    print(themeValue(th, "--color-nope"));
    print(themeVar("--color-white"));
    val one: ThemeEntry[] = [ThemeEntry(name: "--color-white", value: "#fffffe")];
    print(themeValue(extendTheme(th, one), "--color-white"));
    print(namespace(clearNamespace(th, Ns.Color), Ns.Color).length);
}
