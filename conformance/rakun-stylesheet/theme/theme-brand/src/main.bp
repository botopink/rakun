import {Theme, ThemeEntry, Ns, defaultTheme, extendTheme, clearNamespace, namespace, themeValue} from "rakun-stylesheet";
import {io.terminal.print} from "std";

fn brandTheme() -> Theme {
    val stripped = clearNamespace(defaultTheme(), Ns.Color);
    val brand: ThemeEntry[] = [
        ThemeEntry(name: "--spacing", value: "4px"),
        ThemeEntry(name: "--color-lagoon", value: "oklch(0.72 0.11 221.19)"),
    ];
    return extendTheme(stripped, brand);
}

pub fn main() {
    val th = brandTheme();
    print(themeValue(defaultTheme(), "--spacing"));
    print(themeValue(th, "--spacing"));
    print(themeValue(th, "--color-lagoon"));
    print(themeValue(th, "--color-white"));
    print(namespace(th, Ns.Color).length);
}
