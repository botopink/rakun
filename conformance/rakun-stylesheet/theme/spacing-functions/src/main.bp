import {spacing.spacing, spacingHalf, spacingNegHalf} from "rakun-stylesheet";
import {io.terminal.print} from "std";

pub fn main() {
    assert spacing(0) == "0";
    assert spacing(4) == "calc(var(--spacing) * 4)";
    assert spacing(-4) == "calc(var(--spacing) * -4)";
    assert spacingHalf(1) == "calc(var(--spacing) * 1.5)";
    assert spacingNegHalf(0) == "calc(var(--spacing) * -0.5)";
    print(spacing(0));
    print(spacing(4));
    print(spacing(-4));
    print(spacingHalf(1));
    print(spacingNegHalf(0));
}
