botopink-cell 1
out Grid.Cols.12 -> grid-template-columns:repeat(12, minmax(0, 1fr))
out Grid.Cols.None -> grid-template-columns:none
out Grid.Cols.Subgrid -> grid-template-columns:subgrid
out Grid.Rows.3 -> grid-template-rows:repeat(3, minmax(0, 1fr))
out Grid.Col.Auto -> grid-column:auto
out Grid.Col.Span.2 -> grid-column:span 2 / span 2
out Grid.Col.Span.Full -> grid-column:1 / -1
out Grid.Col.Start.13 -> grid-column-start:13
out Grid.Col.End.Auto -> grid-column-end:auto
out Grid.Row.Span.2 -> grid-row:span 2 / span 2
out Grid.Row.End.3 -> grid-row-end:3
out Grid.Flow.Col -> grid-auto-flow:column
out Grid.Flow.RowDense -> grid-auto-flow:row dense
out Grid.AutoCols.Min -> grid-auto-columns:min-content
out Grid.AutoRows.Fr -> grid-auto-rows:minmax(0, 1fr)
