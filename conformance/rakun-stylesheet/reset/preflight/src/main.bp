import {preflightRules, preflight.preflight, flushWith, withBase, defaultOptions} from "rakun-stylesheet";

pub fn main() -> @Task<void> {
    val html = await flushWith(withBase(defaultOptions(), preflightRules())); // @layer base{…}
    val css = preflight(); // a static reset.css fragment
    @print(html);
    @print(css);
}
