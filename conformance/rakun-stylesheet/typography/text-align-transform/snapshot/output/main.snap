botopink-cell 1
out Text.Left -> text-align:left
out Text.Center -> text-align:center
out Text.Right -> text-align:right
out Text.Justify -> text-align:justify
out Text.Start -> text-align:start
out Text.End -> text-align:end
out Text.Transform.Uppercase -> text-transform:uppercase
out Text.Transform.None -> text-transform:none
out Text.Truncate -> overflow:hidden;text-overflow:ellipsis;white-space:nowrap
out Text.Overflow.Ellipsis -> text-overflow:ellipsis
out Text.Wrap.Balance -> text-wrap:balance
out Text.Clamp.3 -> overflow:hidden;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3
out Text.Clamp.None -> overflow:visible;display:block;-webkit-box-orient:horizontal;-webkit-line-clamp:none
