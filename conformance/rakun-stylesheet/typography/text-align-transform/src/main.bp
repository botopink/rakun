import {Token, styleRule, decodeSheet, declarationsOf, defaultTheme} from "rakun-stylesheet";

fn show(name: string, tokens: Token[]) {
    val sheet = decodeSheet(styleRule(tokens, defaultTheme())._1);
    @print(name + " -> " + declarationsOf(sheet).join(" | "));
}

pub fn main() {
    show("Text.Left", [.Text.Left]);
    show("Text.Center", [.Text.Center]);
    show("Text.Right", [.Text.Right]);
    show("Text.Justify", [.Text.Justify]);
    show("Text.Start", [.Text.Start]);
    show("Text.End", [.Text.End]);
    show("Text.Transform.Uppercase", [.Text.Transform.Uppercase]);
    show("Text.Transform.None", [.Text.Transform.None]);
    show("Text.Truncate", [.Text.Truncate]);
    show("Text.Overflow.Ellipsis", [.Text.Overflow.Ellipsis]);
    show("Text.Wrap.Balance", [.Text.Wrap.Balance]);
    show("Text.Clamp.3", [.Text.Clamp.3]);
    show("Text.Clamp.None", [.Text.Clamp.None]);
}
