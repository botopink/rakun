import {Token, styleRule, decodeSheet, declarationsOf, defaultTheme} from "rakun-stylesheet";
import {io.terminal.print} from "std";

fn show(name: string, tokens: Token[]) -> void {
    val sheet = decodeSheet(styleRule(tokens, defaultTheme())._1);
    print(name + " -> " + declarationsOf(sheet).join(" | "));
}

pub fn main() -> void {
    show("Text.Whitespace.Pre", [.Text.Whitespace.Pre]);
    show("Text.Break.Normal", [.Text.Break.Normal]);
    show("Text.Break.All", [.Text.Break.All]);
    show("Text.OverflowWrap.Anywhere", [.Text.OverflowWrap.Anywhere]);
    show("Text.Hyphens.Auto", [.Text.Hyphens.Auto]);
    show("Text.Indent.8", [.Text.Indent.8]);
    show("Text.Align.Super", [.Text.Align.Super]);
    show("Text.Tab.4", [.Text.Tab.4]);
    show("Text.Content.None", [.Text.Content.None]);
    show("Text.Content.Empty", [.Text.Content.Empty]);
}
