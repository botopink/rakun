botopink-cell 1
out Text.Whitespace.Pre -> white-space:pre
out Text.Break.Normal -> overflow-wrap:normal;word-break:normal
out Text.Break.All -> word-break:break-all
out Text.OverflowWrap.Anywhere -> overflow-wrap:anywhere
out Text.Hyphens.Auto -> hyphens:auto
out Text.Indent.8 -> text-indent:calc(var(--spacing) * 8)
out Text.Align.Super -> vertical-align:super
out Text.Tab.4 -> tab-size:4
out Text.Content.None -> content:none
out Text.Content.Empty -> content:""
