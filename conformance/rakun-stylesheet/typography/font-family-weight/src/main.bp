import {Token, styleRule, decodeSheet, declarationsOf, defaultTheme} from "rakun-stylesheet";
import {io.terminal.print} from "std";

fn show(name: string, tokens: Token[]) {
    val sheet = decodeSheet(styleRule(tokens, defaultTheme())._1);
    print(name + " -> " + declarationsOf(sheet).join(" | "));
}

pub fn main() {
    show("Font.Sans", [.Font.Sans]);
    show("Font.Serif", [.Font.Serif]);
    show("Font.Mono", [.Font.Mono]);
    show("Font.Weight.Thin", [.Font.Weight.Thin]);
    show("Font.Weight.Normal", [.Font.Weight.Normal]);
    show("Font.Weight.Semibold", [.Font.Weight.Semibold]);
    show("Font.Weight.Black", [.Font.Weight.Black]);
}
