import {Token, styleRule, decodeSheet, declarationsOf, defaultTheme} from "rakun-stylesheet";
import {io.terminal.print} from "std";

fn show(name: string, tokens: Token[]) {
    val sheet = decodeSheet(styleRule(tokens, defaultTheme())._1);
    print(name + " -> " + declarationsOf(sheet).join(" | "));
}

pub fn main() {
    show("List.None", [.List.None]);
    show("List.Disc", [.List.Disc]);
    show("List.Decimal", [.List.Decimal]);
    show("List.Inside", [.List.Inside]);
    show("List.Outside", [.List.Outside]);
    show("List.ImageNone", [.List.ImageNone]);
}
