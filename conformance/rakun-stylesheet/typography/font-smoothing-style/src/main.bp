import {Token, styleRule, decodeSheet, declarationsOf, defaultTheme} from "rakun-stylesheet";
import {io.terminal.print} from "std";

fn show(name: string, tokens: Token[]) -> void {
    val sheet = decodeSheet(styleRule(tokens, defaultTheme())._1);
    print(name + " -> " + declarationsOf(sheet).join(" | "));
}

pub fn main() -> void {
    show("Font.Smoothing.Antialiased", [.Font.Smoothing.Antialiased]);
    show("Font.Smoothing.Subpixel", [.Font.Smoothing.Subpixel]);
    show("Font.Style.Italic", [.Font.Style.Italic]);
    show("Font.Style.Normal", [.Font.Style.Normal]);
    show("Font.Stretch.SemiCondensed", [.Font.Stretch.SemiCondensed]);
    show("Font.Nums.Tabular", [.Font.Nums.Tabular]);
    show("Font.Nums.SlashedZero", [.Font.Nums.SlashedZero]);
}
