botopink-cell 1
out Font.Smoothing.Antialiased -> -webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale
out Font.Smoothing.Subpixel -> -webkit-font-smoothing:auto;-moz-osx-font-smoothing:auto
out Font.Style.Italic -> font-style:italic
out Font.Style.Normal -> font-style:normal
out Font.Stretch.SemiCondensed -> font-stretch:semi-condensed
out Font.Nums.Tabular -> font-variant-numeric:tabular-nums
out Font.Nums.SlashedZero -> font-variant-numeric:slashed-zero
