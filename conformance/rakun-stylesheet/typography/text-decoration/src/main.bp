import {Token, styleRule, decodeSheet, declarationsOf, defaultTheme} from "rakun-stylesheet";
import {io.terminal.print} from "std";

fn show(name: string, tokens: Token[]) -> void {
    val sheet = decodeSheet(styleRule(tokens, defaultTheme())._1);
    print(name + " -> " + declarationsOf(sheet).join(" | "));
}

pub fn main() -> void {
    show("Text.Underline", [.Text.Underline]);
    show("Text.Overline", [.Text.Overline]);
    show("Text.LineThrough", [.Text.LineThrough]);
    show("Text.NoUnderline", [.Text.NoUnderline]);
    show("Text.Decoration.Style.Wavy", [.Text.Decoration.Style.Wavy]);
    show("Text.Decoration.Thickness.2", [.Text.Decoration.Thickness.2]);
    show("Text.Decoration.Thickness.FromFont", [.Text.Decoration.Thickness.FromFont]);
    show("Text.Decoration.Offset.4", [.Text.Decoration.Offset.4]);
    show("Text.Decoration.Color.Sky.500", [.Text.Decoration.Color.Sky.500]);
}
