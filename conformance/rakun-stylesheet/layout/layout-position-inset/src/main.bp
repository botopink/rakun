import {Token, styleRule, decodeSheet, declarationsOf, defaultTheme} from "rakun-stylesheet";
import {io.terminal.print} from "std";

fn show(name: string, tokens: Token[]) {
    val sheet = decodeSheet(styleRule(tokens, defaultTheme())._1);
    print(name + " -> " + declarationsOf(sheet).join(" | "));
}

pub fn main() {
    show("Layout.Position.Absolute", [.Layout.Position.Absolute]);
    show("Layout.Position.Sticky", [.Layout.Position.Sticky]);
    show("Layout.Inset.All.0", [.Layout.Inset.All.0]);
    show("Layout.Inset.X.0", [.Layout.Inset.X.0]);
    show("Layout.Inset.Y.0", [.Layout.Inset.Y.0]);
    show("Layout.Inset.T.4", [.Layout.Inset.T.4]);
    show("Layout.Inset.T.Neg.4", [.Layout.Inset.T.Neg.4]);
    show("Layout.Inset.T.Half.0", [.Layout.Inset.T.Half.0]);
    show("Layout.Inset.T.Frac.Half", [.Layout.Inset.T.Frac.Half]);
    show("Layout.Inset.T.Full", [.Layout.Inset.T.Full]);
    show("Layout.Inset.T.Auto", [.Layout.Inset.T.Auto]);
    show("Layout.Inset.S.0", [.Layout.Inset.S.0]);
    show("Layout.Inset.E.0", [.Layout.Inset.E.0]);
}
