import {Token, styleRule, decodeSheet, declarationsOf, defaultTheme} from "rakun-stylesheet";
import {io.terminal.print} from "std";

fn show(name: string, tokens: Token[]) {
    val sheet = decodeSheet(styleRule(tokens, defaultTheme())._1);
    print(name + " -> " + declarationsOf(sheet).join(" | "));
}

pub fn main() {
    show("Grid.Cols.12", [.Grid.Cols.12]);
    show("Grid.Cols.None", [.Grid.Cols.None]);
    show("Grid.Cols.Subgrid", [.Grid.Cols.Subgrid]);
    show("Grid.Rows.3", [.Grid.Rows.3]);
    show("Grid.Col.Auto", [.Grid.Col.Auto]);
    show("Grid.Col.Span.2", [.Grid.Col.Span.2]);
    show("Grid.Col.Span.Full", [.Grid.Col.Span.Full]);
    show("Grid.Col.Start.13", [.Grid.Col.Start.13]);
    show("Grid.Col.End.Auto", [.Grid.Col.End.Auto]);
    show("Grid.Row.Span.2", [.Grid.Row.Span.2]);
    show("Grid.Row.End.3", [.Grid.Row.End.3]);
    show("Grid.Flow.Col", [.Grid.Flow.Col]);
    show("Grid.Flow.RowDense", [.Grid.Flow.RowDense]);
    show("Grid.AutoCols.Min", [.Grid.AutoCols.Min]);
    show("Grid.AutoRows.Fr", [.Grid.AutoRows.Fr]);
}
