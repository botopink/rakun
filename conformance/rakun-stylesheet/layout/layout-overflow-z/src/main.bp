import {Token, styleRule, decodeSheet, declarationsOf, defaultTheme} from "rakun-stylesheet";

fn show(name: string, tokens: Token[]) {
    val sheet = decodeSheet(styleRule(tokens, defaultTheme())._1);
    @print(name + " -> " + declarationsOf(sheet).join(" | "));
}

pub fn main() {
    show("Layout.Overflow.Hidden", [.Layout.Overflow.Hidden]);
    show("Layout.Overflow.Y.Auto", [.Layout.Overflow.Y.Auto]);
    show("Layout.Overscroll.Contain", [.Layout.Overscroll.Contain]);
    show("Layout.Overscroll.X.None", [.Layout.Overscroll.X.None]);
    show("Layout.Visibility.Invisible", [.Layout.Visibility.Invisible]);
    show("Layout.Visibility.Collapse", [.Layout.Visibility.Collapse]);
    show("Layout.Z.50", [.Layout.Z.50]);
    show("Layout.Z.Auto", [.Layout.Z.Auto]);
    show("Layout.Isolation.Isolate", [.Layout.Isolation.Isolate]);
}
