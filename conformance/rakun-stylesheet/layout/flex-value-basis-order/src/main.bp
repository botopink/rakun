import {Token, styleRule, decodeSheet, declarationsOf, defaultTheme} from "rakun-stylesheet";
import {io.terminal.print} from "std";

fn show(name: string, tokens: Token[]) {
    val sheet = decodeSheet(styleRule(tokens, defaultTheme())._1);
    print(name + " -> " + declarationsOf(sheet).join(" | "));
}

pub fn main() {
    show("Flex.Value.One", [.Flex.Value.One]);
    show("Flex.Value.Auto", [.Flex.Value.Auto]);
    show("Flex.Value.Initial", [.Flex.Value.Initial]);
    show("Flex.Value.None", [.Flex.Value.None]);
    show("Flex.Grow.1", [.Flex.Grow.1]);
    show("Flex.Grow.0", [.Flex.Grow.0]);
    show("Flex.Shrink.1", [.Flex.Shrink.1]);
    show("Flex.Shrink.0", [.Flex.Shrink.0]);
    show("Flex.Basis.0", [.Flex.Basis.0]);
    show("Flex.Basis.4", [.Flex.Basis.4]);
    show("Flex.Basis.Half.1", [.Flex.Basis.Half.1]);
    show("Flex.Basis.Px", [.Flex.Basis.Px]);
    show("Flex.Basis.Auto", [.Flex.Basis.Auto]);
    show("Flex.Basis.Full", [.Flex.Basis.Full]);
    show("Flex.Basis.Frac.Third", [.Flex.Basis.Frac.Third]);
    show("Flex.Order.1", [.Flex.Order.1]);
    show("Flex.Order.12", [.Flex.Order.12]);
    show("Flex.Order.First", [.Flex.Order.First]);
    show("Flex.Order.Last", [.Flex.Order.Last]);
    show("Flex.Order.None", [.Flex.Order.None]);
}
