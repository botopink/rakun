botopink-cell 1
out Flex.Value.One -> flex:1 1 0%
out Flex.Value.Auto -> flex:1 1 auto
out Flex.Value.Initial -> flex:0 1 auto
out Flex.Value.None -> flex:none
out Flex.Grow.1 -> flex-grow:1
out Flex.Grow.0 -> flex-grow:0
out Flex.Shrink.1 -> flex-shrink:1
out Flex.Shrink.0 -> flex-shrink:0
out Flex.Basis.0 -> flex-basis:0
out Flex.Basis.4 -> flex-basis:calc(var(--spacing) * 4)
out Flex.Basis.Half.1 -> flex-basis:calc(var(--spacing) * 1.5)
out Flex.Basis.Px -> flex-basis:1px
out Flex.Basis.Auto -> flex-basis:auto
out Flex.Basis.Full -> flex-basis:100%
out Flex.Basis.Frac.Third -> flex-basis:calc(1 / 3 * 100%)
out Flex.Order.1 -> order:1
out Flex.Order.12 -> order:12
out Flex.Order.First -> order:-9999
out Flex.Order.Last -> order:9999
out Flex.Order.None -> order:0
