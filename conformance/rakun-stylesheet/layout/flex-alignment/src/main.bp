import {Token, styleRule, decodeSheet, declarationsOf, defaultTheme} from "rakun-stylesheet";
import {io.terminal.print} from "std";

fn show(name: string, tokens: Token[]) {
    val sheet = decodeSheet(styleRule(tokens, defaultTheme())._1);
    print(name + " -> " + declarationsOf(sheet).join(" | "));
}

pub fn main() {
    show("Flex.Justify.Normal", [.Flex.Justify.Normal]);
    show("Flex.Justify.Start", [.Flex.Justify.Start]);
    show("Flex.Justify.Between", [.Flex.Justify.Between]);
    show("Flex.Justify.Evenly", [.Flex.Justify.Evenly]);
    show("Flex.Justify.Stretch", [.Flex.Justify.Stretch]);
    show("Flex.Items.Center", [.Flex.Items.Center]);
    show("Flex.Items.Baseline", [.Flex.Items.Baseline]);
    show("Flex.AlignSelf.Start", [.Flex.AlignSelf.Start]);
    show("Flex.Content.Between", [.Flex.Content.Between]);
    show("Flex.JustifyItems.Start", [.Flex.JustifyItems.Start]);
    show("Flex.JustifySelf.Center", [.Flex.JustifySelf.Center]);
    show("Flex.PlaceContent.Between", [.Flex.PlaceContent.Between]);
    show("Flex.PlaceItems.Center", [.Flex.PlaceItems.Center]);
    show("Flex.PlaceSelf.Stretch", [.Flex.PlaceSelf.Stretch]);
}
