import {Token, styleRule, decodeSheet, declarationsOf, defaultTheme} from "rakun-stylesheet";

fn show(name: string, tokens: Token[]) {
    val sheet = decodeSheet(styleRule(tokens, defaultTheme())._1);
    @print(name + " -> " + declarationsOf(sheet).join(" | "));
}

pub fn main() {
    show("Layout.Columns.2", [.Layout.Columns.2]);
    show("Layout.Columns.Md", [.Layout.Columns.Md]);
    show("Layout.BreakAfter.Page", [.Layout.BreakAfter.Page]);
    show("Layout.BreakInside.AvoidColumn", [.Layout.BreakInside.AvoidColumn]);
    show("Layout.Box.Border", [.Layout.Box.Border]);
    show("Layout.BoxDecoration.Clone", [.Layout.BoxDecoration.Clone]);
}
