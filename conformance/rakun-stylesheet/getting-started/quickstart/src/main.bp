import {emilia.emilia, flush, Token} from "rakun-stylesheet";

val titleStyle = emilia([
    .Text.Size.X3xl,
    .Text.Bold,
    .Color.Red.600,
]);

val bodyStyle = emilia([
    .Text.Size.Base,
    .Color.Gray.600,
    Token.Hover([.Color.Red.600]),
    Token.Md([.Text.Size.Lg]),
]);

pub fn main() -> @Task<void> {
    // SSR composition — markup first, then the registered stylesheet. The
    // markup is a literal here: rakun-bpp's `renderToString` writes it in an app.
    val markup = "<div><h1 class=\""
        + titleStyle
        + "\"></h1><p class=\""
        + bodyStyle
        + "\"></p></div>";
    val styles = await flush();
    val html = "<html><head>"
        + styles
        + "</head><body>"
        + markup
        + "</body></html>";
    @print(html);
}
