import {Token, styled, styledWith, cls, defaultTheme} from "rakun-stylesheet";
import {io.terminal.print} from "std";

fn cardTokens() -> Token[] {
    val out: Token[] = [.Pad.All.4, .Bg.White];
    return out;
}

pub fn main() {
    val th = defaultTheme(); // ONE theme value, on the server and the client
    val a = styled(cardTokens(), th); // #("class", "e_…")
    print(a._0 + " = " + a._1);
    val b = styledWith("card", cardTokens(), th); // "card e_…", static first
    print(b._0 + " = " + b._1);
    val card = cls(cardTokens(), th); // for a `[class]={card}` hole
    print(card);
}
