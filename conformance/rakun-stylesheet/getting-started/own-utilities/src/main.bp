import {Token, emilia.emilia, flushWith, defaultOptions, withTheme, emptyTheme, compose.compose, hocus, named, scrollbarHidden} from "rakun-stylesheet";
import {io.terminal.print} from "std";

fn btn() -> Token[] {
    val out: Token[] = [.Pad.X.__4, .Pad.Y.__2, .Border.Rounded.Md];
    return out;
}

pub async fn main() -> Async<void> {
    val red: Token[] = [.Bg.Color.Red.__500];
    val danger = emilia(btn().append(red)); // @apply
    val all = emilia(compose([btn(), scrollbarHidden()]));
    val bold: Token[] = [.Text.Bold];
    val link = emilia(hocus(bold)); // :hover and :focus
    val cls = named("btn", btn()); // .btn in @layer components
    print(danger);
    print(all);
    print(link);
    print(cls);
    print(await flushWith(withTheme(defaultOptions(), emptyTheme())));
}
