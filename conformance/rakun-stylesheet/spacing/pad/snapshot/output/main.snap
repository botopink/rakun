botopink-cell 1
out Pad.All.4 -> padding:calc(var(--spacing) * 4)
out Pad.X.4 -> padding-left:calc(var(--spacing) * 4);padding-right:calc(var(--spacing) * 4)
out Pad.T.4 -> padding-top:calc(var(--spacing) * 4)
out Pad.S.4 -> padding-inline-start:calc(var(--spacing) * 4)
out Pad.E.4 -> padding-inline-end:calc(var(--spacing) * 4)
