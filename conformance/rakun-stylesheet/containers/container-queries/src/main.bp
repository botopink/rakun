import {Token, emilia.emilia, flushWith, defaultOptions, withTheme, emptyTheme, containerName, containerAtMd, containerAtSm} from "rakun-stylesheet";

fn doc(name: string, tokens: Token[]) -> @Task<void> {
    emilia(tokens);
    @print(name);
    @print(await flushWith(withTheme(defaultOptions(), emptyTheme())));
}

pub fn main() -> @Task<void> {
    await doc("slot", [.Container.Inline]); // container-type:inline-size
    await doc("shell", [containerName("main")]); // + container-name:main
    val row: Token[] = [.Flex.Row];
    await doc("card", [.Flex.Col, containerAtMd(row)]); // @container (width >= 28rem){…}
    await doc("card-sm", [containerAtSm(row)]);
}
