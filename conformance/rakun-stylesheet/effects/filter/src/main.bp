import {Token, emilia.emilia, flushWith, defaultOptions, withTheme, emptyTheme} from "rakun-stylesheet";
import {io.terminal.print} from "std";

fn doc(name: string, tokens: Token[]) -> Task<void> {
    emilia(tokens);
    print(name);
    print(await flushWith(withTheme(defaultOptions(), emptyTheme())));
}

pub fn main() -> Task<void> {
    val frosted = emilia([.BackdropFilter.Blur.Md, .BackdropFilter.Saturate.__150]);
    val dimmed = emilia([.Filter.Grayscale.__100, .Filter.Brightness.__75]);
    print(frosted);
    print(dimmed);
    print(await flushWith(withTheme(defaultOptions(), emptyTheme())));
}
