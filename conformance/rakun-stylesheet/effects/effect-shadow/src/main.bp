import {Token, styleRule, decodeSheet, declarationsOf, defaultTheme} from "rakun-stylesheet";
import {io.terminal.print} from "std";

fn show(name: string, tokens: Token[]) -> void {
    val sheet = decodeSheet(styleRule(tokens, defaultTheme())._1);
    print(name + " -> " + declarationsOf(sheet).join(" | "));
}

pub fn main() -> void {
    show("Effect.Shadow.X2xs", [.Effect.Shadow.X2xs]);
    show("Effect.Shadow.Xs", [.Effect.Shadow.Xs]);
    show("Effect.Shadow.X2xl", [.Effect.Shadow.X2xl]);
    show("Effect.Shadow.None", [.Effect.Shadow.None]);
    show("Effect.Shadow.Inner", [.Effect.Shadow.Inner]);
    show("Effect.InsetShadow.X2xs", [.Effect.InsetShadow.X2xs]);
    show("Effect.InsetShadow.Xs", [.Effect.InsetShadow.Xs]);
    show("Effect.InsetShadow.Sm", [.Effect.InsetShadow.Sm]);
    show("Effect.TextShadow.Sm", [.Effect.TextShadow.Sm]);
    show("Effect.TextShadow.None", [.Effect.TextShadow.None]);
}
