import {Token, emilia.emilia, flushWith, defaultOptions, withTheme, emptyTheme, rawMaskImage} from "rakun-stylesheet";
import {io.terminal.print} from "std";

async fn doc(name: string, tokens: Token[]) -> Async<void> {
    emilia(tokens);
    print(name);
    print(await flushWith(withTheme(defaultOptions(), emptyTheme())));
}

pub async fn main() -> Async<void> {
    val tokens: Token[] = [
        rawMaskImage("linear-gradient(to bottom, black 60%, transparent)"),
        .Mask.Repeat.NoRepeat,
    ];
    await doc("mask", tokens);
}
