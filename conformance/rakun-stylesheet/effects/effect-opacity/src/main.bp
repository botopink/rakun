import {Token, styleRule, decodeSheet, declarationsOf, defaultTheme} from "rakun-stylesheet";
import {io.terminal.print} from "std";

fn show(name: string, tokens: Token[]) -> void {
    val sheet = decodeSheet(styleRule(tokens, defaultTheme())._1);
    print(name + " -> " + declarationsOf(sheet).join(" | "));
}

pub fn main() -> void {
    show("Effect.Opacity.__0", [.Effect.Opacity.__0]);
    show("Effect.Opacity.__60", [.Effect.Opacity.__60]);
    show("Effect.Opacity.__100", [.Effect.Opacity.__100]);
}
