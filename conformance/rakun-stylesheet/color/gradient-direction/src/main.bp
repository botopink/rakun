import {Token, styleRule, decodeSheet, declarationsOf, defaultTheme} from "rakun-stylesheet";
import {io.terminal.print} from "std";

fn show(name: string, tokens: Token[]) -> void {
    val sheet = decodeSheet(styleRule(tokens, defaultTheme())._1);
    print(name + " -> " + declarationsOf(sheet).join(" | "));
}

pub fn main() -> void {
    show("Gradient.To.T", [.Gradient.To.T]);
    show("Gradient.To.Tr", [.Gradient.To.Tr]);
    show("Gradient.To.R", [.Gradient.To.R]);
    show("Gradient.To.Br", [.Gradient.To.Br]);
    show("Gradient.To.B", [.Gradient.To.B]);
    show("Gradient.To.Bl", [.Gradient.To.Bl]);
    show("Gradient.To.L", [.Gradient.To.L]);
    show("Gradient.To.Tl", [.Gradient.To.Tl]);
}
