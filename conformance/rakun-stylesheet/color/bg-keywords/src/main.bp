import {Token, styleRule, decodeSheet, declarationsOf, defaultTheme} from "rakun-stylesheet";

fn show(name: string, tokens: Token[]) {
    val sheet = decodeSheet(styleRule(tokens, defaultTheme())._1);
    @print(name + " -> " + declarationsOf(sheet).join(" | "));
}

pub fn main() {
    show("Bg.Attachment.Fixed", [.Bg.Attachment.Fixed]);
    show("Bg.Attachment.Local", [.Bg.Attachment.Local]);
    show("Bg.Attachment.Scroll", [.Bg.Attachment.Scroll]);
    show("Bg.Clip.Border", [.Bg.Clip.Border]);
    show("Bg.Clip.Padding", [.Bg.Clip.Padding]);
    show("Bg.Clip.Content", [.Bg.Clip.Content]);
    show("Bg.Clip.Text", [.Bg.Clip.Text]);
    show("Bg.Origin.Border", [.Bg.Origin.Border]);
    show("Bg.Origin.Padding", [.Bg.Origin.Padding]);
    show("Bg.Origin.Content", [.Bg.Origin.Content]);
    show("Bg.Pos.Bottom", [.Bg.Pos.Bottom]);
    show("Bg.Pos.Center", [.Bg.Pos.Center]);
    show("Bg.Pos.Left", [.Bg.Pos.Left]);
    show("Bg.Pos.LeftBottom", [.Bg.Pos.LeftBottom]);
    show("Bg.Pos.LeftTop", [.Bg.Pos.LeftTop]);
    show("Bg.Pos.Right", [.Bg.Pos.Right]);
    show("Bg.Pos.RightBottom", [.Bg.Pos.RightBottom]);
    show("Bg.Pos.RightTop", [.Bg.Pos.RightTop]);
    show("Bg.Pos.Top", [.Bg.Pos.Top]);
    show("Bg.Repeat.Repeat", [.Bg.Repeat.Repeat]);
    show("Bg.Repeat.None", [.Bg.Repeat.None]);
    show("Bg.Repeat.X", [.Bg.Repeat.X]);
    show("Bg.Repeat.Y", [.Bg.Repeat.Y]);
    show("Bg.Repeat.Round", [.Bg.Repeat.Round]);
    show("Bg.Repeat.Space", [.Bg.Repeat.Space]);
    show("Bg.Size.Auto", [.Bg.Size.Auto]);
    show("Bg.Size.Cover", [.Bg.Size.Cover]);
    show("Bg.Size.Contain", [.Bg.Size.Contain]);
    show("Bg.Image.None", [.Bg.Image.None]);
}
