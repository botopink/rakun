import {Token, styleRule, decodeSheet, declarationsOf, defaultTheme} from "rakun-stylesheet";
import {io.terminal.print} from "std";

fn show(name: string, tokens: Token[]) {
    val sheet = decodeSheet(styleRule(tokens, defaultTheme())._1);
    print(name + " -> " + declarationsOf(sheet).join(" | "));
}

pub fn main() {
    show("Color.Red.500", [.Color.Red.500]);
    show("Color.Sky.100", [.Color.Sky.100]);
    show("Color.Taupe.950", [.Color.Taupe.950]);
    show("Color.White", [.Color.White]);
    show("Color.Black", [.Color.Black]);
    show("Color.Transparent", [.Color.Transparent]);
    show("Color.Current", [.Color.Current]);
    show("Color.Inherit", [.Color.Inherit]);
}
