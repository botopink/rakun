import {defaultTheme, extendTheme, transitionEntries, themeValue} from "rakun-stylesheet";
import {io.terminal.print} from "std";

pub fn main() {
    val th = extendTheme(defaultTheme(), transitionEntries());
    print(themeValue(defaultTheme(), "--ease-in"));
    print(themeValue(th, "--ease-in"));
    print(themeValue(th, "--ease-out"));
    print(themeValue(th, "--ease-in-out"));
}
