import {Token, emilia.emilia, flushWith, defaultOptions, withTheme, emptyTheme, rawTransitionProperty, rawAnimate} from "rakun-stylesheet";
import {io.terminal.print} from "std";

async fn doc(name: string, tokens: Token[]) -> Async<void> {
    emilia(tokens);
    print(name);
    print(await flushWith(withTheme(defaultOptions(), emptyTheme())));
}

pub async fn main() -> Async<void> {
    val tokens: Token[] = [
        rawTransitionProperty("width"),
        rawAnimate("fade 300ms ease-out"),
    ];
    await doc("raw", tokens);
}
