import {Token, emilia.emilia, flushWith, defaultOptions, withTheme, emptyTheme, accent, paletteVar} from "rakun-stylesheet";
import {io.terminal.print} from "std";

async fn doc(name: string, tokens: Token[]) -> Async<void> {
    emilia(tokens);
    print(name);
    print(await flushWith(withTheme(defaultOptions(), emptyTheme())));
}

pub async fn main() -> Async<void> {
    await doc("carousel", [.Interact.Snap.Type.X, .Interact.Snap.Strictness.Mandatory, .Interact.Scroll.Behavior.Smooth]);
    await doc("handle", [.Interact.Cursor.Grab, .Interact.Select.None, Token.Active([.Interact.Cursor.Grabbing])]);
    await doc("overlay", [.Interact.PointerEvents.None]);
    await doc("checkbox", [accent(paletteVar("indigo", "600"))]);
}
