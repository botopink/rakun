//// rakun-hateoas — HAL (front 21): the link set, `#[halResource]`,
//// collections, `linkTo` over the core router's table, and the response.

import {testing.asserts} from "std";
import {Request, Response, rkSetProp, rkRegisterRoute} from "rakun";
import {headerValue, rkHeaderClear} from "rakun-web";
import {
    Link,
    link,
    linksObject,
    halObject,
    halString,
    halInt,
    halBool,
    halFloat,
    halResource,
    halCollection,
    linkTo,
    unknownPatternProblem,
    missingParamProblem,
    unusedParamProblem,
    halResponse,
    halResponseFor,
} from "hal";

#[halResource]
pub type UserResource(
    id: i32,
    name: string,
    active: bool,
)

fn users(req: Request) -> Response {
    return Response.ok("[]");
}

test "rakun-hateoas: a link renders its href under its rel" {
    assert linksObject([link("self", "/api/users/1")]) == "{\"self\":{\"href\":\"/api/users/1\"}}";
}

test "rakun-hateoas: empty mediaType and title are omitted, non-empty ones written; templated only when true" {
    val full: Link = Link(rel: "doc", href: "/d{?q}", mediaType: "text/html", title: "Docs", templated: true);
    assert linksObject([full]) == "{\"doc\":{\"href\":\"/d{?q}\",\"type\":\"text/html\",\"title\":\"Docs\",\"templated\":true}}";
    assert linksObject([link("a", "/a")]).contains("templated") == false;
}

test "rakun-hateoas: two links with one rel are an array, in insertion order" {
    assert linksObject([link("item", "/1"), link("self", "/"), link("item", "/2")]) == "{\"item\":[{\"href\":\"/1\"},{\"href\":\"/2\"}],\"self\":{\"href\":\"/\"}}";
}

test "rakun-hateoas: a quote or a backslash in an href is escaped" {
    assert linksObject([link("x", "/a\"b\\c")]) == "{\"x\":{\"href\":\"/a\\\"b\\\\c\"}}";
}

test "rakun-hateoas: #[halResource] emits <typeName>ToHal - fields in order, bare scalars, _links last" {
    val v: UserResource = UserResource(id: 1, name: "Alice \"A\"", active: true);
    val out: string = userResourceToHal(v, [link("self", "/api/users/1")]);
    assert out == "{\"id\":1,\"name\":\"Alice \\\"A\\\"\",\"active\":true,\"_links\":{\"self\":{\"href\":\"/api/users/1\"}}}";
    assert userResourceToHal(v, [link("self", "/api/users/1")]) == out;
}

test "rakun-hateoas: the scalar renderers" {
    assert halInt(42) == "42";
    assert halBool(false) == "false";
    assert halFloat(2.5) == "2.5";
    assert halString("x") == "\"x\"";
}

test "rakun-hateoas: a collection is _embedded first and _links last; empty is []" {
    val one: string = halObject([#("id", "1")], []);
    assert halCollection("users", [one], [link("self", "/api/users")]) == "{\"_embedded\":{\"users\":[{\"id\":1,\"_links\":{}}]},\"_links\":{\"self\":{\"href\":\"/api/users\"}}}";
    assert halCollection("users", [], []).contains("\"_embedded\":{\"users\":[]}");
}

test "rakun-hateoas: paging links keep their order" {
    val links: Array<Link> = [link("self", "/u?page=2"), link("first", "/u?page=1"), link("prev", "/u?page=1"), link("next", "/u?page=3"), link("last", "/u?page=9")];
    assert linksObject(links).startsWith("{\"self\":{\"href\":\"/u?page=2\"},\"first\":");
    assert linksObject(links).endsWith("\"last\":{\"href\":\"/u?page=9\"}}");
}

test "rakun-hateoas: linkTo substitutes by name over a registered route" {
    val _r = rkRegisterRoute("GET", "/api/users/:id", { r -> users(r) });
    assert linkTo("self", "/api/users/:id", [#("id", "1")]).href == "/api/users/1";
}

test "rakun-hateoas: a pattern nobody serves raises, naming it and the nearest path" {
    val _r = rkRegisterRoute("GET", "/api/users/:id", { r -> users(r) });
    try asserts.throwsWith({ ->
        val _l = linkTo("self", "/api/user/:id", [#("id", "1")]);
        0;
    }, "nearest registered path is `/api/users/:id`");
}

test "rakun-hateoas: a missing entry and an unused entry both raise with the name" {
    val _r = rkRegisterRoute("GET", "/api/users/:id", { r -> users(r) });
    try asserts.throwsWith({ ->
        val _l = linkTo("self", "/api/users/:id", []);
        0;
    }, missingParamProblem("/api/users/:id", "id"));
    try asserts.throwsWith({ ->
        val _l = linkTo("self", "/api/users/:id", [#("id", "1"), #("x", "2")]);
        0;
    }, unusedParamProblem("/api/users/:id", "x"));
}

test "rakun-hateoas: a value holding / ? or # is percent-encoded" {
    val _r = rkRegisterRoute("GET", "/files/:name", { r -> users(r) });
    assert linkTo("self", "/files/:name", [#("name", "a/b?c#d")]).href == "/files/a%2Fb%3Fc%23d";
}

test "rakun-hateoas: halResponse is 200 application/hal+json through the header surface" {
    val _c = rkHeaderClear();
    val res: Response = halResponse("{}");
    assert res.status == 200;
    assert headerValue("Content-Type") == "application/hal+json";
}

test "rakun-hateoas: with the default off, plain JSON - unless the client asks for HAL" {
    val _p = rkSetProp("rakun.hateoas.use-hal-as-default-json-media-type", "false");
    val _c = rkHeaderClear();
    val _a = halResponseFor("application/json", "{}");
    val plain: string = headerValue("Content-Type");
    val _d = halResponseFor("application/hal+json", "{}");
    val asked: string = headerValue("Content-Type");
    val _u = rkSetProp("rakun.hateoas.use-hal-as-default-json-media-type", "");
    assert plain == "application/json";
    assert asked == "application/hal+json";
}
