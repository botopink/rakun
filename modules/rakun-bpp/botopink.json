{
  "name": "rakun-bpp",
  "version": "0.0.1",
  "description": "rakun-bpp — the Element tree + builders + SSR renderer, the state/effect/memo/ref/reducer hooks, the route snapshot, the request record, the server-component convention, the `html \"\"\"…\"\"\"` markup DSL, `Link`, forms and the test helpers (html/, link/, forms/, testing/) — commonJS and erlang",
  "src": "src/",
  "entry": "root.bp",
  "target": "commonJS",
  "files": [
    "root.bp",
    "element.bp",
    "hooks.bp",
    "router.bp",
    "server.bp",
    "globals.bp",
    "client.bp",
    "error_boundary.bp",
    "metadata.bp",
    "elements.bp",
    "suspense.bp",
    "plugin.bp",
    "routes.bp",
    "styled_sheet.bp",
    "render.bp",
    "streaming.bp",
    "client_app.bp",
    "client_runtime.bp",
    "html_attrs.bp",
    "node.bp",
    "prelude.bp",
    "html/mod.bp",
    "html/html.bp",
    "link/mod.bp",
    "link/link.bp",
    "link/reconcile.bp",
    "forms/mod.bp",
    "forms/form.bp",
    "testing/mod.bp",
    "testing/harness.bp",
    "testing/assert_html.bp",
    "testing/assert_route.bp",
    "testing/assert_link.bp",
    "testing/assert_server.bp",
    "testing/assert_island.bp",
    "testing/assert_stream.bp",
    "testing/assert_render.bp",
    "testing/assert_error_boundary.bp",
    "testing/assert_metadata.bp",
    "testing/assert_form.bp"
  ],
  "dependencies": {
    "actions": {
      "git": "https://github.com/botopink/actions.git",
      "branch": "feat"
    },
    "routing": {
      "git": "https://github.com/botopink/routing.git",
      "branch": "feat"
    },
    "rakun-style": {
      "workspace": true
    },
    "snap": {
      "git": "https://github.com/botopink/snap.git",
      "branch": "feat"
    }
  }
}
