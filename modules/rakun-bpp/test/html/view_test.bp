// Decision 276: `View` is `Component<Element>` under a shorter
// name. A function declared with one spelling returns a call of a function
// declared with the other, both ways.

import {element.Element, element.ElementBase, element.View, element.p, element.text, render.renderNode};
import {context.Scope, context.run} from "std";

component fn spelledInFull() -> Component<Element> {
    return p([text("full")], attrs: []);
}

fn spelledAsView() -> View {
    return spelledInFull();
}

component fn backInFull() -> Component<Element> {
    val v = use spelledAsView();
    return v;
}

test "-> View and -> Component<Element> accept one another" {
    val viewed = await run(spelledAsView());
    val full = await run(backInFull());
    assert renderNode(viewed) == "<p>full</p>";
    assert renderNode(full) == "<p>full</p>";
}
