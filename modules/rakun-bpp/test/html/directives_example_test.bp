// specs/1.0.12-beta/08-bpp/118-bpp-components/examples/directives-example.bp,
// landed: step 5 — `raw`, `classList`, `#[isRaw]`. Rendered through
// `renderNode`; `pre` and `code` are declared here (no core builder).
//
// `html` runs every annotation over the tag's `@Decl` (decision 302) and
// reads back the meta it knows by type — `RawBody`, recorded by `#[isRaw]`.
// Not here, and why: the readers of the other metas (`#[mustBeBox]`, the
// style, island and transition annotations) are their fronts' (119, 120, 126).

import {html.html.html, html.html.isRaw, html.html.classList, html.html.classIf};
import {element.Element, node.Node, elements.article, element.div, element.p, element.span, elements.el, render.raw, render.renderNode};

fn pre(children: Children, attrs: Array<#(string, string)> = []) -> Element {
    return el("pre", children, attrs);
}

fn code(children: Children, attrs: Array<#(string, string)> = []) -> Element {
    return el("code", children, attrs);
}

pub fn Rendered(content: string) -> Element {
    return html "<article>{raw(content)}</article>";
}

pub fn Inline(content: string) -> Element {
    return html "{raw(content)}";
}

pub fn Quoted(value: string) -> Element {
    return html "<p>{value}</p>";
}

pub fn Box(isRed: bool, extra: string, children: Node = []) -> Element {
    return html """
      <div class={classList(["box", classIf(isRed, "red"), extra])}>
        <slot />
      </div>
    """;
}

pub fn Snippet() -> Element {
    return html """
      <pre><code #[isRaw]>{items.map({ x -> <li>{x}</li> })}</code></pre>
    """;
}

test "raw writes the value unescaped" {
    assert renderNode(Rendered("<p>raw</p>"))
        == "<article><p>raw</p></article>";
    assert renderNode(Inline("<p>raw</p>")) == "<p>raw</p>";
}

test "a hole escapes" {
    assert renderNode(Quoted("<b>")) == "<p>&lt;b&gt;</p>";
}

test "classList drops what is empty" {
    assert renderNode(Box(true, "")) == "<div class=\"box red\"></div>";
    assert renderNode(Box(false, "wide")) == "<div class=\"box wide\"></div>";
    assert renderNode(Box(false, "")) == "<div class=\"box\"></div>";
}

test "#[isRaw] keeps braces and angle brackets as text" {
    val markup = renderNode(Snippet());
    assert markup
        == "<pre><code>{items.map({ x -&gt; &lt;li&gt;{x}&lt;/li&gt; })}</code></pre>";
}
