// rakun-bpp/suspense — the streaming boundary and its hole (front 30).
//
// An `Element` cannot carry a deferred child — `NodeChildren` is a list of
// elements, never of components (until 809 (7)) — so a boundary is a
// RECORD beside the tree: its fallback goes out with the shell, and its child
// is the component VALUE, `child: Component<Element>` (decisions 964 (2)
// 30-d, 809 (7)). The caller evaluates it where it writes the boundary —
// `Boundary(…, child: Slow())` — so the call is counted where it is written,
// on the placing body's cell, in the render's own process (966 (3), (4)).
// Calling a component only makes its lambda (791 (1)): nothing runs until the
// fill runs it, `run(b.child, fill.scope)`, over the cell the fill opens under
// its detached seed (966 (5), 970 (3)). A thunk here would stamp the call
// inside the fill's process over the page's cell, which is another process's
// there — `scope-foreign`.
//
// `Suspense(b)` renders only the HOLE: the fallback inside
// `<div data-jh-h="h1">` (`contracts.md § 2`). The child never appears in the
// shell. A boundary's id is an ordinal assigned by the render in shell order
// (`holeId`), never derived from the route: a client navigation is a new
// response with a new set of ordinals.
//
// `Suspense` is itself a `component fn` keeping its OWN cell (`use
// selfScope`, 809 (8) case B, 1103), exactly the device `render.bp`'s
// `errorBoundaryNode` keeps for an application's error boundary: a bare
// `Suspense` written directly in a page body — not nested under
// `errorBoundaryNode` or under the composition's own loading level
// (`placeFill`) — sees every `use provide` written above it at ITS OWN
// placement, the same guarantee a nested `use` would have (mt-0373 (3)).
// Before this, the fill's seed was the scope of the RUN that met the hole
// (`renderComponent`'s own `scope` argument) rather than the placing body's
// own cell, so a context provided inside that body, above the `Suspense`
// call, never reached the fill — the known gap the boundaries-hold-a-value
// fix (5c90bc0a) left open.

import {element.Element, element.ElementBase};
import {compiler} from "std";
import {context.Scope} from "std";

pub type Boundary(
    id: string,
    fallback: Element,
    child: Component<Element>,
)

// A boundary with the scope its fill runs with: always a detached seed, the
// one form of a scope that crosses a process (970 (3), (4)).
pub type Fill(boundary: Boundary, scope: Scope)

// A boundary as the render learns it: `at` answers the fill's scope — the
// seed `Suspense` or `placeFill` already detached at the placement, never
// read from the scope of the run that meets the hole (mt-0373 (3)).
pub type Placed(boundary: Boundary, at: fn(scope: Scope) -> Scope)

// The boundary is registered with the render as the hole is written: an
// `Element` has nowhere to carry a component until the tree's children are
// components themselves (809 (7)), so the render learns the boundaries a
// tree holds from this cell (`render.mjs` / `sidecars/jhonstart_render.erl`,
// per render). Outside a render the registration is simply never read.
#[compiler.external(.JavaScript("require('./render.mjs').pushBoundary($0)"), .Erlang("jhonstart_render:push_boundary($0)"))]
declare fn __jhPushBoundary(p: Placed) -> i32;

// The ambient scope a body currently stands in (809 (8) case B): `render.bp`
// keeps an identical `val selfScope`, kept here too rather than imported —
// `render.bp` imports `suspense.bp`, so the arrow cannot run the other way.
// Stateless, so one value is `use`d from every body that needs it.
val selfScope: Component<Scope> = { scope, key -> scope };

// `component fn` so `use selfScope` sees every provider above THIS call's
// own placement (mt-0373 (3)) — never the scope of whatever run later meets
// the hole, which may be a detached seed of an entirely different cell once
// the fill crosses a process on erlang and beam (970 (3), (4)).
pub component fn Suspense(b: Boundary) -> Component<Element> {
    val myScope = use selfScope;
    __jhPushBoundary(Placed(boundary: b, at: { scope -> myScope.detach() }));
    return hole(b);
}

// A hole whose fill runs over the seed `f` already carries — the placing
// body's own cell, detached where it was placed (970 (3)).
pub fn placeFill(f: Fill) -> Element {
    val seed = f.scope;
    __jhPushBoundary(Placed(boundary: f.boundary, at: { scope -> seed }));
    return hole(f.boundary);
}

fn hole(b: Boundary) -> Element {
    return Element(
        tag: "div",
        value: "",
        children: [b.fallback],
        attrs: [#("data-jh-h", b.id)],
    );
}

// `h` followed by the ordinal — the spelling `contracts.md § 2` pins. Nothing
// but `[h0-9]` can come out of it, so a hole id needs no escaping anywhere it
// is written.
pub fn holeId(index: i32) -> string {
    return "h" + index.toString();
}
