// rakun-bpp/element — the UI core, implemented in *real* botopink.

// `Element` carries the tree and implements `Renderable` (decision 354 of
// botopink), so a component is `fn … -> Component<Element>` and a
// `Component` read with `use` is `fn … -> Component<T>` — the return is the
// effect (decision 118), there is no annotation. `ElementBase` was the base
// decision 128's wrapper named; `Component<R>` names none, and the root
// context the render provides in its place is `ElementContext` (354 (7),
// `05-jhonstart/26`), which retires this phantom.
pub type ElementBase()

// An element's children: an ordinary list of elements, rakun-bpp's own type
// (decision 804 (4): the compiler knows no child list, and the compiler-known
// `Children` with its single-child and string coercions retired —
// `div([text("x")])`). Interim until 809 (7): a child becomes
// `Component<Element>` (`NodeChild = Component<Element>`,
// `NodeChildren = NodeChild[]`), the renderer resolving each one.
pub type NodeChildren = Element[];

pub type Element(
    tag: string,
    value: string,
    children: NodeChildren,
    attrs: array<#(string, string)>,
) implement Renderable

// What a component returns (decision 276): the same type as
// `Component<Element>` under a shorter name — each spelling
// accepts the other. `html """…"""` declares `-> @ExprCustom<View>` (275).
pub type View = Component<Element>;

pub fn bracketPair(name: string, value: string) -> #(string, string) {
    return #(name, value);
}

pub fn text(value: string, attrs: array<#(string, string)> = []) -> Element {
    return Element(tag: "#text", value: value, children: [], attrs: attrs);
}

pub fn fragment(
    children: NodeChildren,
    attrs: array<#(string, string)> = [],
) -> Element {
    return Element(
        tag: "#fragment",
        value: "",
        children: children,
        attrs: attrs,
    );
}

pub fn div(
    children: NodeChildren,
    attrs: array<#(string, string)> = [],
) -> Element {
    return Element(tag: "div", value: "", children: children, attrs: attrs);
}

pub fn span(
    children: NodeChildren,
    attrs: array<#(string, string)> = [],
) -> Element {
    return Element(tag: "span", value: "", children: children, attrs: attrs);
}

pub fn p(children: NodeChildren, attrs: array<#(string, string)> = []) -> Element {
    return Element(tag: "p", value: "", children: children, attrs: attrs);
}

pub fn h1(children: NodeChildren, attrs: array<#(string, string)> = []) -> Element {
    return Element(tag: "h1", value: "", children: children, attrs: attrs);
}

pub fn ul(children: NodeChildren, attrs: array<#(string, string)> = []) -> Element {
    return Element(tag: "ul", value: "", children: children, attrs: attrs);
}

pub fn li(children: NodeChildren, attrs: array<#(string, string)> = []) -> Element {
    return Element(tag: "li", value: "", children: children, attrs: attrs);
}

// The single documented escape hatch: `html` is written verbatim. Its two
// uses are a plugin's `<style>` block and the payload script. Lives here
// (m1-0295, mt-0418), not in `render.bp`, because it needs only `Element`:
// `prelude.bp`'s `import {render.raw}` used to pull in `render.bp`'s own
// `routes.bp` import at a `.bpp` consumer's module-load time, reentering
// `routes.bp` while it was still loading (routes → element → prelude →
// render → routes) — this module has no further imports, so the prelude's
// load of it can never cycle back into anything.
pub fn raw(html: string) -> Element {
    return Element(tag: "#raw", value: html, children: [], attrs: []);
}

pub fn renderToString(e: Element) -> string {
    if (e.tag == "#text") return e.value;
    var inner = "";
    for (e.children) { c ->
        inner = inner + renderToString(c);
    }
    if (e.tag == "#fragment") return inner;
    var attrStr = "";
    for (e.attrs) { a ->
        attrStr = attrStr + " " + a._0 + "=\"" + a._1 + "\"";
    }
    return "<" + e.tag + attrStr + ">" + inner + "</" + e.tag + ">";
}

test "leaf, fragment, and a nested tree render to HTML" {
    assert renderToString(text("hi", attrs: [])) == "hi";
    assert renderToString(
        fragment([text("a", attrs: []), text("b", attrs: [])], attrs: []),
    )
        == "ab";
    val tree = div(
        [p([text("hi", attrs: [])], attrs: []), text("!", attrs: [])],
        attrs: [],
    );
    assert renderToString(tree) == "<div><p>hi</p>!</div>";
}

test "deeply nested lists build and render (list form)" {
    val page = div(
        [
            h1([text("Title", attrs: [])], attrs: []),
            ul(
                [
                    li([text("one", attrs: [])], attrs: []),
                    li(
                        [
                            span(
                                [text("t", attrs: []), text("wo", attrs: [])],
                                attrs: [],
                            ),
                        ],
                        attrs: [],
                    ),
                ],
                attrs: [],
            ),
        ],
        attrs: [],
    );
    assert renderToString(page)
        == "<div><h1>Title</h1><ul><li>one</li><li><span>two</span></li></ul></div>";
}
