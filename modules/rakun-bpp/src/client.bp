// rakun-bpp/client — the server/client boundary (front 29 of 1.0.10-beta).
//
// Next.js writes `'use client'` at the top of a file and the bundler reads it.
// botopink has no directive syntax and the milestone forbids compiler changes,
// so the boundary is built out of what annotation processing already gives: a
// decorator (a function whose first parameter is `syntax decl`) and its typed
// meta. `#[client]` marks a component,
// `#[clientProps]` marks the record its props travel in, and the server render
// contributes an ISLAND — `<div data-jh-i="i0">` — whose component name and
// encoded props live in front 23's payload rather than on the element.
//
// ── What is ENFORCED here, and what is NOT ──────────────────────────────────
//
// Read this before reading anything else in this file. The front's priority
// line is a security claim — "without a *checked* boundary, a secret read on
// the server reaches the browser and nobody notices" — and **this file is not
// that check.** Front 29 defines the boundary; **front 68 enforces it at build
// time.** 29 without 68 is a convention nobody walks.
//
// Enforced TODAY, at comptime, as a REFUSAL with no flag that turns it off
// (decision 67 — a boundary that warns is a boundary that is ignored):
//
//   1. `#[client]` on anything but a `fn` — refused, located at the annotation.
//   2. `#[client]` on a fn whose return type is neither `Element` nor `Component<Element>` — refused. A
//      server component that only loads data is `fn … -> Async<Element>`,
//      whose reflected `returnType` is `"Async<Element>"`, so it cannot be
//      marked client.
//   3. `#[clientProps]` on anything but a record — refused (an enum-shaped
//      `type` has `variants`, a `fn` is not `DeclKind.Type`).
//   4. A field of a `#[clientProps]` record whose type is not one of the four
//      serializable scalars — refused, naming the field and its type.
//
// NOT enforced today, by anything, anywhere in this tree:
//
//   - that a `#[client]` component's parameter record carries `#[clientProps]`
//     at all. `@Decl` exposes `fields`, `variants`, `methods`, `returnType` and
//     `annotations` and **does not expose a function's parameters** — so
//     `#[client]` alone can check nothing about props, which is the entire
//     reason the marker is split in two. A client component declared with a
//     bare `Element` parameter is accepted here.
//   - that no module reachable from a `#[client]` component imports
//     `serverOnly` (the poison pill below), or `request`/`cookies`/`headers`
//     from `server.bp`. Those are module-GRAPH predicates and there is no graph
//     here.
//   - that the props actually written into the payload's `i` row are the ones
//     the `#[clientProps]` record declares. `islandEntry` encodes whatever it
//     is handed.
//
// So today a secret read on the server still reaches the browser if someone
// writes it into an `Island`'s props, and nothing in this file notices. What
// closes it is front 68's walk over the client module graph, and this file's
// § *The front-68 contract* (mirrored in `../../../conformance/docs.md`) is the input it
// walks. Nothing here is written as if the decorator were a sandbox.
//
// ── The hydrate point and the props cell — dual-target ──────────────────────
//
// `hydrate()` and `propsFor(name)` are declared at the foot of this file over
// `./island_runtime.mjs`, with an erlang twin (`sidecars/jhonstart_island.erl`)
// answering the server's truth — nothing hydrates, no props. Dual-target and
// not node-only because this module is in the core, compiled on both rows,
// and a CALLED node-only cell reds the erlang compile at its caller
// (`decisions-pending.md` 27-a, the same choice). `hydrate()` is per-island:
// it walks every `[data-jh-i]`, reads that island's `i` row from the payload
// and starts the starter front 68's entry registered for that component in
// `globals.starters` (`registerStarter`, or a route's loader through
// `registerRouteStarters` — the bundle splits by route); it is
// idempotent, and it mounts no link and no form — front 68's entry calls it,
// then front 27's `linkMount()` and front 67's `formMount()` once each.
// `propsFor(name)` is `propsOf` over the cell's raw row.

// ── The marker is a PURE function, deliberately ─────────────────────────────
//
// `#[client]` records comptime meta — `decl.setMeta("component", <Name>)`,
// read as `compiler.typeInfo(<Name>).meta.client.component` (decision 216) — and no
// run-time code at all: not a call into a runtime registry, which would make
// every `#[client]` component fail to link during the erlang server render (a
// Node-only cell called on every target) — the exact case the boundary exists
// to support. Meta is a compile-time constant on every target and carries the
// same information: front 68 reads the set of client components with
// `@TypeInfo.all(with: client)`.

import {element.Element};
import {encoding, compiler, compiler.DeclKind} from "std";
import {globals.globals};

// ── step 1: `#[client]` — the marker ────────────────────────────────────────
//
// The meta is set BEFORE the `fail` checks, matching rakun's ordering
// (`decorators.bp`): a failed outcome discards it, so only a correctly placed
// declaration is recorded.
//
// Two hard constraints on any decorator body, both of them the reason this one
// is shaped the way it is: it cannot call a sibling function (each decorator is
// lowered ALONE into the eval script), and a `//` comment inside it breaks the
// emitted line. So every predicate below is inlined and the body is bare.
//
// `decl.returnType` is the return type as the source spells it: a
// `fn … -> Element` reflects as `"Element"`, a component as
// `"Component<Element>"` (any `Component<R>` passes check 2), and a data-loading server component as
// `"Async<Element>"`. That is what makes check 2 reject a server component.
//
// `botopink check` runs the decorator like `build` and `test` do, so
// the meta is recorded under `check` too.
// What `#[client]` records: the component's name, read `compiler.typeInfo(X).meta(ClientMark)?.component`.
pub type ClientMark(component: string)

pub fn client(syntax decl: unknown) -> void {
    compiler.setMeta(ClientMark(component: compiler.name(decl)!));
    if (compiler.kind(decl) != DeclKind.Fn)
        compiler.fail("#[client] must annotate a function", at: decl);
    // Decision 354: a component is a `Component<R>` whose `R` implements
    // `Renderable`, whatever `R` is named.
    // LANGUAGE GAP: a decorator cannot read whether the `R` of a `Component<R>` return implements `Renderable` — any `Component<…>` is accepted here.
    if (compiler.returnType(decl) != "Element"
        && !(compiler.returnType(decl).startsWith("Component<")
            && compiler.returnType(decl).endsWith(">")))
        compiler.fail(
            "#[client] must annotate a component returning Element or Component<R>",
            at: decl,
        );
}

// ── step 2: `#[clientProps]` — the serializable whitelist ───────────────────
//
// The serializability rule is checked where the type information actually is.
// A client component takes ONE record parameter and that record carries
// `#[clientProps]`; `#[client]` cannot reach it, because `@Decl` does not
// expose a function's parameters.
//
// The whitelist is CLOSED: `string`, `i32`, `f64`, `bool`. A type not on it is
// refused rather than guessed at. `Element` is not on it — a client component
// receives server-rendered children as CHILDREN, never as a prop, which is the
// rule `serverSlot` below marks in the markup.
//
// **The whitelist is four names and not six.** § Step 2 asks for `string[]`
// and `i32[]` as well; they were left out while `Field.typeName` erased an
// element type (`array<string>` and `array<Element>` both reflected as
// `"Array"`, `string[]` as `""`). `typeName` is now the field's type as the
// source spells it, so widening the whitelist by those two spellings is this
// front's to do — until then an array-valued prop is an encoded `string`.
pub fn clientProps(syntax decl: unknown) -> void {
    if (compiler.kind(decl) != DeclKind.Type)
        compiler.fail("#[clientProps] must annotate a type", at: decl);
    if (compiler.variants(decl).length > 0)
        compiler.fail("#[clientProps] must annotate a record, not an enum", at: decl);
    compiler
        .fields(decl)
        .forEach({ f ->
            val ok = f.typeName == "string"
                || f.typeName == "i32"
                || f.typeName == "f64"
                || f.typeName == "bool";
            if (!ok)
                compiler.fail(
                    "a client prop must be serializable; '"
                        + f.name
                        + "' is "
                        + f.typeName,
                    at: decl,
                );
        });
}

// ── step 3: the island, and the ONE place its marker is spelled ─────────────
//
// `contracts.md § 2` pins the marker: `<div data-jh-i="i0">`. The component
// name and the encoded props do NOT live on the element — they live in the
// payload's `i` array as `[id, component, props]`, which is how the client
// finds the island without parsing attributes off the DOM, and what makes the
// boundary auditable: every crossing value is in one place, in render order,
// and front 68 walks it.
//
// **Decision 77: one definition, passed in, never two that must agree.** The
// string `"data-jh-i"` occurs ONCE in this tree, in `islandAttrOf` below.
// Everything else routes through it:
//
//   | caller  | calls                        | for |
//   |---------|------------------------------|-----|
//   | this file | `clientMount`              | the placeholder's `attrs` |
//   | front 23  | `RenderHooks.islandAttr`   | the pair for the ordinal it just assigned |
//   | front 68  | the same function, imported | the selector its entry walks |
//
// Front 23 assigns the ordinals (`i0`, `i1`, … in render order) and fills its
// `RenderHooks` field from here rather than spelling the pair a second time.
// **It must pass a LAMBDA** — `islandAttr: { n -> islandAttr(n) }`, never the
// bare name: a bare function name used as a value lowers to an unbound erlang
// variable, and a function-valued record field must be read into a local before
// it is called (`val f = hooks.islandAttr; f(0)`, never `hooks.islandAttr(0)`).
// Both are measured defects this tree records, not conventions.

// The id spelling for an ordinal. Front 23 owns WHICH ordinal; this owns what
// an ordinal is written as, so the markup and the payload's `i` row cannot
// disagree about the id of the same island.
pub fn islandId(ordinal: i32) -> string {
    return "i" + ordinal.toString();
}

// The one occurrence of the attribute name in this tree.
pub fn islandAttrOf(id: string) -> #(string, string) {
    return #("data-jh-i", id);
}

// Decision 77's export: the marker pair for an ordinal. `islandAttr(0)` is
// `#("data-jh-i", "i0")`.
pub fn islandAttr(ordinal: i32) -> #(string, string) {
    return islandAttrOf(islandId(ordinal));
}

// One island: the id front 23 assigned, the component front 68 must start, and
// the props that cross the boundary. `props` is a pair list and not a record,
// because this is the erased form every island shares once `#[clientProps]` has
// had its say about the record it came from.
pub type Island(
    id: string,
    component: string,
    props: array<#(string, string)>,
)

// What the server emits for a client component. The element carries the id and
// NOTHING else; children render inside it, unmodified.
//
// It touches no host cell, so it renders identically during front 23's BEAM
// pass and during a client re-render — which is the point: a placeholder that
// did not render on the server would be a boundary that never starts.
pub fn clientMount(island: Island, children: Children) -> Element {
    return Element(
        tag: "div",
        value: "",
        children: children,
        attrs: [islandAttrOf(island.id)],
    );
}

// The payload `i` row for one island: `[id, component, props]`, the props
// encoded `k=v&k=v`.
//
// The encoder is std's `encoding.formStringify` — the percent-aware codec the
// router, the request and the payload's `m` / `q` use (decision 116 rule 4),
// so a prop value containing `&`, `=` or a space round-trips.
//
// This front does not build the payload and does not escape it. Front 23
// collects one `islandEntry` per island into the `i` key and escapes the whole
// script per `contracts.md § 2`.
pub fn islandEntry(island: Island) -> #(string, string, string) {
    return #(island.id, island.component, encoding.formStringify(island.props));
}

// The pure half of the front's `propsFor(name)`: the decode, over the raw
// `k=v&k=v` string the host cell would answer. `propsFor` is this plus the cell
// (see this file's header for why the cell is not declared).
//
// `propsOf("")` is `[]` — the front's "a component with no props returns `[]`"
// acceptance row, asserted without a host.
pub fn propsOf(raw: string) -> array<#(string, string)> {
    return encoding.formParse(raw);
}

// ── step 3b: the hole in the payload ────────────────────────────────────────
//
// A client component may wrap server-rendered children: the Context Provider
// pattern puts a `'use client'` provider in the root layout with the entire
// server tree inside it. The provider is client code; its children are not.
//
// So the payload has a HOLE: inside `data-jh-i`, the subtree is server markup
// the client must ADOPT as-is and must not re-render — re-rendering it would
// need the server's data and the server's secrets. rakun-bpp marks the hole
// explicitly rather than leaving it implicit.
//
// The three rules that follow, and that front 68 enforces — none of them here:
//
//   1. A `data-jh-s` subtree is adopted by the client reconciler, never
//      reconstructed.
//   2. A server component may be a CHILD of a client component. It may never be
//      a PROP of one — which is why `Element` is off the whitelist above.
//   3. A client component may not read request scope. `request()`, `cookies()`
//      and `headers()` are `server.bp`'s and reaching them from a `#[client]`
//      module is a BUILD failure, not a runtime one.
//
// Same decision-77 treatment as the island: `"data-jh-s"` occurs once.
pub fn serverSlotAttr() -> #(string, string) {
    return #("data-jh-s", "1");
}

pub fn serverSlot(children: Children) -> Element {
    return Element(
        tag: "div",
        value: "",
        children: children,
        attrs: [serverSlotAttr()],
    );
}

// ── step 4: `server-only`, the poison pill ──────────────────────────────────
//
// `import 'server-only'` upstream is a module that exists only to fail the
// build when it lands in the client graph. This is the same trick in botopink's
// vocabulary: a module that touches the server imports `serverOnly`, and front
// 68 fails the build when a module reachable from a `#[client]` component
// imports it.
//
// **The returned value is meaningless and is never read.** Its PRESENCE in a
// module's import list is the whole signal. Nothing in this tree checks for it
// today — the check is a module-graph walk and the graph is front 68's.
pub fn serverOnly() -> i32 {
    return 1;
}

// ── the front-68 contract ───────────────────────────────────────────────────
//
// Everything front 68 needs from this front, and where each row comes from.
// Mirrored in `../../../conformance/docs.md` § *The client boundary*; front 68's README
// cites it there.
//
//   | Front 68 input              | Produced by |
//   |-----------------------------|-------------|
//   | the set of client component names | `@TypeInfo.all(with: client)` — the meta `#[client]` records |
//   | the island rows             | `islandEntry` per island, collected into the payload's `i` key by front 23 |
//   | the island selector         | `islandAttr(ordinal)` — decision 77, the only spelling of the pair |
//   | the client module graph     | the transitive imports of every module declaring one |
//   | the poison-pill predicate   | a module in that graph importing `serverOnly` |
//   | the request-scope predicate | a module in that graph importing `request`/`cookies`/`headers` from `server.bp` |
//
//   | the starter table           | `registerStarter(name, start)` / `registerRouteStarters(pattern, load)` into `globals.starters` |
//
// The entry calls `hydrate()` after registering; `propsFor(name)` reads a
// component's props from the payload.

// ── step 4: the hydrate point and the props cell ────────────────────────────

#[compiler.external(.JavaScript("require('./island_runtime.mjs').hydrate($0, $1)"), .Erlang("jhonstart_island:hydrate($0, $1)"))]
declare fn __jhHydrate(payloadName: string, tableName: string) -> i32;

#[compiler.external(
    .JavaScript("require('./island_runtime.mjs').registerStarter($0, $1, $2)"),
    .Erlang("jhonstart_island:register_starter($0, $1, $2)"),
)]
declare fn __jhRegisterStarter(
    tableName: string,
    name: string,
    start: fn(raw: string, commit: fn(html: string) -> i32) -> i32,
) -> i32;

#[compiler.external(
    .JavaScript("require('./island_runtime.mjs').registerRouteStarters($0, $1, $2)"),
    .Erlang("jhonstart_island:register_route_starters($0, $1, $2)"),
)]
declare fn __jhRegisterRouteStarters(
    tableName: string,
    pattern: string,
    load: fn() -> Async<i32>,
) -> i32;

#[compiler.external(
    .JavaScript("require('./island_runtime.mjs').starterNames($0)"),
    .Erlang("jhonstart_island:starter_names($0)"),
)]
declare fn __jhStarterNames(tableName: string) -> string[];

#[compiler.external(
    .JavaScript("require('./island_runtime.mjs').routeLoaders($0)"),
    .Erlang("jhonstart_island:route_loaders($0)"),
)]
declare fn __jhRouteLoaders(tableName: string) -> string[];

#[compiler.external(
    .JavaScript("require('./island_runtime.mjs').islandProps($0, $1)"),
    .Erlang("jhonstart_island:island_props($0, $1)"),
)]
declare fn __jhClientPropsRaw(payloadName: string, name: string) -> string;

// Starts every island not yet started whose component has a starter; answers
// how many have started in all. When a loader is registered for the payload's
// matched pattern (`r`), it is called once, and hydrate runs again when it
// resolves.
pub fn hydrate() -> i32 {
    return __jhHydrate(globals.payload, globals.starters);
}

// ── the island starter table — `globals.starters` ───────────────────────────
//
// rakun-ssr front 68's generated entry registers one starter per client component
// it bundles eagerly, and one loader per route whose islands live in that
// route's chunk. The table's name is the registry's (`globals.starters`), so
// the entry writes no `__` name; the entry holds no host cell for it either.
//
// A starter receives the island's encoded props (`propsOf` decodes them) and
// `commit(html)`, which writes the island's markup into its placeholder. A
// loader brings the route's chunk in and registers that route's starters with
// `registerStarter`; `hydrate()` calls it once, the first time the payload's
// matched pattern is its route.

// One starter per client component: a second registration for one name fails,
// naming it, on both rows.
pub fn registerStarter(
    name: string,
    start: fn(raw: string, commit: fn(html: string) -> i32) -> i32,
) -> i32 {
    assert registeredStarters().contains(name)
        == false, "rakun-bpp: a starter for `"
        + name
        + "` is already registered - one starter per client component";
    return __jhRegisterStarter(globals.starters, name, start);
}

// One loader per route pattern (the pattern the payload's `r` carries, the
// manifest's `R` record — contract 6): a second one fails, naming it.
pub fn registerRouteStarters(pattern: string, load: fn() -> Async<i32>) -> i32 {
    assert registeredRouteStarters().contains(pattern)
        == false, "rakun-bpp: a starter loader for route `"
        + pattern
        + "` is already registered - one loader per route";
    return __jhRegisterRouteStarters(globals.starters, pattern, load);
}

// The component names with a starter, in registration order.
pub fn registeredStarters() -> string[] {
    return __jhStarterNames(globals.starters);
}

// The route patterns with a loader, in registration order.
pub fn registeredRouteStarters() -> string[] {
    return __jhRouteLoaders(globals.starters);
}

// The props the payload's `i` row carries for `name`, decoded; `[]` when the
// component has none.
pub fn propsFor(name: string) -> array<#(string, string)> {
    return propsOf(__jhClientPropsRaw(globals.payload, name));
}
