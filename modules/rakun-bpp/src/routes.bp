// rakun-bpp/routes — the UI file conventions (front 30 Step 10, decisions 114
// and 117).
//
// A folder under `app/` is a URL segment and a file in it gives the segment its
// UI. The file conventions that answer an `Element` are rakun-bpp's: the server
// registers only an opaque `PageRenderer` per route and names none of them.
// One decorator per file, taking the APP-RELATIVE DIRECTORY of the file it sits
// in (`@Decl` carries no source location):
//
//   | file in `app/` | decorator            | the function it accepts                                        |
//   |----------------|----------------------|----------------------------------------------------------------|
//   | `layout.bp`    | `#[layout(seg)]`     | `fn(props: LayoutProps) -> Component<Element>`   |
//   | `template.bp`  | `#[template(seg)]`   | `fn(props: LayoutProps) -> Component<Element>`   |
//   | `page.bp`      | `#[page(seg)]`       | `fn(route: PageContext) -> Component<Element>`   |
//   | `default.bp`   | `#[defaultView(seg)]`| `fn(props: LayoutProps) -> Element`                            |
//
// A layout, a template and a page are components (decision 117 rule 3): each
// may `await`, `use` a hook and raise a navigation signal. A function under
// `#[layout]`, `#[template]` or `#[page]` whose return is not
// `Component<Element>` is refused at compile time, naming the
// function and the form it needs; there is no plain-layout form (decision 67).
// `default` is a reserved keyword, so `default.bp`'s marker is `#[defaultView]`.
// `loading.bp`, `error.bp` and `not-found.bp` export an undecorated
// `Loading()` / `ErrorPage(info)` / `NotFound()`; rakun-ssr registers them with
// `jhLoading` / `jhError` / `jhNotFound` from the scan front 22 performs.
//
// Each decorator body records its segment as comptime meta (`seg`, decision
// 216) — the program's entry point registers every marked function from
// `@TypeInfo.all` with `jhRegisterRoutes` (below), no module registers itself
// at load — then each enforces placement with `compiler.fail`. A page reads its
// parameters at run time through `pageParams(route)` (below), against the
// pattern its segment registered — `routing`'s `parseSegment` / `kindName` say
// which segment binds a name and whether it is a list (front 102). `routing`
// owns the segment grammar; `test/routes_test.bp` round-trips `uiTable()`
// through its `parsePath`.
//
// The registration is a LAMBDA, never a bare function name: a named function
// used as a value lowers to an unbound erlang variable.
//
// The per-segment record the render composes — `UiSegment` — lives here too,
// beside the conventions it collects: `render.bp` imports it, and a
// `UiSegment` in `render.bp` would make this module and that one import each
// other.

import {element.Element, element.ElementBase};
import {router.pairValue};
import {error_boundary.ErrorInfo};
import {segment.kindName, segment.parsePath, segment.parseSegment, segment.patternOf, segment.slotOf, table.RouteEntry, table.writeTable} from "routing";
import {compiler, compiler.DeclKind, failure.panic} from "std";

// NO `query` FIELD. The query is per-request input, and reading it marks the
// render dynamic; a public field is a read nothing can intercept, so the only
// reader is front 26's `searchParams()` hook, which marks (`AGENTS.md` § *The
// `query` hole, closed*).
pub type PageContext(
    pathname: string,
    pattern: string,
    params: Array<#(string, string)>,
    rest: string[],
)

// One record rather than three parameters: a declared default is never
// applied, and a layout that uses no slot would otherwise spell an empty
// `slots:` at every call site the registry generates.
pub type LayoutProps(
    route: PageContext,
    children: Element,
    slots: Array<#(string, Element)>,
)

// ── the registry ────────────────────────────────────────────────────────────
//
// botopink has no top-level mutable state, so the registry lives in the host
// (`routes.mjs` / `sidecars/jhonstart_routes.erl`), holding each render
// FUNCTION beside its finished `kind|pattern|slot|verb` line. Neither host
// parses a segment or builds a line.

#[compiler.external(
    .JavaScript("require('./routes.mjs').registerPage($0, $1)"),
    .Erlang("jhonstart_routes:register_page($0, $1)"),
)]
pub declare fn jhRegisterPage(
    record: string,
    render: fn(route: PageContext) -> Component<Element>,
) -> i32;

#[compiler.external(
    .JavaScript("require('./routes.mjs').registerLayout($0, $1)"),
    .Erlang("jhonstart_routes:register_layout($0, $1)"),
)]
pub declare fn jhRegisterLayout(
    record: string,
    render: fn(props: LayoutProps) -> Component<Element>,
) -> i32;

#[compiler.external(
    .JavaScript("require('./routes.mjs').registerTemplate($0, $1)"),
    .Erlang("jhonstart_routes:register_template($0, $1)"),
)]
pub declare fn jhRegisterTemplate(
    record: string,
    render: fn(props: LayoutProps) -> Component<Element>,
) -> i32;

#[compiler.external(
    .JavaScript("require('./routes.mjs').registerDefault($0, $1)"),
    .Erlang("jhonstart_routes:register_default($0, $1)"),
)]
pub declare fn jhRegisterDefault(
    record: string,
    render: fn(props: LayoutProps) -> Element,
) -> i32;

#[compiler.external(
    .JavaScript("require('./routes.mjs').registerLoading($0, $1)"),
    .Erlang("jhonstart_routes:register_loading($0, $1)"),
)]
pub declare fn jhRegisterLoading(
    record: string,
    render: fn() -> Element,
) -> i32;

#[compiler.external(
    .JavaScript("require('./routes.mjs').registerError($0, $1)"),
    .Erlang("jhonstart_routes:register_error($0, $1)"),
)]
pub declare fn jhRegisterError(
    record: string,
    render: fn(info: ErrorInfo) -> Element,
) -> i32;

#[compiler.external(
    .JavaScript("require('./routes.mjs').registerNotFound($0, $1)"),
    .Erlang("jhonstart_routes:register_not_found($0, $1)"),
)]
pub declare fn jhRegisterNotFound(
    record: string,
    render: fn() -> Element,
) -> i32;

#[compiler.external(.JavaScript("require('./routes.mjs').table()"), .Erlang("jhonstart_routes:table()"))]
declare fn __jhRoutesTable() -> string;

// The stored function for a record, or `fallback` when nothing registered it.
#[compiler.external(.JavaScript("require('./routes.mjs').lookup($0, $1)"), .Erlang("jhonstart_routes:lookup($0, $1)"))]
declare fn __jhRoutesLookup<F>(record: string, fallback: F) -> F;

#[compiler.external(.JavaScript("require('./routes.mjs').has($0)"), .Erlang("jhonstart_routes:has($0)"))]
declare fn __jhRoutesHas(record: string) -> bool;

// The one place a kind and a segment become a wire line. It HALTS on a segment
// that may not be registered (`routing`'s `parsePath`), which is right for a
// module-load `val`: the program stops at load rather than serving something
// surprising.
pub fn entryLine(kind: string, seg: string) -> string {
    val segs = parsePath(seg);
    return writeTable(
        [
            RouteEntry(
                kind: kind,
                pattern: patternOf(segs),
                slot: slotOf(segs),
                verb: "",
            ),
        ],
    );
}

pub fn jhPage(
    seg: string,
    render: fn(route: PageContext) -> Component<Element>,
) -> i32 {
    return jhRegisterPage(entryLine("P", seg), render);
}

pub fn jhLayout(
    seg: string,
    render: fn(props: LayoutProps) -> Component<Element>,
) -> i32 {
    return jhRegisterLayout(entryLine("L", seg), render);
}

pub fn jhTemplate(
    seg: string,
    render: fn(props: LayoutProps) -> Component<Element>,
) -> i32 {
    return jhRegisterTemplate(entryLine("T", seg), render);
}

pub fn jhDefault(
    seg: string,
    render: fn(props: LayoutProps) -> Element,
) -> i32 {
    return jhRegisterDefault(entryLine("D", seg), render);
}

pub fn jhLoading(seg: string, render: fn() -> Element) -> i32 {
    return jhRegisterLoading(entryLine("S", seg), render);
}

pub fn jhError(seg: string, render: fn(info: ErrorInfo) -> Element) -> i32 {
    return jhRegisterError(entryLine("E", seg), render);
}

pub fn jhNotFound(seg: string, render: fn() -> Element) -> i32 {
    return jhRegisterNotFound(entryLine("N", seg), render);
}

// ── the reader: the four markers' declarations, registered ─────────────────
//
// A marker registers nothing itself (decision 216): it records its segment
// as meta (`seg`) and the program's entry point hands the catalogue in, once —
//
//     val __jhRoutes = jhRegisterRoutes(
//         @TypeInfo.all(with: page),
//         @TypeInfo.all(with: layout),
//         @TypeInfo.all(with: template),
//         @TypeInfo.all(with: defaultView),
//     );
//
// Layouts, then templates, then pages, then default views; inside each, the
// catalogue's order (module path, then declaration order). A declaration
// whose value is not the function its marker accepts, or that carries no
// `seg`, halts: the marker refused it already, so it cannot be one of the
// marker's.

fn segOf(d: Declared<unknown>) -> string {
    val recorded = d.meta(RouteSegment);
    if (recorded == null)
        panic(
            "rakun-bpp: `"
                + d.module
                + "."
                + d.name
                + "` carries no route segment",
        );
    return recorded.seg;
}

fn notMarked(d: Declared<unknown>, marker: string) -> i32 {
    panic(
        "rakun-bpp: `"
            + d.module
            + "."
            + d.name
            + "` is not the function #["
            + marker
            + "] accepts",
    );
}

pub fn jhRegisterRoutes(
    pages: Declared<unknown>[],
    layouts: Declared<unknown>[],
    templates: Declared<unknown>[],
    defaults: Declared<unknown>[],
) -> i32 {
    var n = 0;
    for (layouts) { d ->
        val v = d.value;
        val k = if (v is fn(props: LayoutProps) -> Component<Element>)
            jhLayout(segOf(d), { props -> v(props) })
        else
            notMarked(d, "layout");
        n = n + k;
    }
    for (templates) { d ->
        val v = d.value;
        val k = if (v is fn(props: LayoutProps) -> Component<Element>)
            jhTemplate(segOf(d), { props -> v(props) })
        else
            notMarked(d, "template");
        n = n + k;
    }
    for (pages) { d ->
        val v = d.value;
        val k = if (v is fn(route: PageContext) -> Component<Element>)
            jhPage(segOf(d), { route -> v(route) })
        else
            notMarked(d, "page");
        n = n + k;
    }
    for (defaults) { d ->
        val v = d.value;
        val k = if (v is fn(props: LayoutProps) -> Element)
            jhDefault(segOf(d), { props -> v(props) })
        else
            notMarked(d, "defaultView");
        n = n + k;
    }
    return n;
}

// This registry's records as contract-1 lines (`L`, `T`, `P`, `D`, `S`, `E`,
// `N`), in registration order — the blob rakun-ssr copies into the server's table, so
// the table the server matches and the payload's `t` are one table.
pub fn uiTable() -> string {
    return __jhRoutesTable();
}

// ── a page's parameters ─────────────────────────────────────────────────────

pub fn ctxParam(route: PageContext, name: string) -> string {
    return pairValue(route.params, name);
}

pub fn ctxRest(route: PageContext) -> string[] {
    return route.rest;
}

// `pageParams(route)` reads a page's parameters against its schema: the
// pattern `#[page]`'s segment registered (`route.pattern`, the bracket spelling
// kept). `get("slug")` answers what a `[slug]` segment binds and `list("slug")`
// what a `[...slug]` / `[[...slug]]` binds; a name the pattern does not bind
// that way halts, naming the pattern — the run-time half of what the page's
// former generated accessor checked by its type.
pub type PageParams(route: PageContext) {
    pub fn get(self: Self, name: string) -> string {
        if (bindsAs(self.route.pattern, name) != "Dynamic")
            panic(paramProblem(self.route.pattern, name, "[" + name + "]"));
        return pairValue(self.route.params, name);
    }

    pub fn list(self: Self, name: string) -> string[] {
        val k = bindsAs(self.route.pattern, name);
        if ((k != "CatchAll") && (k != "OptionalCatchAll"))
            panic(paramProblem(self.route.pattern, name, "[..." + name + "]"));
        return self.route.rest;
    }
}

pub fn pageParams(route: PageContext) -> PageParams {
    return PageParams(route: route);
}

// The kind of the capturing segment of `pattern` that binds `name`, or `""`.
fn bindsAs(pattern: string, name: string) -> string {
    var kind = "";
    for (pattern.split("/")) { raw ->
        val s = parseSegment(raw);
        val k = kindName(s.kind);
        val capturing = (k == "Dynamic")
            || (k == "CatchAll")
            || (k == "OptionalCatchAll");
        if ((s.name == name) && capturing) kind = k;
    }
    return kind;
}

fn paramProblem(pattern: string, name: string, wanted: string) -> string {
    return "rakun-bpp: the page at `"
        + pattern
        + "` has no "
        + wanted
        + " segment - `"
        + name
        + "` is not one of its parameters";
}

// ── the four markers ────────────────────────────────────────────────────────
//
// `decl.returnType` is the return type as the source spells it:
// `-> Component<Element>` reflects as
// `"Component<Element>"`, `-> Async<Element>` as
// `"Async<Element>"`, `-> Element` as `"Element"`. The required spelling is in
// the message.

// What `#[page]`, `#[layout]`, `#[template]` and `#[defaultView]` record: the route segment, read
// `d.meta(RouteSegment)?.seg`.
pub type RouteSegment(seg: string)

pub fn page(syntax decl: unknown, comptime seg: string) {
    compiler.setMeta(RouteSegment(seg: seg));
    if (compiler.kind(decl) != DeclKind.Fn)
        compiler.fail("#[page] must annotate a function", at: decl);
    if (compiler.returnType(decl) != "Component<Element>")
        compiler.fail(
            "#[page] on `"
                + compiler.name(decl)!
                + "`: a page is `fn "
                + compiler.name(decl)!
                + "(route: PageContext) -> Component<Element>`, not `"
                + compiler.returnType(decl)
                + "`",
            at: decl,
        );
}

pub fn layout(syntax decl: unknown, comptime seg: string) {
    compiler.setMeta(RouteSegment(seg: seg));
    if (compiler.kind(decl) != DeclKind.Fn)
        compiler.fail("#[layout] must annotate a function", at: decl);
    if (compiler.returnType(decl) != "Component<Element>")
        compiler.fail(
            "#[layout] on `"
                + compiler.name(decl)!
                + "`: a layout is `fn "
                + compiler.name(decl)!
                + "(props: LayoutProps) -> Component<Element>`, not `"
                + compiler.returnType(decl)
                + "`",
            at: decl,
        );
}

pub fn template(syntax decl: unknown, comptime seg: string) {
    compiler.setMeta(RouteSegment(seg: seg));
    if (compiler.kind(decl) != DeclKind.Fn)
        compiler.fail("#[template] must annotate a function", at: decl);
    if (compiler.returnType(decl) != "Component<Element>")
        compiler.fail(
            "#[template] on `"
                + compiler.name(decl)!
                + "`: a template is `fn "
                + compiler.name(decl)!
                + "(props: LayoutProps) -> Component<Element>`, not `"
                + compiler.returnType(decl)
                + "`",
            at: decl,
        );
}

pub fn defaultView(syntax decl: unknown, comptime seg: string) {
    compiler.setMeta(RouteSegment(seg: seg));
    if (compiler.kind(decl) != DeclKind.Fn)
        compiler.fail("#[defaultView] must annotate a function", at: decl);
    if (compiler.returnType(decl) != "Element")
        compiler.fail(
            "#[defaultView] on `"
                + compiler.name(decl)!
                + "`: a default view is `fn "
                + compiler.name(decl)!
                + "(props: LayoutProps) -> Element`, not `"
                + compiler.returnType(decl)
                + "`",
            at: decl,
        );
}

// ── `UiSegment` — one segment's conventions, for `compose` ────────────────────
//
// No optionals: a convention the segment lacks is `has<X> == false` and an
// inert function. rakun-ssr builds the chain root-first from `routing`'s
// `layoutChain` and this registry (`segmentFor(pattern)`); a test builds it
// with `segment(pattern)` and the `with*` refiners.

pub type UiSegment(
    pattern: string,
    hasLayout: bool,
    layoutView: fn(props: LayoutProps) -> Component<Element>,
    hasTemplate: bool,
    templateView: fn(props: LayoutProps) -> Component<Element>,
    hasError: bool,
    errorView: fn(info: ErrorInfo) -> Element,
    hasLoading: bool,
    loadingView: fn() -> Element,
    hasNotFound: bool,
    notFoundView: fn() -> Element,
)

component fn passThrough(props: LayoutProps) -> Component<Element> {
    return props.children;
}

fn emptyTree() -> Element {
    return Element(tag: "#fragment", value: "", children: [], attrs: []);
}

fn emptyErrorView(info: ErrorInfo) -> Element {
    return emptyTree();
}

pub fn segment(pattern: string) -> UiSegment {
    return UiSegment(
        pattern: pattern,
        hasLayout: false,
        layoutView: { props -> passThrough(props) },
        hasTemplate: false,
        templateView: { props -> passThrough(props) },
        hasError: false,
        errorView: { info -> emptyErrorView(info) },
        hasLoading: false,
        loadingView: { -> emptyTree() },
        hasNotFound: false,
        notFoundView: { -> emptyTree() },
    );
}

pub fn withLayout(
    s: UiSegment,
    f: fn(props: LayoutProps) -> Component<Element>,
) -> UiSegment {
    return UiSegment(
        pattern: s.pattern,
        hasLayout: true,
        layoutView: f,
        hasTemplate: s.hasTemplate,
        templateView: s.templateView,
        hasError: s.hasError,
        errorView: s.errorView,
        hasLoading: s.hasLoading,
        loadingView: s.loadingView,
        hasNotFound: s.hasNotFound,
        notFoundView: s.notFoundView,
    );
}

pub fn withTemplate(
    s: UiSegment,
    f: fn(props: LayoutProps) -> Component<Element>,
) -> UiSegment {
    return UiSegment(
        pattern: s.pattern,
        hasLayout: s.hasLayout,
        layoutView: s.layoutView,
        hasTemplate: true,
        templateView: f,
        hasError: s.hasError,
        errorView: s.errorView,
        hasLoading: s.hasLoading,
        loadingView: s.loadingView,
        hasNotFound: s.hasNotFound,
        notFoundView: s.notFoundView,
    );
}

pub fn withError(s: UiSegment, f: fn(info: ErrorInfo) -> Element) -> UiSegment {
    return UiSegment(
        pattern: s.pattern,
        hasLayout: s.hasLayout,
        layoutView: s.layoutView,
        hasTemplate: s.hasTemplate,
        templateView: s.templateView,
        hasError: true,
        errorView: f,
        hasLoading: s.hasLoading,
        loadingView: s.loadingView,
        hasNotFound: s.hasNotFound,
        notFoundView: s.notFoundView,
    );
}

pub fn withLoading(s: UiSegment, f: fn() -> Element) -> UiSegment {
    return UiSegment(
        pattern: s.pattern,
        hasLayout: s.hasLayout,
        layoutView: s.layoutView,
        hasTemplate: s.hasTemplate,
        templateView: s.templateView,
        hasError: s.hasError,
        errorView: s.errorView,
        hasLoading: true,
        loadingView: f,
        hasNotFound: s.hasNotFound,
        notFoundView: s.notFoundView,
    );
}

pub fn withNotFound(s: UiSegment, f: fn() -> Element) -> UiSegment {
    return UiSegment(
        pattern: s.pattern,
        hasLayout: s.hasLayout,
        layoutView: s.layoutView,
        hasTemplate: s.hasTemplate,
        templateView: s.templateView,
        hasError: s.hasError,
        errorView: s.errorView,
        hasLoading: s.hasLoading,
        loadingView: s.loadingView,
        hasNotFound: true,
        notFoundView: f,
    );
}

// The segment at `pattern` as the registry holds it: every convention
// registered for that pattern, the rest absent.
pub fn segmentFor(pattern: string) -> UiSegment {
    var s = segment(pattern);
    val layoutLine = lineFor("L", pattern);
    if (__jhRoutesHas(layoutLine))
        s = withLayout(s, __jhRoutesLookup(layoutLine, s.layoutView));
    val templateLine = lineFor("T", pattern);
    if (__jhRoutesHas(templateLine))
        s = withTemplate(s, __jhRoutesLookup(templateLine, s.templateView));
    val errorLine = lineFor("E", pattern);
    if (__jhRoutesHas(errorLine))
        s = withError(s, __jhRoutesLookup(errorLine, s.errorView));
    val loadingLine = lineFor("S", pattern);
    if (__jhRoutesHas(loadingLine))
        s = withLoading(s, __jhRoutesLookup(loadingLine, s.loadingView));
    val notFoundLine = lineFor("N", pattern);
    if (__jhRoutesHas(notFoundLine))
        s = withNotFound(s, __jhRoutesLookup(notFoundLine, s.notFoundView));
    return s;
}

// The page registered at `pattern`, or `fallback`.
pub fn pageFor(
    pattern: string,
    fallback: fn(route: PageContext) -> Component<Element>,
) -> fn(route: PageContext) -> Component<Element> {
    return __jhRoutesLookup(lineFor("P", pattern), fallback);
}

fn lineFor(kind: string, pattern: string) -> string {
    return writeTable(
        [RouteEntry(kind: kind, pattern: pattern, slot: "", verb: "")],
    );
}
