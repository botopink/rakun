// rakun-bpp/globals — the browser globals two builds must agree on without
// exchanging anything (front 30, decisions 113, 115 and 117; front 29).
//
// A global is a value the HTML names by text, or a table the client entry and
// the core's hydrate point share across two builds, and there are four: the
// payload variable, the fill function a fill's `<script>` calls, the signal
// function a late navigation signal's `<script>` calls, and the island starter
// table `registerStarter` fills and `hydrate()` reads (front 29; rakun-ssr front
// 68's entry writes no `__` name of its own). Each gets an indexed alias
// `__bp<N>` from this registry, `N` counting in DECLARATION ORDER below. No
// alias is spelled by hand anywhere else: adding a global is one registry
// entry, appended, so the earlier numbers never move.
//
// The four are the fields of one module-level `pub val globals` — read as
// `globals.payload`, `globals.fill`, `globals.signal`, `globals.starters`.
// One record rather than flat `pub val`s named `payload` / `fill` / …, which
// would shadow front 26's `fill` in a consumer's flat `import {…} from
// "rakun-bpp"`.

// The browser half is three cells over `render.mjs`, called only by rakun-ssr front
// 68's generated entry: the payload script's JSON text (decoded here with
// std's `json.decode`, decision 117 rule 7), and the registration of the fill
// and signal functions. Each has an erlang twin that answers the empty value —
// a called node-only cell reds the erlang compile of the core member, and on
// the server there is no DOM to register into.

import {json.Json, json.decode, compiler} from "std";

val registry = ["payload", "fill", "signal", "starters"];

// `"__bp"` + the name's index in the registry. An unknown name fails.
pub fn alias(name: string) -> string {
    var found = 0 - 1;
    var i = 0;
    for entry in registry {
        if (entry == name) found = i;
        i = i + 1;
    }
    assert found >= 0, "rakun-bpp: globals: `"
        + name
        + "` is not a registered global - the registry is payload, fill, signal, starters";
    return "__bp" + found.toString();
}

pub type Globals(payload: string, fill: string, signal: string, starters: string)

pub val globals = Globals(
    payload: alias("payload"),
    fill: alias("fill"),
    signal: alias("signal"),
    starters: alias("starters"),
);

// The payload script's JSON text: everything after `window.<name> = ` in the
// last payload script, `""` when there is none (and always `""` on the server).
#[compiler.external(.JavaScript("require('./render.mjs').payloadText($0)"), .Erlang("jhonstart_render:payload_text($0)"))]
declare fn __jhPayloadText(name: string) -> string;

// Registers the fill function under `name` (`globals.fill`), with the holes
// still open when the shell flushed (the payload's `h`).
#[compiler.external(
    .JavaScript("require('./render.mjs').registerFill($0, $1)"),
    .Erlang("jhonstart_render:register_fill($0, $1)"),
)]
declare fn __jhRegisterFill(name: string, holes: string[]) -> i32;

// Registers the signal function under `name` (`globals.signal`), checking a
// late redirect against the same `allowedRedirects` list `app(…)` got.
#[compiler.external(
    .JavaScript("require('./render.mjs').registerSignal($0, $1)"),
    .Erlang("jhonstart_render:register_signal($0, $1)"),
)]
declare fn __jhRegisterSignal(name: string, allowedRedirects: string[]) -> i32;

// The payload the render assigned, decoded with std's `json.decode`. A text
// `json.decode` refuses is an `Error` — never a partial payload.
pub fn readPayload(name: string) -> Result<Json, string> {
    return try decode(__jhPayloadText(name));
}

pub fn registerFill(name: string, holes: string[]) -> i32 {
    return __jhRegisterFill(name, holes);
}

pub fn registerSignal(name: string, allowedRedirects: string[]) -> i32 {
    return __jhRegisterSignal(name, allowedRedirects);
}
