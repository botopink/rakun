//// rakun-bpp/assert_island — the payload `i` rows and the placeholders (front 29).

import {client.Island, client.islandEntry, client.clientMount, element.renderToString};
import {assertAs} from "snap";

// `--- payload i`, one `<id> <component> <props>` line per island (the
// `islandEntry` tuple, space-joined), then `--- markup` and each island's
// placeholder.
pub fn clientBundleEntryText(islands: Array<Island>) -> string {
    var lines: string[] = ["--- payload i"];
    for (islands) { island ->
        val row = islandEntry(island);
        lines.push(row._0 + " " + row._1 + " " + row._2);
    }
    lines.push("--- markup");
    for (islands) { island ->
        lines.push(renderToString(clientMount(island, [])));
    }
    return lines.join("\n");
}

pub fn assertClientBundleEntry(loc: SourceLocation, islands: Array<Island>) -> @Result<void, string> {
    try assertAs(loc, "island", clientBundleEntryText(islands));
    return;
}
