//// rakun-bpp/assert_form — a form, an action state and an optimistic fold
//// (front 67).

import {element.Element};
import {forms.form.applyOptimistic};
import {state.ActionState} from "actions";
import {testing.assert_html.htmlLinesText};
import {assertAs} from "snap";

// `ok`, `message` and `redirectTo`, then one `f.<name>: <message>` line per
// field message.
pub fn actionStateText(s: ActionState) -> string {
    var lines: string[] = [
        "ok: " + s.ok.toString(),
        "message: " + s.message,
        "redirectTo: " + s.redirectTo,
    ];
    for (s.fields) { f ->
        lines.push("f." + f._0 + ": " + f._1);
    }
    return lines.join("\n");
}

fn plus(current: i32, action: i32) -> i32 {
    return current + action;
}

// `base`, `actions` (space-joined) and `value` — `applyOptimistic` with `+`.
pub fn optimisticText(base: i32, actions: i32[]) -> string {
    val value = applyOptimistic(base, actions, { c, a -> plus(c, a) });
    val lines: string[] = [
        "base: " + base.toString(),
        "actions: " + actions.map({ a -> a.toString() }).join(" "),
        "value: " + value.toString(),
    ];
    return lines.join("\n");
}

pub fn assertForm(loc: SourceLocation, f: Element) -> @Result<void, string> {
    try assertAs(loc, "form", htmlLinesText(f));
    return;
}

pub fn assertActionState(loc: SourceLocation, s: ActionState) -> @Result<void, string> {
    try assertAs(loc, "action-state", actionStateText(s));
    return;
}

pub fn assertOptimistic(loc: SourceLocation, base: i32, actions: i32[]) -> @Result<void, string> {
    try assertAs(loc, "optimistic", optimisticText(base, actions));
    return;
}
