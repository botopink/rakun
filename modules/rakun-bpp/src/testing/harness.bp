//// rakun-bpp/harness — fixtures and the render harness (fronts 94, 26,
//// 27, 28, 30, 67).
////
//// Fixtures build the values a test hands to rakun-bpp (`fixtureRouter`,
//// `fixtureRequest`, `fixturePageOver`, `stubEnvelope`); the harness runs the
//// pure halves a test snapshots (`renderToStream`, `simulateNavigation`) and
//// front 30's render over a recording `Response` (`renderStreamCollect`,
//// `renderRecorded`). Nothing from std is re-exported: a value already rendered
//// to a string is snapshotted with `snap`'s `assertText`.

import {element.Element, element.ElementBase, element.p, element.text, router.RouterState, server.RequestData, suspense.Boundary, suspense.Suspense, suspense.holeId};
import {streaming.Chunk, streaming.resolve, streaming.fillHtml, render.shellHtml, streaming.Response, streaming.PageInput, streaming.App};
import {link.reconcile.layoutKeys, link.reconcile.sharedDepth};
import {envelope.ActionEnvelope, envelope.writeEnvelope} from "actions";
import {navigation.NavKind, navigation.NavOutcome, navigation.signalToWire} from "routing";
import {encoding, compiler} from "std";
import {} from "snap";

// ── fixtures ────────────────────────────────────────────────────────────────

// A `RouterState` from querystring-encoded params and search, at depth 0.
pub fn fixtureRouter(path: string, pattern: string, params: string, search: string) -> RouterState {
    return RouterState(path: path, params: encoding.formParse(params), search: encoding.formParse(search), pattern: pattern, selected: 0);
}

// A `RequestData` from querystring-encoded pair lists — the value rakun-ssr builds
// from rakun's `Request`. Every list but the method and the path defaults to
// empty, so `fixtureRequest("GET", "/blog")` is a bare request.
pub fn fixtureRequest(method: string, path: string, params: string = "", query: string = "", headers: string = "", cookies: string = "") -> RequestData {
    return RequestData(
        method: method,
        path: path,
        params: encoding.formParse(params),
        query: encoding.formParse(query),
        headers: encoding.formParse(headers),
        cookies: encoding.formParse(cookies),
    );
}

// The fallback `fixturePageOver`'s boundary shows.
pub fn loadingFallback() -> Element {
    return p([text("Loading…")]);
}

component fn pageOver(shell: Element, child: fn() -> Component<Element>) -> Component<Element> {
    val hole = Suspense(Boundary(id: holeId(1), fallback: loadingFallback(), child: child));
    val kids = shell.children.append([hole]);
    return Element(tag: shell.tag, value: shell.value, children: kids, attrs: shell.attrs);
}

// A `PageInput` for `path` with no layout: the page is `shell` with one
// boundary (`h1`, `loadingFallback()`) over `child` appended to its children;
// build id `build-0001`, the table the one page.
pub fn fixturePageOver(path: string, shell: Element, child: fn() -> Component<Element>) -> PageInput {
    return PageInput(
        build: "build-0001",
        pathname: path,
        pattern: path,
        params: "",
        query: "",
        table: "P|" + path,
        actions: [],
        chain: [],
        page: { -> pageOver(shell, child) },
        metadata: [],
        viewports: [],
    );
}

// The JSON envelope `__jhFormSubmit` answers, written with `actions`'
// `writeEnvelope`; a non-empty `redirect` is the `n` signal wire.
pub fn stubEnvelope(ok: bool, state: string, redirect: string) -> string {
    val n = if (redirect == "")
        ""
    else
        signalToWire(NavOutcome(kind: NavKind.Redirect, location: redirect, status: 307));
    return writeEnvelope(ActionEnvelope(ok: ok, state: state, revalidated: [], n: n, payload: ""));
}

// ── the pure harness ────────────────────────────────────────────────────────

// The shell, then one fill per boundary in DECLARATION order — a harness has
// no scheduler; front 30's completion order is its own test.
pub async fn renderToStream(shell: Element, boundaries: Array<Boundary>) -> Async<Array<string>> {
    var chunks: Array<string> = [shellHtml(shell)];
    for (boundaries) { b ->
        val c = await resolve(b);
        chunks = chunks.append([fillHtml(c, "")]);
    }
    return chunks;
}

// A client transition's remount decision, from the two routes' layout keys.
pub type Navigation(fromKeys: Array<string>, toKeys: Array<string>, shared: i32, keep: Array<string>, remount: Array<string>)

// (`from` is a keyword, so the two routes are `current` and `target`.)
pub fn simulateNavigation(current: RouterState, target: RouterState) -> Navigation {
    val fromKeys = layoutKeys(current.segments());
    val toKeys = layoutKeys(target.segments());
    val shared = sharedDepth(fromKeys, toKeys);
    return Navigation(fromKeys: fromKeys, toKeys: toKeys, shared: shared, keep: toKeys.slice(0, shared), remount: toKeys.slice(shared, toKeys.length));
}

// ── the render over a recording `Response` ──────────────────────────────────
//
// The recording is test-process state (`put`/`get` on erlang, a `globalThis`
// entry on node): the render writes from its own process, which is the test's.

#[compiler.external(
    .JavaScript("""(globalThis.jhonstartTestRecording = { status: 0, headers: [], chunks: [], closed: 0 }, 0)"""),
    .Erlang("""(fun() -> put(jhonstart_test_recording, {0, [], [], 0}), 0 end)()"""),
)]
declare fn recordingReset() -> i32;

#[compiler.external(
    .JavaScript("""(globalThis.jhonstartTestRecording.status = $0, 0)"""),
    .Erlang("""(fun(__C) -> {_, __H, __W, __X} = get(jhonstart_test_recording), put(jhonstart_test_recording, {__C, __H, __W, __X}), 0 end)($0)"""),
)]
declare fn recordStatus(code: i32) -> i32;

#[compiler.external(
    .JavaScript("""(globalThis.jhonstartTestRecording.headers.push($0 + ": " + $1), 0)"""),
    .Erlang("""(fun(__N, __V) -> {__S, __H, __W, __X} = get(jhonstart_test_recording), put(jhonstart_test_recording, {__S, __H ++ [<<__N/binary, ": ", __V/binary>>], __W, __X}), 0 end)($0, $1)"""),
)]
declare fn recordHeader(name: string, value: string) -> i32;

#[compiler.external(
    .JavaScript("""(globalThis.jhonstartTestRecording.chunks.push($0), 0)"""),
    .Erlang("""(fun(__C) -> {__S, __H, __W, __X} = get(jhonstart_test_recording), put(jhonstart_test_recording, {__S, __H, __W ++ [__C], __X}), 0 end)($0)"""),
)]
declare fn recordChunk(chunk: string) -> i32;

#[compiler.external(
    .JavaScript("""(globalThis.jhonstartTestRecording.closed += 1, 0)"""),
    .Erlang("""(fun() -> {__S, __H, __W, __X} = get(jhonstart_test_recording), put(jhonstart_test_recording, {__S, __H, __W, __X + 1}), 0 end)()"""),
)]
declare fn recordClose() -> i32;

#[compiler.external(
    .JavaScript("""globalThis.jhonstartTestRecording.status"""),
    .Erlang("""(fun() -> element(1, get(jhonstart_test_recording)) end)()"""),
)]
declare fn recordedStatus() -> i32;

#[compiler.external(
    .JavaScript("""globalThis.jhonstartTestRecording.headers"""),
    .Erlang("""(fun() -> element(2, get(jhonstart_test_recording)) end)()"""),
)]
declare fn recordedHeaders() -> Array<string>;

#[compiler.external(
    .JavaScript("""globalThis.jhonstartTestRecording.chunks"""),
    .Erlang("""(fun() -> element(3, get(jhonstart_test_recording)) end)()"""),
)]
declare fn recordedChunks() -> Array<string>;

#[compiler.external(
    .JavaScript("""globalThis.jhonstartTestRecording.closed"""),
    .Erlang("""(fun() -> element(4, get(jhonstart_test_recording)) end)()"""),
)]
declare fn recordedCloses() -> i32;

fn onStatus(code: i32) -> void {
    recordStatus(code);
}

fn onHeader(name: string, value: string) -> void {
    recordHeader(name, value);
}

async fn onWrite(chunk: string) -> Async<void> {
    recordChunk(chunk);
}

async fn onClose() -> Async<void> {
    recordClose();
}

// A fresh recording `Response`.
pub fn recordingResponse() -> Response {
    recordingReset();
    return Response(
        status: { code -> onStatus(code) },
        header: { name, value -> onHeader(name, value) },
        write: { chunk -> onWrite(chunk) },
        close: { -> onClose() },
    );
}

// What a recording `Response` received: the status (200 when never set, the
// render's default), each header as `name: value`, the chunks in `write`
// order, and how many times it was closed.
pub type RecordedResponse(status: i32, headers: Array<string>, chunks: Array<string>, closed: i32)

pub fn recorded() -> RecordedResponse {
    val code = recordedStatus();
    val status = if (code == 0) 200 else code;
    return RecordedResponse(status: status, headers: recordedHeaders(), chunks: recordedChunks(), closed: recordedCloses());
}

// `render` (`streaming == false`) or `renderStream` over a recording
// `Response`; the render's own outcome is dropped — a failure shows in the
// recording (no status, no chunk, one close).
fn renderOver(a: App, input: PageInput, req: RequestData, res: Response, streaming: bool) -> Async<Result<void, string>> {
    if (streaming) return a.renderStream(input, req, res);
    return a.render(input, req, res);
}

pub async fn renderRecorded(a: App, input: PageInput, req: RequestData, streaming: bool) -> Async<RecordedResponse> {
    val res = recordingResponse();
    val outcome = await renderOver(a, input, req, res, streaming);
    return recorded();
}

// `renderStream` over a recording `Response`: the chunks in the order `write`
// received them.
pub async fn renderStreamCollect(a: App, input: PageInput, req: RequestData) -> Async<Array<string>> {
    val r = await renderRecorded(a, input, req, true);
    return r.chunks;
}
