//// The `rakun-bpp` package — module-tree root.
////
//// The test-helper member every library carries (front 95,
//// `specs/1.0.10-beta/02-packaging/README.md` § 5): `assert<Subject>(loc, …)
//// -> @Result<void, string>` helpers, fixtures and builders that know
//// rakun-bpp's types, standing on `snap`
//// (`specs/1.0.10-beta/04-jhonstart/modules.md` § 5, `test-snap.md` § 0.2).
//// Every helper has a pure `<subject>Text` twin — the text it snapshots — so a
//// plain `assert` can read the same text. A consumer adds
//// `"rakun-bpp"` to its dependencies; it never reaches into the core's
//// own `test/`. Nothing from std is re-exported, and mocking is std's
//// (decision 71) — this member keeps only the injection pairing.

pub mod harness; // fronts 94, 26, 27, 28, 30, 67
pub mod assert_html; // front 94
pub mod assert_route; // front 26
pub mod assert_link; // front 27
pub mod assert_server; // front 28
pub mod assert_island; // front 29
pub mod assert_stream; // front 30
pub mod assert_render; // front 30
pub mod assert_error_boundary; // front 31
pub mod assert_metadata; // front 32
pub mod assert_form; // front 67

import {element.renderToString, element.div, element.text};

test "rakun-bpp: the core member resolves from the test member" {
    assert renderToString(div([text("ok")])) == "<div>ok</div>";
}
