//// rakun-bpp/styled_sheet — the render's `styled` sheet and the
//// `StyledContext` the render provides at its root (decisions 352, 354 (7),
//// 361; front 119 step 1).
////
//// A `styled` component computed at render reads `use
//// context(StyledSheet)` and hands its class and rules to the sheet's
//// writer; `compose` (`render.bp`), the root of every page render, provides
//// `renderSheet()`, so a page's components write to this render's sheet. The
//// sheet is a `styled` `Sheet` value kept in the per-render state
//// (`render.mjs` / `sidecars/jhonstart_render.erl`), reset with the rest of
//// it: a component already in it is not added again, so one rendered twenty
//// times is written once. `styled` holds no store; this module is the store.
////
//// Taken from front 119 step 2 only as far as step 1 needs it: the layer
//// (`styled`, the class prefix `s_`) and `renderedStyles()`, the sheet as
//// text. The sink that writes it into the head and each boundary fill, the
//// order after a CSS library's own layers and payload key `s` are step 2,
//// 3 and 5's.
////
//// `renderedStyles()` resolves `Sheet.render()` in the CALLER's scope, never
//// a fresh `Scope.root()` (decisions 969, 809; mt-0410): a `component fn`
//// keeping its own cell, the same device `suspense.bp`'s `Suspense` fix
//// (c01f4a3f) uses — `val myScope = use selfScope;` sees every provider
//// above THIS call's own placement. Plain code (a `test {}` block, a
//// top-level `fn`, where `use` is refused) calls `renderedStylesAt(scope)`
//// instead, passing the scope it already holds — never opening a new root.

import {StyledSheet, Styled, Styleable, Sheet, layer} from "rakun-style";
import {compiler, context.Scope, context.run} from "std";

// The ambient scope a body currently stands in (809 (8) case B): `suspense.bp`
// and `render.bp` each keep an identical `val selfScope`, duplicated rather
// than imported — every one of the three modules is a different point in the
// dependency order, and `selfScope` is not `pub` in either of the other two.
val selfScope: Component<Scope> = { scope, key -> scope };

#[compiler.external(.JavaScript("require('./render.mjs').styledSheet($0)"), .Erlang("jhonstart_render:styled_sheet($0)"))]
declare fn __jhStyledSheet(fallback: Sheet) -> Sheet;

#[compiler.external(
    .JavaScript("require('./render.mjs').setStyledSheet($0)"),
    .Erlang("jhonstart_render:set_styled_sheet($0)"),
)]
declare fn __jhSetStyledSheet(s: Sheet) -> i32;

// The layer a render's `styled` components are written to.
pub fn styledLayer() -> string {
    return "styled";
}

fn emptySheet() -> Sheet {
    return Sheet.of([layer(styledLayer())]);
}

// The sheet's writer: `item` in `layerName`, once.
fn addToRender(layerName: string, item: Styled) -> void {
    val _n = __jhSetStyledSheet(
        __jhStyledSheet(emptySheet()).add(layerName, item),
    );
}

// What the render provides as `StyledContext`.
pub fn renderSheet() -> StyledSheet {
    return StyledSheet(layer: styledLayer(), add: addToRender);
}

// This render's sheet as text: `@layer styled{…}`, `""` when nothing was
// registered. `Sheet.render` resolves its entries under one `use all`
// (decision 969), so reading it crosses an `await` now. `component fn` so
// `use renderedStyles()` sees every provider above THIS call's own
// placement (mt-0410) — never a fresh, disconnected `Scope.root()`.
pub component fn renderedStyles() -> Component<string> {
    val myScope = use selfScope;
    val s = await run(__jhStyledSheet(emptySheet()).render(), myScope);
    return s;
}

// The plain-code form of `renderedStyles()`: no render tree stands where
// `use` is refused (a `test {}` block, a top-level `fn`), so the caller
// hands its own scope through instead — never a fresh root (mt-0410).
pub async fn renderedStylesAt(scope: Scope) -> Async<string> {
    val s = await run(__jhStyledSheet(emptySheet()).render(), scope);
    return s;
}
