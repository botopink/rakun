// rakun-bpp/render — the escaping walker, composition, the document and the
// payload (front 30, decisions 113, 114, 116 and 117).
//
// rakun-bpp writes the HTML. `renderToString` (`element.bp`, frozen) escapes
// nothing and closes void tags; everything this front writes goes through
// `renderNode` instead, which differs in four places:
//
//   | node                         | `renderToString`  | `renderNode`                               |
//   |------------------------------|-------------------|--------------------------------------------|
//   | `#text`                      | verbatim          | `escape.html(value)` (std)                 |
//   | text inside `script`/`style` | verbatim          | verbatim; `</script` / `</style` REFUSED   |
//   | attribute                    | verbatim          | `escape.attribute(value)` (std)            |
//   | a void tag                   | `<input></input>` | `<input …>`, no closing tag                |
//   | `#raw`                       | `<#raw>…`         | `value` verbatim — the one escape hatch    |
//
// `isVoidTag` and `isRawTextTag` are front 94's and are called, never restated.
// A raw-text body is emitted verbatim because escaping CSS or a script changes
// the program; the one sequence that can close the element early is refused,
// case-insensitive, and no flag turns the refusal into escaping (decision 67).
//
// ── Composition ─────────────────────────────────────────────────────────────
//
// `compose(chain, route, page)` wraps the page per segment, root-first:
// `layout > template > error > loading > not-found > page`. The layouts RUN
// FIRST — each is called with a `#children` placeholder and the inner tree is
// substituted afterwards — so a layout that raises a navigation signal means
// the page's function is never called. Each layout render receives its
// `selected` depth (root `0`) through front 26's route snapshot. A `template`
// wrapper carries `data-jh-t="<pattern>#<nav>"`, a fresh key per render. A
// segment with `loading` turns everything below it into a streamed boundary
// (`Suspense`); a segment with `error` catches below it; a segment with
// `not-found` wraps below it in `data-jh-n` and is the nearest not-found tree a
// not-found signal from below renders.
//
// ── The payload — contract 2 ────────────────────────────────────────────────
//
// One executable script, last in `<body>` before `RenderHooks.bodyExtra`,
// assigning `globals.payload`. The JSON is written with std's `json.quote` /
// `json.arrayOf` / `json.object` and the finished text passes through
// `escape.scriptJson`, so `</script` is unrepresentable inside the block; this
// file keeps no JSON writer and no escaper of its own (decision 116). `t`, `a`
// and `b` are written verbatim from the strings rakun-ssr handed in; plugin keys
// (`s` is the CSS bridge member's) are written verbatim under their key.

import {element.Element, element.ElementBase};
import {elements.isVoidTag, elements.isRawTextTag};
import {escape, json.quote, json.arrayOf, json.object, encoding, failure, compiler, failure.panic} from "std";
import {router.fill, router.snapshot};
import {client.islandId, client.islandAttr, client.Island, client.clientMount, client.islandEntry};
import {error_boundary.ErrorInfo, error_boundary.infoFor, error_boundary.isSignal, error_boundary.notFoundReason, error_boundary.wrap};
import {suspense.Boundary, suspense.Suspense, suspense.holeId};
import {globals.globals};
import {plugin.Json as PayloadJson};
import {routes.PageContext, routes.LayoutProps, routes.UiSegment, routes.segment};
import {styled_sheet.renderSheet};
import {context.createContext, context.provide, context.Scope, context.run} from "std";

// ── the per-render state (render.mjs / sidecars/jhonstart_render.erl) ───────

#[compiler.external(.JavaScript("require('./render.mjs').stateReset()"), .Erlang("jhonstart_render:state_reset()"))]
pub declare fn __jhStateReset() -> i32;

#[compiler.external(.JavaScript("require('./render.mjs').takeBoundaries()"), .Erlang("jhonstart_render:take_boundaries()"))]
pub declare fn __jhTakeBoundaries() -> array<Boundary>;

#[compiler.external(
    .JavaScript("require('./render.mjs').nextIslandOrdinal()"),
    .Erlang("jhonstart_render:next_island_ordinal()"),
)]
declare fn __jhNextIslandOrdinal() -> i32;

#[compiler.external(.JavaScript("require('./render.mjs').pushIsland($0)"), .Erlang("jhonstart_render:push_island($0)"))]
declare fn __jhPushIsland(row: #(string, string, string)) -> i32;

#[compiler.external(.JavaScript("require('./render.mjs').islands()"), .Erlang("jhonstart_render:islands()"))]
pub declare fn __jhIslands() -> array<#(string, string, string)>;

#[compiler.external(
    .JavaScript("require('./render.mjs').setIslandBase($0)"),
    .Erlang("jhonstart_render:set_island_base($0)"),
)]
pub declare fn __jhSetIslandBase(n: i32) -> i32;

#[compiler.external(
    .JavaScript("require('./render.mjs').stashNotFound($0)"),
    .Erlang("jhonstart_render:stash_not_found($0)"),
)]
declare fn __jhStashNotFound(e: Element) -> i32;

#[compiler.external(
    .JavaScript("require('./render.mjs').stashedNotFound($0)"),
    .Erlang("jhonstart_render:stashed_not_found($0)"),
)]
pub declare fn __jhStashedNotFound(fallback: Element) -> Element;

#[compiler.external(.JavaScript("require('./render.mjs').nextNav()"), .Erlang("jhonstart_render:next_nav()"))]
declare fn __jhNextNav() -> i32;

#[compiler.external(.JavaScript("require('./render.mjs').setHooks($0)"), .Erlang("jhonstart_render:set_hooks($0)"))]
declare fn __jhSetHooks(h: RenderHooks) -> void;

#[compiler.external(.JavaScript("require('./render.mjs').hooks($0)"), .Erlang("jhonstart_render:hooks($0)"))]
declare fn __jhHooks(fallback: RenderHooks) -> RenderHooks;

#[compiler.external(.JavaScript("require('./render.mjs').pushNode($0)"), .Erlang("jhonstart_render:push_node($0)"))]
declare fn __jhPushNode(n: fn(scope: Scope) -> Async<Walked>) -> i32;

#[compiler.external(.JavaScript("require('./render.mjs').nodeAt($0)"), .Erlang("jhonstart_render:node_at($0)"))]
declare fn __jhNodeAt(index: string) -> fn(scope: Scope) -> Async<Walked>;

// Raises `reason` and never returns: a signal or a failure that leaves the
// boundary it was caught at goes on as an abort whose message is the reason,
// which `failure.attempt` reads back as `Failure.message` on every target.
fn raiseElement(reason: string) -> Element {
    panic(reason);
}

// The per-render state reached from OUTSIDE this directory goes through these
// plain functions, never through the cells themselves: on the commonJS row a
// cell called from another directory's module requires its own copy of
// `render.mjs`, so its state would not be this render's.
pub fn resetRender() -> i32 {
    return __jhStateReset();
}

pub fn renderedIslands() -> array<#(string, string, string)> {
    return __jhIslands();
}

pub fn registeredBoundaries() -> array<Boundary> {
    return __jhTakeBoundaries();
}

// `f`'s task under std's `failure.attemptTask` (botopink decisions 431, 494):
// its value, or `Error(reason)` — the message of the raise it crashed with.
pub async fn attemptTask<T>(f: fn() -> Async<T>) -> Async<Result<T, string>> {
    val out = await failure.attemptTask(f);
    return case out {
        Ok(v) -> v;
        Error(e) -> throw e.message;
    };
}

// A component's run walked with `scope`, under `attemptTask` —
// `Error(reason)` for a raise.
pub async fn componentOutcome(
    f: fn() -> Component<Element>,
    scope: Scope,
) -> Async<Result<Walked, string>> {
    val out = await attemptTask({ -> renderComponent(f(), scope) });
    return try out;
}

// ── the renderer holds the scope (decisions 388, 414, 809, 908) ─────────────
//
// A component at run time is a lambda over a `Scope` (388); calling one runs
// nothing, `resolve(c, scope, key)` / `run(c, scope)` runs it, so a try
// catches a component only around its run, and only a function holding the
// scope can write one. The composition's error and not-found boundaries are
// therefore NODES of the tree (`ErrorBoundaryNode`, `NotFoundBoundaryNode`,
// beside `suspense.Boundary`): `caughtBelow` / `notFoundLevel` / an
// application's own `errorBoundaryNode` each answer a placeholder (`#node`,
// the node registered per render) and call no host try, and the plain
// functions below run each inside the host's try with whatever scope
// `resolveTree` is threading — but that threaded scope is never what `child`
// actually sees: `Scope` no longer hands a caller back "the scope the body
// made for its children" (809 (8), 822, 825 retire 388 (2)'s `Rendered`),
// and resolving a child from outside the cell that made it is refused by the
// model (908) — a run elsewhere would never see `compose`'s own `use
// provide(StyledSheet)`, and an application calling `errorBoundaryNode`
// would never see its own providers either (1103). So `caughtBelow` /
// `notFoundLevel` / `errorLevel` / `errorBoundaryNode`, each a `component
// fn` of its own, keep THEIR OWN cell (`use selfScope`, 809 (8) case B)
// before placing a boundary, and `keptAt` closes over it: whatever scope the
// boundary is later resolved with is ignored, and `inner`'s own `enter`
// opens its cell against the kept one instead — which sits over the
// providers visible where the boundary was PLACED, exactly as a nested `use`
// would see it there. A `Suspense` boundary's `child` is kept the same way;
// `Fill.scope` stays (streaming.bp's shape) but is no longer load-bearing
// for a boundary built through `keptAt`.

// The ambient scope a body currently stands in (809 (8) case B): a raw
// `Composition<Scope>` that answers the cell it is handed, so `use
// selfScope` inside a body gives back THAT body's own cell — every
// `use provide` written above it (`compose`'s included) already in its
// map. Stateless, so one value is `use`d from every body that needs it.
val selfScope: Component<Scope> = { scope, key -> scope };

// A thunk resolved later — inside a host's try, or a stream's fill — kept
// over `scope` from where it was placed, never a scope reselected from
// outside (809 (8), 908): whatever scope the caller later resolves it with
// is ignored, and `inner`'s own cell opens against the kept one.
fn keptAt(scope: Scope, inner: fn() -> Component<Element>) -> fn() -> Component<Element> {
    return { -> boundTo(scope, inner) };
}

component fn boundTo(scope: Scope, inner: fn() -> Component<Element>) -> Component<Element> {
    val e = await run(inner(), scope);
    return e;
}

// The error boundary of a segment: `child` runs inside the host's try; a
// signal is re-raised, any other failure renders `view` (wrapped in
// `data-jh-e` unless the segment streams, `wrapped`).
pub type ErrorBoundaryNode(
    id: string,
    child: fn() -> Component<Element>,
    view: fn(info: ErrorInfo) -> Element,
    wrapped: bool,
)

// The not-found level of a segment: `data-jh-n` around `child`, and `view`
// stashed as the nearest not-found tree when a not-found signal leaves it.
pub type NotFoundBoundaryNode(
    pattern: string,
    child: fn() -> Component<Element>,
    view: fn() -> Element,
)

// A `Suspense` boundary with the scope its fill runs with.
pub type Fill(boundary: Boundary, scope: Scope)

// A run walked: its tree, every boundary node resolved, and the fills the run
// and the nodes below it registered.
pub type Walked(tree: Element, fills: Fill[])

// An application's error boundary around a component (decisions 414 (3),
// 1103): it writes no try around its children — it places this node, and the
// renderer runs `child` inside the host's try. `child` is kept over THIS
// call's own scope (`keptAt`, 809 (8)) rather than the scope the node is
// later resolved with — an application's `errorBoundaryNode` is itself a
// `component fn` now, so its placement sees every `use provide` written
// above it, the same guarantee `caughtBelow` keeps for the composition's own
// levels. Renders `fallback` (in `data-jh-e="ID"`) for an ordinary failure
// and re-raises a signal.
pub component fn errorBoundaryNode(
    id: string,
    child: fn() -> Component<Element>,
    fallback: fn(info: ErrorInfo) -> Element,
) -> Component<Element> {
    val myScope = use selfScope;
    return errorNode(
        ErrorBoundaryNode(id: id, child: keptAt(myScope, child), view: fallback, wrapped: true),
    );
}

// A boundary node is its own renderer: the placeholder carries the index of
// the function that runs it with the scope its parent's run answered.
fn errorNode(b: ErrorBoundaryNode) -> Element {
    return nodePlaceholder({ scope -> renderErrorBoundary(b, scope) });
}

fn notFoundNode(b: NotFoundBoundaryNode) -> Element {
    return nodePlaceholder({ scope -> renderNotFound(b, scope) });
}

fn nodePlaceholder(n: fn(scope: Scope) -> Async<Walked>) -> Element {
    val index = __jhPushNode(n);
    return Element(
        tag: "#node",
        value: index.toString(),
        children: [],
        attrs: [],
    );
}

// Run `c` with `scope`, then every boundary node of its tree with the same
// scope: a boundary built through `keptAt` — every boundary this module
// places, `errorBoundaryNode`'s included (1103) — ignores it and runs over
// the cell it was kept at (809 (8), 908).
pub async fn renderComponent(
    c: Component<Element>,
    scope: Scope,
) -> Async<Walked> {
    val value = await run(c, scope);
    val own = __jhTakeBoundaries().map(
        { b -> Fill(boundary: b, scope: scope) },
    );
    val inner = await resolveTree(value, scope);
    return Walked(tree: inner.tree, fills: own.append(inner.fills));
}

async fn resolveTree(e: Element, scope: Scope) -> Async<Walked> {
    if (e.tag == "#node") {
        val run = __jhNodeAt(e.value);
        val walked = await run(scope);
        return walked;
    }
    var kids: Element[] = [];
    var fills: Fill[] = [];
    for (e.children) { c ->
        val w = await resolveTree(c, scope);
        kids.push(w.tree);
        fills = fills.append(w.fills);
    }
    return Walked(
        tree: Element(
            tag: e.tag,
            value: e.value,
            children: kids,
            attrs: e.attrs,
        ),
        fills: fills,
    );
}

fn failureOf(outcome: Result<Walked, string>) -> string {
    return case outcome {
        Ok(w) -> "";
        Error(message) -> message;
    };
}

pub async fn renderErrorBoundary(
    b: ErrorBoundaryNode,
    scope: Scope,
) -> Async<Walked> {
    val outcome = await componentOutcome(b.child, scope);
    val failure = failureOf(outcome);
    if (isSignal(failure))
        return Walked(tree: raiseElement(failure), fills: []);
    val view = b.view;
    val walked = case outcome {
        Ok(w) -> w;
        Error(message) -> Walked(tree: view(infoFor(message)), fills: []);
    };
    if (b.wrapped)
        return Walked(tree: wrap(b.id, walked.tree), fills: walked.fills);
    return walked;
}

pub async fn renderNotFound(
    b: NotFoundBoundaryNode,
    scope: Scope,
) -> Async<Walked> {
    val outcome = await componentOutcome(b.child, scope);
    val failure = failureOf(outcome);
    if (failure == notFoundReason()) {
        val view = b.view;
        __jhStashNotFound(notFoundAnchor(b.pattern, view()));
    }
    if (failure != "") return Walked(tree: raiseElement(failure), fills: []);
    val walked = case outcome {
        Ok(w) -> w;
        Error(message) -> Walked(tree: childrenMarker(), fills: []);
    };
    return Walked(
        tree: notFoundAnchor(b.pattern, walked.tree),
        fills: walked.fills,
    );
}

// `f` under std's `failure.attempt` (botopink decision 431): its value, or
// `Error(reason)` — the message of the raise it crashed with.
pub fn attemptRender<T>(f: fn() -> T) -> Result<T, string> {
    val out = failure.attempt(f);
    return case out {
        Ok(v) -> v;
        Error(e) -> throw e.message;
    };
}

// ── step 3: the escaping walker ─────────────────────────────────────────────

pub fn renderNode(e: Element) -> string {
    if (e.tag == "#text") return escape.html(e.value);
    if (e.tag == "#raw") return e.value;
    if (e.tag == "#fragment") return renderChildren(e.children);
    val open = "<" + e.tag + renderAttrs(e.attrs) + ">";
    if (isVoidTag(e.tag)) return open;
    if (isRawTextTag(e.tag))
        return open + rawBody(e.tag, e.children) + "</" + e.tag + ">";
    return open + renderChildren(e.children) + "</" + e.tag + ">";
}

fn renderChildren(children: Children) -> string {
    var out = "";
    for (children) { c ->
        out = out + renderNode(c);
    }
    return out;
}

fn renderAttrs(attrs: array<#(string, string)>) -> string {
    var out = "";
    for (attrs) { a ->
        out = out + " " + a._0 + "=\"" + escape.attribute(a._1) + "\"";
    }
    return out;
}

// The text of a raw-text element, verbatim. A body holding `</script` /
// `</style` (any case) would close the element early: the render FAILS, naming
// the tag.
fn rawBody(tag: string, children: Children) -> string {
    var out = "";
    for (children) { c ->
        out = out + c.value;
    }
    val closer = "</" + tag;
    assert out.toLower().contains(closer) == false, "render: a <"
        + tag
        + "> body contains `"
        + closer
        + "`, which would close the element early - refused, never escaped";
    return out;
}

// The single documented escape hatch: `html` is written verbatim. Its two uses
// are a plugin's `<style>` block and the payload script.
pub fn raw(html: string) -> Element {
    return Element(tag: "#raw", value: html, children: [], attrs: []);
}

// The shell: the page with every boundary showing its fallback. No doctype and
// no head — the document is `document`'s.
pub fn shellHtml(page: Element) -> string {
    return renderNode(page);
}

// ── islands — the ordinals are the render's (front 29's `islandAttr`) ───────

// An island in render order: the next ordinal, the placeholder front 29's
// `clientMount` builds, and the payload `i` row recorded for this render.
pub fn mountIsland(
    component: string,
    props: array<#(string, string)>,
    children: Children,
) -> Element {
    val ordinal = __jhNextIslandOrdinal();
    val island = Island(
        id: islandId(ordinal),
        component: component,
        props: props,
    );
    __jhPushIsland(islandEntry(island));
    return clientMount(island, children);
}

// ── `RenderHooks` ───────────────────────────────────────────────────────────
//
// The two fields that carry markup another package writes — rakun-ssr front 68's
// bundle tags — and nothing else. The style moments are `RenderPlugin`'s.

pub type RenderHooks(
    headExtra: fn(route: string) -> string,
    bodyExtra: fn(route: string) -> string,
)

fn noExtra(route: string) -> string {
    return "";
}

pub fn defaultHooks() -> RenderHooks {
    return RenderHooks(
        headExtra: { route -> noExtra(route) },
        bodyExtra: { route -> noExtra(route) },
    );
}

// Stored once, at boot, for every render that follows (a process-independent
// store on the BEAM: rakun-ssr sets it in another process than the renders).
pub fn setHooks(h: RenderHooks) -> void {
    __jhSetHooks(h);
}

pub fn currentHooks() -> RenderHooks {
    return __jhHooks(defaultHooks());
}

// ── step 4: composition ─────────────────────────────────────────────────────

fn childrenMarker() -> Element {
    return Element(tag: "#children", value: "", children: [], attrs: []);
}

// `tree` with every `#children` placeholder replaced by `inner`.
pub fn substitute(tree: Element, inner: Element) -> Element {
    if (tree.tag == "#children") return inner;
    var kids: array<Element> = [];
    for (tree.children) { c ->
        kids.push(substitute(c, inner));
    }
    return Element(
        tag: tree.tag,
        value: tree.value,
        children: kids,
        attrs: tree.attrs,
    );
}

fn segmentOf(chain: array<UiSegment>, i: i32) -> UiSegment {
    var found = segment("");
    var n = 0;
    for (chain) { s ->
        if (n == i) found = s;
        n = n + 1;
    }
    return found;
}

fn propsFor(route: PageContext) -> LayoutProps {
    return LayoutProps(route: route, children: childrenMarker(), slots: []);
}

// The route snapshot for the layout at `depth`: front 26's `selected`.
// The query is the snapshot's own — the render filled it at depth 0 — since
// `PageContext` carries none.
fn enterDepth(route: PageContext, depth: i32) -> i32 {
    return fill(
        route.pathname,
        encoding.formStringify(route.params),
        encoding.formStringify(snapshot().search),
        route.pattern,
        depth,
    );
}

// The view of a segment that has no layout (or no template): the bare
// `#children` placeholder, so the composition passes straight through.
component fn markerView(props: LayoutProps) -> Component<Element> {
    return childrenMarker();
}

// A layout's (a template's) view is resolved by one `use`, written at the top
// of the body (357): the segment that has none takes `markerView` in the
// argument, never a `return` before the `use` (decision 791 (3), (4)).
component fn layoutOf(
    seg: UiSegment,
    route: PageContext,
    depth: i32,
) -> Component<Element> {
    enterDepth(route, depth);
    val none: fn(props: LayoutProps) -> Component<Element> = { props -> markerView(props) };
    val view = if (seg.hasLayout) seg.layoutView else none;
    val tree = use view(propsFor(route));
    return tree;
}

component fn templateOf(seg: UiSegment, route: PageContext) -> Component<Element> {
    val none: fn(props: LayoutProps) -> Component<Element> = { props -> markerView(props) };
    val view = if (seg.hasTemplate) seg.templateView else none;
    val tree = use view(propsFor(route));
    if (seg.hasTemplate == false) return tree;
    val key = seg.pattern + "#" + __jhNextNav().toString();
    return Element(
        tag: "div",
        value: "",
        children: [tree],
        attrs: [#("data-jh-t", key)],
    );
}

// The page, composed through `chain`: root-first, layouts before the page.
// The root of every page render: it provides `styled`'s `StyledSheet`
// context (decisions 352, 354 (7), 379), so a `styled` component computed at
// render below it writes to this render's sheet (`styled_sheet.bp`).
pub component fn compose(
    chain: array<UiSegment>,
    route: PageContext,
    page: fn() -> Component<Element>,
) -> Component<Element> {
    use provide(createContext(renderSheet()));
    val tree = use composeAt(chain, 0, route, page);
    return tree;
}

// A value already in hand, as a component: no `use` of its own, so a branch
// that only places a node (never defers to another component) still answers
// through the ONE `use` decision 357 asks for (`use step()` below) rather
// than returning early out from under it.
component fn literalElement(e: Element) -> Component<Element> {
    return e;
}

component fn composeAt(
    chain: array<UiSegment>,
    i: i32,
    route: PageContext,
    page: fn() -> Component<Element>,
) -> Component<Element> {
    val segmentStep: fn() -> Component<Element> = { -> composeSegment(chain, i, route, page) };
    val step: fn() -> Component<Element> = if (i >= chain.length)
        page
    else
        segmentStep;
    val tree = use step();
    return tree;
}

component fn composeSegment(
    chain: array<UiSegment>,
    i: i32,
    route: PageContext,
    page: fn() -> Component<Element>,
) -> Component<Element> {
    val seg = segmentOf(chain, i);
    val shell = use layoutOf(seg, route, i);
    val tmpl = use templateOf(seg, route);
    val inner = use errorLevel(chain, i, route, page);
    return substitute(shell, substitute(tmpl, inner));
}

fn errorId(seg: UiSegment) -> string {
    return seg.pattern;
}

// The loading boundary of segment `i`, as a plain value: no `use` of its own
// — `caughtBelow`'s content is kept for later over `myScope` (`keptAt`,
// decision 809 (8)), never resolved here.
fn loadingBoundary(
    seg: UiSegment,
    chain: array<UiSegment>,
    i: i32,
    route: PageContext,
    page: fn() -> Component<Element>,
    myScope: Scope,
) -> Element {
    val loading = seg.loadingView;
    val hole = holeId(nextHoleOrdinal());
    val child = keptAt(myScope, { -> caughtBelow(chain, i, route, page) });
    val placeholder = Suspense(
        Boundary(id: hole, fallback: loading(), child: child),
    );
    if (seg.hasError) return wrap(errorId(seg), placeholder);
    return placeholder;
}

// `error > loading > not-found > (the rest)` for segment `i`. `myScope`
// (809 (8) case B — kept from inside this body, over `compose`'s own map)
// is captured on every call, unconditionally (decision 357), whether this
// segment streams or not.
component fn errorLevel(
    chain: array<UiSegment>,
    i: i32,
    route: PageContext,
    page: fn() -> Component<Element>,
) -> Component<Element> {
    val seg = segmentOf(chain, i);
    val myScope = use selfScope;
    val loadingStep: fn() -> Component<Element> = { -> literalElement(loadingBoundary(seg, chain, i, route, page, myScope)) };
    val throughStep: fn() -> Component<Element> = { -> caughtBelow(chain, i, route, page) };
    val step: fn() -> Component<Element> = if (seg.hasLoading)
        loadingStep
    else
        throughStep;
    val tree = use step();
    return tree;
}

// The error boundary of segment `i` around its not-found level, as a node
// the renderer runs (`renderErrorBoundary`): a signal is re-raised, an
// ordinary failure renders the segment's error view.
component fn caughtBelow(
    chain: array<UiSegment>,
    i: i32,
    route: PageContext,
    page: fn() -> Component<Element>,
) -> Component<Element> {
    val seg = segmentOf(chain, i);
    val myScope = use selfScope;
    val throughStep: fn() -> Component<Element> = { -> notFoundLevel(chain, i, route, page) };
    val caughtStep: fn() -> Component<Element> = { ->
        literalElement(errorNode(
            ErrorBoundaryNode(
                id: errorId(seg),
                child: keptAt(myScope, { -> notFoundLevel(chain, i, route, page) }),
                view: seg.errorView,
                wrapped: seg.hasLoading == false,
            ),
        ))
    };
    val step: fn() -> Component<Element> = if (seg.hasError == false)
        throughStep
    else
        caughtStep;
    val tree = use step();
    return tree;
}

// The not-found level, as a node the renderer runs (`renderNotFound`):
// `data-jh-n` around the rest, and the nearest not-found tree for a not-found
// signal raised below it.
component fn notFoundLevel(
    chain: array<UiSegment>,
    i: i32,
    route: PageContext,
    page: fn() -> Component<Element>,
) -> Component<Element> {
    val seg = segmentOf(chain, i);
    val myScope = use selfScope;
    val throughStep: fn() -> Component<Element> = { -> composeAt(chain, i + 1, route, page) };
    val notFoundStep: fn() -> Component<Element> = { ->
        literalElement(notFoundNode(
            NotFoundBoundaryNode(
                pattern: seg.pattern,
                child: keptAt(myScope, { -> composeAt(chain, i + 1, route, page) }),
                view: seg.notFoundView,
            ),
        ))
    };
    val step: fn() -> Component<Element> = if (seg.hasNotFound == false)
        throughStep
    else
        notFoundStep;
    val tree = use step();
    return tree;
}

// The not-found anchor: the client swaps a late not-found into the nearest one.
pub fn notFoundAnchor(pattern: string, tree: Element) -> Element {
    return Element(
        tag: "div",
        value: "",
        children: [tree],
        attrs: [#("data-jh-n", pattern)],
    );
}

#[compiler.external(
    .JavaScript("require('./render.mjs').nextHoleOrdinal()"),
    .Erlang("jhonstart_render:next_hole_ordinal()"),
)]
declare fn __jhNextHoleOrdinal() -> i32;

// The next hole ordinal of this render: `h1`, `h2`, … in shell order.
pub fn nextHoleOrdinal() -> i32 {
    return __jhNextHoleOrdinal();
}

// ── step 5: the payload (contract 2) ────────────────────────────────────────

pub type Payload(
    build: string,
    pathname: string,
    pattern: string,
    params: string,
    query: string,
    table: string,
    islands: array<#(string, string, string)>,
    actions: array<#(string, string)>,
    holes: string[],
    dynamic: bool,
    extras: array<#(string, PayloadJson)>,
)

// The keys the render writes itself; a plugin may give none of them.
pub fn renderKeys() -> string[] {
    return ["v", "b", "p", "r", "m", "q", "t", "i", "a", "h", "d", "k", "z"];
}

pub fn writePayload(p: Payload) -> string {
    val islandRows = p.islands.map(
        { row -> arrayOf([quote(row._0), quote(row._1), quote(row._2)]) },
    );
    val actionRows = p.actions.map(
        { row -> arrayOf([quote(row._0), quote(row._1)]) },
    );
    val holeRows = p.holes.map({ h -> quote(h) });
    var fields: array<#(string, string)> = [
        #("v", "1"),
        #("b", quote(p.build)),
        #("p", quote(p.pathname)),
        #("r", quote(p.pattern)),
        #("m", quote(p.params)),
        #("q", quote(p.query)),
        #("t", quote(p.table)),
        #("i", arrayOf(islandRows)),
        #("a", arrayOf(actionRows)),
        #("h", arrayOf(holeRows)),
        #("d", if (p.dynamic) "true" else "false"),
    ];
    for (p.extras) { extra ->
        fields.push(extra);
    }
    return escape.scriptJson(object(fields));
}

// The payload script: `<script>window.<globals.payload> = {…}</script>`.
pub fn payloadScript(p: Payload) -> string {
    return "<script>window."
        + globals.payload
        + " = "
        + writePayload(p)
        + "</script>";
}

// ── the document ────────────────────────────────────────────────────────────

// A language tag `app(lang: …)` accepts: letters, digits and `-`, starting
// with a letter (`en`, `pt-BR`, `zh-Hant-TW`). Anything else is refused by
// `app`, so the attribute never carries markup.
pub fn isLangTag(tag: string) -> bool {
    val chars = tag.split("");
    val letters = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ";
    val allowed = letters + "0123456789-";
    val first = chars.at(0) ?? "";
    val startsWithLetter = first != "" && letters.contains(first);
    return startsWithLetter && chars.all({ c -> allowed.contains(c) });
}

// Everything up to and including the root's opening tag: the doctype, the
// `<html lang>` the app was built with, the head (front 32's tags, the
// plugins' `head`, `RenderHooks.headExtra`), and `<div data-jh-root="">`.
pub fn documentStart(
    lang: string,
    head: string,
    pluginHead: string,
    route: string,
) -> string {
    val hooks = currentHooks();
    val headExtra = hooks.headExtra;
    return "<!DOCTYPE html><html lang=\""
        + escape.attribute(lang)
        + "\"><head><meta charset=\"utf-8\">"
        + head
        + pluginHead
        + headExtra(route)
        + "</head><body><div data-jh-root=\"\">";
}

// Everything after the fills: the payload script, `RenderHooks.bodyExtra`, and
// the closing tags.
pub fn documentEnd(p: Payload, route: string) -> string {
    val hooks = currentHooks();
    val bodyExtra = hooks.bodyExtra;
    return payloadScript(p) + bodyExtra(route) + "</body></html>";
}

// A whole document in one string: `documentStart`, the composed tree, the
// root's close, `fills`, `documentEnd`.
pub fn document(
    lang: string,
    head: string,
    pluginHead: string,
    body: string,
    fills: string,
    p: Payload,
) -> string {
    return documentStart(lang, head, pluginHead, p.pattern)
        + body
        + "</div>"
        + fills
        + documentEnd(p, p.pattern);
}
