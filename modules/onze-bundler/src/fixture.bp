//// onze-bundler — the frozen fixture app (`test-snap.md` § Fixture
//// conventions): the tree every track-E suite reads — a root layout with a
//// client nav, a home page, a dynamic post page with a client like button
//// and a loading file, a shared formatting module and a server-only store.
//// Frozen, so the hashes the suites record stay stable.

pub fn fixtureApp() -> string {
    return [
        "== app/layout.bp",
        "import { Nav } from \"@/components.nav\";",
        "#[layout(\"\")] pub fn rootLayout(props: LayoutProps) -> @Component<Element> { return main([Nav(navProps())]); }",
        "== app/page.bp",
        "#[page(\"\")] pub fn home(route: PageContext) -> @Component<Element> { return p([]); }",
        "== app/blog/[slug]/page.bp",
        "import { LikeButton } from \"@/components.like_button\";",
        "import { listPosts } from \"@/lib.db\";",
        "#[page(\"blog/[slug]\")] pub fn post(route: PageContext) -> @Component<Element> { return p([]); }",
        "== app/blog/[slug]/loading.bp",
        "pub fn Loading() -> Element { return p([]); }",
        "== components/nav.bp",
        "import { plural } from \"@/lib.format\";",
        "#[client]",
        "pub fn Nav(props: NavProps) -> Element { return nav([]); }",
        "== components/like_button.bp",
        "import { plural } from \"@/lib.format\";",
        "import { io.env } from \"std\";",
        "#[client]",
        "pub fn LikeButton(props: LikeProps) -> Element { val api = env.read(\"ONZE_PUBLIC_API_URL\"); return button([]); }",
        "== lib/format.bp",
        "pub fn plural(n: i32, word: string) -> string { return word; }",
        "== lib/db.bp",
        "import { serverOnly } from \"jhonstart\";",
        "pub fn listPosts() -> Post[] { return []; }",
    ].join("\n");
}
