//// onze-bundler — the client module graph (front 68 step 2).
////
//// The roots are front 29's `#[client]` modules reached from a route: every
//// route module (a page, layout, template, loading, error or not-found file
//// under `appDir`) is walked on the SERVER side until a client module is
//// reached — that module is a root and the server walk does not descend past
//// it. From each root the imports are walked again; that closure is the
//// client graph. A module reachable from a root is in the bundle whether or
//// not it carries the marker (`NEXTJS-DOCS.md § 7`'s first rule), and every
//// node carries the import chain from the root that pulled it in — the chain
//// every refusal prints.

import {AliasMap, resolveAlias} from "onze";
import {conventions.classify} from "routing";
import {scan.SourceFile, scan.ImportRef, scan.importsOf, scan.moduleIdOf, scan.isClientModule, scan.publicNamesOf};

pub type AppModule(id: string, path: string, source: string, refs: Array<ImportRef>, client: bool)

pub type GraphNode(moduleId: string, path: string, chain: Array<string>, isRoot: bool)

pub type ClientGraph(nodes: Array<GraphNode>, roots: Array<string>, outside: Array<string>)

// The `.bp` files of a project as modules, each scanned. A file the scanner
// cannot read fails the load, naming it.
pub fn loadModules(
    files: Array<SourceFile>,
) -> @Result<Array<AppModule>, string> {
    var out: Array<AppModule> = [];
    for (files.filter({ f -> f.path.endsWith(".bp") })) { f ->
        val refs = try importsOf(f.path, f.source);
        out.push(
            AppModule(
                id: moduleIdOf("", f.path),
                path: f.path,
                source: f.source,
                refs: refs,
                client: isClientModule(f.source),
            ),
        );
    }
    return out;
}

fn moduleById(modules: Array<AppModule>, id: string) -> ?AppModule {
    val hit = modules.filter({ m -> m.id == id });
    if (hit.length == 0) return null;
    return hit.at(0) ?? AppModule(
        id: "",
        path: "",
        source: "",
        refs: [],
        client: false,
    );
}

fn hasModule(modules: Array<AppModule>, id: string) -> bool {
    return modules.any({ m -> m.id == id });
}

fn dirIdOf(m: AppModule) -> string {
    val parts = m.id.split(".");
    val isIndex = m.path.endsWith("/mod.bp")
        || m.path == "mod.bp"
        || m.path.endsWith("root.bp");
    if (isIndex) return m.id;
    return parts.take(parts.length - 1).join(".");
}

fn joinId(dir: string, name: string) -> string {
    return if (dir == "") name else dir + "." + name;
}

// The app modules one import (or `mod` line) of `origin` reaches. A spec that
// names no module of the app — `std`, `jhonstart`, a shared library — is
// not an app edge.
pub fn edgesOf(
    modules: Array<AppModule>,
    aliases: AliasMap,
    origin: AppModule,
    r: ImportRef,
) -> string[] {
    if (r.isModDecl) {
        val id = joinId(dirIdOf(origin), r.spec);
        return if (hasModule(modules, id)) [id] else [];
    }
    if (r.spec == "") {
        // A dotted item names a module of the app by its path inside the
        // braces (decision 206): `lib.db.listPosts` is `lib.db`'s, and
        // `lib.db` alone is the module itself (the namespace form).
        var named: string[] = [];
        for (r.names) { item ->
            val path = leafPathOf(item);
            if (path.contains(".")) {
                val parts = path.split(".");
                val owner = parts.take(parts.length - 1).join(".");
                val hit = if (hasModule(modules, owner))
                    owner
                else if (hasModule(modules, path))
                    path
                else
                    "";
                if (hit != "" && named.contains(hit) == false) named.push(hit);
            }
        }
        val bare = r.names.filter(
            { n -> leafPathOf(n).contains(".") == false },
        );
        val dir = dirIdOf(origin);
        val siblings = modules.filter(
            { m -> m.id != origin.id && dirIdOf(m) == dir },
        );
        val shorthand = siblings
            .filter(
                { m -> publicNamesOf(m.source).any({ n -> bare.contains(n) }) },
            )
            .map({ m -> m.id });
        return named.append(
            shorthand.filter({ id -> named.contains(id) == false }),
        );
    }
    val target = resolveAlias(aliases, r.spec).replaceAll("/", ".");
    return if (hasModule(modules, target)) [target] else [];
}

// An import item's path, its `as` alias and `*` dropped: `lib.db.Post as P`
// → `lib.db.Post`.
fn leafPathOf(item: string) -> string {
    val noAlias = if (item.contains(" as "))
        item.slice(0, item.indexOf(" as "))
    else
        item;
    return noAlias.replaceAll("*", "").trim();
}

fn allEdges(
    modules: Array<AppModule>,
    aliases: AliasMap,
    origin: AppModule,
) -> string[] {
    var out: string[] = [];
    for (origin.refs) { r ->
        for (edgesOf(modules, aliases, origin, r)) { id ->
            if (out.contains(id) == false) out.push(id);
        }
    }
    return out;
}

// The route modules under `appDir`: every file `routing`'s `classify` names, route
// handlers (`route.bp`) aside — a handler renders no page.
pub fn routeModuleIds(modules: Array<AppModule>, appDir: string) -> string[] {
    return modules
        .filter({ m -> isRenderFile(appDir, m.path) })
        .map({ m -> m.id });
}

fn isRenderFile(appDir: string, path: string) -> bool {
    val f = classify(appDir, path);
    if (f == null) return false;
    return (f.kind) != "route";
}

// The client roots the server-side walk from `starts` reaches, in discovery
// order.
pub fn rootsFrom(
    modules: Array<AppModule>,
    aliases: AliasMap,
    starts: string[],
) -> string[] {
    var roots: string[] = [];
    var seen: string[] = [];
    var stack: string[] = starts.reverse();
    while (stack.length > 0) {
        val id = stack.at(stack.length - 1) ?? "";
        stack = stack.take(stack.length - 1);
        if (seen.contains(id) == false) {
            seen.push(id);
            val m = moduleById(modules, id);
            if (m != null) {
                val found = m;
                if (found.client) {
                    if (roots.contains(id) == false) roots.push(id);
                } else {
                    val next = allEdges(modules, aliases, found).reverse();
                    for (next) { e ->
                        stack.push(e);
                    }
                }
            }
        }
    }
    return roots;
}

// The client graph of the whole app: the roots every route reaches, each
// root's closure depth-first, each module once with the chain of the first
// root that reached it.
pub fn clientGraph(
    modules: Array<AppModule>,
    aliases: AliasMap,
    appDir: string,
) -> ClientGraph {
    val roots = rootsFrom(modules, aliases, routeModuleIds(modules, appDir));
    return graphOfRoots(modules, aliases, roots);
}

pub fn graphOfRoots(
    modules: Array<AppModule>,
    aliases: AliasMap,
    roots: string[],
) -> ClientGraph {
    var nodes: Array<GraphNode> = [];
    var placed: string[] = [];
    for (roots) { root ->
        var stack: Array<#(string, string[])> = [#(root, [root])];
        while (stack.length > 0) {
            val top = stack.at(stack.length - 1) ?? #("", []);
            stack = stack.take(stack.length - 1);
            val id = top._0;
            if (placed.contains(id) == false) {
                placed.push(id);
                val m = moduleById(modules, id) ?? AppModule(
                    id: id,
                    path: "",
                    source: "",
                    refs: [],
                    client: false,
                );
                nodes.push(
                    GraphNode(
                        moduleId: id,
                        path: m.path,
                        chain: top._1,
                        isRoot: id == root,
                    ),
                );
                val next = allEdges(modules, aliases, m).reverse();
                for (next) { e ->
                    if (placed.contains(e) == false)
                        stack.push(#(e, top._1.append([e])));
                }
            }
        }
    }
    val outside = modules
        .map({ m -> m.id })
        .filter({ id -> placed.contains(id) == false });
    return ClientGraph(nodes: nodes, roots: roots, outside: outside);
}

// The chain from the root that pulled `moduleId` in, root first; `[]` when
// the module is not in the graph.
pub fn chainOf(graph: ClientGraph, moduleId: string) -> Array<string> {
    val hit = graph.nodes.filter({ n -> n.moduleId == moduleId });
    if (hit.length == 0) return [];
    return (hit.at(0) ?? GraphNode(
        moduleId: "",
        path: "",
        chain: [],
        isRoot: false,
    )).chain;
}

pub fn inGraph(graph: ClientGraph, moduleId: string) -> bool {
    return graph.nodes.any({ n -> n.moduleId == moduleId });
}

pub fn chainText(chain: Array<string>) -> string {
    return chain.join(" > ");
}

fn widestOf(xs: string[]) -> i32 {
    var w = 0;
    for (xs) { x ->
        val n: i32 = x.length();
        if (n > w) w = n;
    }
    return w;
}

// The graph as the `graph` snapshots record it.
pub fn describeGraph(graph: ClientGraph) -> string {
    val width = widestOf(graph.nodes.map({ n -> n.moduleId }));
    val rootsText = if (graph.roots.length == 0)
        "(none)"
    else
        graph.roots.join(", ");
    var rows: string[] = ["roots: " + rootsText];
    for (graph.nodes) { n ->
        val rootMark = if (n.isRoot) "root" else "-";
        rows.push(
            n.moduleId.padEnd(width + 3, " ")
                + rootMark.padEnd(7, " ")
                + "chain: "
                + chainText(n.chain),
        );
    }
    val outsideText = if (graph.outside.length == 0)
        "(none)"
    else
        graph.outside.join(", ");
    rows.push("not in graph: " + outsideText);
    return rows.join("\n");
}
