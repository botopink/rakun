//// The `onze-bundler` package — module-tree root (front 68 owns it).
////
//// The client bundle: the textual module scan, the client graph, the three
//// build refusals, chunks, the client manifest the BEAM server reads on every
//// render, the generated hydration entry, `<Script>` placement and the dev
//// rebuild. `manifest` compiles for both targets; the rest runs at build time
//// under the CLI (commonJS) and is asserted on both rows where it is pure.

pub mod manifest;
pub mod scan;
pub mod graph;
pub mod refusal;
pub mod chunk;
pub mod fixture;
pub mod entry;
pub mod script;
pub mod rebuild;
pub mod hooks;
pub mod link;
