//// onze-bundler — the bundle's tags as jhonstart's `RenderHooks` (front 68).
////
//// `headScriptTags` / `scriptTags` wrapped as the two tag fields jhonstart's
//// render keeps; `Onze.run` (front 49's `bootSite`) installs them. jhonstart
//// writes the strings without knowing where they came from, and its payload
//// script stays its own, before them.

import {RenderHooks} from "jhonstart";
import {manifest.ClientBundleManifest, manifest.ChunkRef, manifest.headScriptTags, manifest.scriptTags};

pub fn bundleRenderHooks(m: ClientBundleManifest) -> RenderHooks {
    return RenderHooks(headExtra: { route -> headScriptTags(m) }, bodyExtra: { route -> scriptTags(m, route) });
}
