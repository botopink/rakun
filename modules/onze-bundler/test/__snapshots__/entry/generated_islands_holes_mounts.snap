fn commitTree(commit: fn(html: string) -> i32, tree: Element) {
    val html = renderNode(tree);
    raiseFirst(unknownClasses(classNamesIn(html), payloadIds(globals.payload, "s")));
    val done = commit(html);
}

fn islandMismatches(domIslands: string[], payloadIslands: string[], domHoles: string[], payloadHoles: string[]) -> string[] {
    var out: string[] = [];
    for (payloadIslands) { id ->
        if (domIslands.contains(id) == false) out.push("island " + id + " is in the payload and not in the document");
    };
    for (domIslands) { id ->
        if (payloadIslands.contains(id) == false) out.push("island " + id + " is in the document and not in the payload");
    };
    for (payloadHoles) { id ->
        if (domHoles.contains(id) == false) out.push("hole " + id + " is in the payload and not in the document");
    };
    return out;
}

fn isEmiliaClass(name: string) -> bool {
    if (name.startsWith("e_") == false || name.length() < 3) return false;
    var hex = true;
    for (name.slice(2).split("")) { c ->
        if ("0123456789abcdef".contains(c) == false) hex = false;
    };
    return hex;
}

fn classNamesIn(html: string) -> string[] {
    var out: string[] = [];
    var first = true;
    for (html.split("class=\"")) { piece ->
        if (first) {
            first = false;
        } else {
            val value = piece.split("\"").at(0) ?? "";
            for (value.split(" ")) { name ->
                if (isEmiliaClass(name) && out.contains(name) == false) out.push(name);
            };
        };
    };
    return out;
}

fn unknownClasses(computed: string[], known: string[]) -> string[] {
    var out: string[] = [];
    for (computed) { name ->
        if (known.contains(name) == false) out.push("class " + name + " is not in the payload's s key - the server's stylesheet has no rule for it");
    };
    return out;
}

fn startNav(raw: string, commit: fn(html: string) -> i32) -> i32 {
    val p = propsOf(raw);
    return clientRender({ -> Nav(NavProps(title: prop(p, "title"), count: toI32(prop(p, "count")))) }, { tree -> commitTree(commit, tree) });
}

fn startLikeButton(raw: string, commit: fn(html: string) -> i32) -> i32 {
    val p = propsOf(raw);
    return clientRender({ -> LikeButton(LikeProps(likes: toI32(prop(p, "likes")), ratio: toF64(prop(p, "ratio")), open: (prop(p, "open") == "true"))) }, { tree -> commitTree(commit, tree) });
}

pub fn onzeEntryMain() {
    setMessageSource(builtInOnly());
    registerFill(globals.fill, payloadIds(globals.payload, "h"));
    registerSignal(globals.signal, []);
    registerStarter("Nav", { raw, commit -> startNav(raw, commit) });
    registerStarter("LikeButton", { raw, commit -> startLikeButton(raw, commit) });
    raiseFirst(islandMismatches(domIds("data-jh-i"), payloadIds(globals.payload, "i"), domIds("data-jh-h"), payloadIds(globals.payload, "h")));
    hydrate();
    linkMount();
    formMount("X-Bp-Action");
    scheduleNow("/c.js", "chatReady");
    scheduleLazy("/ads.js", "");
    startWorker("/w.js");
}

