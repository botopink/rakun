//// rakun-service — the two entry points, as comptime decorators, and the boot.
////
//// `#[filter]` and `#[middleware]` are not two mechanisms. They are two
//// REGISTRATIONS into the one chain of `filter.bp`, at two default orders:
////
//// | Entry point | Registers as | Default order | Suits |
//// |---|---|---|---|
//// | `#[filter]` on a component | one entry per component, ordered by `#[order(N)]` | `0` | reusable concerns: CORS, compression, metrics, security |
//// | `#[middleware]` on `pub fn middleware` in `middleware.bp` | one entry | `−50` | the application's own request gate: auth redirects, rewrites, locale |
////
//// Both receive `(req, chain)`, both may short-circuit, and both see the
//// response. The same redirect can be written either way, which is the honest
//// way to make the claim checkable — `test/middleware_test.bp` writes it twice.
////
//// DECORATOR-BODY CONSTRAINTS (rakun's `AGENTS.md`): a decorator body cannot
//// call a sibling function — each is lowered alone into the eval script — so
//// the per-field injection rule and the factory builder are inlined in every
//// marker here exactly as `decorators.bp` inlines them in every stereotype. The
//// outputs (`compiler.compile` executors, members) run BEFORE the placement `fail`, and a failed outcome discards the
//// contributions, so only correctly placed declarations wire up.

import {Response} from "rakun";
import {rkProp, rkScan, toI32} from "rakun";
import {filter.WebRequest, filter.Chain, filter.withHeader, filter.registerFilter, filter.runChain};
import {filter.orderRequestId, filter.orderCors, filter.orderProblem, filter.orderCompression, filter.orderNegotiation, filter.orderServerId, filter.orderApiVersion, filter.rkFreshId, filter.rkChainSetRunner};
import {negotiation.negotiationEntry, negotiation.installConverters, negotiation.registerConverter};
import {middleware.registerMiddleware, middleware.gateByMatcher, middleware.skip};
import {customizer.runCustomizers, customizer.rkCustomizerRegister};
import {apiversion.apiVersionEntry};
import {cors.corsEntry, cors.globalPolicy, cors.validatePolicy, cors.registerCorsMapping};
import {error.errorEntry};
import {compression.compressionEntry, compression.serverIdEntry, compression.validateCompression};
import {compiler, compiler.DeclKind} from "std";

// ── the markers ─────────────────────────────────────────────────────────────

// `#[filter]` is a TYPE-level decorator: a method `@Decl` carries no owner
// (front 06's gap table), so a marker that wired itself could not find the type
// it belongs to. It contributes the component wiring a stereotype does — scan
// plus a singleton factory — and then one chain entry calling `handle`.
pub fn filter(syntax decl: unknown) {
    val declName = compiler.name(decl)!;
    compiler.init({ -> rkScan(declName); });
    var args: Array<string> = [];
    compiler
        .fields(decl)
        .forEach({ f ->
            var valKey = "";
            f.annotations.forEach(
                { a -> if (a.name == "value") valKey = a.args.join("") },
            );
            val expr = if (valKey != "") {
                if (f.typeName == "i32")
                    "rkPropInt(" + valKey + ")"
                else
                    "rkProp(" + valKey + ")";
            } else "rkResolve(\"" + f.typeName + "\")";
            args.push(f.name + ": " + expr);
        });
    compiler.addMember(
        "pub fn make() -> "
            + compiler.name(decl)!
            + " { return rkSingleton(\""
            + compiler.name(decl)!
            + "\", { -> val _e = rkEnter(\""
            + compiler.name(decl)!
            + "\"); val v = "
            + compiler.name(decl)!
            + "("
            + args.join(", ")
            + "); val _d = rkDone(\""
            + compiler.name(decl)!
            + "\"); v }); }",
    );
    var ord = "\"0\"";
    compiler
        .annotations(decl)
        .forEach(
            { a -> if (a.name == "order") ord = a.args.join("") },
        );
    val ordText = ord.replaceAll("\"", "");
    compiler.init({ -> registerFilter(declName, toI32(ordText), { req, chain -> decl.make().handle(req, chain) }); });
    if (compiler.kind(decl) != DeclKind.Type)
        compiler.fail("#[filter] must annotate a type", at: decl);
    if (compiler.variants(decl).length > 0)
        compiler.fail("#[filter] must annotate a type with fields, not an enum", at: decl);
}

// `#[messageConverter("text/csv")]` on a component type with
// `write(self, value: string) -> string` and
// `read(self, body: string) -> Result<string, string>`: the component wiring a
// stereotype contributes, then one converter registration for the media type.
// A later registration for the same media type replaces the built-in one, so
// an application's converter wins for its type.
pub fn messageConverter(syntax decl: unknown, comptime media: string) {
    val declName = compiler.name(decl)!;
    compiler.init({ -> rkScan(declName); });
    var args: Array<string> = [];
    compiler
        .fields(decl)
        .forEach({ f ->
            var valKey = "";
            f.annotations.forEach(
                { a -> if (a.name == "value") valKey = a.args.join("") },
            );
            val expr = if (valKey != "") {
                if (f.typeName == "i32")
                    "rkPropInt(" + valKey + ")"
                else
                    "rkProp(" + valKey + ")";
            } else "rkResolve(\"" + f.typeName + "\")";
            args.push(f.name + ": " + expr);
        });
    compiler.addMember(
        "pub fn make() -> "
            + compiler.name(decl)!
            + " { return rkSingleton(\""
            + compiler.name(decl)!
            + "\", { -> val _e = rkEnter(\""
            + compiler.name(decl)!
            + "\"); val v = "
            + compiler.name(decl)!
            + "("
            + args.join(", ")
            + "); val _d = rkDone(\""
            + compiler.name(decl)!
            + "\"); v }); }",
    );
    compiler.init({ -> registerConverter(media, { v -> decl.make().write(v) }, { b -> decl.make().read(b) }); });
    if (compiler.kind(decl) != DeclKind.Type)
        compiler.fail("#[messageConverter] must annotate a type", at: decl);
    if (compiler.variants(decl).length > 0)
        compiler.fail(
            "#[messageConverter] must annotate a type with fields, not an enum",
            at: decl,
        );
    if (media.indexOf("/") <= 0)
        compiler.fail("#[messageConverter] needs a media type like \"text/csv\"", at: decl);
}

// `#[webCustomizer]` on a component type with
// `customize(self, reg: WebRegistry) -> i32`: the component wiring, then one
// customizer registration at its `#[order("N")]` (default 0). `bootWeb()` runs
// every customizer once, in that order.
pub fn webCustomizer(syntax decl: unknown) {
    val declName = compiler.name(decl)!;
    compiler.init({ -> rkScan(declName); });
    var args: Array<string> = [];
    compiler
        .fields(decl)
        .forEach({ f ->
            var valKey = "";
            f.annotations.forEach(
                { a -> if (a.name == "value") valKey = a.args.join("") },
            );
            val expr = if (valKey != "") {
                if (f.typeName == "i32")
                    "rkPropInt(" + valKey + ")"
                else
                    "rkProp(" + valKey + ")";
            } else "rkResolve(\"" + f.typeName + "\")";
            args.push(f.name + ": " + expr);
        });
    compiler.addMember(
        "pub fn make() -> "
            + compiler.name(decl)!
            + " { return rkSingleton(\""
            + compiler.name(decl)!
            + "\", { -> val _e = rkEnter(\""
            + compiler.name(decl)!
            + "\"); val v = "
            + compiler.name(decl)!
            + "("
            + args.join(", ")
            + "); val _d = rkDone(\""
            + compiler.name(decl)!
            + "\"); v }); }",
    );
    var ord = "\"0\"";
    compiler
        .annotations(decl)
        .forEach(
            { a -> if (a.name == "order") ord = a.args.join("") },
        );
    val ordText = ord.replaceAll("\"", "");
    compiler.init({ -> rkCustomizerRegister(declName, toI32(ordText), { reg -> decl.make().customize(reg) }); });
    if (compiler.kind(decl) != DeclKind.Type)
        compiler.fail("#[webCustomizer] must annotate a type", at: decl);
    if (compiler.variants(decl).length > 0)
        compiler.fail(
            "#[webCustomizer] must annotate a type with fields, not an enum",
            at: decl,
        );
}

// `#[order("-100")]` is read off `decl.annotations` by `#[filter]`; on its own
// it is a placement check, the same split `#[route]` and `#[restController]`
// use. A marker that emitted its own line could not see the entry it belongs
// to.
//
// THE ARGUMENT IS A STRING AND THAT IS NOT A STYLE CHOICE. The spec writes
// `#[order(-100)]` and that spelling DOES NOT PARSE: a negative integer literal
// in a decorator argument is `error: this token cannot appear here ... unexpected
// `100``, on both targets, measured against compiler 2e6bb4ac with the smallest
// program there is (`#[mark(20)]` compiles, `#[mark(-20)]` does not). Every
// order in the band below zero is therefore unwritable as an integer. The
// string is quoted and parsed with front 05's `toI32`, whose rule — a LEADING
// integer wins — is the one `#[value]` already uses, and the emitted line is
// `toI32("-100")`. When the parser accepts the minus sign the signature becomes
// `n: i32` and the emitted `toI32(` wrapper is deleted; nothing else moves.
pub fn order(syntax decl: unknown, comptime n: string) {
    if (compiler.kind(decl) == DeclKind.Field)
        compiler.fail("#[order] must annotate a type or a function, not a field", at: decl);
}

// `#[middleware]` on `pub fn middleware(req, chain)`. The matcher is read off
// the stacked `#[matcher(...)]`; with none the entry runs on every request,
// which is Next's own default.
pub fn middleware(syntax decl: fn(req: WebRequest, chain: Chain) -> Response) {
    var pattern = "\"\"";
    compiler
        .annotations(decl)
        .forEach(
            { a -> if (a.name == "matcher") pattern = a.args.join("") },
        );
    val declName = compiler.name(decl)!;
    val patternText = pattern.replaceAll("\"", "");
    compiler.init({ ->
        registerMiddleware(
            declName,
            patternText,
            { req, chain -> if (gateByMatcher(req, patternText)) decl(req, chain) else skip() },
        );
    });
    if (compiler.kind(decl) != DeclKind.Fn)
        compiler.fail("#[middleware] must annotate a function", at: decl);
}

pub fn matcher(syntax decl: unknown, comptime pattern: string) {
    if (compiler.kind(decl) != DeclKind.Fn)
        compiler.fail("#[matcher] must annotate the #[middleware] function", at: decl);
}

// `#[crossOrigin("https://example.com", "GET,POST")]` — comma-joined strings
// rather than array arguments, because a decorator argument is a raw lexeme
// typed by the signature and an array literal there is unverified. The mapping
// is keyed by the controller's `#[route]` prefix, so the override applies to
// that controller's routes and to nothing else.
pub fn crossOrigin(
    syntax decl: unknown,
    comptime origins: string,
    comptime methods: string,
) {
    var prefix = "";
    compiler
        .annotations(decl)
        .forEach(
            { a -> if (a.name == "route") prefix = a.args.join("") },
        );
    val prefixText = prefix.replaceAll("\"", "");
    compiler.init({ -> registerCorsMapping(prefixText, origins, methods); });
    if (compiler.kind(decl) != DeclKind.Type)
        compiler.fail("#[crossOrigin] must annotate a controller type", at: decl);
    if (prefix == "")
        compiler.fail(
            "#[crossOrigin] needs a #[route] prefix on the same type - a CORS mapping is keyed by the paths it covers, and a controller with no prefix covers none of them",
            at: decl,
        );
}

// `#[controllerAdvice]` is a TYPE-level decorator and `#[exceptionHandler]` a
// method-level placement marker, because a method `@Decl` carries no owner. The
// advice does the wiring: it walks its own methods and registers one handler
// per tag.
pub fn controllerAdvice(syntax decl: unknown) {
    val declName = compiler.name(decl)!;
    compiler.init({ -> rkScan(declName); });
    var aargs: Array<string> = [];
    compiler
        .fields(decl)
        .forEach({ f ->
            var valKey = "";
            f.annotations.forEach(
                { a -> if (a.name == "value") valKey = a.args.join("") },
            );
            val expr = if (valKey != "") {
                if (f.typeName == "i32")
                    "rkPropInt(" + valKey + ")"
                else
                    "rkProp(" + valKey + ")";
            } else "rkResolve(\"" + f.typeName + "\")";
            aargs.push(f.name + ": " + expr);
        });
    compiler.addMember(
        "pub fn make() -> "
            + compiler.name(decl)!
            + " { return rkSingleton(\""
            + compiler.name(decl)!
            + "\", { -> val _e = rkEnter(\""
            + compiler.name(decl)!
            + "\"); val v = "
            + compiler.name(decl)!
            + "("
            + aargs.join(", ")
            + "); val _d = rkDone(\""
            + compiler.name(decl)!
            + "\"); v }); }",
    );
    var handlers: Array<string> = [];
    compiler
        .methods(decl)
        .forEach({ m ->
            m.annotations.forEach({ a ->
                if (a.name == "exceptionHandler")
                    handlers.push(
                        "registerAdvice("
                            + a.args.join("")
                            + ", \""
                            + compiler.name(decl)!
                            + "."
                            + m.name
                            + "\", { detail -> "
                            + compiler.name(decl)!
                            + ".make()."
                            + m.name
                            + "(detail) });",
                    );
            });
        });
    if (handlers.length > 0) {
        compiler.addMember("pub fn rkAdvice() { " + handlers.join(" ") + " }");
        compiler.init({ -> decl.rkAdvice(); });
    }
    if (compiler.kind(decl) != DeclKind.Type)
        compiler.fail("#[controllerAdvice] must annotate a type", at: decl);
    if (compiler.variants(decl).length > 0)
        compiler.fail(
            "#[controllerAdvice] must annotate a type with fields, not an enum",
            at: decl,
        );
}

// The tag is a STRING, not a type name. botopink has no typed raise and no
// user-visible catch of one, so there is nothing for a type to key on; the
// front's first language-gap row says so rather than pretending otherwise.
pub fn exceptionHandler(syntax decl: unknown, comptime tag: string) {
    if (compiler.kind(decl) != DeclKind.Method)
        compiler.fail(
            "#[exceptionHandler] must annotate a method of a #[controllerAdvice] type",
            at: decl,
        );
}

// ── the built-in entries ────────────────────────────────────────────────────

pub fn requestIdHeader() -> string {
    return "X-Request-Id";
}

// Order −400: the first thing in the chain, so every later entry and every log
// line can name the same request. An incoming id is HONOURED — a proxy that
// already correlated the request is the authority — and the id is echoed on the
// response whichever way it was obtained.
pub fn requestIdEntry(req: WebRequest, chain: Chain) -> Response {
    val incoming: string = req.header("x-request-id");
    val id: string = if (incoming != "") incoming else rkFreshId();
    val res: Response = chain.next(req);
    return withHeader(res, requestIdHeader(), id);
}

// ── the boot ────────────────────────────────────────────────────────────────
//
// The built-ins are installed by a CALL rather than by a module-level `val`, so
// a test can reset the chain and rebuild it, and so an application says when
// its web layer starts. `bootWeb()` also validates the global CORS policy —
// `*` with credentials fails HERE, at boot, not on the first cross-origin
// request — and hands the runner to the host so front 04's `dispatch_http/5`
// finds it.

pub fn installBuiltins() -> i32 {
    val _r = registerFilter(
        "request-id",
        orderRequestId(),
        { req, chain -> requestIdEntry(req, chain) },
    );
    val _c = registerFilter(
        "cors",
        orderCors(),
        { req, chain -> corsEntry(req, chain) },
    );
    val _a = registerFilter(
        "api-version",
        orderApiVersion(),
        { req, chain -> apiVersionEntry(req, chain) },
    );
    val _e = registerFilter(
        "problem",
        orderProblem(),
        { req, chain -> errorEntry(req, chain) },
    );
    val _z = registerFilter(
        "compression",
        orderCompression(),
        { req, chain -> compressionEntry(req, chain) },
    );
    val _n = registerFilter(
        "negotiation",
        orderNegotiation(),
        { req, chain -> negotiationEntry(req, chain) },
    );
    val _s = registerFilter(
        "server-id",
        orderServerId(),
        { req, chain -> serverIdEntry(req, chain) },
    );
    val _v = installConverters();
    return 7;
}

pub fn bootWeb() -> i32 {
    val _v = validatePolicy(globalPolicy());
    val _c = validateCompression();
    val _w = runCustomizers();
    val _b = installBuiltins();
    return rkChainSetRunner({ method, path, headersWire, queryWire, body ->
        runChain(method, path, headersWire, queryWire, body)
    });
}

// `rakun.web.error-path` and the page resolution order live in `error.bp`
// (`errorPagePath`, `errorPageFiles`, `staticPage`) since step 5 landed.
