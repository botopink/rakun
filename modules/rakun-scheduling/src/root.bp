//// rakun-scheduling — module-tree root.
////
//// Front 16 (in-VM scheduling): `cron` (the six-field parser and the calendar
//// walk), `registry` (the task table and its three seams), `markers`
//// (`#[scheduler]`, `#[scheduled]`, `#[fixedRate]`, `#[fixedDelay]`),
//// `executor` (configuration, the supervised timers and per-run workers, start
//// and stop), `endpoint` (`scheduledtasks` and the `scheduling` indicator).
//// Front 84 appends `src/jobstore/**` (the durable, cluster-coordinated store)
//// behind this registry; a task here lives in one node's memory, and every node
//// of a cluster runs its own copy.
////
//// The order is a DEPENDENCY order and `botopink.json`'s `files` repeats it.

pub mod cron;
pub mod registry;
pub mod markers;
pub mod executor;
pub mod endpoint;
