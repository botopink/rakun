//// rakun-scheduling — firing durable triggers once across a cluster (front 84
//// steps 3, 4 and 5).
////
//// `tickOn(ds, node)` is one pass of one node. Every node runs the same pass
//// against the same store; the store is the only coordination:
////
////   1. an `acquired` trigger whose lease has passed is taken over with a
////      conditional UPDATE on its old owner — one winner — and the takeover is
////      a history row naming the dead owner;
////   2. each due `waiting` trigger is claimed with a conditional UPDATE
////      (`state = 'acquired'`, `owner`, `lease_until`) — the portable form of
////      `FOR UPDATE SKIP LOCKED`: a node that loses the claim does nothing;
////   3. the claimed trigger's windows run (the misfire policy decides which),
////      each through the handler with its retries, and the trigger goes back
////      to `waiting` with its next fire time — only if this node still owns it.
////
//// AT-LEAST-ONCE. A node that completes the work and dies before step 3's
//// final UPDATE leaves the trigger `acquired`; after the lease another node
//// takes it over and runs it again. A handler whose side effects must happen
//// once enrols them in front 83's outbox. A handler that outlives the lease
//// renews it every `lease-ms / 3` of wall time while it runs.
////
//// MISFIRES. A trigger is misfired when more than one of its windows passed,
//// or its one window is older than `rakun.scheduling.jobstore.misfire-threshold-ms`
//// (60000). Its declared policy decides: `FireNow` runs once, `SkipToNext`
//// runs nothing, `FireAll` runs each missed window in order up to
//// `rakun.scheduling.jobstore.fire-all-ceiling` (10) and writes an `error`
//// history row naming how many it skipped. There is no global override.
////
//// RETRIES. A raising handler is retried `retries` times, `backoffMs` apart;
//// retries stop as soon as the trigger's next window is due (a job never
//// spends its next window retrying the previous one), and the execution is
//// `failed` with the reason. The schedule continues either way.
////
//// AN UNREACHABLE STORE is logged once per `rakun.scheduling.jobstore.interval-ms`
//// (1000) per node, and the next pass that reaches it logs the recovery.

import {rkProp, toI32} from "rakun";
import {param, Row, Rows, sqlTemplate} from "rakun-data";
import {jobClock, cronAfter, formatInstant, runJobHandler, jobStatusOn} from "jobstore/store";

#[@External.Erlang("""(fun(__Ms) -> timer:sleep(__Ms), 0 end)($0)""")]
declare fn pause(ms: i32) -> i32;
#[@External.Erlang("""erlang:unique_integer([positive, monotonic])""")]
declare fn freshId() -> i32;
#[@External.Erlang("""(fun(__F) -> try {ok, __F()} catch _:{panic, __R} when is_binary(__R) -> {error, __R}; _:__R -> {error, iolist_to_binary(io_lib:format("~p", [__R]))} end end)($0)""")]
declare fn guarded(work: fn() -> i32) -> @Result<i32, string>;
#[@External.Erlang("""(fun(__W, __Renew, __Ms) -> __Me = self(), __Ref = make_ref(), {__P, __M} = spawn_monitor(fun() -> __Me ! {__Ref, try {ok, __W()} catch _:{panic, __E} when is_binary(__E) -> {error, __E}; _:__E -> {error, iolist_to_binary(io_lib:format("~p", [__E]))} end} end), __Wait = fun __Wt() -> receive {__Ref, __Res} -> erlang:demonitor(__M, [flush]), __Res; {'DOWN', __M, process, __P, __Why} -> {error, iolist_to_binary(io_lib:format("~p", [__Why]))} after __Ms -> _ = __Renew(), __Wt() end end, __Wait() end)($0, $1, $2)""")]
declare fn runRenewing(work: fn() -> string, renew: fn() -> i32, everyMs: i32) -> @Result<string, string>;
#[@External.Erlang("""(fun(__N) -> case persistent_term:get({rakun_job_kill, __N}, false) of true -> persistent_term:erase({rakun_job_kill, __N}), exit(self(), kill); _ -> 0 end end)($0)""")]
declare fn killHook(node: string) -> i32;
#[@External.Erlang("""(fun(__N) -> persistent_term:put({rakun_job_kill, __N}, true), 0 end)($0)""")]
pub declare fn killAfterAcquire(node: string) -> i32;
#[@External.Erlang("""(fun(__N, __Every) -> erlang:phash2(__N, erlang:max(1, __Every div 4)) end)($0, $1)""")]
declare fn phash(node: string, every: i32) -> i32;
#[@External.Erlang("""(fun(__N, __T, __Ms) -> __P = spawn(fun() -> __Go = fun __G() -> _ = (try __T() catch _:_ -> 0 end), receive stop -> ok after __Ms -> __G() end end, __Go() end), persistent_term:put({rakun_job_loop, __N}, __P), 0 end)($0, $1, $2)""")]
declare fn spawnLoop(node: string, tick: fn() -> i32, everyMs: i32) -> i32;
#[@External.Erlang("""(fun(__N) -> case persistent_term:get({rakun_job_loop, __N}, undefined) of undefined -> 0; __P -> __P ! stop, persistent_term:erase({rakun_job_loop, __N}), 1 end end)($0)""")]
pub declare fn stopJobScheduler(node: string) -> i32;
#[@External.Erlang("""(fun(__K) -> persistent_term:get({rakun_job_down, __K}, -1) end)($0)""")]
declare fn downSince(node: string) -> i32;
#[@External.Erlang("""(fun(__K, __T) -> case __T of -1 -> persistent_term:erase({rakun_job_down, __K}); _ -> persistent_term:put({rakun_job_down, __K}, __T) end, 0 end)($0, $1)""")]
declare fn setDownSince(node: string, at: i32) -> i32;
#[@External.Erlang("""(fun(__T) -> logger:warning("~ts", [__T]), persistent_term:put(rakun_job_log, persistent_term:get(rakun_job_log, []) ++ [__T]), 0 end)($0)""")]
declare fn logLine(line: string) -> i32;
#[@External.Erlang("""persistent_term:get(rakun_job_log, [])""")]
pub declare fn jobLog() -> string[];

fn intProp(key: string, fallback: i32) -> i32 {
    val raw = rkProp(key).trim();
    return if (raw == "") fallback else toI32(raw);
}

pub fn leaseMs() -> i32 { return intProp("rakun.scheduling.jobstore.lease-ms", 60000); }
pub fn intervalMs() -> i32 { return intProp("rakun.scheduling.jobstore.interval-ms", 1000); }
fn misfireThreshold() -> i32 { return intProp("rakun.scheduling.jobstore.misfire-threshold-ms", 60000); }
fn fireAllCeiling() -> i32 { return intProp("rakun.scheduling.jobstore.fire-all-ceiling", 10); }

// This node's offset added to every interval: stable per node, in
// [0, interval / 4), so N nodes do not query at one instant.
pub fn jitterMs(node: string, interval: i32) -> i32 {
    return phash(node, interval);
}

// ── history ─────────────────────────────────────────────────────────────────

fn history(ds: string, job: string, trig: string, node: string, window: i32, started: i32, outcome: string, detail: string) -> i32 {
    return sqlTemplate(ds).update("INSERT INTO rakun_job_history (id, job, trig, node, window_at, started, ended, outcome, detail) VALUES (:id, :j, :t, :n, :w, :s, :e, :o, :d)", [
        param("id", freshId().toString()), param("j", job), param("t", trig), param("n", node), param("w", window.toString()),
        param("s", started.toString()), param("e", jobClock().toString()), param("o", outcome), param("d", detail),
    ]);
}

pub type Execution(job: string, trigger: string, node: string, window: i32, started: i32, ended: i32, outcome: string, detail: string)

fn executionOf(r: Row) -> Execution {
    return Execution(job: r.get("job"), trigger: r.get("trig"), node: r.get("node"), window: r.int("window_at"), started: r.int("started"), ended: r.int("ended"), outcome: r.get("outcome"), detail: r.get("detail"));
}

// Every history row of `job`, oldest first.
pub fn executionsOf(ds: string, job: string) -> Execution[] {
    val rows: Rows = sqlTemplate(ds).query("SELECT id, job, trig, node, window_at, started, ended, outcome, detail FROM rakun_job_history WHERE job = :j ORDER BY id", [param("j", job)]);
    return rows.toList().map({ r -> executionOf(r) });
}

// One line per history row: `<outcome> owner=<node> window=<instant> <detail>`.
pub fn historyOf(ds: string, job: string) -> string[] {
    return executionsOf(ds, job).map({ e ->
        val window = if (e.window > 0) { formatInstant(e.window) } else { "-" };
        return e.outcome + " owner=" + e.node + " window=" + window + " " + e.detail;
    });
}

// Deletes at most `batch` rows that ended more than `retentionMs` ago.
pub fn pruneHistory(ds: string, retentionMs: i32, batch: i32) -> i32 {
    val sql = sqlTemplate(ds);
    val cutoff = jobClock() - retentionMs;
    val rows: Rows = sql.query("SELECT id, ended FROM rakun_job_history ORDER BY id", []);
    val old = rows.toList().filter({ r -> r.int("ended") <= cutoff }).slice(0, batch);
    var n = 0;
    for (old) { r -> n = n + sql.update("DELETE FROM rakun_job_history WHERE id = :id", [param("id", r.get("id"))]); };
    return n;
}

// ── one pass ────────────────────────────────────────────────────────────────

fn renew(ds: string, trig: string, node: string) -> i32 {
    return sqlTemplate(ds).update("UPDATE rakun_job_trigger SET lease_until = :l WHERE name = :n AND owner = :me AND state = 'acquired'", [param("l", (jobClock() + leaseMs()).toString()), param("n", trig), param("me", node)]);
}

// The windows of `cron` from `first` up to `now`, at most `cap` listed;
// `total` counts every one (up to 100000).
pub type Windows(listed: i32[], total: i32)

pub fn windowsUpTo(cron: string, first: i32, now: i32, cap: i32) -> Windows {
    var out: i32[] = [];
    var w = first;
    var total = 0;
    while (w >= 0 && w <= now && total < 100000) {
        if (out.length < cap) out.push(w);
        total = total + 1;
        w = cronAfter(cron, w);
    };
    return Windows(listed: out, total: total);
}

fn execute(ds: string, node: string, trig: string, job: string, data: string, cron: string, window: i32, retries: i32, backoff: i32) -> i32 {
    val nextWindow = cronAfter(cron, window);
    var attempt = 1;
    var done = false;
    while (done == false) {
        val started = jobClock();
        val r = runRenewing({ -> runJobHandler(job, data) }, { -> renew(ds, trig, node) }, leaseMs() / 3);
        if (r.isOk()) {
            val _h = history(ds, job, trig, node, window, started, "success", "attempt=" + attempt.toString() + " result=" + r.unwrapOr(""));
            done = true;
        } else {
            val reason = case r { Ok(v) -> ""; Error(e) -> e; };
            val _h = history(ds, job, trig, node, window, started, "failed", "attempt=" + attempt.toString() + " reason=" + reason);
            if (attempt > retries) {
                done = true;
            } else if (nextWindow >= 0 && jobClock() >= nextWindow) {
                val _a = history(ds, job, trig, node, window, jobClock(), "abandoned", "retries stop: the next window " + formatInstant(nextWindow) + " is due");
                done = true;
            } else {
                val _p = pause(backoff);
                attempt = attempt + 1;
            };
        };
    };
    return 1;
}

fn fire(ds: string, node: string, trig: string) -> i32 {
    val sql = sqlTemplate(ds);
    val tr: Rows = sql.query("SELECT name, job, cron, end_at, misfire, retries, backoff_ms, next_fire FROM rakun_job_trigger WHERE name = :n", [param("n", trig)]);
    val t = tr.first() ?? Row(columns: [], values: []);
    val job = t.get("job");
    val jr: Rows = sql.query("SELECT data, state FROM rakun_job WHERE name = :n", [param("n", job)]);
    val j = jr.first() ?? Row(columns: ["data", "state"], values: ["", "orphaned"]);
    val now = jobClock();
    val cron = t.get("cron");
    val first = t.int("next_fire");
    val ceiling = fireAllCeiling();
    val ws = windowsUpTo(cron, first, now, ceiling);
    val misfired = ws.total > 1 || now - first > misfireThreshold();
    val policy = t.get("misfire");
    var toRun: i32[] = [];
    if (misfired == false) {
        toRun = [first];
    } else if (policy == "FireNow") {
        toRun = [ws.listed.at(ws.listed.length - 1) ?? first];
    } else if (policy == "FireAll") {
        toRun = ws.listed;
        if (ws.total > ceiling) {
            val _e = history(ds, job, trig, node, first, now, "error", "FireAll ceiling " + ceiling.toString() + " reached - " + (ws.total - ceiling).toString() + " missed windows skipped");
        };
    } else {
        val _s = history(ds, job, trig, node, first, now, "misfire-skipped", ws.total.toString() + " missed windows skipped (SkipToNext)");
    };
    var ran = 0;
    if (j.get("state") != "orphaned") {
        for (toRun) { w -> ran = ran + execute(ds, node, trig, job, j.get("data"), cron, w, t.int("retries"), t.int("backoff_ms")); };
    };
    val next = cronAfter(cron, jobClock());
    val endAt = t.int("end_at");
    val state = if (endAt > 0 && (next < 0 || next > endAt)) "complete" else "waiting";
    val _u = sql.update("UPDATE rakun_job_trigger SET state = :s, owner = '', lease_until = 0, next_fire = :f, prev_fire = :p WHERE name = :n AND owner = :me", [param("s", state), param("f", next.toString()), param("p", now.toString()), param("n", trig), param("me", node)]);
    return ran;
}

fn tickBody(ds: string, node: string) -> i32 {
    val sql = sqlTemplate(ds);
    val now = jobClock();
    val lease = (now + leaseMs()).toString();
    var mine: string[] = [];
    val acquired: Rows = sql.query("SELECT name, job, owner, lease_until FROM rakun_job_trigger WHERE state = 'acquired'", []);
    for (acquired.toList()) { r ->
        if (r.int("lease_until") < now) {
            val got = sql.update("UPDATE rakun_job_trigger SET owner = :me, lease_until = :l WHERE name = :n AND state = 'acquired' AND owner = :old", [param("me", node), param("l", lease), param("n", r.get("name")), param("old", r.get("owner"))]);
            if (got == 1) {
                val _h = history(ds, r.get("job"), r.get("name"), node, 0, now, "takeover", "from " + r.get("owner") + ", whose lease ended " + formatInstant(r.int("lease_until")));
                mine.push(r.get("name"));
            };
        };
    };
    val waiting: Rows = sql.query("SELECT name, next_fire, start_at FROM rakun_job_trigger WHERE state = 'waiting' ORDER BY next_fire", []);
    for (waiting.toList()) { r ->
        val due = r.int("next_fire") >= 0 && r.int("next_fire") <= now && r.int("start_at") <= now;
        if (due) {
            val got = sql.update("UPDATE rakun_job_trigger SET state = 'acquired', owner = :me, lease_until = :l WHERE name = :n AND state = 'waiting'", [param("me", node), param("l", lease), param("n", r.get("name"))]);
            if (got == 1) mine.push(r.get("name"));
        };
    };
    if (mine.length > 0) {
        val _k = killHook(node);
    };
    var fired = 0;
    for (mine) { n -> fired = fired + fire(ds, node, n); };
    return fired;
}

// One pass of `node`; answers how many executions ran (0 when the store was
// unreachable).
pub fn tickOn(ds: string, node: string) -> i32 {
    val r = guarded({ -> tickBody(ds, node) });
    val since = downSince(node);
    if (r.isOk()) {
        if (since >= 0) {
            val _l = logLine("rakun-scheduling: node " + node + " reaches the job store again");
            val _c = setDownSince(node, -1);
        };
        return r.unwrapOr(0);
    };
    val reason = case r { Ok(v) -> ""; Error(e) -> e; };
    val now = jobClock();
    if (since < 0 || now - since >= intervalMs()) {
        val _l = logLine("rakun-scheduling: node " + node + " cannot reach the job store - " + reason);
        val _s = setDownSince(node, now);
    };
    return 0;
}

// A supervised loop: `tickOn` every interval plus this node's jitter.
pub fn startJobScheduler(ds: string, node: string) -> i32 {
    val every = intervalMs() + jitterMs(node, intervalMs());
    return spawnLoop(node, { -> tickOn(ds, node) }, every);
}
