//// rakun-scheduling — `#[persistentJob]` and `#[jobs]` (front 84 step 2).
////
////   #[service]
////   #[jobs]
////   pub type Billing(...) {
////       #[persistentJob("nightly-invoices", "0 0 3 * * *")]
////       pub fn runInvoices(self: Self, data: string) -> string { ... }
////   }
////
//// `#[persistentJob(name, cron)]` takes front 16's six-field cron, positionally
//// like every rakun decorator. It refuses, at the declaration, anything that is
//// not a method and a method whose signature is not
//// `(self: Self, data: string) -> string`. `#[jobs]` on the type adds a member
//// `<Type>.rkJobs()` (run before `main` by an executor) calling, per such method, `rkPersistentJob("<name>", "<cron>", { data ->
//// <Type>.make().<fn>(data) })` — the handler registration — so the
//// consumer imports `rkPersistentJob` beside the markers. A method `@Decl`
//// carries no parameter list, so the parameter half of the signature rule is
//// checked by `#[jobs]` (reported at the type, naming the method); the return
//// type is checked at the method. The cron is checked
//// by `cron.bp`'s parser when that line runs; the trigger that fires the job
//// (its misfire policy, retries, start and end) is a `Trigger` value passed to
//// `registerTrigger`, where an operator can read it.
////

import {compiler, compiler.DeclKind} from "std";

pub fn persistentJob(
    expr decl: unknown,
    comptime name: string,
    comptime cron: string,
) {
    if (compiler.kind(decl) != DeclKind.Method)
        compiler.fail("#[persistentJob] must annotate a method of a #[jobs] type", at: decl);
    if (compiler.returnType(decl) != "string")
        compiler.fail(
            "#[persistentJob(\""
                + name
                + "\")] "
                + compiler.name(decl)!
                + " returns `"
                + compiler.returnType(decl)
                + "` - a persistent job returns string, recorded with each execution",
            at: decl,
        );
    if (name.trim() == "")
        compiler.fail(
            "#[persistentJob] needs a job name - the store keys the job and its history by it",
            at: decl,
        );
}

pub fn jobs(expr decl: unknown) {
    var stereotype = "";
    compiler.annotations(decl).forEach({ a ->
        val isStereo = a.name == "component"
            || a.name == "service"
            || a.name == "repository"
            || a.name == "controller"
            || a.name == "restController"
            || a.name == "configuration";
        val st = if (isStereo) a.name else stereotype;
        stereotype = st;
    });
    var found = 0;
    var problem = "";
    var handlers: Array<string> = [];
    compiler.methods(decl).forEach({ m ->
        var args = "";
        var marked = false;
        m.annotations.forEach({ a ->
            val isJob = a.name == "persistentJob";
            val nextArgs = if (isJob) a.args.join(", ") else args;
            args = nextArgs;
            val mk = if (isJob) true else marked;
            marked = mk;
        });
        val f = if (marked) found + 1 else found;
        found = f;
        var count = 0;
        var dataType = "";
        m.params.forEach({ p ->
            val c = count + 1;
            count = c;
            val d = if (c == 2) p.typeName else dataType;
            dataType = d;
        });
        val badSig = marked
            && (problem == "")
            && ((count != 2)
                || (dataType != "string")
                || (m.returnType != "string"));
        val withSig = if (badSig)
            "#[jobs] "
                + compiler.name(decl)!
                + "."
                + m.name
                + " carries #[persistentJob] and is not (self: Self, data: string) -> string - the store hands a job its data and records the string it answers"
        else
            problem;
        problem = withSig;
        if (marked && (problem == ""))
            handlers.push(
                "rkPersistentJob("
                    + args
                    + ", { data -> "
                    + compiler.name(decl)!
                    + ".make()."
                    + m.name
                    + "(data) });",
            );
    });
    if (handlers.length > 0) {
        compiler.addMember("pub fn rkJobs() { " + handlers.join(" ") + " }");
        compiler.compile({ -> decl.rkJobs(); });
    }
    if (compiler.kind(decl) != DeclKind.Type) compiler.fail("#[jobs] must annotate a type", at: decl);
    if (stereotype == "")
        compiler.fail(
            "#[jobs] needs a stereotype on the same type (#[component], #[service], …) - the stereotype emits the singleton factory each job's handler builds the component through",
            at: decl,
        );
    if (found == 0)
        compiler.fail(
            "#[jobs] on "
                + compiler.name(decl)!
                + " finds no method carrying #[persistentJob]",
            at: decl,
        );
    if (problem != "") compiler.fail(problem, at: decl);
}
