//// rakun-scheduling — `#[persistentJob]` and `#[jobs]` (front 84 step 2).
////
////   #[service]
////   #[jobs]
////   pub type Billing(...) {
////       #[persistentJob("nightly-invoices", "0 0 3 * * *")]
////       pub fn runInvoices(self: Self, data: string) -> string { ... }
////   }
////
//// `#[persistentJob(name, cron)]` takes front 16's six-field cron, positionally
//// like every rakun decorator. It refuses, at the declaration, anything that is
//// not a method and a method whose signature is not
//// `(self: Self, data: string) -> string`. `#[jobs]` on the type emits, per
//// such method, `rkPersistentJob("<name>", "<cron>", { data ->
//// <Type>.make().<fn>(data) })` — the handler registration — so the
//// consumer imports `rkPersistentJob` beside the markers. A method `@Decl`
//// carries no parameter list, so the parameter half of the signature rule is
//// checked by `#[jobs]` (reported at the type, naming the method); the return
//// type is checked at the method. The cron is checked
//// by `cron.bp`'s parser when that line runs; the trigger that fires the job
//// (its misfire policy, retries, start and end) is a `Trigger` value passed to
//// `registerTrigger`, where an operator can read it.
////

pub fn persistentJob(comptime decl: @Decl, name: string, cron: string) {
    if (decl.kind != DeclKind.Method) decl.fail("#[persistentJob] must annotate a method of a #[jobs] type");
    if (decl.returnType != "string") decl.fail("#[persistentJob(\"" + name + "\")] " + decl.name + " returns `" + decl.returnType + "` - a persistent job returns string, recorded with each execution");
    if (name.trim() == "") decl.fail("#[persistentJob] needs a job name - the store keys the job and its history by it");
}

pub fn jobs(comptime decl: @Decl) {
    var stereotype = "";
    decl.annotations.forEach({ a ->
        val isStereo = a.name == "component" || a.name == "service" || a.name == "repository" || a.name == "controller" || a.name == "restController" || a.name == "configuration";
        val st = if (isStereo) a.name else stereotype;
        stereotype = st;
    });
    var found = 0;
    var problem = "";
    decl.methods.forEach({ m ->
        var args = "";
        var marked = false;
        m.annotations.forEach({ a ->
            val isJob = a.name == "persistentJob";
            val nextArgs = if (isJob) a.args.join(", ") else args;
            args = nextArgs;
            val mk = if (isJob) true else marked;
            marked = mk;
        });
        val f = if (marked) found + 1 else found;
        found = f;
        var count = 0;
        var dataType = "";
        m.params.forEach({ p ->
            val c = count + 1;
            count = c;
            val d = if (c == 2) p.typeName else dataType;
            dataType = d;
        });
        val badSig = marked && (problem == "") && ((count != 2) || (dataType != "string") || (m.returnType != "string"));
        val withSig = if (badSig) "#[jobs] " + decl.name + "." + m.name + " carries #[persistentJob] and is not (self: Self, data: string) -> string - the store hands a job its data and records the string it answers" else problem;
        problem = withSig;
        if (marked && (problem == "")) @emit("val __rkJob_" + decl.name + "_" + m.name + " = rkPersistentJob(" + args + ", { data -> " + decl.name + ".make()." + m.name + "(data) });");
    });
    if (decl.kind != DeclKind.Type) decl.fail("#[jobs] must annotate a type");
    if (stereotype == "") decl.fail("#[jobs] needs a stereotype on the same type (#[component], #[service], …) - the stereotype emits the singleton factory each job's handler builds the component through");
    if (found == 0) decl.fail("#[jobs] on " + decl.name + " finds no method carrying #[persistentJob]");
    if (problem != "") decl.fail(problem);
}
