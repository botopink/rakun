//// rakun-web — module-tree root.
////
//// The member front 07 fills: ONE ordered chain between the socket and the
//// route handler, its two entry points, and the error shape everything above it
//// produces. Reached by a consumer via `import {…} from "rakun-web"`.
////
//// The order here is a DEPENDENCY order and `botopink.json`'s `files` repeats
//// it, because a consumer's build reads that list literally: a module listed
//// before a sibling it imports reds with `unbound variable` inside rakun-web's
//// own source. `filter` first (it imports only `rakun`), then `error`,
//// `middleware` and `cors` (each imports `filter`), then `convention` (which
//// imports all three).
////
//// Two later fronts append to this list and reorder nothing: front 20 adds
//// `pub mod websocket;` and front 65 adds `pub mod rules;`, in front-number
//// order (`specs/1.0.10-beta/03-rakun/07-rakun-middleware` § Contradictions).

pub mod filter;
// Front 07 steps 5 and 6: the `Accept` reader. Pure, imports only `rakun`, and
// `error` imports it — so it sits right after `filter`.
pub mod negotiation;
pub mod error;
pub mod middleware;
pub mod cors;
// Front 07 step 9: compression and server identification, the late end of the
// band. It imports `filter` only, and `convention` installs it — so it sits
// before `convention`, which is the dependency order this list must keep.
pub mod compression;
// Front 07 step 7: `WebRegistry` and the customizer pass. It imports `filter`,
// `negotiation` and `cors`, and `convention` runs it.
pub mod customizer;
// Front 07 step 8: the API-version entry. It imports `filter` and `error`.
pub mod apiversion;
// Front 07 step 10: the graceful-shutdown sequence. It imports only `rakun`.
pub mod shutdown;
pub mod convention;
// Front 74's TLS seam closes the list: it imports `filter` (the chain entry, the
// per-request signal table and `withHeader`) and the core's bundle registry, and
// nothing in this member imports it.
pub mod tls;
// Front 65: URL rules — one chain entry at −250. It imports `filter`.
pub mod rules;
