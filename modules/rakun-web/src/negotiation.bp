//// rakun-web — `Accept` negotiation (front 07 steps 5 and 6).
////
//// One reader of a media-range list with q-values (RFC 9110 § 12.5.1), shared
//// by the static error pages (step 5: does this client want HTML?) and the
//// message converters (step 6: which media type does the response take?).
//// A q-value is read in THOUSANDTHS, as `compression.bp` reads
//// `Accept-Encoding`: at most three decimals, so every comparison is integral.
//// The most specific matching range wins for a media type: `text/html` over
//// `text/*` over `*/*`. An absent `Accept` means `*/*`.

import {Response, toI32} from "rakun";
import {WebRequest, Chain, withHeader, headerValue, sentinelStatus} from "filter";
import {json} from "std";

pub fn rangeQ(raw: string) -> i32 {
    val t: string = raw.trim();
    if (t == "") return 1000;
    val parts: string[] = t.split(".");
    val whole: string = parts.at(0) ?? "";
    val frac: string = (parts.at(1) ?? "") + "000";
    if ((whole != "0") && (whole != "1")) return 0;
    val q: i32 = toI32(whole) * 1000 + toI32(frac.slice(0, 3));
    if (q > 1000) return 0 else return q;
}

fn baseOf(range: string) -> string {
    return (range.split(";").at(0) ?? "").trim().toLower();
}

fn qOf(range: string) -> i32 {
    var q = 1000;
    for (range.split(";")) { p ->
        val kv: string = p.trim().toLower();
        if (kv.startsWith("q=")) q = rangeQ(kv.slice(2, kv.length));
    };
    return q;
}

// 3 for an exact match, 2 for `type/*`, 1 for `*/*`, 0 for none.
fn specificity(range: string, mediaType: string) -> i32 {
    val want: string = mediaType.toLower();
    if (range == want) return 3;
    val slash: i32 = want.indexOf("/");
    val family: string = if (slash < 0) want else want.slice(0, slash);
    if (range == family + "/*") return 2;
    if (range == "*/*") return 1;
    return 0;
}

// The q-value `accept` gives `mediaType`, through its most specific range.
pub fn mediaQuality(accept: string, mediaType: string) -> i32 {
    val header: string = if (accept.trim() == "") "*/*" else accept;
    var bestSpec = 0;
    var q = 0;
    for (header.split(",")) { range ->
        val base: string = baseOf(range);
        val spec: i32 = specificity(base, mediaType);
        if (spec > bestSpec) {
            bestSpec = spec;
            q = qOf(range);
        };
    };
    return q;
}

// The media type `accept` prefers among `offered`, or `""` when it accepts none
// of them. Ties go to the order of `offered`.
pub fn negotiate(accept: string, offered: string[]) -> string {
    var best = "";
    var bestQ = 0;
    for (offered) { m ->
        val q: i32 = mediaQuality(accept, m);
        if (q > bestQ) {
            best = m;
            bestQ = q;
        };
    };
    return best;
}

// A browser asking for a page: HTML acceptable, and preferred to JSON.
pub fn prefersHtml(accept: string) -> bool {
    return negotiate(accept, ["text/html", "application/json"]) == "text/html";
}

// ── message converters (step 6) ─────────────────────────────────────────────
//
// A converter is a media type and two functions over strings: `write` shapes a
// handler's body for the wire, `read` checks (and may normalise) a request body
// before the handler sees it, answering an `Error` to refuse it. botopink has
// no run-time type descriptor to dispatch on, so there is no `canWrite(type)`:
// a handler's `Response` body is already a string, and the converter's real
// job is choosing the media type and the shape — a narrowing of Spring's
// `HttpMessageConverter`, stated rather than hidden. The registry is keyed by
// media type in `rakun_chain.erl`; registering a type twice REPLACES the
// converter and keeps its place, so an application's converter wins for its
// media type. `text/plain` (the identity) is registered first and
// `application/json` second, so `Accept: */*` — curl's default — keeps a
// handler's text as text.

#[@External.Erlang("rakun_chain", "converter_register")]
pub declare fn rkConverterRegister(
    media: string,
    write: fn(value: string) -> string,
    read: fn(body: string) -> @Result<string, string>,
) -> i32;

#[@External.Erlang("rakun_chain", "converter_media")]
pub declare fn rkConverterMedia() -> string;

#[@External.Erlang("rakun_chain", "converter_write")]
pub declare fn rkConverterWrite(media: string, value: string) -> string;

#[@External.Erlang("rakun_chain", "converter_read")]
pub declare fn rkConverterRead(media: string, body: string) -> @Result<string, string>;

#[@External.Erlang("rakun_chain", "converter_reset")]
pub declare fn rkConverterReset() -> i32;

pub fn converterMediaTypes() -> string[] {
    val wire: string = rkConverterMedia();
    if (wire == "") return [] else return wire.split("\n");
}

pub fn registerConverter(
    media: string,
    write: fn(value: string) -> string,
    read: fn(body: string) -> @Result<string, string>,
) -> i32 {
    if (media.indexOf("/") <= 0) @panic("rakun-web: a message converter needs a media type like `application/json`, not `" + media + "`");
    return rkConverterRegister(media.toLower(), write, read);
}

// The JSON converter's two halves. A body that already IS a JSON document is
// written as it is; any other text becomes a JSON string. A request body must
// be one RFC 8259 document (std's `json.decode`), or the request is refused.
pub fn jsonWrite(value: string) -> string {
    if (json.decode(value).isOk()) return value else return json.quote(value);
}

pub fn jsonRead(body: string) -> @Result<string, string> {
    val parsed = json.decode(body);
    if (parsed.isError()) {
        val assert Error(e) = parsed;
        throw "the request body is not JSON: " + e;
    };
    return body;
}

pub fn textRead(body: string) -> @Result<string, string> {
    return body;
}

pub fn installConverters() -> i32 {
    val _t = registerConverter("text/plain", { v -> v }, { b -> textRead(b) });
    return registerConverter("application/json", { v -> jsonWrite(v) }, { b -> jsonRead(b) });
}

fn readBody(inType: string, body: string) -> @Result<string, string> {
    if ((inType == "") || (body == "")) return body;
    val decoded: string = try rkConverterRead(inType, body);
    return decoded;
}

fn mediaOf(contentType: string) -> string {
    return (contentType.split(";").at(0) ?? "").trim().toLower();
}

// The entry, at order 250. On the way IN a body is read by the converter its
// `Content-Type` names (a type nobody registered passes through untouched); a
// refusal answers 400. On the way OUT a response that set no `Content-Type`
// and carries a body gets the media type `Accept` prefers among the registered
// ones, written by that converter; an `Accept` that admits none of them
// answers 406.
pub fn negotiationEntry(req: WebRequest, chain: Chain) -> Response {
    val inType: string = mediaOf(req.header("content-type"));
    val read = readBody(inType, req.body);
    if (read.isError()) {
        val assert Error(why) = read;
        return Response.badRequest(why);
    };
    val decoded: WebRequest = WebRequest(
        method: req.method,
        path: req.path,
        target: req.target,
        headersWire: req.headersWire,
        queryWire: req.queryWire,
        body: read.unwrapOr(req.body),
    );
    val res: Response = chain.next(decoded);
    if (res.status == sentinelStatus()) return res;
    if (res.body == "") return res;
    if (headerValue("Content-Type") != "") return res;
    val chosen: string = negotiate(req.header("accept"), converterMediaTypes());
    if (chosen == "") return Response(status: 406, body: "");
    val _h = withHeader(res, "Content-Type", chosen);
    return Response(status: res.status, body: rkConverterWrite(chosen, res.body));
}
