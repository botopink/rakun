//// rakun-session — the `Set-Cookie` line. Front 18 step 4.
////
//// `HttpOnly` always; `Secure` whenever `SessionSettings.secure` (see
//// `session_config.bp` for its one structural exemption); `SameSite` Lax by
//// default, Strict or None when configured; `Path` and `Max-Age` from the
//// settings. No argument turns `HttpOnly` or `Secure` off.

import {SessionSettings} from "session_config";

pub fn sessionCookieHeader(s: SessionSettings, value: string) -> string {
    val secure: string = if (s.secure) "; Secure" else "";
    return s.cookieName + "=" + value + "; Path=" + s.cookiePath + "; Max-Age=" + s.timeoutSeconds.toString() + "; HttpOnly" + secure + "; SameSite=" + s.sameSite;
}

// The line that ends a session at the client: same name and path, no value,
// `Max-Age=0`, the same attributes.
pub fn expiredCookieHeader(s: SessionSettings) -> string {
    val secure: string = if (s.secure) "; Secure" else "";
    return s.cookieName + "=; Path=" + s.cookiePath + "; Max-Age=0; HttpOnly" + secure + "; SameSite=" + s.sameSite;
}

// The value of one cookie out of a `Cookie` header (`a=1; SESSION=x.y`), `""`
// when absent.
pub fn cookieFromHeader(header: string, name: string) -> string {
    var out = "";
    for (header.split(";")) { part ->
        val t: string = part.trim();
        val eq: i32 = t.indexOf("=");
        if (eq > 0) {
            if (t.slice(0, eq) == name) out = t.slice(eq + 1, t.length());
        };
    };
    return out;
}
