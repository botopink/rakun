//// rakun-session — the host cells over `src/sidecars/rakun_session.erl`.
////
//// The per-request slots, the installed repository, the ETS arm's table (owned
//// by a dedicated process), the counters a store double counts with, and the
//// Redis wire. Everything that DECIDES — the value, the ids, the signature,
//// the attributes, the arm, every refusal — is botopink, in the modules beside
//// this one.

import {compiler} from "std";

// ── per-request slots (the process dictionary) ─────────────────────────────

#[compiler.external(.Erlang("rakun_session:slot_put($0, $1)"))]
pub declare fn rkSessSlotPut(key: string, value: string) -> i32;

#[compiler.external(.Erlang("rakun_session:slot($0)"))]
pub declare fn rkSessSlot(key: string) -> string;

#[compiler.external(.Erlang("rakun_session:slots_clear()"))]
pub declare fn rkSessSlotsClear() -> i32;

#[compiler.external(.Erlang("rakun_session:put_current($0)"))]
pub declare fn rkSessPutCurrent<S>(session: S) -> i32;

#[compiler.external(.Erlang("rakun_session:current()"))]
declare fn rkSessCurrentRaw() -> unknown;

// The request's current session, as the `S` the caller names (668).
pub fn rkSessCurrent<S>(t: type<S>) -> ?S {
    val found = rkSessCurrentRaw();
    if (found is t) return found;
    return null;
}

#[compiler.external(.Erlang("rakun_session:clear_current()"))]
pub declare fn rkSessClearCurrent() -> i32;

// ── the installed repository (a `persistent_term`) ─────────────────────────

#[compiler.external(.Erlang("rakun_session:install_repo($0)"))]
pub declare fn rkSessInstallRepo<R>(repo: R) -> i32;

#[compiler.external(.Erlang("rakun_session:repo()"))]
declare fn rkSessRepoRaw() -> unknown;

// The installed repository, as the `R` the caller names (668).
pub fn rkSessRepo<R>(t: type<R>) -> ?R {
    val found = rkSessRepoRaw();
    if (found is t) return found;
    return null;
}

#[compiler.external(.Erlang("rakun_session:uninstall_repo()"))]
pub declare fn rkSessUninstallRepo() -> i32;

// ── counters ────────────────────────────────────────────────────────────────

#[compiler.external(.Erlang("rakun_session:bump($0)"))]
pub declare fn rkSessBump(key: string) -> i32;

#[compiler.external(.Erlang("rakun_session:count($0)"))]
pub declare fn rkSessCount(key: string) -> i32;

#[compiler.external(.Erlang("rakun_session:count_reset($0)"))]
pub declare fn rkSessCountReset(key: string) -> i32;

// ── the ETS arm's table ─────────────────────────────────────────────────────

#[compiler.external(.Erlang("rakun_session:ets_put($0, $1, $2, $3)"))]
pub declare fn rkSessEtsPut<S>(
    store: string,
    id: string,
    principal: string,
    session: S,
) -> i32;

#[compiler.external(.Erlang("rakun_session:ets_get($0, $1)"))]
declare fn rkSessEtsGetRaw(store: string, id: string) -> unknown;

// The row of `id` in `store`, as the `S` the caller names (668).
pub fn rkSessEtsGet<S>(t: type<S>, store: string, id: string) -> ?S {
    val found = rkSessEtsGetRaw(store, id);
    if (found is t) return found;
    return null;
}

#[compiler.external(.Erlang("rakun_session:ets_delete($0, $1)"))]
pub declare fn rkSessEtsDelete(store: string, id: string) -> i32;

#[compiler.external(.Erlang("rakun_session:ets_by_principal($0, $1)"))]
declare fn rkSessEtsByPrincipalRaw(store: string, principal: string) -> unknown[];

// The rows of `principal` in `store` that are an `S` (668).
pub fn rkSessEtsByPrincipal<S>(t: type<S>, store: string, principal: string) -> S[] {
    var out: S[] = [];
    for (rkSessEtsByPrincipalRaw(store, principal)) { row ->
        if (row is t) out.push(row);
    }
    return out;
}

#[compiler.external(.Erlang("rakun_session:ets_all($0)"))]
declare fn rkSessEtsAllRaw(store: string) -> unknown[];

// Every row of `store` that is an `S` (668).
pub fn rkSessEtsAll<S>(t: type<S>, store: string) -> S[] {
    var out: S[] = [];
    for (rkSessEtsAllRaw(store)) { row ->
        if (row is t) out.push(row);
    }
    return out;
}

#[compiler.external(.Erlang("rakun_session:ets_clear($0)"))]
pub declare fn rkSessEtsClear(store: string) -> i32;

#[compiler.external(.Erlang("rakun_session:ets_owner_facts()"))]
pub declare fn rkSessEtsOwnerFacts() -> string;

#[compiler.external(.Erlang("rakun_session:ets_alive()"))]
pub declare fn rkSessEtsAlive() -> bool;

#[compiler.external(.Erlang("rakun_session:spawn_crash($0)"))]
pub declare fn rkSessSpawnCrash<T>(work: fn() -> T) -> string;

// ── integers ────────────────────────────────────────────────────────────────

// Text to `i64` (`0` when it is not an integer). There is no std parser for
// an `i64`, and a millisecond epoch does not fit an `i32`.
#[compiler.external(.Erlang("rakun_session:to_i64($0)"))]
pub declare fn rkSessToI64(text: string) -> i64;

// An `i32` read as an `i64`: botopink has no widening conversion.
#[compiler.external(.Erlang("rakun_session:wide($0)"))]
pub declare fn rkSessWide(n: i32) -> i64;

// ── the Redis wire ──────────────────────────────────────────────────────────

// One command, one connection: `ok <text>`, `nil` or `err <text>`.
#[compiler.external(.Erlang("rakun_session:redis($0, $1, $2)"))]
pub declare fn rkSessRedis(
    url: string,
    args: string[],
    timeoutMs: i32,
) -> string;

#[compiler.external(.Erlang("rakun_session:redact($0)"))]
pub declare fn rkSessRedact(url: string) -> string;
