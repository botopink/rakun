//// rakun-data — the DataSource: arm selection, driver refusal, the test
//// profile's ETS default, and the bootstrap modes. Front 08 steps 1, 2 and 3.
////
//// A `try` inside a lambda does not propagate out of it (measured: the cell
//// passed with a needle that matched nothing), so a refusal asserted inside
//// `withUrl`/`withProfiles` is turned into a value there and asserted outside.
////
//// The profile set and the property table are node-global on the erlang row
//// and the test files share one node, so every cell that changes either puts
//// it back before it ends.

import {testing.asserts} from "std";
import {rkProp, rkSetProp, setResolved, resolvedKey} from "rakun";
import {
    DataSource,
    PooledDataSource,
    PoolStats,
    armOf,
    driverModule,
    effectiveUrl,
    urlProblem,
    startDataSource,
    dataSourceBoot,
    rkPoolStarted,
    rkPoolStop,
    rkDataSourceArm,
    rkEtsSetReachable,
    rkDataWarnings,
    rkDataWarningsReset,
    poolStats,
} from "datasource";
import {Param, param} from "sql/params";
import {Row, Rows} from "sql/rows";
import {SqlTemplate, sqlTemplate} from "sql/template";

fn withProfiles(names: string[], body: fn() -> i32) -> i32 {
    val saved = rkProp(resolvedKey());
    val _s = setResolved(names);
    val out = body();
    val _r = rkSetProp(resolvedKey(), saved);
    return out;
}

fn withUrl(url: string, body: fn() -> i32) -> i32 {
    val saved = rkProp("rakun.datasource.url");
    val _s = rkSetProp("rakun.datasource.url", url);
    val out = body();
    val _r = rkSetProp("rakun.datasource.url", saved);
    return out;
}

// ── step 1: the arms ─────────────────────────────────────────────────────────

test "datasource: rakun.datasource.url selects the arm" {
    assert armOf("ets:memory") == "ets";
    assert armOf("postgresql://app:pw@db:5432/shop") == "postgresql";
    assert armOf("postgres://db/shop") == "postgresql";
    assert armOf("mysql://app:pw@db:3306/shop") == "mysql";
    assert armOf("oracle://db") == "";
    assert driverModule("postgresql") == "epgsql";
    assert driverModule("mysql") == "mysql";
}

test "datasource: a started datasource is a DataSource with connect, close and stats" {
    val ds = startDataSource("contract", "ets:memory", 3, 500, "eager");
    assert ds.arm == "ets";
    assert rkDataSourceArm("contract") == "ets";
    val s: PoolStats = ds.stats();
    assert s.size == 3;
    assert ds.close() == 3;
    assert rkPoolStarted("contract") == false;
    assert ds.connect() == "";
    assert rkPoolStarted("contract");
}

test "datasource: an unknown scheme fails at boot naming the value" {
    try asserts.throwsWith({ ->
        val _d = startDataSource("odd", "oracle://db:1521/x", 1, 100, "eager");
        0;
    }, "rakun.datasource.url is 'oracle://db:1521/x', whose scheme no arm serves");
    assert rkPoolStarted("odd") == false;
}

test "datasource: a PostgreSQL URL whose driver is not loadable fails at boot naming it, with no fallback" {
    try asserts.throwsWith({ ->
        val _d = startDataSource("pg", "postgresql://app:pw@localhost:5432/shop", 2, 100, "eager");
        0;
    }, "the postgresql driver module 'epgsql' is not loadable - put the OTP application epgsql");
    try asserts.contains(urlProblem("postgresql://localhost/shop"), "does not fall back to the ETS store");
    assert rkPoolStarted("pg") == false;
}

test "datasource: a MySQL URL whose driver is not loadable fails at boot naming it, with no fallback" {
    try asserts.throwsWith({ ->
        val _d = startDataSource("my", "mysql://app:pw@localhost:3306/shop", 2, 100, "eager");
        0;
    }, "the mysql driver module 'mysql' is not loadable - put the OTP application mysql-otp");
    assert rkPoolStarted("my") == false;
}

test "datasource: the boot reads rakun.datasource.* and refuses a configured driver it cannot load" {
    val refused = withUrl("postgresql://localhost/shop", { ->
        val r = asserts.throwsWith({ ->
            val _d = dataSourceBoot();
            0;
        }, "driver module 'epgsql' is not loadable");
        if (r.isOk()) 1 else 0;
    });
    assert refused == 1;
}

// ── step 2: the test profile's default ───────────────────────────────────────

test "datasource: the ETS arm is selected under the test profile with no URL configured" {
    assert effectiveUrl("", true) == "ets:memory";
    assert effectiveUrl("", false) == "";
    assert effectiveUrl("mysql://db/x", true) == "mysql://db/x";
    val arm = withUrl("", { ->
        withProfiles(["test"], { ->
            val ds = dataSourceBoot();
            if (ds.arm == "ets") 1 else 0;
        });
    });
    assert arm == 1;
    assert rkDataSourceArm("default") == "ets";
}

test "datasource: with no URL and no test profile the boot fails rather than guessing" {
    val refused = withUrl("", { ->
        withProfiles([], { ->
            val r = asserts.throwsWith({ ->
                val _d = dataSourceBoot();
                0;
            }, "rakun.datasource.url is not set");
            if (r.isOk()) 1 else 0;
        });
    });
    assert refused == 1;
}

// ── step 3: bootstrap modes ──────────────────────────────────────────────────

test "bootstrap: eager (the default) fails the boot when the database is unreachable" {
    val _down = rkEtsSetReachable("down-eager", false);
    try asserts.throwsWith({ ->
        val _d = startDataSource("down-eager", "ets:memory", 2, 100, "eager");
        0;
    }, "the datasource 'down-eager' failed to start - rakun-data: datasource 'down-eager' is unreachable");
    assert rkPoolStarted("down-eager") == false;
    val _up = rkEtsSetReachable("down-eager", true);
}

test "bootstrap: the mode defaults to eager and an unknown mode is refused" {
    val _s = rkSetProp("rakun.data.repositories.bootstrap-mode", "");
    val ds = withUrl("ets:memory", { ->
        val d = dataSourceBoot();
        if (d.mode == "eager") 1 else 0;
    });
    assert ds == 1;
    assert poolStats("default").opened == poolStats("default").size;
    try asserts.throwsWith({ ->
        val _d = startDataSource("mode", "ets:memory", 1, 100, "sometimes");
        0;
    }, "bootstrap-mode is 'sometimes' - accepted: eager, deferred, lazy");
}

test "bootstrap: deferred boots with the database down and opens the first connection on the first statement" {
    val _down = rkEtsSetReachable("deferred", false);
    val ds = startDataSource("deferred", "ets:memory", 2, 500, "deferred");
    assert rkPoolStarted("deferred");
    assert ds.stats().opened == 0;
    assert ds.stats().size == 2;
    val _up = rkEtsSetReachable("deferred", true);
    val n = sqlTemplate("deferred").update("CREATE TABLE t (id int)", []);
    assert n == 0;
    assert ds.stats().opened == 1;
}

test "bootstrap: lazy starts the pool the way deferred does" {
    val _down = rkEtsSetReachable("lazy", false);
    val ds = startDataSource("lazy", "ets:memory", 2, 500, "lazy");
    assert ds.stats().opened == 0;
    val _up = rkEtsSetReachable("lazy", true);
}

test "bootstrap: deferred under a production profile logs a warning naming the profile, and still boots" {
    val _r = rkDataWarningsReset();
    val booted = withProfiles(["production"], { ->
        val ds = startDataSource("prod-deferred", "ets:memory", 1, 100, "deferred");
        if (rkPoolStarted("prod-deferred")) 1 else 0;
    });
    assert booted == 1;
    val warned = rkDataWarnings().join("\n");
    try asserts.contains(warned, "bootstrap-mode is 'deferred' under the active profile 'production'");
    val _q = rkDataWarningsReset();
    val _e = withProfiles(["production"], { ->
        val ds = startDataSource("prod-eager", "ets:memory", 1, 100, "eager");
        0;
    });
    assert rkDataWarnings().length == 0;
}
