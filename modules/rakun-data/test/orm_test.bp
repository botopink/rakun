//// rakun-data — entities and derived queries (front 78) on the ETS arm.

import {testing.asserts} from "std";
import {rkSetProp} from "rakun";
import {datasource.startDataSource};
import {migration.migrate.ddlAutoOn, migration.migrate.ddlCreateOn, migration.migrate.ddlValidateOn, migration.migrate.schemaDiff};
import {sql.params.Param, sql.params.param};
import {sql.rows.Row, sql.rows.Rows};
import {sql.template.SqlTemplate, sql.template.Tx, sql.template.sqlTemplate};
import {orm.entity.EntityMeta, orm.entity.Revision, orm.entity.rkRegisterEntity, orm.entity.rkOrmNow, orm.entity.rkOrmPrincipal, orm.entity.rkOrmSortRevisions, orm.entity.entity, orm.entity.id, orm.entity.generated, orm.entity.column, orm.entity.version, orm.entity.createdAt, orm.entity.updatedAt, orm.entity.createdBy, orm.entity.updatedBy, orm.entity.transient, orm.entity.revisions, orm.entity.entityNames, orm.entity.entityTable, orm.entity.entityColumns, orm.entity.entityColumnType};
import {orm.repository.derived, orm.repository.entityRepository, orm.repository.belongsTo};
import {orm.query.Sort, orm.query.Pageable, orm.query.Page, orm.query.Slice, orm.query.pagedSql, orm.query.pageParams, orm.query.countOf, orm.query.joinColumns, orm.query.unprefixed, orm.query.Op, orm.query.queryOf};

#[entity("cities")]
pub type City(
    #[id]
    #[generated]
    id: i32,
    name: string,
    #[column("state_name")]
    state: string,
    population: i32,
    #[version]
    revision: i32,
    #[transient]
    note: string,
)

#[entityRepository("City")]
pub type CityRepo(sql: SqlTemplate) {
    #[derived]
    pub fn findByName(self: Self, name: string) -> City[] {
        return __rkDerived_CityRepo_findByName(self.sql, name);
    }

    #[derived]
    pub fn findByNameAndStateAllIgnoringCase(self: Self, name: string, state: string) -> City[] {
        return __rkDerived_CityRepo_findByNameAndStateAllIgnoringCase(self.sql, name, state);
    }

    #[derived]
    pub fn findByPopulationBetween(self: Self, low: i32, high: i32) -> City[] {
        return __rkDerived_CityRepo_findByPopulationBetween(self.sql, low, high);
    }

    #[derived]
    pub fn findByNameIsNull(self: Self) -> City[] {
        return __rkDerived_CityRepo_findByNameIsNull(self.sql);
    }

    #[derived]
    pub fn countByState(self: Self, state: string) -> i32 {
        return __rkDerived_CityRepo_countByState(self.sql, state);
    }

    #[derived]
    pub fn existsByName(self: Self, name: string) -> bool {
        return __rkDerived_CityRepo_existsByName(self.sql, name);
    }

    #[derived]
    pub fn deleteByState(self: Self, state: string) -> i32 {
        return __rkDerived_CityRepo_deleteByState(self.sql, state);
    }

    #[derived]
    pub fn findFirstByStateOrderByNameDesc(self: Self, state: string) -> ?City {
        return __rkDerived_CityRepo_findFirstByStateOrderByNameDesc(self.sql, state);
    }

    #[derived]
    pub fn findByState(self: Self, state: string, page: Pageable) -> Page<City> {
        return __rkDerived_CityRepo_findByState(self.sql, state, page);
    }

    #[derived]
    pub fn findByPopulationGreaterThan(self: Self, population: i32, page: Pageable) -> Slice<City> {
        return __rkDerived_CityRepo_findByPopulationGreaterThan(self.sql, population, page);
    }

    #[derived]
    pub fn findByStateOrderByNameDesc(self: Self, state: string) -> City[] {
        return __rkDerived_CityRepo_findByStateOrderByNameDesc(self.sql, state);
    }

    #[derived]
    pub fn findByNameOrStateAndPopulation(self: Self, name: string, state: string, population: i32) -> City[] {
        return __rkDerived_CityRepo_findByNameOrStateAndPopulation(self.sql, name, state, population);
    }
}

fn ds(name: string) -> SqlTemplate {
    val _s = startDataSource(name, "ets:memory", 2, 5000, "eager");
    val t = sqlTemplate(name);
    val _c = t.update("CREATE TABLE cities (id integer, name text, state_name text, population integer, revision integer)", []);
    return t;
}

fn city(name: string, state: string, population: i32) -> City {
    return City(id: 0, name: name, state: state, population: population, revision: 0, note: "");
}

test "orm: camelCase fields map to snake_case columns, #[column] overrides, #[transient] is no column" {
    assert __rkEntity_City_table() == "cities";
    assert __rkEntity_City_columns() == "id|name|state_name|population|revision";
    assert CityCol().state == "state_name" && CityCol().population == "population";
    assert __rkEntity_City_params(city("a", "b", 1)).map({ p -> p.name }).join(",") == "id,name,state_name,population,revision";
}

test "orm: fromRow of the params' row round-trips a record" {
    val c = City(id: 7, name: "Lima", state: "LI", population: 9, revision: 2, note: "");
    val ps = __rkEntity_City_params(c);
    val back = __rkEntity_City_fromRow(Row(columns: ps.map({ p -> p.name }), values: ps.map({ p -> p.value })));
    assert back == c;
}

test "orm: every derived statement, as a literal" {
    assert __rkDerivedSql_CityRepo_findByName() == "select id, name, state_name, population, revision from cities where name = :p0";
    assert __rkDerivedSql_CityRepo_findByNameAndStateAllIgnoringCase() == "select id, name, state_name, population, revision from cities where lower(name) = lower(:p0) and lower(state_name) = lower(:p1)";
    assert __rkDerivedSql_CityRepo_findByPopulationBetween() == "select id, name, state_name, population, revision from cities where population between :p0 and :p1";
    assert __rkDerivedSql_CityRepo_findByNameIsNull() == "select id, name, state_name, population, revision from cities where name is null";
    assert __rkDerivedSql_CityRepo_countByState() == "select count(*) as n from cities where state_name = :p0";
    assert __rkDerivedSql_CityRepo_existsByName() == "select count(*) as n from cities where name = :p0";
    assert __rkDerivedSql_CityRepo_deleteByState() == "delete from cities where state_name = :p0";
    assert __rkDerivedSql_CityRepo_findFirstByStateOrderByNameDesc() == "select id, name, state_name, population, revision from cities where state_name = :p0 order by name desc limit 1";
    assert __rkDerivedSql_CityRepo_findByNameOrStateAndPopulation() == "select id, name, state_name, population, revision from cities where name = :p0 or state_name = :p1 and population = :p2";
}

test "orm: save, the derived reads and the writes run on the ETS arm" {
    val t = ds("orm1");
    val repo = CityRepo(sql: t);
    val lima = __rkEntity_City_insert(t, city("Lima", "LI", 100));
    val _b = __rkEntity_City_insert(t, city("Ica", "IC", 50));
    val _c = __rkEntity_City_insert(t, city("Nazca", "IC", 20));
    assert lima.id == 1;
    assert repo.findByName("Lima").length == 1;
    assert repo.findByNameAndStateAllIgnoringCase("lima", "li").length == 1;
    assert repo.findByPopulationBetween(20, 60).map({ c -> c.name }).join(",") == "Ica,Nazca";
    assert repo.countByState("IC") == 2 && repo.existsByName("Ica") && repo.existsByName("Cusco") == false;
    val top = repo.findFirstByStateOrderByNameDesc("IC") ?? city("", "", 0);
    assert top.name == "Nazca";
    assert repo.deleteByState("IC") == 2 && repo.countByState("IC") == 0;
}

// ── step 3: paging ──────────────────────────────────────────────────────────

fn many(t: SqlTemplate) -> i32 {
    for (["a", "b", "c", "d", "e"]) { n -> val _i = __rkEntity_City_insert(t, city(n, "S", 10)); };
    return 0;
}

test "orm: a Page runs the page and a count statement with the same where and no order by" {
    val t = ds("orm2");
    val _m = many(t);
    val repo = CityRepo(sql: t);
    assert __rkDerivedCount_CityRepo_findByState() == "select count(*) as n from cities where state_name = :p0";
    val p0 = repo.findByState("S", Pageable(page: 0, size: 2, sort: [Sort(field: "name", descending: true)]));
    val p2 = repo.findByState("S", Pageable(page: 2, size: 2, sort: []));
    assert p0.content.map({ c -> c.name }).join(",") == "e,d" && p0.totalElements == 5;
    assert p0.totalPages() == 3 && p0.hasNext();
    assert p2.content.length == 1 && p2.hasNext() == false;
}

test "orm: a Slice fetches size + 1 rows, answers size, and hasNext from the extra" {
    val t = ds("orm3");
    val _m = many(t);
    val repo = CityRepo(sql: t);
    val first = repo.findByPopulationGreaterThan(5, Pageable(page: 0, size: 3, sort: []));
    val last = repo.findByPopulationGreaterThan(5, Pageable(page: 1, size: 3, sort: []));
    assert first.content.length == 3 && first.hasNext;
    assert last.content.length == 2 && last.hasNext == false;
}

test "orm: sort fields append in order with their directions; a non-column fails and is never spliced; size 0 is refused" {
    val base = __rkDerivedSql_CityRepo_findByState();
    val sorted = pagedSql(base, Pageable(page: 0, size: 5, sort: [Sort(field: "state_name", descending: false), Sort(field: "population", descending: true)]), CityMeta(), 0);
    assert sorted == base + " order by state_name asc, population desc limit :__limit offset :__offset";
    try asserts.throwsWith({ -> pagedSql(base, Pageable(page: 0, size: 5, sort: [Sort(field: "name; drop table cities", descending: false)]), CityMeta(), 0).length() }, "the sort field `name; drop table cities` is not a column of cities");
    try asserts.throwsWith({ -> pagedSql(base, Pageable(page: 0, size: 0, sort: []), CityMeta(), 0).length() }, "a page size of 0 is refused");
}

// ── step 4: writes ──────────────────────────────────────────────────────────

#[entity("countries")]
pub type Country(
    #[id]
    code: string,
    name: string,
    #[version]
    version: i32,
    #[createdAt]
    createdAt: string,
    #[updatedAt]
    updatedAt: string,
    #[createdBy]
    createdBy: string,
    #[updatedBy]
    updatedBy: string,
)

fn countries(name: string) -> SqlTemplate {
    val _s = startDataSource(name, "ets:memory", 2, 5000, "eager");
    val t = sqlTemplate(name);
    val _c = t.update("CREATE TABLE countries (code text, name text, version integer, created_at text, updated_at text, created_by text, updated_by text)", []);
    return t;
}

#[@External.Erlang("""(fun(__P) -> put(rakun_orm_test_principal, __P), 0 end)($0)""")]
declare fn asPrincipal(name: string) -> i32;

#[@External.Erlang("""(fun(__Ms) -> timer:sleep(__Ms), 0 end)($0)""")]
declare fn sleep(ms: i32) -> i32;

fn peru() -> Country {
    return Country(code: "PE", name: "Peru", version: 0, createdAt: "", updatedAt: "", createdBy: "", updatedBy: "");
}

test "orm: a non-generated id is sent as given; audit columns are stamped by the mapper" {
    val t = countries("orm4");
    val _p = asPrincipal("");
    val saved = __rkEntity_Country_insert(t, peru());
    val _w = sleep(2);
    val _q = asPrincipal("ana");
    val next = __rkEntity_Country_update(t, saved);
    val _r = asPrincipal("");
    val stored = __rkEntity_Country_byId(t, "PE") ?? peru();
    assert saved.code == "PE" && saved.createdAt != "" && saved.createdAt == saved.updatedAt && saved.createdBy == "";
    assert next.createdAt == saved.createdAt && next.updatedAt > saved.updatedAt;
    assert next.updatedBy == "ana" && next.createdBy == "";
    assert stored.createdAt == saved.createdAt && stored.updatedBy == "ana";
}

test "orm: update increments the version and leaves the caller's record alone; a stale one raises naming everything" {
    val t = countries("orm5");
    val saved = __rkEntity_Country_insert(t, peru());
    val next = __rkEntity_Country_update(t, saved);
    assert saved.version == 0 && next.version == 1;
    try asserts.throwsWith({ -> __rkEntity_Country_update(t, saved).version }, "optimistic lock failure on countries id PE - expected version 0, stored 1");
    try asserts.throwsWith({ -> __rkEntity_Country_delete(t, saved) }, "expected version 0, stored 1");
    assert __rkEntity_Country_delete(t, next) == 1;
    assert __rkEntity_Country_byId(t, "PE") == null;
}

// ── step 6: the typed builder ───────────────────────────────────────────────

test "orm: the builder composes one statement, the same bytes a derived query produces" {
    val q = queryOf(CityMeta()).where(CityCol().state, Op.Eq, "IC").orderBy(CityCol().name, true);
    assert q.toSql() == __rkDerivedSql_CityRepo_findByStateOrderByNameDesc();
    val full = queryOf(CityMeta()).where(CityCol().state, Op.Eq, "IC").and(CityCol().population, Op.Gt, "10").or(CityCol().name, Op.Like, "L%").orderBy(CityCol().name, false).limit(50).offset(5);
    assert full.toSql() == "select id, name, state_name, population, revision from cities where state_name = :p0 and population > :p1 or name like :p2 order by name asc limit 50 offset 5";
}

test "orm: a builder value never reaches the statement text" {
    val t = ds("orm6");
    val _i = __rkEntity_City_insert(t, city("Lima", "LI", 1));
    val rows = queryOf(CityMeta()).where(CityCol().name, Op.Eq, "'; drop table cities; --").fetch(t);
    assert rows.rowCount() == 0;
    assert t.query("SELECT id FROM cities", []).rowCount() == 1;
}

// ── step 5: relations ───────────────────────────────────────────────────────

#[entity("customers")]
pub type Customer(
    #[id]
    id: i32,
    name: string,
)

#[entity("orders")]
pub type Order(
    #[id]
    id: i32,
    customerId: i32,
    cents: i32,
)

#[belongsTo("Order", "customerId", "Customer", "id")]
pub type OrderWithCustomer(order: Order, customer: Customer)

#[belongsTo("Order", "customerId", "Customer", "id")]
pub type OrderMaybeCustomer(order: Order, customer: ?Customer)

test "orm: a join is one statement, and a left join's missing half is null" {
    assert __rkJoin_OrderWithCustomer_sql() == "select a.id AS a__id, a.customer_id AS a__customer_id, a.cents AS a__cents, b.id AS b__id, b.name AS b__name from orders a join customers b on a.customer_id = b.id";
    assert __rkJoin_OrderMaybeCustomer_sql().contains(" from orders a left join customers b on ");
    val both = __rkJoin_OrderWithCustomer_fromRow(Row(columns: ["a__id", "a__customer_id", "a__cents", "b__id", "b__name"], values: ["1", "7", "500", "7", "Ana"]));
    assert both.order.cents == 500 && both.customer.name == "Ana";
    val alone = __rkJoin_OrderMaybeCustomer_fromRow(Row(columns: ["a__id", "a__customer_id", "a__cents", "b__id", "b__name"], values: ["2", "9", "100", "", ""]));
    assert alone.order.id == 2 && alone.customer == null;
}

// ── step 7: revisions ───────────────────────────────────────────────────────

#[entity("accounts")]
#[revisions]
pub type Account(
    #[id]
    id: i32,
    owner: string,
    balance: i32,
)

fn accounts(name: string) -> SqlTemplate {
    val _s = startDataSource(name, "ets:memory", 2, 5000, "eager");
    val t = sqlTemplate(name);
    val _c = t.update("CREATE TABLE accounts (id integer, owner text, balance integer)", []);
    val _r = t.update("CREATE TABLE accounts_revisions (id integer, owner text, balance integer, revision_number integer, revision_type text, revision_timestamp text, revision_author text)", []);
    return t;
}

test "orm: an audited write appends exactly one revision per insert, update and delete, with the author" {
    val t = accounts("orm7");
    val _p = asPrincipal("ana");
    val a = __rkEntity_Account_insert(t, Account(id: 1, owner: "ana", balance: 10));
    val b = __rkEntity_Account_update(t, Account(id: 1, owner: "ana", balance: 20));
    val _d = __rkEntity_Account_delete(t, b);
    val _q = asPrincipal("");
    val revs = __rkEntity_Account_revisionsOf(t, 1);
    assert revs.map({ r -> r.number.toString() + ":" + r.kind + ":" + r.author }).join(",") == "1:insert:ana,2:update:ana,3:delete:ana";
    assert __rkEntity_Account_revisionNumbers(t, 1).map({ n -> n.toString() }).join(",") == "1,2,3";
    assert a.balance == 10;
}

test "orm: a rolled-back write leaves no revision" {
    val t = accounts("orm8");
    val _r = t.withRollback({ tx -> __rkEntity_Account_insertIn(tx, Account(id: 5, owner: "x", balance: 1)).balance });
    assert __rkEntity_Account_revisionsOf(t, 5).length == 0;
    assert t.query("SELECT id FROM accounts", []).rowCount() == 0;
}

test "orm: revisionAt answers the state as of an instant, and null before the first revision" {
    val t = accounts("orm9");
    val before = rkOrmNow();
    val _w = sleep(2);
    val _a = __rkEntity_Account_insert(t, Account(id: 1, owner: "ana", balance: 10));
    val _v = sleep(2);
    val mid = rkOrmNow();
    val _x = sleep(2);
    val _b = __rkEntity_Account_update(t, Account(id: 1, owner: "ana", balance: 99));
    assert __rkEntity_Account_revisionAt(t, 1, before) == null;
    assert (__rkEntity_Account_revisionAt(t, 1, mid) ?? Account(id: 0, owner: "", balance: 0)).balance == 10;
    assert (__rkEntity_Account_revisionAt(t, 1, rkOrmNow()) ?? Account(id: 0, owner: "", balance: 0)).balance == 99;
}

test "orm: an unaudited entity has no revision table in the metadata" {
    assert entityColumns("cities_revisions") == "";
    assert entityColumns("accounts_revisions") == "id|owner|balance|revision_number|revision_type|revision_timestamp|revision_author";
}

// ── step 8: metadata ────────────────────────────────────────────────────────

test "orm: every entity's table, columns and column types are in the metadata" {
    val names = entityNames();
    for (["City", "Country", "Customer", "Order", "Account"]) { n -> assert names.indexOf(n) >= 0, n; };
    assert entityTable("City") == "cities" && entityColumns("cities") == "id|name|state_name|population|revision";
    assert entityColumnType("cities", "population") == "integer" && entityColumnType("cities", "name") == "text";
    assert entityColumns("nowhere") == "";
}

// ── front 77's ddl-auto over this metadata ──────────────────────────────────

fn emptyDs(name: string) -> SqlTemplate {
    val _s = startDataSource(name, "ets:memory", 2, 5000, "eager");
    return sqlTemplate(name);
}

test "orm ddl: create recreates every entity table under a dev profile" {
    val t = emptyDs("orm10");
    val _p = rkSetProp("rakun.profiles.resolved", "dev");
    val _m = rkSetProp("rakun.migration.ddl-auto", "create");
    val _l = rkSetProp("rakun.migration.locations", "no-such-dir-orm10");
    val _a = ddlAutoOn("orm10");
    val _i = __rkEntity_City_insert(t, city("Lima", "LI", 1));
    val _b = ddlAutoOn("orm10");
    val _u = rkSetProp("rakun.profiles.resolved", "");
    val _v = rkSetProp("rakun.migration.ddl-auto", "");
    val _w = rkSetProp("rakun.migration.locations", "");
    assert t.query("SELECT id FROM cities", []).rowCount() == 0;
    assert t.query("SELECT id FROM accounts_revisions", []).rowCount() == 0;
    assert ddlValidateOn("orm10") == "";
}

test "orm ddl: validate names the table and the column of a missing, extra or retyped column" {
    val t = emptyDs("orm11");
    val _c = ddlCreateOn("orm11");
    val _d = t.update("DROP TABLE cities", []);
    val _e = t.update("CREATE TABLE cities (id integer, name text, state_name text, revision integer)", []);
    val missing = ddlValidateOn("orm11");
    val _f = t.update("DROP TABLE cities", []);
    val _g = t.update("CREATE TABLE cities (id integer, name text, state_name text, population integer, revision integer, mayor text)", []);
    val extra = ddlValidateOn("orm11");
    assert missing == "rakun migration: ddl-auto=validate - the table `cities` has no column `population`", missing;
    assert extra == "rakun migration: ddl-auto=validate - the table `cities` has a column `mayor` no entity declares", extra;
    assert schemaDiff("cities", "id:integer|name:text", "id:integer|name:integer") == "rakun migration: ddl-auto=validate - the column `cities.name` is integer and the entity declares text";
}
