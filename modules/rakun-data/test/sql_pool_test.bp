//// rakun-data — the pool. Front 08 step 3.
////
//// The cells that matter here are the ones about processes, and they are
//// asserted by OBSERVING the pool, never by a counter kept for the test: a
//// killed connection is proven restarted by the supervisor's child list being
//// full again, and a borrower that died is proven reclaimed by every
//// connection being free again and its uncommitted row being gone.
////
//// Every cell uses its own datasource name, so a pool one cell left behind is
//// never the pool the next one reads.

import {testing.asserts} from "std";
import {io.clock} from "std";
import {async, async.Gate} from "std";
import {datasource.PooledDataSource, datasource.PoolStats, datasource.startDataSource, datasource.poolStats, datasource.rkPoolStats, datasource.rkPoolKillSlot, datasource.rkPoolSettle, datasource.rkDataSleep};
import {sql.params.Param, sql.params.param};
import {sql.rows.Row, sql.rows.Rows};
import {sql.template.SqlTemplate, sql.template.Tx, sql.template.sqlTemplate, sql.template.rkSqlSpawnBorrower};

fn errorOf(r: @Result<Rows, string>) -> string {
    return case r {
        Ok(_rows) -> "";
        Error(e) -> e;
    };
}

// A statement from ANOTHER process, which has no transaction mark and so must
// check a connection out of the pool.
fn fromElsewhere(sql: SqlTemplate) -> @Task<string> {
    return errorOf(sql.tryQuery("SELECT 1", []));
}

fn raiseElsewhere(sql: SqlTemplate) -> @Task<i32> {
    return sql.query("SELECT 1", []).rowCount();
}

// What each transaction thunk below runs. `await` is legal only in a
// `-> @Task` fn or a test block, not in a lambda, so the thunks call these.
fn probeInside(sql: SqlTemplate) -> @Task<string[]> {
    return await async.runAll([{ -> fromElsewhere(sql) }]);
}

fn raiseInside(sql: SqlTemplate) -> @Task<i32> {
    val counts = await async.runAll([{ -> raiseElsewhere(sql) }]);
    return counts.length;
}

// ── the waiting count, observed rather than timed ───────────────────────────
// Three tasks and two gates: `holding` checks the pool's one connection out
// (a transaction) and keeps it until the count has been OBSERVED; the borrower
// asks for a connection only once it is held, so it has to wait; the observer
// reads the stats until that wait shows. Nothing here is a race against a
// clock — a 60 ms sleep before the read, against a 150 ms checkout timeout,
// measured the machine's load as much as the pool.

fn holding(sql: SqlTemplate, held: Gate, observed: Gate) -> @Task<string> {
    return await sql.transaction({ tx -> holdUntilObserved(held, observed) });
}

fn holdUntilObserved(held: Gate, observed: Gate) -> @Task<string> {
    async.openGate(held);
    val seen = await async.awaitGate(observed, 10000);
    return if (seen) "held" else "never observed";
}

fn borrowWhenHeld(sql: SqlTemplate, held: Gate) -> @Task<string> {
    val _h = await async.awaitGate(held, 10000);
    return await fromElsewhere(sql);
}

fn observeWaiting(name: string, held: Gate, observed: Gate) -> @Task<string> {
    val _h = await async.awaitGate(held, 10000);
    val seen = busyAndWaiting(name);
    async.openGate(observed);
    return seen;
}

// `busy|waiting` of `name` once a borrower is waiting, polled every
// millisecond; after ten thousand polls (at least ten seconds) with nobody
// waiting it answers what it sees, and the assertion reds.
fn busyAndWaiting(name: string) -> string {
    var polls = 0;
    var s: PoolStats = poolStats(name);
    while (s.waiting < 1 && polls < 10000) {
        val _s = rkDataSleep(1);
        polls = polls + 1;
        s = poolStats(name);
    }
    return s.busy.toString() + "|" + s.waiting.toString();
}

test "pool: the configured number of connection processes start under rakun_pool_sup" {
    val ds = startDataSource("sized", "ets:memory", 4, 500, "eager");
    val s = ds.stats();
    assert s.size == 4;
    assert s.free == 4;
    assert s.busy == 0;
    assert s.opened == 4;
}

test "pool: a checkout with an empty free list waits and then fails after connection-timeout" {
    val _d = startDataSource("tiny", "ets:memory", 1, 150, "eager");
    val sql = sqlTemplate("tiny");
    val start = clock.monotonicMillis();
    val answers = await sql.transaction({ tx -> probeInside(sql) });
    val elapsed = clock.monotonicMillis() - start;
    try asserts.contains(
        answers.join(""),
        "no connection available from datasource 'tiny' within 150 ms (pool size 1, all in use)",
    );
    assert elapsed >= 150;
}

test "pool: the raising surface raises when the checkout times out" {
    val sql = sqlTemplate("tiny");
    try asserts.throwsWith({ ->
        val _t = sql.transaction({ tx -> raiseInside(sql) });
        0;
    }, "no connection available from datasource 'tiny'");
}

test "pool: rkPoolStats reports size, in-use and waiting" {
    val _d = startDataSource("watched", "ets:memory", 1, 10000, "eager");
    val sql = sqlTemplate("watched");
    val held = async.newGate();
    val observed = async.newGate();
    val answers = await async.runAll(
        [
            { -> holding(sql, held, observed) },
            { -> borrowWhenHeld(sql, held) },
            { -> observeWaiting("watched", held, observed) },
        ],
    );
    // The borrower waited, then got the connection once the transaction
    // ended: its statement succeeded (no error text).
    assert answers.join(",") == "held,,1|1", answers.join(",");
    val after = poolStats("watched");
    assert after.size == 1;
    assert after.busy == 0;
    assert after.waiting == 0;
    val dflt: PoolStats = rkPoolStats();
    assert dflt.size >= 0;
}

test "pool: a connection process killed while idle is restarted and the pool returns to full size" {
    val _d = startDataSource("killed", "ets:memory", 3, 500, "eager");
    val _k = rkPoolKillSlot("killed", 2);
    val free = rkPoolSettle("killed", 1000);
    assert free == 3;
    assert poolStats("killed").size == 3;
    val _c = sqlTemplate("killed").update(
        "CREATE TABLE after_kill (id int)",
        [],
    );
    assert sqlTemplate("killed")
        .query("SELECT id FROM after_kill", [])
        .rowCount()
        == 0;
}

test "pool: a borrower that dies mid-query has its connection reclaimed and its transaction rolled back" {
    val _d = startDataSource("orphan", "ets:memory", 2, 500, "eager");
    val sql = sqlTemplate("orphan");
    val _c = sql.update("CREATE TABLE ledger (id int)", []);
    val spawned = rkSqlSpawnBorrower(
        "orphan",
        "INSERT INTO ledger (id) VALUES ($1)",
        ["9"],
    );
    assert spawned == 1;
    val free = rkPoolSettle("orphan", 1000);
    assert free == 2;
    assert poolStats("orphan").busy == 0;
    assert sql.query("SELECT id FROM ledger WHERE id = 9", []).rowCount() == 0;
}

test "pool: no connection is checked out until the first statement runs" {
    val _d = startDataSource("lazyacq", "ets:memory", 2, 500, "eager");
    val before = poolStats("lazyacq").checkouts;
    val sql = sqlTemplate("lazyacq");
    val other = SqlTemplate(dataSourceName: "lazyacq");
    assert poolStats("lazyacq").checkouts == before;
    assert other.inTransaction() == false;
    val _c = sql.update("CREATE TABLE t (id int)", []);
    assert poolStats("lazyacq").checkouts == before + 1;
    assert poolStats("lazyacq").busy == 0;
}
