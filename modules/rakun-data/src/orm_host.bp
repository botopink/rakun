//// rakun-data — the host cells of front 78's entities (`rakun_orm.erl`).
////
//// A ROOT-LEVEL module on purpose: `shipErlSidecars` reads the first path
//// segment of a module name as the dependency that owns it, so a sidecar
//// called only from `orm/*.bp` was looked up in a package named `orm` and
//// never shipped (language-gaps.md). Each cell has a wrapper here, so this
//// module's own text calls every one of them.

#[@External.Erlang("rakun_orm", "register")]
declare fn cellRegister<M>(meta: M) -> i32;

#[@External.Erlang("rakun_orm", "entity_names")]
declare fn cellNames() -> string[];

#[@External.Erlang("rakun_orm", "entity_table")]
declare fn cellTable(entity: string) -> string;

#[@External.Erlang("rakun_orm", "table_columns")]
declare fn cellColumns(table: string) -> string;

#[@External.Erlang("rakun_orm", "column_type")]
declare fn cellColumnType(table: string, column: string) -> string;

#[@External.Erlang("rakun_orm", "tables")]
declare fn cellTables() -> string[];

#[@External.Erlang("rakun_orm", "now_iso")]
declare fn cellNow() -> string;

#[@External.Erlang("rakun_orm", "principal")]
declare fn cellPrincipal() -> string;

#[@External.Erlang("""(fun(__L) -> lists:sort(fun(__A, __B) -> element(2, __A) =< element(2, __B) end, __L) end)($0)""")]
declare fn cellSort<R>(xs: R[]) -> R[];

pub fn rkOrmRegister<M>(meta: M) -> i32 {
    return cellRegister(meta);
}

pub fn rkOrmNames() -> string[] {
    return cellNames();
}

pub fn rkOrmTable(entity: string) -> string {
    return cellTable(entity);
}

pub fn rkOrmColumns(table: string) -> string {
    return cellColumns(table);
}

pub fn rkOrmColumnType(table: string, column: string) -> string {
    return cellColumnType(table, column);
}

pub fn rkOrmTables() -> string[] {
    return cellTables();
}

pub fn rkOrmNowCell() -> string {
    return cellNow();
}

pub fn rkOrmPrincipalCell() -> string {
    return cellPrincipal();
}

// Revision records sorted by their number (the record's first field).
pub fn rkOrmSortCell<R>(xs: R[]) -> R[] {
    return cellSort(xs);
}
