//// rakun-data — the SQL arm (front 08). The order is a DEPENDENCY order and
//// `botopink.json`'s `files` repeats it: `params` and `rows` import nothing of
//// this member, `template` imports both and `datasource`, and the two decorator
//// modules import nothing (their emissions reference `rkTxRun` and
//// `rkRegisterQuery` at the APPLICATION site). `health` closes the list: it
//// imports `template` and `datasource`, and registers the `db` indicator with
//// `rakun-actuator-api` at module load.

pub mod params;
pub mod rows;
pub mod template;
pub mod query;
pub mod transactional;
pub mod health;
