//// rakun-data — `#[transactional]`, `#[noTransaction]`, `#[propagation]`.
//// Front 08 step 6.
////
//// WHY A PROXY. A decorator adds declarations; it cannot rewrite the body of
//// the thing it annotates. So `#[transactional]` on a METHOD cannot open a
//// transaction around it. What a TYPE-level decorator can do is add a proxy
//// type, which is also what Spring does at run time:
////
////     #[service]
////     #[transactional]
////     pub type OrderService(sql: SqlTemplate, orders: OrderRepository) {
////         pub fn place(self: Self, userId: i32, total: i32) -> i32 { … }
////     }
////
//// adds the associated type `OrderService.Tx` (`compiler.addType` over
//// `compiler.buildType`, its text computed from the methods)
////
////     OrderService.Tx(inner: OrderService) {
////         pub fn make() -> OrderService.Tx { … rkSingleton … OrderService.make() … }
////         pub fn place(self: Self, userId: i32, total: i32) -> i32 {
////             return rkTxRun("OrderService.place", "required", { -> self.inner.place(userId, total) });
////         }
////     }
////
//// and compiles `rkRegisterBean("OrderService.Tx", …, { -> OrderService.Tx.make() })`
//// into the init list (`compiler.compile`, run before `main`).
////
//// A component injecting `OrderService.Tx` gets the transactional path;
//// injecting `OrderService` gets the bare one — the distinction Spring hides,
//// made visible. `#[noTransaction]` on a method gets a plain forward.
//// The proxy enters the context table, so a field `tx: OrderService.Tx`
//// resolves through `rkResolve`'s fallback. The application site imports
//// `rkTxRun` (rakun-data) and `rkSingleton` (rakun), and
//// the type needs a stereotype for `<Type>.make()`.
////
//// SIGNATURES ARE REDECLARED VERBATIM. `@Decl` spells every parameter and
//// return type as written (`i32[]`, `array<string>`, `Result<T, E>`, a
//// function type), so the proxy redeclares each method's signature as it
//// reads it; a method with no return type is emitted as a void method.
//// Every reflected method is forwarded: `Method` carries no visibility, so a
//// private method is forwarded too.
////
//// PROPAGATION. REQUIRED only. `#[propagation("REQUIRES_NEW")]` or
//// `("NESTED")` on a method fails the build saying it is not implemented, and
//// `rkTxRun` refuses any other value at run time — never accepted and ignored.

import {compiler, compiler.DeclKind} from "std";
import {rkRegisterBean} from "rakun";

pub fn transactional(syntax decl: unknown) -> void {
    var methods: array<string> = [];
    var refused = "";
    compiler
        .methods(decl)
        .forEach({ m ->
            var plain = false;
            var prop = "REQUIRED";
            m.annotations.forEach({ a ->
                val p = if (a.name == "noTransaction") true else plain;
                plain = p;
                val q = if (a.name == "propagation")
                    a.args.join("").replaceAll("\"", "").toUpper()
                else
                    prop;
                prop = q;
            });
            val badProp = if (prop != "REQUIRED" && refused == "")
                compiler.name(decl)!
                    + "."
                    + m.name
                    + " asks for propagation "
                    + prop
            else
                refused;
            refused = badProp;
            var params: array<string> = [];
            var args: array<string> = [];
            m.params.forEach({ p ->
                if (p.name != "self") {
                    params.push(p.name + ": " + p.typeName);
                    args.push(p.name);
                }
            });
            val ret = m.returnType;
            val call = "self.inner." + m.name + "(" + args.join(", ") + ")";
            val label = compiler.name(decl)! + "." + m.name;
            val head = if (params.length > 0)
                "pub fn " + m.name + "(self: Self, " + params.join(", ") + ")"
            else
                "pub fn " + m.name + "(self: Self)";
            val sig = if (ret != "") head + " -> " + ret else head;
            val wrapped = "rkTxRun(\""
                + label
                + "\", \"required\", { -> "
                + call
                + " })";
            val voidWrapped = "val _tx = rkTxRun(\""
                + label
                + "\", \"required\", { -> "
                + call
                + "; 0 });";
            val body = if (plain) {
                if (ret != "") "return " + call + ";" else call + ";";
            } else if (ret != "") "return " + wrapped + ";" else voidWrapped;
            methods.push(sig + " {\n        " + body + "\n    }");
        });
    val declName = compiler.name(decl)!;
    val txName = declName + ".Tx";
    val make = "pub fn make() -> "
        + txName
        + " {\n        return rkSingleton(\""
        + txName
        + "\", { -> "
        + txName
        + "(inner: "
        + declName
        + ".make()) });\n    }";
    compiler.addType(
        "Tx",
        compiler.buildType(
            "(inner: "
                + declName
                + ") {\n    "
                + make
                + "\n\n    "
                + methods.join("\n\n    ")
                + "\n}",
        ),
    );
    compiler.init({ ->
        rkRegisterBean(txName, "", "singleton", false, false, declName, { -> decl.Tx.make() });
    });
    if (compiler.kind(decl) != DeclKind.Type)
        compiler.fail(
            "#[transactional] must annotate a type - a decorator cannot wrap a method body, so the transaction lives on the <Type>.Tx proxy the type-level marker adds",
            at: decl,
        );
    if (compiler.variants(decl).length > 0)
        compiler.fail(
            "#[transactional] must annotate a type with fields, not an enum",
            at: decl,
        );
    if (refused != "")
        compiler.fail(
            "#[transactional]: "
                + refused
                + " - only REQUIRED is implemented (a nested call joins the open transaction); REQUIRES_NEW and NESTED (savepoints) are not implemented and are refused rather than ignored",
            at: decl,
        );
}

pub fn noTransaction(syntax decl: unknown) -> void {
    if (compiler.kind(decl) != DeclKind.Method)
        compiler.fail(
            "#[noTransaction] must annotate a method of a #[transactional] type",
            at: decl,
        );
}

pub fn propagation(syntax decl: unknown, comptime name: string) -> void {
    if (compiler.kind(decl) != DeclKind.Method)
        compiler.fail(
            "#[propagation] must annotate a method of a #[transactional] type",
            at: decl,
        );
}
