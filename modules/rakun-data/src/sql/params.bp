//// rakun-data — named parameters. Front 08 step 4.
////
//// Parameters are NAMED (`:id`), Spring's `JdbcClient`, and they are the
//// default rather than an alternative: a positional list beside a multi-line
//// statement is where the off-by-one lives.
////
//// `bindNamed` rewrites each `:name` to the arm's own placeholder in the order
//// the names first appear — `$1`, `$2`, … for PostgreSQL and the ETS arm, `?`
//// for MySQL — and answers the values to pass. The same name used twice is ONE
//// value on a numbered dialect (`$1` twice) and one value per occurrence on
//// MySQL, whose `?` is positional. A `:name` inside a quoted literal is text,
//// and `::` is PostgreSQL's cast, not a parameter.
////
//// A `:name` with no `Param`, a `Param` the statement never mentions, and a
//// `Param` given twice are each a refusal naming the parameter and the
//// statement — never a null bind. The VALUE is never spliced into the text,
//// which is the whole of the injection rule: a value holding
//// `'; DROP TABLE users; --` reaches the driver as a value.

import {charOf, sub} from "rakun";

pub type Param(name: string, value: string)

pub fn param(name: string, value: string) -> Param {
    return Param(name: name, value: value);
}

// The rewritten statement, the values in placeholder order, the distinct names
// in first-appearance order, and the refusal (`""` when it bound).
pub type Bound(
    sql: string,
    values: string[],
    names: string[],
    problem: string,
)

fn isNameStart(c: string) -> bool {
    return c != "" && ("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_".contains(c));
}

fn isNamePart(c: string) -> bool {
    return c != "" && ("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789".contains(c));
}

fn indexIn(xs: string[], x: string) -> i32 {
    var found = -1;
    var i = 0;
    for (xs) { y ->
        if (found < 0 && y == x) found = i;
        i = i + 1;
    };
    return found;
}

fn valueOf(params: Param[], name: string) -> string {
    var v = "";
    for (params) { p -> if (p.name == name) v = p.value; };
    return v;
}

fn countOf(params: Param[], name: string) -> i32 {
    var n = 0;
    for (params) { p -> if (p.name == name) n = n + 1; };
    return n;
}

// The `:name` occurrences of a statement, in order, repeats included.
pub fn placeholderNames(sql: string) -> string[] {
    var out: string[] = [];
    var inQuote = false;
    var i = 0;
    val n = sql.length();
    while (i < n) {
        val c = charOf(sql, i);
        if (inQuote) {
            if (c == "'") inQuote = false;
            i = i + 1;
        } else if (c == "'") {
            inQuote = true;
            i = i + 1;
        } else if (c == ":" && charOf(sql, i + 1) == ":") {
            i = i + 2;
        } else if (c == ":" && isNameStart(charOf(sql, i + 1))) {
            var j = i + 1;
            while (j < n && isNamePart(charOf(sql, j))) {
                j = j + 1;
            };
            out.push(sub(sql, i + 1, j));
            i = j;
        } else {
            i = i + 1;
        };
    };
    return out;
}

// `dialect` is the arm: `postgresql` and `ets` number (`$1`), `mysql` repeats `?`.
pub fn bindNamed(sql: string, params: Param[], dialect: string) -> Bound {
    val numbered = dialect != "mysql";
    var out = "";
    var names: string[] = [];
    var values: string[] = [];
    var inQuote = false;
    var i = 0;
    val n = sql.length();
    while (i < n) {
        val c = charOf(sql, i);
        if (inQuote) {
            if (c == "'") inQuote = false;
            out = out + c;
            i = i + 1;
        } else if (c == "'") {
            inQuote = true;
            out = out + c;
            i = i + 1;
        } else if (c == ":" && charOf(sql, i + 1) == ":") {
            out = out + "::";
            i = i + 2;
        } else if (c == ":" && isNameStart(charOf(sql, i + 1))) {
            var j = i + 1;
            while (j < n && isNamePart(charOf(sql, j))) {
                j = j + 1;
            };
            val name = sub(sql, i + 1, j);
            if (indexIn(names, name) < 0) {
                names.push(name);
                if (numbered) values.push(valueOf(params, name));
            };
            if (numbered == false) values.push(valueOf(params, name));
            out = out + (if (numbered) "$" + (indexIn(names, name) + 1).toString() else "?");
            i = j;
        } else {
            out = out + c;
            i = i + 1;
        };
    };
    return Bound(sql: out, values: values, names: names, problem: bindProblem(sql, names, params));
}

// `""`, or the first thing wrong with the pairing of names and params.
pub fn bindProblem(sql: string, names: string[], params: Param[]) -> string {
    var problem = "";
    for (names) { name ->
        if (problem == "" && countOf(params, name) == 0) problem = "rakun-data: the statement names :" + name + " but no Param '" + name + "' was given - statement: " + sql;
    };
    for (params) { p ->
        if (problem == "" && countOf(params, p.name) > 1) problem = "rakun-data: Param '" + p.name + "' is given twice - statement: " + sql;
    };
    for (params) { p ->
        if (problem == "" && indexIn(names, p.name) < 0) problem = "rakun-data: Param '" + p.name + "' is not used by the statement - statement: " + sql;
    };
    return problem;
}

// `id=1, name=ana` — how a statement's params read in the statement log.
pub fn paramsLine(params: Param[]) -> string {
    var parts: string[] = [];
    for (params) { p -> parts.push(p.name + "=" + p.value); };
    return parts.join(", ");
}
