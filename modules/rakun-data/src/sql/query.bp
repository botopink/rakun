//// rakun-data — `#[query]`: the repository shape, decided once. Front 08
//// step 5 (front 09's `#[documentQuery]` follows it).
////
//// A method in a `type` body must have a body, so the Spring Data shape — a
//// bodyless `#[query("…")] pub fn findById(…);` — does not parse. `#[query]` is
//// therefore a METHOD-level decorator that gives the owning type a member
//// (decision 216 of 1.0.11-beta), and the method's body calls it:
////
////     #[query("SELECT id, name FROM users WHERE id = :id")]
////     pub fn findById(self: Self, id: i32) -> ?Row {
////         return self.sql.single(UserRepository.findByIdSql(), [param("id", id.toString())]);
////     }
////
//// gives
////
////     UserRepository.findByIdSql() -> string     "SELECT id, name FROM users WHERE id = :id"
////     rkRegisterQuery("findById", "SELECT …")   — an executor, run before `main`
////
//// What the decorator buys over an inline string:
////   1. the statement is a DECLARATION — a decorator argument is a literal, so
////      it cannot be built by concatenation (the injection rule, enforced by
////      the shape);
////   2. it is REGISTERED — `rkRegisteredQueries()` is the inventory of every
////      statement the application can issue (`/actuator/sql`, front 77's
////      linter);
////   3. it is CHECKED at comptime for what the text shows: an empty statement,
////      a leading keyword that is not SELECT / INSERT / UPDATE / DELETE / WITH /
////      CALL, and a `'` immediately followed by a placeholder sigil (`':id`,
////      `'$1`, `'?` — the concatenation smell; `'…'::type` is a cast and passes)
////      each fail the build at the annotated method.
////
//// NOT checked: the placeholder count against the method's parameters — a
//// method-level `@Decl` exposes no parameter list (language gap, README).
////
//// The registration is an executor compiled beside the annotated method
//// (`compiler.compile`), so two `#[query]` methods of one name on two types of
//// one module are two registrations and build.
////
//// Decorator-body rules (see rakun's AGENTS.md): no sibling calls, no `//`
//// comments inside the body, the outputs first and the placement checks last.

import {compiler, compiler.DeclKind} from "std";

#[@external(.Erlang("rakun_sql:register_query($0, $1)"))]
pub declare fn rkRegisterQuery(name: string, sql: string) -> i32;

#[@external(.Erlang("rakun_sql:registered_queries()"))]
pub declare fn rkRegisteredQueries() -> string[];

pub fn query(expr decl: unknown, comptime sql: string) {
    val literal = sql
        .replaceAll("\\", "\\\\")
        .replaceAll("\"", "\\\"")
        .replaceAll("\n", "\\n");
    compiler.addMember(
        "pub fn "
            + compiler.name(decl)!
            + "Sql() -> string { return \""
            + literal
            + "\"; }",
    );
    val methodName = compiler.name(decl)!;
    compiler.compile({ -> rkRegisterQuery(methodName, sql); });
    val trimmed = sql.trim();
    val head = (trimmed
        .replaceAll("\n", " ")
        .replaceAll("\t", " ")
        .replaceAll("(", " ")
        .split(" ")
        .at(0) ?? "").toUpper();
    val known = head == "SELECT"
        || head == "INSERT"
        || head == "UPDATE"
        || head == "DELETE"
        || head == "WITH"
        || head == "CALL";
    val uncast = sql.replaceAll("'::", "");
    val smell = uncast.contains("':")
        || uncast.contains("'$")
        || uncast.contains("'?");
    if (compiler.kind(decl) != DeclKind.Method)
        compiler.fail("#[query] must annotate a method of a repository type", at: decl);
    if (trimmed == "") compiler.fail("#[query] statement is empty", at: decl);
    if ((trimmed != "" && known == false))
        compiler.fail(
            "#[query] statement starts with '"
                + head
                + "', which is not one of SELECT, INSERT, UPDATE, DELETE, WITH, CALL",
            at: decl,
        );
    if (smell)
        compiler.fail(
            "#[query] statement has a quote next to a placeholder (':name, '$1 or '?) - a placeholder is a bound value, never text inside a literal; write :name without the quotes",
            at: decl,
        );
}
