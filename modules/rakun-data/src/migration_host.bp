//// rakun-data — the host cells of front 77's migrations
//// (`rakun_migration.erl`). Root-level; its move into `migration/` is not measured
//// (RX-14 names only `orm_host.bp`).

#[@external(.Erlang("rakun_migration:with_lock($0, $1, $2)"))]
declare fn cellWithLock<T>(ds: string, timeoutMs: i32, work: fn() -> T) -> T;

#[@external(.Erlang("rakun_migration:split($0)"))]
declare fn cellSplit(text: string) -> string[];

#[@external(.Erlang("rakun_migration:compare($0, $1)"))]
declare fn cellCompare(a: string, b: string) -> i32;

#[@external(.Erlang("rakun_migration:try_run($0)"))]
declare fn cellTry(work: fn() -> i32) -> string;

#[@external(.Erlang("rakun_migration:table_count($0)"))]
declare fn cellTableCount(ds: string) -> i32;

#[@external(.Erlang("rakun_migration:now_iso()"))]
declare fn cellNowIso() -> string;

#[@external(.Erlang("rakun_migration:now_ms()"))]
declare fn cellNowMs() -> i64;

#[@external(.Erlang("rakun_migration:unlocked_warning($0)"))]
declare fn cellUnlockedWarning(ds: string) -> i32;

#[@external(.Erlang("rakun_migration:warnings()"))]
declare fn cellWarnings() -> string[];

#[@external(.Erlang("rakun_migration:lock_events()"))]
declare fn cellLockEvents() -> string[];

#[@external(.Erlang("rakun_migration:live_columns($0, $1)"))]
declare fn cellLiveColumns(ds: string, table: string) -> string;

pub fn rkMigLiveColumns(ds: string, table: string) -> string {
    return cellLiveColumns(ds, table);
}

pub fn rkMigWithLock<T>(ds: string, timeoutMs: i32, work: fn() -> T) -> T {
    return cellWithLock(ds, timeoutMs, work);
}

pub fn rkMigSplit(text: string) -> string[] {
    return cellSplit(text);
}

// `-1`, `0` or `1`: versions compared component-wise as integers.
pub fn compareVersions(a: string, b: string) -> i32 {
    return cellCompare(a, b);
}

pub fn rkMigTry(work: fn() -> i32) -> string {
    return cellTry(work);
}

pub fn rkMigTableCount(ds: string) -> i32 {
    return cellTableCount(ds);
}

pub fn rkMigNowIso() -> string {
    return cellNowIso();
}

pub fn rkMigNowMs() -> i64 {
    return cellNowMs();
}

pub fn rkMigUnlockedWarning(ds: string) -> i32 {
    return cellUnlockedWarning(ds);
}

pub fn rkMigWarnings() -> string[] {
    return cellWarnings();
}

pub fn rkMigLockEvents() -> string[] {
    return cellLockEvents();
}
