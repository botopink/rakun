//// rakun-client — what a request answers (front 13 step 2).
////
//// A non-2xx response is RETURNED, not raised: the caller decides with
//// `isOk()`. A request that never got a response — refused by the address
//// filter, a connect or read timeout, a refused connection — answers status
//// `-1` with the reason as the body, the shape std's erlang `fetch` used for a
//// failed request before it moved to `@Result`.

#[@External.Erlang("rakun_client", "header_get")]
pub declare fn rkClientHeaderGet(headersJson: string, name: string) -> string;

// `headersJson` is a JSON object of the response headers, names lowercased,
// a repeated header joined with `, `.
pub type ClientResponse(status: i32, body: string, headersJson: string) {
    pub fn isOk(self: Self) -> bool {
        val ok = if (self.status < 200) { false } else { self.status < 300 };
        return ok;
    }

    // One response header, case-insensitively; `""` when absent.
    pub fn header(self: Self, name: string) -> string {
        return rkClientHeaderGet(self.headersJson, name);
    }
}

// The answer of a request that never reached a response.
pub fn failedResponse(reason: string) -> ClientResponse {
    return ClientResponse(status: -1, body: reason, headersJson: "{}");
}
