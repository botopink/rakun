//// rakun-client — module-tree root (front 13).
////
//// `RestClient` over one builder with two terminal operations (`retrieve`,
//// `retrieveFuture`), global and per-client settings, the SSRF address filter
//// every connect goes through, response caching over front 12's store (a soft
//// seam), `#[httpExchange]` service interfaces and a per-group health
//// indicator. Erlang only; the transport is std's `io.net`.
////
//// The order is a DEPENDENCY order and `botopink.json`'s `files` repeats it.

pub mod address;
pub mod settings;
pub mod response;
pub mod cache;
pub mod transport;
pub mod health;
pub mod client;
pub mod request;
pub mod exchange;
