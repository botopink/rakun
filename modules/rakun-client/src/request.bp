//// rakun-client — the step functions as module functions (front 13 steps 2
//// and 4): `retrieveFuture(spec)`, `cached(spec, …)`, `revalidate(spec, n)`.
////
//// They are the same operations as the `RequestSpec` methods of the same
//// names, spelled as functions for callers that compose them (`await
//// retrieveFuture(client.get(p))`). They live in their own module because a
//// module function and a method of one name and arity in ONE module would be
//// one Erlang function.
////
//// `retrieveFuture` returns `@Task<ClientResponse>`: the return type is the
//// whole declaration of the effect (decision 118). It is EAGER on erlang — the
//// request has completed when the call returns — so two calls issued before
//// either is awaited run one after the other.

import {ClientResponse} from "response";
import {CacheLife} from "cache";
import {HttpClientSettings} from "settings";
import {RestClient, RequestSpec, retrieveSpec, cachedSpec} from "client";

pub fn retrieveFuture(spec: RequestSpec) -> @Task<ClientResponse> {
    return retrieveSpec(spec);
}

pub fn cached(spec: RequestSpec, name: string, life: CacheLife, tags: Array<string>) -> RequestSpec {
    return cachedSpec(spec, name, life, tags);
}

pub fn revalidate(spec: RequestSpec, seconds: i32) -> RequestSpec {
    return spec.revalidate(seconds);
}
