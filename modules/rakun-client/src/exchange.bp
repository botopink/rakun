//// rakun-client — HTTP service interfaces: `#[httpExchange]` (front 13 step 5).
////
//// Spring's `@HttpExchange` turns an interface into a generated client. Here
//// the same comptime twin-type mechanism `onze`'s `#[mock]` uses: the decorator
//// reflects a `behavior` and `@emit`s a type implementing it plus a factory.
////
////     #[httpExchange("echo")]
////     pub behavior EchoService {
////         #[getExchange("/users/:id")]
////         fn user(self: Self, id: string) -> string;
////
////         #[postExchange("/echo")]
////         fn echo(self: Self, body: string) -> string;
////     }
////
//// emits
////
////     pub type HttpEchoService(client: RestClient) implement EchoService {
////         fn user(self: Self, id: string) -> string {
////             return self.client.exchange("GET", "/users/:id", ["id"], [id], "");
////         }
////         fn echo(self: Self, body: string) -> string {
////             return self.client.exchange("POST", "/echo", [], [], body);
////         }
////     }
////     pub fn httpEchoService() -> EchoService {
////         return HttpEchoService(client: RestClient.forGroup("echo"));
////     }
////
//// The emission names only `RestClient` (a method call and a static call on
//// it), so the application site imports `RestClient` — with its type closure,
//// `HttpClientSettings`, `CacheLife` and `ClientResponse`, because importing a
//// type re-checks its declaration at the importing site (rakun AGENTS.md,
//// "unknown type") — and nothing else of this member. The group's client reads
//// `rakun.http.serviceclient.<group>.base-url` (required) and the group's
//// timeouts, redirects and bundle, each falling back to the global key; two
//// groups never share settings.
////
//// THE RULES, each a located build failure (never an emitted type that cannot
//// work):
////   * `:name` in a path must be a parameter of the method — both names are in
////     the message;
////   * GET, DELETE (and HEAD/OPTIONS) take no body: every parameter must be a
////     path parameter;
////   * POST, PUT, PATCH take exactly one parameter that is not a path
////     parameter, and it is the body;
////   * every parameter and the return type are `string` — std has no derivation
////     from its `Json` value to a record (language gap), so a typed body cannot
////     be decoded or encoded here;
////   * exactly one exchange annotation per method; a method without one fails;
////   * `#[getExchange]`…`#[deleteExchange]` on anything but a method fail, and
////     `#[httpExchange]` on anything but a behavior fails.
////
//// A decorator body is comptime and cannot call a sibling function, which is
//// why `httpExchange` is one long function.

pub fn httpExchange(comptime decl: @Decl, group: string) {
    val g = group.replaceAll("\"", "").trim();
    var problems: Array<string> = [];
    var methods: Array<string> = [];
    decl.methods.forEach({ m ->
        var verb = "";
        var path = "";
        var count = 0;
        m.annotations.forEach({ a ->
            val v = if (a.name == "getExchange") "GET" else if (a.name == "postExchange") "POST" else if (a.name == "putExchange") "PUT" else if (a.name == "patchExchange") "PATCH" else if (a.name == "deleteExchange") "DELETE" else "";
            val isExchange = v != "";
            val nextVerb = if (isExchange) v else verb;
            verb = nextVerb;
            val nextPath = if (isExchange) a.args.join("").replaceAll("\"", "").trim() else path;
            path = nextPath;
            val nextCount = if (isExchange) count + 1 else count;
            count = nextCount;
        });
        val label = decl.name + "." + m.name;
        if (count == 0) problems.push(label + " has no exchange annotation - add #[getExchange], #[postExchange], #[putExchange], #[patchExchange] or #[deleteExchange]");
        if (count > 1) problems.push(label + " has more than one exchange annotation");
        if (m.returnType != "string") problems.push(label + " returns `" + m.returnType + "`, but an exchange method returns the body as string: std has no JSON value model to decode a response into a record (language gap), so a typed return cannot work");
        var params: Array<string> = [];
        var args: Array<string> = [];
        m.params.forEach({ p ->
            if (p.name != "self") {
                params.push(p.name);
                args.push(p.name + ": " + p.typeName);
                if (p.typeName != "string") problems.push(label + " parameter `" + p.name + "` is `" + p.typeName + "`, but exchange parameters are string");
            };
        });
        var pathNames: Array<string> = [];
        path.split("/").forEach({ seg ->
            if (seg.startsWith(":")) {
                val name = seg.replaceAll(":", "");
                pathNames.push(name);
                if (params.contains(name) == false) problems.push(label + " path " + path + " names `:" + name + "`, but the method has no parameter `" + name + "` (parameters: " + params.join(", ") + ")");
            };
        });
        var rest: Array<string> = [];
        params.forEach({ p ->
            if (pathNames.contains(p) == false) rest.push(p);
        });
        val bodied = verb == "POST" || verb == "PUT" || verb == "PATCH";
        if (bodied && rest.length != 1) problems.push(label + " is a " + verb + ": exactly one parameter that is not a path parameter carries the body, and it has " + rest.length.toString() + " (" + rest.join(", ") + ")");
        if ((bodied == false) && verb != "" && rest.length > 0) problems.push(label + " is a " + verb + " and takes no body, but parameter `" + rest.join("`, `") + "` is not in the path " + path);
        val body = if (bodied) rest.join("") else "\"\"";
        val names = "[" + pathNames.map({ n -> "\"" + n + "\"" }).join(", ") + "]";
        val values = "[" + pathNames.join(", ") + "]";
        val sig = if (args.length > 0) "self: Self, " + args.join(", ") else "self: Self";
        val call = "self.client.exchange(\"" + verb + "\", \"" + path + "\", " + names + ", " + values + ", " + body + ")";
        methods.push("fn " + m.name + "(" + sig + ") -> string {\n        return " + call + ";\n    }");
    });
    if (decl.kind != DeclKind.Behavior) decl.fail("#[httpExchange] must annotate a behavior - the generated client is a type implementing it");
    if (g == "") decl.fail("#[httpExchange] needs a group name: #[httpExchange(\"<group>\")] reads rakun.http.serviceclient.<group>.*");
    if (problems.length > 0) decl.fail("#[httpExchange(\"" + g + "\")] on " + decl.name + ": " + problems.join("; "));
    @emit("pub type Http" + decl.name + "(client: RestClient) implement " + decl.name + " {\n    " + methods.join("\n\n    ") + "\n}");
    @emit("pub fn http" + decl.name + "() -> " + decl.name + " { return Http" + decl.name + "(client: RestClient.forGroup(\"" + g + "\")); }");
}

pub fn getExchange(comptime decl: @Decl, path: string) {
    if (decl.kind != DeclKind.Method) decl.fail("#[getExchange] must annotate a method of a #[httpExchange] behavior");
}

pub fn postExchange(comptime decl: @Decl, path: string) {
    if (decl.kind != DeclKind.Method) decl.fail("#[postExchange] must annotate a method of a #[httpExchange] behavior");
}

pub fn putExchange(comptime decl: @Decl, path: string) {
    if (decl.kind != DeclKind.Method) decl.fail("#[putExchange] must annotate a method of a #[httpExchange] behavior");
}

pub fn patchExchange(comptime decl: @Decl, path: string) {
    if (decl.kind != DeclKind.Method) decl.fail("#[patchExchange] must annotate a method of a #[httpExchange] behavior");
}

pub fn deleteExchange(comptime decl: @Decl, path: string) {
    if (decl.kind != DeclKind.Method) decl.fail("#[deleteExchange] must annotate a method of a #[httpExchange] behavior");
}
