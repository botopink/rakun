//// onze-assets — the preprocessor hook (front 69 step 4).
////
//// Sass and friends stay external tools: `preprocess(command, inputPath)`
//// runs the configured command through std's `process.run` with the input
//// path as its one argument and takes its stdout. No command configured means
//// the file's own text. A configured command that is missing, or exits
//// non-zero, fails the build naming it — a silent fallback would ship
//// unprocessed source as CSS. No plugin API, no loader model.

import {io.fs, io.process, io.process.Exit} from "std";

pub fn preprocess(command: string, inputPath: string) -> @Result<string, string> {
    if (command == "") return try fs.readText(inputPath);
    val ran = process.run(command, [inputPath]);
    val exit = case ran {
        Ok(e) -> e;
        Error(message) -> Exit(status: 0 - 1, stdout: "", stderr: message);
    };
    if (exit.status == 0 - 1)
        throw "preprocessor \"" + command + "\" could not run: " + exit.stderr;
    if (exit.status != 0)
        throw "preprocessor \""
            + command
            + "\" exited "
            + exit.status.toString()
            + " on "
            + inputPath
            + ": "
            + (exit.stderr + exit.stdout).trim().slice(0, 400);
    return exit.stdout;
}
