//// onze-assets — the head fragment (front 69): the stylesheet `<link>`s
//// first, then front 68's `beforeInteractive` scripts, as jhonstart's
//// `RenderHooks.headExtra`; `bodyExtra` is front 68's `scriptTags`. The
//// boot installs the result (front 49's `bootSite`).

import {RenderHooks} from "jhonstart";
import {ClientBundleManifest, ChunkRef, headScriptTags, scriptTags} from "onze-bundler";
import {stylesheet.stylesheetLinks};

pub fn headFragment(m: ClientBundleManifest) -> string {
    return [stylesheetLinks(m.styles), headScriptTags(m)]
        .filter({ s -> s != "" })
        .join("\n");
}

pub fn pageRenderHooks(m: ClientBundleManifest) -> RenderHooks {
    return RenderHooks(headExtra: { route -> headFragment(m) }, bodyExtra: { route -> scriptTags(m, route) });
}
