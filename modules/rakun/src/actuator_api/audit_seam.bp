//// rakun-actuator-api — the audit seam (front 87 step 4).
////
//// `rkAudit(kind, principal, data)` is the one function a module that emits
//// audit events calls (front 10's security filter). It hands the event to the
//// sink rakun-actuator's audit repository installed (`rkAuditInstallSink`),
//// and is a no-op answering 0 when none is — so the emitter never imports the
//// actuator, and runs unchanged without it.

#[@External.Erlang("""(fun(__K, __P, __D) -> case persistent_term:get(rakun_audit_sink, undefined) of undefined -> 0; __F -> try __F(__K, __P, __D) catch _:_ -> 0 end end end)($0, $1, $2)""")]
pub declare fn rkAudit(
    kind: string,
    principal: string,
    data: Array<#(string, string)>,
) -> i32;

#[@External.Erlang("""(fun(__F) -> persistent_term:put(rakun_audit_sink, __F), 1 end)($0)""")]
pub declare fn rkAuditInstallSink(
    sink: fn(kind: string, principal: string, data: Array<#(string, string)>) -> i32,
) -> i32;

#[@External.Erlang("""(fun() -> persistent_term:erase(rakun_audit_sink), 0 end)()""")]
pub declare fn rkAuditClearSink() -> i32;

#[@External.Erlang("""(fun() -> persistent_term:get(rakun_audit_sink, undefined) =/= undefined end)()""")]
pub declare fn rkAuditSinkInstalled() -> bool;
