//// rakun — the auto-configuration registry seam, and the manifest behind
//// `#[conditionalOnModule]`.
////
//// Two halves live here and neither of them decides anything.
////
//// THE TABLE. Every `#[autoConfiguration]`, every `#[bean]` method of one and
//// every `#[profile]`-gated component emits one `rkAutoRegister(name,
//// conditions, before, after)` at module load. botopink has no top-level
//// mutable state, so the rows live in the host: `./autoconfig.mjs` on the node
//// row and `./sidecars/rakun_autoconfig.erl` on the BEAM. Everything stored is
//// a STRING — which is the measurement that decides the split. Front 06 stores
//// a bean FACTORY, a lifecycle THUNK, a listener CLOSURE and an exit-code
//// GENERATOR, and no string table holds a fun, so its grammar stayed in
//// botopink and only its table crossed. Here nothing is a fun, so the host is
//// an append-only table and nothing more: the blob grammar, the sort, the
//// evaluation, every refusal text and the rendered report are `conditions.bp`,
//// `autoconfig.bp` and `condition_report.bp`, compiled to both targets.
////
//// THE MANIFEST. `#[conditionalOnModule("rakun-data")]` is botopink's answer to
//// Spring's `@ConditionalOnClass`: there is no classpath and no reflective
//// scan, so the question is "is this module a declared dependency", and the
//// manifest answers it. The read is botopink over `std`'s `fs.readText` rather
//// than a host cell, for one reason worth stating: the normaliser then has ONE
//// implementation compiled twice, and both on-disk shapes of `dependencies` —
//// the array of names and the object keyed by name — are asserted against
//// fixture files instead of against a second copy in two host languages.
////
//// The atom is `rakun_autoconfig`, never `autoconfig`: `shipErlSidecars` skips
//// any qualifier matching a module this build emitted, rakun emits
//// `rakun/autoconfig`, and the skip is SILENT — the build exits 0 and the
//// program dies with `undefined function autoconfig:auto_names/0`.
////
//// Reached via `from "rakun"`; see ../AGENTS.md § The auto-configuration pass.

import {io.fs} from "std";

// ── the table ───────────────────────────────────────────────────────────────
//
// `rkAutoRegister` is the cell the decorator bodies emit a call to, so it is
// in scope at every application site that imports the marker. `name` is `Type`
// for a configuration or a gated component and `Type.method` for a `#[bean]`
// method; `conditions` is the `;`-joined blob `conditions.bp` documents;
// `before` and `after` are comma-joined name lists, `""` when empty.
//
// A second registration of one name REPLACES the first rather than appending a
// twin: a module loaded twice must not double a row, and a doubled row would
// make the report lie about the size of the table.

#[@External.Node("./autoconfig.mjs", "autoRegister"),
  @External.Erlang("rakun_autoconfig", "auto_register")]
pub declare fn rkAutoRegister(name: string, conditions: string, before: string, after: string) -> i32;

// What an entry contributes to the registered set once it matches. It is NOT a
// condition, so it is NOT a record of the condition blob: `rkAutoConditions`
// has to answer the blob the annotations produced, verbatim, or it stops being
// the comptime half's assertion point. A configuration provides itself; a
// `#[bean]` method provides its return type, which is the one piece of the
// entry the name cannot carry.

#[@External.Node("./autoconfig.mjs", "autoProvides"),
  @External.Erlang("rakun_autoconfig", "auto_provides")]
pub declare fn rkAutoProvides(name: string, typeName: string) -> i32;

#[@External.Node("./autoconfig.mjs", "autoProvided"),
  @External.Erlang("rakun_autoconfig", "auto_provided")]
pub declare fn rkAutoProvided(name: string) -> string;

#[@External.Node("./autoconfig.mjs", "autoNames"),
  @External.Erlang("rakun_autoconfig", "auto_names")]
pub declare fn rkAutoNames() -> string;

#[@External.Node("./autoconfig.mjs", "autoCount"),
  @External.Erlang("rakun_autoconfig", "auto_count")]
pub declare fn rkAutoCount() -> i32;

// The comptime half's assertion point: the blob a given annotation set produced,
// verbatim, with nothing between the decorator body and the assertion.
#[@External.Node("./autoconfig.mjs", "autoConditions"),
  @External.Erlang("rakun_autoconfig", "auto_conditions")]
pub declare fn rkAutoConditions(name: string) -> string;

#[@External.Node("./autoconfig.mjs", "autoBefore"),
  @External.Erlang("rakun_autoconfig", "auto_before")]
pub declare fn rkAutoBefore(name: string) -> string;

#[@External.Node("./autoconfig.mjs", "autoAfter"),
  @External.Erlang("rakun_autoconfig", "auto_after")]
pub declare fn rkAutoAfter(name: string) -> string;

#[@External.Node("./autoconfig.mjs", "autoKnown"),
  @External.Erlang("rakun_autoconfig", "auto_known")]
pub declare fn rkAutoKnown(name: string) -> bool;

// ── the decisions ───────────────────────────────────────────────────────────
//
// One row per name once the apply pass has walked it: the state (`applied`,
// `skipped` or `excluded`) and the reason, which is empty for `applied` and
// names the FIRST failing condition record plus the value observed otherwise.

#[@External.Node("./autoconfig.mjs", "autoDecide"),
  @External.Erlang("rakun_autoconfig", "auto_decide")]
pub declare fn rkAutoDecide(name: string, state: string, reason: string) -> i32;

#[@External.Node("./autoconfig.mjs", "autoState"),
  @External.Erlang("rakun_autoconfig", "auto_state")]
pub declare fn rkAutoState(name: string) -> string;

#[@External.Node("./autoconfig.mjs", "autoReason"),
  @External.Erlang("rakun_autoconfig", "auto_reason")]
pub declare fn rkAutoReason(name: string) -> string;

// ── the seal ────────────────────────────────────────────────────────────────
//
// `rkAutoSeal` records that the pass ran and the order it sorted into. Both
// halves of that matter: the seal is what makes `autoConfigure()` idempotent,
// and the recorded order is what lets the report be stable across runs and
// what a test reads to prove the sort happened BEFORE the evaluation.

#[@External.Node("./autoconfig.mjs", "autoSeal"),
  @External.Erlang("rakun_autoconfig", "auto_seal")]
pub declare fn rkAutoSeal(order: string) -> i32;

#[@External.Node("./autoconfig.mjs", "autoSealed"),
  @External.Erlang("rakun_autoconfig", "auto_sealed")]
pub declare fn rkAutoSealed() -> bool;

#[@External.Node("./autoconfig.mjs", "autoOrder"),
  @External.Erlang("rakun_autoconfig", "auto_order")]
pub declare fn rkAutoOrder() -> string;

// Drops the decisions and the seal and KEEPS the registrations: a test
// re-applies over the same table, which is the shape every assertion here
// wants. `rkAutoReset` drops the registrations too, for a test that builds its
// own table from nothing.

#[@External.Node("./autoconfig.mjs", "autoUnseal"),
  @External.Erlang("rakun_autoconfig", "auto_unseal")]
pub declare fn rkAutoUnseal() -> i32;

#[@External.Node("./autoconfig.mjs", "autoReset"),
  @External.Erlang("rakun_autoconfig", "auto_reset")]
pub declare fn rkAutoReset() -> i32;

// ── the `--debug` printer ───────────────────────────────────────────────────
//
// `println` (and `print`) in `libs/std/src/builtins.d.bp` have no erlang
// lowering: the emitted module calls a bare local `println/1`, `erlc` refuses
// it with `function println/1 undefined`, and the test runner's
// `__bp_load_siblings/0` then skips that module SILENTLY — every function in it
// answers `{error,undef}` at the first call, which points at the caller rather
// than at the print. Measured, smallest program and both rows, in
// ../AGENTS.md § The auto-configuration pass. Until it is closed, the report
// prints through a cell of this front's own, which costs one line per row.

#[@External.Node("./autoconfig.mjs", "printLine"),
  @External.Erlang("rakun_autoconfig", "print_line")]
pub declare fn rkAutoPrint(line: string) -> i32;

// ── the manifest ────────────────────────────────────────────────────────────
//
// `botopink.json`'s `dependencies` has two on-disk shapes and
// `compiler-cli/src/cli/config.zig` normalises both into one list of names:
//
//     "dependencies": ["rakun", "std"]
//     "dependencies": { "rakun": { "workspace": true } }
//
// The reader below normalises the same two the same way. It is a scanner, not
// a JSON parser: it finds the `dependencies` key, takes the balanced container
// that follows, and collects the names at ITS top level — every quoted string
// for the array shape, every quoted KEY for the object shape. Nothing else in
// the manifest is read, and a value nested inside a dependency's object is at
// depth 1 and therefore never mistaken for a name.

pub fn manifestName() -> string {
    return "botopink.json";
}

fn charAt(s: string, i: i32) -> string {
    return s.at(i).unwrapOr("");
}

// The index just past the closing quote of the string literal starting at
// `open` (which must be the opening quote). A backslash escapes the next
// character, so a name is never cut short by an escaped quote.
fn endOfQuoted(s: string, open: i32) -> i32 {
    var i = open + 1;
    var run = true;
    while (run) {
        val c = charAt(s, i);
        if (c == "") run = false else if (c == "\\") i = i + 2 else if (c == "\"") {
            i = i + 1;
            run = false;
        } else i = i + 1;
    };
    return i;
}

fn quotedAt(s: string, open: i32) -> string {
    val stop = endOfQuoted(s, open);
    val inner = stop - 1;
    var out = "";
    var i = open + 1;
    while (i < inner) {
        out = out + charAt(s, i);
        i = i + 1;
    };
    return out;
}

// The index of the first `[` or `{` at or after `from`, or -1.
fn openerAfter(s: string, begin: i32) -> i32 {
    var i = begin;
    var found = 0 - 1;
    var run = true;
    while (run) {
        val c = charAt(s, i);
        if (c == "") run = false else if (c == "[" || c == "{") {
            found = i;
            run = false;
        } else i = i + 1;
    };
    return found;
}

// The first non-space, non-newline character at or after `from`.
fn nextSolid(s: string, begin: i32) -> string {
    var i = begin;
    var out = "";
    var run = true;
    while (run) {
        val c = charAt(s, i);
        val blank = (c == " " || c == "\n" || c == "\r" || c == "\t");
        if (c == "") run = false else if (blank) i = i + 1 else {
            out = c;
            run = false;
        };
    };
    return out;
}

// The scan's state, carried as a value rather than as loop-local `var`s: the
// erlang backend lowers a loop body by collecting the variables it mutates
// into a tuple, and a `var` declared inside a nested block of a loop body
// comes out `unbound` in one of the branches. One loop per function, mutating
// only what that function declared — the rule `profiles.bp` is written around.
pub type DepScan(
    out: string[],
    i: i32,
    depth: i32,
    run: bool,
)

fn scanStep(text: string, isObject: bool, st: DepScan) -> DepScan {
    val c = charAt(text, st.i);
    if (c == "") return DepScan(out: st.out, i: st.i, depth: st.depth, run: false) else if (c == "\"") {
        val name = quotedAt(text, st.i);
        val stop = endOfQuoted(text, st.i);
        val isKey = nextSolid(text, stop) == ":";
        val take = (st.depth == 0) && (isObject == false || isKey);
        var out = st.out;
        if (take) out.push(name);
        return DepScan(out: out, i: stop, depth: st.depth, run: true);
    } else if (c == "[" || c == "{") {
        return DepScan(out: st.out, i: st.i + 1, depth: st.depth + 1, run: true);
    } else if (c == "]" || c == "}") {
        if (st.depth == 0) return DepScan(out: st.out, i: st.i + 1, depth: 0, run: false) else return DepScan(out: st.out, i: st.i + 1, depth: st.depth - 1, run: true);
    } else return DepScan(out: st.out, i: st.i + 1, depth: st.depth, run: true);
}

// The normaliser, over the manifest TEXT. Exposed because it is the assertion
// point for both on-disk shapes: a test hands it a literal and reads the list
// back, with no file and no host between the two.
pub fn manifestDependencies(text: string) -> string[] {
    val none: string[] = [];
    val at = text.indexOf("\"dependencies\"");
    if (at < 0) return none else {
        val open = openerAfter(text, at + 14);
        if (open < 0) return none else {
            val isObject = charAt(text, open) == "{";
            val seed: string[] = [];
            var st = DepScan(out: seed, i: open + 1, depth: 0, run: true);
            while (st.run) {
                st = scanStep(text, isObject, st);
            };
            return st.out;
        };
    };
}

// ── the module question ─────────────────────────────────────────────────────
//
// `moduleList()` is the application's own declared dependencies, read from the
// `botopink.json` of the working directory. A manifest that cannot be read is
// a REFUSAL, not a `false`: "this module is not a dependency" and "I could not
// find out" are different answers, and a condition that silently takes the
// second for the first turns every `#[conditionalOnModule]` in the build off
// without saying so.

pub fn manifestMissingProblem() -> string {
    return "rakun: #[conditionalOnModule] needs the application's " + manifestName() + " and none was readable from the working directory - run the program from the directory holding its manifest";
}

pub fn moduleListIn(path: string) -> string[] {
    val text = try fs.readText(path) catch "";
    if (text == "") {
        @panic(manifestMissingProblem());
    };
    return manifestDependencies(text);
}

pub fn moduleList() -> string[] {
    return moduleListIn(manifestName());
}

pub fn rkModulePresent(name: string) -> bool {
    var found = false;
    for (moduleList()) { m -> if (m == name) found = true; };
    return found;
}
