//// The `rakun` package — module-tree root.
////
//// The Spring-style framework's compiled surface: `decorators` (the component
//// markers AS comptime decorator fns + the DI/router wiring they `@emit`),
//// `http` (the `HttpMethod` enum · `Response` · `App` value types), and
//// `runtime` (the `#[@External.Node]` declarations binding the `runtime.mjs` mutable
//// seams). All three are public surface, reached by a consumer via `import {…}
//// from "rakun"` — the `@emit`ted wiring imports the runtime fns by name.
////
//// The boundary interfaces stay in a declaration module — `rakun.d.bp`
//// (`Request`/`Context`/`Rakun`) — wired through `botopink.json` `files` (loaded
//// with `.declaration = true` for a consumer), not the build tree: `.d.bp`
//// modules are not resolved by `mod` paths, mirroring how `libs/std` keeps its
//// ambient `.d.bp` out of `root.bp`.

pub mod decorators;
pub mod http;
pub mod runtime;
pub mod bootstrap;
// `profiles` is declared before `config` because `config` imports it. The
// binding rule is the `files` ORDER in `botopink.json` (a module has to be
// listed after every sibling it imports, as `http` is listed before `runtime`);
// a consumer's build otherwise reds with `unbound variable` inside rakun's own
// source, which is a confusing place to read it from. The tree here is kept in
// the same order so the two lists tell one story.
pub mod profiles;
pub mod config;
// `file_router` is declared last: it imports `runtime` (the property table the
// scan reads `appDir` from) and nothing imports it.
pub mod file_router;
// `request_context` and `request_memo` are declared last: the context imports
// `runtime` (the property table the deferred-work budget is read from) and the
// memo imports the context. Nothing in rakun imports either — fronts 23, 24 and
// 25 do, from outside.
pub mod request_context;
pub mod request_memo;
// `lifecycle` before `context`: nothing in rakun imports either today, but
// `context.bootSequence()` reaches the two passes and the `files` ORDER in
// `botopink.json` is a dependency order a consumer's build reads literally.
// `events` before `lifecycle` before `context`: `context` imports both (the
// boot sequence publishes the eight events and runs the post pass), and the
// `files` ORDER in `botopink.json` is a dependency order a consumer's build
// reads literally — a module listed before a sibling it imports reds with
// `unbound variable` inside rakun's own source.
pub mod events;
pub mod lifecycle;
pub mod context;
// `ssr` is declared after `file_router`, `request_context` and `request_memo`:
// front 23's pipeline imports all three, and the `files` ORDER in
// `botopink.json` is a dependency order a consumer's build reads literally.
pub mod ssr;
// Front 72's four modules close the tree, in dependency order: the registry
// seam (the host table plus the manifest read) is imported by `conditions`,
// `conditions` by `autoconfig`, and both by `condition_report`. The `files`
// ORDER in `botopink.json` is a dependency order a consumer's build reads
// literally, so the two lists stay the same story. `conditions` also imports
// `context`, which is why it is declared after it and not beside `runtime`.
pub mod autoconfig_registry;
pub mod conditions;
pub mod autoconfig;
pub mod condition_report;
// Front 74's bundle registry closes the tree: it imports `runtime` (the
// property table) and `config` (the typed readers and `rkValue`), and nothing in
// rakun imports it — fronts 04, 08, 09, 13, 15, 76, 79, 85 and 90 do, from
// outside, and `modules/rakun-web/src/tls.bp` is the first of them.
pub mod ssl_bundle;
