//// rakun — the request context: the frame, its epoch, and the five phases.
////
//// WHY THIS EXISTS. A rakun handler gets a `Request` value and that value
//// exists only inside the function the router dispatched to. A `#[service]`
//// three calls down cannot see it, a page rendered by the SSR pipeline is never
//// handed one, and `Response` is `(status, body)` with `src/http.bp` frozen, so
//// there is no field to put a `Set-Cookie` in. Authentication, theme
//// personalization, draft mode, per-request deduplication and the
//// dynamic-rendering decision all bottom out here.
////
//// THE SCOPE IS A FRAME, NOT A PROCESS. On the BEAM a request is served by a
//// process, and process-local state is very nearly request scope — but a
//// keep-alive connection process serves many requests in sequence, so process
//// identity is NOT request identity. A scope that is implicit in the process is
//// a scope that leaks the previous request's cookies into the next one. So the
//// frame is explicit and carries an EPOCH: every handle minted from it carries
//// the epoch it was minted with, and a handle used after `endRequest`, or from
//// the next request on the same connection, raises instead of writing into
//// somebody else's response.
////
//// READING OUTSIDE A REQUEST IS A HARD FAILURE. `headers()` with no frame does
//// not answer an empty map, does not answer `null` and does not consult a
//// default: it raises. There is no `headersOr(default)`, no
//// `rakun.request.lenient` property and no predicate to branch around it — a
//// predicate is an escape hatch with a different spelling. A library that has
//// to work both inside and outside a request takes the values as parameters.
////
//// WHY THIS FRONT SHIPS BOTH HOST FILES WHERE FRONT 05 SHIPPED NONE. Front 05's
//// three measurements still hold and none is violated here: every cell below
//// carries BOTH forms, so neither row has a call with no binding; `runtime.mjs`
//// is frozen but `request_context.mjs` is this front's own file; and the atom
//// `rakun_request_context` is named in emitted output, so `shipErlSidecars`
//// copies it. What decides the shape is front 22's test — is the thing being
//// stored PURE? A config reader is; this frame is not. It carries a queue of
//// deferred THUNKS and a memo table of arbitrary typed VALUES, and no string
//// table holds either. The hosts hold a slot store, a keyed line list, a queue,
//// a table and a counter; the phase rules, the wire grammars, the cookie
//// serialization and every refusal message are botopink, compiled twice.

import {rkProp, rkPropInt} from "runtime";
import {charOf, sub} from "config";
import {crypto} from "std";

// ── the five phases ─────────────────────────────────────────────────────────
//
// | | `headers()` | `cookies()` | `.set`/`.delete` | `after()` | marks dynamic |
// |---|---|---|---|---|---|
// | `Middleware` | yes | yes | yes | yes | n/a |
// | `Render` | yes | yes | RAISES | yes | yes |
// | `Action` | yes | yes | yes | yes | n/a |
// | `Handler` | yes | yes | yes | yes | yes |
// | `After` | yes | yes | RAISES | RAISES | n/a |
//
// A cookie write during render raises rather than warns: by the time a render
// is running the response head may already be on the wire. `After` is the
// frozen copy — the response is gone, so every write would be a no-op waiting
// to be found in production, and raising is the cheaper discovery.

pub type RequestPhase {
    Middleware,
    Render,
    Action,
    Handler,
    After,
}

pub fn phaseName(phase: RequestPhase) -> string {
    val name = case phase {
        RequestPhase.Middleware -> "middleware";
        RequestPhase.Render -> "render";
        RequestPhase.Action -> "action";
        RequestPhase.Handler -> "handler";
        RequestPhase.After -> "after";
    };
    return name;
}

// Total by construction: the only writer of the slot is `phaseName`. An unknown
// spelling is a host that was written around rather than through this module,
// and it raises rather than picking a phase for it.
pub fn phaseFrom(name: string) -> RequestPhase {
    if (name == "middleware") return RequestPhase.Middleware;
    if (name == "render") return RequestPhase.Render;
    if (name == "action") return RequestPhase.Action;
    if (name == "handler") return RequestPhase.Handler;
    if (name == "after") return RequestPhase.After;
    @panic("rakun request: `" + name + "` is not a request phase");
    return RequestPhase.Handler;
}

// The BASE a request hook's `use`s anchor at (decision 128, front 24's guide
// § 4.4): a hook over the request is `-> @Component<RequestBase, T>`, and the
// one-base rule keeps it out of a jhonstart component (`ElementBase`). It is a
// marker and carries nothing. `RequestScope` owns the context — the frame a
// request runs inside — which is what `implement @Context<RequestBase>` says.
pub type RequestBase {}

// `headersWire` is `name\tvalue` lines, `\n`-separated, names already lowercased
// by the dispatcher. Cookies are parsed out of the `cookie` header by this
// front, not passed separately.
pub type RequestScope(
    id: string,
    phase: RequestPhase,
    method: string,
    path: string,
    query: string,
    headersWire: string,
    strict: bool,
) implement @Context<RequestBase>

// ── the host cells ──────────────────────────────────────────────────────────
//
// A keyed slot store over one process-dictionary key, and nothing else. The
// host never reads a slot's MEANING: `beginRequest` writes them and the
// accessors below read them back.

#[@External.Node("./request_context.mjs", "begin"),
  @External.Erlang("rakun_request_context", "begin_frame")]
pub declare fn rkReqBegin(id: string) -> i64;

#[@External.Node("./request_context.mjs", "end"),
  @External.Erlang("rakun_request_context", "end_frame")]
pub declare fn rkReqEnd() -> i32;

#[@External.Node("./request_context.mjs", "isLive"),
  @External.Erlang("rakun_request_context", "is_live")]
pub declare fn rkReqLive() -> bool;

#[@External.Node("./request_context.mjs", "epoch"),
  @External.Erlang("rakun_request_context", "epoch")]
pub declare fn rkReqEpoch() -> i64;

#[@External.Node("./request_context.mjs", "slot"),
  @External.Erlang("rakun_request_context", "slot")]
pub declare fn rkReqSlot(name: string) -> string;

#[@External.Node("./request_context.mjs", "putSlot"),
  @External.Erlang("rakun_request_context", "put_slot")]
pub declare fn rkReqPutSlot(name: string, value: string) -> i32;

// The queued `Set-Cookie` lines. A keyed line list, insertion-ordered and
// replaced by key: front 04's `rkSetReplyHeader/2` replaces by NAME, so it can
// carry one `Set-Cookie` and no more, and this front therefore queues fully
// serialized lines on the frame and hands the list back from `endRequest()`.
// The host knows only "a keyed list of lines" — the same primitive
// `set_reply_header/2` already is; it does not know what a cookie looks like.

#[@External.Node("./request_context.mjs", "queueCookie"),
  @External.Erlang("rakun_request_context", "queue_cookie")]
pub declare fn rkReqQueueCookie(name: string, line: string) -> i32;

#[@External.Node("./request_context.mjs", "cookieBlob"),
  @External.Erlang("rakun_request_context", "cookie_blob")]
pub declare fn rkReqCookieBlob() -> string;

// ── deferred work: the host cells ───────────────────────────────────────────
//
// `defer` holds a THUNK, which is the second half of why this front ships host
// files at all: no string table holds a closure. `startDeferred` freezes the
// frame and starts the work; `afterWait` reaps it and enforces the budget. The
// dispatcher calls both, in that order, around writing the response.

#[@External.Node("./request_context.mjs", "defer"),
  @External.Erlang("rakun_request_context", "defer")]
pub declare fn rkReqDefer(work: fn() -> i32) -> i32;

#[@External.Node("./request_context.mjs", "deferCount"),
  @External.Erlang("rakun_request_context", "defer_count")]
pub declare fn rkReqDeferCount() -> i32;

#[@External.Node("./request_context.mjs", "startDeferred"),
  @External.Erlang("rakun_request_context", "start_deferred")]
pub declare fn rkReqStartDeferred(timeoutMs: i32) -> i32;

#[@External.Node("./request_context.mjs", "afterWait"),
  @External.Erlang("rakun_request_context", "after_wait")]
pub declare fn rkReqAfterWait(budgetMs: i32) -> i32;

#[@External.Node("./request_context.mjs", "afterStat"),
  @External.Erlang("rakun_request_context", "after_stat")]
pub declare fn rkReqAfterStat(name: string) -> i32;

#[@External.Node("./request_context.mjs", "afterLog"),
  @External.Erlang("rakun_request_context", "after_log")]
pub declare fn rkReqAfterLog() -> string;

#[@External.Node("./request_context.mjs", "afterReset"),
  @External.Erlang("rakun_request_context", "after_reset")]
pub declare fn rkReqAfterReset() -> i32;

// The shared scratch. A deferred child is a different PROCESS on the BEAM, so a
// counter it bumps cannot live in either dictionary; this is the ETS the front's
// own text names when it says "the loader increments an ETS counter".

#[@External.Node("./request_context.mjs", "shareBump"),
  @External.Erlang("rakun_request_context", "share_bump")]
pub declare fn rkReqShareBump(key: string) -> i32;

#[@External.Node("./request_context.mjs", "shareCount"),
  @External.Erlang("rakun_request_context", "share_count")]
pub declare fn rkReqShareCount(key: string) -> i32;

#[@External.Node("./request_context.mjs", "sharePut"),
  @External.Erlang("rakun_request_context", "share_put")]
pub declare fn rkReqSharePut(key: string, value: string) -> i32;

#[@External.Node("./request_context.mjs", "shareGet"),
  @External.Erlang("rakun_request_context", "share_get")]
pub declare fn rkReqShareGet(key: string) -> string;

#[@External.Node("./request_context.mjs", "shareReset"),
  @External.Erlang("rakun_request_context", "share_reset")]
pub declare fn rkReqShareReset() -> i32;

// A BLOCKING sleep. Front 01's `clock` module does not exist yet and the
// deferred-work and single-flight assertions need a thunk that is still
// running; `timer:sleep/1` on the BEAM and `Atomics.wait` on node are the two
// synchronous ones there are.
#[@External.Node("./request_context.mjs", "sleep"),
  @External.Erlang("rakun_request_context", "sleep")]
pub declare fn rkReqSleep(ms: i32) -> i32;

// ── the per-request memo table: the host cells ──────────────────────────────
//
// `rkSingleton` one scope down, and generic for the same reason: the caller
// keeps its own type instead of stringifying. The table lives IN the frame, so
// it dies with the request. `request_memo.bp` is the surface over these.

#[@External.Node("./request_context.mjs", "memoState"),
  @External.Erlang("rakun_request_context", "memo_state")]
pub declare fn rkMemoState(key: string) -> i32;

#[@External.Node("./request_context.mjs", "memoResolve"),
  @External.Erlang("rakun_request_context", "memo_resolve")]
pub declare fn rkMemoResolve<T>(key: string, load: fn() -> T) -> T;

#[@External.Node("./request_context.mjs", "memoPreload"),
  @External.Erlang("rakun_request_context", "memo_preload")]
pub declare fn rkMemoPreload<T>(key: string, load: fn() -> T) -> i32;

#[@External.Node("./request_context.mjs", "memoCount"),
  @External.Erlang("rakun_request_context", "memo_count")]
pub declare fn rkMemoCount(name: string) -> i32;

// ── the refusals ────────────────────────────────────────────────────────────
//
// Each message is a function of its own, for the reason `durationProblem` is:
// a test reads the text without the halt taking the test down, and the words a
// consumer will paste into a search engine are written once.

pub fn noFrameProblem(what: string) -> string {
    return "rakun request: request context is not established - " + what
        + " is legal only while a request is in flight";
}

pub fn nestedFrameProblem(outerPath: string) -> string {
    return "rakun request: a request context is already established for `" + outerPath
        + "` - beginRequest inside a request scope is a dispatcher bug, not a feature";
}

pub fn staleEpochProblem(what: string) -> string {
    return "rakun request: this " + what
        + " handle belongs to a request that has ended - a handle captured across "
        + "requests would write into somebody else's response";
}

// ── the frame ───────────────────────────────────────────────────────────────

pub fn requestLive() -> bool {
    return rkReqLive();
}

fn demand(what: string) -> i32 {
    if (rkReqLive() == false) @panic(noFrameProblem(what));
    return 0;
}

// The same guard, exported, so `request_memo.bp` raises in the same words
// rather than spelling the refusal a second time.
pub fn demandRequest(what: string) -> i32 {
    return demand(what);
}

pub fn beginRequest(scope: RequestScope) -> i64 {
    if (rkReqLive()) @panic(nestedFrameProblem(rkReqSlot("path")));
    val epoch = rkReqBegin(scope.id);
    val _m = rkReqPutSlot("method", scope.method);
    val _p = rkReqPutSlot("path", scope.path);
    val _q = rkReqPutSlot("query", scope.query);
    val _w = rkReqPutSlot("headers", scope.headersWire);
    val _f = rkReqPutSlot("phase", phaseName(scope.phase));
    val _s = rkReqPutSlot("strict", if (scope.strict) "1" else "");
    return epoch;
}

// The dispatcher contract is three lines and this is the middle of them: the
// blob is read, the deferred work is STARTED with a frozen copy of the frame,
// and only then is the key erased. The work is reaped by `drainAfter()` once
// the response is on the wire.
pub fn endRequest() -> string {
    val _d = demand("endRequest()");
    val blob: string = rkReqCookieBlob();
    val _s = rkReqStartDeferred(afterTimeoutMs());
    val _e = rkReqEnd();
    return blob;
}

pub fn setPhase(phase: RequestPhase) -> i32 {
    val _d = demand("setPhase()");
    return rkReqPutSlot("phase", phaseName(phase));
}

pub fn requestPhase() -> RequestPhase {
    val _d = demand("requestPhase()");
    return phaseFrom(rkReqSlot("phase"));
}

pub fn requestId() -> string {
    val _d = demand("requestId()");
    return rkReqSlot("id");
}

pub fn requestEpoch() -> i64 {
    val _d = demand("requestEpoch()");
    return rkReqEpoch();
}

pub fn requestPath() -> string {
    val _d = demand("requestPath()");
    return rkReqSlot("path");
}

pub fn requestMethod() -> string {
    val _d = demand("requestMethod()");
    return rkReqSlot("method");
}

pub fn requestQuery() -> string {
    val _d = demand("requestQuery()");
    return rkReqSlot("query");
}

// `strict` is set by front 60's build-time prerenderer and by nothing else.
// With `strict = false` — the serving path — a dynamic read marks and
// continues; with `strict = true` it raises, naming the function and the route,
// which is how `output: 'export'` fails the build rather than shipping a page
// that read a cookie at build time.
pub fn requestStrict() -> bool {
    val _d = demand("requestStrict()");
    return rkReqSlot("strict") != "";
}

// The epoch a handle has to match. Split out so every handle type asks the same
// question in the same words.
pub fn checkEpoch(epoch: i64, what: string) -> i32 {
    val _d = demand(what + "()");
    if (rkReqEpoch() != epoch) @panic(staleEpochProblem(what));
    return 0;
}

// The deferred-work budget, read where front 05's table can set it.
pub fn afterTimeoutMs() -> i32 {
    val raw: i32 = rkPropInt("rakun.request.after.timeout");
    if (raw <= 0) return 30000;
    return raw;
}

// ── the dynamic marker ──────────────────────────────────────────────────────
//
// Every accessor that reads the in-flight request marks the render dynamic when
// the phase is `Render` or `Handler`. `connection()` marks and reads nothing,
// which is its whole purpose. Front 60 reads `isDynamic()` after the render to
// decide whether the output may become a prerendered entry, and
// `dynamicReason()` names the FIRST function that made it dynamic — which is
// what turns "this page is not being prerendered" from a mystery into a line of
// build output.
//
// `strict` is the other mode, set by front 60's build-time prerenderer and by
// nothing else: a dynamic read RAISES there, naming the function and the route,
// which is how `output: 'export'` fails the build rather than silently shipping
// a page that read a cookie at build time.

pub fn strictProblem(what: string, path: string) -> string {
    return "rakun request: " + what + "() read the in-flight request while prerendering `"
        + path + "` - a strict render may not be dynamic";
}

pub fn markDynamic(reason: string) -> i32 {
    val _d = demand("markDynamic()");
    if (requestStrict()) @panic(strictProblem(reason, rkReqSlot("path")));
    val first: string = rkReqSlot("reason");
    val keep: string = if (first == "") reason else first;
    val _r = rkReqPutSlot("reason", keep);
    return rkReqPutSlot("dynamic", "1");
}

pub fn isDynamic() -> bool {
    val _d = demand("isDynamic()");
    return rkReqSlot("dynamic") != "";
}

pub fn dynamicReason() -> string {
    val _d = demand("dynamicReason()");
    return rkReqSlot("reason");
}

// Only `Render` and `Handler` can be prerendered, so only they carry a dynamic
// decision; `Middleware`, `Action` and `After` are dynamic by construction and
// marking them would put a reason on a render that never existed.
fn markIfRendering(what: string) -> i32 {
    val _d = demand(what + "()");
    val phase: string = rkReqSlot("phase");
    val rendering = ((phase == "render") || (phase == "handler"));
    if (rendering) return markDynamic(what);
    return 0;
}

// ── the header wire ─────────────────────────────────────────────────────────
//
// `name\tvalue` lines, `\n`-separated, names already lowercased by the
// dispatcher — `headerName` lowercases again anyway, because a lookup that
// trusts its caller is a lookup that answers `null` in production. A repeated
// header is joined with `", "`, which is what RFC 9110 § 5.3 says a recipient
// may do and what front 04's dispatcher already does for a repeated query key.
//
// The three readers below take the WIRE as a parameter, so the grammar is
// unit-testable with no frame, no process and no socket.

pub fn headerNames(wire: string) -> string[] {
    var out: string[] = [];
    val lines: string[] = wire.split("\n");
    var i = 0;
    while (i < lines.length()) {
        val line: string = lines.at(i).unwrapOr("");
        val tab: i32 = line.indexOf("\t");
        val name: string = if (tab > 0) sub(line, 0, tab).toLower() else "";
        val fresh = ((name != "") && (out.indexOf(name) < 0));
        if (fresh) out.push(name);
        i = i + 1;
    };
    return out;
}

pub fn headerLookup(wire: string, name: string) -> string {
    val want: string = name.toLower().trim();
    val lines: string[] = wire.split("\n");
    var out = "";
    var found = false;
    var i = 0;
    while (i < lines.length()) {
        val line: string = lines.at(i).unwrapOr("");
        val tab: i32 = line.indexOf("\t");
        val key: string = if (tab > 0) sub(line, 0, tab).toLower() else "";
        val value: string = if (tab > 0) sub(line, tab + 1, line.length()) else "";
        val hit = ((key != "") && (key == want));
        val joined: string = if (found) out + ", " + value else value;
        out = if (hit) joined else out;
        found = if (hit) true else found;
        i = i + 1;
    };
    return out;
}

pub fn headerPresent(wire: string, name: string) -> bool {
    val want: string = name.toLower().trim();
    return headerNames(wire).indexOf(want) >= 0;
}

// ── headers() ───────────────────────────────────────────────────────────────
//
// `get` answers `?string` and `null` for an absent header — the one place this
// front deliberately differs from `Request.header`, which is frozen at plain
// `string`. A header that is absent and a header whose value is empty are
// different questions, and a server that cannot tell them apart cannot
// implement a conditional request.

pub type Headers(
    epoch: i64,
) {
    pub fn get(self: Self, name: string) -> ?string {
        val _c = checkEpoch(self.epoch, "headers");
        val wire: string = rkReqSlot("headers");
        if (headerPresent(wire, name) == false) return null;
        return headerLookup(wire, name);
    }

    pub fn has(self: Self, name: string) -> bool {
        val _c = checkEpoch(self.epoch, "headers");
        return headerPresent(rkReqSlot("headers"), name);
    }

    pub fn names(self: Self) -> string[] {
        val _c = checkEpoch(self.epoch, "headers");
        return headerNames(rkReqSlot("headers"));
    }
}

pub fn headers() -> Headers {
    val _m = markIfRendering("headers");
    return Headers(epoch: rkReqEpoch());
}

// Read a header with `headerOf(h, name, fallback)`, not
// `headers().get(name).unwrapOr(fallback)`. The optional a record method
// answers loses its type when the receiver is itself a CALL — the shape
// `paramOf` already exists for in `file_router.bp` — and `.unwrapOr` is then a
// bare local call that no module defines. This is the typed form, and it is
// what fronts 23, 24 and 25 should use.
pub fn headerOf(h: Headers, name: string, fallback: string) -> string {
    val found: ?string = h.get(name);
    return found.unwrapOr(fallback);
}

// ── percent encoding ────────────────────────────────────────────────────────
//
// There is no byte type (front 01 recorded it) and `charCodeAt` answers a
// UTF-16 code unit on node against a codepoint on the BEAM — two reasons the
// two rows cannot be made to agree about a non-ASCII octet. (A third used to be
// listed here — `std`'s `unicode` was `undef` on the erlang row from a `test/`
// file — and it is gone: `unicode.firstCodepoint` from a test file is green on
// both rows as of `4fe1747e`. Widening this encoder past ASCII is a behaviour
// change for the front that owns the cookie grammar.) So this encoder is ASCII and
// says so: a character at or above 128 makes `serializeCookie` RAISE, naming
// the cookie, rather than writing a byte sequence one row would read back
// differently from the other. A caller with a non-ASCII value encodes it
// itself — base64url is the usual answer, and a session token already is one.
//
// `idiv` is here because `i32 / i32` is FLOAT division on commonJS (`233 / 16`
// is `14.5625`) and integer division on erlang (`14`). Subtracting the
// remainder first makes the quotient exact on both rows.

fn idiv(a: i32, b: i32) -> i32 {
    return (a - a % b) / b;
}

fn hexDigit(n: i32) -> string {
    return charOf("0123456789ABCDEF", n);
}

pub fn hexByte(code: i32) -> string {
    return hexDigit(idiv(code, 16)) + hexDigit(code % 16);
}

// Index == code - 32. Only the printable range is here, deliberately: a decoder
// that can produce a control character is a decoder that can put a newline in a
// header, and this front's contract is that a `Set-Cookie` line cannot hold one.
fn printableAscii() -> string {
    return " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~";
}

fn unreserved(c: string) -> bool {
    if (c == "") return false;
    return "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_.~".indexOf(c) >= 0;
}

// A control character is percent-encoded — that is how `serializeCookie`'s
// promise that a `Set-Cookie` line cannot hold a newline is kept. A character
// ABOVE printable ASCII is refused, because there is no byte type and the two
// rows do not agree what octets it is.
//
// On the erlang row this guard is unreachable: a non-ASCII string LITERAL makes
// `String.length()` raise `{badarg, <<...>>}` before any code here runs, which
// is why `test/request_context_test.bp` asserts the refusal TEXT and the
// negative case rather than the positive one. Recorded in `AGENTS.md`, not
// worked around.
pub fn nonAscii(raw: string) -> bool {
    var found = false;
    var i = 0;
    while (i < raw.length()) {
        val code: i32 = charOf(raw, i).charCodeAt(0);
        found = if (code > 126) true else found;
        i = i + 1;
    };
    return found;
}

pub fn percentEncode(raw: string) -> string {
    var out = "";
    var i = 0;
    while (i < raw.length()) {
        val c: string = charOf(raw, i);
        val code: i32 = c.charCodeAt(0);
        val escaped: string = if (code < 128) "%" + hexByte(code) else c;
        val piece: string = if (unreserved(c)) c else escaped;
        out = out + piece;
        i = i + 1;
    };
    return out;
}

fn hexValue(c: string) -> i32 {
    if (c == "") return -1;
    return "0123456789ABCDEF".indexOf(c.toUpper());
}

// `%XX` in the printable ASCII range decodes; anything else stays as written.
// Rebuilding a codepoint out of octets needs a byte type this language does not
// have, and producing a control character out of an escape is how a newline
// reaches a header. Leaving the escape untouched is lossless and round-trips;
// guessing would not.
pub fn percentDecode(raw: string) -> string {
    var out = "";
    var i = 0;
    while (i < raw.length()) {
        val c: string = charOf(raw, i);
        val hi: i32 = if (c == "%") hexValue(charOf(raw, i + 1)) else -1;
        val lo: i32 = if (c == "%") hexValue(charOf(raw, i + 2)) else -1;
        val pair = ((hi >= 0) && (lo >= 0));
        val code: i32 = if (pair) hi * 16 + lo else -1;
        val decodable = ((code >= 32) && (code <= 126));
        val piece: string = if (decodable) charOf(printableAscii(), code - 32) else c;
        val step: i32 = if (decodable) 3 else 1;
        out = out + piece;
        i = i + step;
    };
    return out;
}

// ── cookies ─────────────────────────────────────────────────────────────────
//
// `cookieDefaults()` is the restrictive end of every axis, because a default
// that has to be tightened is a default that ships untightened.
//
// ONE DEFECT IN THAT SENTENCE IS THE SPEC'S AND IS IMPLEMENTED AS WRITTEN.
// `maxAge = 0` is NOT the restrictive end of the lifetime axis: RFC 6265
// § 5.2.2 says a `Max-Age` at or below zero expires the cookie immediately, so
// `serializeCookie(n, v, cookieDefaults())` writes a line the user agent
// deletes on arrival. The restrictive-and-correct default is to OMIT `Max-Age`
// — a session cookie, gone when the browser closes. The front's acceptance
// pins the literal `s=a%20b; Path=/; Max-Age=0; HttpOnly; Secure; SameSite=Lax`
// and eleven fronts cite this one, so the literal is honoured and the defect is
// written down rather than silently corrected: a caller that wants the cookie
// to survive the response passes its own `maxAge`, and `delete` is told apart
// from a defaulted `set` by its EMPTY value, not by its `Max-Age`.

pub type CookieAttrs(
    path: string,
    domain: string,
    maxAge: i32,
    httpOnly: bool,
    secure: bool,
    sameSite: string,
)

pub fn cookieDefaults() -> CookieAttrs {
    return CookieAttrs(
        path: "/",
        domain: "",
        maxAge: 0,
        httpOnly: true,
        secure: true,
        sameSite: "Lax",
    );
}

pub fn cookieValueProblem(name: string) -> string {
    return "rakun request: cookie `" + name
        + "` carries a character outside printable ASCII - there is no byte type, so the "
        + "two backends cannot agree what octets that is; encode the value yourself "
        + "(base64url) before setting it";
}

pub fn cookiePhaseProblem(phase: string) -> string {
    return "rakun request: a cookie may not be written in phase `" + phase
        + "` - a cookie may be set from a server action, a route handler or middleware, "
        + "never from a render (the response head may already be on the wire) and never "
        + "after the response is sent";
}

// The one place a cookie becomes a wire line. Pure, so it is asserted as a
// literal string with no socket anywhere near it.
pub fn serializeCookie(name: string, value: string, attrs: CookieAttrs) -> string {
    if (nonAscii(name)) @panic(cookieValueProblem(name));
    if (nonAscii(value)) @panic(cookieValueProblem(name));
    var out: string = name + "=" + percentEncode(value);
    val path: string = attrs.path;
    if (path != "") out = out + "; Path=" + path;
    val domain: string = attrs.domain;
    if (domain != "") out = out + "; Domain=" + domain;
    out = out + "; Max-Age=" + attrs.maxAge.toString();
    if (attrs.httpOnly) out = out + "; HttpOnly";
    if (attrs.secure) out = out + "; Secure";
    val sameSite: string = attrs.sameSite;
    if (sameSite != "") out = out + "; SameSite=" + sameSite;
    return out;
}

// ── the cookie request header ───────────────────────────────────────────────
//
// `name=value; name2=value2`. A chunk with no `=` contributes nothing — it does
// not become an entry with an empty value, because a cookie the client never
// sent must not read as one it did. Spaces around the separators are trimmed, a
// trailing `;` produces an empty chunk that is skipped, and a cookie NAME is
// case-sensitive where a header name is not.

fn cookieChunkName(chunk: string) -> string {
    val c: string = chunk.trim();
    val eq: i32 = c.indexOf("=");
    if (eq <= 0) return "";
    return sub(c, 0, eq).trim();
}

fn cookieChunkValue(chunk: string) -> string {
    val c: string = chunk.trim();
    val eq: i32 = c.indexOf("=");
    if (eq <= 0) return "";
    return percentDecode(sub(c, eq + 1, c.length()).trim());
}

pub fn cookieNames(header: string) -> string[] {
    var out: string[] = [];
    val chunks: string[] = header.split(";");
    var i = 0;
    while (i < chunks.length()) {
        val name: string = cookieChunkName(chunks.at(i).unwrapOr(""));
        val fresh = ((name != "") && (out.indexOf(name) < 0));
        if (fresh) out.push(name);
        i = i + 1;
    };
    return out;
}

// The FIRST occurrence wins, which is what RFC 6265 § 5.4 says a server should
// assume when a client sends one name twice.
pub fn cookieLookup(header: string, name: string) -> string {
    val chunks: string[] = header.split(";");
    var out = "";
    var found = false;
    var i = 0;
    while (i < chunks.length()) {
        val chunk: string = chunks.at(i).unwrapOr("");
        val hit = ((cookieChunkName(chunk) == name) && (found == false));
        out = if (hit) cookieChunkValue(chunk) else out;
        found = if (hit) true else found;
        i = i + 1;
    };
    return out;
}

pub fn cookiePresent(header: string, name: string) -> bool {
    return cookieNames(header).indexOf(name) >= 0;
}

// ── cookies() ───────────────────────────────────────────────────────────────

fn cookieHeader() -> string {
    return headerLookup(rkReqSlot("headers"), "cookie");
}

fn demandWritablePhase() -> i32 {
    val phase: string = rkReqSlot("phase");
    val blocked = ((phase == "render") || (phase == "after"));
    if (blocked) @panic(cookiePhaseProblem(phase));
    return 0;
}

pub type Cookies(
    epoch: i64,
) {
    pub fn get(self: Self, name: string) -> ?string {
        val _c = checkEpoch(self.epoch, "cookies");
        val header: string = cookieHeader();
        if (cookiePresent(header, name) == false) return null;
        return cookieLookup(header, name);
    }

    pub fn has(self: Self, name: string) -> bool {
        val _c = checkEpoch(self.epoch, "cookies");
        return cookiePresent(cookieHeader(), name);
    }

    pub fn names(self: Self) -> string[] {
        val _c = checkEpoch(self.epoch, "cookies");
        return cookieNames(cookieHeader());
    }

    pub fn set(self: Self, name: string, value: string, attrs: CookieAttrs) -> i32 {
        val _c = checkEpoch(self.epoch, "cookies");
        val _p = demandWritablePhase();
        return rkReqQueueCookie(name, serializeCookie(name, value, attrs));
    }

    pub fn delete(self: Self, name: string) -> i32 {
        val _c = checkEpoch(self.epoch, "cookies");
        val _p = demandWritablePhase();
        val attrs = cookieDefaults();
        return rkReqQueueCookie(name, serializeCookie(name, "", attrs));
    }
}

pub fn cookies() -> Cookies {
    val _m = markIfRendering("cookies");
    return Cookies(epoch: rkReqEpoch());
}

// The typed read, for the reason `headerOf` is typed: the optional a record
// method answers loses its type when the receiver is a call.
pub fn cookieOf(c: Cookies, name: string, fallback: string) -> string {
    val found: ?string = c.get(name);
    return found.unwrapOr(fallback);
}

// ── draft mode ──────────────────────────────────────────────────────────────
//
// `__rakun_draft` is a SIGNED cookie: `token + "." + signature`. `isEnabled`
// recomputes the signature and compares it in constant time, so a forged or
// truncated cookie is simply not enabled and the comparison is not a signing
// oracle. An empty `rakun.draft.secret` makes `enable()` raise at the first
// call rather than issue an unsigned bypass — an unsigned bypass cookie is a
// public preview of every unpublished draft on the site.
//
// TWO DEVIATIONS FROM THE FRONT'S TEXT, both because front 01's `hmac` and
// `random` modules do not exist in `libs/std` today. The signature is
// `crypto.hmacSha256`, which is HEX rather than base64url, and the token is
// `crypto.randomBytes(16)`, which is hex too. Both carry an `@External.Node`
// and an `@External.Erlang` form and both answer identically on the two rows,
// which is the property that matters; the encoding is wider on the wire and
// nothing else. When front 01 lands, `draftSign` is the one function to change.

pub fn draftCookieName() -> string {
    return "__rakun_draft";
}

pub fn draftSecret() -> string {
    return rkProp("rakun.draft.secret");
}

pub fn draftSecretProblem() -> string {
    return "rakun request: draft mode needs `rakun.draft.secret` - an unsigned bypass "
        + "cookie is a public preview of every unpublished draft on the site, so enable() "
        + "refuses rather than issuing one";
}

pub fn draftSign(secret: string, token: string) -> string {
    return crypto.hmacSha256(secret, token);
}

// A day, not forever: a preview bypass with no expiry is a permanent hole in
// the published site, and the frame cannot use `cookieDefaults()` here because
// its `maxAge` of 0 would delete the cookie on arrival (see the defect note
// above `cookieDefaults`).
pub fn draftAttrs() -> CookieAttrs {
    return CookieAttrs(
        path: "/",
        domain: "",
        maxAge: 86400,
        httpOnly: true,
        secure: true,
        sameSite: "Lax",
    );
}

// Constant-time in the only sense a language with no byte type can promise: no
// early exit and the same number of comparisons whatever the inputs are. A
// length mismatch is folded into the accumulator rather than short-circuited,
// for the same reason.
pub fn equalsConstantTime(a: string, b: string) -> bool {
    val la: i32 = a.length();
    val lb: i32 = b.length();
    val n: i32 = if (la > lb) la else lb;
    var diff = 0;
    var i = 0;
    while (i < n) {
        val same = (charOf(a, i) == charOf(b, i));
        val step: i32 = if (same) 0 else 1;
        diff = diff + step;
        i = i + 1;
    };
    val lengthPenalty: i32 = if (la == lb) 0 else 1;
    return (diff + lengthPenalty) == 0;
}

pub fn draftVerify(secret: string, value: string) -> bool {
    if (secret == "") return false;
    val dot: i32 = value.indexOf(".");
    if (dot <= 0) return false;
    val token: string = sub(value, 0, dot);
    val signature: string = sub(value, dot + 1, value.length());
    if (signature == "") return false;
    return equalsConstantTime(signature, draftSign(secret, token));
}

pub type DraftMode(
    epoch: i64,
) {
    pub fn isEnabled(self: Self) -> bool {
        val _c = checkEpoch(self.epoch, "draftMode");
        return draftVerify(draftSecret(), cookieLookup(cookieHeader(), draftCookieName()));
    }

    pub fn enable(self: Self) -> i32 {
        val _c = checkEpoch(self.epoch, "draftMode");
        val _p = demandWritablePhase();
        val secret: string = draftSecret();
        if (secret == "") @panic(draftSecretProblem());
        val token: string = crypto.randomBytes(16);
        val value: string = token + "." + draftSign(secret, token);
        val name: string = draftCookieName();
        val _q = rkReqQueueCookie(name, serializeCookie(name, value, draftAttrs()));
        val _b = rkReqPutSlot("draft", "1");
        return markDynamic("draftMode");
    }

    pub fn disable(self: Self) -> i32 {
        val _c = checkEpoch(self.epoch, "draftMode");
        val _p = demandWritablePhase();
        val name: string = draftCookieName();
        val _q = rkReqQueueCookie(name, serializeCookie(name, "", cookieDefaults()));
        val _b = rkReqPutSlot("draft", "");
        return markDynamic("draftMode");
    }
}

pub fn draftMode() -> DraftMode {
    val _m = markIfRendering("draftMode");
    return DraftMode(epoch: rkReqEpoch());
}

// The one coupling between this front and front 60, and it is one boolean:
// draft mode instructs the prerenderer to bypass its entry for this request.
pub fn draftBypass() -> bool {
    val _d = demand("draftBypass()");
    return rkReqSlot("draft") != "";
}

// `connection()` reads nothing and marks — that is its whole purpose. It is how
// a route says "I am dynamic" without pretending to need a header.
pub fn connection() -> i32 {
    val _d = demand("connection()");
    return markDynamic("connection");
}

// ── after() ─────────────────────────────────────────────────────────────────
//
// `after(work)` schedules work to run once the response is sent. On the BEAM
// each thunk is a `spawn_monitor` child holding a FROZEN copy of the frame
// under phase `After`, so it can still read the headers and the cookies of the
// request it belongs to and can write nothing. On node there is no process and
// no way to interrupt a synchronous function: the thunk runs in a try/catch
// with the same frozen copy installed, and a thunk that OVERRAN the budget is
// counted and logged in the slot the BEAM kills into. That is the one place the
// two rows are not the same mechanism, and no assertion here claims otherwise.

pub fn afterPhaseProblem() -> string {
    return "rakun request: after() may not be called from deferred work - the response "
        + "is already written, so a second round of deferred work would run against a "
        + "request nobody is waiting on";
}

pub fn after(work: fn() -> i32) -> i32 {
    val _d = demand("after()");
    if (rkReqSlot("phase") == "after") @panic(afterPhaseProblem());
    return rkReqDefer(work);
}

pub fn deferredCount() -> i32 {
    val _d = demand("deferredCount()");
    return rkReqDeferCount();
}

// Called by the dispatcher AFTER the response is on the wire. Reaps every child
// started by `endRequest`, enforcing `rakun.request.after.timeout` per child;
// answers how many settled. Nothing else in a connection process would reap
// them, so this is part of the contract rather than a test seam.
pub fn drainAfter(budgetMs: i32) -> i32 {
    return rkReqAfterWait(budgetMs);
}

pub fn afterStarted() -> i32 {
    return rkReqAfterStat("started");
}

pub fn afterCompleted() -> i32 {
    return rkReqAfterStat("ok");
}

pub fn afterFailed() -> i32 {
    return rkReqAfterStat("failed");
}

pub fn afterKilled() -> i32 {
    return rkReqAfterStat("killed");
}

// What front 17 is handed: one line per deferred failure or kill, each carrying
// the REQUEST ID, because a deferred failure with no request to hang it on is a
// line nobody can act on.
pub fn afterLog() -> string {
    return rkReqAfterLog();
}

pub fn afterReset() -> i32 {
    return rkReqAfterReset();
}
