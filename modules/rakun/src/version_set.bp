//// rakun — the version set (front 73): the one table that maps every module
//// under `modules/` and every starter under `starters/` to the version this
//// release of rakun pins.
////
//// Three readers share it: the actuator's `info` (the `rakun` key: the
//// framework version and the version of every resolved rakun module), the
//// starter lint (`test/starter_manifest_test.bp` — a starter naming a module
//// the set does not know fails), and a developer asking which `rakun-data`
//// this is. `test/version_set_test.bp` reads every manifest and fails when a
//// version disagrees with the table, when a directory has no row, or when a
//// row names no directory — authored data kept honest by a test.
////
//// `versionOf` answers `""` for a name nobody pinned, the flat-string contract
//// `Request.param` sets; a caller that must tell absent from empty compares
//// against `moduleVersions()`.

pub type ModuleVersion(
    name: string,
    version: string,
)

pub fn rakunVersion() -> string {
    return "0.0.1";
}

pub fn moduleVersions() -> ModuleVersion[] {
    val all: ModuleVersion[] = [
        ModuleVersion(name: "rakun", version: "0.0.1"),
        ModuleVersion(name: "rakun-actuator", version: "0.0.1"),
        ModuleVersion(name: "rakun-actuator-api", version: "0.0.1"),
        ModuleVersion(name: "rakun-app", version: "0.0.1"),
        ModuleVersion(name: "rakun-cache", version: "0.0.1"),
        ModuleVersion(name: "rakun-client", version: "0.0.1"),
        ModuleVersion(name: "rakun-data", version: "0.0.1"),
        ModuleVersion(name: "rakun-devtools", version: "0.0.1"),
        ModuleVersion(name: "rakun-hateoas", version: "0.0.1"),
        ModuleVersion(name: "rakun-logging", version: "0.0.1"),
        ModuleVersion(name: "rakun-metrics", version: "0.0.1"),
        ModuleVersion(name: "rakun-messaging", version: "0.0.1"),
        ModuleVersion(name: "rakun-release", version: "0.0.1"),
        ModuleVersion(name: "rakun-scheduling", version: "0.0.1"),
        ModuleVersion(name: "rakun-security", version: "0.0.1"),
        ModuleVersion(name: "rakun-session", version: "0.0.1"),
        ModuleVersion(name: "rakun-test", version: "0.0.1"),
        ModuleVersion(name: "rakun-tx", version: "0.0.1"),
        ModuleVersion(name: "rakun-web", version: "0.0.1"),
        ModuleVersion(name: "rakun-websocket", version: "0.0.1"),
        ModuleVersion(name: "rakun-starter", version: "0.0.1"),
        ModuleVersion(name: "rakun-starter-actuator", version: "0.0.1"),
        ModuleVersion(name: "rakun-starter-cache", version: "0.0.1"),
        ModuleVersion(name: "rakun-starter-data-sql", version: "0.0.1"),
        ModuleVersion(name: "rakun-starter-messaging", version: "0.0.1"),
        ModuleVersion(name: "rakun-starter-security", version: "0.0.1"),
        ModuleVersion(name: "rakun-starter-test", version: "0.0.1"),
        ModuleVersion(name: "rakun-starter-web", version: "0.0.1"),
    ];
    return all;
}

pub fn versionOf(name: string) -> string {
    val hit = moduleVersions().filter({ m -> m.name == name });
    return if (hit.length > 0) (hit.at(0) ?? ModuleVersion(name: "", version: "")).version else "";
}

// What the table gets wrong against the manifests on disk, each `(name,
// version)`: a version that disagrees, a directory with no row, a row with no
// directory. `[]` when the set is honest.
pub fn versionSetProblems(manifests: Array<#(string, string)>) -> string[] {
    var out: string[] = [];
    for (manifests) { m ->
        val row = versionOf(m._0);
        if (row == "") out.push("`" + m._0 + "` has a manifest and no row in the version set")
        else if (row != m._1) out.push("`" + m._0 + "` is " + m._1 + " in its manifest and " + row + " in the version set");
    };
    for (moduleVersions()) { v ->
        if (manifests.filter({ m -> m._0 == v.name }).length == 0) out.push("the version set pins `" + v.name + "`, which has no directory");
    };
    return out;
}
