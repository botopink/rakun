//// rakun — runtime surface (host-backed): the DI container + router seams.
////
//// These `declare fn`s map to the BEAM host module (botopink has no top-level
//// mutable state, so the scan registry / DI cache / router live in the host).
//// rakun is erlang-only (decision 113): the node twin `runtime.mjs` and every
//// node host form left with front 04's Step 10.
////
//// `#[@External.Erlang]` names the module atom `rakun_runtime`, shipped from
//// `./sidecars/rakun_runtime.erl` by `shipErlSidecars`. The atom is NOT
//// `runtime`: `shipErlSidecars` skips a qualifier matching a module the build
//// emitted, rakun emits `rakun/runtime`, and the skip is silent — the build
//// would exit 0 and the program would die with `undefined function
//// runtime:scan/1`. The name mapping is camelCase → snake_case, the only place
//// the cells and the host differ in spelling.
////
//// `pub` so a module compiled with rakun can reference them from the
//// self-registering `val`s the decorators `@emit`. Reached via `from "rakun"`.

import {Response, Request} from "http"; // sibling module — the handler type
// `rkRegisterRoute` names in its signature

// ── component scan ──────────────────────────────────────────────────────────
// A component decorator emits `val _ = rkScan("TypeName");` at module load.

#[@External.Erlang("rakun_runtime", "scan")]
pub declare fn rkScan(name: string) -> i32;

#[@External.Erlang("rakun_runtime", "scanned_names")]
pub declare fn rkScannedNames() -> string;

#[@External.Erlang("rakun_runtime", "scanned_count")]
pub declare fn rkScannedCount() -> i32;

// ── dependency-cycle guard ──────────────────────────────────────────────────
// A component factory brackets its construction with `rkEnter`/`rkDone`; a cycle
// makes `rkEnter` raise at first construction (see `enter/1` in rakun_runtime.erl).

#[@External.Erlang("rakun_runtime", "enter")]
pub declare fn rkEnter(name: string) -> i32;

#[@External.Erlang("rakun_runtime", "done")]
pub declare fn rkDone(name: string) -> i32;

// ── singleton scope ─────────────────────────────────────────────────────────
// A component factory is `rkSingleton("Type", { -> …construct… })`: the first
// resolve runs the thunk and caches the instance, every later resolve returns
// it. Generic over the constructed type `T` (like any typed host cell), so the
// emitted factory stays typed at `-> Type`. `rkBuildCount` reports how many
// times a type's constructor actually ran (1 for a singleton) — the scope assert.

#[@External.Erlang("rakun_runtime", "singleton")]
pub declare fn rkSingleton<T>(name: string, build: fn() -> T) -> T;

#[@External.Erlang("rakun_runtime", "build_count")]
pub declare fn rkBuildCount(name: string) -> i32;

// ── property injection (`#[value("key")]`) ──────────────────────────────────
// A `#[value("key")]` field is filled from the config source, NOT the DI graph.
// `rkProp` reads a string property, `rkPropInt` the same parsed as an `i32`, so
// the emitted constructor argument is typed to the field.

#[@External.Erlang("rakun_runtime", "set_prop")]
pub declare fn rkSetProp(key: string, value: string) -> i32;

#[@External.Erlang("rakun_runtime", "prop")]
pub declare fn rkProp(key: string) -> string;

#[@External.Erlang("rakun_runtime", "prop_int")]
pub declare fn rkPropInt(key: string) -> i32;

// ── router ──────────────────────────────────────────────────────────────────
// A controller decorator emits `rkRegisterRoute(verb, path, handler)` per mapped
// method; `rkDispatch` runs the matching handler (or returns a 404 Response).
//
// The handler is generic over the request type `Req` (it is always `Request` in
// practice): the emitted `{ req -> __rkMake_C().handler(req) }` closure binds
// `req` to a fresh type var that unifies NOMINALLY with the handler method's
// `Request` parameter. Pinning the param to the `Request` interface here instead
// would expand it structurally, and a structural interface does not unify with a
// nominal `Request` parameter — so the generic seam is what keeps the wiring typed.

#[@External.Erlang("rakun_runtime", "register_route")]
pub declare fn rkRegisterRoute<Req>(
    verb: string,
    path: string,
    handler: fn(req: Req) -> Response,
) -> i32;

#[@External.Erlang("rakun_runtime", "route_count")]
pub declare fn rkRouteCount() -> i32;

#[@External.Erlang("rakun_runtime", "route_paths")]
pub declare fn rkRoutePaths() -> string;

#[@External.Erlang("rakun_runtime", "dispatch")]
pub declare fn rkDispatch(verb: string, path: string) -> Response;

// The real-server dispatch seam: `rkServe` hands a socket request here as
// scalars (headers/query JSON-encoded so the boundary stays scalar). We match,
// build a LIVE `Request` (query/header/body populated), run the handler, and
// return its `Response`. `Rakun.run` passes a closure over this to the server.

#[@External.Erlang("rakun_runtime", "dispatch_http")]
pub declare fn rkDispatchHttp(
    verb: string,
    path: string,
    headersJson: string,
    queryJson: string,
    body: string,
) -> Response;

// ── HTTP server ─────────────────────────────────────────────────────────────
// `Rakun.run` starts the BEAM `gen_tcp` server through `rkServe`: it listens on
// `port` and decodes every socket request into the scalars `dispatcher` takes
// (headers and query JSON-encoded), then writes the returned `Response` back.
// Returns the port it listens on. The socket transport lives in rakun's own
// `rakun_runtime.erl` — there is no separate server library.

#[@External.Erlang("rakun_runtime", "serve")]
pub declare fn rkServe(
    port: i32,
    dispatcher: fn(method: string, path: string, headersJson: string, queryJson: string, body: string) -> Response,
) -> i32;

// Graceful shutdown's socket half (front 04's listener; front 07's
// `shutdown.bp` orders the sequence). `rkStopAccepting` stops the listener
// child — the acceptor owns the listening socket, so it closes and a new
// connection is refused — and keeps every connection process alive; answers
// the monotonic millisecond it stopped. `rkDrain` closes idle keep-alive
// connections at once and waits for busy ones up to `timeoutMs`, killing what
// is left; answers `"<drained>|<killed>"`. `rkConnectionCount` is the number
// of live connection processes.
#[@External.Erlang("rakun_runtime", "stop_accepting")]
pub declare fn rkStopAccepting() -> i32;

#[@External.Erlang("rakun_runtime", "drain")]
pub declare fn rkDrain(timeoutMs: i32) -> string;

#[@External.Erlang("rakun_runtime", "connection_count")]
pub declare fn rkConnectionCount() -> i32;

// ── reply headers and boot options (front 04 steps 5 and 7) ─────────────────
// `Response` is `(status, body)` and `http.bp` is frozen, so a reply header is
// per-request state in the connection process: a handler writes one with
// `rkSetReplyHeader` and the acceptor writes the accumulated list ahead of the
// body. A second write to the same name (case-insensitively) replaces the
// first. `rkReplyHeaders` reads the list back as a JSON object in insertion
// order. `rkBoot` writes the `rakun.main.*` / `rakun.server.*` keys from a JSON
// object — the same property table configuration fills, so there is one
// resolution path — then prints the banner and writes the pid file.

#[@External.Erlang("rakun_runtime", "set_reply_header")]
pub declare fn rkSetReplyHeader(name: string, value: string) -> i32;

#[@External.Erlang("rakun_runtime", "reply_headers_json")]
pub declare fn rkReplyHeaders() -> string;

#[@External.Erlang("rakun_runtime", "boot")]
pub declare fn rkBoot(optionsJson: string) -> i32;

// ── configuration checks (front 05 step 9 · front 14 step 6) ────────────────
// `#[configurationProperties]` on a record that also carries `#[validated]`
// emits one `rkConfigCheckRegister` at module load: a check that binds the
// record and answers its refusal text, `""` when it is valid. The boot runs
// them all (`rkConfigCheckRun`, the texts `\n`-joined) after the property
// sources are loaded and before the first component is constructed.

#[@External.Erlang("rakun_runtime", "config_check_register")]
pub declare fn rkConfigCheckRegister(name: string, check: fn() -> string) -> i32;

#[@External.Erlang("rakun_runtime", "config_check_run")]
pub declare fn rkConfigCheckRun() -> string;

#[@External.Erlang("rakun_runtime", "config_check_reset")]
pub declare fn rkConfigCheckReset() -> i32;

// ── the TLS peer (front 74 step 3) ──────────────────────────────────────────
// The subject of the certificate the client presented on THIS connection, read
// after `ssl:handshake/2` returned — which is after verification, so an
// unverified certificate never reaches it (the handshake rejects the
// connection instead). `""` over plaintext and when no certificate was sent.

#[@External.Erlang("rakun_runtime", "peer_subject")]
pub declare fn rkPeerSubject() -> string;

// ── the test seam (front 19) ────────────────────────────────────────────────
// `rakun-test` builds its doubles on these. `rkMakeRequest` answers the same
// `Request` a socket request gets (params, headers and query as JSON objects),
// because an implementer of `Request` does not convert to it at a call site.
// `rkResetSingletons` drops instances and keeps registrations;
// `rkResetContext` drops the registrations too — scan registry, routes,
// fallback — and runs every reset a member hung off `rkOnReset`.
// `rkContextSnapshot` answers `{"scanned":[…],"routes":[…],"listeners":[…]}`.

#[@External.Erlang("rakun_runtime", "make_request")]
pub declare fn rkMakeRequest(
    verb: string,
    path: string,
    paramsJson: string,
    headersJson: string,
    queryJson: string,
    body: string,
) -> Request;

#[@External.Erlang("rakun_runtime", "reset_singletons")]
pub declare fn rkResetSingletons() -> i32;

#[@External.Erlang("rakun_runtime", "reset_context")]
pub declare fn rkResetContext() -> i32;

#[@External.Erlang("rakun_runtime", "on_reset")]
pub declare fn rkOnReset(name: string, reset: fn() -> i32) -> i32;

#[@External.Erlang("rakun_runtime", "context_snapshot")]
pub declare fn rkContextSnapshot() -> string;
