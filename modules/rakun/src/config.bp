//// rakun — externalized configuration: the readers, the sources and the order
//// they resolve in.
////
//// Front 04 owns the property TABLE (`rkSetProp`/`rkProp`/`rkPropInt`, backed by
//// `runtime.mjs` on node and by the `?PROPS` ETS table on the BEAM). This module
//// owns what FILLS it: the document readers, the eight sources, placeholder
//// resolution and the typed readers a bound record is built from. Two modules,
//// one table, no second store.
////
//// WHY THIS IS BOTOPINK AND NOT A SIDECAR. The front's spec puts the `.json` and
//// `.yaml` decoding in `src/sidecars/rakun_config.erl`, because std's `json` has
//// no structured walker. An erlang-only cell cannot be reached from this
//// repository's tests: `botopink test` compiles every `test/*.bp` on BOTH rows
//// with no per-target gate, and a `declare fn` carrying only an
//// `#[@External.Erlang]` form is a located `has no #[@External.<Target>(…)] for
//// the node backend` at the CALL SITE — it reddens the commonJS row, which is the
//// only row the core member's `targets` gates. `runtime.mjs` is frozen and a
//// second Node file is forbidden by the front's own contradiction 1, so there is
//// no node twin to pair such a cell with. The readers are therefore written once,
//// in botopink, over `std`'s `fs`/`env` (both of which carry both forms), and the
//// same code answers on both rows — which is the claim front 04 made about the
//// runtime and the only one worth making about a port.
////
//// LANGUAGE NOTES that shape the code below (each measured, not guessed):
////   * `String.slice`, `String.chars`, `String.lines`, `String.words` and
////     `String.charCodeAt` make the commonJS backend emit a self-recursive
////     `String.prototype.charCodeAt` patch that kills the module before any test
////     runs. `String.at` (native `charAt`) does not. Every substring below is
////     therefore built character by character through `charOf`/`sub`.
////   * `Array.pop` is `lists:last/1` on the erlang row — it reads, it does not
////     remove. Nothing here pops; a stack shrinks by rebuilding (`dropLast`).
////   * A declared parameter default is not applied at a call site yet, so every
////     call passes every argument.
////   * std modules written in botopink (`path`, `json`, `dict`) are emitted into
////     an `std/` subdirectory and only load on the erlang row when the emitting
////     module also references a sibling erlang module. `env` and `fs` are reached
////     here beside rakun's own host cells, which is exactly that case.

import {fs, env, random} from "std";
import {rkSetProp, rkProp} from "runtime";
import {matches, expand, setResolved} from "profiles";

// ── a flat key/value pair, the only shape a source ever yields ──────────────

pub type Entry(
    key: string,
    value: string,
)

// One document: a `---`-separated YAML document, a `#---`-separated properties
// document, or a whole `.json` file. `conditions` holds the
// `rakun.config.activate.*` keys lifted out of `entries`, because a document
// whose conditions do not hold contributes NOTHING — not a lower-priority value.
pub type Doc(
    origin: string,
    entries: Array<Entry>,
    conditions: Array<Entry>,
)

// ── character helpers ───────────────────────────────────────────────────────

pub fn charOf(s: string, i: i32) -> string {
    return s.at(i).unwrapOr("");
}

pub fn sub(s: string, begin: i32, end: i32) -> string {
    var out = "";
    var i = begin;
    val stop = if (end > s.length()) s.length() else end;
    while (i < stop) {
        out = out + charOf(s, i);
        i = i + 1;
    };
    return out;
}

pub fn splitLines(text: string) -> string[] {
    return text.replaceAll("\r\n", "\n").split("\n");
}

pub fn isDigit(c: string) -> bool {
    if (c == "") return false else return "0123456789".indexOf(c) >= 0;
}

// `parseInt(v, 10)`: a LEADING integer wins, anything else is 0 — the rule
// `rkPropInt` already states on both rows, restated here so a typed reader and
// `#[value]` never disagree.
pub fn toI32(s: string) -> i32 {
    val t = s.trim();
    var i = 0;
    var sign = 1;
    if (charOf(t, 0) == "-") {
        sign = -1;
        i = 1;
    };
    if (charOf(t, 0) == "+") i = 1;
    var n = 0;
    var seen = false;
    var done = false;
    while (i < t.length()) {
        val c = charOf(t, i);
        if (done == false) {
            if (isDigit(c)) {
                n = n * 10 + "0123456789".indexOf(c);
                seen = true;
            } else done = true;
        };
        i = i + 1;
    };
    if (seen) return n * sign else return 0;
}

pub fn dropLast(xs: string[]) -> string[] {
    var out: string[] = [];
    var i = 0;
    while (i < xs.length - 1) {
        out.push(xs.at(i).unwrapOr(""));
        i = i + 1;
    };
    return out;
}

// ── entry list helpers ──────────────────────────────────────────────────────
// A flat `Array<Entry>` is the working store rather than a `Dict`: std's `dict`
// is a botopink module and this file must stay loadable on the erlang row.

pub fn entryAt(entries: Array<Entry>, key: string) -> string {
    var found = "";
    for (entries) { e -> if (e.key == key) { found = e.value; }; };
    return found;
}

pub fn entryHas(entries: Array<Entry>, key: string) -> bool {
    var found = false;
    for (entries) { e -> if (e.key == key) { found = true; }; };
    return found;
}

// Later wins: the caller appends in precedence order, low first.
pub fn entryPut(entries: Array<Entry>, key: string, value: string) -> Array<Entry> {
    var out: Array<Entry> = [];
    var replaced = false;
    for (entries) { e ->
        if (e.key == key) {
            out.push(Entry(key: key, value: value));
            replaced = true;
        } else out.push(e);
    };
    if (replaced == false) out.push(Entry(key: key, value: value));
    return out;
}

// ── `.properties` ───────────────────────────────────────────────────────────
// `key=value` (or `key: value`), `#` and `!` comments, `\` continuations, and
// `#---` on a line of its own splitting the file into documents.

pub fn parseProperties(text: string, origin: string) -> Array<Doc> {
    var docs: Array<Doc> = [];
    var entries: Array<Entry> = [];
    var pending = "";
    for (splitLines(text)) { raw ->
        val line: string = raw.trim();
        if (line == "#---") {
            if (entries.length > 0) docs.push(splitConditions(origin, entries));
            entries = [];
        } else {
            if (pending != "") {
                pending = pending + line;
                if (line.endsWith("\\") == false) {
                    entries = addPropertyLine(entries, pending);
                    pending = "";
                };
            } else {
                if (line == "") {
                } else {
                    if (line.startsWith("#")) {
                    } else {
                        if (line.startsWith("!")) {
                        } else {
                            if (line.endsWith("\\")) {
                                pending = sub(line, 0, line.length() - 1);
                            } else entries = addPropertyLine(entries, line);
                        };
                    };
                };
            };
        };
    };
    if (pending != "") entries = addPropertyLine(entries, pending);
    if (entries.length > 0) docs.push(splitConditions(origin, entries));
    return docs;
}

fn addPropertyLine(entries: Array<Entry>, line: string) -> Array<Entry> {
    val eq = line.indexOf("=");
    val colon = line.indexOf(":");
    val cut = if (eq >= 0) {
        if (colon >= 0) { if (colon < eq) colon else eq; } else eq;
    } else colon;
    if (cut < 0) return entryPut(entries, line.trim(), "") else return entryPut(
        entries,
        sub(line, 0, cut).trim(),
        sub(line, cut + 1, line.length()).trim(),
    );
}

// ── the activation keys ─────────────────────────────────────────────────────

pub fn splitConditions(origin: string, entries: Array<Entry>) -> Doc {
    var body: Array<Entry> = [];
    var conds: Array<Entry> = [];
    for (entries) { e ->
        val k: string = e.key;
        if (k.startsWith("rakun.config.activate.")) {
            conds.push(Entry(key: sub(k, 22, k.length()), value: e.value));
        } else body.push(e);
    };
    return Doc(origin: origin, entries: body, conditions: conds);
}

// ── helpers over a `string[]` used as a stack ───────────────────────────────
// `Array.pop` is `lists:last/1` on the erlang row — a READ, not a removal — so a
// stack here shrinks with `dropLast` and its top is `lastOf`.

pub fn lastOf(xs: string[]) -> string {
    return xs.at(xs.length - 1).unwrapOr("");
}

pub fn setLast(xs: string[], v: string) -> string[] {
    var out = dropLast(xs);
    out.push(v);
    return out;
}

fn skipWs(text: string, start: i32) -> i32 {
    var i = start;
    var run = true;
    while (run) {
        val c = charOf(text, i);
        if (c == " ") i = i + 1 else if (c == "\n") i = i + 1 else if (c == "\t") i = i + 1 else if (c == "\r") i = i + 1 else run = false;
    };
    return i;
}

fn joinKey(prefix: string, name: string) -> string {
    if (prefix == "") return name else return prefix + "." + name;
}

// ── `.json` ─────────────────────────────────────────────────────────────────
// A flattening scanner: it never builds a tree, it emits `a.b.c` and `a[0]` as
// it walks. Written here rather than over std's `json` because std's decoder
// answers a `@Result<string, string>` with nothing to walk (the front's third
// language-gap row) — and because a sidecar decoder could not be tested from a
// `.bp` file on the only row this member gates.

#[@result]
pub fn parseJson(text: string, origin: string) -> @Result<Array<Doc>, string> {
    var out: Array<Entry> = [];
    var kinds: string[] = [];
    var prefixes: string[] = [];
    var idxs: string[] = [];
    var cur = "";
    var mode = "value";
    var i = 0;
    var done = false;
    var err = "";
    var guard = 0;
    i = skipWs(text, 0);
    if (charOf(text, i) == "") done = true;
    while (done == false) {
        guard = guard + 1;
        if (guard > 2000000) {
            err = origin + ": json scanner did not terminate";
            done = true;
        };
        i = skipWs(text, i);
        val c = charOf(text, i);
        if (done) {
        } else if (mode == "value") {
            if (c == "{") {
                i = skipWs(text, i + 1);
                if (charOf(text, i) == "}") {
                    i = i + 1;
                    mode = "after";
                } else {
                    kinds.push("o");
                    prefixes.push(cur);
                    idxs.push("0");
                    val k = jsonString(text, i);
                    if (k == "") {
                        err = origin + ": expected a quoted object key";
                        done = true;
                    } else {
                        i = jsonStringEnd(text, i);
                        i = skipWs(text, i);
                        if (charOf(text, i) != ":") {
                            err = origin + ": expected ':' after an object key";
                            done = true;
                        } else {
                            i = i + 1;
                            cur = joinKey(lastOf(prefixes), jsonUnquote(k));
                        };
                    };
                };
            } else if (c == "[") {
                i = skipWs(text, i + 1);
                if (charOf(text, i) == "]") {
                    i = i + 1;
                    mode = "after";
                } else {
                    kinds.push("a");
                    prefixes.push(cur);
                    idxs.push("1");
                    cur = cur + "[0]";
                };
            } else if (c == "") {
                err = origin + ": unexpected end of input";
                done = true;
            } else {
                val lit = jsonScalar(text, i);
                if (lit == "") {
                    err = origin + ": unexpected character '" + c + "'";
                    done = true;
                } else {
                    i = i + toI32(lit);
                    if (cur != "") out.push(Entry(key: cur, value: jsonUnquote(lit)));
                    mode = "after";
                };
            };
        } else {
            if (kinds.length == 0) done = true else if (c == ",") {
                i = skipWs(text, i + 1);
                if (lastOf(kinds) == "o") {
                    val k2 = jsonString(text, i);
                    if (k2 == "") {
                        err = origin + ": expected a quoted object key";
                        done = true;
                    } else {
                        i = jsonStringEnd(text, i);
                        i = skipWs(text, i);
                        if (charOf(text, i) != ":") {
                            err = origin + ": expected ':' after an object key";
                            done = true;
                        } else {
                            i = i + 1;
                            cur = joinKey(lastOf(prefixes), jsonUnquote(k2));
                            mode = "value";
                        };
                    };
                } else {
                    val n = lastOf(idxs);
                    cur = lastOf(prefixes) + "[" + n + "]";
                    idxs = setLast(idxs, "" + (toI32(n) + 1));
                    mode = "value";
                };
            } else if (c == "}") {
                if (lastOf(kinds) != "o") {
                    err = origin + ": '}' closing an array";
                    done = true;
                } else {
                    i = i + 1;
                    kinds = dropLast(kinds);
                    cur = lastOf(prefixes);
                    prefixes = dropLast(prefixes);
                    idxs = dropLast(idxs);
                };
            } else if (c == "]") {
                if (lastOf(kinds) != "a") {
                    err = origin + ": ']' closing an object";
                    done = true;
                } else {
                    i = i + 1;
                    kinds = dropLast(kinds);
                    cur = lastOf(prefixes);
                    prefixes = dropLast(prefixes);
                    idxs = dropLast(idxs);
                };
            } else {
                err = origin + ": expected ',' or a closing bracket";
                done = true;
            };
        };
    };
    if (err != "") throw err;
    var docs: Array<Doc> = [];
    docs.push(splitConditions(origin, out));
    return docs;
}

// The three `json*` helpers below answer LENGTH-PREFIXED strings ("<n> <text>")
// so one call can report both how far it read and what it read: botopink has no
// multiple-return and a mutable out-parameter would need a reference type.

fn jsonString(text: string, start: i32) -> string {
    if (charOf(text, start) != "\"") return "" else {
        var i = start + 1;
        var body = "";
        var run = true;
        while (run) {
            val c = charOf(text, i);
            if (c == "") run = false else if (c == "\\") {
                body = body + unescape(charOf(text, i + 1));
                i = i + 2;
            } else if (c == "\"") {
                run = false;
                i = i + 1;
            } else {
                body = body + c;
                i = i + 1;
            };
        };
        return "" + (i - start) + " " + body;
    };
}

fn jsonStringEnd(text: string, start: i32) -> i32 {
    val s = jsonString(text, start);
    return start + toI32(s);
}

fn jsonUnquote(lenAndBody: string) -> string {
    val n = toI32(lenAndBody);
    return sub(lenAndBody, ("" + n).length() + 1, lenAndBody.length());
}

fn unescape(c: string) -> string {
    if (c == "n") return "\n" else if (c == "t") return "\t" else if (c == "r") return "\r" else return c;
}

// A scalar: a quoted string, a number, `true`, `false` or `null`. Answers the
// same `"<consumed> <text>"` shape; `null` answers an empty value, which is what
// an absent property reads as anyway.
fn jsonScalar(text: string, start: i32) -> string {
    val c = charOf(text, start);
    if (c == "\"") return jsonString(text, start) else if (sub(text, start, start + 4) == "true") return "4 true" else if (sub(text, start, start + 5) == "false") return "5 false" else if (sub(text, start, start + 4) == "null") return "4 " else {
        var i = start;
        var body = "";
        var run = true;
        while (run) {
            val ch = charOf(text, i);
            val numeric = isDigit(ch) || ch == "-" || ch == "+" || ch == "." || ch == "e" || ch == "E";
            if (numeric) {
                body = body + ch;
                i = i + 1;
            } else run = false;
        };
        if (body == "") return "" else return "" + (i - start) + " " + body;
    };
}

// ── `.yaml` / `.yml` — a documented SUBSET ──────────────────────────────────
// Block mappings, block sequences, plain and quoted scalars, `#` comments and
// `---` document separators. An anchor, an alias, flow style, a multi-line
// block scalar or a tag is REFUSED with an error naming the file and the line —
// never silently mis-parsed. A full YAML parser is not this front's work; saying
// plainly what is not covered is.

#[@result]
pub fn parseYaml(text: string, origin: string) -> @Result<Array<Doc>, string> {
    var docs: Array<Doc> = [];
    var entries: Array<Entry> = [];
    var stackIndent: string[] = [];
    var stackPrefix: string[] = [];
    var stackSeq: string[] = [];
    var ln = 0;
    var err = "";
    for (splitLines(text)) { raw ->
        ln = ln + 1;
        val line: string = stripComment(raw);
        val body: string = line.trim();
        val isBlank = (body == "");
        if (err != "") {
        } else if (isBlank) {
        } else if (body == "---") {
            if (entries.length > 0) docs.push(splitConditions(origin, entries));
            entries = [];
            stackIndent = [];
            stackPrefix = [];
            stackSeq = [];
        } else {
            val refusal = yamlRefusal(body);
            if (refusal != "") {
                err = origin + ":" + ln + ": " + refusal;
            } else {
                val ind = indentOf(line);
                val isSeq = body.startsWith("- ");
                val cut = if (isSeq) ind + 1 else ind;
                var popping = true;
                while (popping) {
                    val n = stackIndent.length;
                    val top = if (n == 0) -1 else toI32(lastOf(stackIndent));
                    if ((n > 0 && top >= cut)) {
                        stackIndent = dropLast(stackIndent);
                        stackPrefix = dropLast(stackPrefix);
                        stackSeq = dropLast(stackSeq);
                    } else popping = false;
                };
                val prefix = if (stackPrefix.length == 0) "" else lastOf(stackPrefix);
                if (isSeq) {
                    val item: string = sub(body, 2, body.length()).trim();
                    val n = if (stackSeq.length == 0) "0" else lastOf(stackSeq);
                    val key = prefix + "[" + n + "]";
                    if (stackSeq.length > 0) stackSeq = setLast(stackSeq, "" + (toI32(n) + 1));
                    val colon = keyColon(item);
                    if (colon < 0) {
                        entries.push(Entry(key: key, value: yamlScalar(item)));
                    } else {
                        stackIndent.push("" + (ind + 1));
                        stackPrefix.push(key);
                        stackSeq.push("0");
                        val k: string = sub(item, 0, colon).trim();
                        val v: string = sub(item, colon + 1, item.length()).trim();
                        if (v == "") {
                            stackIndent.push("" + (ind + 2));
                            stackPrefix.push(joinKey(key, k));
                            stackSeq.push("0");
                        } else entries.push(Entry(key: joinKey(key, k), value: yamlScalar(v)));
                    };
                } else {
                    val colon = keyColon(body);
                    if (colon < 0) {
                        err = origin + ":" + ln + ": expected `key: value`, a `- item` or `---`";
                    } else {
                        val k: string = sub(body, 0, colon).trim();
                        val v: string = sub(body, colon + 1, body.length()).trim();
                        val full = joinKey(prefix, k);
                        if (v == "") {
                            stackIndent.push("" + ind);
                            stackPrefix.push(full);
                            stackSeq.push("0");
                        } else entries.push(Entry(key: full, value: yamlScalar(v)));
                    };
                };
            };
        };
    };
    if (err != "") throw err;
    if (entries.length > 0) docs.push(splitConditions(origin, entries));
    return docs;
}

// The constructs the subset refuses, each by the shape that identifies it.
fn yamlRefusal(body: string) -> string {
    val v = yamlValueOf(body);
    if (body.startsWith("&")) return "YAML anchors are not supported by rakun's subset" else if (body.contains(" &")) return "YAML anchors are not supported by rakun's subset" else if (v.startsWith("*")) return "YAML aliases are not supported by rakun's subset" else if (v.startsWith("{")) return "YAML flow mappings are not supported by rakun's subset" else if (v.startsWith("[")) return "YAML flow sequences are not supported by rakun's subset" else if (v == "|") return "YAML block scalars are not supported by rakun's subset" else if (v == ">") return "YAML block scalars are not supported by rakun's subset" else if (v.startsWith("!")) return "YAML tags are not supported by rakun's subset" else return "";
}

fn yamlValueOf(body: string) -> string {
    val colon = keyColon(body);
    if (colon < 0) return "" else return sub(body, colon + 1, body.length()).trim();
}

// The first `:` that ends a key: followed by a space, or the last character.
fn keyColon(body: string) -> i32 {
    var i = 0;
    var found = -1;
    var quote = "";
    while (i < body.length()) {
        val c = charOf(body, i);
        if (found >= 0) {
        } else if (quote != "") {
            if (c == quote) quote = "";
        } else if (c == "\"") {
            quote = c;
        } else if (c == "'") {
            quote = c;
        } else if (c == ":") {
            val next = charOf(body, i + 1);
            if ((next == " " || next == "")) found = i;
        };
        i = i + 1;
    };
    return found;
}

fn indentOf(line: string) -> i32 {
    var i = 0;
    var run = true;
    while (run) {
        if (charOf(line, i) == " ") i = i + 1 else run = false;
    };
    return i;
}

// A `#` opens a comment at the start of a line or after a space. A `#` inside a
// value (`pass#word`) does not.
fn stripComment(raw: string) -> string {
    var out = "";
    var i = 0;
    var quote = "";
    var run = true;
    while (run) {
        val c = charOf(raw, i);
        if (c == "") run = false else if (quote != "") {
            out = out + c;
            if (c == quote) quote = "";
            i = i + 1;
        } else if (c == "\"") {
            quote = c;
            out = out + c;
            i = i + 1;
        } else if (c == "'") {
            quote = c;
            out = out + c;
            i = i + 1;
        } else if (c == "#") {
            val prev = if (i == 0) " " else charOf(raw, i - 1);
            if (prev == " ") run = false else {
                out = out + c;
                i = i + 1;
            };
        } else {
            out = out + c;
            i = i + 1;
        };
    };
    return out.trimEnd();
}

fn yamlScalar(v: string) -> string {
    val n = v.length();
    if (n >= 2) {
        val head = charOf(v, 0);
        val tail = charOf(v, n - 1);
        if ((head == "\"" && tail == "\"")) return sub(v, 1, n - 1) else if ((head == "'" && tail == "'")) return sub(v, 1, n - 1) else return v;
    } else return v;
}

// ── `configtree:` ───────────────────────────────────────────────────────────
// One file per key, the body is the value — the shape a Kubernetes secret mount
// has. The trailing newline a text file carries is stripped; nothing else is.

#[@result]
pub fn readTree(dir: string) -> @Result<Array<Entry>, string> {
    var out: Array<Entry> = [];
    val names = try fs.list(dir) catch [];
    for (names) { name ->
        val full: string = dir + "/" + name;
        if (fs.exists(full)) {
            val body: string = try fs.readText(full) catch "";
            out.push(Entry(key: name.replaceAll("__", "-").replaceAll("_", "."), value: body.trimEnd()));
        };
    };
    return out;
}

// ── one document, by extension ──────────────────────────────────────────────

#[@result]
pub fn readDocument(path: string) -> @Result<Array<Doc>, string> {
    val text = try fs.readText(path) catch "";
    if (path.endsWith(".properties")) {
        return parseProperties(text, path);
    };
    // `return try f()` double-wraps on the erlang row (the value comes back as
    // `{ok, {ok, …}}`), so every fallible tail below binds the value first. A
    // `//` comment INSIDE one of these blocks would be fatal on the node row:
    // the commonJS emitter flattens a block onto one line and the comment then
    // swallows the closing brace.
    if (path.endsWith(".json")) {
        val fromJson = try parseJson(text, path);
        return fromJson;
    };
    val isYaml = path.endsWith(".yaml") || path.endsWith(".yml");
    if (isYaml) {
        val fromYaml = try parseYaml(text, path);
        return fromYaml;
    };
    throw path + ": unknown configuration format — rakun reads .properties, .json, .yaml and .yml";
}

// ── writing through to front 04's table ─────────────────────────────────────
// `rkSetProp` is the ONE store. This module never keeps a second one: an
// `Array<Entry>` here is a working list that ends in the table.

pub fn rkConfigApply(entries: Array<Entry>) -> i32 {
    var n = 0;
    for (entries) { e ->
        val _ = rkSetProp(e.key, e.value);
        n = n + 1;
    };
    return n;
}

// ── the eight sources ───────────────────────────────────────────────────────
//
// Highest precedence first, which is the order a reader argues about and the
// REVERSE of the order they are merged in (a merge applies low first so the high
// one overwrites it):
//
//   1  command-line arguments        --server.port=9090
//   2  RAKUN_APPLICATION_JSON        one JSON object in one variable, flattened
//   3  OS environment variables      RAKUN_SERVER_PORT then server.port
//   4  profile-specific documents    application-<profile>.<ext>, later profile wins
//   5  base documents                application.<ext>, later location wins
//   6  configuration trees           configtree:/etc/config/, one file per key
//   7  programmatic defaults         rkSetProp / boot/1, already in the table
//   8  declared field defaults       the second argument of a typed reader
//
// Row 7 needs no layer and no enumeration of the table: the merge of rows 6..1
// is written OVER the table, so a key nothing else mentions keeps the value
// `rkSetProp` gave it and a key a file mentions loses it. Row 8 is not a layer at
// all: it is the fallback the typed readers apply when the table has no answer.

// -- row 1: the command line -------------------------------------------------
// Split out from `env.args()` so a test can drive argv, which `env.args()` never
// lets it do: a test process carries the runner's arguments, not the program's.

pub fn cliEntries(args: string[]) -> Array<Entry> {
    var out: Array<Entry> = [];
    for (args) { raw ->
        val arg: string = raw;
        if (arg.startsWith("--")) {
            val body: string = sub(arg, 2, arg.length());
            val eq = body.indexOf("=");
            if (eq < 0) out = entryPut(out, body, "") else out = entryPut(
                out,
                sub(body, 0, eq),
                sub(body, eq + 1, body.length()),
            );
        };
    };
    return out;
}

// -- row 2: RAKUN_APPLICATION_JSON -------------------------------------------

#[@result]
pub fn applicationJsonEntries(raw: string) -> @Result<Array<Entry>, string> {
    if (raw == "") return [] else {
        val docs = try parseJson(raw, "RAKUN_APPLICATION_JSON");
        var out: Array<Entry> = [];
        for (docs) { d -> for (d.entries) { e -> out = entryPut(out, e.key, e.value); }; };
        return out;
    };
}

// -- row 3: the environment --------------------------------------------------
// `RAKUN_SERVER_PORT` becomes `server.port`: strip the prefix, `__` to `-`, `_`
// to `.`, lowercase. `__` is replaced FIRST, so the `-` it produces is not then
// read as a separator. A variable WITHOUT the prefix contributes nothing: the
// environment is not a property table and a rakun application does not read
// `PATH`. `RAKUN_APPLICATION_JSON` is row 2 and is excluded here so it cannot
// also contribute its raw JSON text under the key `application.json`.

pub fn envKey(name: string) -> string {
    if (name.startsWith("RAKUN_") == false) return "" else if (name == "RAKUN_APPLICATION_JSON") return "" else {
        val body: string = sub(name, 6, name.length());
        return body.replaceAll("__", "-").replaceAll("_", ".").toLower();
    };
}

pub fn envEntries(names: string[], values: string[]) -> Array<Entry> {
    var out: Array<Entry> = [];
    var i = 0;
    while (i < names.length) {
        val key: string = envKey(names.at(i).unwrapOr(""));
        if (key != "") out = entryPut(out, key, values.at(i).unwrapOr(""));
        i = i + 1;
    };
    return out;
}

pub fn readEnvEntries() -> Array<Entry> {
    var names: string[] = [];
    var values: string[] = [];
    for (env.vars()) { v ->
        names.push(v.0);
        values.push(v.1);
    };
    return envEntries(names, values);
}

// -- merging -----------------------------------------------------------------
// `mergeInto` applies a HIGHER-precedence layer over a lower one; the caller
// walks the source table upwards.

pub fn mergeInto(base: Array<Entry>, higher: Array<Entry>) -> Array<Entry> {
    var out = base;
    for (higher) { e -> out = entryPut(out, e.key, e.value); };
    return out;
}

// -- locations, names and imports --------------------------------------------

// A module-level `val` with an ALL-CAPS name is emitted as an erlang VARIABLE
// and comes back `unbound`, taking the whole module down with it, so every
// constant here is a function.
pub fn defaultLocations() -> string {
    return "optional:file:./,optional:file:./config/";
}

pub fn locationsOf(entries: Array<Entry>) -> string[] {
    val raw: string = if (entryHas(entries, "rakun.config.location")) entryAt(entries, "rakun.config.location") else {
        val fromTable: string = rkProp("rakun.config.location");
        if (fromTable == "") defaultLocations() else fromTable;
    };
    return raw.split(",");
}

pub fn configNameOf(entries: Array<Entry>) -> string {
    val raw: string = if (entryHas(entries, "rakun.config.name")) entryAt(entries, "rakun.config.name") else rkProp(
        "rakun.config.name"
    );
    if (raw == "") return "application" else return raw;
}

// A location is `[optional:]<file:|configtree:><path>`. Without `optional:` a
// path that does not exist is a STARTUP FAILURE naming it, which is the
// milestone's most-restrictive rule applied to configuration: a typo in a
// location is not a warning.

pub fn locationOptional(loc: string) -> bool {
    return loc.trim().startsWith("optional:");
}

fn locationBody(loc: string) -> string {
    val t: string = loc.trim();
    if (t.startsWith("optional:")) return sub(t, 9, t.length()) else return t;
}

pub fn locationPath(loc: string) -> string {
    val body: string = locationBody(loc);
    if (body.startsWith("configtree:")) return sub(body, 11, body.length()) else if (body.startsWith("file:")) return sub(
        body,
        5,
        body.length()
    ) else return body;
}

pub fn locationIsTree(loc: string) -> bool {
    return locationBody(loc).startsWith("configtree:");
}

// Within ONE location the extensions apply low to high, so `.properties` beats
// `.yaml` for the same key at the same location, which is Spring's own rule.
pub fn extensions() -> string {
    return "yml,yaml,json,properties";
}

// -- carriers ----------------------------------------------------------------
// Everything below the public entry point answers a VALUE carrying its own
// error rather than an `@Result`: `try` unwraps only in a `val` binding on the
// erlang row, and a loop body is a lambda, so a fallible call inside one has no
// way to propagate. The public `rkConfigLoad` is the single `#[@result]` seam
// and throws the first error it is handed.

pub type Loaded(
    docs: Array<Doc>,
    error: string,
)

pub type Resolved(
    names: string[],
    error: string,
)

fn loadedOf(r: @Result<Array<Doc>, string>) -> Loaded {
    val empty: Array<Doc> = [];
    if (r.isError()) {
        val assert Error(e) = r;
        return Loaded(docs: empty, error: e);
    } else return Loaded(docs: r.unwrapOr(empty), error: "");
}

// -- the cloud platform ------------------------------------------------------
// One function, and testable by setting an environment variable, which is how
// its test works.

pub fn cloudPlatform() -> string {
    if (env.read("KUBERNETES_SERVICE_HOST").unwrapOr("") != "") return "kubernetes" else if (env.read("VCAP_APPLICATION").unwrapOr("") != "") return "cloud-foundry" else if (env.read("DYNO").unwrapOr("") != "") return "heroku" else if (env.read("WEBSITE_SITE_NAME").unwrapOr("") != "") return "azure-app-service" else return "none";
}

// -- activation --------------------------------------------------------------
// A document whose conditions do not hold contributes NOTHING: not a
// lower-priority value, nothing. Two conditions both have to hold.

pub fn docApplies(d: Doc, actives: string[], platform: string) -> bool {
    var ok = true;
    for (d.conditions) { c ->
        val key: string = c.key;
        if (key == "on-profile") {
            if (matches(c.value, actives) == false) ok = false;
        } else if (key == "on-cloud-platform") {
            if (c.value.trim() != platform) ok = false;
        };
    };
    return ok;
}

pub fn flattenDocs(docs: Array<Doc>, actives: string[], platform: string) -> Array<Entry> {
    var out: Array<Entry> = [];
    for (docs) { d ->
        if (docApplies(d, actives, platform)) {
            for (d.entries) { e -> out = entryPut(out, e.key, e.value); };
        };
    };
    return out;
}

// -- one location's documents, plus what they import -------------------------

fn documentsAt(path: string, visited: string[]) -> Loaded {
    var docs: Array<Doc> = [];
    var err = "";
    if (visited.length > 64) return Loaded(docs: docs, error: path + ": configuration imports nested more than 64 deep") else {
        var seen = false;
        for (visited) { v -> if (v == path) { seen = true; }; };
        if (seen) return Loaded(docs: docs, error: "rakun.config.import cycle: " + visited.join(" -> ") + " -> " + path) else {
            val first = loadedOf(readDocument(path));
            if (first.error != "") return first else {
                var trail = visited;
                trail.push(path);
                for (first.docs) { d -> docs.push(d); };
                var imports: string[] = [];
                for (first.docs) { d ->
                    for (d.entries) { e ->
                        if (e.key == "rakun.config.import") {
                            for (e.value.split(",")) { ref -> imports.push(ref); };
                        };
                    };
                };
                for (imports) { ref ->
                    val target: string = locationPath(ref);
                    val optional = locationOptional(ref);
                    val exists = fs.exists(target);
                    if (exists) {
                        val nested = documentsAt(target, trail);
                        if (nested.error != "") {
                            if (err == "") err = nested.error;
                        } else for (nested.docs) { d -> docs.push(d); };
                    } else if (optional == false) {
                        if (err == "") err = "rakun.config.import: " + target + " does not exist and is not marked `optional:`";
                    };
                };
                return Loaded(docs: docs, error: err);
            };
        };
    };
}

// `profile` empty means the BASE document (`application.<ext>`); otherwise
// `application-<profile>.<ext>`. Locations apply in list order, so a later
// location overrides an earlier one; extensions apply in `extensions()` order, so
// `.properties` beats `.yaml` at the same location.

pub fn documentsFor(locations: string[], name: string, profile: string) -> Loaded {
    var docs: Array<Doc> = [];
    var err = "";
    val stem: string = if (profile == "") name else name + "-" + profile;
    for (locations) { loc ->
        if (locationIsTree(loc)) {
        } else {
            val dir: string = locationPath(loc);
            val dirExists = fs.exists(dir);
            if ((dirExists == false && locationOptional(loc) == false)) {
                if (err == "") err = "rakun.config.location: " + dir + " does not exist and is not marked `optional:`";
            } else {
                val seed: string[] = [];
                for (extensions().split(",")) { ext ->
                    val path: string = dir + stem + "." + ext;
                    if (fs.exists(path)) {
                        val one = documentsAt(path, seed);
                        if (one.error != "") {
                            if (err == "") err = one.error;
                        } else for (one.docs) { d -> docs.push(d); };
                    };
                };
            };
        };
    };
    return Loaded(docs: docs, error: err);
}

// -- row 6: configuration trees ----------------------------------------------

pub fn treesFor(locations: string[]) -> Array<Entry> {
    var out: Array<Entry> = [];
    for (locations) { loc ->
        if (locationIsTree(loc)) {
            val dir: string = locationPath(loc);
            if (fs.exists(dir)) {
                val empty: Array<Entry> = [];
                val es = readTree(dir).unwrapOr(empty);
                for (es) { e -> out = entryPut(out, e.key, e.value); };
            };
        };
    };
    return out;
}

// -- the profile set ---------------------------------------------------------
// `rakun.profiles.active` activates in order; `rakun.profiles.default` (itself
// defaulting to `default`) applies when nothing is active; `include[i]` adds
// unconditionally; `group.<name>[i]` expands one name into a list, transitively.

pub fn resolveProfiles(entries: Array<Entry>) -> Resolved {
    var seed: string[] = [];
    val activeRaw: string = entryAt(entries, "rakun.profiles.active");
    if (activeRaw != "") {
        for (activeRaw.split(",")) { p ->
            val name: string = p.trim();
            if (name != "") seed.push(name);
        };
    };
    var i = 0;
    var run = true;
    while (run) {
        val v: string = entryAt(entries, "rakun.profiles.include[" + i + "]");
        if (v == "") run = false else {
            val name: string = v.trim();
            if (name != "") seed.push(name);
            i = i + 1;
        };
    };
    if (seed.length == 0) {
        val fallback: string = entryAt(entries, "rakun.profiles.default");
        if (fallback == "") seed.push("default") else {
            for (fallback.split(",")) { p ->
                val name: string = p.trim();
                if (name != "") seed.push(name);
            };
        };
    };
    val expanded = expand(seed, { name, index -> entryAt(entries, "rakun.profiles.group." + name + "[" + index + "]") });
    val none: string[] = [];
    if (expanded.isError()) {
        val assert Error(e) = expanded;
        return Resolved(names: none, error: e);
    } else return Resolved(names: expanded.unwrapOr(none), error: "");
}

fn documentsForProfiles(locations: string[], name: string, actives: string[]) -> Loaded {
    var docs: Array<Doc> = [];
    var err = "";
    for (actives) { p ->
        val one = documentsFor(locations, name, p);
        if (one.error != "") {
            if (err == "") err = one.error;
        } else for (one.docs) { d -> docs.push(d); };
    };
    return Loaded(docs: docs, error: err);
}

// ── the loader ────────────────────────────────────────────────────────────
// The ONE public entry point, and the only `#[@result]` seam in the chain: an
// error anywhere below is carried up as a value and thrown here, so a caller
// writes `try rkConfigLoad();` in `main` and a bad location, a cyclic import, a
// refused YAML construct or a self-referential profile group all refuse the boot
// the same way, naming the input.
//
// Two passes, which is what Spring does and what the ordering forces: the
// profile set decides which documents contribute, and a document can set the
// profile set. Pass 1 merges the sources that carry no condition and resolves
// the set; pass 2 merges everything with the set known.

#[@result]
pub fn rkConfigLoadFrom(args: string[]) -> @Result<i32, string> {
    val cli = cliEntries(args);
    val rawJson: string = env.read("RAKUN_APPLICATION_JSON").unwrapOr("");
    val appJson = try applicationJsonEntries(rawJson);
    val envs = readEnvEntries();

    // rows 3, 2 and 1, low to high: they decide the name and the locations,
    // because a document cannot name the location it is itself read from.
    var high: Array<Entry> = [];
    high = mergeInto(high, envs);
    high = mergeInto(high, appJson);
    high = mergeInto(high, cli);

    val locations = locationsOf(high);
    val name = configNameOf(high);
    val platform = cloudPlatform();
    val trees = treesFor(locations);

    val base = documentsFor(locations, name, "");
    if (base.error != "") throw base.error;

    val noProfiles: string[] = [];
    var seed: Array<Entry> = [];
    seed = mergeInto(seed, trees);
    seed = mergeInto(seed, flattenDocs(base.docs, noProfiles, platform));
    seed = mergeInto(seed, high);
    val resolved = resolveProfiles(seed);
    if (resolved.error != "") throw resolved.error;
    val actives = resolved.names;

    val profileDocs = documentsForProfiles(locations, name, actives);
    if (profileDocs.error != "") throw profileDocs.error;

    var merged: Array<Entry> = [];
    merged = mergeInto(merged, trees);
    merged = mergeInto(merged, flattenDocs(base.docs, actives, platform));
    merged = mergeInto(merged, flattenDocs(profileDocs.docs, actives, platform));
    merged = mergeInto(merged, high);

    val resolvedValues = resolveAll(merged);
    if (resolvedValues.error != "") throw resolvedValues.error;

    val written = rkConfigApply(resolvedValues.entries);
    val _ = setResolved(actives);
    val _keys = registerRakunKeys();
    return written;
}

#[@result]
pub fn rkConfigLoad() -> @Result<i32, string> {
    val n = try rkConfigLoadFrom(env.args());
    return n;
}

// ── step 4: placeholders ────────────────────────────────────────────────────
// `${key}` and `${key:default}`, resolved recursively with a depth limit, over
// the merged entries first and the property table second. An unresolvable
// `${key}` with NO default is a startup failure naming the key and the property
// that referenced it — there is no mode in which it silently becomes the empty
// string. A cycle (`a=${b}`, `b=${a}`) is a failure naming the chain rather than
// a loop.
//
// `${random.*}` is NOT a source and is NOT resolved here: it is resolved at
// REFERENCE time by `rkValue`, so `${random.int[1024,65536]}` answers
// differently per reference and is never cached.

pub type Res(
    value: string,
    error: string,
)

// `${` cannot be written as a literal: botopink INTERPOLATES `${…}` inside a
// string, so `"${" + body + "}"` compiles to the interpolation of the expression
// `" + body + "` and the value comes out as the text ` + body + `. Every literal
// placeholder in this module is built through this function.
fn openBrace() -> string {
    return "$" + "{";
}

fn indexFrom(s: string, needle: string, start: i32) -> i32 {
    var i = start;
    var found = -1;
    while (i < s.length()) {
        if (found < 0) {
            if (charOf(s, i) == needle) found = i;
        };
        i = i + 1;
    };
    return found;
}

pub fn resolveIn(raw: string, owner: string, entries: Array<Entry>, trail: string[]) -> Res {
    var out = "";
    var err = "";
    var i = 0;
    while (i < raw.length()) {
        val opens = (charOf(raw, i) == "$" && charOf(raw, i + 1) == "{");
        if (opens) {
            val close = indexFrom(raw, "}", i + 2);
            if (close < 0) {
                out = out + charOf(raw, i);
                i = i + 1;
            } else {
                val body: string = sub(raw, i + 2, close);
                val r = resolveRef(body, owner, entries, trail);
                if (r.error != "") {
                    if (err == "") err = r.error;
                };
                out = out + r.value;
                i = close + 1;
            };
        } else {
            out = out + charOf(raw, i);
            i = i + 1;
        };
    };
    return Res(value: out, error: err);
}

fn resolveRef(body: string, owner: string, entries: Array<Entry>, trail: string[]) -> Res {
    val colon = body.indexOf(":");
    val key: string = if (colon < 0) body.trim() else sub(body, 0, colon).trim();
    val fallback: string = if (colon < 0) "" else sub(body, colon + 1, body.length());
    if (key.startsWith("random.")) return Res(value: openBrace() + body + "}", error: "") else if (trail.length > 32) return Res(
        value: "",
        error: owner + ": placeholder nesting deeper than 32 — " + trail.join(" -> "),
    ) else if (containsName(trail, key)) return Res(
        value: "",
        error: owner + ": placeholder cycle — " + trail.join(" -> ") + " -> " + key,
    ) else {
        val present = (entryHas(entries, key) || rkProp(key) != "");
        if (present == false) {
            if (colon < 0) return Res(
                value: "",
                error: owner + ": unresolvable placeholder " + openBrace() + key + "} — nothing sets `" + key + "` and the reference carries no `:default`",
            ) else {
                var deeper = trail;
                deeper.push(key);
                return resolveIn(fallback, owner, entries, deeper);
            };
        } else {
            val found: string = if (entryHas(entries, key)) entryAt(entries, key) else rkProp(key);
            var deeper = trail;
            deeper.push(key);
            return resolveIn(found, owner, entries, deeper);
        };
    };
}

fn containsName(xs: string[], name: string) -> bool {
    var found = false;
    for (xs) { x -> if (x == name) { found = true; }; };
    return found;
}

pub type Resolution(
    entries: Array<Entry>,
    error: string,
)

pub fn resolveAll(entries: Array<Entry>) -> Resolution {
    var out: Array<Entry> = [];
    var err = "";
    for (entries) { e ->
        var trail: string[] = [];
        trail.push(e.key);
        val r = resolveIn(e.value, e.key, entries, trail);
        if (r.error != "") {
            if (err == "") err = r.error;
        };
        out.push(Entry(key: e.key, value: r.value));
    };
    return Resolution(entries: out, error: err);
}

// ── `${random.*}`, at reference time ────────────────────────────────────────
// `value`, `int`, `long`, `uuid`, `int(10)` and `int[1024,65536]`, over std's
// `random`. Never cached: two references to the same key answer differently,
// which is the whole point of the form.

pub fn resolveRandom(raw: string) -> string {
    var out = "";
    var i = 0;
    while (i < raw.length()) {
        val opens = (charOf(raw, i) == "$" && charOf(raw, i + 1) == "{");
        if (opens) {
            val close = indexFrom(raw, "}", i + 2);
            if (close < 0) {
                out = out + charOf(raw, i);
                i = i + 1;
            } else {
                val body: string = sub(raw, i + 2, close);
                if (body.startsWith("random.")) out = out + randomFor(body) else out = out + openBrace() + body + "}";
                i = close + 1;
            };
        } else {
            out = out + charOf(raw, i);
            i = i + 1;
        };
    };
    return out;
}

fn randomFor(body: string) -> string {
    val spec: string = sub(body, 7, body.length());
    if (spec == "value") return randomHex(32) else if (spec == "uuid") return randomUuid() else if (spec == "long") return "" + randomBelow(
        2000000000
    ) + "" + randomBelow(1000000000) else if (spec == "int") return "" + randomBelow(2147483647) else if (spec.startsWith("int(")) {
        val inner: string = sub(spec, 4, spec.length() - 1);
        return "" + randomBelow(toI32(inner));
    } else if (spec.startsWith("int[")) {
        val inner: string = sub(spec, 4, spec.length() - 1);
        val comma = inner.indexOf(",");
        if (comma < 0) return "" + randomBelow(toI32(inner)) else {
            val lo = toI32(sub(inner, 0, comma));
            val hi = toI32(sub(inner, comma + 1, inner.length()));
            return "" + randomBetween(lo, hi);
        };
    } else return openBrace() + body + "}";
}

// std's `random.intInRange` walks up to `hi - lo` recursive steps to floor a
// float (`floorWalk`), which blows the JavaScript stack for a range the size of
// a TCP port space. Rejection sampling over composed decimal digits is uniform,
// needs no float-to-int conversion (botopink has no cast) and costs a bounded
// number of draws: for a 5-digit bound roughly two thirds of draws are accepted.
fn digitsOf(n: i32) -> i32 {
    var d = 1;
    var bound = 10;
    while (bound <= n) {
        bound = bound * 10;
        d = d + 1;
    };
    return d;
}

fn drawDigits(d: i32) -> i32 {
    var v = 0;
    var i = 0;
    while (i < d) {
        v = v * 10 + random.intInRange(0, 9);
        i = i + 1;
    };
    return v;
}

pub fn randomBelow(n: i32) -> i32 {
    if (n <= 1) return 0 else {
        val d = digitsOf(n - 1);
        var v = n;
        var tries = 0;
        while ((v >= n && tries < 64)) {
            v = drawDigits(d);
            tries = tries + 1;
        };
        if (v >= n) return 0 else return v;
    };
}

pub fn randomBetween(lo: i32, hi: i32) -> i32 {
    if (hi <= lo) return lo else return lo + randomBelow(hi - lo + 1);
}

fn randomHex(n: i32) -> string {
    var out = "";
    var i = 0;
    while (i < n) {
        out = out + hexDigit(randomBelow(16));
        i = i + 1;
    };
    return out;
}

fn hexDigit(n: i32) -> string {
    return "0123456789abcdef".at(n).unwrapOr("0");
}

// RFC 4122 version 4: the version nibble is `4` and the variant nibble is one of
// `8`, `9`, `a`, `b`. A "random UUID" that is not a valid v4 is a bug a reader
// only finds in production.
fn randomUuid() -> string {
    val variant: string = "89ab".at(randomBelow(4)).unwrapOr("8");
    return randomHex(8) + "-" + randomHex(4) + "-4" + randomHex(3) + "-" + variant + randomHex(3) + "-" + randomHex(12);
}

// ── step 8: `Duration` and `DataSize` ───────────────────────────────────────
//
// The spec writes these as `i64`. An integer LITERAL is `i32` and there is no
// widening and no cast, so an `i64` field cannot be given a value at all today;
// both carry `i32`, which is not the narrowing it reads as — a botopink integer
// is a JavaScript number on the node row and a BEAM integer on the erlang one,
// so `10GB` (10737418240) is exact on both. The type NAME is the only thing the
// gap costs.
//
// An unparsable value is a startup failure naming the key, the value and the
// accepted forms — never a zero. `assert` is the halt: a typed reader is called
// from an emitted factory, which is not a `#[@result]` context, and a wrong
// configuration value must stop the program rather than be carried into a
// request as a silent default.

pub type Duration(
    millis: i32,
)

pub type DataSize(
    bytes: i32,
)

fn durationUnitMillis(unit: string) -> i32 {
    val u: string = unit.toLower();
    if (u == "nanos") return 0 else if (u == "millis") return 1 else if (u == "milliseconds") return 1 else if (u == "seconds") return 1000 else if (u == "minutes") return 60000 else if (u == "hours") return 3600000 else if (u == "days") return 86400000 else return 1;
}

fn durationSuffixMillis(suffix: string) -> i32 {
    if (suffix == "ms") return 1 else if (suffix == "s") return 1000 else if (suffix == "m") return 60000 else if (suffix == "h") return 3600000 else if (suffix == "d") return 86400000 else return -1;
}

fn splitDigits(raw: string) -> string {
    var out = "";
    var i = 0;
    var run = true;
    while (run) {
        val c = charOf(raw, i);
        if (isDigit(c)) {
            out = out + c;
            i = i + 1;
        } else run = false;
    };
    return out;
}

// `PT1H30M`, `PT30S`, `PT0.5S` is refused (no fractional seconds in the subset).
fn isoDurationMillis(raw: string) -> i32 {
    val body: string = sub(raw, 2, raw.length());
    var total = 0;
    var digits = "";
    var i = 0;
    var bad = false;
    while (i < body.length()) {
        val c = charOf(body, i);
        if (isDigit(c)) digits = digits + c else {
            val step: i32 = if (c == "H") 3600000 else if (c == "M") 60000 else if (c == "S") 1000 else -1;
            if (step < 0) bad = true else total = total + toI32(digits) * step;
            digits = "";
        };
        i = i + 1;
    };
    val unterminated = (digits != "");
    if ((bad || unterminated)) return -1 else return total;
}

// The refusal MESSAGE is a function of its own, and the parser asserts on it.
// `assert` is the halt — a typed reader is called from an emitted factory, which
// is not a `#[@result]` context, and a wrong configuration value has to stop the
// program rather than be carried into a request as a silent zero. Splitting the
// message out is what lets a test read it without the halt taking the test with
// it.

pub fn durationProblem(raw: string, unit: string, key: string) -> string {
    val v: string = raw.trim();
    val forms = " — accepted: 30, 30s, 500ms, 2m, 1h, 1d, PT30S, PT1H30M";
    if (v == "") return "" else if (v.startsWith("PT")) {
        if (isoDurationMillis(v) < 0) return "rakun config: `" + key + "` is `" + raw + "`, which is not a duration" + forms else return "";
    } else {
        val digits: string = splitDigits(v);
        val suffix: string = sub(v, digits.length(), v.length()).trim();
        if (digits == "") return "rakun config: `" + key + "` is `" + raw + "`, which is not a duration" + forms else if (suffix == "") return "" else if (durationSuffixMillis(suffix) < 0) return "rakun config: `" + key + "` is `" + raw + "`, which is not a duration" + forms else return "";
    };
}

pub fn parseDuration(raw: string, unit: string, key: string) -> Duration {
    val problem: string = durationProblem(raw, unit, key);
    assert problem == "", problem;
    val v: string = raw.trim();
    if (v == "") return Duration(millis: 0) else if (v.startsWith("PT")) return Duration(
        millis: isoDurationMillis(v)
    ) else {
        val digits: string = splitDigits(v);
        val suffix: string = sub(v, digits.length(), v.length()).trim();
        if (suffix == "") return Duration(millis: toI32(digits) * durationUnitMillis(unit)) else return Duration(
            millis: toI32(digits) * durationSuffixMillis(suffix),
        );
    };
}

fn sizeUnitBytes(unit: string) -> i32 {
    val u: string = unit.toLower();
    if (u == "bytes") return 1 else if (u == "kilobytes") return 1024 else if (u == "megabytes") return 1048576 else if (u == "gigabytes") return 1073741824 else if (u == "terabytes") return 1099511627776 else return 1;
}

fn sizeSuffixBytes(suffix: string) -> i32 {
    val u: string = suffix.toUpper();
    if (u == "B") return 1 else if (u == "KB") return 1024 else if (u == "MB") return 1048576 else if (u == "GB") return 1073741824 else if (u == "TB") return 1099511627776 else return -1;
}

pub fn dataSizeProblem(raw: string, unit: string, key: string) -> string {
    val v: string = raw.trim();
    val forms = " — accepted: 10, 10B, 10KB, 10MB, 10GB, 10TB";
    if (v == "") return "" else {
        val digits: string = splitDigits(v);
        val suffix: string = sub(v, digits.length(), v.length()).trim();
        if (digits == "") return "rakun config: `" + key + "` is `" + raw + "`, which is not a data size" + forms else if (suffix == "") return "" else if (sizeSuffixBytes(suffix) < 0) return "rakun config: `" + key + "` is `" + raw + "`, which is not a data size" + forms else return "";
    };
}

pub fn parseDataSize(raw: string, unit: string, key: string) -> DataSize {
    val problem: string = dataSizeProblem(raw, unit, key);
    assert problem == "", problem;
    val v: string = raw.trim();
    if (v == "") return DataSize(bytes: 0) else {
        val digits: string = splitDigits(v);
        val suffix: string = sub(v, digits.length(), v.length()).trim();
        if (suffix == "") return DataSize(bytes: toI32(digits) * sizeUnitBytes(unit)) else return DataSize(
            bytes: toI32(digits) * sizeSuffixBytes(suffix),
        );
    };
}

// ── the typed readers ───────────────────────────────────────────────────────
// Front 04 owns `rkProp`/`rkPropInt`; these are the rest, and they carry ROW 8 —
// the declared default — as their second argument, because a declared field
// default is not applied at a call site yet (the front's first language-gap
// row). `rkValue` is the string reader that also resolves `${random.*}` at
// REFERENCE time.
//
// RELAXED BINDING lives here rather than in the emitter: a reader tries the
// written key, then the kebab-case spelling, then the camelCase one, then the
// underscored upper-case one, so `remoteAddress` binds from `remote-address`,
// from `remoteAddress` and from `REMOTE_ADDRESS` without the caller knowing
// which spelling a file used.

pub fn kebabOf(name: string) -> string {
    var out = "";
    var i = 0;
    while (i < name.length()) {
        val c = charOf(name, i);
        val u: string = c.toUpper();
        val lower: string = c.toLower();
        if ((c == u && c != lower)) out = out + "-" + lower else out = out + c;
        i = i + 1;
    };
    return out;
}

fn camelOf(kebab: string) -> string {
    var out = "";
    var up = false;
    var i = 0;
    while (i < kebab.length()) {
        val c = charOf(kebab, i);
        if (c == "-") up = true else {
            if (up) out = out + c.toUpper() else out = out + c;
            up = false;
        };
        i = i + 1;
    };
    return out;
}

pub fn rawValue(key: string) -> string {
    val direct: string = rkProp(key);
    if (direct != "") return direct else {
        val kebab: string = kebabOf(key);
        val viaKebab: string = rkProp(kebab);
        if (viaKebab != "") return viaKebab else {
            val camel: string = camelOf(key);
            val viaCamel: string = rkProp(camel);
            if (viaCamel != "") return viaCamel else return rkProp(kebab.replaceAll("-", "_").replaceAll(".", "_").toUpper());
        };
    };
}

pub fn rkValue(key: string) -> string {
    return resolveRandom(rawValue(key));
}

pub fn rkValueOr(key: string, fallback: string) -> string {
    val v: string = rkValue(key);
    if (v == "") return fallback else return v;
}

pub fn boolProblem(raw: string, key: string) -> string {
    val v: string = raw.trim().toLower();
    val known = (v == "" || v == "true" || v == "yes" || v == "on" || v == "1" || v == "false" || v == "no" || v == "off" || v == "0");
    if (known) return "" else return "rakun config: `" + key + "` is `" + raw + "`, which is not a boolean — accepted: true, false, yes, no, on, off, 1, 0";
}

pub fn rkPropBool(key: string, fallback: bool) -> bool {
    val raw: string = rkValue(key);
    val problem: string = boolProblem(raw, key);
    assert problem == "", problem;
    val v: string = raw.trim().toLower();
    val yes = (v == "true" || v == "yes" || v == "on" || v == "1");
    if (v == "") return fallback else return yes;
}

pub fn rkPropIntOr(key: string, fallback: i32) -> i32 {
    val v: string = rkValue(key).trim();
    if (v == "") return fallback else {
        val digits: string = if (charOf(v, 0) == "-") sub(v, 1, v.length()) else v;
        assert splitDigits(digits) == digits, "rakun config: `" + key + "` is `" + v + "`, which is not an integer";
        return toI32(v);
    };
}

// `f64` has no integer literal either, so the fraction is accumulated as a whole
// number and divided by a power of ten built the same way.
pub fn rkPropFloat(key: string, fallback: f64) -> f64 {
    val v: string = rkValue(key).trim();
    if (v == "") return fallback else {
        val neg = v.startsWith("-");
        val body: string = if (neg) sub(v, 1, v.length()) else v;
        val dot = body.indexOf(".");
        val whole: string = if (dot < 0) body else sub(body, 0, dot);
        val frac: string = if (dot < 0) "" else sub(body, dot + 1, body.length());
        val wellFormed = (splitDigits(whole) == whole && splitDigits(frac) == frac);
        assert ((wellFormed && whole != "")), "rakun config: `" + key + "` is `" + v + "`, which is not a number";
        var acc = 0.0;
        var i = 0;
        while (i < whole.length()) {
            acc = acc * 10.0 + digitFloat(charOf(whole, i));
            i = i + 1;
        };
        var scale = 1.0;
        var j = 0;
        while (j < frac.length()) {
            acc = acc * 10.0 + digitFloat(charOf(frac, j));
            scale = scale * 10.0;
            j = j + 1;
        };
        val magnitude = acc / scale;
        if (neg) return 0.0 - magnitude else return magnitude;
    };
}

fn digitFloat(c: string) -> f64 {
    val n = "0123456789".indexOf(c);
    var out = 0.0;
    var i = 0;
    while (i < n) {
        out = out + 1.0;
        i = i + 1;
    };
    return out;
}

// A list binds from a comma-separated scalar OR from the indexed keys a JSON or
// YAML sequence flattens to (`a[0]`, `a[1]`, …), whichever the file used.
pub fn rkPropList(key: string) -> string[] {
    var out: string[] = [];
    var i = 0;
    var run = true;
    while (run) {
        val v: string = rkValue(key + "[" + i + "]");
        if (v == "") run = false else {
            out.push(v);
            i = i + 1;
        };
    };
    if (out.length > 0) return out else {
        val scalar: string = rkValue(key);
        if (scalar == "") return out else {
            for (scalar.split(",")) { part ->
                val item: string = part;
                out.push(item.trim());
            };
            return out;
        };
    };
}

pub fn rkPropDuration(key: string, unit: string) -> Duration {
    return parseDuration(rkValue(key), unit, key);
}

pub fn rkPropSize(key: string, unit: string) -> DataSize {
    return parseDataSize(rkValue(key), unit, key);
}

// ── step 9: the key catalogue ───────────────────────────────────────────────
// A rakun decorator body cannot accumulate comptime state across invocations —
// each is lowered alone into its own eval script — so there is no comptime
// catalogue of every configuration key in the build. The registry is built at
// RUN time instead, by the module-load `val`s the rest of rakun uses, and a
// headless boot (`rakun.main.headless`, front 04) is what dumps it for
// `rakun config-catalogue` (front 88) and the LSP's `application.yaml`
// completion.
//
// It lives in the property table like everything else: `rakun.config.catalogue`
// is the comma-separated list of registered prefixes and
// `rakun.config.catalogue.<prefix>` is that prefix's spec, so there is still one
// store.

pub fn rkRegisterConfigKeys(prefix: string, spec: string) -> i32 {
    val known: string = rkProp("rakun.config.catalogue");
    val already = (("," + known + ",").contains("," + prefix + ","));
    if (already == false) {
        val next: string = if (known == "") prefix else known + "," + prefix;
        val _ = rkSetProp("rakun.config.catalogue", next);
    };
    return rkSetProp("rakun.config.catalogue." + prefix, spec);
}

pub fn configCataloguePrefixes() -> string[] {
    val known: string = rkProp("rakun.config.catalogue");
    if (known == "") {
        val none: string[] = [];
        return none;
    } else return known.split(",");
}

// `<prefix>.<name>:<type>:<default>` per key, so a dump is a fold over the
// prefixes and a split of each spec — no second format and no second store.
pub fn configCatalogue() -> Array<Entry> {
    var out: Array<Entry> = [];
    for (configCataloguePrefixes()) { prefix ->
        val spec: string = rkProp("rakun.config.catalogue." + prefix);
        if (spec != "") {
            for (spec.split("|")) { row ->
                val entry: string = row;
                val colon = entry.indexOf(":");
                if (colon > 0) {
                    val name: string = sub(entry, 0, colon);
                    out.push(Entry(key: prefix + "." + name, value: sub(entry, colon + 1, entry.length())));
                };
            };
        };
    };
    return out;
}

// rakun's own keys, registered beside the application's so a dump answers "every
// key rakun reads" and not "every key the application declared". The boot
// options are front 04's table (AGENTS.md § The server half).
pub fn registerRakunKeys() -> i32 {
    val _m = rkRegisterConfigKeys(
        "rakun.main",
        "banner-mode:string:console|headless:bool:false|keep-alive:bool:true|pid-file:string:|port-file:string:",
    );
    val _s = rkRegisterConfigKeys(
        "rakun.server",
        "port:i32:8080|backlog:i32:128|idle-timeout:Duration:60000|max-connections:i32:16384|transport:string:gen_tcp|bound-port:i32:",
    );
    val _c = rkRegisterConfigKeys(
        "rakun.config",
        "name:string:application|location:string:optional:file:./|import:string:|activate.on-profile:string:|activate.on-cloud-platform:string:",
    );
    return rkRegisterConfigKeys(
        "rakun.profiles",
        "active:string:|default:string:default|include:string[]:|group:string[]:|resolved:string[]:",
    );
}

// ── step 7: `#[configurationProperties("prefix")]` ──────────────────────────
//
// A type-level decorator that emits two functions and one registration:
//
//   pub fn __rkBind_<Name>(prefix: string) -> <Name>   — prefix is a PARAMETER,
//       which is what makes `#[nested]` compose: a nested field calls the nested
//       type's own binder with `prefix + "." + <field>`, and neither decorator
//       has to know the other exists. A rakun decorator body cannot call a
//       sibling function, so composition has to happen in the EMITTED code.
//   pub fn __rkMake_<Name>() -> <Name>                  — the ordinary DI factory
//       name, so a bound record is injectable by type into any `#[service]` with
//       no further wiring.
//   val __rkCat_<Name> = rkRegisterConfigKeys(...)      — the run-time catalogue.
//
// A LIST FIELD IS RECOGNISED BY AN EMPTY `typeName`. `@Decl` renders no name at
// all for a generic type: `hosts: string[]` reflects as `typeName == ""`, the
// same as `Array<string>` would. An empty name is therefore read as a list here,
// which is right for every array and wrong for any other generic field — the
// only signal the reflection offers, and a gap worth closing in `@Decl` rather
// than around.
//
// RELAXED BINDING IS IN THE READER, NOT THE EMITTER. The spec puts the
// `remoteAddress` → `remote-address` rewrite in the decorator. It is in
// `rawValue` instead, which tries the written key, the kebab spelling, the camel
// spelling and the `SCREAMING_SNAKE` one — so the emitter stays free of string
// surgery a decorator body would have to inline (it cannot call a helper), and
// all three spellings bind rather than only the two the emitter would have
// produced.

pub fn configurationProperties(comptime decl: @Decl, prefix: string) {
    var args: Array<string> = [];
    var catalogue: Array<string> = [];
    decl.fields.forEach({ f ->
        var unit = "";
        var fallback = "";
        var nested = false;
        f.annotations.forEach({ a ->
            if (a.name == "unit") unit = a.args.join("").replaceAll("\"", "");
            if (a.name == "defaultValue") fallback = a.args.join("").replaceAll("\"", "");
            if (a.name == "nested") nested = true;
        });
        val key = "prefix + \".\" + \"" + f.name + "\"";
        val quoted = "\"" + fallback + "\"";
        val reader = if (nested) "__rkBind_" + f.typeName + "(" + key + ")" else if (f.typeName == "bool") "rkPropBool(" + key + ", " + (if (fallback == "") "false" else fallback) + ")" else if (f.typeName == "i32") "rkPropIntOr(" + key + ", " + (if (fallback == "") "0" else fallback) + ")" else if (f.typeName == "f64") "rkPropFloat(" + key + ", " + (if (fallback == "") "0.0" else fallback) + ")" else if (f.typeName == "Duration") "rkPropDuration(" + key + ", \"" + unit + "\")" else if (f.typeName == "DataSize") "rkPropSize(" + key + ", \"" + unit + "\")" else if (f.typeName == "string[]") "rkPropList(" + key + ")" else if (f.typeName == "Array<string>") "rkPropList(" + key + ")" else if (f.typeName == "") "rkPropList(" + key + ")" else if (f.typeName.contains("[]")) "rkPropList(" + key + ")" else if (f.typeName.startsWith("Array<")) "rkPropList(" + key + ")" else "rkValueOr(" + key + ", " + quoted + ")";
        args.push(f.name + ": " + reader);
        val shown = if (f.typeName == "") "string[]" else f.typeName;
        catalogue.push(f.name + ":" + shown + ":" + fallback);
    });
    @emit("pub fn __rkBind_" + decl.name + "(prefix: string) -> " + decl.name + " { return " + decl.name + "(" + args.join(
            ", "
        ) + "); }");
    @emit("pub fn __rkMake_" + decl.name + "() -> " + decl.name + " { return rkSingleton(\"" + decl.name + "\", { -> __rkBind_" + decl.name + "(\"" + prefix + "\") }); }");
    @emit("val __rkCat_" + decl.name + " = rkRegisterConfigKeys(\"" + prefix + "\", \"" + catalogue.join(
            "|"
        ) + "\");");
    if (decl.kind != DeclKind.Type) decl.fail("#[configurationProperties] must annotate a type");
    if (decl.variants.length > 0) decl.fail("#[configurationProperties] must annotate a type with fields, not an enum");
}

// `#[nested]` marks a field bound under `<prefix>.<field>` by its own type's
// binder. The `#[configurationProperties]` body does the wiring (it sees every
// field); this marker enforces placement.
pub fn nested(comptime decl: @Decl) {
    if (decl.kind != DeclKind.Field) decl.fail("#[nested] must annotate a field");
}

// `#[unit("seconds")]` is the unit a BARE number is read in for a `Duration` or
// a `DataSize` field. A suffixed value (`30s`, `10MB`) parses whatever it says.
pub fn unit(comptime decl: @Decl, name: string) {
    if (decl.kind != DeclKind.Field) decl.fail("#[unit] must annotate a field");
}

// `#[defaultValue("false")]` is row 8 — the declared field default — written
// where the catalogue can report it. A default written on the field itself
// (`enabled: bool = false`) is not visible through `@Decl.fields`, so the
// annotation is the form that reaches both the reader and the dump.
pub fn defaultValue(comptime decl: @Decl, literal: string) {
    if (decl.kind != DeclKind.Field) decl.fail("#[defaultValue] must annotate a field");
}

// `#[validated]` marks a configuration record whose constraints run at boot.
// Front 14 owns the constraints; front 05 owns the MOMENT — after binding and
// before the first component is constructed. Until 14 lands this is placement
// only, and `rkConfigValidate` has nothing to run.
pub fn validated(comptime decl: @Decl) {
    if (decl.kind != DeclKind.Type) decl.fail("#[validated] must annotate a type");
    if (decl.variants.length > 0) decl.fail("#[validated] must annotate a type with fields, not an enum");
}

// `#[enableConfigurationProperties]` on a `#[configuration]` type is the
// explicit-registration form for records that carry
// `#[configurationProperties]` but live in a module the application does not
// otherwise import. It registers the same names the record's own decorator
// would have.
pub fn enableConfigurationProperties(comptime decl: @Decl, types: string) {
    var registrations: Array<string> = [];
    types.split(",").forEach({ t -> registrations.push(t.trim()) });
    registrations.forEach({ name -> @emit("val __rkEnable_" + name + " = rkScan(\"" + name + "\");") });
    if (decl.kind != DeclKind.Type) decl.fail("#[enableConfigurationProperties] must annotate a type");
}
