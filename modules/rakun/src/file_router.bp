//// rakun — the file-convention route table: the segment grammar, the wire
//// format, the matcher and the four markers that fill the registry.
////
//// `#[restController]` + `#[getMapping]` (`decorators.bp`) route by DECORATOR and
//// that model is untouched. This module is the other one: a URL that comes from
//// where a file sits, a layout that wraps everything below it, a segment that
//// captures part of the path, a folder that is transparent to the URL and a
//// folder that renders into a named slot of its parent. Front 23 nests layouts
//// off `layoutChain`, front 25 registers `route.bp` handlers into the same
//// table, front 27 asks whether a `Link` target is worth prefetching and front
//// 61 hangs `@slot` off the same tree.
////
//// WHY THE ARGUMENT IS A STRING. botopink compiles only declared modules
//// (`pub mod` in the package root), so a `.bp` file is not loadable by path, and
//// `@Decl` carries no source location — a decorator cannot learn which file it
//// was written in. A file-convention router in botopink is therefore
//// REGISTRATION-driven and the app-relative directory reaches the decorator as
//// an argument, which `scanProblem` below checks against the real tree.
////
//// WHY THERE IS A `.mjs` AND AN `.erl` HERE AND NOT IN `config.bp`. Front 05
//// refused its sidecar because its work was PURE — document readers — and an
//// erlang-only cell is a located node-row diagnostic at its call site. Nothing
//// about that applies to a REGISTRY: botopink has no top-level mutable state, so
//// the table has to live in the host, exactly as `rkRegisterRoute`'s does, and a
//// registered render function is a closure that no string store can hold. Every
//// cell below therefore carries BOTH forms — `@External.Node("./file_router.mjs")`
//// and `@External.Erlang("rakun_file_router")` — so neither row is a compile
//// error, and `test/file_router_test.bp` runs the same assertions on both. What
//// is NOT duplicated is the part front 05's argument was really about: the
//// grammar, the wire format and the matcher are botopink, compiled twice, so the
//// browser and the BEAM cannot disagree about which route a URL is.
////
//// LANGUAGE NOTES this file is written around (measured, not guessed; the full
//// list is in `AGENTS.md` § Language notes):
////   * `String.slice`/`chars`/`lines`/`words`/`charCodeAt` kill the commonJS
////     module before a test runs; every substring is built through `charOf`/`sub`.
////   * A declared parameter default is still not applied at a call site, on
////     either row, so every call passes every argument.
////   * `&&` and `||` inside an `if (…)` head need their own parentheses.
////   * A `//` comment inside a braced block is fatal on the node row, and a
////     decorator body cannot call a sibling function — so the four markers below
////     are comment-free and inline their segment walk instead of sharing one.

import {dict, fs} from "std";
import {Request} from "http";
import {rkProp} from "runtime";
import {charOf, sub} from "config";

// ── step 1: the segment grammar ─────────────────────────────────────────────
//
// Four folder spellings are not URL segments: `(group)` is transparent,
// `@slot` renders into a named prop of the parent layout, `_private` is
// excluded from routing entirely, and `[dynamic]` / `[...catchAll]` /
// `[[...optionalCatchAll]]` capture instead of matching.

pub type SegmentKind {
    Static,
    Dynamic,
    CatchAll,
    OptionalCatchAll,
    Group,
    Slot,
    Private,
}

pub type Segment(
    kind: SegmentKind,
    name: string,
    raw: string,
)

// The one place the bracket and parenthesis spellings are decoded. Pure and
// total: a name that may not appear on a registered path is still classified
// here and refused by `pathProblem`, one step up.
pub fn parseSegment(raw: string) -> Segment {
    val n = raw.length();
    if ((raw.startsWith("[[...") && raw.endsWith("]]"))) return Segment(
        kind: SegmentKind.OptionalCatchAll,
        name: sub(raw, 5, n - 2),
        raw: raw,
    ) else if ((raw.startsWith("[...") && raw.endsWith("]"))) return Segment(
        kind: SegmentKind.CatchAll,
        name: sub(raw, 4, n - 1),
        raw: raw,
    ) else if ((raw.startsWith("[") && raw.endsWith("]"))) return Segment(
        kind: SegmentKind.Dynamic,
        name: sub(raw, 1, n - 1),
        raw: raw,
    ) else if ((raw.startsWith("(") && raw.endsWith(")"))) return Segment(
        kind: SegmentKind.Group,
        name: sub(raw, 1, n - 1),
        raw: raw,
    ) else if (raw.startsWith("@")) return Segment(
        kind: SegmentKind.Slot,
        name: sub(raw, 1, n),
        raw: raw,
    ) else if (raw.startsWith("_")) return Segment(
        kind: SegmentKind.Private,
        name: sub(raw, 1, n),
        raw: raw,
    ) else return Segment(kind: SegmentKind.Static, name: raw, raw: raw);
}

// The kind as a word. `case` rather than `==`, so nothing depends on how a
// payload-free variant compares on either row; it is also what a test asserts
// against and what a diagnostic prints.
pub fn kindName(k: SegmentKind) -> string {
    return case k {
        Static -> "Static";
        Dynamic -> "Dynamic";
        CatchAll -> "CatchAll";
        OptionalCatchAll -> "OptionalCatchAll";
        Group -> "Group";
        Slot -> "Slot";
        Private -> "Private";
    };
}

// `""` when the path is registrable, the refusal otherwise. Split out for the
// reason `config.bp` splits `durationProblem` out: `parsePath` HALTS on a bad
// path (it is called from an emitted module-load `val`, which has no `@Result`
// return to carry an error), and a test can only read the message if reading
// it does not take the test down with it.
pub fn pathProblem(seg: string) -> string {
    var problem = "";
    val trimmed = trimSlashes(seg);
    if (trimmed == "") return "" else {
        for (trimmed.split("/")) { raw ->
            if (problem == "") {
                val s = parseSegment(raw);
                if (raw.contains("|")) {
                    problem = "rakun routing: segment `" + raw + "` in `" + seg + "` holds a `|`, which is the route table's field separator";
                } else if (raw.contains("\n")) {
                    problem = "rakun routing: segment `" + raw + "` in `" + seg + "` holds a newline, which is the route table's record separator";
                } else if (raw == "") {
                    problem = "rakun routing: `" + seg + "` holds an empty segment";
                } else {
                    val k = kindName(s.kind);
                    if (k == "Private") {
                        problem = "rakun routing: `" + raw + "` in `" + seg + "` is a private folder — a `_`-prefixed directory is excluded from routing and may not appear on a registered path";
                    };
                };
            };
        };
        return problem;
    };
}

pub fn trimSlashes(seg: string) -> string {
    var out = seg;
    while (out.startsWith("/")) {
        out = sub(out, 1, out.length());
    };
    while (out.endsWith("/")) {
        out = sub(out, 0, out.length() - 1);
    };
    return out;
}

// The app-relative directory of a convention file, split into segments. `""` is
// the root and answers the empty list.
pub fn parsePath(seg: string) -> Segment[] {
    val problem = pathProblem(seg);
    assert problem == "", problem;
    val trimmed = trimSlashes(seg);
    var out: Segment[] = [];
    if (trimmed == "") return out else {
        for (trimmed.split("/")) { raw ->
            out.push(parseSegment(raw));
        };
        return out;
    };
}

// The URL pattern: groups and slots removed, the bracket spelling preserved.
pub fn patternOf(segments: Segment[]) -> string {
    var parts: string[] = [];
    for (segments) { s ->
        val k = kindName(s.kind);
        if ((k != "Group" && k != "Slot")) {
            parts.push(s.raw);
        };
    };
    if (parts.length == 0) return "/" else return "/" + parts.join("/");
}

// `""` for the children slot, the slot name for an `@slot` entry. A path holds
// at most one `@slot`; the innermost one wins, which is the only reading that
// makes `dashboard/@team/settings` a `team` entry rather than a `dashboard` one.
pub fn slotOf(segments: Segment[]) -> string {
    var name = "";
    for (segments) { s ->
        val k = kindName(s.kind);
        if (k == "Slot") {
            name = s.name;
        };
    };
    return name;
}

// ── step 3: the route table and its wire format ─────────────────────────────
//
// The table crosses the boundary as a LINE-ORIENTED BLOB, not as JSON: std's
// `json` is `string -> @Result<string, string>` with no structured walker, and
// this parser has to compile to the BEAM as well as to the browser. One record
// per line, `\n`-separated, in registration order:
//
//     kind|pattern|slot|verb
//
// `kind` is one letter — `L` layout, `T` template, `P` page, `D` default,
// `R` route handler (front 25), `S` loading (front 30), `E` error and `N`
// not-found (front 31). `pattern` is the URL pattern with groups and slots
// removed and the bracket spelling preserved. `slot` is `""` for the children
// slot and the slot name for an `@slot` entry. `verb` is `""` for a UI entry and
// the HTTP method for an `R` one.
//
// TRAILING EMPTY FIELDS ARE DROPPED, which is what makes the front's rule "no
// line terminates with a trailing `|`" true of a record whose slot and verb are
// both empty — the common case. `parseTable` reads a short line back as empty
// fields, so the round trip is unaffected and no reader ever splits by hand.

pub type RouteEntry(
    kind: string,
    pattern: string,
    slot: string,
    verb: string,
)

pub fn writeTable(entries: RouteEntry[]) -> string {
    var lines: string[] = [];
    for (entries) { e ->
        val head = e.kind + "|" + e.pattern;
        if (e.verb != "") {
            lines.push(head + "|" + e.slot + "|" + e.verb);
        } else if (e.slot != "") {
            lines.push(head + "|" + e.slot);
        } else {
            lines.push(head);
        };
    };
    return lines.join("\n");
}

pub fn parseTable(wire: string) -> RouteEntry[] {
    var out: RouteEntry[] = [];
    if (wire == "") return out else {
        for (wire.split("\n")) { line ->
            if (line != "") {
                val f: string[] = line.split("|");
                out.push(
                    RouteEntry(
                        kind: f.at(0).unwrapOr(""),
                        pattern: f.at(1).unwrapOr(""),
                        slot: f.at(2).unwrapOr(""),
                        verb: f.at(3).unwrapOr(""),
                    ),
                );
            };
        };
        return out;
    };
}

// The long name of a `kind` letter, for a diagnostic and for a reader that would
// otherwise re-derive the table. The eight letters are the front's contract with
// 23, 25, 27, 30, 31, 60, 61 and 66.
pub fn kindLabel(kind: string) -> string {
    if (kind == "L") return "layout" else if (kind == "T") return "template" else if (kind == "P") return "page" else if (kind == "D") return "default" else if (kind == "R") return "route" else if (kind == "S") return "loading" else if (kind == "E") return "error" else if (kind == "N") return "not-found" else return "";
}

// ── step 4: the matcher ─────────────────────────────────────────────────────
//
// One function, both targets, one precedence order — applied segment by
// segment, highest first: static, then dynamic, then catch-all, then optional
// catch-all. Groups never reach here (they are not in a pattern) and a slot
// entry is matched separately against the same URL by front 61, so an entry
// carrying a slot is not a candidate.

pub fn splitPath(p: string) -> string[] {
    var out: string[] = [];
    for (trimSlashes(p).split("/")) { s ->
        if (s != "") {
            out.push(s);
        };
    };
    return out;
}

// The score of one pattern segment, highest first.
pub fn segmentWeight(k: SegmentKind) -> i32 {
    val name = kindName(k);
    if (name == "Static") return 3 else if (name == "Dynamic") return 2 else if (name == "CatchAll") return 1 else return 0;
}

// Lexicographic, segment by segment; a longer score wins a shared prefix, which
// is what makes `/blog/[slug]` beat `/blog/[...slug]` for `/blog/x`.
pub fn scoreBeats(a: i32[], b: i32[]) -> bool {
    val n = if (a.length < b.length) a.length else b.length;
    var verdict = 0;
    var i = 0;
    while (i < n) {
        val av = a.at(i).unwrapOr(0);
        val bv = b.at(i).unwrapOr(0);
        if (verdict == 0) {
            if (av > bv) {
                verdict = 1;
            } else if (av < bv) {
                verdict = 0 - 1;
            };
        };
        i = i + 1;
    };
    if (verdict == 0) {
        if (a.length > b.length) {
            verdict = 1;
        } else if (a.length < b.length) {
            verdict = 0 - 1;
        };
    };
    return verdict > 0;
}

// One attempt at one pattern. `ok` rather than a `?Attempt` so the caller reads
// the score without unwrapping twice; it is internal to `matchPath`.
pub type Attempt(
    ok: bool,
    names: string[],
    values: string[],
    rest: string[],
    score: i32[],
)

pub fn attempt(pattern: string, pathname: string) -> Attempt {
    val pat = splitPath(pattern);
    val url = splitPath(pathname);
    var names: string[] = [];
    var values: string[] = [];
    var rest: string[] = [];
    var score: i32[] = [];
    var ok = true;
    var i = 0;
    var p = 0;
    while (p < pat.length) {
        val raw = pat.at(p).unwrapOr("");
        val seg = parseSegment(raw);
        val kind = kindName(seg.kind);
        val here = url.at(i).unwrapOr("");
        if (kind == "Static") {
            if ((i < url.length && here == raw)) {
                score.push(3);
                i = i + 1;
            } else {
                ok = false;
            };
        } else if (kind == "Dynamic") {
            if (i < url.length) {
                names.push(seg.name);
                values.push(here);
                score.push(2);
                i = i + 1;
            } else {
                ok = false;
            };
        } else if (kind == "CatchAll") {
            if (i < url.length) {
                rest = url.slice(i, url.length);
                names.push(seg.name);
                values.push(rest.join("/"));
                score.push(1);
                i = url.length;
            } else {
                ok = false;
            };
        } else if (kind == "OptionalCatchAll") {
            rest = url.slice(i, url.length);
            names.push(seg.name);
            values.push(rest.join("/"));
            score.push(0);
            i = url.length;
        } else {
            ok = false;
        };
        p = p + 1;
    };
    if (i != url.length) {
        ok = false;
    };
    return Attempt(ok: ok, names: names, values: values, rest: rest, score: score);
}

// The `L` entries wrapping a pattern, root first. Group segments never appear,
// because `patternOf` dropped them before the entry was written.
pub fn ancestorPatterns(pattern: string) -> string[] {
    var out: string[] = ["/"];
    val segs = splitPath(pattern);
    var acc = "";
    var i = 0;
    while (i < segs.length) {
        acc = acc + "/" + segs.at(i).unwrapOr("");
        out.push(acc);
        i = i + 1;
    };
    return out;
}

pub fn layoutChain(table: RouteEntry[], pattern: string) -> RouteEntry[] {
    var chain: RouteEntry[] = [];
    for (ancestorPatterns(pattern)) { p ->
        for (table) { e ->
            if (((e.kind == "L" && e.slot == "") && e.pattern == p)) {
                chain.push(e);
            };
        };
    };
    return chain;
}

// A matched route: the entry that claimed the URL, the bound path parameters,
// the catch-all remainder and the layout chain that wraps it, root first.
pub type RouteMatch(
    entry: RouteEntry,
    params: Dict<string, string>,
    rest: string[],
    chain: RouteEntry[],
)

// A bound path parameter by name, `""` when the route binds none of that name.
// A `RouteMatch` reached through the optional binder of `if (matchPath(…)) { m
// -> … }` has lost its type there, so `m.params.at(name)` lowers to a property
// read and `.unwrapOr` is not a function on it; this reads it through a TYPED
// parameter instead, and is the form fronts 23 and 26 should use.
pub fn paramOf(m: RouteMatch, name: string) -> string {
    return m.params.at(name).unwrapOr("");
}

pub fn paramsOf(names: string[], values: string[]) -> Dict<string, string> {
    var d = dict.empty();
    var i = 0;
    while (i < names.length) {
        d = d.insert(names.at(i).unwrapOr(""), values.at(i).unwrapOr(""));
        i = i + 1;
    };
    return d;
}

// A route is PUBLIC only when a page or a handler claims it: a pattern carrying
// nothing but an `L` entry answers `null`, not a match with no body. A slot
// entry is matched separately, by front 61, against the same URL.
pub fn matchPath(table: RouteEntry[], pathname: string) -> ?RouteMatch {
    var best: RouteEntry[] = [];
    var bestScore: i32[] = [];
    var bestNames: string[] = [];
    var bestValues: string[] = [];
    var bestRest: string[] = [];
    for (table) { e ->
        if (((e.kind == "P" || e.kind == "R") && e.slot == "")) {
            val a = attempt(e.pattern, pathname);
            if (a.ok) {
                if ((best.length == 0 || scoreBeats(a.score, bestScore))) {
                    best = [e];
                    bestScore = a.score;
                    bestNames = a.names;
                    bestValues = a.values;
                    bestRest = a.rest;
                };
            };
        };
    };
    if (best.length == 0) return null else {
        val entry = best.at(0).unwrapOr(RouteEntry(kind: "", pattern: "", slot: "", verb: ""));
        return RouteMatch(
            entry: entry,
            params: paramsOf(bestNames, bestValues),
            rest: bestRest,
            chain: layoutChain(table, entry.pattern),
        );
    };
}

// ── step 2: what a registered route is handed ───────────────────────────────
//
// `Element` is jhonstart's type, not rakun's — rakun declares no dependency on
// it and must not learn one — so everything that would name it is GENERIC in
// `El`, the same trick `rkRegisterRoute<Req>` and `rkSingleton<T>` use to stay
// typed without naming the caller's types.
//
// `LayoutProps` is ONE record rather than three parameters because a declared
// parameter default is still not applied at a call site (measured on this
// binary, on BOTH rows, for a free fn and for a record field alike — the
// compiler's `docs.md` says otherwise). A layout that uses no slot would
// otherwise still have to spell out an empty `slots:` argument at every call
// site the registry generates. One uniform arity is the only shape that
// survives the gap.

pub type PageContext(
    pathname: string,
    pattern: string,
    params: Dict<string, string>,
    query: Dict<string, string>,
    rest: string[],
)

pub type LayoutProps<El>(
    route: PageContext,
    children: El,
    slots: Dict<string, El>,
)

// A `PageContext` for a matched URL. The query is the caller's — front 23 hands
// what the request carried, a test hands an empty dict.
pub fn contextOf(m: RouteMatch, pathname: string, query: Dict<string, string>) -> PageContext {
    return PageContext(
        pathname: pathname,
        pattern: m.entry.pattern,
        params: m.params,
        query: query,
        rest: m.rest,
    );
}

pub fn emptyParams() -> Dict<string, string> {
    return dict.empty();
}

// ── the registry ────────────────────────────────────────────────────────────
//
// Each cell carries BOTH host forms, which is what makes this shape legal where
// front 05's was not: `botopink test` compiles every `test/*.bp` on both rows
// with no per-target gate, so a cell with only an `@External.Erlang` form is a
// located diagnostic on the commonJS row at its call site. Nothing here is
// erlang-only.
//
// The cells take the FINISHED `kind|pattern|slot|verb` line, never the raw
// segment: the grammar and the wire format stay in botopink, compiled twice,
// and neither host knows how to build a record. The `rkApp*` wrappers below are
// what the markers emit and what keeps the front's own surface
// `(seg, render)`.

#[@External.Node("./file_router.mjs", "registerPage"),
  @External.Erlang("rakun_file_router", "register_page")]
pub declare fn rkAppRegisterPage<El>(
    record: string,
    render: fn(route: PageContext) -> @Task<El>,
) -> i32;

#[@External.Node("./file_router.mjs", "registerLayout"),
  @External.Erlang("rakun_file_router", "register_layout")]
pub declare fn rkAppRegisterLayout<El>(
    record: string,
    render: fn(props: LayoutProps<El>) -> El,
) -> i32;

#[@External.Node("./file_router.mjs", "registerTemplate"),
  @External.Erlang("rakun_file_router", "register_template")]
pub declare fn rkAppRegisterTemplate<El>(
    record: string,
    render: fn(props: LayoutProps<El>) -> El,
) -> i32;

#[@External.Node("./file_router.mjs", "registerDefault"),
  @External.Erlang("rakun_file_router", "register_default")]
pub declare fn rkAppRegisterDefault<El>(
    record: string,
    render: fn(props: LayoutProps<El>) -> El,
) -> i32;

// Front 25's `route.bp` handlers register into the SAME table as `R` records,
// through a cell declared here and generic over the response type — so this
// front never has to know what a `HandlerResponse` is and front 25 never has to
// declare a host cell.
#[@External.Node("./file_router.mjs", "registerHandler"),
  @External.Erlang("rakun_file_router", "register_handler")]
pub declare fn rkAppRegisterHandler<Res>(
    record: string,
    handle: fn(req: Request) -> Res,
) -> i32;

#[@External.Node("./file_router.mjs", "table"),
  @External.Erlang("rakun_file_router", "table")]
pub declare fn rkAppTable() -> string;

#[@External.Node("./file_router.mjs", "count"),
  @External.Erlang("rakun_file_router", "count")]
pub declare fn rkAppCount() -> i32;

#[@External.Node("./file_router.mjs", "hasRender"),
  @External.Erlang("rakun_file_router", "has_render")]
pub declare fn rkAppHasRender(record: string) -> bool;

// The stored function, or `fallback` when nothing registered that record.
// Total and typed: an optional function type is a shape neither row reads
// comfortably, and front 23 needs a value it can call either way.
#[@External.Node("./file_router.mjs", "render"),
  @External.Erlang("rakun_file_router", "render")]
pub declare fn rkAppRender<F>(record: string, fallback: F) -> F;

#[@External.Node("./file_router.mjs", "reset"),
  @External.Erlang("rakun_file_router", "reset")]
pub declare fn rkAppReset() -> i32;

// Where each registration was WRITTEN. The wire record carries the URL pattern,
// not the app-relative directory, and the scan has to check the DIRECTORY the
// marker was given against the real tree and name the function that got it
// wrong. So the raw pair is kept beside the table rather than squeezed into a
// fifth field of a four-field record.
#[@External.Node("./file_router.mjs", "registerSource"),
  @External.Erlang("rakun_file_router", "register_source")]
pub declare fn rkAppRegisterSource(seg: string, fnName: string) -> i32;

#[@External.Node("./file_router.mjs", "sources"),
  @External.Erlang("rakun_file_router", "sources")]
pub declare fn rkAppSources() -> string;

// The one place a `kind`, a segment and a verb become a wire record. It HALTS
// on a segment that may not be registered — a `_`-prefixed folder, an empty
// segment, a `|` or a newline — which is the right moment for that refusal: the
// call is a module-load `val`, so the program stops at load rather than serving
// something surprising.
pub fn entryLine(kind: string, seg: string, verb: string) -> string {
    val segs = parsePath(seg);
    return writeTable(
        [RouteEntry(kind: kind, pattern: patternOf(segs), slot: slotOf(segs), verb: verb)],
    );
}

pub fn rkAppPage<El>(seg: string, render: fn(route: PageContext) -> @Task<El>) -> i32 {
    return rkAppRegisterPage(entryLine("P", seg, ""), render);
}

pub fn rkAppLayout<El>(seg: string, render: fn(props: LayoutProps<El>) -> El) -> i32 {
    return rkAppRegisterLayout(entryLine("L", seg, ""), render);
}

pub fn rkAppTemplate<El>(seg: string, render: fn(props: LayoutProps<El>) -> El) -> i32 {
    return rkAppRegisterTemplate(entryLine("T", seg, ""), render);
}

pub fn rkAppDefault<El>(seg: string, render: fn(props: LayoutProps<El>) -> El) -> i32 {
    return rkAppRegisterDefault(entryLine("D", seg, ""), render);
}

pub fn rkAppHandler<Res>(verb: string, seg: string, handle: fn(req: Request) -> Res) -> i32 {
    return rkAppRegisterHandler(entryLine("R", seg, verb), handle);
}

// The registered table, parsed. The server reads it from its own registry and
// the client rebuilds it out of the `"t"` field of front 23's payload with the
// same `parseTable`, which is what makes the two sides agree.
pub fn appTable() -> RouteEntry[] {
    return parseTable(rkAppTable());
}

// ── what an emitted accessor reads ──────────────────────────────────────────
// A `PageContext` reached through a TYPED parameter, which is the shape the
// emitted code has; `route.params.at(name)` written inline would be read off an
// untyped binder at some call sites and lower to a property read.

pub fn ctxParam(route: PageContext, name: string) -> string {
    return route.params.at(name).unwrapOr("");
}

pub fn ctxRest(route: PageContext) -> string[] {
    return route.rest;
}

// ── step 2 and step 6: the four markers ─────────────────────────────────────
//
// One decorator per file convention, each taking the APP-RELATIVE DIRECTORY of
// the file it sits in. `default` is a reserved keyword, so the `default.bp`
// marker is spelled `#[defaultView]` — the only name in the set that does not
// match its file.
//
// Each body does three things, in the order rakun's own component markers do
// them: it `@emit`s the registration, it `@emit`s the per-route parameter
// accessor, and then it enforces placement with `decl.fail`. The `@emit`s run
// first because a failed outcome discards the contributions.
//
// THREE RESTRICTIONS SHAPE THESE BODIES AND NONE IS NEGOTIABLE. A decorator
// body cannot call a sibling function — the evaluator emits only the decorator
// function into the eval script — which is why the segment walk is inlined in
// each of the four rather than shared, exactly as `decorators.bp` copies its
// field-injection block six times. A `//` comment anywhere in the body breaks
// the flattened emit, so the bodies are comment-free and the prose lives here.
// And nothing optional works in a comptime body — no `.at(i)`, no `?T` — so the
// walk uses `split` / `forEach` / `push` / `join` / `startsWith` / `replaceAll`
// only, and everything a field needs is pushed in the SAME pass.
//
// THE REGISTRATION IS A LAMBDA, NOT A BARE NAME. `rkAppPage("blog",
// blogPostPage)` compiles on the node row and is `variable 'BlogPostPage' is
// unbound` on the erlang one: a named function used as a VALUE is not lowered
// to a `fun name/1`. `{ route -> blogPostPage(route) }` is the same value and
// lowers on both, and it is what `decorators.bp` already emits for a controller
// method. Recorded in `AGENTS.md`, not worked around anywhere else.
//
// THE RETURN TYPE A `@Decl` CARRIES HAS NO TYPE ARGUMENT. `decl.returnType` is
// `"Task"` for `-> @Task<Element>`, `"Element"` for `-> Element` and `""`
// for a type. So a page is checked to be a `Task` and a layout to be anything
// that is not one; the required spelling is in the MESSAGE, which is as close to
// "naming the required return type" as the reflection allows.

pub fn page(comptime decl: @Decl, seg: string) {
    @emit("val __rkPage_" + decl.name + " = rkAppPage(\"" + seg + "\", { route -> " + decl.name + "(route) });");
    @emit("val __rkSrc_" + decl.name + " = rkAppRegisterSource(\"" + seg + "\", \"" + decl.name + "\");");
    var lets: Array<string> = [];
    var sigs: Array<string> = [];
    var fields: Array<string> = [];
    seg.split("/").forEach({ raw ->
        if (raw.startsWith("[")) {
            val bare = raw.replaceAll("[", "").replaceAll("]", "").replaceAll(".", "");
            val isList = raw.startsWith("[[") || raw.startsWith("[.");
            val reader = if (isList) "ctxRest(route)" else "ctxParam(route, \"" + bare + "\")";
            val shown = if (isList) "string[]" else "string";
            lets.push("val " + bare + " = " + reader + ";");
            sigs.push(bare + ": " + shown);
            fields.push(bare);
        };
    });
    @emit("pub fn " + decl.name + "Params(route: PageContext) -> #(" + sigs.join(", ") + ") { " + lets.join(
            " "
        ) + " return #(" + fields.join(", ") + "); }");
    if (decl.kind != DeclKind.Fn) decl.fail("#[page] must annotate a function");
    if (decl.returnType != "Task") decl.fail("#[page] must annotate a fn returning @Task<Element> — every page is async so the render pipeline has one shape to drive");
}

pub fn layout(comptime decl: @Decl, seg: string) {
    @emit("val __rkLayout_" + decl.name + " = rkAppLayout(\"" + seg + "\", { props -> " + decl.name + "(props) });");
    @emit("val __rkSrc_" + decl.name + " = rkAppRegisterSource(\"" + seg + "\", \"" + decl.name + "\");");
    if (decl.kind != DeclKind.Fn) decl.fail("#[layout] must annotate a function");
    if (decl.returnType == "") decl.fail("#[layout] must annotate a fn(props: LayoutProps) -> Element");
    if (decl.returnType == "Task") decl.fail("#[layout] must annotate a fn(props: LayoutProps) -> Element — a layout is synchronous, only a page is a @Task");
}

pub fn template(comptime decl: @Decl, seg: string) {
    @emit("val __rkTemplate_" + decl.name + " = rkAppTemplate(\"" + seg + "\", { props -> " + decl.name + "(props) });");
    @emit("val __rkSrc_" + decl.name + " = rkAppRegisterSource(\"" + seg + "\", \"" + decl.name + "\");");
    if (decl.kind != DeclKind.Fn) decl.fail("#[template] must annotate a function");
    if (decl.returnType == "") decl.fail("#[template] must annotate a fn(props: LayoutProps) -> Element");
    if (decl.returnType == "Task") decl.fail("#[template] must annotate a fn(props: LayoutProps) -> Element — a template is synchronous, only a page is a @Task");
}

pub fn defaultView(comptime decl: @Decl, seg: string) {
    @emit("val __rkDefault_" + decl.name + " = rkAppDefault(\"" + seg + "\", { props -> " + decl.name + "(props) });");
    @emit("val __rkSrc_" + decl.name + " = rkAppRegisterSource(\"" + seg + "\", \"" + decl.name + "\");");
    if (decl.kind != DeclKind.Fn) decl.fail("#[defaultView] must annotate a function");
    if (decl.returnType == "") decl.fail("#[defaultView] must annotate a fn(props: LayoutProps) -> Element");
    if (decl.returnType == "Task") decl.fail("#[defaultView] must annotate a fn(props: LayoutProps) -> Element — a default view is synchronous, only a page is a @Task");
}

// ── step 5: the scan ────────────────────────────────────────────────────────
//
// The scan is the half that keeps the decorator argument HONEST. It reads
// `appDir` from front 05's property table, walks the real tree, and fails
// loudly rather than serving something surprising.
//
// IT IS WRITTEN IN BOTOPINK, over `std`'s `fs`, and not in the two host files
// the front's text puts it in. Two reasons, both front 05's. A scan written
// twice can disagree twice, and the whole point of this front is that the two
// sides cannot disagree; and an erlang-only cell cannot be asserted from a
// `.bp` test at all, so the acceptance list below would have had to be taken on
// trust. `fs.list`, `fs.exists` and `fs.stat` each carry both host forms, so one
// implementation answers identically on both rows — which is the only claim
// worth making about a port.
//
// The REFUSALS are strings rather than a halt, for the reason `durationProblem`
// is a function of its own: the CLI (front 50) prints them and stops, a server
// boot check prints them and stops, and a test reads them without the halt
// taking the test down.

pub fn noStrings() -> string[] {
    var out: string[] = [];
    return out;
}

// The eight convention filenames, in the order their kind letters are listed.
pub fn conventionFiles() -> string[] {
    return [
        "layout.bp",
        "template.bp",
        "page.bp",
        "default.bp",
        "route.bp",
        "loading.bp",
        "error.bp",
        "not-found.bp",
    ];
}

pub fn conventionKind(file: string) -> string {
    if (file == "layout.bp") return "L" else if (file == "template.bp") return "T" else if (file == "page.bp") return "P" else if (file == "default.bp") return "D" else if (file == "route.bp") return "R" else if (file == "loading.bp") return "S" else if (file == "error.bp") return "E" else if (file == "not-found.bp") return "N" else return "";
}

// `appDir` is CONFIGURATION, not a literal (front 05): `app` or `src/app`, so
// moving the tree between the two layouts changes one config line and no source.
pub fn appDirOf() -> string {
    val configured = rkProp("onze.appDir");
    if (configured == "") return "app" else return configured;
}

// A name is a directory when listing it succeeds. `fs.stat` would say so more
// directly, but its `FileStat` carries an `i64` field and an integer literal is
// `i32` with no widening, so a fallback value for the `catch` cannot be written.
pub fn isDir(path: string) -> bool {
    return fs.list(path).isOk();
}

pub fn childDirs(path: string) -> string[] {
    val names = try fs.list(path) catch noStrings();
    var out: string[] = [];
    for (names) { n ->
        if (isDir(path + "/" + n)) {
            out.push(n);
        };
    };
    return out;
}

// Every app-relative directory under `base`, depth first, with `_`-prefixed
// folders SKIPPED — nothing inside one is registered even if it holds a
// `page.bp`. The root itself is not in the list; `scanAppDir` adds it as `""`.
pub fn walkSegments(base: string, seg: string) -> string[] {
    val here = if (seg == "") base else base + "/" + seg;
    var out: string[] = [];
    for (childDirs(here)) { name ->
        if (name.startsWith("_").negate()) {
            val child = if (seg == "") name else seg + "/" + name;
            out.push(child);
            for (walkSegments(base, child)) { deeper ->
                out.push(deeper);
            };
        };
    };
    return out;
}

pub fn conventionsIn(base: string, seg: string) -> string[] {
    val dir = if (seg == "") base else base + "/" + seg;
    var out: string[] = [];
    for (conventionFiles()) { f ->
        if (fs.exists(dir + "/" + f)) {
            out.push(f);
        };
    };
    return out;
}

pub type ScanEntry(
    seg: string,
    pattern: string,
    slot: string,
    conventions: string[],
)

pub type ScanReport(
    appDir: string,
    entries: ScanEntry[],
    middleware: string,
    problems: string[],
)

// The table the tree implies, in walk order — the same records the markers
// register, derived from the directories instead of from the arguments. The two
// are compared by `registrationProblems`.
pub fn scanTable(report: ScanReport) -> RouteEntry[] {
    var out: RouteEntry[] = [];
    for (report.entries) { e ->
        for (e.conventions) { f ->
            val kind = conventionKind(f);
            val verb = if (kind == "R") "GET" else "";
            out.push(RouteEntry(kind: kind, pattern: e.pattern, slot: e.slot, verb: verb));
        };
    };
    return out;
}

pub fn scanAppDir(root: string, appDir: string) -> ScanReport {
    val base = if (root == "") appDir else root + "/" + appDir;
    var entries: ScanEntry[] = [];
    var problems: string[] = [];
    var segs: string[] = [""];
    for (walkSegments(base, "")) { s ->
        segs.push(s);
    };
    for (segs) { seg ->
        val found = conventionsIn(base, seg);
        if (found.length > 0) {
            val problem = pathProblem(seg);
            if (problem != "") {
                problems.push(problem);
            } else {
                val parsed = parsePath(seg);
                entries.push(
                    ScanEntry(
                        seg: seg,
                        pattern: patternOf(parsed),
                        slot: slotOf(parsed),
                        conventions: found,
                    ),
                );
            };
        };
    };
    for (conflictProblems(entries)) { p ->
        problems.push(p);
    };
    val middlewarePath = if (root == "") "middleware.bp" else root + "/middleware.bp";
    val middleware = if (fs.exists(middlewarePath)) middlewarePath else "";
    return ScanReport(
        appDir: appDir,
        entries: entries,
        middleware: middleware,
        problems: problems,
    );
}

// The top-level `(group)` a segment sits under, `""` when it sits under none.
pub fn rootGroupOf(seg: string) -> string {
    val parts = splitPath(seg);
    if (parts.length == 0) return "" else {
        val head = parts.at(0).unwrapOr("");
        if (kindName(parseSegment(head).kind) == "Group") return head else return "";
    };
}

pub fn hasConvention(e: ScanEntry, file: string) -> bool {
    var found = false;
    for (e.conventions) { f ->
        if (f == file) {
            found = true;
        };
    };
    return found;
}

// Two rules the tree can break on its own, both refused by name. The second is
// § 5 Múltiplos Root Layouts: two route groups may each own a root layout, and
// that is legal right up to the point where their subtrees claim one URL.
pub fn conflictProblems(entries: ScanEntry[]) -> string[] {
    var problems: string[] = [];
    for (entries) { e ->
        if ((hasConvention(e, "page.bp") && hasConvention(e, "route.bp"))) {
            problems.push(
                "rakun routing: `" + e.seg + "` holds both page.bp and route.bp — a segment is a page or an endpoint, never both",
            );
        };
    };
    var keys: string[] = [];
    var groups: string[] = [];
    for (entries) { e ->
        if (hasConvention(e, "page.bp")) {
            val key = e.pattern + "|" + e.slot;
            val group = rootGroupOf(e.seg);
            val prior = keys.indexOf(key);
            if (prior >= 0) {
                val priorGroup = groups.at(prior).unwrapOr("");
                if (priorGroup != group) {
                    problems.push(
                        "rakun routing: `" + e.pattern + "` is claimed by both `" + priorGroup + "` and `" + group + "` — two root layouts whose subtrees match one URL",
                    );
                };
            };
            keys.push(key);
            groups.push(group);
        };
    };
    return problems;
}

// ── the registered side of the scan ─────────────────────────────────────────

pub type SourceEntry(
    seg: string,
    fnName: string,
)

pub fn parseSources(wire: string) -> SourceEntry[] {
    var out: SourceEntry[] = [];
    if (wire == "") return out else {
        for (wire.split("\n")) { line ->
            if (line != "") {
                val f: string[] = line.split("|");
                out.push(SourceEntry(seg: f.at(0).unwrapOr(""), fnName: f.at(1).unwrapOr("")));
            };
        };
        return out;
    };
}

pub fn appSources() -> SourceEntry[] {
    return parseSources(rkAppSources());
}

// The check that keeps the decorator argument honest, in both directions: a
// registered segment with no directory under `appDir`, and a directory holding a
// convention file that registered nothing.
pub fn registrationProblems(report: ScanReport, sources: SourceEntry[]) -> string[] {
    var problems: string[] = [];
    var known: string[] = [];
    for (report.entries) { e ->
        known.push(e.seg);
    };
    for (sources) { src ->
        var found = false;
        for (known) { k ->
            if (k == src.seg) {
                found = true;
            };
        };
        if (found.negate()) {
            problems.push(
                "rakun routing: `" + src.seg + "` was registered by `" + src.fnName + "` but there is no directory `" + report.appDir + "/" + src.seg + "`",
            );
        };
    };
    for (report.entries) { e ->
        var registered = false;
        for (sources) { src ->
            if (src.seg == e.seg) {
                registered = true;
            };
        };
        if (registered.negate()) {
            problems.push(
                "rakun routing: `" + report.appDir + "/" + e.seg + "` holds " + e.conventions.join(
                    ", "
                ) + " but nothing registered it — the marker's argument is what puts a route in the table",
            );
        };
    };
    return problems;
}
