//// rakun — the file-convention route table: the segment grammar, the wire
//// format, the matcher and the four markers that fill the registry.
////
//// `#[restController]` + `#[getMapping]` (`decorators.bp`) route by DECORATOR and
//// that model is untouched. This module is the other one: a URL that comes from
//// where a file sits, a layout that wraps everything below it, a segment that
//// captures part of the path, a folder that is transparent to the URL and a
//// folder that renders into a named slot of its parent. Front 23 nests layouts
//// off `layoutChain`, front 25 registers `route.bp` handlers into the same
//// table, front 27 asks whether a `Link` target is worth prefetching and front
//// 61 hangs `@slot` off the same tree.
////
//// WHY THE ARGUMENT IS A STRING. botopink compiles only declared modules
//// (`pub mod` in the package root), so a `.bp` file is not loadable by path, and
//// `@Decl` carries no source location — a decorator cannot learn which file it
//// was written in. A file-convention router in botopink is therefore
//// REGISTRATION-driven and the app-relative directory reaches the decorator as
//// an argument, which `scanProblem` below checks against the real tree.
////
//// WHY THERE IS A `.mjs` AND AN `.erl` HERE AND NOT IN `config.bp`. Front 05
//// refused its sidecar because its work was PURE — document readers — and an
//// erlang-only cell is a located node-row diagnostic at its call site. Nothing
//// about that applies to a REGISTRY: botopink has no top-level mutable state, so
//// the table has to live in the host, exactly as `rkRegisterRoute`'s does, and a
//// registered render function is a closure that no string store can hold. Every
//// cell below therefore carries BOTH forms — `@External.Node("./file_router.mjs")`
//// and `@External.Erlang("rakun_file_router")` — so neither row is a compile
//// error, and `test/file_router_test.bp` runs the same assertions on both. What
//// is NOT duplicated is the part front 05's argument was really about: the
//// grammar, the wire format and the matcher are botopink, compiled twice, so the
//// browser and the BEAM cannot disagree about which route a URL is.
////
//// LANGUAGE NOTES this file is written around (measured, not guessed; the full
//// list is in `AGENTS.md` § Language notes):
////   * `String.slice`/`chars`/`lines`/`words`/`charCodeAt` kill the commonJS
////     module before a test runs; every substring is built through `charOf`/`sub`.
////   * A declared parameter default is still not applied at a call site, on
////     either row, so every call passes every argument.
////   * `&&` and `||` inside an `if (…)` head need their own parentheses.
////   * A `//` comment inside a braced block is fatal on the node row, and a
////     decorator body cannot call a sibling function — so the four markers below
////     are comment-free and inline their segment walk instead of sharing one.

import {dict} from "std";

// ── character helpers ───────────────────────────────────────────────────────
// `config.bp` has the same two; a decorator body cannot call a sibling and a
// module cannot import a private one, so they are spelled again rather than
// shared. They are `pub` because the test file reads them.

pub fn charOf(s: string, i: i32) -> string {
    return s.at(i).unwrapOr("");
}

pub fn sub(s: string, begin: i32, end: i32) -> string {
    var out = "";
    var i = begin;
    val stop = if (end > s.length()) s.length() else end;
    loop (i < stop) {
        out = out + charOf(s, i);
        i = i + 1;
    };
    return out;
}

// ── step 1: the segment grammar ─────────────────────────────────────────────
//
// Four folder spellings are not URL segments: `(group)` is transparent,
// `@slot` renders into a named prop of the parent layout, `_private` is
// excluded from routing entirely, and `[dynamic]` / `[...catchAll]` /
// `[[...optionalCatchAll]]` capture instead of matching.

pub type SegmentKind {
    Static,
    Dynamic,
    CatchAll,
    OptionalCatchAll,
    Group,
    Slot,
    Private,
}

pub type Segment(
    kind: SegmentKind,
    name: string,
    raw: string,
)

// The one place the bracket and parenthesis spellings are decoded. Pure and
// total: a name that may not appear on a registered path is still classified
// here and refused by `pathProblem`, one step up.
pub fn parseSegment(raw: string) -> Segment {
    val n = raw.length();
    if ((raw.startsWith("[[...") && raw.endsWith("]]"))) return Segment(
        kind: SegmentKind.OptionalCatchAll,
        name: sub(raw, 5, n - 2),
        raw: raw,
    ) else if ((raw.startsWith("[...") && raw.endsWith("]"))) return Segment(
        kind: SegmentKind.CatchAll,
        name: sub(raw, 4, n - 1),
        raw: raw,
    ) else if ((raw.startsWith("[") && raw.endsWith("]"))) return Segment(
        kind: SegmentKind.Dynamic,
        name: sub(raw, 1, n - 1),
        raw: raw,
    ) else if ((raw.startsWith("(") && raw.endsWith(")"))) return Segment(
        kind: SegmentKind.Group,
        name: sub(raw, 1, n - 1),
        raw: raw,
    ) else if (raw.startsWith("@")) return Segment(
        kind: SegmentKind.Slot,
        name: sub(raw, 1, n),
        raw: raw,
    ) else if (raw.startsWith("_")) return Segment(
        kind: SegmentKind.Private,
        name: sub(raw, 1, n),
        raw: raw,
    ) else return Segment(kind: SegmentKind.Static, name: raw, raw: raw);
}

// The kind as a word. `case` rather than `==`, so nothing depends on how a
// payload-free variant compares on either row; it is also what a test asserts
// against and what a diagnostic prints.
pub fn kindName(k: SegmentKind) -> string {
    return case k {
        Static -> "Static";
        Dynamic -> "Dynamic";
        CatchAll -> "CatchAll";
        OptionalCatchAll -> "OptionalCatchAll";
        Group -> "Group";
        Slot -> "Slot";
        Private -> "Private";
    };
}

// `""` when the path is registrable, the refusal otherwise. Split out for the
// reason `config.bp` splits `durationProblem` out: `parsePath` HALTS on a bad
// path (it is called from an emitted module-load `val`, which is not a
// `#[@result]` context), and a test can only read the message if reading it
// does not take the test down with it.
pub fn pathProblem(seg: string) -> string {
    var problem = "";
    val trimmed = trimSlashes(seg);
    if (trimmed == "") return "" else {
        loop (trimmed.split("/")) { raw ->
            if (problem == "") {
                val s = parseSegment(raw);
                if (raw.contains("|")) {
                    problem = "rakun routing: segment `" + raw + "` in `" + seg + "` holds a `|`, which is the route table's field separator";
                } else if (raw.contains("\n")) {
                    problem = "rakun routing: segment `" + raw + "` in `" + seg + "` holds a newline, which is the route table's record separator";
                } else if (raw == "") {
                    problem = "rakun routing: `" + seg + "` holds an empty segment";
                } else {
                    val k = kindName(s.kind);
                    if (k == "Private") {
                        problem = "rakun routing: `" + raw + "` in `" + seg + "` is a private folder — a `_`-prefixed directory is excluded from routing and may not appear on a registered path";
                    };
                };
            };
        };
        return problem;
    };
}

pub fn trimSlashes(seg: string) -> string {
    var out = seg;
    loop (out.startsWith("/")) {
        out = sub(out, 1, out.length());
    };
    loop (out.endsWith("/")) {
        out = sub(out, 0, out.length() - 1);
    };
    return out;
}

// The app-relative directory of a convention file, split into segments. `""` is
// the root and answers the empty list.
pub fn parsePath(seg: string) -> Segment[] {
    val problem = pathProblem(seg);
    assert problem == "", problem;
    val trimmed = trimSlashes(seg);
    var out: Segment[] = [];
    if (trimmed == "") return out else {
        loop (trimmed.split("/")) { raw ->
            out.push(parseSegment(raw));
        };
        return out;
    };
}

// The URL pattern: groups and slots removed, the bracket spelling preserved.
pub fn patternOf(segments: Segment[]) -> string {
    var parts: string[] = [];
    loop (segments) { s ->
        val k = kindName(s.kind);
        if ((k != "Group" && k != "Slot")) {
            parts.push(s.raw);
        };
    };
    if (parts.length == 0) return "/" else return "/" + parts.join("/");
}

// `""` for the children slot, the slot name for an `@slot` entry. A path holds
// at most one `@slot`; the innermost one wins, which is the only reading that
// makes `dashboard/@team/settings` a `team` entry rather than a `dashboard` one.
pub fn slotOf(segments: Segment[]) -> string {
    var name = "";
    loop (segments) { s ->
        val k = kindName(s.kind);
        if (k == "Slot") {
            name = s.name;
        };
    };
    return name;
}

// ── step 3: the route table and its wire format ─────────────────────────────
//
// The table crosses the boundary as a LINE-ORIENTED BLOB, not as JSON: std's
// `json` is `string -> @Result<string, string>` with no structured walker, and
// this parser has to compile to the BEAM as well as to the browser. One record
// per line, `\n`-separated, in registration order:
//
//     kind|pattern|slot|verb
//
// `kind` is one letter — `L` layout, `T` template, `P` page, `D` default,
// `R` route handler (front 25), `S` loading (front 30), `E` error and `N`
// not-found (front 31). `pattern` is the URL pattern with groups and slots
// removed and the bracket spelling preserved. `slot` is `""` for the children
// slot and the slot name for an `@slot` entry. `verb` is `""` for a UI entry and
// the HTTP method for an `R` one.
//
// TRAILING EMPTY FIELDS ARE DROPPED, which is what makes the front's rule "no
// line terminates with a trailing `|`" true of a record whose slot and verb are
// both empty — the common case. `parseTable` reads a short line back as empty
// fields, so the round trip is unaffected and no reader ever splits by hand.

pub type RouteEntry(
    kind: string,
    pattern: string,
    slot: string,
    verb: string,
)

pub fn writeTable(entries: RouteEntry[]) -> string {
    var lines: string[] = [];
    loop (entries) { e ->
        val head = e.kind + "|" + e.pattern;
        if (e.verb != "") {
            lines.push(head + "|" + e.slot + "|" + e.verb);
        } else if (e.slot != "") {
            lines.push(head + "|" + e.slot);
        } else {
            lines.push(head);
        };
    };
    return lines.join("\n");
}

pub fn parseTable(wire: string) -> RouteEntry[] {
    var out: RouteEntry[] = [];
    if (wire == "") return out else {
        loop (wire.split("\n")) { line ->
            if (line != "") {
                val f: string[] = line.split("|");
                out.push(
                    RouteEntry(
                        kind: f.at(0).unwrapOr(""),
                        pattern: f.at(1).unwrapOr(""),
                        slot: f.at(2).unwrapOr(""),
                        verb: f.at(3).unwrapOr(""),
                    ),
                );
            };
        };
        return out;
    };
}

// The long name of a `kind` letter, for a diagnostic and for a reader that would
// otherwise re-derive the table. The eight letters are the front's contract with
// 23, 25, 27, 30, 31, 60, 61 and 66.
pub fn kindLabel(kind: string) -> string {
    if (kind == "L") return "layout" else if (kind == "T") return "template" else if (kind == "P") return "page" else if (kind == "D") return "default" else if (kind == "R") return "route" else if (kind == "S") return "loading" else if (kind == "E") return "error" else if (kind == "N") return "not-found" else return "";
}

// ── step 4: the matcher ─────────────────────────────────────────────────────
//
// One function, both targets, one precedence order — applied segment by
// segment, highest first: static, then dynamic, then catch-all, then optional
// catch-all. Groups never reach here (they are not in a pattern) and a slot
// entry is matched separately against the same URL by front 61, so an entry
// carrying a slot is not a candidate.

pub fn splitPath(p: string) -> string[] {
    var out: string[] = [];
    loop (trimSlashes(p).split("/")) { s ->
        if (s != "") {
            out.push(s);
        };
    };
    return out;
}

// The score of one pattern segment, highest first.
pub fn segmentWeight(k: SegmentKind) -> i32 {
    val name = kindName(k);
    if (name == "Static") return 3 else if (name == "Dynamic") return 2 else if (name == "CatchAll") return 1 else return 0;
}

// Lexicographic, segment by segment; a longer score wins a shared prefix, which
// is what makes `/blog/[slug]` beat `/blog/[...slug]` for `/blog/x`.
pub fn scoreBeats(a: i32[], b: i32[]) -> bool {
    val n = if (a.length < b.length) a.length else b.length;
    var verdict = 0;
    var i = 0;
    loop (i < n) {
        val av = a.at(i).unwrapOr(0);
        val bv = b.at(i).unwrapOr(0);
        if (verdict == 0) {
            if (av > bv) {
                verdict = 1;
            } else if (av < bv) {
                verdict = 0 - 1;
            };
        };
        i = i + 1;
    };
    if (verdict == 0) {
        if (a.length > b.length) {
            verdict = 1;
        } else if (a.length < b.length) {
            verdict = 0 - 1;
        };
    };
    return verdict > 0;
}

// One attempt at one pattern. `ok` rather than a `?Attempt` so the caller reads
// the score without unwrapping twice; it is internal to `matchPath`.
pub type Attempt(
    ok: bool,
    names: string[],
    values: string[],
    rest: string[],
    score: i32[],
)

pub fn attempt(pattern: string, pathname: string) -> Attempt {
    val pat = splitPath(pattern);
    val url = splitPath(pathname);
    var names: string[] = [];
    var values: string[] = [];
    var rest: string[] = [];
    var score: i32[] = [];
    var ok = true;
    var i = 0;
    var p = 0;
    loop (p < pat.length) {
        val raw = pat.at(p).unwrapOr("");
        val seg = parseSegment(raw);
        val kind = kindName(seg.kind);
        val here = url.at(i).unwrapOr("");
        if (kind == "Static") {
            if ((i < url.length && here == raw)) {
                score.push(3);
                i = i + 1;
            } else {
                ok = false;
            };
        } else if (kind == "Dynamic") {
            if (i < url.length) {
                names.push(seg.name);
                values.push(here);
                score.push(2);
                i = i + 1;
            } else {
                ok = false;
            };
        } else if (kind == "CatchAll") {
            if (i < url.length) {
                rest = url.slice(i, url.length);
                names.push(seg.name);
                values.push(rest.join("/"));
                score.push(1);
                i = url.length;
            } else {
                ok = false;
            };
        } else if (kind == "OptionalCatchAll") {
            rest = url.slice(i, url.length);
            names.push(seg.name);
            values.push(rest.join("/"));
            score.push(0);
            i = url.length;
        } else {
            ok = false;
        };
        p = p + 1;
    };
    if (i != url.length) {
        ok = false;
    };
    return Attempt(ok: ok, names: names, values: values, rest: rest, score: score);
}

// The `L` entries wrapping a pattern, root first. Group segments never appear,
// because `patternOf` dropped them before the entry was written.
pub fn ancestorPatterns(pattern: string) -> string[] {
    var out: string[] = ["/"];
    val segs = splitPath(pattern);
    var acc = "";
    var i = 0;
    loop (i < segs.length) {
        acc = acc + "/" + segs.at(i).unwrapOr("");
        out.push(acc);
        i = i + 1;
    };
    return out;
}

pub fn layoutChain(table: RouteEntry[], pattern: string) -> RouteEntry[] {
    var chain: RouteEntry[] = [];
    loop (ancestorPatterns(pattern)) { p ->
        loop (table) { e ->
            if (((e.kind == "L" && e.slot == "") && e.pattern == p)) {
                chain.push(e);
            };
        };
    };
    return chain;
}

// A matched route: the entry that claimed the URL, the bound path parameters,
// the catch-all remainder and the layout chain that wraps it, root first.
pub type RouteMatch(
    entry: RouteEntry,
    params: Dict<string, string>,
    rest: string[],
    chain: RouteEntry[],
)

// A bound path parameter by name, `""` when the route binds none of that name.
// A `RouteMatch` reached through the optional binder of `if (matchPath(…)) { m
// -> … }` has lost its type there, so `m.params.at(name)` lowers to a property
// read and `.unwrapOr` is not a function on it; this reads it through a TYPED
// parameter instead, and is the form fronts 23 and 26 should use.
pub fn paramOf(m: RouteMatch, name: string) -> string {
    return m.params.at(name).unwrapOr("");
}

pub fn paramsOf(names: string[], values: string[]) -> Dict<string, string> {
    var d = dict.empty();
    var i = 0;
    loop (i < names.length) {
        d = d.insert(names.at(i).unwrapOr(""), values.at(i).unwrapOr(""));
        i = i + 1;
    };
    return d;
}

// A route is PUBLIC only when a page or a handler claims it: a pattern carrying
// nothing but an `L` entry answers `null`, not a match with no body. A slot
// entry is matched separately, by front 61, against the same URL.
pub fn matchPath(table: RouteEntry[], pathname: string) -> ?RouteMatch {
    var best: RouteEntry[] = [];
    var bestScore: i32[] = [];
    var bestNames: string[] = [];
    var bestValues: string[] = [];
    var bestRest: string[] = [];
    loop (table) { e ->
        if (((e.kind == "P" || e.kind == "R") && e.slot == "")) {
            val a = attempt(e.pattern, pathname);
            if (a.ok) {
                if ((best.length == 0 || scoreBeats(a.score, bestScore))) {
                    best = [e];
                    bestScore = a.score;
                    bestNames = a.names;
                    bestValues = a.values;
                    bestRest = a.rest;
                };
            };
        };
    };
    if (best.length == 0) return null else {
        val entry = best.at(0).unwrapOr(RouteEntry(kind: "", pattern: "", slot: "", verb: ""));
        return RouteMatch(
            entry: entry,
            params: paramsOf(bestNames, bestValues),
            rest: bestRest,
            chain: layoutChain(table, entry.pattern),
        );
    };
}
