//// rakun — decorator bodies (annotation processors, lib-side).
////
//// These are the `#[service]`/`#[getMapping("/x")]`/… markers, implemented as
//// generic comptime decorator functions: each takes the reflected declaration
//// it is applied to as its first parameter (`comptime decl: @Decl`) and the
//// annotation arguments as the trailing ones. The compiler core knows NOTHING
//// about rakun — it only recognises the `@Decl`-first signature, type-checks the
//// trailing arguments against it (arity + types), and runs the body over the
//// annotated declaration. Every rule below lives here, in botopink.
////
//// This file holds the PLACEMENT rules (F3): a component marker must sit on a
//// type with fields (a record-shaped `type`, not an enum), a route marker on a
//// method, `#[value]` on a field. Argument arity /
//// type checking is automatic from the signatures (e.g. `getMapping(path:
//// string)` rejects `#[getMapping()]` and `#[getMapping(1)]`). The DI/router
//// WIRING the same decorators contribute (F2/F4) is layered on through
//// `compiler.compile` (run-time registrations) and `compiler.addMember`.
////
//// Reached via `from "rakun"`; see ./AGENTS.md and ./conformance/docs.md.

import {compiler, compiler.DeclKind} from "std";
import {runtime.rkScan};

// ---- component markers (annotate a record-shaped type) ----
//
// A component is a managed singleton. `#[service]`/`#[repository]`/`#[controller]`
// are Spring's stereotypes — semantically identical to `#[component]` here, kept
// distinct for intent + future per-stereotype behaviour.

// Each component marker contributes the IoC wiring on top of its placement rule.
// In order, the body:
//   1. compiles `rkScan("Name")` into the init list (`compiler.compile`) —
//      self-registration into the scan registry before `main` (F2: the scan
//      discovers every component, no shared comptime state);
//   2. adds the member `Name.make()` (decision 234), the SINGLETON factory that
//      constructs the value once and caches it (`rkSingleton`), injecting each
//      field by type through `rkResolve("<FieldType>")` — the catalogue the
//      application's entry point installs (decisions 254, 256) — except a
//      `#[value("key")]` field, which is filled from config
//      (`rkProp`/`rkPropInt`) and is NOT a DI edge. Construction is bracketed by `rkEnter`/`rkDone` so a dependency cycle
//      raises at first construction;
//   3. enforces placement (must annotate a `type` with fields: `DeclKind.Type` and
//      no `variants`, so an enum-shaped `type` is rejected).
// The outputs run before the placement `fail`, and a failed outcome discards the
// contributions — so only correctly placed types wire up. An executor's names
// resolve here, where it is written (`rkScan` is imported above); the string
// members (`make()`, a controller's `rkRoutes()`, a configuration's `rkBeans()`
// — their code is computed from the fields and methods, so it is text until
// B-140) call `rkSingleton`/`rkEnter`/`rkDone`/`rkResolve`/`rkProp(Int)`/
// `rkRegisterRoute`/`rkRegisterBean`, which are in scope at the application
// site (`import {service, rkSingleton, rkEnter, rkDone, rkResolve, …} from
// "rakun"`).
//
// Decorator-body constraints (see ../AGENTS.md): the body can't call sibling fns
// (each is lowered alone into the eval script), so the per-field injection rule
// and the factory builder are inlined in every component marker rather than shared.

pub fn component(syntax decl: unknown) -> void {
    val declName = compiler.name(decl)!;
    compiler.init({ -> rkScan(declName); });
    var args: Array<string> = [];
    compiler
        .fields(decl)
        .forEach({ f ->
            var valKey = "";
            f.annotations.forEach(
                { a -> if (a.name == "value") valKey = a.args.join("") },
            );
            val expr = if (valKey != "") {
                if (f.typeName == "i32")
                    "rkPropInt(" + valKey + ")"
                else
                    "rkProp(" + valKey + ")";
            } else "rkResolve(" + f.typeName + ", \"" + f.typeName + "\")";
            args.push(f.name + ": " + expr);
        });
    compiler.addMember(
        "pub fn make() -> "
            + compiler.name(decl)!
            + " { return rkSingleton(\""
            + compiler.name(decl)!
            + "\", { -> val _e = rkEnter(\""
            + compiler.name(decl)!
            + "\"); val v = "
            + compiler.name(decl)!
            + "("
            + args.join(", ")
            + "); val _d = rkDone(\""
            + compiler.name(decl)!
            + "\"); v }); }",
    );
    if (compiler.kind(decl) != DeclKind.Type)
        compiler.fail("#[component] must annotate a type", at: decl);
    if (compiler.variants(decl).length > 0)
        compiler.fail("#[component] must annotate a type with fields, not an enum", at: decl);
}

