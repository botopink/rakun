// A controller is a component (scan + singleton factory) that ALSO contributes
// routes: for every method carrying a `#[getMapping(path)]`/… annotation, its
// member `rkRoutes()` calls `rkRegisterRoute(verb, prefix + path, handler)`,
// whose handler builds the controller via its factory and calls the method;
// the executor `decl.rkRoutes()` runs it before `main`. The `#[route("/prefix")]` on
// the type (if any) is the path prefix.

pub fn controller(syntax decl: unknown) -> void {
    val declName = compiler.name(decl)!;
    compiler.init({ -> rkScan(declName); });
    var cargs: Array<string> = [];
    compiler
        .fields(decl)
        .forEach({ f ->
            var valKey = "";
            f.annotations.forEach(
                { a -> if (a.name == "value") valKey = a.args.join("") },
            );
            val expr = if (valKey != "") {
                if (f.typeName == "i32")
                    "rkPropInt(" + valKey + ")"
                else
                    "rkProp(" + valKey + ")";
            } else "rkResolve(" + f.typeName + ", \"" + f.typeName + "\")";
            cargs.push(f.name + ": " + expr);
        });
    compiler.addMember(
        "pub fn make() -> "
            + compiler.name(decl)!
            + " { return rkSingleton(\""
            + compiler.name(decl)!
            + "\", { -> val _e = rkEnter(\""
            + compiler.name(decl)!
            + "\"); val v = "
            + compiler.name(decl)!
            + "("
            + cargs.join(", ")
            + "); val _d = rkDone(\""
            + compiler.name(decl)!
            + "\"); v }); }",
    );
    var prefix = "\"\"";
    compiler
        .annotations(decl)
        .forEach(
            { a -> if (a.name == "route") prefix = a.args.join("") },
        );
    var routes: Array<string> = [];
    compiler
        .methods(decl)
        .forEach({ m ->
            m.annotations.forEach({ a ->
                val verb = if (a.name == "getMapping")
                    "GET"
                else if (a.name == "postMapping")
                    "POST"
                else if (a.name == "putMapping")
                    "PUT"
                else if (a.name == "patchMapping")
                    "PATCH"
                else if (a.name == "deleteMapping")
                    "DELETE"
                else
                    "";
                if (verb != "")
                    routes.push(
                        "rkRegisterRoute(\""
                            + verb
                            + "\", "
                            + prefix
                            + " + "
                            + a.args.join("")
                            + ", { req -> "
                            + compiler.name(decl)!
                            + ".make()."
                            + m.name
                            + "(req) });",
                    );
            });
        });
    if (routes.length > 0) {
        compiler.addMember("pub fn rkRoutes() { " + routes.join(" ") + " }");
        compiler.init({ -> decl.rkRoutes(); });
    }
    if (compiler.kind(decl) != DeclKind.Type)
        compiler.fail("#[controller] must annotate a type", at: decl);
    if (compiler.variants(decl).length > 0)
        compiler.fail(
            "#[controller] must annotate a type with fields, not an enum",
            at: decl,
        );
}

pub fn restController(syntax decl: unknown) -> void {
    val declName = compiler.name(decl)!;
    compiler.init({ -> rkScan(declName); });
    var rargs: Array<string> = [];
    compiler
        .fields(decl)
        .forEach({ f ->
            var valKey = "";
            f.annotations.forEach(
                { a -> if (a.name == "value") valKey = a.args.join("") },
            );
            val expr = if (valKey != "") {
                if (f.typeName == "i32")
                    "rkPropInt(" + valKey + ")"
                else
                    "rkProp(" + valKey + ")";
            } else "rkResolve(" + f.typeName + ", \"" + f.typeName + "\")";
            rargs.push(f.name + ": " + expr);
        });
    compiler.addMember(
        "pub fn make() -> "
            + compiler.name(decl)!
            + " { return rkSingleton(\""
            + compiler.name(decl)!
            + "\", { -> val _e = rkEnter(\""
            + compiler.name(decl)!
            + "\"); val v = "
            + compiler.name(decl)!
            + "("
            + rargs.join(", ")
            + "); val _d = rkDone(\""
            + compiler.name(decl)!
            + "\"); v }); }",
    );
    var rprefix = "\"\"";
    compiler
        .annotations(decl)
        .forEach(
            { a -> if (a.name == "route") rprefix = a.args.join("") },
        );
    var routes: Array<string> = [];
    compiler
        .methods(decl)
        .forEach({ m ->
            m.annotations.forEach({ a ->
                val verb = if (a.name == "getMapping")
                    "GET"
                else if (a.name == "postMapping")
                    "POST"
                else if (a.name == "putMapping")
                    "PUT"
                else if (a.name == "patchMapping")
                    "PATCH"
                else if (a.name == "deleteMapping")
                    "DELETE"
                else
                    "";
                if (verb != "")
                    routes.push(
                        "rkRegisterRoute(\""
                            + verb
                            + "\", "
                            + rprefix
                            + " + "
                            + a.args.join("")
                            + ", { req -> "
                            + compiler.name(decl)!
                            + ".make()."
                            + m.name
                            + "(req) });",
                    );
            });
        });
    if (routes.length > 0) {
        compiler.addMember("pub fn rkRoutes() { " + routes.join(" ") + " }");
        compiler.init({ -> decl.rkRoutes(); });
    }
    if (compiler.kind(decl) != DeclKind.Type)
        compiler.fail("#[restController] must annotate a type", at: decl);
    if (compiler.variants(decl).length > 0)
        compiler.fail(
            "#[restController] must annotate a type with fields, not an enum",
            at: decl,
        );
}

// ---- configuration / factory markers ----

// `#[configuration]` marks a type whose `#[bean]` methods are factories. The
// configuration is itself a stereotype (scan + its `make()` member), and every
// `#[bean]` method registers its RETURN TYPE in the context table with a
// factory that builds the configuration and calls the bean — so the type is
// injectable by type anywhere a component declares a field of it
// (`rkResolve` falls back to the context table; Spring's @Bean). The bean
// output is a singleton too (cached by its return-type name). How a `#[bean]`
// reaches the entry point's catalogue instead is question `130-c`.
pub fn configuration(syntax decl: unknown) -> void {
    val declName = compiler.name(decl)!;
    compiler.init({ -> rkScan(declName); });
    var gargs: Array<string> = [];
    compiler
        .fields(decl)
        .forEach({ f ->
            var valKey = "";
            f.annotations.forEach(
                { a -> if (a.name == "value") valKey = a.args.join("") },
            );
            val expr = if (valKey != "") {
                if (f.typeName == "i32")
                    "rkPropInt(" + valKey + ")"
                else
                    "rkProp(" + valKey + ")";
            } else "rkResolve(" + f.typeName + ", \"" + f.typeName + "\")";
            gargs.push(f.name + ": " + expr);
        });
    compiler.addMember(
        "pub fn make() -> "
            + compiler.name(decl)!
            + " { return rkSingleton(\""
            + compiler.name(decl)!
            + "\", { -> val _e = rkEnter(\""
            + compiler.name(decl)!
            + "\"); val v = "
            + compiler.name(decl)!
            + "("
            + gargs.join(", ")
            + "); val _d = rkDone(\""
            + compiler.name(decl)!
            + "\"); v }); }",
    );
    var beans: Array<string> = [];
    compiler
        .methods(decl)
        .forEach({ m ->
            var isBean = false;
            m.annotations.forEach({ a -> if (a.name == "bean") isBean = true });
            if (isBean)
                beans.push(
                    "rkRegisterBean(\""
                        + m.returnType
                        + "\", \"\", \"singleton\", false, false, \""
                        + compiler.name(decl)!
                        + "\", { -> rkSingleton(\""
                        + m.returnType
                        + "\", { -> "
                        + compiler.name(decl)!
                        + ".make()."
                        + m.name
                        + "() }) });",
                );
        });
    if (beans.length > 0) {
        compiler.addMember("pub fn rkBeans() { " + beans.join(" ") + " }");
        compiler.init({ -> decl.rkBeans(); });
    }
    if (compiler.kind(decl) != DeclKind.Type)
        compiler.fail("#[configuration] must annotate a type", at: decl);
    if (compiler.variants(decl).length > 0)
        compiler.fail(
            "#[configuration] must annotate a type with fields, not an enum",
            at: decl,
        );
}

// `#[bean]` marks a factory method: its return type becomes an injectable singleton.
// The `#[configuration]` body does the wiring (it sees every method); this marker
// just enforces placement.
pub fn bean(syntax decl: unknown) -> void {
    if (compiler.kind(decl) != DeclKind.Method)
        compiler.fail("#[bean] must annotate a method", at: decl);
}

// `#[inject]` marks a field for explicit constructor injection by type.
pub fn inject(syntax decl: unknown) -> void {
    if (compiler.kind(decl) != DeclKind.Field)
        compiler.fail("#[inject] must annotate a field", at: decl);
}

// `#[value("key")]` pulls a config property into a field (Spring's @Value). The
// component factory reads the annotation off the field and fills it from
// `rkProp`/`rkPropInt` instead of the DI graph; this marker enforces placement.
pub fn value(syntax decl: unknown, comptime key: string) -> void {
    if (compiler.kind(decl) != DeclKind.Field)
        compiler.fail("#[value] must annotate a field", at: decl);
}

// ---- web / route markers ----

// `#[route("/prefix")]` sets a controller-level path prefix (Spring @RequestMapping).
pub fn route(syntax decl: unknown, comptime prefix: string) -> void {
    if (compiler.kind(decl) != DeclKind.Type)
        compiler.fail("#[route] must annotate a type (controller)", at: decl);
    if (compiler.variants(decl).length > 0)
        compiler.fail("#[route] must annotate a type with fields, not an enum", at: decl);
}

pub fn getMapping(syntax decl: unknown, comptime path: string) -> void {
    if (compiler.kind(decl) != DeclKind.Method)
        compiler.fail("#[getMapping] must annotate a method", at: decl);
}

pub fn postMapping(syntax decl: unknown, comptime path: string) -> void {
    if (compiler.kind(decl) != DeclKind.Method)
        compiler.fail("#[postMapping] must annotate a method", at: decl);
}

pub fn putMapping(syntax decl: unknown, comptime path: string) -> void {
    if (compiler.kind(decl) != DeclKind.Method)
        compiler.fail("#[putMapping] must annotate a method", at: decl);
}

pub fn patchMapping(syntax decl: unknown, comptime path: string) -> void {
    if (compiler.kind(decl) != DeclKind.Method)
        compiler.fail("#[patchMapping] must annotate a method", at: decl);
}

pub fn deleteMapping(syntax decl: unknown, comptime path: string) -> void {
    if (compiler.kind(decl) != DeclKind.Method)
        compiler.fail("#[deleteMapping] must annotate a method", at: decl);
}
