#[compiler.external(.Erlang("rakun_logging:override_get($0)"))]
pub declare fn rkLogOverride(name: string) -> string;

#[compiler.external(.Erlang("rakun_logging:override_set($0, $1)"))]
pub declare fn rkLogOverrideSet(name: string, level: string) -> i32;

#[compiler.external(.Erlang("rakun_logging:override_clear($0)"))]
pub declare fn rkLogOverrideClear(name: string) -> i32;

#[compiler.external(.Erlang("rakun_logging:override_names()"))]
pub declare fn rkLogOverrideNames() -> string;

#[compiler.external(.Erlang("rakun_logging:override_reset()"))]
pub declare fn rkLogOverrideReset() -> i32;

#[compiler.external(.Erlang("rakun_logging:register_name($0)"))]
pub declare fn rkLogRegisterName(name: string) -> i32;

#[compiler.external(.Erlang("rakun_logging:registered_names()"))]
pub declare fn rkLogRegisteredNames() -> string;

