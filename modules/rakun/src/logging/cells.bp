//// rakun-logging — the host cells over `rakun_logging` (OTP `logger`).
////
//// Every host cell of the member is here and every one is
//// `#[compiler.external(.Erlang(…))]`: the call into `logger:log/3`, the formatter and the
//// capturing handler, the `logger_std_h` console and file handlers, the
//// run-time overrides, the correlation slot, the record facts, the
//// `sys.config` consult and the log-file reads. Nothing here decides anything:
//// levels, groups, schemas and the digest are botopink, in the sibling modules.

import {compiler} from "std";

// ── the record ──────────────────────────────────────────────────────────────

#[compiler.external(.Erlang("rakun_logging:emit($0, $1, $2, $3, $4, $5)"))]
pub declare fn rkLogEmit(
    otpLevel: string,
    rakunLevel: string,
    name: string,
    consoleLine: string,
    fileLine: string,
    trace: string,
) -> i32;

#[compiler.external(.Erlang("rakun_logging:ensure_otp()"))]
pub declare fn rkLogEnsureOtp() -> i32;

// ── facts ───────────────────────────────────────────────────────────────────

#[compiler.external(.Erlang("rakun_logging:fix_facts($0, $1, $2)"))]
pub declare fn rkLogFixFacts(seconds: i32, pid: string, node: string) -> i32;

#[compiler.external(.Erlang("rakun_logging:unfix_facts()"))]
pub declare fn rkLogUnfixFacts() -> i32;

#[compiler.external(.Erlang("rakun_logging:now_ms()"))]
pub declare fn rkLogNowMillis() -> i64;

#[compiler.external(.Erlang("rakun_logging:pid_str()"))]
pub declare fn rkLogPid() -> string;

#[compiler.external(.Erlang("rakun_logging:node_str()"))]
pub declare fn rkLogNode() -> string;

#[compiler.external(.Erlang("rakun_logging:thread_name()"))]
pub declare fn rkLogThread() -> string;

#[compiler.external(.Erlang("rakun_logging:iso($0)"))]
pub declare fn rkLogIso(millis: i64) -> string;

#[compiler.external(.Erlang("rakun_logging:gelf_ts($0)"))]
pub declare fn rkLogGelfTs(millis: i64) -> string;

#[compiler.external(.Erlang("rakun_logging:os_pid()"))]
pub declare fn rkLogOsPid() -> string;

#[compiler.external(.Erlang("rakun_logging:uptime_ms()"))]
pub declare fn rkLogUptimeMillis() -> i64;

