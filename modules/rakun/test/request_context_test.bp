//// rakun — the request context.
////
//// Every assertion here runs on BOTH rows (`botopink test` and
//// `botopink test --target erlang`), from this one file. The front's assigned
//// target is erlang — a request scope is a server thing — but the rule the
//// library has enforced since front 04 is that a host cell carries both forms
//// or it does not exist, and the honest consequence is that the same
//// assertions answer on both rows.
////
//// A raise is asserted with `asserts.throwsWith`, which is the only way to read
//// a `@panic` without the halt taking the test down. The body ends in `0;` for
//// the reason `std/asserts` documents: a closure whose only statement is a
//// `@panic` does not unify with `void`.

import {asserts} from "std";
import {sub} from "config";
import {
    RequestPhase,
    RequestScope,
    phaseName,
    phaseFrom,
    beginRequest,
    endRequest,
    setPhase,
    requestPhase,
    requestId,
    requestEpoch,
    requestPath,
    requestMethod,
    requestQuery,
    requestStrict,
    requestLive,
    checkEpoch,
    noFrameProblem,
    nestedFrameProblem,
    staleEpochProblem,
    afterTimeoutMs,
    headers,
    Headers,
    headerOf,
    headerNames,
    headerLookup,
    headerPresent,
    isDynamic,
    dynamicReason,
    markDynamic,
    strictProblem,
    CookieAttrs,
    Cookies,
    cookies,
    cookieOf,
    cookieDefaults,
    serializeCookie,
    cookieNames,
    cookieLookup,
    cookiePresent,
    percentEncode,
    percentDecode,
    hexByte,
    nonAscii,
    cookieValueProblem,
    cookiePhaseProblem,
    DraftMode,
    draftMode,
    draftBypass,
    draftCookieName,
    draftSecret,
    draftSign,
    draftVerify,
    draftSecretProblem,
    equalsConstantTime,
    connection,
} from "request_context";
import {rkSetProp} from "runtime";

fn scopeOf(id: string, phase: RequestPhase, path: string) -> RequestScope {
    return RequestScope(
        id: id,
        phase: phase,
        method: "GET",
        path: path,
        query: "",
        headersWire: "",
        strict: false,
    );
}

// ── the keep-alive test, first in the file ──────────────────────────────────
//
// This is the bug the whole front is shaped around: a connection process serves
// many requests in sequence, so process identity is not request identity. A
// handle minted in the first request and used in the second has to raise, not
// write a cookie into somebody else's response.

test "rakun request: two requests on one process get different epochs and an old handle raises" {
    val first = beginRequest(scopeOf("r-1", RequestPhase.Handler, "/one"));
    val _e1 = endRequest();
    val second = beginRequest(scopeOf("r-2", RequestPhase.Handler, "/two"));
    assert second > first;
    val _ok = checkEpoch(second, "cookies");
    try asserts.throwsWith({ ->
        checkEpoch(first, "cookies");
        0;
    }, "belongs to a request that has ended");
    val _e2 = endRequest();
}

test "rakun request: beginRequest answers an epoch strictly greater than the previous one" {
    val a = beginRequest(scopeOf("a", RequestPhase.Handler, "/a"));
    val _ea = endRequest();
    val b = beginRequest(scopeOf("b", RequestPhase.Handler, "/b"));
    val _eb = endRequest();
    val c = beginRequest(scopeOf("c", RequestPhase.Handler, "/c"));
    val _ec = endRequest();
    assert b > a;
    assert c > b;
}

test "rakun request: an accessor with no frame raises and names the mechanism" {
    assert requestLive() == false;
    try asserts.throwsWith({ ->
        requestPhase();
        0;
    }, "request context is not established");
    try asserts.throwsWith({ ->
        requestId();
        0;
    }, "request context is not established");
    try asserts.throwsWith({ ->
        requestEpoch();
        0;
    }, "request context is not established");
}

test "rakun request: beginRequest inside a request scope raises, naming the outer path" {
    val _e = beginRequest(scopeOf("outer", RequestPhase.Handler, "/dashboard/settings"));
    try asserts.throwsWith({ ->
        beginRequest(scopeOf("inner", RequestPhase.Handler, "/inner"));
        0;
    }, "/dashboard/settings");
    val _x = endRequest();
}

test "rakun request: endRequest with no frame raises" {
    try asserts.throwsWith({ ->
        endRequest();
        0;
    }, "request context is not established");
}

test "rakun request: the key is erased, not blanked" {
    val _e = beginRequest(scopeOf("erase", RequestPhase.Handler, "/erase"));
    val _x = endRequest();
    assert requestLive() == false;
    try asserts.throwsWith({ ->
        requestEpoch();
        0;
    }, "request context is not established");
}

test "rakun request: the scope's fields read back off the frame" {
    val _e = beginRequest(RequestScope(
        id: "req-77",
        phase: RequestPhase.Handler,
        method: "POST",
        path: "/api/posts",
        query: "page=2",
        headersWire: "accept\ttext/html",
        strict: false,
    ));
    assert requestId() == "req-77";
    assert requestMethod() == "POST";
    assert requestPath() == "/api/posts";
    assert requestQuery() == "page=2";
    assert requestStrict() == false;
    val _x = endRequest();
}

test "rakun request: setPhase is visible to requestPhase in the same process" {
    val _e = beginRequest(scopeOf("phase", RequestPhase.Render, "/p"));
    assert phaseName(requestPhase()) == "render";
    val _s = setPhase(RequestPhase.Action);
    assert phaseName(requestPhase()) == "action";
    val _x = endRequest();
}

test "rakun request: every phase round-trips through its name" {
    assert phaseName(phaseFrom("middleware")) == "middleware";
    assert phaseName(phaseFrom("render")) == "render";
    assert phaseName(phaseFrom("action")) == "action";
    assert phaseName(phaseFrom("handler")) == "handler";
    assert phaseName(phaseFrom("after")) == "after";
    try asserts.throwsWith({ ->
        phaseFrom("whenever");
        0;
    }, "is not a request phase");
}

test "rakun request: a strict frame reads back strict" {
    val _e = beginRequest(RequestScope(
        id: "prerender",
        phase: RequestPhase.Render,
        method: "GET",
        path: "/about",
        query: "",
        headersWire: "",
        strict: true,
    ));
    assert requestStrict() == true;
    val _x = endRequest();
}

test "rakun request: the refusal texts say what they mean" {
    assert noFrameProblem("headers()")
        == "rakun request: request context is not established - headers() is legal only while a request is in flight";
    assert nestedFrameProblem("/one").contains("beginRequest inside a request scope is a dispatcher bug");
    assert staleEpochProblem("cookies").contains("somebody else's response");
}

test "rakun request: the deferred-work budget defaults to thirty seconds" {
    assert afterTimeoutMs() == 30000;
}

// ── step 2: headers() ───────────────────────────────────────────────────────

fn wireOf() -> string {
    return "host\texample.com\nuser-agent\trakun/1\naccept\ttext/html\naccept\tapplication/json";
}

fn headerScope(phase: RequestPhase, strict: bool) -> RequestScope {
    return RequestScope(
        id: "h-1",
        phase: phase,
        method: "GET",
        path: "/api/posts",
        query: "",
        headersWire: wireOf(),
        strict: strict,
    );
}

test "rakun request: a header lookup case-folds its name" {
    val _e = beginRequest(headerScope(RequestPhase.Handler, false));
    val h: Headers = headers();
    val mixed = h.get("User-Agent");
    val lower = h.get("user-agent");
    val upper = h.get("USER-AGENT");
    assert mixed.unwrapOr("") == "rakun/1";
    assert lower.unwrapOr("") == "rakun/1";
    assert upper.unwrapOr("") == "rakun/1";
    val _x = endRequest();
}

test "rakun request: an absent header answers null, not the empty string" {
    val _e = beginRequest(headerScope(RequestPhase.Handler, false));
    val h: Headers = headers();
    val absent = h.get("x-absent");
    try asserts.isNil(absent);
    assert h.has("x-absent") == false;
    assert h.has("host") == true;
    val _x = endRequest();
}

test "rakun request: a header sent twice answers both values joined" {
    val _e = beginRequest(headerScope(RequestPhase.Handler, false));
    val h: Headers = headers();
    val both = h.get("accept");
    assert both.unwrapOr("") == "text/html, application/json";
    val _x = endRequest();
}

test "rakun request: names answers each header once, in wire order" {
    val _e = beginRequest(headerScope(RequestPhase.Handler, false));
    val h: Headers = headers();
    assert h.names().join(",") == "host,user-agent,accept";
    val _x = endRequest();
}

test "rakun request: headerOf reads through the handle with no annotation at the call site" {
    val _e = beginRequest(headerScope(RequestPhase.Handler, false));
    assert headerOf(headers(), "User-Agent", "") == "rakun/1";
    assert headerOf(headers(), "x-absent", "none") == "none";
    val _x = endRequest();
}

test "rakun request: the wire grammar is readable with no frame at all" {
    assert headerLookup("a\t1\nb\t2", "A") == "1";
    assert headerLookup("a\t1\na\t2", "a") == "1, 2";
    assert headerLookup("a\t1", "zz") == "";
    assert headerPresent("a\t1", "A") == true;
    assert headerPresent("a\t1", "b") == false;
    assert headerNames("").join(",") == "";
    assert headerNames("a\t1\n\nb\t2").join(",") == "a,b";
    assert headerLookup("a\t", "a") == "";
    assert headerPresent("a\t", "a") == true;
}

test "rakun request: headers() marks a render dynamic and an action does not" {
    val _e = beginRequest(headerScope(RequestPhase.Render, false));
    assert isDynamic() == false;
    val hr: Headers = headers();
    val _h = hr.get("host");
    assert isDynamic() == true;
    assert dynamicReason() == "headers";
    val _x = endRequest();

    val _e2 = beginRequest(headerScope(RequestPhase.Action, false));
    val ha: Headers = headers();
    val _h2 = ha.get("host");
    assert isDynamic() == false;
    assert dynamicReason() == "";
    val _x2 = endRequest();
}

test "rakun request: headers() in a strict frame raises, naming the function and the route" {
    val _e = beginRequest(headerScope(RequestPhase.Render, true));
    try asserts.throwsWith({ ->
        headers();
        0;
    }, "headers() read the in-flight request while prerendering `/api/posts`");
    val _x = endRequest();
}

test "rakun request: headers() with no frame raises" {
    try asserts.throwsWith({ ->
        headers();
        0;
    }, "request context is not established");
}

test "rakun request: a Headers handle used after endRequest raises" {
    val _e = beginRequest(headerScope(RequestPhase.Handler, false));
    val h: Headers = headers();
    val _x = endRequest();
    try asserts.throwsWith({ ->
        h.get("host");
        0;
    }, "request context is not established");
}

test "rakun request: a Headers handle minted in the previous request raises in the next" {
    val _e = beginRequest(headerScope(RequestPhase.Handler, false));
    val stale: Headers = headers();
    val _x = endRequest();
    val _e2 = beginRequest(headerScope(RequestPhase.Handler, false));
    try asserts.throwsWith({ ->
        stale.get("host");
        0;
    }, "belongs to a request that has ended");
    val _x2 = endRequest();
}


// ── step 3: cookies() ───────────────────────────────────────────────────────

fn cookieScope(phase: RequestPhase, header: string) -> RequestScope {
    return RequestScope(
        id: "c-1",
        phase: phase,
        method: "GET",
        path: "/dashboard",
        query: "",
        headersWire: "host\texample.com\ncookie\t" + header,
        strict: false,
    );
}

test "rakun request: percent encoding round-trips the printable range" {
    assert percentEncode("a b") == "a%20b";
    assert percentEncode("plain-VALUE_1.~") == "plain-VALUE_1.~";
    assert percentEncode("a;b") == "a%3Bb";
    assert percentEncode("a=b") == "a%3Db";
    assert hexByte(32) == "20";
    assert hexByte(255) == "FF";
    assert percentDecode("a%20b") == "a b";
    assert percentDecode(percentEncode("a b;c=d")) == "a b;c=d";
    assert percentDecode("%zz") == "%zz";
    assert percentDecode("100%") == "100%";
    assert percentDecode("%0A") == "%0A";
}

test "rakun request: serializeCookie writes the literal that goes on the wire" {
    assert serializeCookie("s", "a b", cookieDefaults())
        == "s=a%20b; Path=/; Max-Age=0; HttpOnly; Secure; SameSite=Lax";
}

test "rakun request: serializeCookie carries every attribute it is given" {
    val attrs = CookieAttrs(
        path: "/admin",
        domain: "example.com",
        maxAge: 3600,
        httpOnly: false,
        secure: true,
        sameSite: "Strict",
    );
    assert serializeCookie("session", "abc", attrs)
        == "session=abc; Path=/admin; Domain=example.com; Max-Age=3600; Secure; SameSite=Strict";
}

// The POSITIVE case cannot be written on both rows: a non-ASCII string LITERAL
// makes `String.length()` raise `{badarg, <<...>>}` on the erlang row before
// any of this front's code runs, so a cell asserting it reddens erlang whatever
// else it says. The guard, its refusal text and the negative case are asserted
// here; the shape is listed in `AGENTS.md`.
test "rakun request: a non-ASCII cookie value is refused, not guessed at" {
    assert nonAscii("plain") == false;
    assert nonAscii("a b;c=d") == false;
    assert cookieValueProblem("theme").contains("outside printable ASCII");
    assert cookieValueProblem("theme").contains("encode the value yourself");
}

test "rakun request: a cookie value cannot carry a newline" {
    val line: string = serializeCookie("s", "a\nb", cookieDefaults());
    assert line.contains("\n") == false;
    assert line.startsWith("s=a%0Ab; ") == true;
}

test "rakun request: the cookie header parses without inventing entries" {
    assert cookieNames("theme=dark; sid=abc").join(",") == "theme,sid";
    assert cookieNames("theme=dark;").join(",") == "theme";
    assert cookieNames("  theme = dark ; sid = abc ").join(",") == "theme,sid";
    assert cookieNames("novalue; theme=dark").join(",") == "theme";
    assert cookieNames("=orphan; theme=dark").join(",") == "theme";
    assert cookieNames("").join(",") == "";
    assert cookieLookup("theme=dark; sid=abc", "sid") == "abc";
    assert cookieLookup("theme=dark; theme=light", "theme") == "dark";
    assert cookieLookup("theme=dark", "missing") == "";
    assert cookiePresent("theme=dark", "theme") == true;
    assert cookiePresent("theme=dark", "Theme") == false;
}

test "rakun request: a cookie value is read back percent-decoded" {
    val _e = beginRequest(cookieScope(RequestPhase.Handler, "theme=a%20b; sid=abc"));
    val c: Cookies = cookies();
    val theme = c.get("theme");
    assert theme.unwrapOr("") == "a b";
    assert cookieOf(cookies(), "sid", "") == "abc";
    assert c.has("sid") == true;
    assert c.has("nope") == false;
    val absent = c.get("nope");
    try asserts.isNil(absent);
    assert c.names().join(",") == "theme,sid";
    val _x = endRequest();
}

test "rakun request: a cookie set in phase Render raises" {
    val _e = beginRequest(cookieScope(RequestPhase.Render, "theme=dark"));
    val c: Cookies = cookies();
    try asserts.throwsWith({ ->
        c.set("theme", "light", cookieDefaults());
        0;
    }, "a cookie may be set from a server action, a route handler or middleware");
    try asserts.throwsWith({ ->
        c.delete("theme");
        0;
    }, "a cookie may be set from a server action, a route handler or middleware");
    val _x = endRequest();
}

test "rakun request: two names queue two lines and one name queues the later value" {
    val _e = beginRequest(cookieScope(RequestPhase.Action, ""));
    val c: Cookies = cookies();
    val _a = c.set("theme", "dark", cookieDefaults());
    val _b = c.set("sid", "one", cookieDefaults());
    val _d = c.set("theme", "light", cookieDefaults());
    val blob: string = endRequest();
    val lines: string[] = blob.split("\n");
    assert lines.length() == 2;
    assert lines.at(0).unwrapOr("") == "theme=light; Path=/; Max-Age=0; HttpOnly; Secure; SameSite=Lax";
    assert lines.at(1).unwrapOr("") == "sid=one; Path=/; Max-Age=0; HttpOnly; Secure; SameSite=Lax";
}

test "rakun request: delete queues an empty value with Max-Age=0" {
    val _e = beginRequest(cookieScope(RequestPhase.Handler, "session=abc"));
    val c: Cookies = cookies();
    val _d = c.delete("session");
    val blob: string = endRequest();
    assert blob == "session=; Path=/; Max-Age=0; HttpOnly; Secure; SameSite=Lax";
}

test "rakun request: a request that queues nothing answers an empty blob" {
    val _e = beginRequest(cookieScope(RequestPhase.Handler, ""));
    assert endRequest() == "";
}

test "rakun request: a Cookies handle used after endRequest raises rather than writing" {
    val _e = beginRequest(cookieScope(RequestPhase.Handler, ""));
    val c: Cookies = cookies();
    val _x = endRequest();
    try asserts.throwsWith({ ->
        c.set("theme", "dark", cookieDefaults());
        0;
    }, "request context is not established");
}

test "rakun request: a Cookies handle minted in the previous request raises in the next" {
    val _e = beginRequest(cookieScope(RequestPhase.Handler, ""));
    val stale: Cookies = cookies();
    val _x = endRequest();
    val _e2 = beginRequest(cookieScope(RequestPhase.Handler, ""));
    try asserts.throwsWith({ ->
        stale.set("theme", "dark", cookieDefaults());
        0;
    }, "belongs to a request that has ended");
    val blob: string = endRequest();
    assert blob == "";
}

test "rakun request: cookies() marks a render dynamic" {
    val _e = beginRequest(cookieScope(RequestPhase.Render, "theme=dark"));
    val c: Cookies = cookies();
    assert isDynamic() == true;
    assert dynamicReason() == "cookies";
    val _x = endRequest();
}

test "rakun request: the cookie refusal texts say what they mean" {
    assert cookieValueProblem("sid").contains("encode the value yourself");
    assert cookiePhaseProblem("render").contains("never from a render");
}


// ── step 4: draftMode() and connection() ────────────────────────────────────

fn draftScope(phase: RequestPhase, cookieHeader: string) -> RequestScope {
    return RequestScope(
        id: "d-1",
        phase: phase,
        method: "GET",
        path: "/blog/draft",
        query: "",
        headersWire: "cookie\t" + cookieHeader,
        strict: false,
    );
}

fn signedDraftCookie(secret: string, token: string) -> string {
    return draftCookieName() + "=" + token + "." + draftSign(secret, token);
}

test "rakun request: a constant-time comparison answers the ordinary question" {
    assert equalsConstantTime("abc", "abc") == true;
    assert equalsConstantTime("abc", "abd") == false;
    assert equalsConstantTime("abc", "ab") == false;
    assert equalsConstantTime("", "") == true;
    assert equalsConstantTime("a", "") == false;
}

test "rakun request: draft mode is off with no cookie and off for a forged one" {
    val _s = rkSetProp("rakun.draft.secret", "top-secret");
    val _e = beginRequest(draftScope(RequestPhase.Handler, ""));
    val d: DraftMode = draftMode();
    assert d.isEnabled() == false;
    val _x = endRequest();

    val _e2 = beginRequest(draftScope(RequestPhase.Handler, draftCookieName() + "=tok.deadbeef"));
    val forged: DraftMode = draftMode();
    assert forged.isEnabled() == false;
    val _x2 = endRequest();
}

test "rakun request: draft mode is on only for a cookie this server issued" {
    val _s = rkSetProp("rakun.draft.secret", "top-secret");
    val _e = beginRequest(draftScope(RequestPhase.Handler, signedDraftCookie("top-secret", "abc123")));
    val d: DraftMode = draftMode();
    assert d.isEnabled() == true;
    val _x = endRequest();

    val _e2 = beginRequest(draftScope(RequestPhase.Handler, signedDraftCookie("another-secret", "abc123")));
    val other: DraftMode = draftMode();
    assert other.isEnabled() == false;
    val _x2 = endRequest();
}

test "rakun request: a truncated draft signature answers false and does not raise" {
    val _s = rkSetProp("rakun.draft.secret", "top-secret");
    val full: string = draftSign("top-secret", "abc123");
    val short: string = sub(full, 0, full.length() - 1);
    val _e = beginRequest(draftScope(RequestPhase.Handler, draftCookieName() + "=abc123." + short));
    val d: DraftMode = draftMode();
    assert d.isEnabled() == false;
    val _x = endRequest();

    assert draftVerify("top-secret", "abc123.") == false;
    assert draftVerify("top-secret", "abc123") == false;
    assert draftVerify("top-secret", ".abc") == false;
    assert draftVerify("", "abc123." + full) == false;
}

test "rakun request: enable with no secret raises, naming the property" {
    val _s = rkSetProp("rakun.draft.secret", "");
    val _e = beginRequest(draftScope(RequestPhase.Action, ""));
    val d: DraftMode = draftMode();
    try asserts.throwsWith({ ->
        d.enable();
        0;
    }, "rakun.draft.secret");
    assert draftSecret() == "";
    val _x = endRequest();
}

test "rakun request: enable queues a signed cookie, marks dynamic and sets the bypass" {
    val _s = rkSetProp("rakun.draft.secret", "top-secret");
    val _e = beginRequest(draftScope(RequestPhase.Action, ""));
    val d: DraftMode = draftMode();
    val _n = d.enable();
    assert isDynamic() == true;
    assert dynamicReason() == "draftMode";
    assert draftBypass() == true;
    val blob: string = endRequest();
    assert blob.startsWith(draftCookieName() + "=") == true;
    assert blob.contains("; HttpOnly") == true;
    assert blob.contains("; Secure") == true;
    assert blob.contains("; SameSite=Lax") == true;
    assert blob.contains("; Max-Age=86400") == true;
}

test "rakun request: the cookie enable issues verifies on the next request" {
    val _s = rkSetProp("rakun.draft.secret", "top-secret");
    val _e = beginRequest(draftScope(RequestPhase.Action, ""));
    val d: DraftMode = draftMode();
    val _n = d.enable();
    val blob: string = endRequest();
    val head: string = sub(blob, 0, blob.indexOf(";"));
    val _e2 = beginRequest(draftScope(RequestPhase.Handler, head));
    val next: DraftMode = draftMode();
    assert next.isEnabled() == true;
    val _x2 = endRequest();
}

test "rakun request: disable queues the deleting cookie and clears the bypass" {
    val _s = rkSetProp("rakun.draft.secret", "top-secret");
    val _e = beginRequest(draftScope(RequestPhase.Action, signedDraftCookie("top-secret", "abc123")));
    val d: DraftMode = draftMode();
    val _n = d.disable();
    assert draftBypass() == false;
    val blob: string = endRequest();
    assert blob == draftCookieName() + "=; Path=/; Max-Age=0; HttpOnly; Secure; SameSite=Lax";
}

test "rakun request: connection() marks and reads nothing" {
    val _e = beginRequest(draftScope(RequestPhase.Render, ""));
    assert isDynamic() == false;
    val _c = connection();
    assert isDynamic() == true;
    assert dynamicReason() == "connection";
    val _x = endRequest();
}

test "rakun request: dynamicReason names the first function to mark, not the last" {
    val _e = beginRequest(draftScope(RequestPhase.Render, ""));
    val _c = connection();
    val h: Headers = headers();
    val _g = h.get("cookie");
    val jar: Cookies = cookies();
    assert dynamicReason() == "connection";
    val _x = endRequest();
}

test "rakun request: a render that touched none of them is not dynamic" {
    val _e = beginRequest(draftScope(RequestPhase.Render, ""));
    assert isDynamic() == false;
    assert dynamicReason() == "";
    val _x = endRequest();
}

test "rakun request: connection() in a strict frame raises" {
    val _e = beginRequest(RequestScope(
        id: "strict",
        phase: RequestPhase.Render,
        method: "GET",
        path: "/about",
        query: "",
        headersWire: "",
        strict: true,
    ));
    try asserts.throwsWith({ ->
        connection();
        0;
    }, "while prerendering `/about`");
    val _x = endRequest();
}

test "rakun request: the draft refusal text names the property" {
    assert draftSecretProblem().contains("rakun.draft.secret");
    assert draftSecretProblem().contains("unsigned bypass");
}
