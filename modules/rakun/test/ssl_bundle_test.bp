//// rakun — the SSL bundle registry: the property grammar, the refusals, the
//// two option lists, reload and the `ssl` health and info contributions.
////
//// Every assertion runs on BOTH rows. `botopink test` compiles every test file
//// on both targets with no per-target gate, which is why every host cell this
//// file drives carries an `#[@External.Node]` form beside its
//// `#[@External.Erlang]` one — see `src/ssl_bundle.bp`'s header for the
//// measurement that forces it.
////
//// THE CERTIFICATE THIS FILE PARSES IS DELIBERATELY EXPIRED, AND THAT IS WHY IT
//// CAN BE COMMITTED. The spec refuses a committed fixture because "a committed
//// certificate expires and turns a whole front red on a date nobody chose". A
//// certificate whose validity window CLOSED in April 2020 has no such date: its
//// subject, issuer, notBefore and notAfter are constants, and `daysRemaining` is
//// negative today and more negative tomorrow. Nothing below asserts a positive
//// number of days from it. The spec's alternative — `rakun_ssl:selftest_material/1`
//// generating a CA and two certificates through `public_key` at setup — is
//// erlang-only (node has no X.509 issuance API at all), so it would move every
//// assertion here off the commonJS row, which is the row `modules/rakun` is
//// pinned on. The material is written to a scratch directory by the cells that
//// need a file on disk and removed again.
////
//// A refusal text carries NO double quote: on the erlang row `throwsWith` reads
//// the `~p` rendering, in which a `"` is escaped, and one needle cannot then
//// match both rows. Front 07 measured it.

// NOT `process`: a test file that imports `std`'s `process` shadows node's
// global `process` in the emitted harness, whose own `__bp_run_tests` reads
// `process.argv[2]`. The module dies before any cell runs; the run EXITS 1, so
// a gate catches it, but the file contributes no `N passed, M failed` line at
// all — the cells are short from the count and nothing says so. Measured
// against `2e6bb4ac` and again against `4fe1747e`; see `AGENTS.md` § Language
// notes. `absolutePath` is asserted through its own shape instead.
import {asserts, fs} from "std";
import {rkSetProp, rkProp, toI32};
import {
    SslBundle,
    blobPut,
    blobGet,
    blobKeys,
    bundlePrefix,
    bundleKey,
    defaultProtocols,
    defaultClientAuth,
    defaultVerify,
    handshakeTimeout,
    reloadInterval,
    warnThresholdDays,
    sslBundleNames,
    bundleConfigured,
    readBundle,
    bundlePassword,
    bundleReloadOnUpdate,
    hasKeystore,
    hasTrustStore,
    halfKeystoreProblem,
    missingFileProblem,
    jksProblem,
    clientAuthProblem,
    verifyProblem,
    protocolProblem,
    separatorProblem,
    unknownBundleProblem,
    keyMismatchProblem,
    verifyNoneWarning,
    absolutePath,
    isJks,
    carriesSeparator,
    knownProtocol,
    protocolsValid,
    checkFile,
    bundleProblem,
    fileProblem,
    validateBundle,
    sslBundle,
    verifyForListener,
    failIfNoPeerCert,
    verifyForClient,
    versionsOf,
    listenerBlob,
    clientBlob,
    transportFor,
    sslTransport,
    sslReset,
    sslRegisteredNames,
    mtimeOf,
    materialStamp,
    sslRegister,
    sslRegisterAll,
    sslFailures,
    sslWarnings,
    sslBoot,
    sslReload,
    sslPoll,
    sslExpiryDays,
    sslSubject,
    sslIssuer,
    sslNotBefore,
    sslNotAfter,
    sslLastError,
    sslListenerOpts,
    sslClientOpts,
    statusUp,
    statusOutOfService,
    statusDown,
    sslHealthOf,
    sslHealth,
    sslInfo,
    registerSslKeys,
    rkSslCertInfo,
    rkSslKeyMatches,
    rkSslGet,
};

// ── the material ────────────────────────────────────────────────────────────
//
// A self-signed RSA certificate with the window 2020-01-01 to 2020-04-01 and the
// key that belongs to it, plus a second key that does not. Written to disk by
// the cells that need a path and read back through `std/fs`, which is the same
// path front 05's document readers take.

