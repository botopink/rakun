// A real regular file every cell that needs "a path that exists" can point at.
// NOT `/dev/null`: it is a character device, and `std`'s `fs.exists` is
// `existsSync` on node (true) and `filelib:is_file/1` on the BEAM (false), so a
// device node is the one path shape the two rows disagree about.
fn anchorFile() -> string {
    val p = scratch("anchor.pem");
    val _w = writeFile(p, certPem());
    return p;
}

fn scratch(leaf: string) -> string {
    return ".botopinkbuild/tmp/ssl-bundle-test-" + leaf;
}

fn writeFile(p: string, body: string) -> i32 {
    val _d1 = try fs.mkdir(".botopinkbuild") catch 0;
    val _d2 = try fs.mkdir(".botopinkbuild/tmp") catch 0;
    return try fs.writeText(p, body) catch 0;
}

fn removeFile(p: string) -> i32 {
    return try fs.rm(p) catch 0;
}

// ── fixtures ────────────────────────────────────────────────────────────────

fn clearBundle(name: string) -> i32 {
    val _a = rkSetProp(bundleKey(name, "keystore.certificate"), "");
    val _b = rkSetProp(bundleKey(name, "keystore.private-key"), "");
    val _c = rkSetProp(bundleKey(name, "keystore.private-key-password"), "");
    val _d = rkSetProp(bundleKey(name, "truststore.certificate"), "");
    val _e = rkSetProp(bundleKey(name, "protocols"), "");
    val _f = rkSetProp(bundleKey(name, "ciphers"), "");
    val _g = rkSetProp(bundleKey(name, "client-auth"), "");
    val _h = rkSetProp(bundleKey(name, "verify"), "");
    val _i = rkSetProp(bundleKey(name, "reload-on-update"), "");
    return 0;
}

fn declareBundles(names: string) -> i32 {
    return rkSetProp(bundlePrefix(), names);
}

fn freshRegistry() -> i32 {
    val _r = sslReset();
    val _n = declareBundles("");
    val _a = clearBundle("one");
    val _b = clearBundle("two");
    val _c = clearBundle("only-trust");
    val _d = clearBundle("mtls");
    val _e = clearBundle("lax");
    val _f = clearBundle("rotating");
    val _t = rkSetProp("rakun.ssl.handshake-timeout", "");
    val _i = rkSetProp("rakun.ssl.reload-interval", "");
    val _w = rkSetProp("rakun.ssl.health.warn-threshold", "");
    return 0;
}

fn materialOn(name: string, certPath: string, keyPath: string) -> i32 {
    val _c = rkSetProp(bundleKey(name, "keystore.certificate"), certPath);
    val _k = rkSetProp(bundleKey(name, "keystore.private-key"), keyPath);
    return 0;
}

fn sample(name: string) -> SslBundle {
    return SslBundle(
        name: name,
        certificateFile: "/etc/rakun/cert.pem",
        privateKeyFile: "/etc/rakun/key.pem",
        trustStoreFile: "",
        protocols: defaultProtocols(),
        ciphers: "",
        clientAuth: defaultClientAuth(),
        verify: defaultVerify(),
    );
}

// ── the blob ────────────────────────────────────────────────────────────────

test "rakun ssl: the blob is key bar value, records separated by semicolons" {
    var b = "";
    b = blobPut(b, "certfile", "/a.pem");
    b = blobPut(b, "verify", "verify_peer");
    assert b == "certfile|/a.pem;verify|verify_peer";
    assert blobGet(b, "certfile") == "/a.pem";
    assert blobGet(b, "verify") == "verify_peer";
    assert blobGet(b, "absent") == "";
    assert blobKeys(b).join(",") == "certfile,verify";
    assert blobKeys("").length == 0;
}

test "rakun ssl: a blob value may itself be empty and still be found" {
    val b = blobPut("", "ciphers", "");
    assert b == "ciphers|";
    assert blobGet(b, "ciphers") == "";
    assert blobKeys(b).join(",") == "ciphers";
}

// ── the property grammar ────────────────────────────────────────────────────

test "rakun ssl: the property names are Spring's with rakun in place of spring" {
    assert bundlePrefix() == "rakun.ssl.bundle.pem";
    assert bundleKey("mybundle", "keystore.certificate")
        == "rakun.ssl.bundle.pem.mybundle.keystore.certificate";
    assert bundleKey("mybundle", "client-auth")
        == "rakun.ssl.bundle.pem.mybundle.client-auth";
}

test "rakun ssl: the declared defaults are both TLS versions, none and full" {
    val _f = freshRegistry();
    assert defaultProtocols() == "tlsv1.3,tlsv1.2";
    assert defaultClientAuth() == "none";
    assert defaultVerify() == "full";
    assert handshakeTimeout() == 5000;
    assert reloadInterval() == 60000;
    assert warnThresholdDays() == 14;
}

test "rakun ssl: the three tuning keys are read from configuration when set" {
    val _f = freshRegistry();
    val _a = rkSetProp("rakun.ssl.handshake-timeout", "200");
    val _b = rkSetProp("rakun.ssl.reload-interval", "1000");
    val _c = rkSetProp("rakun.ssl.health.warn-threshold", "30");
    assert handshakeTimeout() == 200;
    assert reloadInterval() == 1000;
    assert warnThresholdDays() == 30;
    val _r = freshRegistry();
}

test "rakun ssl: a bundle reads every property and falls back per field" {
    val _f = freshRegistry();
    val _n = declareBundles("one");
    val _c = rkSetProp(bundleKey("one", "keystore.certificate"), "/a/cert.pem");
    val _k = rkSetProp(bundleKey("one", "keystore.private-key"), "/a/key.pem");
    val _p = rkSetProp(bundleKey("one", "keystore.private-key-password"), "hunter2");
    val _t = rkSetProp(bundleKey("one", "truststore.certificate"), "/a/ca.pem");
    val b = readBundle("one");
    assert b.name == "one";
    assert b.certificateFile == "/a/cert.pem";
    assert b.privateKeyFile == "/a/key.pem";
    assert b.trustStoreFile == "/a/ca.pem";
    assert b.protocols == "tlsv1.3,tlsv1.2";
    assert b.ciphers == "";
    assert b.clientAuth == "none";
    assert b.verify == "full";
    // The password and the reload flag are deliberately NOT fields of the
    // record: the spec pins it at eight, and a password on the record would mean
    // a password in every rendering of it.
    assert bundlePassword("one") == "hunter2";
    assert bundleReloadOnUpdate("one") == false;
    assert hasKeystore(b);
    assert hasTrustStore(b);
}

test "rakun ssl: the bundle names are read in property order" {
    val _f = freshRegistry();
    assert sslBundleNames().length == 0;
    val _n = declareBundles("zeta,alpha,mid");
    assert sslBundleNames().join(",") == "zeta,alpha,mid";
    assert bundleConfigured("alpha");
    assert bundleConfigured("absent") == false;
}

test "rakun ssl: a name nobody configured is the empty optional, not an empty bundle" {
    val _f = freshRegistry();
    val _n = declareBundles("one");
    val _c = rkSetProp(bundleKey("one", "truststore.certificate"), anchorFile());
    var seen = "";
    val present = sslBundle("one");
    if (present) { b -> seen = b.name; };
    assert seen == "one";

    var absentSeen = false;
    val absent = sslBundle("nothing-by-this-name");
    if (absent) { b -> absentSeen = true; };
    assert absentSeen == false;
}

// ── the refusals ────────────────────────────────────────────────────────────

test "rakun ssl: half a keystore is refused, naming the half that is missing" {
    val _f = freshRegistry();
    try asserts.throwsWith({ ->
        validateBundle(SslBundle(
            name: "one",
            certificateFile: "/a/cert.pem",
            privateKeyFile: "",
            trustStoreFile: "",
            protocols: defaultProtocols(),
            ciphers: "",
            clientAuth: "none",
            verify: "full",
        ));
        0;
    }, "rakun.ssl.bundle.pem.one.keystore.private-key");
    try asserts.throwsWith({ ->
        validateBundle(SslBundle(
            name: "one",
            certificateFile: "",
            privateKeyFile: "/a/key.pem",
            trustStoreFile: "",
            protocols: defaultProtocols(),
            ciphers: "",
            clientAuth: "none",
            verify: "full",
        ));
        0;
    }, "rakun.ssl.bundle.pem.one.keystore.certificate");
    // Neither half is a verify-only bundle, and that is legal.
    assert validateBundle(SslBundle(
        name: "only-trust",
        certificateFile: "",
        privateKeyFile: "",
        trustStoreFile: anchorFile(),
        protocols: defaultProtocols(),
        ciphers: "",
        clientAuth: "none",
        verify: "full",
    )) == 0;
}

test "rakun ssl: a file that is not there is refused, naming the absolute path searched" {
    val _f = freshRegistry();
    val text: string = missingFileProblem("one", "keystore.certificate", "certs/server.pem");
    assert text.contains("rakun.ssl.bundle.pem.one.keystore.certificate");
    assert text.contains("certs/server.pem");
    assert text.contains(absolutePath("certs/server.pem"));
    assert absolutePath("/already/absolute") == "/already/absolute";
    // A relative path is resolved against the working directory, so the answer
    // is absolute and still ends in what was asked for.
    val resolved: string = absolutePath("relative/x.pem");
    assert resolved.endsWith("relative/x.pem");
    assert resolved != "relative/x.pem";
    // Idempotent: resolving an already-resolved path changes nothing. That is
    // what `path.isAbsolute` buys, and it holds on a drive letter as well as on
    // a leading slash — so the `windows-2022` commonJS row, which is
    // `allow_fail: false`, reads this the same way ubuntu does. The obvious
    // assertion here is that `resolved` starts with `process.cwd()`, and it is
    // unavailable: a TEST file that imports `std`'s `process` loses every cell
    // in it on the commonJS row (see the header of this file). Idempotence is
    // the same property without the import.
    assert absolutePath(resolved) == resolved;
    try asserts.throwsWith({ ->
        checkFile("one", "keystore.certificate", "certs/definitely-not-here.pem");
    }, "and nothing is there");
}

test "rakun ssl: a JKS is refused with the keytool command, and no property lifts it" {
    val _f = freshRegistry();
    assert isJks("/etc/app/keystore.jks");
    assert isJks("/etc/app/KEYSTORE.JKS");
    assert isJks("/etc/app/server.keystore");
    assert isJks("/etc/app/cert.pem") == false;
    val text: string = jksProblem("one", "keystore.certificate", "/etc/app/keystore.jks");
    assert text.contains("keytool -importkeystore");
    assert text.contains("-deststoretype PKCS12");
    assert text.contains("there is no property that lifts this");
    try asserts.throwsWith({ ->
        checkFile("one", "keystore.certificate", "/etc/app/keystore.jks");
    }, "keytool -importkeystore");
}

test "rakun ssl: a path carrying a blob separator is refused rather than truncated" {
    val _f = freshRegistry();
    assert carriesSeparator("/a/b;c.pem");
    assert carriesSeparator("/a/b|c.pem");
    assert carriesSeparator("/a/b.pem") == false;
    assert separatorProblem("one", "keystore.certificate", "/a/b;c.pem").contains("Move the file");
    try asserts.throwsWith({ ->
        checkFile("one", "keystore.certificate", "/a/b|c.pem");
    }, "cannot be encoded");
}

test "rakun ssl: the three server postures and the two client postures, and nothing else" {
    val _f = freshRegistry();
    loop (["none", "want", "need"]) { posture ->
        val p: string = posture;
        assert validateBundle(SslBundle(
            name: "one", certificateFile: "", privateKeyFile: "", trustStoreFile: "",
            protocols: defaultProtocols(), ciphers: "", clientAuth: p, verify: "full",
        )) == 0;
    };
    try asserts.throwsWith({ ->
        validateBundle(SslBundle(
            name: "one", certificateFile: "", privateKeyFile: "", trustStoreFile: "",
            protocols: defaultProtocols(), ciphers: "", clientAuth: "maybe", verify: "full",
        ));
        0;
    }, "none, want and need");
    try asserts.throwsWith({ ->
        validateBundle(SslBundle(
            name: "one", certificateFile: "", privateKeyFile: "", trustStoreFile: "",
            protocols: defaultProtocols(), ciphers: "", clientAuth: "none", verify: "partial",
        ));
        0;
    }, "full and none");
    assert clientAuthProblem("one", "maybe").contains("maybe");
    assert verifyProblem("one", "partial").contains("partial");
}

test "rakun ssl: TLS 1.1 and below are gone, not a property away" {
    val _f = freshRegistry();
    assert knownProtocol("tlsv1.3");
    assert knownProtocol("tlsv1.2");
    assert knownProtocol("tlsv1.1") == false;
    assert knownProtocol("sslv3") == false;
    assert protocolsValid("tlsv1.3,tlsv1.2");
    assert protocolsValid(" tlsv1.2 ");
    assert protocolsValid("tlsv1.3,tlsv1.1") == false;
    assert protocolsValid("") == false;
    assert protocolProblem("one", "tlsv1.1").contains("they are gone");
    try asserts.throwsWith({ ->
        validateBundle(SslBundle(
            name: "one", certificateFile: "", privateKeyFile: "", trustStoreFile: "",
            protocols: "sslv3", ciphers: "", clientAuth: "none", verify: "full",
        ));
        0;
    }, "tlsv1.3 and tlsv1.2");
}

test "rakun ssl: a listener naming a bundle that is not configured is a refusal, not plaintext" {
    val text: string = unknownBundleProblem("rakun.server.ssl.bundle", "ghost");
    assert text.contains("rakun.server.ssl.bundle names the bundle ghost");
    assert text.contains("does not fall back to plaintext");
}

test "rakun ssl: every refusal text is free of double quotes" {
    // The needle a `throwsWith` matches is read from the `~p` rendering on the
    // erlang row, where a `"` is escaped. One quote anywhere below would make a
    // refusal unassertable on one of the two rows; this cell is the guard.
    val texts: string[] = [
        halfKeystoreProblem("a", "keystore.certificate", "keystore.private-key"),
        missingFileProblem("a", "keystore.certificate", "/x.pem"),
        jksProblem("a", "keystore.certificate", "/x.jks"),
        clientAuthProblem("a", "maybe"),
        verifyProblem("a", "partial"),
        protocolProblem("a", "sslv3"),
        separatorProblem("a", "keystore.certificate", "/x;y.pem"),
        unknownBundleProblem("rakun.server.ssl.bundle", "a"),
        keyMismatchProblem("a"),
        verifyNoneWarning("a"),
    ];
    loop (texts) { t ->
        val text: string = t;
        assert text.contains("\"") == false;
    };
    assert texts.length == 10;
}

// ── the two option lists ────────────────────────────────────────────────────

test "rakun ssl: client-auth maps to verify plus fail-if-no-peer-cert, and verify does not" {
    assert verifyForListener(sample("one")) == "verify_none";
    assert failIfNoPeerCert(sample("one")) == false;

    val want = SslBundle(
        name: "one", certificateFile: "/c.pem", privateKeyFile: "/k.pem",
        trustStoreFile: "/ca.pem", protocols: defaultProtocols(), ciphers: "",
        clientAuth: "want", verify: "full",
    );
    assert verifyForListener(want) == "verify_peer";
    assert failIfNoPeerCert(want) == false;

    val need = SslBundle(
        name: "one", certificateFile: "/c.pem", privateKeyFile: "/k.pem",
        trustStoreFile: "/ca.pem", protocols: defaultProtocols(), ciphers: "",
        clientAuth: "need", verify: "full",
    );
    assert verifyForListener(need) == "verify_peer";
    assert failIfNoPeerCert(need);

    // `verify` is the CLIENT's question and never touches the listener's answer.
    val lax = SslBundle(
        name: "one", certificateFile: "/c.pem", privateKeyFile: "/k.pem",
        trustStoreFile: "", protocols: defaultProtocols(), ciphers: "",
        clientAuth: "need", verify: "none",
    );
    assert verifyForListener(lax) == "verify_peer";
    assert verifyForClient(lax) == "verify_none";
    assert verifyForClient(need) == "verify_peer";
}

test "rakun ssl: the listener option list carries the material, the versions and the posture" {
    val _f = freshRegistry();
    val b = SslBundle(
        name: "one", certificateFile: "/c.pem", privateKeyFile: "/k.pem",
        trustStoreFile: "/ca.pem", protocols: "tlsv1.3, tlsv1.2", ciphers: "",
        clientAuth: "need", verify: "full",
    );
    assert versionsOf(b) == "tlsv1.3,tlsv1.2";
    val blob: string = listenerBlob(b);
    assert blobGet(blob, "bundle") == "one";
    assert blobGet(blob, "certfile") == "/c.pem";
    assert blobGet(blob, "keyfile") == "/k.pem";
    assert blobGet(blob, "cacertfile") == "/ca.pem";
    assert blobGet(blob, "versions") == "tlsv1.3,tlsv1.2";
    assert blobGet(blob, "verify") == "verify_peer";
    assert blobGet(blob, "fail_if_no_peer_cert") == "true";
    assert blobGet(blob, "handshake_timeout") == "5000";
    // An empty cipher list means the host's default and is left OUT rather than
    // encoded as empty: an empty `ciphers` option to OTP is not the default, it
    // is a listener that negotiates nothing.
    assert blobKeys(blob).indexOf("ciphers") < 0;
}

test "rakun ssl: a named cipher list and a key password reach the option list" {
    val _f = freshRegistry();
    val _n = declareBundles("one");
    val _p = rkSetProp(bundleKey("one", "keystore.private-key-password"), "hunter2");
    val b = SslBundle(
        name: "one", certificateFile: "/c.pem", privateKeyFile: "/k.pem",
        trustStoreFile: "", protocols: "tlsv1.2", ciphers: "ECDHE-RSA-AES128-GCM-SHA256",
        clientAuth: "none", verify: "full",
    );
    val blob: string = listenerBlob(b);
    assert blobGet(blob, "ciphers") == "ECDHE-RSA-AES128-GCM-SHA256";
    assert blobGet(blob, "password") == "hunter2";
    assert blobGet(blob, "versions") == "tlsv1.2";
}

test "rakun ssl: a trust-store-only bundle produces a verify-only client option list" {
    val _f = freshRegistry();
    val b = SslBundle(
        name: "only-trust", certificateFile: "", privateKeyFile: "",
        trustStoreFile: "/ca.pem", protocols: defaultProtocols(), ciphers: "",
        clientAuth: "none", verify: "full",
    );
    val blob: string = clientBlob(b);
    assert blobGet(blob, "cacertfile") == "/ca.pem";
    assert blobGet(blob, "verify") == "verify_peer";
    assert blobGet(blob, "verify_hostname") == "true";
    assert blobKeys(blob).indexOf("certfile") < 0;
    assert blobKeys(blob).indexOf("keyfile") < 0;
}

test "rakun ssl: verify none turns off the chain and the hostname together" {
    val b = SslBundle(
        name: "lax", certificateFile: "", privateKeyFile: "",
        trustStoreFile: "/ca.pem", protocols: defaultProtocols(), ciphers: "",
        clientAuth: "none", verify: "none",
    );
    val blob: string = clientBlob(b);
    assert blobGet(blob, "verify") == "verify_none";
    assert blobGet(blob, "verify_hostname") == "false";
}

test "rakun ssl: a bundle with no keystore cannot terminate TLS and says gen_tcp" {
    val _f = freshRegistry();
    val _n = declareBundles("only-trust");
    val _t = rkSetProp(bundleKey("only-trust", "truststore.certificate"), anchorFile());
    assert transportFor(sample("one")) == "ssl";
    assert transportFor(SslBundle(
        name: "only-trust", certificateFile: "", privateKeyFile: "",
        trustStoreFile: "/ca.pem", protocols: defaultProtocols(), ciphers: "",
        clientAuth: "none", verify: "full",
    )) == "gen_tcp";
    assert sslTransport("") == "gen_tcp";
    assert sslTransport("only-trust") == "gen_tcp";
    assert sslTransport("absent") == "gen_tcp";
}

// ── the certificate reader ──────────────────────────────────────────────────

test "rakun ssl: both rows read the same five fields out of one certificate" {
    val info: string = rkSslCertInfo(certPem());
    assert blobGet(info, "error") == "";
    assert blobGet(info, "subject") == "CN=rakun-ssl-selftest,O=rakun";
    assert blobGet(info, "issuer") == "CN=rakun-ssl-selftest,O=rakun";
    assert blobGet(info, "notBefore") == "2020-01-01T00:00:00Z";
    assert blobGet(info, "notAfter") == "2020-04-01T00:00:00Z";
    // The window closed in April 2020, so this is negative today and more
    // negative tomorrow. Nothing here pins a number.
    assert toI32(blobGet(info, "daysRemaining")) < 0;
}

test "rakun ssl: text that is not a certificate answers an error rather than empty fields" {
    // The two hosts word the reason differently — node reports OpenSSL's message
    // and OTP reports the missing PEM block — so what is asserted is that there
    // IS a reason and that no field came back.
    val info: string = rkSslCertInfo("this is not a certificate");
    assert blobGet(info, "error") != "";
    assert blobGet(info, "subject") == "";
    assert blobGet(info, "notAfter") == "";
}

test "rakun ssl: a key belongs to a certificate or it does not, and both rows agree" {
    assert rkSslKeyMatches(certPem(), keyPem());
    assert rkSslKeyMatches(certPem(), otherKeyPem()) == false;
    assert rkSslKeyMatches(certPem(), "") == false;
    assert rkSslKeyMatches("", keyPem()) == false;
    assert rkSslKeyMatches(certPem(), "-----BEGIN PRIVATE KEY-----\nnope\n-----END PRIVATE KEY-----\n") == false;
}

// ── the registry ────────────────────────────────────────────────────────────

test "rakun ssl: two bundles resolve independently and one failing does not stop the other" {
    val _f = freshRegistry();
    val cert = scratch("indep-cert.pem");
    val key = scratch("indep-key.pem");
    val _w1 = writeFile(cert, certPem());
    val _w2 = writeFile(key, keyPem());
    val _n = declareBundles("one,two");
    val _m1 = materialOn("one", cert, key);
    // `two` pairs the same certificate with a key that does not belong to it.
    val other = scratch("indep-other.pem");
    val _w3 = writeFile(other, otherKeyPem());
    val _m2 = materialOn("two", cert, other);

    val registered = sslRegisterAll();
    assert registered == 1;
    assert sslRegisteredNames().join(",") == "one,two";
    assert sslLastError("one") == "";
    assert sslLastError("two").contains("does not belong to the certificate");
    assert sslSubject("one") == "CN=rakun-ssl-selftest,O=rakun";
    assert sslSubject("two") == "";
    assert sslListenerOpts("one") != "";
    assert sslListenerOpts("two") == "";

    // The startup pass turns the recorded failure into the refusal.
    try asserts.throwsWith({ -> sslBoot(); }, "does not belong to the certificate");

    val _r1 = removeFile(cert);
    val _r2 = removeFile(key);
    val _r3 = removeFile(other);
    val _z = freshRegistry();
}

test "rakun ssl: a resolved bundle stores the certificate fields and both option lists" {
    val _f = freshRegistry();
    val cert = scratch("resolve-cert.pem");
    val key = scratch("resolve-key.pem");
    val _w1 = writeFile(cert, certPem());
    val _w2 = writeFile(key, keyPem());
    val _n = declareBundles("one");
    val _m = materialOn("one", cert, key);
    val _a = rkSetProp(bundleKey("one", "client-auth"), "need");
    assert sslRegister("one");

    assert sslSubject("one") == "CN=rakun-ssl-selftest,O=rakun";
    assert sslIssuer("one") == "CN=rakun-ssl-selftest,O=rakun";
    assert sslNotBefore("one") == "2020-01-01T00:00:00Z";
    assert sslNotAfter("one") == "2020-04-01T00:00:00Z";
    assert sslExpiryDays("one") < 0;
    assert sslLastError("one") == "";
    assert sslTransport("one") == "ssl";
    assert rkSslGet("one", "transport") == "ssl";

    val listener: string = sslListenerOpts("one");
    assert blobGet(listener, "certfile") == cert;
    assert blobGet(listener, "fail_if_no_peer_cert") == "true";

    // SNI is the CALLER's hostname and is appended by the host at call time, so
    // the same bundle serves a listener and any number of clients.
    val client: string = sslClientOpts("one", "api.internal");
    assert blobGet(client, "server_name_indication") == "api.internal";
    assert blobGet(client, "verify") == "verify_peer";
    assert sslClientOpts("one", "other.internal").contains("other.internal");
    assert sslClientOpts("absent", "api.internal") == "";

    val _r1 = removeFile(cert);
    val _r2 = removeFile(key);
    val _z = freshRegistry();
}

test "rakun ssl: a bundle that is not configured records that and resolves nothing" {
    val _f = freshRegistry();
    assert sslRegister("ghost") == false;
    assert sslLastError("ghost") == "not configured";
    assert sslListenerOpts("ghost") == "";
    assert sslExpiryDays("ghost") == 0;
    val _z = freshRegistry();
}

test "rakun ssl: a file that vanished between configuration and boot is a refusal" {
    val _f = freshRegistry();
    val _n = declareBundles("one");
    val _m = materialOn("one", scratch("never-written-cert.pem"), scratch("never-written-key.pem"));
    // `sslRegister` RECORDS and answers false; it does not raise. A reload runs
    // on a timer in a process that has to survive a file being late.
    assert sslRegister("one") == false;
    assert sslLastError("one").contains("and nothing is there");
    // `sslBoot` is the raising form, and it is the same text.
    try asserts.throwsWith({ -> sslBoot(); }, "and nothing is there");
    // As is the direct read.
    try asserts.throwsWith({ ->
        sslBundle("one");
        0;
    }, "and nothing is there");
    val _z = freshRegistry();
}

test "rakun ssl: one text, two deliveries - bundleProblem records what validateBundle raises" {
    val bad = SslBundle(
        name: "one", certificateFile: "", privateKeyFile: "", trustStoreFile: "",
        protocols: defaultProtocols(), ciphers: "", clientAuth: "maybe", verify: "full",
    );
    assert bundleProblem(bad) == clientAuthProblem("one", "maybe");
    try asserts.throwsWith({ -> validateBundle(bad); }, "none, want and need");
    val good = SslBundle(
        name: "one", certificateFile: "", privateKeyFile: "", trustStoreFile: "",
        protocols: defaultProtocols(), ciphers: "", clientAuth: "need", verify: "none",
    );
    assert bundleProblem(good) == "";
    assert validateBundle(good) == 0;
    assert fileProblem("one", "keystore.certificate", "") == "";
    assert fileProblem("one", "keystore.certificate", "/a/b.jks").contains("keytool");
}

test "rakun ssl: a reload of a bundle whose file went away records rather than raises" {
    val _f = freshRegistry();
    val cert = scratch("vanish-cert.pem");
    val key = scratch("vanish-key.pem");
    val _w1 = writeFile(cert, certPem());
    val _w2 = writeFile(key, keyPem());
    val _n = declareBundles("rotating");
    val _m = materialOn("rotating", cert, key);
    assert sslRegister("rotating");
    val goodListener: string = sslListenerOpts("rotating");

    val _r1 = removeFile(cert);
    assert sslReload("rotating") == false;
    assert sslLastError("rotating").contains("and nothing is there");
    // The previous material is untouched: `sslRegister` computes everything
    // before it writes anything, so a failure cannot half-write.
    assert sslListenerOpts("rotating") == goodListener;
    assert sslSubject("rotating") == "CN=rakun-ssl-selftest,O=rakun";

    val _r2 = removeFile(key);
    val _z = freshRegistry();
}

test "rakun ssl: verify none resolves with a warning naming the bundle" {
    val _f = freshRegistry();
    val _n = declareBundles("lax");
    val _t = rkSetProp(bundleKey("lax", "truststore.certificate"), scratch("lax-ca.pem"));
    val _w = writeFile(scratch("lax-ca.pem"), certPem());
    val _v = rkSetProp(bundleKey("lax", "verify"), "none");
    assert sslRegister("lax");
    assert sslWarnings().length == 1;
    assert sslWarnings().at(0).unwrapOr("").contains("the bundle lax resolves with verify=none");
    assert sslFailures().length == 0;

    // A bundle at the default posture produces no warning at all.
    val _v2 = rkSetProp(bundleKey("lax", "verify"), "full");
    assert sslRegister("lax");
    assert sslWarnings().length == 0;

    val _r = removeFile(scratch("lax-ca.pem"));
    val _z = freshRegistry();
}

// ── reload ──────────────────────────────────────────────────────────────────

test "rakun ssl: a reload after the files change presents the new material" {
    val _f = freshRegistry();
    val cert = scratch("reload-cert.pem");
    val key = scratch("reload-key.pem");
    val _w1 = writeFile(cert, certPem());
    val _w2 = writeFile(key, keyPem());
    val _n = declareBundles("rotating");
    val _m = materialOn("rotating", cert, key);
    assert sslRegister("rotating");
    val before: string = rkSslGet("rotating", "stamp");
    assert before != "//";

    // The rotation: the same pair written again, which is what a renewal looks
    // like from the registry's side.
    val _w3 = writeFile(cert, certPem());
    assert sslReload("rotating");
    assert sslLastError("rotating") == "";
    assert sslSubject("rotating") == "CN=rakun-ssl-selftest,O=rakun";

    val _r1 = removeFile(cert);
    val _r2 = removeFile(key);
    val _z = freshRegistry();
}

test "rakun ssl: a broken rotation keeps the previous material and is recorded" {
    val _f = freshRegistry();
    val cert = scratch("broken-cert.pem");
    val key = scratch("broken-key.pem");
    val _w1 = writeFile(cert, certPem());
    val _w2 = writeFile(key, keyPem());
    val _n = declareBundles("rotating");
    val _m = materialOn("rotating", cert, key);
    assert sslRegister("rotating");
    val goodListener: string = sslListenerOpts("rotating");
    val goodSubject: string = sslSubject("rotating");

    // The deploy half-wrote the key: it is now somebody else's.
    val _w3 = writeFile(key, otherKeyPem());
    assert sslReload("rotating") == false;
    assert sslLastError("rotating").contains("does not belong to the certificate");
    // The previous material is still there. Serving yesterday's certificate for
    // another hour beats serving nothing at 3am.
    assert sslListenerOpts("rotating") == goodListener;
    assert sslSubject("rotating") == goodSubject;

    // And the error clears on a good rotation.
    val _w4 = writeFile(key, keyPem());
    assert sslReload("rotating");
    assert sslLastError("rotating") == "";

    val _r1 = removeFile(cert);
    val _r2 = removeFile(key);
    val _z = freshRegistry();
}

test "rakun ssl: reload-on-update false makes the poll touch no file at all" {
    val _f = freshRegistry();
    val cert = scratch("poll-cert.pem");
    val key = scratch("poll-key.pem");
    val _w1 = writeFile(cert, certPem());
    val _w2 = writeFile(key, keyPem());
    val _n = declareBundles("rotating");
    val _m = materialOn("rotating", cert, key);
    assert sslRegister("rotating");
    assert bundleReloadOnUpdate("rotating") == false;

    // With the flag off the poll is a no-op even when the files DID move: the
    // stamp is never read, so nothing reloads. Proved by removing the files
    // entirely — a poll that stat'd them would fail or reload.
    val _r1 = removeFile(cert);
    val _r2 = removeFile(key);
    assert sslPoll() == 0;
    assert sslLastError("rotating") == "";
    assert sslSubject("rotating") == "CN=rakun-ssl-selftest,O=rakun";
    val _z = freshRegistry();
}

test "rakun ssl: a material stamp changes when a file does and not otherwise" {
    val _f = freshRegistry();
    val cert = scratch("stamp-cert.pem");
    val _w1 = writeFile(cert, certPem());
    val b = SslBundle(
        name: "rotating", certificateFile: cert, privateKeyFile: "",
        trustStoreFile: "", protocols: defaultProtocols(), ciphers: "",
        clientAuth: "none", verify: "full",
    );
    val first: string = materialStamp(b);
    assert first == materialStamp(b);
    assert mtimeOf("") == "";
    assert mtimeOf(scratch("not-a-file")) == "0";
    val _r = removeFile(cert);
    // A file that is gone stamps as `0`, which differs from any mtime, so a
    // deletion is a change the poll sees rather than one it misses.
    assert materialStamp(b) != first;
    val _z = freshRegistry();
}

// ── health and info ─────────────────────────────────────────────────────────

test "rakun ssl: the four verdicts one bundle can have" {
    assert sslHealthOf(30, "", 14) == statusUp();
    assert sslHealthOf(15, "", 14) == statusUp();
    assert sslHealthOf(14, "", 14) == statusOutOfService();
    assert sslHealthOf(3, "", 14) == statusOutOfService();
    assert sslHealthOf(0, "", 14) == statusOutOfService();
    assert sslHealthOf(0 - 1, "", 14) == statusDown();
    // A failed reload is DOWN even while the OLD material is still being served.
    assert sslHealthOf(300, "a reload failed", 14) == statusDown();
    assert statusUp() == "UP";
    assert statusOutOfService() == "OUT_OF_SERVICE";
    assert statusDown() == "DOWN";
}

test "rakun ssl: with no bundles the indicator is UP with an empty detail, never absent" {
    val _f = freshRegistry();
    val h: string = sslHealth();
    assert blobGet(h, "status") == "UP";
    assert blobGet(h, "bundles") == "0";
    // "no TLS configured" and "TLS broken" must not look the same to a monitor.
    assert h == "status|UP;bundles|0";
    assert sslInfo() == "";
}

test "rakun ssl: the indicator names the bundle, the days and the reason" {
    val _f = freshRegistry();
    val cert = scratch("health-cert.pem");
    val key = scratch("health-key.pem");
    val _w1 = writeFile(cert, certPem());
    val _w2 = writeFile(key, keyPem());
    val _n = declareBundles("one");
    val _m = materialOn("one", cert, key);
    assert sslRegister("one");

    // The committed certificate is expired, so this bundle is DOWN by expiry and
    // the detail says which bundle and what its subject is.
    val h: string = sslHealth();
    assert blobGet(h, "status") == "DOWN";
    assert blobGet(h, "bundles") == "1";
    assert blobGet(h, "one.status") == "DOWN";
    assert blobGet(h, "one.subject") == "CN=rakun-ssl-selftest,O=rakun";
    assert blobGet(h, "one.error") == "";

    val i: string = sslInfo();
    assert blobGet(i, "one.subject") == "CN=rakun-ssl-selftest,O=rakun";
    assert blobGet(i, "one.issuer") == "CN=rakun-ssl-selftest,O=rakun";
    assert blobGet(i, "one.notBefore") == "2020-01-01T00:00:00Z";
    assert blobGet(i, "one.notAfter") == "2020-04-01T00:00:00Z";
    assert blobGet(i, "one.daysRemaining") != "";
    // No key material, no private-key fingerprint, no password — the whole
    // contribution is what the certificate already tells anyone who connects.
    assert i.contains("PRIVATE") == false;
    assert i.contains("password") == false;

    val _r1 = removeFile(cert);
    val _r2 = removeFile(key);
    val _z = freshRegistry();
}

test "rakun ssl: a failed resolve is DOWN with the reason as the detail" {
    val _f = freshRegistry();
    val cert = scratch("down-cert.pem");
    val other = scratch("down-other.pem");
    val _w1 = writeFile(cert, certPem());
    val _w2 = writeFile(other, otherKeyPem());
    val _n = declareBundles("two");
    val _m = materialOn("two", cert, other);
    assert sslRegister("two") == false;
    val h: string = sslHealth();
    assert blobGet(h, "status") == "DOWN";
    assert blobGet(h, "two.status") == "DOWN";
    assert blobGet(h, "two.error").contains("does not belong to the certificate");
    val _r1 = removeFile(cert);
    val _r2 = removeFile(other);
    val _z = freshRegistry();
}

// ── the key catalogue ───────────────────────────────────────────────────────

test "rakun ssl: the front's own keys join front 05's catalogue once" {
    val _f = freshRegistry();
    val _a = registerSslKeys();
    val _b = registerSslKeys();
    val known: string = rkProp("rakun.config.catalogue");
    assert known.contains("rakun.ssl");
    val spec: string = rkProp("rakun.config.catalogue.rakun.ssl");
    assert spec.contains("handshake-timeout:i32:5000");
    assert spec.contains("health.warn-threshold:i32:14");
    // Registered twice, listed once.
    assert (("," + known + ",").split(",rakun.ssl,").length) == 2;
}
