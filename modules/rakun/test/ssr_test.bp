// rakun — the SSR pipeline (front 23): the rendered page, the composition
// order, the escaping walker, the document and its payload, the chunk protocol
// and the two entry points.
//
// EVERY CELL IN THIS FILE RUNS ON BOTH ROWS. The render, the escaping and the
// chunk writer are the erlang half of the front; the payload reader and the
// streaming-hole swapper are the js half; the payload format is the contract
// between them, so a suite that only wrote or only read would prove nothing
// about the boundary this front exists to hold.
//
// THE ELEMENT THE CELLS RENDER is rakun's own `Node`, reached through
// `nodeView`. jhonstart's `Element` is not importable here and must not become
// importable: rakun declares no dependency on it. The two tag predicates are
// PARAMETERS of the view — front 94's `isVoidTag` / `isRawTextTag` in a real
// application — and the two written here are this file's fixture, deliberately
// two tags wide so that nobody mistakes them for a second void list.

import {asserts} from "std";
import {dict} from "std";
import {
    LayoutProps,
    PageContext,
    RouteEntry,
    contextOf,
    emptyParams,
    matchPath,
    appTable,
    rkAppLayout,
    rkAppPage,
    rkAppReset,
} from "file_router";
import {rkReqShareBump, rkReqShareCount, rkReqShareReset} from "request_context";
import {
    ElementView,
    Node,
    RenderedPage,
    compose,
    escapeAttribute,
    escapeHtml,
    headerOfPage,
    htmlHeaders,
    Payload,
    RenderHooks,
    defaultHooks,
    document,
    emptyPayload,
    hooks,
    island,
    islandId,
    jsonString,
    nextIslandOrdinal,
    nodeView,
    payloadEscape,
    payloadOf,
    payloadScript,
    raw,
    registerBoundary,
    renderNode,
    renderedPage,
    rkSsrPayloadKeys,
    rkSsrPayloadText,
    rkSsrReset,
    setHooks,
    withCollectHead,
    withHeadExtra,
    writePayload,
    selected,
    toResponse,
} from "ssr";

// ── the fixture view ────────────────────────────────────────────────────────

pub fn fixtureVoid(tag: string) -> bool {
    return tag == "input" || tag == "br";
}

pub fn fixtureRawText(tag: string) -> bool {
    return tag == "script" || tag == "style";
}

pub fn view() -> ElementView<Node> {
    return nodeView({ t -> fixtureVoid(t) }, { t -> fixtureRawText(t) });
}

pub fn el(tag: string, attrs: Array<#(string, string)>, children: Node[]) -> Node {
    return Node(tag: tag, value: "", attrs: attrs, children: children);
}

pub fn txt(value: string) -> Node {
    return Node(tag: "#text", value: value, attrs: [], children: []);
}

pub fn ssrContext(pathname: string, pattern: string) -> PageContext {
    return PageContext(
        pathname: pathname,
        pattern: pattern,
        params: emptyParams(),
        query: dict.empty(),
        rest: [],
    );
}

// A layout that names itself and keeps its children, which is what makes the
// nesting readable as a string rather than asserted in prose.
pub fn wrapLayout(name: string, props: LayoutProps<Node>) -> Node {
    return el(name, [], [props.children]);
}

pub fn depthLayout(props: LayoutProps<Node>) -> Node {
    return el("d" + selected().toString(), [], [props.children]);
}

// ── step 1: the rendered page ───────────────────────────────────────────────

test "rakun ssr: a rendered page carries headers and an ordered chunk list" {
    val page: RenderedPage = renderedPage(200, ["<html>", "<body>", "</html>"]);
    assert page.status == 200;
    assert page.chunks.length == 3;
    assert headerOfPage(page, "Content-Type") == "text/html; charset=utf-8";
    assert htmlHeaders().length == 1;
}

test "rakun ssr: toResponse joins the chunks and is the only place that does" {
    val page: RenderedPage = renderedPage(404, ["a", "b", "c"]);
    val res = toResponse(page);
    assert res.status == 404;
    assert res.body == "abc";
}

// ── step 3: the escaping walker ─────────────────────────────────────────────

test "rakun ssr: a text node carrying a script tag renders with no `<` at all" {
    val v: ElementView<Node> = view();
    val out = renderNode(v, txt("<script>alert(1)</script>"));
    assert out.contains("<") == false;
    assert out == "&lt;script&gt;alert(1)&lt;/script&gt;";
}

test "rakun ssr: the ampersand is escaped first, so an entity is not doubled" {
    assert escapeHtml("a & b") == "a &amp; b";
    assert escapeHtml("&lt;") == "&amp;lt;";
    assert escapeAttribute("say \"hi\" & 'bye'") == "say &quot;hi&quot; &amp; &#39;bye&#39;";
}

test "rakun ssr: an attribute value containing a quote renders as an entity" {
    val v: ElementView<Node> = view();
    val out = renderNode(v, el("div", [#("title", "a \"quoted\" <b>")], []));
    assert out == "<div title=\"a &quot;quoted&quot; &lt;b&gt;\"></div>";
    assert out.contains("\"a \"") == false;
}

test "rakun ssr: a void tag emits no closing tag" {
    val v: ElementView<Node> = view();
    val out = renderNode(v, el("input", [#("name", "q")], []));
    assert out == "<input name=\"q\">";
    assert out.contains("</input>") == false;
}

test "rakun ssr: a raw-text body is verbatim, in both directions" {
    val v: ElementView<Node> = view();
    val style = renderNode(v, el("style", [], [txt("a > b { color: red }")]));
    assert style == "<style>a > b { color: red }</style>";
    val script = renderNode(v, el("script", [], [txt("if (a && b) go();")]));
    assert script == "<script>if (a && b) go();</script>";
}

test "rakun ssr: a raw-text body that closes its own element is refused, in any case" {
    val v: ElementView<Node> = view();
    try asserts.throwsWith({ ->
        renderNode(v, el("script", [], [txt("var a = \"</script>\";")]));
        0;
    }, "a <script> body contains");
    try asserts.throwsWith({ ->
        renderNode(v, el("style", [], [txt("/* </STYLE> */")]));
        0;
    }, "a <style> body contains");
}

test "rakun ssr: `#raw` is the one escape hatch and renders verbatim" {
    val v: ElementView<Node> = view();
    assert renderNode(v, raw(v, "<b>x</b>")) == "<b>x</b>";
}

test "rakun ssr: the walker is a superset of the frozen renderer, not a divergence" {
    val v: ElementView<Node> = view();
    val tree = el("div", [#("class", "post")], [el("p", [], [txt("hi")])]);
    assert renderNode(v, tree) == "<div class=\"post\"><p>hi</p></div>";
    assert renderNode(v, Node(tag: "#fragment", value: "", attrs: [], children: [txt("a"), txt("b")])) == "ab";
}

// ── step 2: composition order ───────────────────────────────────────────────

test "rakun ssr: one segment holding all six conventions nests layout > template > error > loading > not-found > page" {
    val _r = rkAppReset();
    val _s = rkSsrReset();
    val v: ElementView<Node> = view();
    val _l = rkAppLayout("", { props -> wrapLayout("layout", props) });
    val _t = registerBoundary("T", "/", { props -> wrapLayout("template", props) });
    val _e = registerBoundary("E", "/", { props -> wrapLayout("error", props) });
    val _o = registerBoundary("S", "/", { props -> wrapLayout("loading", props) });
    val _n = registerBoundary("N", "/", { props -> wrapLayout("not-found", props) });
    val tree = compose(v, [RouteEntry(kind: "L", pattern: "/", slot: "", verb: "")], ssrContext("/", "/"), 1, el("page", [], []));
    val out = renderNode(v, tree);
    assert out.startsWith("<layout><div data-onze-t=\"/#1\"><template><error><loading><not-found><page>");
    assert out.endsWith("</page></not-found></loading></error></template></div></layout>");
}

test "rakun ssr: a segment with no template contributes no wrapper" {
    val _r = rkAppReset();
    val _s = rkSsrReset();
    val v: ElementView<Node> = view();
    val _l = rkAppLayout("", { props -> wrapLayout("layout", props) });
    val tree = compose(v, [RouteEntry(kind: "L", pattern: "/", slot: "", verb: "")], ssrContext("/", "/"), 1, el("page", [], []));
    assert renderNode(v, tree) == "<layout><page></page></layout>";
    assert renderNode(v, tree).contains("div") == false;
}

test "rakun ssr: the root layout is outermost and the page innermost for a real chain" {
    val _r = rkAppReset();
    val _s = rkSsrReset();
    val v: ElementView<Node> = view();
    val _root = rkAppLayout("", { props -> wrapLayout("root", props) });
    val _blog = rkAppLayout("blog", { props -> wrapLayout("blog", props) });
    val _page = rkAppPage("blog/[slug]", { route -> pageOf(route) });
    val table = appTable();
    var out = "";
    if (matchPath(table, "/blog/hello")) { hit ->
        val ctx = contextOf(hit, "/blog/hello", emptyParams());
        out = renderNode(v, compose(v, hit.chain, ctx, 1, el("page", [], [])));
    };
    assert out == "<root><blog><page></page></blog></root>";
}

test "rakun ssr: a template key changes between two renders of the same route" {
    val _r = rkAppReset();
    val _s = rkSsrReset();
    val v: ElementView<Node> = view();
    val _t = registerBoundary("T", "/", { props -> wrapLayout("template", props) });
    val chain = [RouteEntry(kind: "L", pattern: "/", slot: "", verb: "")];
    val first = renderNode(v, compose(v, chain, ssrContext("/", "/"), 1, el("page", [], [])));
    val second = renderNode(v, compose(v, chain, ssrContext("/", "/"), 2, el("page", [], [])));
    assert first.contains("data-onze-t=\"/#1\"");
    assert second.contains("data-onze-t=\"/#2\"");
    assert first == second == false;
}

test "rakun ssr: each layout render receives its own selected depth, root first" {
    val _r = rkAppReset();
    val _s = rkSsrReset();
    val v: ElementView<Node> = view();
    val _root = rkAppLayout("", { props -> depthLayout(props) });
    val _blog = rkAppLayout("blog", { props -> depthLayout(props) });
    val _year = rkAppLayout("blog/[year]", { props -> depthLayout(props) });
    val _page = rkAppPage("blog/[year]/[slug]", { route -> pageOf(route) });
    val table = appTable();
    var out = "";
    if (matchPath(table, "/blog/2026/hello")) { hit ->
        val ctx = contextOf(hit, "/blog/2026/hello", emptyParams());
        out = renderNode(v, compose(v, hit.chain, ctx, 1, el("page", [], [])));
    };
    assert out == "<d0><d1><d2><page></page></d2></d1></d0>";
}

#[@future]
pub fn pageOf(route: PageContext) -> @Future<Node> {
    return el("page", [], []);
}

// ── step 4: the document and the payload ────────────────────────────────────

pub fn samplePayload() -> Payload {
    return Payload(
        build: "b0",
        pathname: "/blog/hello",
        pattern: "/blog/[slug]",
        params: "slug=hello",
        query: "page=2",
        table: "L|/\nP|/blog/[slug]",
        islands: [#("i0", "Counter", "n=1"), #("i1", "Toggle", "on=")],
        actions: [#("like", "a1")],
        styles: "a1b2 c3d4",
        holes: ["h1"],
        dynamic: true,
        kinds: "/blog/[slug]|dynamic",
        slots: "/dashboard|team",
    );
}

test "rakun ssr: the payload emits `v` first and `1` as its value" {
    val json = writePayload(samplePayload());
    assert json.startsWith("{\"v\":1,");
    assert rkSsrPayloadText(json, "v") == "1";
}

test "rakun ssr: the payload's `t` is the route-table blob verbatim, newline-escaped by the JSON writer" {
    val json = writePayload(samplePayload());
    assert json.contains("\"t\":\"L|/\\nP|/blog/[slug]\"");
    assert rkSsrPayloadText(json, "t") == "L|/\nP|/blog/[slug]";
}

test "rakun ssr: a JSON string escapes the backslash before anything it adds" {
    assert jsonString("a\\b") == "\"a\\\\b\"";
    assert jsonString("say \"hi\"") == "\"say \\\"hi\\\"\"";
    assert jsonString("one\ntwo") == "\"one\\ntwo\"";
}

test "rakun ssr: payloadEscape leaves no literal `<`, `>` or `&` in its output" {
    val out = payloadEscape("{\"m\":\"a=<b>&c\"}");
    assert out.contains("<") == false;
    assert out.contains(">") == false;
    assert out.contains("&") == false;
    assert out.contains("\\u003c");
    assert out.contains("\\u003e");
    assert out.contains("\\u0026");
}

test "rakun ssr: a param carrying `</script>` yields a document with exactly two script closers" {
    val _s = rkSsrReset();
    val p = Payload(
        build: "b0",
        pathname: "/p",
        pattern: "/p",
        params: "q=</script><img src=x onerror=alert(1)>",
        query: "",
        table: "",
        islands: [],
        actions: [],
        styles: "",
        holes: [],
        dynamic: false,
        kinds: "",
        slots: "",
    );
    val doc = await document("<title>t</title>", "<p>body</p>", p);
    // ONE closer, this front's own: the spec says two because the second is the
    // client bundle's, and `defaultHooks()` installs no bundle.
    assert countOf(doc, "</script>") == 1;
    // The dangerous half of the injection cannot form at all: no `<` survives
    // the payload escape, so `<img` is not in the document even though the
    // inert text `onerror=alert(1)` is — which is the point of an
    // `application/json` block a parser never executes.
    assert doc.contains("<img") == false;
    assert doc.contains("img src=x onerror=alert(1)");
    assert payloadOf(doc).contains("</script") == false;
}

test "rakun ssr: the payload round trip — a real parser on each row reads the same field set" {
    val _s = rkSsrReset();
    val p: Payload = samplePayload();
    val doc = await document("", "<main></main>", p);
    val json = payloadOf(doc);
    assert rkSsrPayloadKeys(json) == "a,b,d,h,i,k,m,p,q,r,s,t,v,z";
    assert rkSsrPayloadText(json, "p") == "/blog/hello";
    assert rkSsrPayloadText(json, "r") == "/blog/[slug]";
    assert rkSsrPayloadText(json, "m") == "slug=hello";
    assert rkSsrPayloadText(json, "q") == "page=2";
    assert rkSsrPayloadText(json, "s") == "a1b2 c3d4";
    assert rkSsrPayloadText(json, "d") == "true";
    assert rkSsrPayloadText(json, "h") == "[\"h1\"]";
    assert rkSsrPayloadText(json, "i") == "[[\"i0\",\"Counter\",\"n=1\"],[\"i1\",\"Toggle\",\"on=\"]]";
    assert rkSsrPayloadText(json, "a") == "[[\"like\",\"a1\"]]";
    assert rkSsrPayloadText(json, "k") == "/blog/[slug]|dynamic";
    assert rkSsrPayloadText(json, "z") == "/dashboard|team";
}

test "rakun ssr: a document rendered with the default hooks names no bundler and opens no sheet" {
    val _s = rkSsrReset();
    val doc = await document("<title>t</title>", "<p>hi</p>", emptyPayload());
    assert doc.startsWith("<!DOCTYPE html><html lang=\"pt-BR\"><head><meta charset=\"utf-8\">");
    assert doc.contains("<div data-onze-root=\"\"><p>hi</p></div>");
    assert doc.endsWith("</body></html>");
    assert doc.contains("<script src") == false;
    // Decision 77: the sheet is a `RenderHooks` field, so a default document
    // carries NO `<style>` at all. The front's own text says "exactly one",
    // which was written when this front still called `emilia.flush()` itself.
    assert doc.contains("<style") == false;
}

test "rakun ssr: the hooks record is filled field by field, not all or nothing" {
    val _s = rkSsrReset();
    val base: RenderHooks = defaultHooks();
    val one: RenderHooks = withHeadExtra(base, { r -> "<link rel=\"stylesheet\" href=\"/a.css\">" });
    val _i = setHooks(one);
    val doc = await document("", "<p>hi</p>", emptyPayload());
    assert doc.contains("<link rel=\"stylesheet\" href=\"/a.css\">");
    // the other six are still the defaults
    assert doc.contains("<style") == false;
    assert doc.endsWith("</script></body></html>");
    val _r = rkSsrReset();
}

test "rakun ssr: the head is serialised once per document, after the body rendered" {
    val _s = rkSsrReset();
    val _z = rkReqShareReset();
    val base: RenderHooks = defaultHooks();
    val sunk: RenderHooks = withCollectHead(base, { -> countedSheet() });
    val _i = setHooks(sunk);
    val doc = await document("", "<p>hi</p>", emptyPayload());
    assert countOf(doc, "<style") == 1;
    assert rkReqShareCount("ssr.collectHead") == 1;
    // a second document in the same process gets its own call, not a drained sheet
    val again = await document("", "<p>two</p>", emptyPayload());
    assert countOf(again, "<style") == 1;
    assert rkReqShareCount("ssr.collectHead") == 2;
    val _r = rkSsrReset();
}

test "rakun ssr: island ordinals are assigned here, in render order, and the marker agrees with the index" {
    val _s = rkSsrReset();
    val v: ElementView<Node> = view();
    val h: RenderHooks = hooks();
    val first = nextIslandOrdinal();
    val second = nextIslandOrdinal();
    assert islandId(first) == "i0";
    assert islandId(second) == "i1";
    val markup = renderNode(v, el("main", [], [
        island(v, h, first, txt("one")),
        island(v, h, second, txt("two")),
    ]));
    assert markup == "<main><div data-onze-i=\"i0\">one</div><div data-onze-i=\"i1\">two</div></main>";
}

pub fn countedSheet() -> string {
    val _b = rkReqShareBump("ssr.collectHead");
    return "<style>.a{color:red}</style>";
}

pub fn countOf(haystack: string, needle: string) -> i32 {
    return haystack.split(needle).length - 1;
}
