//// rakun — front 72's COMPTIME half: what each marker serialises, and what the
//// one evaluator answers for each record letter.
////
//// Every assertion here runs on BOTH rows. The blob is produced by a decorator
//// body at compile time and read back through the host table with nothing in
//// between, so `rkAutoConditions("Name")` is the tightest assertion point this
//// front has: if the body emitted a different string, this file reds.
////
//// WHAT CANNOT BE ASSERTED HERE, and where it lives instead. A placement
//// failure and an arity failure are COMPILE errors, not values, so
//// `#[conditionalOnModule]` on a field, `#[conditionalOnProperty("k")]` with one
//// argument, `#[conditionalOnProperty("k", 1)]` with the wrong type, a key
//// carrying `;` or `|`, two `#[profile]` markers on one type and a condition
//// marker with no registration to belong to are all rejected by the compiler
//// and cannot be written down in a `.bp` test. `test/di_test.bp` records the
//// same split for the six stereotypes: the generic rejection path is the
//// compiler's own annotation-processor suite
//// (`comptime/tests/decorator_invocation.zig`), and this file asserts only the
//// cases that produce a value.
////
//// NOTHING HERE CALLS `autoConfigure()` OR RESETS THE TABLE. The registrations
//// these types emit run at module LOAD, before the first test block; a reset
//// would wipe the very thing the file is about. The apply pass lives in
//// `test/autoconfig_test.bp`, which runs in its own process with its own table.

import {decorators.service, decorators.bean, decorators.value};
import {runtime.rkScan, runtime.rkSingleton, runtime.rkEnter, runtime.rkDone, runtime.rkSetProp, runtime.rkProp, runtime.rkPropInt, runtime.rkScannedNames};
import {autoconfig.autoConfiguration, autoconfig.rkAutoGate};
import {conditions.conditionalOnModule, conditions.conditionalOnProperty, conditions.conditionalOnBean, conditions.conditionalOnMissingBean, conditions.profile, conditions.autoConfigureBefore, conditions.autoConfigureAfter, conditions.moduleRecord, conditions.propertyRecord, conditions.beanRecord, conditions.missingBeanRecord, conditions.profileRecord, conditions.anyValue, conditions.recordField, conditions.recordKind, conditions.splitBlob, conditions.evaluateRecord, conditions.evaluateBlob, conditions.activeProfiles, conditions.defaultProfiles, conditions.profilesAreDefaulted, conditions.profileObserved, conditions.registeredNames, conditions.unknownRecordProblem};
import {autoconfig_registry.rkAutoRegister, autoconfig_registry.rkAutoProvides, autoconfig_registry.rkAutoConditions, autoconfig_registry.rkAutoProvided, autoconfig_registry.rkAutoBefore, autoconfig_registry.rkAutoAfter, autoconfig_registry.rkAutoNames, autoconfig_registry.rkAutoKnown, autoconfig_registry.rkModulePresent, autoconfig_registry.moduleList, autoconfig_registry.moduleListIn, autoconfig_registry.manifestDependencies, autoconfig_registry.manifestDependencyNames, autoconfig_registry.manifestShapeProblem, autoconfig_registry.manifestName, autoconfig_registry.manifestMissingProblem};
import {profiles.setResolved};
import {testing.asserts} from "std";
import {collections.Dict} from "std";
import {rkResolve, rkAddBean, rkInstallBeans, rkRegisterBean};

fn beans() -> Dict<string, unknown> {
    return comptime {
        var d: Dict<string, unknown> = Dict.empty();
        for (@TypeInfo.all(
            with: [service, autoConfiguration],
            member: "make",
        )) { b ->
            d = rkAddBean(d, b.name, b.value);
        }
        break d;
    };
}

// ── the declarations whose blobs this file reads ────────────────────────────

pub type CondMailSender(
    host: string,
)

pub type CondAuditTrail(
    tag: string,
)

// No condition at all: the blob is the `V|` record and nothing else, and the
// entry therefore always matches.
#[autoConfiguration]
type PlainAutoConfiguration() {
    pub fn tag(self: Self) -> string {
        return "plain";
    }
}

// Three conditions, in source order, plus two ordering annotations that go to
// the `before`/`after` lists rather than into the blob.
#[autoConfiguration]
#[conditionalOnModule("rakun-mail")]
#[conditionalOnProperty("rakun.cond.mail.host", "*")]
#[conditionalOnMissingBean("CondMailSender")]
#[autoConfigureAfter("PlainAutoConfiguration")]
#[autoConfigureBefore("LateAutoConfiguration")]
type CondMailAutoConfiguration(
    #[value("rakun.cond.mail.host")] host: string,
    #[value("rakun.cond.mail.port")] port: i32,
) {
    #[bean]
    #[conditionalOnProperty("rakun.cond.mail.from", "noreply")]
    pub fn condMailSender(self: Self) -> CondMailSender {
        return CondMailSender(host: self.host);
    }
}

#[autoConfiguration]
#[conditionalOnBean("PlainAutoConfiguration")]
#[profile("prod")]
type LateAutoConfiguration() {
    #[bean]
    pub fn condAuditTrail(self: Self) -> CondAuditTrail {
        return CondAuditTrail(tag: "audit");
    }
}

// `#[profile]` on an ORDINARY stereotype: the marker registers the component
// itself, with one `F|` record and the `V|` record saying what it contributes.
#[service]
#[profile("staging")]
type CondStagingService() {
    pub fn tag(self: Self) -> string {
        return "staging";
    }
}

// ── the blob ────────────────────────────────────────────────────────────────

test "rakun conditions: a type with no condition registers an always-matching blob" {
    val _beans = rkInstallBeans(beans());
    assert rkAutoKnown("PlainAutoConfiguration");
    assert rkAutoConditions("PlainAutoConfiguration") == "";
    assert rkAutoProvided("PlainAutoConfiguration") == "PlainAutoConfiguration";
    assert rkAutoBefore("PlainAutoConfiguration") == "";
    assert rkAutoAfter("PlainAutoConfiguration") == "";
    val none: string[] = [];
    assert evaluateBlob(rkAutoConditions("PlainAutoConfiguration"), none).ok;
}

test "rakun conditions: three conditions produce three records, in source order" {
    val _beans = rkInstallBeans(beans());
    assert rkAutoConditions("CondMailAutoConfiguration")
        == "M|rakun-mail;P|rakun.cond.mail.host|*;X|CondMailSender";
    val recs = splitBlob(rkAutoConditions("CondMailAutoConfiguration"));
    assert recs.length == 3;
    assert recordKind(recs.at(0) ?? "") == moduleRecord();
    assert recordKind(recs.at(1) ?? "") == propertyRecord();
    assert recordKind(recs.at(2) ?? "") == missingBeanRecord();
}

test "rakun conditions: the ordering markers go to the two lists, never to the blob" {
    val _beans = rkInstallBeans(beans());
    assert rkAutoAfter("CondMailAutoConfiguration") == "PlainAutoConfiguration";
    assert rkAutoBefore("CondMailAutoConfiguration") == "LateAutoConfiguration";
    assert rkAutoConditions("CondMailAutoConfiguration").contains(
        "PlainAutoConfiguration",
    )
        == false;
}

test "rakun conditions: a #[bean] method registers under Type.method with its own conditions" {
    val _beans = rkInstallBeans(beans());
    assert rkAutoKnown("CondMailAutoConfiguration.condMailSender");
    assert rkAutoConditions("CondMailAutoConfiguration.condMailSender")
        == "P|rakun.cond.mail.from|noreply";
    assert rkAutoProvided("CondMailAutoConfiguration.condMailSender")
        == "CondMailSender";
    assert rkAutoConditions("LateAutoConfiguration.condAuditTrail") == "";
    assert rkAutoProvided("LateAutoConfiguration.condAuditTrail")
        == "CondAuditTrail";
}

test "rakun conditions: #[conditionalOnBean] and #[profile] serialise their own letters" {
    val _beans = rkInstallBeans(beans());
    assert rkAutoConditions("LateAutoConfiguration")
        == "B|PlainAutoConfiguration;F|prod";
    assert recordKind("B|X") == beanRecord();
    assert recordKind("F|prod") == profileRecord();
}

test "rakun conditions: #[profile] on a stereotype registers the component itself" {
    val _beans = rkInstallBeans(beans());
    assert rkAutoKnown("CondStagingService");
    assert rkAutoConditions("CondStagingService") == "F|staging";
    assert rkAutoProvided("CondStagingService") == "CondStagingService";
    assert rkAutoBefore("CondStagingService") == "";
}

test "rakun conditions: every registration this file made is in the table" {
    val _beans = rkInstallBeans(beans());
    val names = rkAutoNames();
    assert names.contains("PlainAutoConfiguration");
    assert names.contains("CondMailAutoConfiguration");
    assert names.contains("CondMailAutoConfiguration.condMailSender");
    assert names.contains("LateAutoConfiguration");
    assert names.contains("LateAutoConfiguration.condAuditTrail");
    assert names.contains("CondStagingService");
}

// ── reading one record ──────────────────────────────────────────────────────

test "rakun conditions: a record splits into its kind and its fields" {
    val _beans = rkInstallBeans(beans());
    assert recordField("P|a.b.c|value", 0) == "P";
    assert recordField("P|a.b.c|value", 1) == "a.b.c";
    assert recordField("P|a.b.c|value", 2) == "value";
    assert recordField("M|only", 2) == "";
    assert splitBlob("").length == 0;
    assert anyValue() == "*";
}

// ── the evaluator, letter by letter ─────────────────────────────────────────

test "rakun conditions: M is answered by the manifest and never guesses" {
    val _beans = rkInstallBeans(beans());
    assert rkModulePresent("rakun-data") == false;
    val none: string[] = [];
    val v = evaluateRecord("M|rakun-data", none);
    assert v.ok == false;
    assert v.record == "M|rakun-data";
    // rakun core declares `validation` alone (decision 326): the observed
    // value is the set it looked at, never a guess.
    assert v.observed == "resolved dependencies: validation";
}

test "rakun conditions: P with * is set-and-non-empty, and an exact value is exact" {
    val _beans = rkInstallBeans(beans());
    val none: string[] = [];
    val _ = rkSetProp("rakun.cond.probe", "");
    assert evaluateRecord("P|rakun.cond.probe|*", none).ok == false;
    assert evaluateRecord("P|rakun.cond.probe|*", none).observed
        == "the property is empty";
    val _s = rkSetProp("rakun.cond.probe", "smtp.example.com");
    assert evaluateRecord("P|rakun.cond.probe|*", none).ok;
    assert evaluateRecord("P|rakun.cond.probe|smtp.example.com", none).ok;
    val wrong = evaluateRecord("P|rakun.cond.probe|other", none);
    assert wrong.ok == false;
    assert wrong.observed == "the property is 'smtp.example.com'";
}

test "rakun conditions: B and X read the registered set, provided names included" {
    val _beans = rkInstallBeans(beans());
    val none: string[] = [];
    assert evaluateRecord("B|CondStagingService", none).ok;
    assert evaluateRecord("X|CondStagingService", none).ok == false;
    assert evaluateRecord("X|CondStagingService", none).observed
        == "a bean named 'CondStagingService' is already registered";
    assert evaluateRecord("B|NeverRegistered", none).ok == false;
    assert evaluateRecord("B|NeverRegistered", none).observed
        == "no bean named 'NeverRegistered' is registered";
    val supplied = ["NeverRegistered"];
    assert evaluateRecord("B|NeverRegistered", supplied).ok;
    assert evaluateRecord("X|NeverRegistered", supplied).ok == false;
    assert registeredNames(supplied).contains("NeverRegistered");
}

test "rakun conditions: F reads front 05's set and names which set it read" {
    val _beans = rkInstallBeans(beans());
    val none: string[] = [];
    val _ = setResolved([]);
    assert profilesAreDefaulted();
    assert activeProfiles().join(",") == "default";
    assert defaultProfiles().join(",") == "default";
    assert profileObserved()
        == "no profile is active; the default profile is 'default'";
    assert evaluateRecord("F|prod", none).ok == false;
    assert evaluateRecord("F|default", none).ok;
    val _a = setResolved(["dev", "local"]);
    assert profilesAreDefaulted() == false;
    assert profileObserved() == "active profiles: dev,local";
    assert evaluateRecord("F|dev", none).ok;
    val missed = evaluateRecord("F|prod", none);
    assert missed.ok == false;
    assert missed.observed == "active profiles: dev,local";
    val _r = setResolved([]);
}

test "rakun conditions: a named default profile is the one the report names" {
    val _beans = rkInstallBeans(beans());
    val none: string[] = [];
    val _r = setResolved([]);
    val _d = rkSetProp("rakun.profiles.default", "fallback");
    assert activeProfiles().join(",") == "fallback";
    assert profileObserved()
        == "no profile is active; the default profile is 'fallback'";
    assert evaluateRecord("F|fallback", none).ok;
    val _c = rkSetProp("rakun.profiles.default", "");
}

test "rakun conditions: what an entry provides is a cell, not a sixth record letter" {
    val _beans = rkInstallBeans(beans());
    val none: string[] = [];
    assert rkAutoProvided("NeverRegisteredAtAll") == "";
    try asserts.throwsWith({ ->
        evaluateRecord("V|Anything", none);
        0;
    }, unknownRecordProblem("V|Anything"));
}

test "rakun conditions: an unknown record letter is refused, not ignored" {
    val _beans = rkInstallBeans(beans());
    val none: string[] = [];
    try asserts.throwsWith({ ->
        evaluateRecord("Q|mystery", none);
        0;
    }, unknownRecordProblem("Q|mystery"));
}

// ── short circuit ───────────────────────────────────────────────────────────

test "rakun conditions: the FIRST failing record wins and the rest are not read" {
    val _beans = rkInstallBeans(beans());
    val none: string[] = [];
    val _a = rkSetProp("rakun.cond.first", "");
    val _b = rkSetProp("rakun.cond.second", "");
    val v = evaluateBlob("P|rakun.cond.first|*;P|rakun.cond.second|*", none);
    assert v.ok == false;
    assert v.record == "P|rakun.cond.first|*";
    val _c = rkSetProp("rakun.cond.first", "set");
    val w = evaluateBlob("P|rakun.cond.first|*;P|rakun.cond.second|*", none);
    assert w.record == "P|rakun.cond.second|*";
}

test "rakun conditions: an empty blob matches" {
    val _beans = rkInstallBeans(beans());
    val none: string[] = [];
    assert evaluateBlob("", none).ok;
    assert evaluateBlob("", none).record == "";
}

// ── the manifest ────────────────────────────────────────────────────────────

fn depsOf(text: string) -> string {
    val none: string[] = [];
    return manifestDependencies(text).unwrapOr(none).join(",");
}

fn manifestRefusal(text: string) -> string {
    return case manifestDependencies(text) {
        Ok(_names) -> "";
        Error(e) -> e;
    };
}

test "rakun conditions: both on-disk shapes of dependencies normalise to one list" {
    val _beans = rkInstallBeans(beans());
    assert depsOf("{\"dependencies\": [\"rakun\", \"std\"]}") == "rakun,std";
    assert depsOf(
        "{\"dependencies\": {\"rakun\": {\"workspace\": true}, \"std\": {}}}",
    )
        == "rakun,std";
    assert manifestDependencies(
        "{\"name\": \"x\", \"targets\": [\"erlang\"]}",
    ).isOk();
    assert depsOf("{\"name\": \"x\", \"targets\": [\"erlang\"]}") == "";
    assert manifestDependencies("{\"dependencies\": {}}").isOk();
    assert depsOf("{\"dependencies\": {}}") == "";
}

test "rakun conditions: a nested value is never mistaken for a dependency name" {
    val _beans = rkInstallBeans(beans());
    assert depsOf(
        "{\"dependencies\": {\"rakun\": {\"workspace\": true, \"version\": \"0.0.1\"}}}",
    )
        == "rakun";
}

test "rakun conditions: a manifest std's json refuses is refused, never scanned" {
    val _beans = rkInstallBeans(beans());
    assert manifestRefusal("{\"dependencies\": [\"rakun\",]}").startsWith(
        manifestShapeProblem("is not JSON - "),
    );
    assert manifestRefusal(
        "{\"dependencies\": [\"a\"], \"dependencies\": [\"b\"]}",
    ).startsWith(manifestShapeProblem("is not JSON - "));
    assert manifestRefusal("[\"rakun\"]")
        == manifestShapeProblem("is not a JSON object");
    assert manifestRefusal("{\"dependencies\": \"rakun\"}")
        == manifestShapeProblem(
            "declares `dependencies` as neither an array of names nor an object keyed by name",
        );
    assert manifestRefusal("{\"dependencies\": [\"rakun\", 1]}")
        == manifestShapeProblem("lists a dependency that is not a string");
}

test "rakun conditions: the manifest is read off disk in both shapes" {
    val _beans = rkInstallBeans(beans());
    assert moduleListIn(
        "test/fixtures/autoconfig/deps-array/botopink.json",
    ).join(",")
        == "rakun,rakun-data";
    assert moduleListIn(
        "test/fixtures/autoconfig/deps-object/botopink.json",
    ).join(",")
        == "rakun,rakun-mail";
    assert manifestName() == "botopink.json";
}

test "rakun conditions: a manifest that cannot be read is a refusal, not a false" {
    val _beans = rkInstallBeans(beans());
    try asserts.throwsWith({ ->
        moduleListIn("test/fixtures/autoconfig/does-not-exist/botopink.json");
        0;
    }, manifestMissingProblem());
}

test "rakun conditions: rakun core's own manifest declares validation alone" {
    val _beans = rkInstallBeans(beans());
    assert moduleList().length == 1;
    assert moduleList().at(0) ?? "" == "validation";
    assert rkModulePresent("rakun") == false;
}

test "rakun conditions: a non-ASCII description before the dependencies does not shift the scan" {
    val _beans = rkInstallBeans(beans());
    val text = "{\"name\": \"x\", \"description\": \"caf\u{e9} — na\u{ef}ve\", \"dependencies\": {\"rakun\": {\"workspace\": true}, \"rakun-web\": {\"path\": \"../w\"}}}";
    assert manifestDependencyNames(text).join(",")
        == "rakun,rakun-web", manifestDependencyNames(text).join(",");
}
