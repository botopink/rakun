//// rakun — the file-convention route table.
////
//// Every assertion here runs on BOTH rows (`botopink test` and
//// `botopink test --target erlang`) from this one file, which is the point of a
//// boundary front: a wire format or a precedence order only one target agrees
//// with is the bug this front exists to prevent.

import {
    parseSegment,
    parsePath,
    patternOf,
    slotOf,
    pathProblem,
    kindName,
    trimSlashes,
    RouteEntry,
    parseTable,
    writeTable,
    kindLabel,
    matchPath,
    layoutChain,
    splitPath,
    attempt,
    paramOf,
    PageContext,
    LayoutProps,
    emptyParams,
    entryLine,
    rkAppHandler,
    rkAppTable,
    rkAppCount,
    rkAppHasRender,
    rkAppRender,
    rkAppReset,
    appTable,
    contextOf,
    ctxParam,
    paramsOf,
    rkAppPage,
    rkAppLayout,
} from "file_router";
import {Request} from "http";
import {dict} from "std";

// The eight `kind` letters, one entry each — the table this front's contract
// with fronts 23, 25, 27, 30, 31, 60, 61 and 66 is written in.
fn eightKinds() -> RouteEntry[] {
    return [
        RouteEntry(kind: "L", pattern: "/", slot: "", verb: ""),
        RouteEntry(kind: "T", pattern: "/blog", slot: "", verb: ""),
        RouteEntry(kind: "P", pattern: "/blog/[slug]", slot: "", verb: ""),
        RouteEntry(kind: "D", pattern: "/dashboard", slot: "team", verb: ""),
        RouteEntry(kind: "R", pattern: "/api/posts", slot: "", verb: "GET"),
        RouteEntry(kind: "S", pattern: "/shop/[...slug]", slot: "", verb: ""),
        RouteEntry(kind: "E", pattern: "/docs/[[...slug]]", slot: "", verb: ""),
        RouteEntry(kind: "N", pattern: "/", slot: "", verb: ""),
    ];
}

// ── step 1: the segment grammar ─────────────────────────────────────────────

test "rakun routing: a static folder is a static segment" {
    val s = parseSegment("blog");
    assert kindName(s.kind) == "Static";
    assert s.name == "blog";
    assert s.raw == "blog";
}

test "rakun routing: [slug] is a dynamic segment" {
    val s = parseSegment("[slug]");
    assert kindName(s.kind) == "Dynamic";
    assert s.name == "slug";
    assert s.raw == "[slug]";
}

test "rakun routing: the catch-all and the optional catch-all are told apart" {
    val required = parseSegment("[...slug]");
    val optional = parseSegment("[[...slug]]");
    assert kindName(required.kind) == "CatchAll";
    assert required.name == "slug";
    assert kindName(optional.kind) == "OptionalCatchAll";
    assert optional.name == "slug";
    assert kindName(optional.kind) != kindName(required.kind);
    assert optional.raw != required.raw;
}

test "rakun routing: a group, a slot and a private folder" {
    val g = parseSegment("(marketing)");
    assert kindName(g.kind) == "Group";
    assert g.name == "marketing";
    val s = parseSegment("@team");
    assert kindName(s.kind) == "Slot";
    assert s.name == "team";
    val p = parseSegment("_components");
    assert kindName(p.kind) == "Private";
    assert p.name == "components";
}

test "rakun routing: a group contributes no URL segment" {
    assert patternOf(parsePath("(marketing)/about")) == "/about";
    assert patternOf(parsePath("")) == "/";
    assert patternOf(parsePath("blog")) == "/blog";
    assert patternOf(parsePath("blog/[slug]")) == "/blog/[slug]";
}

test "rakun routing: a slot contributes no URL segment and names itself" {
    val segs = parsePath("dashboard/@team/settings");
    assert patternOf(segs) == "/dashboard/settings";
    assert slotOf(segs) == "team";
    assert slotOf(parsePath("dashboard/settings")) == "";
}

test "rakun routing: a private folder may not appear on a registered path" {
    val problem = pathProblem("blog/_drafts/[slug]");
    assert problem != "";
    assert problem.contains("_drafts");
    assert pathProblem("blog/[slug]") == "";
}

test "rakun routing: a `|` or a newline in a segment is refused by name" {
    val bar = pathProblem("blog/a|b");
    assert bar != "";
    assert bar.contains("a|b");
    val nl = pathProblem("blog/a\nb");
    assert nl != "";
    assert nl.contains("newline");
}

test "rakun routing: a leading or trailing slash is not a segment" {
    assert trimSlashes("/blog/") == "blog";
    assert patternOf(parsePath("/blog/[slug]/")) == "/blog/[slug]";
}

// ── step 3: the wire format ─────────────────────────────────────────────────

test "rakun routing: the wire format round-trips all eight kinds, field by field" {
    val xs = eightKinds();
    val back = parseTable(writeTable(xs));
    assert back.length == xs.length;
    var i = 0;
    while (i < xs.length) {
        val a = xs.at(i).unwrapOr(RouteEntry(kind: "?", pattern: "?", slot: "?", verb: "?"));
        val b = back.at(i).unwrapOr(RouteEntry(kind: "!", pattern: "!", slot: "!", verb: "!"));
        assert a.kind == b.kind;
        assert a.pattern == b.pattern;
        assert a.slot == b.slot;
        assert a.verb == b.verb;
        i = i + 1;
    };
}

test "rakun routing: writeTable keeps registration order and ends no line with a bar" {
    val wire = writeTable(eightKinds());
    val lines = wire.split("\n");
    assert lines.length == 8;
    assert lines.at(0).unwrapOr("") == "L|/";
    assert lines.at(3).unwrapOr("") == "D|/dashboard|team";
    assert lines.at(4).unwrapOr("") == "R|/api/posts||GET";
    for (lines) { line ->
        assert line.endsWith("|").negate();
    };
}

test "rakun routing: an empty wire is an empty table" {
    assert parseTable("").length == 0;
    assert writeTable([]) == "";
}

test "rakun routing: each kind letter has a name" {
    assert kindLabel("L") == "layout";
    assert kindLabel("T") == "template";
    assert kindLabel("P") == "page";
    assert kindLabel("D") == "default";
    assert kindLabel("R") == "route";
    assert kindLabel("S") == "loading";
    assert kindLabel("E") == "error";
    assert kindLabel("N") == "not-found";
    assert kindLabel("Z") == "";
}

// ── step 4: the matcher ─────────────────────────────────────────────────────

fn blogTable() -> RouteEntry[] {
    return [
        RouteEntry(kind: "L", pattern: "/", slot: "", verb: ""),
        RouteEntry(kind: "L", pattern: "/blog", slot: "", verb: ""),
        RouteEntry(kind: "L", pattern: "/blog/[slug]", slot: "", verb: ""),
        RouteEntry(kind: "P", pattern: "/blog/[slug]", slot: "", verb: ""),
    ];
}

test "rakun routing: a dynamic segment binds its parameter" {
    val m = matchPath(blogTable(), "/blog/hello");
    var slug = "";
    var pattern = "";
    if (m) { hit ->
        slug = paramOf(hit, "slug");
        pattern = hit.entry.pattern;
    };
    assert pattern == "/blog/[slug]";
    assert slug == "hello";
}

test "rakun routing: a catch-all binds the remainder and fills rest" {
    val table = [RouteEntry(kind: "P", pattern: "/shop/[...slug]", slot: "", verb: "")];
    val m = matchPath(table, "/shop/a/b");
    var slug = "";
    var rest: string[] = [];
    if (m) { hit ->
        slug = paramOf(hit, "slug");
        rest = hit.rest;
    };
    assert slug == "a/b";
    assert rest.length == 2;
    assert rest.at(0).unwrapOr("") == "a";
    assert rest.at(1).unwrapOr("") == "b";
}

test "rakun routing: a required catch-all does not match its own bare prefix" {
    val table = [RouteEntry(kind: "P", pattern: "/shop/[...slug]", slot: "", verb: "")];
    var matched = true;
    if (matchPath(table, "/shop")) { _ -> matched = true; } else { matched = false; };
    assert matched.negate();
}

test "rakun routing: an optional catch-all matches with and without a remainder" {
    val table = [RouteEntry(kind: "P", pattern: "/docs/[[...slug]]", slot: "", verb: "")];
    var bareRest = 0 - 1;
    if (matchPath(table, "/docs")) { hit -> bareRest = hit.rest.length; };
    assert bareRest == 0;
    var deep: string[] = [];
    if (matchPath(table, "/docs/a/b")) { hit -> deep = hit.rest; };
    assert deep.length == 2;
    assert deep.join("/") == "a/b";
}

test "rakun routing: a static entry beats a dynamic one for the same URL" {
    val table = [
        RouteEntry(kind: "P", pattern: "/blog/[slug]", slot: "", verb: ""),
        RouteEntry(kind: "P", pattern: "/blog/new", slot: "", verb: ""),
    ];
    var pattern = "";
    if (matchPath(table, "/blog/new")) { hit -> pattern = hit.entry.pattern; };
    assert pattern == "/blog/new";
    var other = "";
    if (matchPath(table, "/blog/x")) { hit -> other = hit.entry.pattern; };
    assert other == "/blog/[slug]";
}

test "rakun routing: a dynamic segment beats a catch-all at the same depth" {
    val table = [
        RouteEntry(kind: "P", pattern: "/shop/[...rest]", slot: "", verb: ""),
        RouteEntry(kind: "P", pattern: "/shop/[id]", slot: "", verb: ""),
    ];
    var pattern = "";
    if (matchPath(table, "/shop/7")) { hit -> pattern = hit.entry.pattern; };
    assert pattern == "/shop/[id]";
}

test "rakun routing: registration order decides between two equal scores" {
    val table = [
        RouteEntry(kind: "P", pattern: "/x/[a]", slot: "", verb: ""),
        RouteEntry(kind: "P", pattern: "/x/[b]", slot: "", verb: ""),
    ];
    var name = "";
    if (matchPath(table, "/x/1")) { hit -> name = hit.entry.pattern; };
    assert name == "/x/[a]";
}

test "rakun routing: a layout alone does not make a route public" {
    val table = [
        RouteEntry(kind: "L", pattern: "/", slot: "", verb: ""),
        RouteEntry(kind: "L", pattern: "/settings", slot: "", verb: ""),
    ];
    var matched = true;
    if (matchPath(table, "/settings")) { _ -> matched = true; } else { matched = false; };
    assert matched.negate();
    val withPage = [
        RouteEntry(kind: "L", pattern: "/settings", slot: "", verb: ""),
        RouteEntry(kind: "R", pattern: "/settings", slot: "", verb: "POST"),
    ];
    var kind = "";
    if (matchPath(withPage, "/settings")) { hit -> kind = hit.entry.kind; };
    assert kind == "R";
}

test "rakun routing: a slot entry is not a candidate for a plain URL match" {
    val table = [
        RouteEntry(kind: "P", pattern: "/dashboard", slot: "team", verb: ""),
    ];
    var matched = true;
    if (matchPath(table, "/dashboard")) { _ -> matched = true; } else { matched = false; };
    assert matched.negate();
}

test "rakun routing: the layout chain is root-first and skips what has no layout" {
    val chain = layoutChain(blogTable(), "/blog/[slug]");
    assert chain.length == 3;
    assert chain.at(0).unwrapOr(RouteEntry(kind: "", pattern: "", slot: "", verb: "")).pattern == "/";
    assert chain.at(1).unwrapOr(RouteEntry(kind: "", pattern: "", slot: "", verb: "")).pattern == "/blog";
    assert chain.at(2).unwrapOr(RouteEntry(kind: "", pattern: "", slot: "", verb: "")).pattern == "/blog/[slug]";
    val sparse = [
        RouteEntry(kind: "L", pattern: "/", slot: "", verb: ""),
        RouteEntry(kind: "L", pattern: "/blog/[slug]", slot: "", verb: ""),
    ];
    assert layoutChain(sparse, "/blog/[slug]").length == 2;
}

test "rakun routing: a group never reaches the chain because it is not in a pattern" {
    val pattern = patternOf(parsePath("(marketing)/about"));
    val table = [
        RouteEntry(kind: "L", pattern: "/", slot: "", verb: ""),
        RouteEntry(kind: "L", pattern: patternOf(parsePath("(marketing)")), slot: "", verb: ""),
        RouteEntry(kind: "P", pattern: pattern, slot: "", verb: ""),
    ];
    assert pattern == "/about";
    val chain = layoutChain(table, pattern);
    assert chain.length == 2;
    assert chain.at(0).unwrapOr(RouteEntry(kind: "", pattern: "", slot: "", verb: "")).pattern == "/";
    assert chain.at(1).unwrapOr(RouteEntry(kind: "", pattern: "", slot: "", verb: "")).pattern == "/";
    var found = "";
    if (matchPath(table, "/about")) { hit -> found = hit.entry.pattern; };
    assert found == "/about";
}

test "rakun routing: a match carries its own layout chain" {
    var depth = 0;
    if (matchPath(blogTable(), "/blog/hello")) { hit -> depth = hit.chain.length; };
    assert depth == 3;
}

test "rakun routing: splitPath and attempt are total on odd input" {
    assert splitPath("///").length == 0;
    assert splitPath("/a//b/").length == 2;
    assert attempt("/blog/[slug]", "/blog").ok.negate();
    assert attempt("/blog", "/blog/x").ok.negate();
    assert attempt("/", "/").ok;
}

// ── step 2: the registry ────────────────────────────────────────────────────
//
// `El` is `string` here: `Element` is jhonstart's type and rakun declares no
// dependency on it, which is exactly why every registry cell is generic.

#[@future]
fn probePage(route: PageContext) -> @Future<string> {
    return "page:" + route.pattern;
}

fn probeLayout(props: LayoutProps<string>) -> string {
    return "layout:" + props.children;
}

fn noLayout(props: LayoutProps<string>) -> string {
    return "none:" + props.children;
}

fn probeHandler(req: Request) -> string {
    return "handled";
}

fn rootContext() -> PageContext {
    val none: string[] = [];
    return PageContext(
        pathname: "/",
        pattern: "/",
        params: emptyParams(),
        query: emptyParams(),
        rest: none,
    );
}

test "rakun routing: a record becomes one line of the host table" {
    assert entryLine("P", "blog/[slug]", "") == "P|/blog/[slug]";
    assert entryLine("L", "", "") == "L|/";
    assert entryLine("D", "dashboard/@team", "") == "D|/dashboard|team";
    assert entryLine("R", "api/posts", "GET") == "R|/api/posts||GET";
    assert entryLine("P", "(marketing)/about", "") == "P|/about";
}

test "rakun routing: the registry appends in order and keeps each renderer" {
    val _reset = rkAppReset();
    val _l = rkAppLayout("", { props -> probeLayout(props) });
    val _p = rkAppPage("blog/[slug]", { route -> probePage(route) });
    val _h = rkAppHandler("GET", "api/posts", { req -> probeHandler(req) });
    assert rkAppCount() == 3;
    assert rkAppTable() == "L|/\nP|/blog/[slug]\nR|/api/posts||GET";
    val back = appTable();
    assert back.length == 3;
    assert back.at(1).unwrapOr(RouteEntry(kind: "", pattern: "", slot: "", verb: "")).kind == "P";
    assert rkAppHasRender("L|/");
    assert rkAppHasRender("P|/blog/[slug]");
    assert rkAppHasRender("P|/nothing-registered").negate();
}

test "rakun routing: a registered renderer comes back callable, with a fallback" {
    val _reset = rkAppReset();
    val _l = rkAppLayout("", { props -> probeLayout(props) });
    val found = rkAppRender("L|/", { props -> noLayout(props) });
    val lp = LayoutProps(route: rootContext(), children: "x", slots: dict.empty());
    assert found(lp) == "layout:x";
    val missing = rkAppRender("L|/nothing", { props -> noLayout(props) });
    assert missing(lp) == "none:x";
}

test "rakun routing: the host table and the botopink matcher agree" {
    val _reset = rkAppReset();
    val _l = rkAppLayout("", { props -> probeLayout(props) });
    val _b = rkAppLayout("blog", { props -> probeLayout(props) });
    val _p = rkAppPage("blog/[slug]", { route -> probePage(route) });
    val table = appTable();
    var slug = "";
    var depth = 0;
    if (matchPath(table, "/blog/hello")) { hit ->
        slug = paramOf(hit, "slug");
        depth = hit.chain.length;
    };
    assert slug == "hello";
    assert depth == 2;
}

test "rakun routing: a context carries the match through to a page" {
    val _reset = rkAppReset();
    val _p = rkAppPage("blog/[slug]", { route -> probePage(route) });
    val table = appTable();
    var pattern = "";
    var pathname = "";
    if (matchPath(table, "/blog/hello")) { hit ->
        val ctx = contextOf(hit, "/blog/hello", emptyParams());
        pattern = ctx.pattern;
        pathname = ctx.pathname;
    };
    assert pattern == "/blog/[slug]";
    assert pathname == "/blog/hello";
}
