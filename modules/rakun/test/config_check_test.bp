//// rakun — boot-time configuration validation (front 14 step 6), over the bundled
//// `validation` library; moved here from the retired validation member.
////
//// Front 14 owns the CONSTRAINTS; front 05 owns the MOMENT. This file asserts
//// the half this front can assert: that a record carrying BOTH
//// `#[configurationProperties]` (front 05, `modules/rakun/src/config.bp`) and
//// `#[validated]` (this module) binds and then validates, that the refusal
//// names property KEYS rather than field names, and that the name front 05
//// builds — `validate` + the type name — is the name that exists.
////
//// WHAT THIS FILE CANNOT ASSERT, and why. The call itself is front 05's:
//// `rkConfigValidate` is named in `config.bp`'s comment ("until 14 lands this
//// is placement only, and `rkConfigValidate` has nothing to run") and does not
//// exist in the tree. `modules/rakun/**` is not this front's to edit, so the
//// boot path's call site is reported rather than written. Everything the call
//// site would need is here and is exercised below.
////
//// The HALT is an `assert` inside `refuseInvalidConfig`, which aborts the
//// process it runs in. A test cannot observe an abort and keep running, so the
//// refusal TEXT is asserted directly and the halt is exercised only on the
//// valid path, where it does not fire.
////
//// NOTE ON `#[validated]`. It is the bundled `validation` library's; front
//// 05's placement-only marker left `config.bp` when the library landed, because
//// a same-named decorator in this package shadowed the imported one.

import {decorators.validated, decorators.notBlank, decorators.minValue, decorators.maxValue, decorators.pattern, decorators.sizeBetween} from "validation";
import {
    report: {ValidationReport, Violation},
    table.constraintTableJson,
    constraints: {vNotBlank, vMinValueI32, vMaxValueI32, vPattern, vSizeBetween},
    spi.vConstraint,
    messages.templateFor,
} from "validation";
import {configurationProperties, defaultValue};
import {rkSetProp, rkProp};
import {rkSingleton, rkValueOr, rkPropBool, rkPropIntOr, rkPropFloat, rkPropList, rkPropDuration, rkPropSize, rkRegisterConfigKeys};
import {rkConfigCheckRegister, rkConfigCheckRun, rkBuildCount};
import {propertyKey, violationLine, configProblem, configProblemOf, refuseInvalidConfig, installMessageSource} from "config_check";
import {bootSequenceFor} from "context";
import {testing.asserts} from "std";

#[validated]
#[configurationProperties("app.billing")]
pub type BillingConfig(
    #[notBlank]
    #[pattern("^https?://.+$")]
    endpoint: string,

    #[minValue(1)]
    #[maxValue(10)]
    retryLimit: i32,
)

fn seed(endpoint: string, retries: string) -> i32 {
    val _a = rkSetProp("app.billing.endpoint", endpoint);
    return rkSetProp("app.billing.retryLimit", retries);
}

fn bound() -> BillingConfig {
    return __rkBind_BillingConfig("app.billing");
}

// ── the seam ────────────────────────────────────────────────────────────────

test "rakun validation: the name front 05 builds is the name that exists" {
    val _s = seed("https://billing.example.com", "3");
    val report = validateBillingConfig(bound());
    assert report.isValid();
    assert refuseInvalidConfig("BillingConfig", "app.billing", report) == 0;
}

test "rakun validation: a bound-but-invalid configuration is refused, with every violation" {
    val _s = seed("", "42");
    val cfg = bound();
    assert cfg.endpoint == "";
    assert cfg.retryLimit == 42;
    val report = validateBillingConfig(cfg);
    assert report.isValid() == false;
    assert report.violations.map({ v -> v.code }).join(",") == "notBlank,pattern,maxValue";
}

test "rakun validation: every line of the refusal names its property key" {
    val _s = seed("", "42");
    val text = configProblem("BillingConfig", "app.billing", validateBillingConfig(bound()));
    assert text.contains("`BillingConfig` is not valid");
    assert text.contains("  app.billing.endpoint: must not be blank (notBlank)");
    assert text.contains("  app.billing.retryLimit: must be at most 10 (maxValue)");
    assert text.contains("  endpoint:") == false;
}

test "rakun validation: the key is the prefix plus the field, and bare without one" {
    assert propertyKey("app.billing", "retryLimit") == "app.billing.retryLimit";
    assert propertyKey("", "retryLimit") == "retryLimit";
    val v = Violation(
        field: "retryLimit",
        code: "maxValue",
        message: "must be at most 10",
        invalidValue: "42",
    );
    assert violationLine("app.billing", v) == "  app.billing.retryLimit: must be at most 10 (maxValue)";
}

test "rakun validation: a valid configuration costs one pass over the violations" {
    val _s = seed("http://x.test", "1");
    val report = validateBillingConfig(bound());
    assert report.violations.length == 0;
    assert refuseInvalidConfig("BillingConfig", "app.billing", report) == 0;
    assert configProblem("BillingConfig", "app.billing", report) == "rakun config: `BillingConfig` is not valid - the application will not start\n";
}

test "rakun validation: the configuration record's table crosses like any other" {
    assert constraintsOfBillingConfig() == "{\"type\":\"BillingConfig\",\"fields\":[{\"name\":\"endpoint\",\"constraints\":[{\"code\":\"notBlank\"},{\"code\":\"pattern\",\"regex\":\"^https?://.+$\"}]},{\"name\":\"retryLimit\",\"constraints\":[{\"code\":\"minValue\",\"min\":1},{\"code\":\"maxValue\",\"max\":10}]}]}";
}

test "rakun validation: rakun's message source answers from rakun's keys" {
    val _i = installMessageSource();
    val _p = rkSetProp("rakun.validation.messages.notBlank", "is required");
    assert templateFor("notBlank", "must not be blank") == "is required";
    val _q = rkSetProp("rakun.validation.messages.notBlank", "");
    assert templateFor("notBlank", "must not be blank") == "must not be blank";
}

// ── the boot check (front 05 step 9 · front 14 step 6) ──────────────────────
//
// `#[validated]` beside `#[configurationProperties]` registers a check at
// module load; `bootSequence` runs every check after the property sources are
// loaded and before the eager pass constructs anything. Each test below that
// seeds an invalid value re-seeds a valid one before it ends: the check is
// registered for the whole run, and a later file's `bootSequence` runs it too.

#[validated]
#[configurationProperties("app.mail")]
pub type MailConfig(
    #[sizeBetween(3, 8)]
    sender: string,
)

fn validMail() -> i32 {
    val _b = seed("http://x.test", "1");
    return rkSetProp("app.mail.sender", "robot");
}

test "rakun validation: a #[validated] configuration record is a registered boot check" {
    val _v = validMail();
    assert rkConfigCheckRun() == "";
    val _s = seed("", "1");
    val refusal = rkConfigCheckRun();
    val _r = validMail();
    assert refusal.contains("`BillingConfig` is not valid - the application will not start");
    assert refusal.contains("  app.billing.endpoint: must not be blank (notBlank)");
    assert refusal.contains("MailConfig") == false;
}

test "rakun validation: an invalid configuration halts the boot before any component is constructed" {
    val _s = seed("http://x.test", "42");
    val before = rkBuildCount("OrderCache");
    try asserts.throwsWith({ ->
        val _b = bootSequenceFor("config-check");
        0;
    }, "app.billing.retryLimit: must be at most 10 (maxValue)");
    val after = rkBuildCount("OrderCache");
    val _r = validMail();
    assert after == before;
}

test "rakun validation: two invalid records are one refusal naming both" {
    val _s = seed("", "1");
    val _m = rkSetProp("app.mail.sender", "x");
    val refusal = rkConfigCheckRun();
    val _r = validMail();
    assert refusal.contains("`BillingConfig` is not valid");
    assert refusal.contains("`MailConfig` is not valid");
    assert refusal.contains("  app.mail.sender:");
}

test "rakun validation: the boot's message source answers a violation's message from rakun.validation.messages" {
    val _i = installMessageSource();
    val _p = rkSetProp("rakun.validation.messages.sizeBetween", "needs 3 to 8 characters");
    val _m = rkSetProp("app.mail.sender", "x");
    val refusal = rkConfigCheckRun();
    val _q = rkSetProp("rakun.validation.messages.sizeBetween", "");
    val _r = validMail();
    assert refusal.contains("  app.mail.sender: needs 3 to 8 characters (sizeBetween)");
}
