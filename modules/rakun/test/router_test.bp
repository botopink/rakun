// rakun — router + DI integration: a controller→service→repository chain wired
// end to end by the decorators, exercised through `rkDispatch`.
//
// Run by `botopink test` from `libs/rakun/`. The component decorators `@emit`
// factories + route registrations; this test never names them — it dispatches a
// request and asserts the Response, which transitively builds the whole DI chain
// (F2: constructor injection) and runs the mapped handler (F4: router). The
// runtime fns the emitted code calls (`rkScan`/`rkEnter`/`rkDone`/
// `rkRegisterRoute`) are imported here because the wiring is spliced into this
// module.

import {decorators.repository, decorators.service, decorators.restController, decorators.route, decorators.getMapping};
import {http.Request, http.Response};
import {runtime.rkScan, runtime.rkSingleton, runtime.rkEnter, runtime.rkDone, runtime.rkRegisterRoute, runtime.rkDispatch, runtime.rkRouteCount};
import {collections.Dict} from "std";
import {context.rkResolve, context.rkAddBean, context.rkInstallBeans};

fn beans() -> Dict<string, unknown> {
    return comptime {
        var d: Dict<string, unknown> = Dict.empty();
        for (@TypeInfo.all(
            with: [service, repository, restController],
            member: "make",
        )) { b ->
            d = rkAddBean(d, b.name, b.value);
        }
        break d;
    };
}

#[repository]
type UserRepo() {
    pub fn all(self: Self) -> Array<string> {
        return ["ana", "bob"];
    }
}

#[service]
type UserService(
    // injected by type
    repo: UserRepo,
) {
    pub fn list(self: Self) -> Array<string> {
        return self.repo.all();
    }
}

#[restController]
#[route("/api/users")]
type UserController(
    // injected by type
    svc: UserService,
) {
    #[getMapping("/")]
    pub fn index(self: Self, req: Request) -> Response {
        return Response.json(self.svc.list().join(", "));
    }
}

test "rakun router: GET a mapped route builds the DI chain and returns 200" {
    val _beans = rkInstallBeans(beans());
    val resp = rkDispatch("GET", "/api/users/");
    assert resp.status == 200;
    assert resp.body == "ana, bob";
}

test "rakun router: an unmapped path returns 404" {
    val _beans = rkInstallBeans(beans());
    val resp = rkDispatch("GET", "/nope");
    assert resp.status == 404;
}

test "rakun router: the mapped route is registered" {
    val _beans = rkInstallBeans(beans());
    assert rkRouteCount() == 1;
}
