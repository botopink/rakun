//// rakun — the bean registry and the `Context` it is reached through.
////
//// Every assertion here runs on BOTH rows: the registry is one botopink
//// implementation over two host files that answer identically, so there is one
//// set of assertions and not two.
////
//// The `#[managed]` types sit at module level, so the `val`s they emit run at
//// LOAD, before the first test block — which is why nothing in this file calls
//// `rkBeanReset()`: it would wipe the registrations the file is about.

import {service, repository, restController, route, getMapping, configuration, bean} from "decorators";
import {rkScan, rkSingleton, rkEnter, rkDone, rkRegisterRoute, rkBuildCount, rkScannedNames, rkSetProp, rkProp} from "runtime";
import {Request, Response} from "http";
import {
    managed,
    provides,
    imports,
    qualifier,
    primary,
    lazy,
    scope,
    Bean,
    Scope,
    beanLine,
    parseBeans,
    scopeName,
    scopeOf,
    scopeProblem,
    ambiguousBeanProblem,
    duplicateBeanProblem,
    rkRegisterBean,
    rkRegisterBeanAt,
    rkBeanTable,
    rkBeanCount,
    rkBeanNames,
    rkBeanNamesIn,
    rkResolve,
    rkResolveIn,
    rkResolveNamed,
    rkHasBean,
    rkHasBeanIn,
    chooseBean,
    Context,
    childNameProblem,
    __rkMake_Context,
    rkCtxNote,
    rkCtxNotes,
    rkCtxNoteReset,
    rkCtxBump,
    rkCtxCount,
    rkRequestScoped,
    rkRequestScopeEnd,
    eagerInit,
    eagerInitIn,
    bootSequence,
    lazyInitialization,
} from "context";
import {Event, event, publishEvent} from "events";
import {
    postConstruct,
    preDestroy,
    Hook,
    hookLine,
    parseHooks,
    rkRegisterLifecycle,
    rkLifecycleTable,
    rkLifecycleReset,
    lifecycleHooks,
    runPostConstruct,
    runPreDestroy,
    postConstructProblem,
    lifecyclePhaseProblem,
    exitCode,
    rkRegisterExitCode,
    rkExitValues,
    rkExitReset,
    processExitCode,
    shutdown,
} from "lifecycle";
import {testing.asserts} from "std";

// ── the components under test ───────────────────────────────────────────────

#[repository]
#[managed]
pub type OrderRepository() {
    pub fn ids(self: Self) -> string[] {
        return ["o-1", "o-2", "o-3"];
    }
}

#[service]
#[managed]
pub type OrderCache(
    repo: OrderRepository,
) {
    pub fn size(self: Self) -> i32 {
        return self.repo.ids().length;
    }
}

// Scanned but NOT `#[managed]`: it proves `beanNames()` is the registry and not
// the scan list.
#[service]
pub type UnregisteredService() {
    pub fn tag(self: Self) -> string {
        return "u";
    }
}

// ── the record grammar ──────────────────────────────────────────────────────

test "rakun context: a bean record round-trips through the wire line" {
    val b = Bean(
        path: "",
        typeName: "ZoneClock",
        qualifier: "fixed",
        scope: "singleton",
        primary: true,
        lazy: false,
        owner: "fixedZoneClock",
    );
    assert beanLine(b) == "|ZoneClock|fixed|singleton|1|0|fixedZoneClock";
    val back = parseBeans(beanLine(b));
    assert back.length == 1;
    val one = back.at(0);
    var seen = "";
    if (one != null) seen = one.typeName + "/" + one.qualifier + "/" + one.owner;
    assert seen == "ZoneClock/fixed/fixedZoneClock";
    var wasPrimary = false;
    if (one != null) wasPrimary = one.primary;
    assert wasPrimary;
}

test "rakun context: a scope name round-trips and an unknown one is refused" {
    assert scopeName(Scope.Singleton) == "singleton";
    assert scopeName(Scope.Prototype) == "prototype";
    assert scopeName(Scope.Request) == "request";
    assert scopeName(scopeOf("prototype")) == "prototype";
    try asserts.throwsWith({ ->
        scopeOf("session");
        0;
    }, scopeProblem("session"));
}

// ── step 1: the registry ────────────────────────────────────────────────────

test "rakun context: #[managed] on a #[service] registers exactly one bean" {
    var mine = 0;
    for (parseBeans(rkBeanTable())) { b ->
        if (b.typeName == "OrderCache") mine = mine + 1;
    };
    assert mine == 1;
    assert rkHasBean("OrderCache");
    assert rkHasBean("OrderRepository");
}

test "rakun context: a scanned type that is not #[managed] is not a bean" {
    assert !rkHasBean("UnregisteredService");
    assert !rkBeanNames().contains("UnregisteredService");
}

test "rakun context: beanNames lists registered beans in declaration order" {
    val names = rkBeanNames();
    val repo = names.indexOf("OrderRepository");
    val cache = names.indexOf("OrderCache");
    assert repo >= 0;
    assert cache > repo;
}

test "rakun context: the registered record carries the scope and the flags" {
    val record = chooseBean("", "OrderCache");
    assert record == "|OrderCache||singleton|0|0|OrderCache";
}

test "rakun context: an unregistered type resolves to null and has answers false" {
    val missing: ?OrderCache = rkResolve("NoSuchBean");
    var found = false;
    if (missing != null) found = true;
    assert !found;
    assert !rkHasBean("NoSuchBean");
    assert chooseBean("", "NoSuchBean") == "";
}

test "rakun context: registering the same type and qualifier twice names both owners" {
    val _a = rkRegisterBean("DupBean", "", "singleton", false, false, "firstOwner", { -> 1 });
    try asserts.throwsWith({ ->
        rkRegisterBean("DupBean", "", "singleton", false, false, "secondOwner", { -> 2 });
        0;
    }, duplicateBeanProblem("DupBean", "", "firstOwner", "secondOwner"));
}

test "rakun context: a resolved bean is the same instance field injection gives" {
    val cache: ?OrderCache = rkResolve("OrderCache");
    var size = -1;
    if (cache != null) size = cache.size();
    assert size == 3;
    val direct = __rkMake_OrderCache();
    assert rkBuildCount("OrderCache") == 1;
    assert direct.size() == 3;
}

// ── the parent/child chain ──────────────────────────────────────────────────

test "rakun context: a child path sees the parent's beans and the parent does not see the child's" {
    val _c = rkRegisterBeanAt("/request", "ScopedOnly", "", "singleton", false, false, "scopedOwner", { -> 7 });
    assert rkHasBeanIn("/request", "ScopedOnly");
    assert !rkHasBean("ScopedOnly");
    assert rkHasBeanIn("/request", "OrderCache");
    val v: ?i32 = rkResolveIn("/request", "ScopedOnly");
    assert v.unwrapOr(0) == 7;
    assert rkBeanNamesIn("/request").contains("ScopedOnly");
    assert !rkBeanNamesIn("").contains("ScopedOnly");
}

test "rakun context: the nearest registration of a type wins over an ancestor's" {
    val _p = rkRegisterBean("Layered", "", "singleton", false, false, "rootOwner", { -> 1 });
    val _c = rkRegisterBeanAt("/inner", "Layered", "", "singleton", false, false, "innerOwner", { -> 2 });
    val root: ?i32 = rkResolve("Layered");
    val inner: ?i32 = rkResolveIn("/inner", "Layered");
    assert root.unwrapOr(0) == 1;
    assert inner.unwrapOr(0) == 2;
}

test "rakun context: two candidates and no #[primary] name both owners" {
    val _a = rkRegisterBean("Tied", "left", "singleton", false, false, "leftMaker", { -> 1 });
    val _b = rkRegisterBean("Tied", "right", "singleton", false, false, "rightMaker", { -> 2 });
    assert rkHasBean("Tied");
    try asserts.throwsWith({ ->
        chooseBean("", "Tied");
        0;
    }, ambiguousBeanProblem("Tied", "'leftMaker', 'rightMaker'"));
    val right: ?i32 = rkResolveNamed("Tied", "right");
    assert right.unwrapOr(0) == 2;
}

test "rakun context: with one candidate marked #[primary] the unqualified resolve returns it" {
    val _a = rkRegisterBean("Picked", "left", "singleton", false, false, "leftMaker", { -> 1 });
    val _b = rkRegisterBean("Picked", "right", "singleton", true, false, "rightMaker", { -> 2 });
    val v: ?i32 = rkResolve("Picked");
    assert v.unwrapOr(0) == 2;
}

// ── step 2: `Context` ───────────────────────────────────────────────────────
//
// The receiver is ALWAYS an annotated local. `__rkMake_Context().resolve(...)`
// and `val ctx = __rkMake_Context();` both lose the optional's payload type —
// the optional a record method answers loses its type when the receiver is a
// call or an UNANNOTATED local (AGENTS.md § Language notes). `val ctx: Context`
// is the spelling that keeps `?OrderCache` an `?OrderCache`.

#[service]
#[managed]
pub type ContextHolder(
    // `Context` is injectable by type with no extra declaration: front 06 emits
    // its factory and `decorators.bp` emits `__rkMake_Context()` for the field.
    ctx: Context,
) {
    pub fn sees(self: Self, typeName: string) -> bool {
        return self.ctx.has(typeName);
    }
}

test "rakun context: ctx.resolve returns what field injection returns" {
    val ctx: Context = __rkMake_Context();
    val cache: ?OrderCache = ctx.resolve("OrderCache");
    var size = -1;
    if (cache != null) size = cache.size();
    assert size == 3;
    assert ctx.has("OrderCache");
    assert !ctx.has("Nonexistent");
    assert ctx.path() == "";
}

test "rakun context: a field of type Context is injected with no extra declaration" {
    val holder = __rkMake_ContextHolder();
    assert holder.sees("OrderCache");
    assert !holder.sees("Nonexistent");
}

test "rakun context: Context is not a bean of its own registry and is not in the cycle guard" {
    val ctx: Context = __rkMake_Context();
    assert !ctx.has("Context");
    assert !ctx.beanNames().contains("Context");
    // `rkEnter`/`rkDone` are what `rkBuildCount` counts; the Context factory
    // brackets nothing, so the guard never saw it.
    assert rkBuildCount("Context") == 0;
}

// The README's acceptance reads "ctx.beanNames() matches rkScannedNames()
// filtered to #[managed] types". That is true of `#[managed]` and false of the
// front's own `#[provides]`: a provided bean's TYPE is never scanned, because
// the scan registers component declarations and `ZoneClock` is not one. The
// registry is not a filter over the scan; it is its own table, and this
// asserts both halves.
test "rakun context: beanNames is the registry, not a filter over the scan list" {
    val ctx: Context = __rkMake_Context();
    val scanned = rkScannedNames();
    assert scanned.contains("OrderCache");
    assert ctx.beanNames().contains("OrderCache");
    assert ctx.beanNames().contains("ContextHolder");
    assert scanned.contains("UnregisteredService");
    assert !ctx.beanNames().contains("UnregisteredService");
    assert ctx.beanNames().contains("ZoneClock");
    assert !scanned.contains("ZoneClock");
}

test "rakun context: a child context finds a bean registered only in the parent" {
    val ctx: Context = __rkMake_Context();
    val kid: Context = ctx.child("request");
    assert kid.path() == "/request";
    val cache: ?OrderCache = kid.resolve("OrderCache");
    var size = -1;
    if (cache != null) size = cache.size();
    assert size == 3;
    assert kid.has("OrderCache");
    val grand: Context = kid.child("inner");
    assert grand.path() == "/request/inner";
    assert grand.has("OrderCache");
}

test "rakun context: a child needs a name and the name may not carry a separator" {
    val ctx: Context = __rkMake_Context();
    try asserts.throwsWith({ ->
        ctx.child("");
        0;
    }, childNameProblem());
    try asserts.throwsWith({ ->
        ctx.child("a/b");
        0;
    }, childNameProblem());
}

// ── step 3: `#[provides]`, qualifiers and primary ───────────────────────────

// NOT `Clock`: `overlapping_routes_test.bp` and `scopes_test.bp` each already
// declare one, and on the ERLANG row every test file shares one node and one
// `rkSingleton` ETS cache — so a type NAME repeated across test files is a real
// collision, and the loser's record reaches the winner's methods as
// `{error, undef}`. The node row runs each file in its own process and shows
// nothing. Measured while writing step 3.
pub type ZoneClock(
    zone: string,
) {
    pub fn stamp(self: Self) -> string {
        return "<now@" + self.zone + ">";
    }
}

// The #[primary] one owns `__rkMake_Clock`, so an unqualified field of type
// `ZoneClock` gets it and the unqualified `resolve` answers the same instance.
#[provides]
#[qualifier("system")]
#[primary]
pub fn systemZoneClock() -> ZoneClock {
    return ZoneClock(zone: "UTC");
}

#[provides]
#[qualifier("fixed")]
pub fn fixedZoneClock() -> ZoneClock {
    return ZoneClock(zone: "fixed");
}

// No qualifier at all: this one owns `__rkMake_Ledger` by being the only
// provider of its type.
pub type Ledger(
    name: string,
)

#[provides]
pub fn mainLedger() -> Ledger {
    return Ledger(name: "main");
}

// Two candidates, both qualified, NEITHER #[primary]: `__rkMake_Dye` is defined
// by neither, so nothing may field-inject a `Dye` and the unqualified resolve
// raises naming both.
pub type Dye(
    hue: string,
)

#[provides]
#[qualifier("warm")]
pub fn warmDye() -> Dye {
    return Dye(hue: "amber");
}

#[provides]
#[qualifier("cool")]
pub fn coolDye() -> Dye {
    return Dye(hue: "slate");
}

#[service]
#[managed]
pub type Stamper(
    // Unqualified, so the #[primary] ZoneClock wins — and it is the same instance
    // the registry hands back.
    clock: ZoneClock,
    ledger: Ledger,
) {
    pub fn stamp(self: Self) -> string {
        return self.ledger.name + self.clock.stamp();
    }
}

test "rakun context: #[provides] makes the return type injectable by type" {
    val s = __rkMake_Stamper();
    assert s.stamp() == "main<now@UTC>";
    assert rkHasBean("ZoneClock");
    assert rkHasBean("Ledger");
}

test "rakun context: two #[provides] of one type are told apart by qualifier" {
    val ctx: Context = __rkMake_Context();
    val fixed: ?ZoneClock = ctx.resolveNamed("ZoneClock", "fixed");
    var fz = "";
    if (fixed != null) fz = fixed.zone;
    val system: ?ZoneClock = ctx.resolveNamed("ZoneClock", "system");
    var sz = "";
    if (system != null) sz = system.zone;
    assert fz == "fixed";
    assert sz == "UTC";
}

test "rakun context: with one #[provides] marked #[primary] the unqualified resolve returns it" {
    val ctx: Context = __rkMake_Context();
    val any: ?ZoneClock = ctx.resolve("ZoneClock");
    var zone = "";
    if (any != null) zone = any.zone;
    assert zone == "UTC";
    // The same instance field injection gives: `__rkMake_Clock` is the primary
    // provider's own factory, so there is one `rkSingleton("ZoneClock", ...)` cell.
    val injected = __rkMake_Stamper();
    assert injected.clock.zone == "UTC";
}

test "rakun context: two qualified #[provides] and no #[primary] raise naming both" {
    val ctx: Context = __rkMake_Context();
    assert ctx.has("Dye");
    try asserts.throwsWith({ ->
        chooseBean("", "Dye");
        0;
    }, ambiguousBeanProblem("Dye", "'warmDye', 'coolDye'"));
    val warm: ?Dye = ctx.resolveNamed("Dye", "warm");
    var hue = "";
    if (warm != null) hue = warm.hue;
    assert hue == "amber";
}

test "rakun context: a qualified provider caches per qualifier, not per type" {
    val ctx: Context = __rkMake_Context();
    val a: ?Dye = ctx.resolveNamed("Dye", "warm");
    val b: ?Dye = ctx.resolveNamed("Dye", "cool");
    var ah = "";
    if (a != null) ah = a.hue;
    var bh = "";
    if (b != null) bh = b.hue;
    assert ah == "amber";
    assert bh == "slate";
}

// ── step 4: lifecycle ───────────────────────────────────────────────────────
//
// These blocks are ORDER-DEPENDENT and deliberately so: the `#[managed]` hooks
// below are registered at module LOAD, the post pass marks an entry done rather
// than leaving that to the caller, and `rkLifecycleReset()` wipes the table. So
// the two blocks that read and run the emitted hooks come first, and every block
// after them resets and registers its own.

#[service]
#[managed]
pub type WarmCache(
    repo: OrderRepository,
) {
    #[postConstruct]
    pub fn warm(self: Self) {
        val n = self.repo.ids().length;
        val _b = rkCtxBump("WarmCache.warm");
        val _s = rkCtxBump("warmSaw" + n.toString());
    }

    #[preDestroy]
    pub fn close(self: Self) {
        val _b = rkCtxBump("WarmCache.close");
    }
}

test "rakun lifecycle: #[managed] emits one registration per marked method" {
    val post = lifecycleHooks("post");
    var sawWarm = false;
    for (post) { h ->
        if ((h.owner == "WarmCache" && h.method == "warm")) sawWarm = true;
    };
    val pre = lifecycleHooks("pre");
    var sawClose = false;
    for (pre) { h ->
        if ((h.owner == "WarmCache" && h.method == "close")) sawClose = true;
    };
    assert sawWarm;
    assert sawClose;
    assert hookLine(Hook(owner: "WarmCache", method: "warm", phase: "post", order: 0)) == "WarmCache|warm|post|0";
}

test "rakun lifecycle: the post pass runs a hook exactly once and it sees its dependencies" {
    val _r = runPostConstruct();
    assert rkCtxCount("WarmCache.warm") == 1;
    // It reached the injected repository: three ids, counted inside the hook.
    assert rkCtxCount("warmSaw3") == 1;
    // A second pass is a no-op: the entry is marked done, so "exactly once for a
    // singleton, no matter how many sites resolve it" is a property of the pass
    // and not of the caller.
    val _again = runPostConstruct();
    assert rkCtxCount("WarmCache.warm") == 1;
}

test "rakun lifecycle: the pre pass runs in reverse registration order" {
    val _z = rkLifecycleReset();
    val _n = rkCtxNoteReset();
    val _a = rkRegisterLifecycle("First", "close", "pre", 0, { -> rkCtxNote("First") });
    val _b = rkRegisterLifecycle("Second", "close", "pre", 0, { -> rkCtxNote("Second") });
    val _c = rkRegisterLifecycle("Third", "close", "pre", 0, { -> rkCtxNote("Third") });
    val failed = runPreDestroy();
    assert failed == "";
    assert rkCtxNotes() == "Third\nSecond\nFirst";
}

test "rakun lifecycle: the post pass runs in registration order" {
    val _z = rkLifecycleReset();
    val _n = rkCtxNoteReset();
    val _a = rkRegisterLifecycle("First", "warm", "post", 0, { -> rkCtxNote("First") });
    val _b = rkRegisterLifecycle("Second", "warm", "post", 0, { -> rkCtxNote("Second") });
    val _r = runPostConstruct();
    assert rkCtxNotes() == "First\nSecond";
}

test "rakun lifecycle: an explicit order runs ahead of registration order" {
    val _z = rkLifecycleReset();
    val _n = rkCtxNoteReset();
    val _a = rkRegisterLifecycle("Late", "warm", "post", 5, { -> rkCtxNote("Late") });
    val _b = rkRegisterLifecycle("Early", "warm", "post", 1, { -> rkCtxNote("Early") });
    val _r = runPostConstruct();
    assert rkCtxNotes() == "Early\nLate";
}

test "rakun lifecycle: a #[postConstruct] that raises fails the boot naming both" {
    val _z = rkLifecycleReset();
    val _n = rkCtxNoteReset();
    val _a = rkRegisterLifecycle("Broken", "warm", "post", 0, { -> @panic("boom") });
    val _b = rkRegisterLifecycle("After", "warm", "post", 0, { -> rkCtxNote("After") });
    try asserts.throwsWith({ ->
        runPostConstruct();
        0;
    }, postConstructProblem("Broken.warm"));
    // Not tolerant: the pass stopped, so the hook behind it did not run.
    assert rkCtxNotes() == "";
}

test "rakun lifecycle: a #[preDestroy] that raises is logged and the rest still run" {
    val _z = rkLifecycleReset();
    val _n = rkCtxNoteReset();
    val _a = rkRegisterLifecycle("First", "close", "pre", 0, { -> rkCtxNote("First") });
    val _b = rkRegisterLifecycle("Broken", "close", "pre", 0, { -> @panic("boom") });
    val _c = rkRegisterLifecycle("Third", "close", "pre", 0, { -> rkCtxNote("Third") });
    val failed = runPreDestroy();
    assert failed == "Broken.close";
    // Reverse order, and the raise took neither neighbour with it.
    assert rkCtxNotes() == "Third\nFirst";
}

test "rakun lifecycle: a phase that is not post or pre is refused" {
    try asserts.throwsWith({ ->
        rkRegisterLifecycle("X", "m", "during", 0, { -> 1 });
        0;
    }, lifecyclePhaseProblem("during"));
}

// ── step 6: scopes ──────────────────────────────────────────────────────────
//
// A non-singleton `#[managed]` type carries NO stereotype, and that is the
// enforcement rather than a convention: the stereotype is what emits the
// singleton `__rkMake_<Type>()` a field would be injected through, `#[managed]`
// refuses the pair at comptime, and without one a field of this type does not
// compile at all. `#[managed]` emits `__rkNew_<Type>()` and the scan itself.

#[managed]
#[scope("prototype")]
pub type TicketMachine(
    repo: OrderRepository,
) {
    pub fn pull(self: Self) -> i32 {
        return rkCtxBump("ticket");
    }
}

#[managed]
#[scope("request")]
pub type RequestBasket(
    repo: OrderRepository,
) {
    pub fn mark(self: Self) -> i32 {
        return rkCtxBump("basket");
    }
}

test "rakun scope: a prototype bean is constructed on every resolve" {
    val ctx: Context = __rkMake_Context();
    val _n = rkCtxNoteReset();
    assert ctx.has("TicketMachine");
    val a: ?TicketMachine = ctx.resolve("TicketMachine");
    val b: ?TicketMachine = ctx.resolve("TicketMachine");
    var first = 0;
    if (a != null) first = a.pull();
    var second = 0;
    if (b != null) second = b.pull();
    // Two distinct instances, each of which ran. The counter is the observable:
    // `rkBuildCount` only counts what `rkEnter`/`rkDone` bracket, and a
    // prototype constructor is deliberately not bracketed.
    assert first == 1;
    assert second == 2;
    assert rkCtxCount("ticket") == 2;
}

test "rakun scope: the registered record carries the scope the decorator was given" {
    assert chooseBean("", "TicketMachine") == "|TicketMachine||prototype|0|0|TicketMachine";
    assert chooseBean("", "RequestBasket") == "|RequestBasket||request|0|0|RequestBasket";
}

test "rakun scope: a request bean is one instance within a request and another in the next" {
    val ctx: Context = __rkMake_Context();
    val _e = rkRequestScopeEnd();
    val _n = rkCtxNoteReset();
    val a: ?RequestBasket = ctx.resolve("RequestBasket");
    val b: ?RequestBasket = ctx.resolve("RequestBasket");
    var inFirst = 0;
    if (a != null) inFirst = a.mark();
    if (b != null) inFirst = b.mark();
    // Two resolves inside one request: the SAME instance, so the constructor
    // ran once. The marks are two because both handles were used.
    assert rkCtxCount("basket") == 2;
    val cleared = rkRequestScopeEnd();
    assert cleared == 1;
    val c: ?RequestBasket = ctx.resolve("RequestBasket");
    var inSecond = 0;
    if (c != null) inSecond = c.mark();
    assert inSecond == 3;
    // On the BEAM the cache is the process dictionary, so two CONCURRENT
    // requests are two processes and never share; that half cannot be asserted
    // from a `.bp` test, which has no way to spawn one. The bracket above is the
    // half that can, and it is the same statement on both rows.
    val second = rkRequestScopeEnd();
    assert second == 1;
}

test "rakun scope: rkRequestScoped caches by key and the bracket clears it" {
    val _e = rkRequestScopeEnd();
    val _n = rkCtxNoteReset();
    val one = rkRequestScoped("k", { -> rkCtxBump("scoped") });
    val two = rkRequestScoped("k", { -> rkCtxBump("scoped") });
    assert one == 1;
    assert two == 1;
    assert rkCtxCount("scoped") == 1;
    val other = rkRequestScoped("other", { -> rkCtxBump("scoped") });
    assert other == 2;
    val cleared = rkRequestScopeEnd();
    assert cleared == 2;
    val again = rkRequestScoped("k", { -> rkCtxBump("scoped") });
    assert again == 3;
    val _z = rkRequestScopeEnd();
}

test "rakun scope: a non-singleton bean is not constructed by the eager pass" {
    val _n = rkCtxNoteReset();
    val _e = rkRequestScopeEnd();
    assert eagerInit() == "";
    // Neither the prototype nor the request bean ran a constructor: the eager
    // pass builds singletons, and a bean built afresh per resolve has no
    // instance to warm.
    assert rkCtxCount("ticket") == 0;
    assert rkCtxCount("basket") == 0;
}

// ── step 7: eager initialization and lazy ───────────────────────────────────
//
// Every bean these blocks register sits at a CHILD path, except the one the
// boot-sequence block needs: the root registry is shared with every other test
// file on the erlang row, and a bean registered here is built by every later
// eager pass there.

#[service]
pub type CycleA(
    b: CycleB,
) {
    pub fn tag(self: Self) -> string {
        return "a";
    }
}

#[service]
pub type CycleB(
    a: CycleA,
) {
    pub fn tag(self: Self) -> string {
        return "b";
    }
}

test "rakun eager: a registered bean is constructed by the pass" {
    val _n = rkCtxNoteReset();
    val _b = rkRegisterBeanAt("/eager", "EagerCounted", "", "singleton", false, false, "eagerOwner", { -> rkCtxBump("eagerBuilt") });
    assert eagerInitIn("/eager") == "";
    assert rkCtxCount("eagerBuilt") == 1;
}

test "rakun eager: #[lazy] excludes only the bean that carries it" {
    val _n = rkCtxNoteReset();
    val _a = rkRegisterBeanAt("/lazybean", "EagerOne", "", "singleton", false, false, "eagerOwner", { -> rkCtxBump("lz1") });
    val _b = rkRegisterBeanAt("/lazybean", "LazyOne", "", "singleton", false, true, "lazyOwner", { -> rkCtxBump("lz2") });
    assert eagerInitIn("/lazybean") == "";
    assert rkCtxCount("lz1") == 1;
    assert rkCtxCount("lz2") == 0;
}

test "rakun eager: a cyclic graph fails the boot through front 04's cycle guard" {
    val _c = rkRegisterBeanAt("/cycle", "CycleA", "", "singleton", false, false, "cycleOwner", { -> __rkMake_CycleA() });
    val reason = eagerInitIn("/cycle");
    // The two rows word it differently — node raises a sentence and the BEAM an
    // `{rakun_cycle, Name}` term — so the assertion is on what both carry: the
    // bean the pass was building, and the word `cycle`.
    assert reason.startsWith("CycleA: ");
    assert reason.contains("cycle");
    assert reason.contains("CycleA");
}

test "rakun eager: rakun.main.lazy-initialization=true constructs nothing at boot" {
    val _b = rkRegisterBean("BootCounted", "", "singleton", false, false, "bootOwner", { -> rkCtxBump("bootBuilt") });
    val _z = rkLifecycleReset();
    val _n = rkCtxNoteReset();
    val _p = rkSetProp("rakun.main.lazy-initialization", "true");
    assert lazyInitialization();
    val published = bootSequence();
    // The events still publish: a lazily initialized application still starts.
    assert published == 8;
    assert rkCtxCount("bootBuilt") == 0;
    val _q = rkSetProp("rakun.main.lazy-initialization", "false");
    assert !lazyInitialization();
    val _n2 = rkCtxNoteReset();
    val again = bootSequence();
    assert again == 8;
    assert rkCtxCount("bootBuilt") == 1;
}

// The front's step 7 asks for "a component whose #[value] key is missing fails
// the boot, not the first request". It cannot: `rkProp` answers `""` for an
// absent key and `rkPropInt` answers `0`, by front 04's rule, on both rows and
// in `runtime.mjs`, which is FROZEN. A missing `#[value]` key is not an error at
// boot, at the first request, or ever. What the eager pass does turn into a boot
// failure is a construction that RAISES, which is the assertion below and the
// cycle one above.
test "rakun eager: a missing #[value] key is a default, not a failure - by design" {
    assert rkProp("rakun.no.such.key") == "";
    val _n = rkCtxNoteReset();
    val _b = rkRegisterBeanAt("/raises", "RaisingBean", "", "singleton", false, false, "raisingOwner", { -> @panic("construction failed") });
    val reason = eagerInitIn("/raises");
    assert reason.startsWith("RaisingBean: ");
    assert reason.contains("construction failed");
}

// ── step 8: shutdown and exit codes ─────────────────────────────────────────
//
// Shutdown is exercised by calling the pass DIRECTLY rather than by sending a
// real SIGTERM, so the run does not take the test runner down. The signal path,
// the readiness flip and the request drain are front 07's, which calls
// `shutdown()` after the drain.
//
// These blocks are ORDER-DEPENDENT: the first reads the registration
// `#[exitCode]` emitted at module load, and the ones after it reset.

#[exitCode]
pub fn drainExitCode() -> i32 {
    return 3;
}

test "rakun shutdown: #[exitCode] emits a registration at module load" {
    val wire = rkExitValues();
    assert wire.contains("3");
    assert processExitCode() == 3;
}

test "rakun shutdown: the highest generator wins and none means zero" {
    val _z = rkExitReset();
    assert processExitCode() == 0;
    val _a = rkRegisterExitCode("low", { -> 2 });
    val _b = rkRegisterExitCode("high", { -> 9 });
    val _c = rkRegisterExitCode("mid", { -> 5 });
    assert rkExitValues() == "2\n9\n5";
    assert processExitCode() == 9;
}

test "rakun shutdown: the pre pass runs in reverse order and answers the exit code" {
    val _z = rkLifecycleReset();
    val _e = rkExitReset();
    val _n = rkCtxNoteReset();
    val _a = rkRegisterLifecycle("First", "close", "pre", 0, { -> rkCtxNote("First") });
    val _b = rkRegisterLifecycle("Second", "close", "pre", 0, { -> rkCtxNote("Second") });
    val _c = rkRegisterLifecycle("Third", "close", "pre", 0, { -> rkCtxNote("Third") });
    val status = shutdown();
    assert rkCtxNotes() == "Third\nSecond\nFirst";
    // No generator registered: a clean stop is 0. A FAILED boot never reaches
    // here — `bootSequence` halts, and a halt is non-zero on both hosts without
    // anybody choosing a number.
    assert status == 0;
}

test "rakun shutdown: a #[preDestroy] that raises is logged and the rest still run" {
    val _z = rkLifecycleReset();
    val _e = rkExitReset();
    val _n = rkCtxNoteReset();
    val _a = rkRegisterLifecycle("First", "close", "pre", 0, { -> rkCtxNote("First") });
    val _b = rkRegisterLifecycle("Broken", "close", "pre", 0, { -> @panic("boom") });
    val _c = rkRegisterLifecycle("Third", "close", "pre", 0, { -> rkCtxNote("Third") });
    val _g = rkRegisterExitCode("drain", { -> 4 });
    val status = shutdown();
    assert rkCtxNotes() == "Third\nFirst";
    assert status == 4;
}

// ── `#[imports]`: Spring's @Import ──────────────────────────────────────────

pub type Wallet(
    owner: string,
)

// `#[configuration]` emits `__rkMake_Wallet()` for the `#[bean]` method, which
// makes `Wallet` injectable by TYPE. `#[imports]` is what additionally puts it
// in the registry, so `ctx.resolve("Wallet")` finds it.
#[configuration]
#[managed]
#[imports("Wallet")]
pub type WalletConfig() {
    #[bean]
    pub fn wallet(self: Self) -> Wallet {
        return Wallet(owner: "treasury");
    }
}

test "rakun context: #[imports] registers a bean for each named type" {
    val ctx: Context = __rkMake_Context();
    assert ctx.has("Wallet");
    val w: ?Wallet = ctx.resolve("Wallet");
    var owner = "";
    if (w != null) owner = w.owner;
    assert owner == "treasury";
    // The owner recorded is the configuration that asked for it, not the type.
    assert chooseBean("", "Wallet") == "|Wallet||singleton|0|0|WalletConfig";
}
