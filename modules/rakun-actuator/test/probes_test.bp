//// rakun-actuator — health groups, liveness, readiness and the shutdown
//// ordering against front 07 (front 76 steps 5 and 6). Probes are enabled by
//// a property each test sets and puts back.

import {testing.asserts} from "std";
import {async} from "std";
import {Request, Response, rkDispatchHttp, rkSetProp, rkServe, event, publishEvent} from "rakun";
import {rkRegisterListener} from "rakun/events";
import {Health, rkRegisterHealthIndicator, rkApiHealthRemove, healthIndicatorIds} from "rakun-actuator-api";
import {ShutdownReport, gracefulShutdown, rkNowMs} from "rakun-web";
import {actuator.mountActuator};
import {management.installManagement, management.setReadiness, management.rkProbesReset, management.rkProbesRefusingSince, management.rkProbesReadiness};

#[@External.Erlang("rakun_runtime", "prop")]
declare fn prop(key: string) -> string;

#[@External.Erlang("rakun_probes", "readiness_drained")]
declare fn readinessDrained() -> i64;

#[@External.Erlang("""(fun(__Ms) -> timer:sleep(__Ms), 0 end)($0)""")]
declare fn sleep(ms: i32) -> i32;

// `status|body` over a real socket (the body read to its Content-Length),
// `closed` when the server closed first, `refused` when the connect failed.
#[@External.Erlang("""(fun(__Port, __Path) -> case gen_tcp:connect("127.0.0.1", __Port, [binary, {active, false}], 1000) of {error, _} -> <<"refused">>; {ok, __S} -> ok = gen_tcp:send(__S, [<<"GET ">>, __Path, <<" HTTP/1.1", 13, 10, "Host: x", 13, 10, 13, 10>>]), __Rd = fun __Rd(__Acc) -> case binary:split(__Acc, <<13, 10, 13, 10>>) of [__H, __B] -> case re:run(__H, <<"(?i)content-length: *([0-9]+)">>, [{capture, [1], binary}]) of {match, [__L]} -> case byte_size(__B) >= binary_to_integer(__L) of true -> {ok, __H, __B}; false -> case gen_tcp:recv(__S, 0, 3000) of {ok, __M} -> __Rd(<<__Acc/binary, __M/binary>>); _ -> closed end end; _ -> {ok, __H, __B} end; _ -> case gen_tcp:recv(__S, 0, 3000) of {ok, __M} -> __Rd(<<__Acc/binary, __M/binary>>); _ -> closed end end end, __R = __Rd(<<>>), gen_tcp:close(__S), case __R of closed -> <<"closed">>; {ok, __Hd, __Bd} -> [_, __St | _] = binary:split(__Hd, <<" ">>, [global]), <<__St/binary, "|", __Bd/binary>> end end end)($0, $1)""")]
declare fn httpGet(port: i32, path: string) -> string;

fn get(path: string) -> Response {
    return rkDispatchHttp("GET", path, "{}", "{}", "");
}

fn set(key: string, value: string) -> i32 {
    return rkSetProp(key, value);
}

fn boot() -> i32 {
    val _m = mountActuator();
    return installManagement();
}

fn down() -> Health {
    return Health(status: "DOWN", details: "{\"error\":\"connection refused\"}");
}

// ── step 5: groups ──────────────────────────────────────────────────────────

test "groups: a group aggregates exactly its indicators" {
    val _d = rkRegisterHealthIndicator("dbx", "test", { -> down() });
    val _g = set("rakun.management.endpoint.health.group.core.include", "ping");
    val _b = boot();
    val core = get("/actuator/health/core");
    val all = get("/actuator/health");
    val _u = set("rakun.management.endpoint.health.group.core.include", "");
    val _x = rkApiHealthRemove("dbx");
    assert core.status == 200 && core.body == "{\"status\":\"UP\"}", core.body;
    assert all.status == 503;
}

test "groups: a group's show-details and roles override the global ones for that group alone" {
    val _g = set("rakun.management.endpoint.health.group.core.include", "ping");
    val _h = set("rakun.management.endpoint.health.group.core.show-details", "always");
    val _o = set("rakun.management.endpoint.health.group.other.include", "ping");
    val _s = set("rakun.management.endpoint.health.show-details", "never");
    val _b = boot();
    val core = get("/actuator/health/core");
    val other = get("/actuator/health/other");
    val _u = set("rakun.management.endpoint.health.group.core.include", "");
    val _v = set("rakun.management.endpoint.health.group.core.show-details", "");
    val _w = set("rakun.management.endpoint.health.group.other.include", "");
    val _x = set("rakun.management.endpoint.health.show-details", "");
    assert core.body.contains("\"components\":{\"ping\":{"), core.body;
    assert other.body == "{\"status\":\"UP\"}", other.body;
}

test "groups: additional-path publishes the group on the application listener and keeps the management path" {
    val _g = set("rakun.management.endpoint.health.group.edge.include", "ping");
    val _a = set("rakun.management.endpoint.health.group.edge.additional-path", "server:/healthz");
    val _b = boot();
    val root = get("/healthz");
    val mgmt = get("/actuator/health/edge");
    val _u = set("rakun.management.endpoint.health.group.edge.include", "");
    val _v = set("rakun.management.endpoint.health.group.edge.additional-path", "");
    assert root.status == 200 && root.body == "{\"status\":\"UP\"}";
    assert mgmt.status == 200 && mgmt.body == root.body;
}

test "groups: an unregistered indicator and an empty group each refuse the boot" {
    val _m = mountActuator();
    val _g = set("rakun.management.endpoint.health.group.bad.include", "ping,nosuch");
    try asserts.throwsWith({ -> installManagement() }, "the health group `bad` includes `nosuch`, which is not a registered indicator - registered: ");
    val _e = set("rakun.management.endpoint.health.group.bad.include", " , ");
    try asserts.throwsWith({ -> installManagement() }, "the health group `bad` includes no indicator");
    val _u = set("rakun.management.endpoint.health.group.bad.include", "");
}

// ── step 6: probes ──────────────────────────────────────────────────────────

fn probes() -> i32 {
    val _p = set("rakun.management.endpoint.health.probes.enabled", "true");
    val _r = rkProbesReset();
    return boot();
}

fn noProbes() -> i32 {
    return set("rakun.management.endpoint.health.probes.enabled", "");
}

test "probes: before Ready readiness is 503 and liveness 200; after Ready readiness is 200" {
    val _b = probes();
    val before = get("/actuator/health/readiness").status;
    val live = get("/actuator/health/liveness").status;
    val _e = publishEvent(event("ApplicationReady", "test", ""));
    val after = get("/actuator/health/readiness").status;
    val _n = noProbes();
    assert before == 503 && live == 200 && after == 200;
}

test "probes: liveness stays 200 while a database indicator is DOWN" {
    val _b = probes();
    val _d = rkRegisterHealthIndicator("db", "test", { -> down() });
    val live = get("/actuator/health/liveness").status;
    val all = get("/actuator/health").status;
    val _x = rkApiHealthRemove("db");
    val _n = noProbes();
    assert live == 200 && all == 503;
}

test "probes: naming an external-dependency indicator in the liveness group refuses the boot" {
    val _d = rkRegisterHealthIndicator("db", "test", { -> down() });
    val _p = set("rakun.management.endpoint.health.probes.enabled", "true");
    val _g = set("rakun.management.endpoint.health.group.liveness.include", "livenessState,db");
    val _m = mountActuator();
    try asserts.throwsWith({ -> installManagement() }, "the liveness group includes `db` - liveness must not depend on an external system");
    val _u = set("rakun.management.endpoint.health.group.liveness.include", "");
    val _x = rkApiHealthRemove("db");
    val _n = noProbes();
}

test "probes: setReadiness(false) flips the probe and publishes an availability event" {
    val _b = probes();
    val _l = rkRegisterListener("AvailabilityChange", "probe-test", { ev -> set("test.probes.availability", ev.payload) });
    val _r = setReadiness(true);
    val up = get("/actuator/health/readiness").status;
    val _f = setReadiness(false);
    val down = get("/actuator/health/readiness").status;
    val _n = noProbes();
    assert up == 200 && down == 503;
    assert prop("test.probes.availability") == "readiness=REFUSING_TRAFFIC";
}

test "probes: /livez and /readyz answer as their management counterparts" {
    val _b = probes();
    val _r = setReadiness(true);
    val lz = get("/livez");
    val lm = get("/actuator/health/liveness");
    val rz = get("/readyz");
    val rm = get("/actuator/health/readiness");
    val _n = noProbes();
    assert lz.status == lm.status && lz.body == lm.body && lz.status == 200;
    assert rz.status == rm.status && rz.body == rm.body;
}

test "probes: disabled, none of the four paths exists and the groups are still validated" {
    val _n = noProbes();
    val _b = boot();
    assert get("/actuator/health/liveness").status == 404;
    assert get("/actuator/health/readiness").status == 404;
    val _g = set("rakun.management.endpoint.health.group.bad.include", " , ");
    try asserts.throwsWith({ -> installManagement() }, "the health group `bad` includes no indicator");
    val _u = set("rakun.management.endpoint.health.group.bad.include", "");
}

#[@External.Erlang("""(fun(__F) -> __T0 = erlang:monotonic_time(millisecond), __F(), erlang:monotonic_time(millisecond) - __T0 end)($0)""")]
declare fn timed(work: fn() -> i64) -> i32;

test "probes: the pre-drain period elapses in full with nothing in flight, and 0 is allowed" {
    val _p = set("rakun.lifecycle.pre-drain-period", "150");
    val full = timed({ -> readinessDrained() });
    val _z = set("rakun.lifecycle.pre-drain-period", "0");
    val none = timed({ -> readinessDrained() });
    val _u = set("rakun.lifecycle.pre-drain-period", "");
    assert full >= 150, full.toString();
    assert none < 50, none.toString();
    assert rkProbesReadiness() == "REFUSING_TRAFFIC";
}

// Polls `/readyz` until it answers 503; answers `<time>` of that answer, or
// `none:<last answer>`.
fn firstRefusal(port: i32, deadline: i64) -> string {
    var found = false;
    var at = "";
    var last = "";
    while (found == false && rkNowMs() < deadline) {
        val r = httpGet(port, "/readyz");
        last = r;
        if (r.startsWith("503|")) {
            found = true;
            at = rkNowMs().toString();
        } else {
            val _s = sleep(5);
        };
    };
    return if (found) at else "none:" + last;
}

fn serve() -> i32 {
    return rkServe(0, { m, p, h, q, b -> rkDispatchHttp(m, p, h, q, b) });
}

fn refusalText(port: i32, deadline: i64) -> string {
    return firstRefusal(port, deadline);
}

fn shutdownAfter(ms: i32) -> string {
    val _w = sleep(ms);
    val r: ShutdownReport = gracefulShutdown();
    return r.stoppedAcceptingAt.toString();
}

#[@External.Erlang("""(fun(__S) -> binary_to_integer(__S) end)($0)""")]
declare fn toInt(s: string) -> i64;
#[@External.Erlang("""(fun(__X) -> __X end)($0)""")]
declare fn wide(n: i32) -> i64;

test "probes: on shutdown readiness answers 503 at least the pre-drain period before the socket refuses" {
    val _b = probes();
    val _r = setReadiness(true);
    val _k = set("rakun.main.keep-alive", "false");
    val _d = set("rakun.lifecycle.pre-drain-period", "200");
    val port = serve();
    assert httpGet(port, "/readyz").startsWith("200|");
    val start = rkNowMs();
    val results = await async.runAll([
        { -> async { refusalText(port, start + wide(3000)) } },
        { -> async { shutdownAfter(50) } },
    ]);
    val _u = set("rakun.lifecycle.pre-drain-period", "");
    val _n = noProbes();
    val seen = results.at(0) ?? "";
    assert seen.startsWith("none:") == false, seen;
    val refusedAt = toInt(seen);
    val closedAt = toInt(results.at(1) ?? "0");
    assert refusedAt < closedAt, refusedAt.toString() + " / " + closedAt.toString();
    assert closedAt - rkProbesRefusingSince() >= wide(200);
    assert httpGet(port, "/readyz") == "refused";
}
