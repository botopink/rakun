//// rakun-actuator — health aggregation and the two indicators front 11 ships.
////
//// THE CONTRACT (the registration half is rakun-actuator-api's):
////
////   · an indicator that RAISES is `DOWN` with `{"error": "<reason>"}` in
////     `details`, and the endpoint still answers;
////   · an indicator has a TIMEOUT, `rakun.management.health.<id>.timeout` (default
////     2 s); past it the answer is `UNKNOWN` with
////     `{"error": "timeout after <n>ms"}` and the check is ABANDONED (its process
////     killed) — a hung dependency never hangs the probe;
////   · indicators run CONCURRENTLY, one BEAM process each
////     (`rakun_actuator:run_health/2`), so ten at one second take one second;
////   · a status outside `UP`/`DOWN`/`OUT_OF_SERVICE`/`UNKNOWN` is `UNKNOWN`, and
////     `details` that are not a JSON object are replaced by an error object —
////     the host never forwards what it cannot vouch for.
////
//// Aggregation takes the WORST status present, ordered by
//// `rakun.management.endpoint.health.status.order` (default
//// `down, out-of-service, unknown, up`), and maps it to a code through
//// `rakun.management.endpoint.health.status.http-mapping.<status>` (default `DOWN`
//// and `OUT_OF_SERVICE` → 503, everything else → 200). The body is
//// `{"status":"<aggregate>"}` — component details are shown only when front 76
//// grants them (`show-details` and health groups are its), so `healthReport()`
//// is the value front 76 renders them from.
////
//// The `ping` indicator (always `UP`) and the `diskSpace` indicator
//// (`rakun.management.health.diskspace.path`, default `.`, and `.threshold` in bytes,
//// default 10 MB) are registered by `registerHealthBuiltins()` under the owner
//// `rakun-actuator`.

import {Request, rkProp, rkPropIntOr} from "rakun";
import {json, json.Json} from "std";
import {
    Health,
    EndpointResponse,
    healthUp,
    rkRegisterHealthIndicator,
    rkRegisterEndpoint,
    healthIndicatorIds,
} from "rakun-actuator-api";
import {rkPropDuration, Duration} from "rakun/config";

#[@External.Erlang("rakun_actuator", "run_health")]
pub declare fn rkActuatorRunHealth(jobs: string, unused: string) -> string;

#[@External.Erlang("rakun_actuator", "disk_facts")]
pub declare fn rkActuatorDiskFacts(path: string, thresholdBytes: i32) -> string;

// ── the records ─────────────────────────────────────────────────────────────

pub type ComponentHealth(
    id: string,
    status: string,
    details: string,
)

pub type HealthReport(
    status: string,
    components: ComponentHealth[],
)

// ── status vocabulary ───────────────────────────────────────────────────────

pub fn knownStatuses() -> string[] {
    return ["UP", "DOWN", "OUT_OF_SERVICE", "UNKNOWN"];
}

// `out-of-service` → `OUT_OF_SERVICE`.
pub fn statusToken(raw: string) -> string {
    return raw.trim().toUpper().replaceAll("-", "_");
}

pub fn statusKey(status: string) -> string {
    return status.toLower().replaceAll("_", "-");
}

pub fn statusOrder() -> string[] {
    val raw: string = rkProp("rakun.management.endpoint.health.status.order").trim();
    val spec: string = if (raw == "") "down, out-of-service, unknown, up" else raw;
    var out: string[] = [];
    for (spec.split(",")) { t ->
        val s = statusToken(t);
        if (s != "") out.push(s);
    };
    return out;
}

// The worst status present: the one earliest in the order. A status the order
// does not name ranks after every one it does.
pub fn aggregateStatus(statuses: string[]) -> string {
    val order: string[] = statusOrder();
    var best = "";
    var bestRank = 1000000;
    for (statuses) { s ->
        val at = order.indexOf(s);
        val rank = if (at < 0) order.length else at;
        if (rank < bestRank) {
            bestRank = rank;
            best = s;
        };
    };
    return if (best == "") "UNKNOWN" else best;
}

pub fn httpStatusFor(status: string) -> i32 {
    val mapped: i32 = rkPropIntOr("rakun.management.endpoint.health.status.http-mapping." + statusKey(status), 0);
    if (mapped > 0) return mapped;
    if ((status == "DOWN") || (status == "OUT_OF_SERVICE")) return 503;
    return 200;
}

// ── running the indicators ──────────────────────────────────────────────────

pub fn healthTimeoutMillis(id: string) -> i32 {
    val d: Duration = rkPropDuration("rakun.management.health." + id + ".timeout", "millis");
    return if (d.millis > 0) d.millis else 2000;
}

fn errorDetails(reason: string) -> string {
    return json.object([#("error", json.quote(reason))]);
}

// Whether `text` is one JSON object, read by std's `json.decode` (RFC 8259: a
// duplicate member or trailing text is not an object this host vouches for).
pub fn isJsonObject(text: string) -> bool {
    return case json.decode(text) {
        Ok(v) -> case v {
            Obj(members: _) -> true;
            _ -> false;
        };
        Error(_e) -> false;
    };
}

// One `id\tkind\tpayload` line from the host becomes a component, and every
// rule of the contract is applied here.
pub fn componentOf(line: string) -> ComponentHealth {
    val f: string[] = line.split("\t");
    val id: string = f.at(0) ?? "";
    val kind: string = f.at(1) ?? "";
    val a: string = f.at(2) ?? "";
    val b: string = f.at(3) ?? "";
    if (kind == "raised") return ComponentHealth(id: id, status: "DOWN", details: errorDetails(a));
    if (kind == "timeout") return ComponentHealth(id: id, status: "UNKNOWN", details: errorDetails("timeout after " + a + "ms"));
    if (kind != "ok") return ComponentHealth(id: id, status: "UNKNOWN", details: errorDetails("indicator missing"));
    val status: string = statusToken(a);
    if (knownStatuses().indexOf(status) < 0) return ComponentHealth(id: id, status: "UNKNOWN", details: errorDetails("unknown status " + a));
    val details: string = if (b.trim() == "") "{}" else b;
    if (isJsonObject(details) == false) return ComponentHealth(id: id, status: status, details: errorDetails("details are not a JSON object"));
    return ComponentHealth(id: id, status: status, details: details);
}

// Every registered indicator, concurrently, each under its own timeout.
pub fn healthReport() -> HealthReport {
    var jobs: string[] = [];
    for (healthIndicatorIds()) { id -> jobs.push(id + "=" + healthTimeoutMillis(id).toString()) };
    val wire: string = rkActuatorRunHealth(jobs.join("\n"), "");
    var components: ComponentHealth[] = [];
    var statuses: string[] = [];
    if (wire != "") {
        for (wire.split("\n")) { line ->
            val c = componentOf(line);
            components.push(c);
            statuses.push(c.status);
        };
    };
    return HealthReport(status: aggregateStatus(statuses), components: components);
}

// `status <S>`, then `components:` and `  <id> <status> <details>` per
// component sorted by id — the rendering the milestone's snapshots pin.
pub fn renderHealth(r: HealthReport) -> string {
    var out: string[] = ["status " + r.status, "components:"];
    for (r.components) { c -> out.push("  " + c.id + " " + c.status + " " + c.details) };
    return out.join("\n");
}

pub fn healthBody(r: HealthReport) -> string {
    return json.object([#("status", json.quote(r.status))]);
}

pub fn healthRead(req: Request) -> EndpointResponse {
    val r: HealthReport = healthReport();
    return EndpointResponse(status: httpStatusFor(r.status), contentType: "application/json", body: healthBody(r));
}

// ── the two indicators front 11 ships ───────────────────────────────────────

pub fn pingHealth() -> Health {
    return healthUp();
}

pub fn diskSpaceHealth() -> Health {
    val raw: string = rkProp("rakun.management.health.diskspace.path").trim();
    val path: string = if (raw == "") "." else raw;
    val threshold: i32 = rkPropIntOr("rakun.management.health.diskspace.threshold", 10485760);
    val facts: string = rkActuatorDiskFacts(path, threshold);
    if (facts == "") return Health(status: "UNKNOWN", details: errorDetails("disk space unreadable at " + path));
    val f: string[] = facts.split("\t");
    val free: string = f.at(0) ?? "0";
    val total: string = f.at(1) ?? "0";
    val enough = (f.at(2) ?? "0") == "1";
    val details = json.object([
        #("total", total),
        #("free", free),
        #("threshold", threshold.toString()),
        #("path", json.quote(path)),
    ]);
    return Health(status: if (enough) "UP" else "DOWN", details: details);
}

// Registered by `mountActuator` (a library module's top-level `val` does not
// run at load on the erlang row, so the host registers its own rows at boot).
pub fn registerHealthBuiltins() -> i32 {
    val _p = rkRegisterHealthIndicator("ping", "rakun-actuator", { -> pingHealth() });
    val _d = rkRegisterHealthIndicator("diskSpace", "rakun-actuator", { -> diskSpaceHealth() });
    return rkRegisterEndpoint("health", "rakun-actuator", "read", { req -> healthRead(req) });
}
