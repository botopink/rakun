//// rakun-actuator — module-tree root.
////
//// Front 11's host: the endpoint host (one route, dispatch by id, base path,
//// path mapping, response cache, endpoint CORS), health aggregation and the
//// `ping`/`diskSpace` indicators, info merging and its four contributors, the
//// `beans`/`configprops`/`mappings`/`startup` endpoints, and
//// `instrumentation.bp` (boot-step timing, the `#[instrumentation]` hook, the
//// `http.server.request` span entry). The registries themselves are
//// rakun-actuator-api's.
////
//// The order is a DEPENDENCY order and `botopink.json`'s `files` repeats it:
//// `endpoint_host` imports no sibling; the others import `endpoint_host`.
//// Fronts 75 and 76 append their `pub mod` lines after these, in front-number
//// order (front 11 README § Contradictions with fronts.md, row 1).

pub mod endpoint_host;
pub mod health;
pub mod info;
pub mod registry_endpoints;
pub mod instrumentation;
pub mod actuator;
