//// rakun-actuator — who may reach the actuator, on which listener, and what a
//// response may contain; liveness and readiness (front 76).
////
//// FOUR GATES, the cheapest and least informative first — an endpoint that
//// fails any of the first three answers EXACTLY like an id nobody registered
//// (front 11's `notFoundProblem`), so a 404/403 difference discloses nothing:
////
////   1. LISTENER — with `rakun.management.server.port` set (`-1` included) the
////      actuator answers only on the management listener; on the application
////      listener every actuator path is the unknown-id 404.
////   2. EXPOSURE — `rakun.management.endpoints.web.exposure.include` (default
////      `health`, `*` for every id, read at request time so a late endpoint is
////      covered) minus `.exclude` (which wins, over `*` too). An include naming
////      an id nobody registered refuses the boot, listing the registered ids.
////   3. ACCESS — `rakun.management.endpoint.<id>.access` (else
////      `rakun.management.endpoints.access.default`, else `read-only`; `shutdown`
////      defaults to `none`) ∈ none | read-only | unrestricted, CAPPED by
////      `rakun.management.endpoints.access.max-permitted` (default
////      `unrestricted`). `none` is the 404; `read-only` answers GET and 405s
////      everything else. No key raises an endpoint above the ceiling.
////   4. AUTHORIZATION — front 10's chain, as for every route.
////
//// SANITIZATION — `env` and `configprops` go through ONE filter: every
//// `{"key", "value"}` object shows its key and, under
//// `rakun.management.endpoint.<id>.show-values` = never (default) |
//// when-authorized (`.roles`) | always, its value or `******`; a key matching
//// the pattern set is `******` even under `always`. Patterns are additive only
//// (`rakun.management.endpoint.sanitize.additional-keys`).
////
//// HEALTH GROUPS — `rakun.management.endpoint.health.group.<name>.include`
//// (`.show-details`, `.roles`, `.additional-path=server:/path`) at
//// `<base>/health/<name>`. PROBES
//// (`rakun.management.endpoint.health.probes.enabled=true`) add the `liveness`
//// (livenessState) and `readiness` (readinessState) groups and `/livez`,
//// `/readyz` on the application listener. Liveness may include only local
//// indicators (livenessState, ping, diskSpace). Readiness is refusing until
//// front 06's ApplicationReady and from the first step of front 07's graceful
//// shutdown (`rakun_probes:readiness_drained/0`, which holds for
//// `rakun.lifecycle.pre-drain-period`, default 5000 ms; 0 is correct only
//// where the balancer reacts synchronously).

import {Request, Response, HttpMethod, rkProp, rkRegisterRoute, rkDispatchHttp, toI32, event, publishEvent} from "rakun";
import {rkRegisterListener} from "rakun/events";
import {json} from "std";
import {problemFor, problemResponse, withHeader} from "rakun-web";
import {EndpointResponse, Health, rkRegisterEndpoint, rkRegisterHealthIndicator, endpointIds, healthIndicatorIds} from "rakun-actuator-api";
import {installExposure, basePath, idForSegment, notFoundProblem, render, readEndpoint, filtered} from "endpoint_host";
import {HealthReport, ComponentHealth, aggregateStatus, httpStatusFor, healthTimeoutMillis, componentOf, rkActuatorRunHealth} from "health";

// ── host cells ──────────────────────────────────────────────────────────────

#[@External.Erlang("rakun_probes", "readiness")]
pub declare fn rkProbesReadiness() -> string;

#[@External.Erlang("rakun_probes", "set_readiness")]
declare fn rkProbesSetReadiness(accepting: bool) -> i32;

#[@External.Erlang("rakun_probes", "liveness")]
pub declare fn rkProbesLiveness() -> string;

#[@External.Erlang("rakun_probes", "set_liveness")]
declare fn rkProbesSetLiveness(correct: bool) -> i32;

#[@External.Erlang("rakun_probes", "refusing_since")]
pub declare fn rkProbesRefusingSince() -> i32;

#[@External.Erlang("rakun_probes", "role")]
pub declare fn rkProbesRole() -> string;

#[@External.Erlang("rakun_probes", "set_role")]
declare fn rkProbesSetRole(role: string) -> i32;

#[@External.Erlang("rakun_probes", "sanitize")]
declare fn rkProbesSanitize(body: string, mode: string, authorized: bool, patterns: string[]) -> string;

#[@External.Erlang("rakun_probes", "authorities")]
pub declare fn rkProbesAuthorities() -> string[];

#[@External.Erlang("rakun_probes", "filter_put")]
declare fn rkProbesFilterPut(filter: fn(id: string, body: string) -> string) -> i32;

#[@External.Erlang("rakun_probes", "env_json")]
declare fn rkProbesEnvJson() -> string;

#[@External.Erlang("rakun_probes", "prop_keys")]
declare fn rkProbesPropKeys(prefix: string) -> string[];

#[@External.Erlang("rakun_probes", "warn")]
declare fn rkProbesWarn(text: string) -> i32;

#[@External.Erlang("rakun_probes", "warnings")]
pub declare fn rkProbesWarnings() -> string[];

