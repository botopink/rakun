//// rakun-messaging — acknowledgement modes, concurrency and prefetch through
//// the reliable dispatcher (front 86 steps 5 and 6), and what the operator
//// sees (step 8).

import {testing.asserts} from "std";
import {rkSetProp, rkProp} from "rakun";
import {message.InProcessBroker};
import {container.resetMessaging, container.stopMessaging, container.startMessaging, container.containerWorkers, container.published};
import {messaging_host.rkMsgBump, messaging_host.rkMsgCount, messaging_host.rkMsgWaitUntil, messaging_host.rkMsgKillWorker, messaging_host.rkMsgInflight, messaging_host.rkMsgDeliveries};
import {healthIndicatorIds} from "rakun-actuator-api";
import {counter, timer, Tag} from "rakun-metrics";
import {reliability.policy.Outcome};
import {reliability.dispatch.Delivery, reliability.dispatch.attemptOf, reliability.dispatch.reliableListener, reliability.dispatch.ackDelivery, reliability.dispatch.startReliability, reliability.dispatch.resetReliability, reliability.dispatch.reliabilityLog, reliability.dispatch.reliabilityConfigProblem, reliability.dispatch.messagingHealth};

fn clean() -> i32 {
    val _s = stopMessaging();
    for (["amqp", "kafka", "redis", "stream"]) { a -> val _t = rkSetProp("rakun.messaging." + a + ".transport", "memory"); };
    val _r = resetReliability();
    return resetMessaging();
}

fn set(name: string, key: string, value: string) -> i32 {
    return rkSetProp("rakun.messaging.listener." + name + "." + key, value);
}

fn unset(name: string) -> i32 {
    for (["retry.initial-interval", "retry.max-interval", "retry.max-attempts", "reliability.ack-mode", "reliability.batch-size", "ack-mode", "prefetch", "concurrency"]) { k -> val _u = set(name, k, ""); };
    return 0;
}

fn publishAll(dest: string, payloads: string[]) -> i32 {
    val b = InProcessBroker(arm: "amqp");
    for (payloads) { p -> val _x = b.publish(dest, "", p); };
    return payloads.length;
}

// ── step 5 ──────────────────────────────────────────────────────────────────

test "ack: auto settles a Done once" {
    val _c = clean();
    val _l = reliableListener("aa", "amqp", "aa", "", { d ->
        val _r = rkMsgBump("aa:" + d.body);
        Outcome.Done
    });
    val _s = startReliability();
    val _b = startMessaging();
    val _p = publishAll("aa", ["one"]);
    val done = rkMsgWaitUntil(2000, { -> rkMsgCount("aa:one") == 1 });
    val _w = rkMsgWaitUntil(200, { -> false });
    val settled = rkMsgInflight("aa");
    val cnt0 = rkMsgCount("aa:one");
    val _z = clean();
    assert done && settled == 0 && cnt0 == 1, done.toString() + " " + settled.toString() + " " + cnt0.toString();
}

test "ack: manual settles nothing for the handler, and a Done without an ack warns naming the listener" {
    val _c = clean();
    val _m = set("am", "ack-mode", "manual");
    val _r = set("am", "reliability.ack-mode", "manual");
    val _l = reliableListener("am", "amqp", "am", "", { d ->
        val n = rkMsgBump("am:" + d.body);
        if (d.body == "acked" || n > 1) {
            val _a = ackDelivery(d);
        };
        Outcome.Done
    });
    val _s = startReliability();
    val _b = startMessaging();
    val _p = publishAll("am", ["acked", "forgot"]);
    val redelivered = rkMsgWaitUntil(3000, { -> rkMsgCount("am:forgot") == 2 });
    val warned = reliabilityLog().filter({ l -> l.contains("listener am returned Done without acking") }).length;
    val _u = unset("am");
    val cnt0 = rkMsgCount("am:acked");
    val _z = clean();
    assert redelivered && cnt0 == 1 && warned == 1, warned.toString();
}

test "ack: batch settles every size messages, and a crash replays at most size - 1" {
    val _c = clean();
    val _m = set("ab", "ack-mode", "manual");
    val _r = set("ab", "reliability.ack-mode", "batch");
    val _z0 = set("ab", "reliability.batch-size", "3");
    val _q = set("ab", "prefetch", "10");
    val _l = reliableListener("ab", "amqp", "ab", "", { d ->
        val _r2 = rkMsgBump("ab:" + d.body);
        Outcome.Done
    });
    val _s = startReliability();
    val _b = startMessaging();
    val _p = publishAll("ab", ["1", "2", "3", "4", "5"]);
    val handled = rkMsgWaitUntil(3000, { -> rkMsgCount("ab:5") >= 1 });
    val _w = rkMsgWaitUntil(200, { -> false });
    val held = rkMsgInflight("ab");
    val killed = rkMsgKillWorker("ab", 1);
    val replayed = rkMsgWaitUntil(3000, { -> rkMsgCount("ab:4") == 2 && rkMsgCount("ab:5") == 2 });
    val first = rkMsgCount("ab:1");
    val _u = unset("ab");
    val _z = clean();
    assert handled && held == 2 && killed != "" && replayed && first == 1, held.toString();
}

test "ack: an unknown ack mode fails at boot naming the key" {
    val _c = clean();
    val _r = set("ax", "reliability.ack-mode", "sometimes");
    val _l = reliableListener("ax", "amqp", "ax", "", { d -> Outcome.Done });
    try asserts.throwsWith({ -> startReliability() }, "rakun.messaging.listener.ax.reliability.ack-mode is `sometimes` - it must be auto, manual or batch");
    val _u = unset("ax");
    val _z = clean();
}

// ── step 6 ──────────────────────────────────────────────────────────────────

test "concurrency: four consumers, one killed and replaced while the others consume" {
    val _c = clean();
    val _n = set("ac", "concurrency", "4");
    val _l = reliableListener("ac", "amqp", "ac", "", { d ->
        val _r = rkMsgBump("ac:" + d.body);
        Outcome.Done
    });
    val _s = startReliability();
    val _b = startMessaging();
    val four = containerWorkers("ac");
    val killed = rkMsgKillWorker("ac", 2);
    val _p = publishAll("ac", ["a", "b", "c", "d", "e", "f"]);
    val consumed = rkMsgWaitUntil(3000, { -> rkMsgCount("ac:a") == 1 && rkMsgCount("ac:f") == 1 });
    val back = rkMsgWaitUntil(3000, { -> containerWorkers("ac") == 4 });
    val _u = unset("ac");
    val _z = clean();
    assert four == 4 && killed != "" && consumed && back;
}

test "prefetch: with prefetch 1 and a blocked handler the second message is not delivered" {
    val _c = clean();
    val _q = set("ap", "prefetch", "1");
    val _g = rkSetProp("test.ap.release", "");
    val _l = reliableListener("ap", "amqp", "ap", "", { d ->
        val _r = rkMsgBump("ap:" + d.body);
        val _w = rkMsgWaitUntil(5000, { -> rkProp("test.ap.release") == "1" });
        Outcome.Done
    });
    val _s = startReliability();
    val _b = startMessaging();
    val _p = publishAll("ap", ["first", "second"]);
    val started = rkMsgWaitUntil(2000, { -> rkMsgCount("ap:first") == 1 });
    val _w = rkMsgWaitUntil(300, { -> false });
    val secondEarly = rkMsgCount("ap:second");
    val _go = rkSetProp("test.ap.release", "1");
    val secondLater = rkMsgWaitUntil(3000, { -> rkMsgCount("ap:second") == 1 });
    val _u = unset("ap");
    val _z = clean();
    assert started && secondEarly == 0 && secondLater;
}

// ── step 8 ──────────────────────────────────────────────────────────────────

test "observe: deliveries, retries, dead-letters and handler duration are counted per listener" {
    val _c = clean();
    val _a = set("ao", "retry.initial-interval", "5");
    val _m = set("ao", "retry.max-attempts", "2");
    val t = [Tag(key: "listener", value: "ao")];
    val d0 = counter("rakun.messaging.deliveries", t).count();
    val r0 = counter("rakun.messaging.retries", t).count();
    val l0 = counter("rakun.messaging.dead_letters", t).count();
    val h0 = timer("rakun.messaging.handler.duration", t).count();
    val _l = reliableListener("ao", "amqp", "ao", "", { d -> Outcome.Retry(reason: "down") });
    val _s = startReliability();
    val _b = startMessaging();
    val _p = publishAll("ao", ["x"]);
    val done = rkMsgWaitUntil(3000, { -> counter("rakun.messaging.dead_letters", t).count() == l0 + 1 });
    val warned = reliabilityLog().filter({ l -> l.contains("listener ao dead-lettered") }).length;
    val _u = unset("ao");
    val _z = clean();
    assert done && counter("rakun.messaging.deliveries", t).count() == d0 + 2 && counter("rakun.messaging.retries", t).count() == r0 + 1 && timer("rakun.messaging.handler.duration", t).count() == h0 + 2;
    assert warned == 1;
}

test "observe: the messaging health indicator reports each listener's broker connection" {
    val _c = clean();
    val _l = reliableListener("ah", "kafka", "ah", "g", { d -> Outcome.Done });
    val _s = startReliability();
    val _b = startMessaging();
    val up = messagingHealth();
    val _d = stopMessaging();
    val down = messagingHealth();
    val _z = clean();
    assert healthIndicatorIds().indexOf("messaging") >= 0;
    assert up.status == "UP" && up.details == "{\"listeners\":{\"ah\":\"UP\"}}" && down.status == "DOWN" && down.details.contains("\"ah\":\"DOWN\""), up.details + " " + down.details;
}
