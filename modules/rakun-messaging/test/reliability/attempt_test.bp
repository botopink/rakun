//// rakun-messaging — the attempt carrier and the reliable dispatcher over
//// front 15's in-process broker (front 86 steps 3 and 4).

import {rkSetProp, rkProp} from "rakun";
import {message.Message, message.InProcessBroker};
import {container.resetMessaging, container.stopMessaging, container.startMessaging, container.published};
import {messaging_host.rkMsgBump, messaging_host.rkMsgCount, messaging_host.rkMsgWaitUntil, messaging_host.rkMsgKillContainer, messaging_host.rkMsgListenerDestinations, messaging_host.rkMsgWide};
import {reliability.policy.Outcome};
import {reliability.dispatch.Delivery, reliability.dispatch.deliveryOf, reliability.dispatch.attemptOf, reliability.dispatch.redeliveryPayload, reliability.dispatch.reliableListener, reliability.dispatch.reliableListenerWith, reliability.dispatch.startReliability, reliability.dispatch.resetReliability, reliability.dispatch.reliabilityLog};

fn clean() -> i32 {
    val _s = stopMessaging();
    for (["amqp", "kafka", "redis", "stream"]) { a ->
        val _t = rkSetProp("rakun.messaging." + a + ".transport", "memory");
    }
    val _r = resetReliability();
    return resetMessaging();
}

fn set(name: string, key: string, value: string) -> i32 {
    return rkSetProp("rakun.messaging.listener." + name + "." + key, value);
}

fn fast(name: string, attempts: string) -> i32 {
    val _a = set(name, "retry.initial-interval", "10");
    val _b = set(name, "retry.max-interval", "40");
    return set(name, "retry.max-attempts", attempts);
}

fn unset(name: string) -> i32 {
    for ([
        "retry.initial-interval",
        "retry.max-interval",
        "retry.max-attempts",
        "dead-letter",
    ]) { k ->
        val _u = set(name, k, "");
    }
    return 0;
}

fn msg(payload: string) -> Message {
    return Message(
        broker: "amqp",
        destination: "q",
        key: "",
        payload: payload,
        headersJson: "{}",
        offset: rkMsgWide(-1),
    );
}

fn record(tag: string, d: Delivery) -> i32 {
    return rkMsgBump(tag + ":" + d.body + "@" + attemptOf(d).toString());
}

fn publish(arm: string, dest: string, payload: string) -> i32 {
    return InProcessBroker(arm: arm).publish(dest, "", payload);
}

// ── step 3 ──────────────────────────────────────────────────────────────────

test "attempt: a delivery without x-rakun-attempt is attempt 1" {
    assert attemptOf(deliveryOf(msg("plain"))) == 1;
}

test "attempt: a redelivery carries x-rakun-attempt one higher than the failed delivery" {
    val _c = clean();
    val _f = fast("ra", "3");
    val _l = reliableListener("ra", "amqp", "ra", "", { d ->
        val _r = record("ra", d);
        if (attemptOf(d) < 2) Outcome.Retry(reason: "busy") else Outcome.Done;
    });
    val _s = startReliability();
    val _b = startMessaging();
    val _p = publish("amqp", "ra", "order-1");
    val both = rkMsgWaitUntil(3000, { -> rkMsgCount("ra:order-1@2") == 1 });
    val sent = published("amqp").filter({ l -> l.startsWith("ra|") }).length;
    val _u = unset("ra");
    val cnt0 = rkMsgCount("ra:order-1@1");
    val cnt1 = rkMsgCount("ra:order-1@2");
    val _z = clean();
    assert both && cnt0 == 1 && sent == 2, both.toString()
        + " "
        + cnt0.toString()
        + " "
        + cnt1.toString()
        + " "
        + sent.toString();
}

test "attempt: the count survives killing the consumers between deliveries" {
    val _c = clean();
    val _f = fast("rk", "5");
    val _g = rkSetProp("test.rk.release", "");
    val _l = reliableListener("rk", "amqp", "rk", "", { d ->
        val _r = record("rk", d);
        val n = attemptOf(d);
        if (n == 2)
            val _w = rkMsgWaitUntil(
                5000,
                { -> rkProp("test.rk.release") == "1" },
            );
        if (n < 3) Outcome.Retry(reason: "busy") else Outcome.Done;
    });
    val _s = startReliability();
    val _b = startMessaging();
    val _p = publish("amqp", "rk", "x");
    val second = rkMsgWaitUntil(3000, { -> rkMsgCount("rk:x@2") == 1 });
    val _k = rkMsgKillContainer("rk");
    val _go = rkSetProp("test.rk.release", "1");
    val _r = startMessaging();
    val third = rkMsgWaitUntil(3000, { -> rkMsgCount("rk:x@3") == 1 });
    val once = rkMsgCount("rk:x@1");
    val twice = rkMsgCount("rk:x@2");
    val _u = unset("rk");
    val _z = clean();
    assert second && third && once == 1 && twice == 2, once.toString()
        + " "
        + twice.toString();
}

test "attempt: a non-numeric header counts as attempt 1 and is logged once" {
    val bad = msg(
        redeliveryPayload(1, rkMsgWide(5), "body").replaceAll(
            "x-rakun-attempt=1",
            "x-rakun-attempt=many",
        ),
    );
    val a = attemptOf(deliveryOf(bad));
    val b = attemptOf(deliveryOf(bad));
    val logged = reliabilityLog().filter(
        { l -> l.contains("x-rakun-attempt `many`") },
    ).length;
    assert a == 1 && b == 1 && logged == 1 && deliveryOf(bad).body == "body";
}

// ── step 4 ──────────────────────────────────────────────────────────────────

test "dlq: exhausted retries publish the envelope to <destination>.dlq with the original destination" {
    val _c = clean();
    val _f = fast("rd", "2");
    val _l = reliableListener(
        "rd",
        "amqp",
        "rd",
        "",
        { d -> Outcome.Retry(reason: "still busy") },
    );
    val _s = startReliability();
    val _b = startMessaging();
    val _p = publish("amqp", "rd", "order-9");
    val lettered = rkMsgWaitUntil(
        3000,
        { -> published("amqp").filter({ l -> l.startsWith("rd.dlq|") }).length == 1 },
    );
    val letter = published("amqp")
        .filter({ l -> l.startsWith("rd.dlq|") })
        .at(0) ?? "";
    val warned = reliabilityLog().filter(
        { l -> l.contains("listener rd dead-lettered") },
    ).length;
    val _u = unset("rd");
    val _z = clean();
    assert lettered
        && letter.contains(
            "{\"destination\":\"rd\",\"body\":\"order-9\",\"reason\":\"still busy\",\"attempt\":2,",
        )
        && warned == 1, letter;
}

test "dlq: a failed dead-letter publish leaves the original unacknowledged, and it is redelivered" {
    val _c = clean();
    val _f = fast("rf", "1");
    val _o = rkSetProp("test.dlq.ok", "");
    val _l = reliableListenerWith("rf", "amqp", "rf", "", { d ->
        val _r = rkMsgBump("rf:seen");
        Outcome.Reject(reason: "malformed");
    }, { b, dest, k, payload -> if (rkProp("test.dlq.ok") == "1") InProcessBroker(arm: b).publish(dest, k, payload) else 1 });
    val _s = startReliability();
    val _b = startMessaging();
    val _p = publish("amqp", "rf", "poison");
    val again = rkMsgWaitUntil(3000, { -> rkMsgCount("rf:seen") >= 2 });
    val _ok = rkSetProp("test.dlq.ok", "1");
    val settled = rkMsgWaitUntil(
        3000,
        { -> published("amqp").filter({ l -> l.startsWith("rf.dlq|") }).length == 1 },
    );
    val _u = unset("rf");
    val _z = clean();
    assert again && settled;
}

test "dlq: the dead-letter destination is configurable, and the listener does not consume it" {
    val _c = clean();
    val _f = fast("rc", "1");
    val _d = set("rc", "dead-letter", "graveyard");
    val _l = reliableListener("rc", "amqp", "rc", "", { d ->
        val _r = rkMsgBump("rc:" + d.body);
        Outcome.Reject(reason: "no");
    });
    val _s = startReliability();
    val _b = startMessaging();
    val _p = publish("amqp", "rc", "m1");
    val lettered = rkMsgWaitUntil(
        3000,
        { -> published("amqp").filter({ l -> l.startsWith("graveyard|") }).length == 1 },
    );
    val _w = rkMsgWaitUntil(200, { -> false });
    val consumed = rkMsgCount("rc:m1");
    val subscribed = rkMsgListenerDestinations().filter(
        { d -> d == "graveyard" || d == "rc.dlq" },
    ).length;
    val _u = unset("rc");
    val _z = clean();
    assert lettered && consumed == 1 && subscribed == 0;
}
