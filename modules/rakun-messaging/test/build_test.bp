//// rakun-messaging — what fails the BUILD (front 15 step 3). A comptime
//// refusal cannot be asserted from inside the module that carries it, so each
//// cell writes a one-file project depending on this member by path, builds it
//// and asserts the refusal (rakun-scheduling's `build_test.bp` shape). The
//// projects live under `.botopinkbuild/tmp/rakun-messaging-fixtures/`.
////
//// The compiler is `$BOTOPINK_BIN`, else `botopink` on `PATH`, else the
//// meta-repository's `repository/botopink-lang/zig-out/bin/botopink`; with
//// none the cells FAIL saying so.

import {testing.asserts} from "std";
import {io: {fs, process}} from "std";

fn fixtureRoot() -> string {
    return process.cwd() + "/.botopinkbuild/tmp/rakun-messaging-fixtures";
}

fn compilerCommand() -> string {
    return "B=\"$BOTOPINK_BIN\"; [ -n \"$B\" ] || B=\"$(command -v botopink)\"; [ -n \"$B\" ] || B=../../../botopink-lang/zig-out/bin/botopink; [ -x \"$B\" ] || { echo \"no botopink compiler: set BOTOPINK_BIN\"; exit 0; }; B=\"$(cd \"$(dirname \"$B\")\" && pwd)/$(basename \"$B\")\"; ";
}

fn dep(name: string, dir: string) -> string {
    return "    \"" + name + "\": { \"path\": \"" + dir + "\" }";
}

fn buildFixture(name: string, source: string) -> string {
    val dir = fixtureRoot() + "/" + name;
    val here = process.cwd();
    val _m = process.runShell("rm -rf '" + dir + "' && mkdir -p '" + dir + "/src'");
    val deps = [dep("rakun", here + "/../rakun"), dep("rakun-actuator-api", here + "/../rakun-actuator-api"), dep("rakun-messaging", here)];
    val manifest = "{\n  \"name\": \"" + name + "\",\n  \"version\": \"0.0.1\",\n  \"src\": \"src/\",\n  \"entry\": \"root.bp\",\n  \"target\": \"erlang\",\n  \"targets\": [\"erlang\"],\n  \"dependencies\": {\n" + deps.join(",\n") + "\n  }\n}\n";
    val _j = fs.writeText(dir + "/botopink.json", manifest);
    val _s = fs.writeText(dir + "/src/root.bp", source);
    return process.runShell(compilerCommand() + "cd '" + dir + "' && \"$B\" build --target erlang --out out 2>&1 < /dev/null; echo \"exit=$?\"");
}

fn header() -> string {
    return "import {service, rkScan, rkSingleton, rkEnter, rkDone} from \"rakun\";\nimport {listener, amqpListener, kafkaListener, redisListener, streamListener, Message, rkRegisterListenerAs} from \"rakun-messaging\";\n\n";
}

fn handler(marker: string, name: string) -> string {
    return "    " + marker + "\n    pub fn " + name + "(self: Self, msg: Message) -> i32 {\n        return 0;\n    }\n";
}

fn service(name: string, body: string) -> string {
    return "#[service]\n#[listener]\npub type " + name + "() {\n" + body + "}\n";
}

test "build: a listener with all four markers builds" {
    val out = buildFixture("ok", header() + service("AllArms", handler("#[amqpListener(\"q\")]", "a") + handler("#[kafkaListener(\"t\", \"g\")]", "k") + handler("#[redisListener(\"c\")]", "r") + handler("#[streamListener(\"s\", \"42\")]", "s")));
    try asserts.contains(out, "exit=0");
}

test "build: #[listener] on a type with no broker marker fails saying so" {
    val out = buildFixture("no-marker", header() + service("Idle", "    pub fn run(self: Self) -> i32 {\n        return 0;\n    }\n"));
    try asserts.contains(out, "#[listener] on Idle finds no method carrying #[amqpListener], #[kafkaListener], #[redisListener] or #[streamListener]");
    try asserts.notContains(out, "exit=0");
}

fn misplaced(marker: string, name: string, n: string) -> bool {
    val out = buildFixture("marker-" + n, header() + marker + "\npub type Wrong(n: i32)\n");
    return out.contains("#[" + name + "] must annotate a method of a #[listener] type") && out.contains("src/root.bp:") && out.contains("exit=0") == false;
}

test "build: each marker anywhere but on a method fails with a located message" {
    assert misplaced("#[amqpListener(\"q\")]", "amqpListener", "a");
    assert misplaced("#[kafkaListener(\"t\", \"g\")]", "kafkaListener", "k");
    assert misplaced("#[redisListener(\"c\")]", "redisListener", "r");
    assert misplaced("#[streamListener(\"s\", \"first\")]", "streamListener", "s");
}

test "build: #[kafkaListener] with one argument is refused - there is no one-argument form" {
    val out = buildFixture("kafka-one", header() + service("OneArg", handler("#[kafkaListener(\"t\")]", "k")));
    try asserts.notContains(out, "exit=0");
}

test "build: #[streamListener] refuses an offset that is neither first, last, next nor a decimal" {
    val bad = buildFixture("stream-bad", header() + service("Replay", handler("#[streamListener(\"s\", \"earliest\")]", "s")));
    try asserts.contains(bad, "#[streamListener] offset `earliest` is not first, last, next or a decimal number");
    try asserts.notContains(bad, "exit=0");
    val neg = buildFixture("stream-neg", header() + service("Replay", handler("#[streamListener(\"s\", \"-1\")]", "s")));
    try asserts.contains(neg, "is not first, last, next or a decimal number");
    val ok = buildFixture("stream-ok", header() + service("Replay", handler("#[streamListener(\"s\", \"last\")]", "s")));
    try asserts.contains(ok, "exit=0");
}

test "build: a handler that does not take one Message is refused" {
    val out = buildFixture("bad-param", header() + service("Needy", "    #[amqpListener(\"q\")]\n    pub fn on(self: Self, body: string) -> i32 {\n        return 0;\n    }\n"));
    try asserts.contains(out, "Needy.on must take exactly one parameter of type Message");
    try asserts.notContains(out, "exit=0");
}

test "build: #[listener] without a stereotype fails naming the fix" {
    val out = buildFixture("no-stereotype", header() + "#[listener]\npub type Bare() {\n" + handler("#[amqpListener(\"q\")]", "a") + "}\n");
    try asserts.contains(out, "#[listener] needs a stereotype on the same type");
    try asserts.notContains(out, "exit=0");
}
