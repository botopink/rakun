//// rakun-messaging — the `messaging.<arm>` indicators (front 15 step 6).

import {rkSetProp} from "rakun";
import {Health, healthIndicatorIds} from "rakun";
import {registry.rkRegisterListener};
import {container.resetMessaging, container.stopMessaging, container.startMessaging, container.stopBroker, container.startBroker};
import {messaging_health.armHealth};
import {messaging_host.rkMsgKillContainer, messaging_host.rkMsgWaitUntil};

fn clean() -> i32 {
    val _s = stopMessaging();
    for (["amqp", "kafka", "redis", "stream"]) { a -> val _t = rkSetProp("rakun.messaging." + a + ".transport", ""); };
    return resetMessaging();
}

test "health: each configured arm contributes one indicator" {
    val _c = clean();
    val _a = rkSetProp("rakun.messaging.amqp.transport", "memory");
    val _k = rkSetProp("rakun.messaging.kafka.transport", "memory");
    val _b = startMessaging();
    val ids = healthIndicatorIds();
    val _y = clean();
    assert ids.filter({ i -> i == "messaging.amqp" }).length == 1;
    assert ids.filter({ i -> i == "messaging.kafka" }).length == 1;
    assert ids.filter({ i -> i == "messaging.redis" }).length == 0;
}

test "health: a stopped broker turns its indicator DOWN naming the arm, and restarting it turns it UP" {
    val _c = clean();
    val _a = rkSetProp("rakun.messaging.amqp.transport", "memory");
    val _l = rkRegisterListener("amqp", "h-orders", "", "h-orders", { msg -> 0 });
    val _b = startMessaging();
    val up: Health = armHealth("amqp");
    val _s = stopBroker("amqp");
    val down: Health = armHealth("amqp");
    val _r = startBroker("amqp");
    val back: Health = armHealth("amqp");
    val _y = clean();
    assert up.status == "UP" && up.details == "{\"arm\":\"amqp\"}";
    assert down.status == "DOWN" && down.details == "{\"arm\":\"amqp\",\"reason\":\"the broker is not connected\"}";
    assert back.status == "UP";
}

test "health: an arm whose container has no live worker is DOWN naming the container, the connection up" {
    val _c = clean();
    val _a = rkSetProp("rakun.messaging.amqp.transport", "memory");
    val _l = rkRegisterListener("amqp", "h-dead", "", "h-dead", { msg -> 0 });
    val _b = startMessaging();
    val _k = rkMsgKillContainer("h-dead");
    val down: Health = armHealth("amqp");
    val _y = clean();
    assert down.status == "DOWN";
    assert down.details == "{\"arm\":\"amqp\",\"container\":\"h-dead\",\"reason\":\"no live worker\"}";
}
