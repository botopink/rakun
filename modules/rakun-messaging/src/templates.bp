//// rakun-messaging — the publishing templates. Front 15 step 5.
////
//// One per arm, each an injectable singleton: a `#[service]` field
//// `amqp: AmqpTemplate` resolves through `__rkMake_AmqpTemplate()`, which the
//// consumer imports (an emitted factory is not importable; these are written
//// by hand, as rakun-data's `__rkMake_SqlTemplate` is). A publish answers 0,
//// or non-zero when the arm has no connection — it never raises: whether a
//// failed publish is fatal is the caller's decision.

import {rkSingleton} from "rakun";
import {messaging_host.rkMsgPublish};

pub type AmqpTemplate() {
    pub fn send(self: Self, queue: string, payload: string) -> i32 {
        return rkMsgPublish("amqp", queue, "", payload);
    }
}

pub type KafkaTemplate() {
    pub fn send(self: Self, topic: string, key: string, payload: string) -> i32 {
        return rkMsgPublish("kafka", topic, key, payload);
    }
}

pub type RedisPubSubTemplate() {
    pub fn publish(self: Self, channel: string, payload: string) -> i32 {
        return rkMsgPublish("redis", channel, "", payload);
    }
}

pub type StreamTemplate() {
    pub fn append(self: Self, stream: string, payload: string) -> i32 {
        return rkMsgPublish("stream", stream, "", payload);
    }
}

pub fn __rkMake_AmqpTemplate() -> AmqpTemplate {
    return rkSingleton("AmqpTemplate", { -> AmqpTemplate() });
}

pub fn __rkMake_KafkaTemplate() -> KafkaTemplate {
    return rkSingleton("KafkaTemplate", { -> KafkaTemplate() });
}

pub fn __rkMake_RedisPubSubTemplate() -> RedisPubSubTemplate {
    return rkSingleton("RedisPubSubTemplate", { -> RedisPubSubTemplate() });
}

pub fn __rkMake_StreamTemplate() -> StreamTemplate {
    return rkSingleton("StreamTemplate", { -> StreamTemplate() });
}
