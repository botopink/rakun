//// rakun-messaging — the host cells of front 91's Pulsar arm
//// (`rakun_pulsar.erl`). Root-level because a sidecar called only from a
//// folder (`src/pulsar/`) is not shipped.

#[@External.Erlang("""(fun(__B) -> binary:encode_hex(<<(rakun_pulsar:crc32c(__B)):32>>, lowercase) end)($0)""")]
pub declare fn pulsarCrc32cHex(bytes: string) -> string;

#[@External.Erlang("""(fun(__N) -> binary:encode_hex(rakun_pulsar:encode_simple(__N, []), lowercase) end)($0)""")]
pub declare fn pulsarSimpleFrameHex(command: string) -> string;

#[@External.Erlang("""(fun(__N, __M, __P) -> binary:encode_hex(rakun_pulsar:encode_payload(__N, [], __M, __P), lowercase) end)($0, $1, $2)""")]
pub declare fn pulsarPayloadFrameHex(
    command: string,
    metadata: string,
    payload: string,
) -> string;

#[@External.Erlang("""(fun(__H, __Split, __Max) -> __B = binary:decode_hex(__H), <<__A:__Split/binary, __Rest/binary>> = __B, __First = case rakun_pulsar:decode(__A, __Max) of more -> <<"more">>; {ok, __C, _} -> __C; {error, __E} -> <<"error:", __E/binary>> end, __Whole = case rakun_pulsar:decode(<<__A/binary, __Rest/binary>>, __Max) of more -> <<"more">>; {ok, __C2, _} -> __C2; {error, __E2} -> <<"error:", __E2/binary>> end, <<__First/binary, "|", __Whole/binary>> end)($0, $1, $2)""")]
pub declare fn pulsarDecodeSplit(
    frameHex: string,
    splitAt: i32,
    maxBytes: i32,
) -> string;
