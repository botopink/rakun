//// rakun-messaging — the host cells of front 90's STOMP arm (`rakun_jms.erl`)
//// and its test broker (`rakun_jms_fixture.erl`). Root-level because a
//// sidecar called only from a folder (`src/jms/`) is not shipped.

import {compiler} from "std";

#[compiler.external(.Erlang("rakun_jms:encode($0, $1, $2)"))]
pub declare fn rkJmsEncode(
    command: string,
    headers: array<#(string, string)>,
    body: string,
) -> string;

#[compiler.external(
    .Erlang("""(fun(__B) -> case rakun_jms:decode(__B) of {ok, {__C, __H, __Bd}, _} -> {__C, __H, __Bd}; more -> {<<>>, [], <<>>} end end)($0)"""),
)]
pub declare fn rkJmsDecode(
    frame: string,
) -> #(string, array<#(string, string)>, string);

#[compiler.external(.Erlang("rakun_jms:escape($0)"))]
pub declare fn rkJmsEscape(value: string) -> string;

#[compiler.external(.Erlang("rakun_jms:unescape($0)"))]
pub declare fn rkJmsUnescape(value: string) -> string;

#[compiler.external(
    .Erlang("""(fun(__H, __P, __U, __W, __B, __T) -> case rakun_jms:connect(__H, __P, __U, __W, __B, case __T of <<>> -> []; __N -> rakun_ssl:connect_options(__N, __H) end) of {ok, __Pid} -> list_to_binary(pid_to_list(__Pid)); {error, __E} -> <<"error:", __E/binary>> end end)($0, $1, $2, $3, $4, $5)"""),
)]
pub declare fn rkJmsConnect(
    host: string,
    port: i32,
    user: string,
    password: string,
    heartMs: i32,
    bundle: string,
) -> string;

#[compiler.external(
    .Erlang("""(fun(__C, __D, __B, __H) -> case rakun_jms:send(list_to_pid(binary_to_list(__C)), __D, __B, __H) of ok -> <<>>; {error, __E} -> __E end end)($0, $1, $2, $3)"""),
)]
pub declare fn rkJmsSend(
    conn: string,
    destination: string,
    body: string,
    headers: array<#(string, string)>,
) -> string;

#[compiler.external(
    .Erlang("""(fun(__C, __Id, __D, __A, __X, __F) -> case rakun_jms:subscribe(list_to_pid(binary_to_list(__C)), __Id, __D, __A, __X, fun(__Bd, __Hs) -> case __F(__Bd, __Hs) of true -> ack; _ -> nack end end) of ok -> <<>>; {error, __E} -> __E end end)($0, $1, $2, $3, $4, $5)"""),
)]
pub declare fn rkJmsSubscribe(
    conn: string,
    id: string,
    destination: string,
    ack: string,
    extra: array<#(string, string)>,
    handler: fn(body: string, headers: array<#(string, string)>) -> bool,
) -> string;

#[compiler.external(
    .Erlang("""(fun(__C, __Id) -> rakun_jms:unsubscribe(list_to_pid(binary_to_list(__C)), __Id), 0 end)($0, $1)"""),
)]
pub declare fn rkJmsUnsubscribe(conn: string, id: string) -> i32;

#[compiler.external(
    .Erlang("""(fun(__C) -> rakun_jms:close(list_to_pid(binary_to_list(__C))), 0 end)($0)"""),
)]
pub declare fn rkJmsClose(conn: string) -> i32;

#[compiler.external(
    .Erlang("""(fun(__C) -> is_process_alive(list_to_pid(binary_to_list(__C))) end)($0)"""),
)]
pub declare fn rkJmsAlive(conn: string) -> bool;

#[compiler.external(
    .Erlang("""(fun(__C) -> rakun_jms:reconnects(list_to_pid(binary_to_list(__C))) end)($0)"""),
)]
pub declare fn rkJmsReconnects(conn: string) -> i32;

#[compiler.external(
    .Erlang("""(fun(__C, __D, __B, __T) -> rakun_jms:request(list_to_pid(binary_to_list(__C)), __D, __B, __T, integer_to_binary(erlang:unique_integer([positive]))) end)($0, $1, $2, $3)"""),
)]
pub declare fn rkJmsRequest(
    conn: string,
    destination: string,
    body: string,
    timeoutMs: i32,
) -> Result<string, string>;

#[compiler.external(.Erlang("rakun_jms_fixture:start($0)"))]
pub declare fn jmsFixtureStart(opts: string[]) -> i32;

#[compiler.external(.Erlang("rakun_jms_fixture:stop($0)"))]
pub declare fn jmsFixtureStop(port: i32) -> i32;

#[compiler.external(.Erlang("rakun_jms_fixture:drop_all($0)"))]
pub declare fn jmsFixtureDropAll(port: i32) -> i32;

#[compiler.external(.Erlang("rakun_jms_fixture:frames($0)"))]
pub declare fn jmsFixtureFrames(port: i32) -> string[];
