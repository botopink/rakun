//// rakun-messaging — the host cells over `src/sidecars/rakun_messaging.erl`
//// (`messaging_host`, not `host`: a consumer may hold another member's `host`).
////
//// The listener registry, the in-process broker (logs, groups, in-flight
//// sets), the containers under rakun's supervision tree, the arms' state, the
//// published log and the startup log. Everything that DECIDES — the settings,
//// the ack-mode rule, the refusals, the `Message` value — is botopink.

// ── the registry ────────────────────────────────────────────────────────────

#[@external(.Erlang("rakun_messaging:register($0, $1, $2, $3, $4, $5)"))]
pub declare fn rkMsgRegister(
    name: string,
    broker: string,
    destination: string,
    group: string,
    container: string,
    invoke: fn(broker: string, destination: string, key: string, payload: string, headersJson: string, offset: i64) -> i32,
) -> i32;

#[@external(.Erlang("rakun_messaging:listener_count()"))]
pub declare fn rkMsgListenerCount() -> i32;

#[@external(.Erlang("rakun_messaging:listener_destinations()"))]
pub declare fn rkMsgListenerDestinations() -> string[];

#[@external(.Erlang("rakun_messaging:listener_names()"))]
pub declare fn rkMsgListenerNames() -> string[];

// `name|broker|destination|group|container`, registration order.
#[@external(.Erlang("rakun_messaging:listeners()"))]
pub declare fn rkMsgListeners() -> string[];

// `broker|destination|first|second`, one per duplicate registration.
#[@external(.Erlang("rakun_messaging:duplicates()"))]
pub declare fn rkMsgDuplicates() -> string[];

#[@external(.Erlang("rakun_messaging:invoke_direct($0, $1, $2, $3, $4, $5)"))]
pub declare fn rkMsgInvokeDirect(
    broker: string,
    destination: string,
    key: string,
    payload: string,
    headersJson: string,
    offset: i64,
) -> i32;

#[@external(.Erlang("rakun_messaging:reset()"))]
pub declare fn rkMsgReset() -> i32;

// ── arms ────────────────────────────────────────────────────────────────────

#[@external(.Erlang("rakun_messaging:arm_connect($0, $1)"))]
pub declare fn rkMsgArmConnect(arm: string, properties: string[]) -> i32;

#[@external(.Erlang("rakun_messaging:arm_disconnect($0)"))]
pub declare fn rkMsgArmDisconnect(arm: string) -> i32;

#[@external(.Erlang("rakun_messaging:arm_connected($0)"))]
pub declare fn rkMsgArmConnected(arm: string) -> bool;

#[@external(.Erlang("rakun_messaging:arm_properties($0)"))]
pub declare fn rkMsgArmProperties(arm: string) -> string[];

// `key=value` for every property under the prefix, sorted by key.
#[@external(.Erlang("rakun_messaging:props_under($0)"))]
pub declare fn rkMsgPropsUnder(prefix: string) -> string[];

// ── publishing ──────────────────────────────────────────────────────────────

#[@external(.Erlang("rakun_messaging:publish($0, $1, $2, $3)"))]
pub declare fn rkMsgPublish(
    arm: string,
    destination: string,
    key: string,
    payload: string,
) -> i32;

// `destination|key|payload`, publish order.
#[@external(.Erlang("rakun_messaging:published($0)"))]
pub declare fn rkMsgPublished(arm: string) -> string[];

#[@external(.Erlang("rakun_messaging:published_clear()"))]
pub declare fn rkMsgPublishedClear() -> i32;

// ── containers ──────────────────────────────────────────────────────────────

#[@external(.Erlang("rakun_messaging:start_container($0, $1, $2, $3, $4, $5, $6)"))]
pub declare fn rkMsgStartContainer(
    name: string,
    broker: string,
    destination: string,
    group: string,
    concurrency: i32,
    prefetch: i32,
    ackMode: string,
) -> i32;

#[@external(.Erlang("rakun_messaging:stop_containers()"))]
pub declare fn rkMsgStopContainers() -> i32;

#[@external(.Erlang("rakun_messaging:containers()"))]
pub declare fn rkMsgContainers() -> string[];

#[@external(.Erlang("rakun_messaging:container_workers($0)"))]
pub declare fn rkMsgContainerWorkers(name: string) -> i32;

#[@external(.Erlang("rakun_messaging:kill_worker($0, $1)"))]
pub declare fn rkMsgKillWorker(name: string, index: i32) -> string;

#[@external(.Erlang("rakun_messaging:kill_container($0)"))]
pub declare fn rkMsgKillContainer(name: string) -> i32;

#[@external(.Erlang("rakun_messaging:inflight($0)"))]
pub declare fn rkMsgInflight(name: string) -> i32;

// How many times the message at `broker|destination|offset` reached a worker.
#[@external(.Erlang("rakun_messaging:deliveries($0)"))]
pub declare fn rkMsgDeliveries(key: string) -> i32;

#[@external(.Erlang("rakun_messaging:bump($0)"))]
pub declare fn rkMsgBump(key: string) -> i32;

#[@external(.Erlang("rakun_messaging:count($0)"))]
pub declare fn rkMsgCount(key: string) -> i32;

#[@external(.Erlang("rakun_messaging:ack()"))]
pub declare fn rkMsgAck() -> i32;

#[@external(.Erlang("rakun_messaging:nack()"))]
pub declare fn rkMsgNack() -> i32;

#[@external(.Erlang("rakun_messaging:current_tag()"))]
pub declare fn rkMsgCurrentTag() -> string;

// ── the startup log, waiting, integers ──────────────────────────────────────

#[@external(.Erlang("rakun_messaging:log_line($0)"))]
pub declare fn rkMsgLogLine(line: string) -> i32;

#[@external(.Erlang("rakun_messaging:log_lines()"))]
pub declare fn rkMsgLogLines() -> string[];

#[@external(.Erlang("rakun_messaging:log_clear()"))]
pub declare fn rkMsgLogClear() -> i32;

#[@external(.Erlang("rakun_messaging:wait_until($0, $1)"))]
pub declare fn rkMsgWaitUntil(ms: i32, probe: fn() -> bool) -> bool;

#[@external(.Erlang("rakun_messaging:wide($0)"))]
pub declare fn rkMsgWide(n: i32) -> i64;
