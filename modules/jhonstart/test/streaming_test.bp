// `botopink test` flat suite for `src/streaming.bp` and the composition half
// of `src/render.bp` (front 30): the render over a RECORDING `Response`.
//
// The recorder is two inline host templates per row — a list of events kept
// in the test process (`put` / `get` on erlang, a `globalThis` array on
// node): `status 404`, `header location /login`, `write <chunk>`, `close`.
// On erlang the fills are written from the render's own process (the
// completion gather hands each value back to it), so the recorder sees every
// write.

import {element.Element, element.ElementBase, element.text, element.div, element.p, element.span, element.ul, element.li};
import {elements.h2, elements.section, elements.main};
import {server.RequestData, server.cookies, server.request};
import {router.selectedLayoutSegment, router.pathname, router.searchParams};
import {error_boundary.notFound, error_boundary.redirect, error_boundary.ErrorInfo};
import {suspense.Boundary, suspense.Suspense, suspense.holeId};
import {render.compose, render.resetRender, render.registeredBoundaries, render.renderNode, render.RenderHooks, render.setHooks, render.defaultHooks, render.attemptTask, render.attemptRender, render.isLangTag};
import {streaming.Response, streaming.PageInput, streaming.App, streaming.app, streaming.redirectAllowed, streaming.extrasProblem, streaming.guarded};
import {plugin.RenderPlugin, plugin.Json};
import {routes.PageContext, routes.LayoutProps, routes.UiSegment, routes.segment, routes.withLayout, routes.withTemplate, routes.withError, routes.withLoading, routes.withNotFound};
import {metadata.Metadata, metadata.Viewport, metadata.emptyMetadata};
import {async, async.Gate} from "std";

// ── the recorder ────────────────────────────────────────────────────────────

#[@External.Node("""(globalThis.__jhRec = [], 0)""")]
#[@External.Erlang("""(fun() -> put(jh_rec, []), 0 end)()""")]
declare fn recReset() -> i32;

#[@External.Node("""((globalThis.__jhRec = (globalThis.__jhRec || []).concat([$0])), 0)""")]
#[@External.Erlang("""(fun(__E) -> put(jh_rec, (case get(jh_rec) of undefined -> []; __L -> __L end) ++ [__E]), 0 end)($0)""")]
declare fn recPush(event: string) -> i32;

#[@External.Node("""(globalThis.__jhRec || [])""")]
#[@External.Erlang("""(fun() -> case get(jh_rec) of undefined -> []; __L -> __L end end)()""")]
declare fn recEvents() -> Array<string>;

fn recStatus(code: i32) -> void {
    recPush("status " + code.toString());
}

fn recHeader(name: string, value: string) -> void {
    recPush("header " + name + " " + value);
}

fn recWrite(chunk: string) -> @Task<void> {
    recPush("write " + chunk);
}

// A recorded write that also opens `afterAside` once the aside's fill (`h2`)
// has been written — the signal `slowPosts` answers on.
fn recWriteOpening(chunk: string, afterAside: Gate) -> @Task<void> {
    recPush("write " + chunk);
    if (chunk.contains("data-jh-f=\"h2\"")) async.openGate(afterAside);
}

fn recClose() -> @Task<void> {
    recPush("close");
}

fn recorder() -> Response {
    recReset();
    return Response(
        status: { code -> recStatus(code) },
        header: { name, value -> recHeader(name, value) },
        write: { chunk -> recWrite(chunk) },
        close: { -> recClose() },
    );
}

// The recorder of a `StreamedPage(afterAside)` render: it opens `afterAside`
// when it writes the aside's fill, and only then can the posts boundary answer.
fn recorderOpening(afterAside: Gate) -> Response {
    recReset();
    return Response(
        status: { code -> recStatus(code) },
        header: { name, value -> recHeader(name, value) },
        write: { chunk -> recWriteOpening(chunk, afterAside) },
        close: { -> recClose() },
    );
}

fn writes() -> Array<string> {
    return recEvents().filter({ e -> e.startsWith("write ") });
}

fn countOf(kind: string) -> i32 {
    return recEvents().filter({ e -> e.startsWith(kind) }).length;
}

fn allText() -> string {
    return recEvents().join("\n");
}

fn req() -> RequestData {
    return RequestData(
        method: "GET",
        path: "/blog/hi",
        params: [#("slug", "hi")],
        query: [],
        headers: [],
        cookies: [#("session", "s1")],
    );
}

fn anonymous() -> RequestData {
    return RequestData(
        method: "GET",
        path: "/dashboard",
        params: [],
        query: [],
        headers: [],
        cookies: [],
    );
}

val table = "L|/\nP|/blog/[slug]\nP|/login\nP|/blog\nP|/dashboard";

fn inputOf(
    pattern: string,
    chain: Array<UiSegment>,
    page: fn() -> @Component<Element>,
) -> PageInput {
    return PageInput(
        build: "b1",
        pathname: "/blog/hi",
        pattern: pattern,
        params: "slug=hi",
        query: "",
        table: table,
        actions: [],
        chain: chain,
        page: page,
        metadata: [],
        viewports: [],
    );
}

fn outcomeText(r: @Result<void, string>) -> string {
    return case r {
        Ok(v) -> "ok";
        Error(message) -> message;
    };
}

// ── pages and layouts ───────────────────────────────────────────────────────

fn RootLayout(props: LayoutProps) -> @Component<Element> {
    val depth = use selectedLayoutSegment();
    return main([props.children], attrs: [#("class", "root")]);
}

fn BlogPage() -> @Component<Element> {
    val slug = use pathname();
    return p([text("post " + slug, attrs: [])], attrs: []);
}

// How long a boundary waits on a gate before it gives up. Every gate these
// tests close is opened by the render itself, so it only elapses when the
// render is wrong — and then as a red assertion, not a hang.
val gateBudget = 10000;

// The posts boundary answers only once the aside's fill has been WRITTEN
// (`recorderOpening` opens the gate then), so the fills come h2 then h1 by
// construction. A 30 ms `delay` said the same only while the machine was
// idle: on erlang each boundary is its own process, and under load the aside's
// process could be scheduled after the timer fired.
fn slowPosts(afterAside: Gate) -> @Component<Element> {
    val opened = await async.awaitGate(afterAside, gateBudget);
    val rows = if (opened)
        ["a", "b"]
    else
        ["the aside's fill was never written"];
    return ul(
        rows.map({ r -> li([text(r, attrs: [])], attrs: []) }),
        attrs: [#("class", "posts")],
    );
}

fn fastAside() -> @Component<Element> {
    return span([text("aside", attrs: [])], attrs: []);
}

fn StreamedPage(afterAside: Gate) -> @Component<Element> {
    return section(
        [
            h2([text("Blog", attrs: [])], attrs: []),
            Suspense(
                Boundary(
                    id: holeId(1),
                    fallback: div([text("wait", attrs: [])], attrs: []),
                    child: { -> slowPosts(afterAside) },
                ),
            ),
            Suspense(
                Boundary(
                    id: holeId(2),
                    fallback: div([text("wait2", attrs: [])], attrs: []),
                    child: { -> fastAside() },
                ),
            ),
        ],
        attrs: [],
    );
}

fn MissingPage() -> @Component<Element> {
    notFound();
    return div([], attrs: []);
}

fn LoginRedirectPage() -> @Component<Element> {
    redirect("/login");
    return div([], attrs: []);
}

fn NowhereRedirectPage() -> @Component<Element> {
    redirect("/nowhere");
    return div([], attrs: []);
}

fn EvilRedirectPage() -> @Component<Element> {
    redirect("https://evil.example");
    return div([], attrs: []);
}

fn AccountsRedirectPage() -> @Component<Element> {
    redirect("https://accounts.example/");
    return div([], attrs: []);
}

fn pageRan() -> @Component<Element> {
    recPush("page ran");
    return div([], attrs: []);
}

fn SessionLayout(props: LayoutProps) -> @Component<Element> {
    val jar = cookies();
    if (jar.length == 0) redirect("/login");
    return div([props.children], attrs: [#("class", "dash")]);
}

fn NotFoundView() -> Element {
    return div([h2([text("No such post", attrs: [])], attrs: [])], attrs: []);
}

fn ErrorView(info: ErrorInfo) -> Element {
    return div(
        [text("failed " + info.digest, attrs: [])],
        attrs: [#("class", "err")],
    );
}

fn LoadingView() -> Element {
    return div([text("loading", attrs: [])], attrs: [#("class", "sk")]);
}

fn TemplateView(props: LayoutProps) -> @Component<Element> {
    return div([props.children], attrs: [#("class", "tpl")]);
}

fn LayoutView(props: LayoutProps) -> @Component<Element> {
    return section([props.children], attrs: [#("class", "layout")]);
}

fn fullSegment() -> UiSegment {
    return withNotFound(
        withLoading(
            withError(
                withTemplate(
                    withLayout(
                        segment("/blog/[slug]"),
                        { props -> LayoutView(props) },
                    ),
                    { props -> TemplateView(props) },
                ),
                { info -> ErrorView(info) },
            ),
            { -> LoadingView() },
        ),
        { -> NotFoundView() },
    );
}

// ── step 8: the streamed render ─────────────────────────────────────────────

test "stream: a page with boundaries writes the shell, then each fill, each awaited" {
    val site = app([], []);
    val afterAside = async.newGate();
    val out = await site.renderStream(
        inputOf("/blog", [], { -> StreamedPage(afterAside) }),
        req(),
        recorderOpening(afterAside),
    );
    assert outcomeText(out) == "ok";
    val w = writes();
    assert w.length == 4;
    assert (w.at(0) ?? "").contains("<body><div data-jh-root=\"\">");
    assert (w.at(0) ?? "").contains("data-jh-h=\"h1\"");
    assert (w.at(0) ?? "").contains("class=\"posts\"") == false;
    assert countOf("close") == 1;
    assert recEvents().at(0) ?? "" == "status 200";
}

test "stream: fills come in completion order, each carrying its own markup" {
    val site = app([], []);
    val afterAside = async.newGate();
    val out = await site.renderStream(
        inputOf("/blog", [], { -> StreamedPage(afterAside) }),
        req(),
        recorderOpening(afterAside),
    );
    val w = writes();
    assert (w.at(1) ?? "").startsWith(
        "write <template data-jh-f=\"h2\"><span>aside</span></template>",
    );
    assert (w.at(2) ?? "").startsWith(
        "write <template data-jh-f=\"h1\"><ul class=\"posts\">",
    );
    assert (w.at(3) ?? "").contains("<script>window.__bp0 = {\"v\":1,");
    assert (w.at(3) ?? "").contains("\"h\":[\"h1\",\"h2\"]");
}

// Opens `mine`, then answers `value` once `theirs` is open. The two loaders
// below cross their gates, so both answer only when the two boundaries are in
// flight at the same time: a render that resolved them one after the other
// leaves the first waiting on a gate the second has not opened, and it answers
// "gate never opened".
fn loader(mine: Gate, theirs: Gate, value: string) -> @Component<Element> {
    async.openGate(mine);
    val opened = await async.awaitGate(theirs, gateBudget);
    val shown = if (opened) value else "gate never opened: " + value;
    return span([text(shown, attrs: [])], attrs: []);
}

fn TwoLoaders(a: Gate, b: Gate) -> @Component<Element> {
    return div(
        [
            Suspense(
                Boundary(
                    id: holeId(1),
                    fallback: div([], attrs: []),
                    child: { -> loader(a, b, "a") },
                ),
            ),
            Suspense(
                Boundary(
                    id: holeId(2),
                    fallback: div([], attrs: []),
                    child: { -> loader(b, a, "b") },
                ),
            ),
        ],
        attrs: [],
    );
}

test "stream: two boundaries resolve concurrently — each waits on the other" {
    val site = app([], []);
    val a = async.newGate();
    val b = async.newGate();
    val out = await site.renderStream(
        inputOf("/blog", [], { -> TwoLoaders(a, b) }),
        req(),
        recorder(),
    );
    assert outcomeText(out) == "ok";
    assert writes().length == 4;
    assert allText().contains("<span>a</span>");
    assert allText().contains("<span>b</span>");
    assert allText().contains("gate never opened") == false;
}

// ── step 4: composition ─────────────────────────────────────────────────────

test "compose: layout > template > error > loading > not-found > page, in the markup" {
    val site = app([], []);
    val out = await site.renderStream(
        inputOf("/blog/[slug]", [fullSegment()], { -> BlogPage() }),
        req(),
        recorder(),
    );
    assert outcomeText(out) == "ok";
    val shell = writes().at(0) ?? "";
    val nest = shell.indexOf(
        "<section class=\"layout\"><div class=\"tpl\"><div data-jh-t=",
    );
    assert shell.contains(
        "<section class=\"layout\"><div data-jh-t=\"/blog/[slug]#",
    );
    assert shell.contains(
        "\"><div class=\"tpl\"><div data-jh-e=\"/blog/[slug]\"><div data-jh-h=\"h1\"><div class=\"sk\">loading</div></div></div></div></div></section>",
    );
    val fill = writes().at(1) ?? "";
    assert fill.contains(
        "<template data-jh-f=\"h1\"><div data-jh-n=\"/blog/[slug]\"><p>post /blog/hi</p></div></template>",
    );
}

test "compose: a segment with no template contributes no wrapper" {
    val site = app([], []);
    val bare = withLayout(segment("/"), { props -> LayoutView(props) });
    val out = await site.render(
        inputOf("/blog/[slug]", [bare], { -> BlogPage() }),
        req(),
        recorder(),
    );
    val doc = writes().at(0) ?? "";
    assert doc.contains(
        "<div data-jh-root=\"\"><section class=\"layout\"><p>post /blog/hi</p></section></div>",
    );
}

fn depthLayout(props: LayoutProps) -> @Component<Element> {
    val here = use selectedLayoutSegment();
    return div([text("[" + here + "]", attrs: []), props.children], attrs: []);
}

test "compose: each layout receives its selected depth, root-first" {
    val site = app([], []);
    val chain = [
        withLayout(segment("/"), { props -> depthLayout(props) }),
        withLayout(segment("/blog"), { props -> depthLayout(props) }),
        withLayout(segment("/blog/[slug]"), { props -> depthLayout(props) }),
    ];
    val out = await site.render(
        inputOf("/blog/[slug]", chain, { -> BlogPage() }),
        req(),
        recorder(),
    );
    val doc = writes().at(0) ?? "";
    assert doc.contains(
        "<div>[blog]<div>[[slug]]<div>[]<p>post /blog/hi</p></div></div></div>",
    );
}

test "compose: two renders of one route give the template two keys" {
    val site = app([], []);
    val tpl = withTemplate(segment("/blog"), { props -> TemplateView(props) });
    val a = await site.render(
        inputOf("/blog", [tpl], { -> BlogPage() }),
        req(),
        recorder(),
    );
    val first = writes().at(0) ?? "";
    val b = await site.render(
        inputOf("/blog", [tpl], { -> BlogPage() }),
        req(),
        recorder(),
    );
    val second = writes().at(0) ?? "";
    assert first.contains("data-jh-t=\"/blog#");
    assert first != second;
}

// ── step 8: the request the render entered ──────────────────────────────────

fn RequestEcho() -> @Component<Element> {
    val r = use request();
    return p([text(r.cookie("session"), attrs: [])], attrs: []);
}

fn readAfter() -> @Component<Element> {
    val r = use request();
    return p([], attrs: []);
}

fn readRequestOutside() -> @Task<i32> {
    val r = await request();
    return r.cookies.length;
}

test "stream: a component reads the req the render received, and nothing after it ends" {
    val site = app([], []);
    val out = await site.render(
        inputOf("/blog", [], { -> RequestEcho() }),
        req(),
        recorder(),
    );
    assert (writes().at(0) ?? "").contains("<p>s1</p>");
    val outside = await attemptTask({ -> readRequestOutside() });
    val message = case outside {
        Ok(n) -> "read " + n.toString();
        Error(m) -> m;
    };
    assert message.contains("request() read outside a render");
}

fn bundleTag(route: string) -> string {
    return "<script src=\"/b.js\"></script>";
}

test "stream: defaultHooks renders a working document with no <script src>; one field replaced keeps the other" {
    val site = app([], []);
    setHooks(defaultHooks());
    val plain = await site.render(
        inputOf("/blog", [], { -> BlogPage() }),
        req(),
        recorder(),
    );
    val doc = writes().at(0) ?? "";
    assert doc.contains("<script src") == false;
    assert doc.startsWith(
        "write <!DOCTYPE html><html lang=\"en\"><head><meta charset=\"utf-8\">",
    );
    assert doc.endsWith("</body></html>");
    val base = defaultHooks();
    setHooks(
        RenderHooks(
            headExtra: base.headExtra,
            bodyExtra: { route -> bundleTag(route) },
        ),
    );
    val bundled = await site.render(
        inputOf("/blog", [], { -> BlogPage() }),
        req(),
        recorder(),
    );
    val withBundle = writes().at(0) ?? "";
    assert withBundle.contains(
        "</script><script src=\"/b.js\"></script></body></html>",
    );
    assert withBundle.contains("<meta charset=\"utf-8\"></head>");
    setHooks(defaultHooks());
}

// ── navigation signals before the first chunk ───────────────────────────────

test "signal: notFound before the first chunk is a 404 with the nearest not-found boundary" {
    val site = app([], []);
    val seg = withNotFound(segment("/blog/[slug]"), { -> NotFoundView() });
    val out = await site.render(
        inputOf("/blog/[slug]", [seg], { -> MissingPage() }),
        req(),
        recorder(),
    );
    assert outcomeText(out) == "ok";
    assert recEvents().at(0) ?? "" == "status 404";
    assert writes().length == 1;
    assert (writes().at(0) ?? "").contains("<h2>No such post</h2>");
    assert countOf("close") == 1;
}

test "signal: redirect(\"/login\") before the first chunk is a 307 with no body" {
    val site = app([], []);
    val out = await site.renderStream(
        inputOf("/blog", [], { -> LoginRedirectPage() }),
        req(),
        recorder(),
    );
    assert outcomeText(out) == "ok";
    assert allText() == "status 307\nheader location /login\nclose";
}

test "signal: a layout's redirect means the page never runs" {
    val site = app([], []);
    val guard = withLayout(
        segment("/dashboard"),
        { props -> SessionLayout(props) },
    );
    val out = await site.renderStream(
        inputOf("/dashboard", [guard], { -> pageRan() }),
        anonymous(),
        recorder(),
    );
    assert allText() == "status 307\nheader location /login\nclose";
    assert allText().contains("page ran") == false;
}

test "signal: a target outside the table, or an unlisted absolute one, fails the render" {
    val site = app([], []);
    val nowhere = await site.renderStream(
        inputOf("/blog", [], { -> NowhereRedirectPage() }),
        req(),
        recorder(),
    );
    assert outcomeText(nowhere).contains("`/nowhere` refused");
    assert allText() == "close";
    val evil = await site.renderStream(
        inputOf("/blog", [], { -> EvilRedirectPage() }),
        req(),
        recorder(),
    );
    assert outcomeText(evil).contains("`https://evil.example` refused");
    assert allText() == "close";
    val listed = app([], ["https://accounts.example/"]);
    val ok = await listed.renderStream(
        inputOf("/blog", [], { -> AccountsRedirectPage() }),
        req(),
        recorder(),
    );
    assert outcomeText(ok) == "ok";
    assert allText()
        == "status 307\nheader location https://accounts.example/\nclose";
}

test "signal: redirectAllowed checks relative targets against the table only" {
    assert redirectAllowed(table, [], "/login");
    assert redirectAllowed(table, [], "/blog/hi?x=1");
    assert redirectAllowed(table, [], "/nowhere") == false;
    assert redirectAllowed(table, [], "https://a.example") == false;
    assert redirectAllowed(table, ["https://a.example"], "https://a.example");
    assert redirectAllowed(table, [], "login") == false;
}

// ── late signals: after the first chunk ─────────────────────────────────────

fn lateMissing() -> @Component<Element> {
    notFound();
    return div([], attrs: []);
}

fn lateLogin() -> @Component<Element> {
    redirect("/blog");
    return div([], attrs: []);
}

fn lateNowhere() -> @Component<Element> {
    redirect("/nowhere");
    return div([], attrs: []);
}

fn LateNotFoundPage() -> @Component<Element> {
    return div(
        [
            Suspense(
                Boundary(
                    id: holeId(1),
                    fallback: div([], attrs: []),
                    child: { -> lateMissing() },
                ),
            ),
        ],
        attrs: [],
    );
}

fn LateRedirectPage() -> @Component<Element> {
    return div(
        [
            Suspense(
                Boundary(
                    id: holeId(1),
                    fallback: div([], attrs: []),
                    child: { -> lateLogin() },
                ),
            ),
        ],
        attrs: [],
    );
}

fn LateNowherePage() -> @Component<Element> {
    return div(
        [
            Suspense(
                Boundary(
                    id: holeId(1),
                    fallback: div([], attrs: []),
                    child: { -> lateNowhere() },
                ),
            ),
        ],
        attrs: [],
    );
}

test "late: a notFound after the shell is the last chunk, status 200, no later fill" {
    val site = app([], []);
    val out = await site.renderStream(
        inputOf("/blog", [], { -> LateNotFoundPage() }),
        req(),
        recorder(),
    );
    assert outcomeText(out) == "ok";
    assert countOf("status") == 1;
    assert recEvents().at(0) ?? "" == "status 200";
    assert writes().at(1) ?? ""
        == "write <template data-jh-g=\"not-found\"><h1>Not found</h1></template><script>__bp2()</script>";
    assert countOf("close") == 1;
}

test "late: a redirect after the shell is data-jh-g markup through escape.attribute" {
    val site = app([], []);
    val out = await site.renderStream(
        inputOf("/blog", [], { -> LateRedirectPage() }),
        req(),
        recorder(),
    );
    assert outcomeText(out) == "ok";
    assert writes().at(1) ?? ""
        == "write <template data-jh-g=\"redirect\" data-jh-to=\"/blog\"></template><script>__bp2()</script>";
    assert countOf("status") == 1;
}

test "late: a refused target after the shell fails the render and writes no markup" {
    val site = app([], []);
    val out = await site.renderStream(
        inputOf("/blog", [], { -> LateNowherePage() }),
        req(),
        recorder(),
    );
    assert outcomeText(out).contains("`/nowhere` refused");
    assert allText().contains("data-jh-g") == false;
    assert countOf("close") == 1;
}

// ── the response guard ──────────────────────────────────────────────────────

fn statusAfterWrite() -> @Task<i32> {
    val g = guarded(recorder());
    val w = g.write;
    await w("x");
    val s = g.status;
    s(500);
    return 0;
}

test "response: status after the first write fails, naming the call" {
    resetRender();
    val out = await site_attempt();
    assert out.contains("status(500) after the first write");
}

fn site_attempt() -> @Task<string> {
    val r = await attemptTask({ -> statusAfterWrite() });
    return case r {
        Ok(v) -> "ok";
        Error(m) -> m;
    };
}

// ── step 6: the render plugin and the order it is called in ─────────────────

fn plHead() -> @Task<string> {
    recPush("plugin head");
    return "<style>.head{}</style>";
}

fn plChunk(holeId: string) -> @Task<string> {
    recPush("plugin chunk " + holeId);
    val css = await async.delay(5, "<style>." + holeId + "{}</style>");
    return css;
}

fn plClose() -> @Task<@Result<void, string>> {
    recPush("plugin close");
    return;
}

fn plCloseFails() -> @Task<@Result<void, string>> {
    throw "a class was registered after the last chunk";
}

fn plPayload() -> @Task<Array<#(string, Json)>> {
    recPush("plugin payload");
    return [#("x", "[1]")];
}

fn plNoPayload() -> @Task<Array<#(string, Json)>> {
    return [];
}

fn plRenderKey() -> @Task<Array<#(string, Json)>> {
    return [#("t", "1")];
}

fn recording() -> RenderPlugin {
    return RenderPlugin(
        name: "rec",
        head: { -> plHead() },
        chunk: { id -> plChunk(id) },
        close: { -> plClose() },
        payload: { -> plPayload() },
    );
}

fn quiet(name: string) -> RenderPlugin {
    return RenderPlugin(
        name: name,
        head: { -> quietHead() },
        chunk: { id -> quietChunk(id) },
        close: { -> plClose() },
        payload: { -> plNoPayload() },
    );
}

fn quietHead() -> @Task<string> {
    return "";
}

fn quietChunk(holeId: string) -> @Task<string> {
    return "";
}

fn pluginList() -> Array<RenderPlugin> {
    return [recording()];
}

fn pluginEvents() -> string[] {
    return recEvents().filter({ e -> e.startsWith("plugin ") });
}

// `chunk(id)` runs in the process that resolved the boundary (its own process
// on erlang, so a per-process stylesheet sees what the boundary registered);
// its calls are read off the fills it styled, in completion order.
test "plugin: head once, chunk per boundary in completion order, close once, payload last" {
    val site = app([recording()], []);
    val afterAside = async.newGate();
    val out = await site.renderStream(
        inputOf("/blog", [], { -> StreamedPage(afterAside) }),
        req(),
        recorderOpening(afterAside),
    );
    assert outcomeText(out) == "ok";
    assert pluginEvents()
        .filter({ e -> e.startsWith("plugin chunk") == false })
        .join("|")
        == "plugin head|plugin close|plugin payload";
    val w = writes();
    assert (w.at(1) ?? "").contains("<style>.h2{}</style>");
    assert (w.at(2) ?? "").contains("<style>.h1{}</style>");
    assert allText().indexOf("plugin head")
        < allText().indexOf("write <!DOCTYPE");
    assert allText().indexOf("plugin close")
        > allText().indexOf("data-jh-f=\"h1\"");
}

test "plugin: head lands in <head>, each chunk first inside its fill, the payload key verbatim" {
    val site = app([recording()], []);
    val afterAside = async.newGate();
    val out = await site.renderStream(
        inputOf("/blog", [], { -> StreamedPage(afterAside) }),
        req(),
        recorderOpening(afterAside),
    );
    val w = writes();
    assert (w.at(0) ?? "").contains("<style>.head{}</style></head>");
    assert (w.at(1) ?? "").startsWith(
        "write <template data-jh-f=\"h2\"><style>.h2{}</style><span>aside</span>",
    );
    assert (w.at(2) ?? "").startsWith(
        "write <template data-jh-f=\"h1\"><style>.h1{}</style><ul",
    );
    assert (w.at(3) ?? "").contains("\"x\":[1]}");
}

test "plugin: a render with no plugin writes no <style> and no plugin key" {
    val site = app([], []);
    val afterAside = async.newGate();
    val out = await site.renderStream(
        inputOf("/blog", [], { -> StreamedPage(afterAside) }),
        req(),
        recorderOpening(afterAside),
    );
    assert allText().contains("<style>") == false;
    assert allText().contains("\"x\"") == false;
    val quietSite = app([quiet("q")], []);
    val quietAside = async.newGate();
    val q = await quietSite.renderStream(
        inputOf("/blog", [], { -> StreamedPage(quietAside) }),
        req(),
        recorderOpening(quietAside),
    );
    assert allText().contains("<style>") == false;
}

test "plugin: a close answering Error fails the render with that message" {
    val failing = RenderPlugin(
        name: "sheet",
        head: { -> quietHead() },
        chunk: { id -> quietChunk(id) },
        close: { -> plCloseFails() },
        payload: { -> plNoPayload() },
    );
    val site = app([failing], []);
    val afterAside = async.newGate();
    val out = await site.renderStream(
        inputOf("/blog", [], { -> StreamedPage(afterAside) }),
        req(),
        recorderOpening(afterAside),
    );
    assert outcomeText(out).contains(
        "plugin `sheet` failed to close: a class was registered after the last chunk",
    );
    assert countOf("close") == 1;
}

test "plugin: a render key, or one key from two plugins, fails the render naming them" {
    val bad = RenderPlugin(
        name: "bad",
        head: { -> quietHead() },
        chunk: { id -> quietChunk(id) },
        close: { -> plClose() },
        payload: { -> plRenderKey() },
    );
    val site = app([bad], []);
    val afterAside = async.newGate();
    val out = await site.renderStream(
        inputOf("/blog", [], { -> StreamedPage(afterAside) }),
        req(),
        recorderOpening(afterAside),
    );
    assert outcomeText(out).contains("plugin `bad` gave the payload key `t`");
    assert extrasProblem([#("a", "s", "[]"), #("b", "s", "[]")]).contains(
        "plugins `a` and `b` both gave the payload key `s`",
    );
    assert extrasProblem([#("a", "s", "[]")]) == "";
}

// ── the document's language — `app(lang: …)` ────────────────────────────────

test "stream: app(lang:) is the document's <html lang>, \"en\" when not given" {
    val plain = await app([], []).render(
        inputOf("/blog", [], { -> BlogPage() }),
        req(),
        recorder(),
    );
    assert (writes().at(0) ?? "").startsWith(
        "write <!DOCTYPE html><html lang=\"en\">",
    );
    val site = app([], [], "pt-BR");
    val streamed = await site.renderStream(
        inputOf("/blog", [], { -> BlogPage() }),
        req(),
        recorder(),
    );
    assert (writes().at(0) ?? "").startsWith(
        "write <!DOCTYPE html><html lang=\"pt-BR\"><head>",
    );
}

fn badLang() -> App {
    return app([], [], "en\"><script>");
}

test "stream: a lang that is not a language tag is refused by app, naming it" {
    val out = attemptRender({ -> badLang() });
    val message = case out {
        Ok(a) -> "";
        Error(m) -> m;
    };
    assert message.contains(
        "app(lang: \"en\"><script>\") is not a language tag",
    );
    assert isLangTag("zh-Hant-TW");
    assert isLangTag("") == false;
    assert isLangTag("1en") == false;
}

// ── contract 5d — the render over rakun's `ChunkWriter` ─────────────────────
//
// rakun front 23's `ChunkWriter`, spelled here field for field — jhonstart
// names no rakun type — and adapted into `Response` exactly as onze front 49
// does (`contracts.md § 5d`). The three literals are the byte sequences rakun
// front 23 asserts on the socket with a stub renderer: a page, a
// pre-first-chunk `redirect("/login")` and a pre-first-chunk `notFound()`.

type ChunkSink(
    setStatus: fn(code: i32),
    setHeader: fn(name: string, value: string),
    write: fn(chunk: string) -> @Task<void>,
    close: fn() -> @Task<void>,
)

fn recordingSink() -> ChunkSink {
    recReset();
    return ChunkSink(
        setStatus: { code -> recStatus(code) },
        setHeader: { name, value -> recHeader(name, value) },
        write: { chunk -> recWrite(chunk) },
        close: { -> recClose() },
    );
}

fn overSink(out: ChunkSink) -> Response {
    val setStatus = out.setStatus;
    val setHeader = out.setHeader;
    val write = out.write;
    val close = out.close;
    return Response(
        status: { c -> setStatus(c) },
        header: { n, v -> setHeader(n, v) },
        write: { chunk -> write(chunk) },
        close: { -> close() },
    );
}

test "chunk writer: a page is 200, text/html, one document, one close" {
    val site = app([], []);
    val out = await site.render(
        inputOf("/blog", [], { -> BlogPage() }),
        req(),
        overSink(recordingSink()),
    );
    assert outcomeText(out) == "ok";
    val events = recEvents();
    assert events.length == 4;
    assert events.at(0) ?? "" == "status 200";
    assert events.at(1) ?? "" == "header content-type text/html; charset=utf-8";
    assert (events.at(2) ?? "").startsWith(
        "write <!DOCTYPE html><html lang=\"en\"><head><meta charset=\"utf-8\"></head><body><div data-jh-root=\"\">",
    );
    assert (events.at(2) ?? "").endsWith("</body></html>");
    assert events.at(3) ?? "" == "close";
}

test "chunk writer: redirect(\"/login\") before the first chunk is 307, location, no body" {
    val site = app([], []);
    val out = await site.renderStream(
        inputOf("/blog", [], { -> LoginRedirectPage() }),
        req(),
        overSink(recordingSink()),
    );
    assert outcomeText(out) == "ok";
    assert allText() == "status 307\nheader location /login\nclose";
}

test "chunk writer: notFound() before the first chunk is 404 and the not-found document" {
    val site = app([], []);
    val seg = withNotFound(segment("/blog/[slug]"), { -> NotFoundView() });
    val out = await site.render(
        inputOf("/blog/[slug]", [seg], { -> MissingPage() }),
        req(),
        overSink(recordingSink()),
    );
    assert outcomeText(out) == "ok";
    val events = recEvents();
    assert events.at(0) ?? "" == "status 404";
    assert events.at(1) ?? "" == "header content-type text/html; charset=utf-8";
    assert (events.at(2) ?? "").contains("<h2>No such post</h2>");
    assert events.at(events.length - 1) ?? "" == "close";
    assert countOf("close") == 1;
}

// ── the DYNAMIC mark: the query and the request are read through a marking
// hook, and `PageContext` carries no `query` field to read around it ────────

fn SortedPage() -> @Component<Element> {
    val q = use searchParams();
    return p([text("rows " + q.length.toString(), attrs: [])], attrs: []);
}

fn CookiePage() -> @Component<Element> {
    val r = use request();
    return p([text("hi " + r.cookie("session"), attrs: [])], attrs: []);
}

fn sortedChild() -> @Component<Element> {
    val q = use searchParams();
    return span([text("sorted " + q.length.toString(), attrs: [])], attrs: []);
}

fn StreamedSortedPage() -> @Component<Element> {
    return section(
        [
            Suspense(
                Boundary(
                    id: holeId(1),
                    fallback: div([], attrs: []),
                    child: { -> sortedChild() },
                ),
            ),
        ],
        attrs: [],
    );
}

fn lastWrite() -> string {
    val w = writes();
    return w.at(w.length - 1) ?? "";
}

test "dynamic: a page that reads neither the query nor the request is static" {
    val site = app([], []);
    val out = await site.renderStream(
        inputOf("/blog/[slug]", [], { -> BlogPage() }),
        req(),
        recorder(),
    );
    assert outcomeText(out) == "ok";
    assert lastWrite().contains("\"d\":false");
}

test "dynamic: reading the query through searchParams() marks the render" {
    val site = app([], []);
    val out = await site.renderStream(
        inputOf("/blog", [], { -> SortedPage() }),
        req(),
        recorder(),
    );
    assert outcomeText(out) == "ok";
    assert lastWrite().contains("\"d\":true");
}

test "dynamic: reading the request marks the render" {
    val site = app([], []);
    val out = await site.renderStream(
        inputOf("/blog", [], { -> CookiePage() }),
        req(),
        recorder(),
    );
    assert outcomeText(out) == "ok";
    assert allText().contains("hi s1");
    assert lastWrite().contains("\"d\":true");
}

test "dynamic: a boundary's read marks the page, from the boundary's own process" {
    val site = app([], []);
    val out = await site.renderStream(
        inputOf("/blog", [], { -> StreamedSortedPage() }),
        req(),
        recorder(),
    );
    assert outcomeText(out) == "ok";
    assert allText().contains("sorted 0");
    assert lastWrite().contains("\"d\":true");
}

test "dynamic: the mark does not leak into the next render" {
    val site = app([], []);
    val first = await site.renderStream(
        inputOf("/blog", [], { -> SortedPage() }),
        req(),
        recorder(),
    );
    val second = await site.renderStream(
        inputOf("/blog/[slug]", [], { -> BlogPage() }),
        req(),
        recorder(),
    );
    assert outcomeText(second) == "ok";
    assert lastWrite().contains("\"d\":false");
}
