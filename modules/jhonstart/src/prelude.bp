//// jhonstart/prelude — the names a `.bpp` file of a `"bpp": "jhonstart"`
//// application resolves without a header import (decision 270).
////
//// The prelude is the module's LAST scope, consulted only for a name the file
//// does not bind: an item becomes an import of the file only when one of its
//// names — a header expression or a tag `html` looks up — resolves through it.
//// It is an ordinary module of the package, compiled and tested with it, and
//// holds `import` items of the core's own modules and nothing else (an item of
//// another package, an activation or any other declaration is refused at its
//// line). `<html>` is the `htmlTag` builder: the default function's name is
//// not rebound. Adding a name breaks no application; removing one fails at
//// each use.
////
//// Decision 361: the toolchain finds this module by its marker — std's
//// `#[bpp.htmlPrelude]` on `prelude`, the one declaration it holds besides
//// its imports — not by the module's name.

import {element.Element, element.ElementBase, element.View, element.text, element.fragment};
import {element.div, element.span, element.p, element.h1, element.ul, element.li};
import {node.Node};
import {render.raw};
import {elements.el, elements.voidEl, elements.a, elements.nav, elements.section, elements.article, elements.header, elements.footer, elements.main, elements.aside};
import {elements.h2, elements.h3, elements.h4, elements.h5, elements.h6, elements.label, elements.timeTag as time, elements.form, elements.button, elements.select, elements.option, elements.textarea};
import {elements.table, elements.thead, elements.tbody, elements.tr, elements.th, elements.td, elements.htmlTag, elements.head, elements.body, elements.title, elements.script, elements.style};
import {elements.input, elements.img, elements.meta, elements.link, elements.br, elements.hr};
import {bpp} from "std";

#[bpp.htmlPrelude]
pub val prelude = bpp.Prelude();
