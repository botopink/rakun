//// jhonstart/html_attrs — the attribute array's shape and order.
////
//// A CSS library hands jhonstart an attribute PAIR (`#("class", "…")`) for a
//// builder's `attrs:`; this module owns what happens to it on this side: the
//// `class` pair's name spelled once (`classAttr`), the append that keeps the
//// base attributes first and the argument order as the rendered order
//// (`withAttrs` — `renderToString` writes attributes in array order, so order
//// is part of the markup a hydrator compares), and the read-back a test or a
//// hydrator uses to find a value without indexing (`attrValue`).
////
//// It imports `element` and nothing else, and names no styling library: the
//// dependency runs one way (1.0.10-beta decision 113). It never concatenates a
//// class name — merging a static class with a generated one is the styling
//// library's, in one function there.

import {element.Element, element.renderToString};

pub fn classAttr(value: string) -> #(string, string) {
    return #("class", value);
}

// Base first, then the extra pairs, each list in its own order.
pub fn withAttrs(
    base: Array<#(string, string)>,
    extra: Array<#(string, string)>,
) -> Array<#(string, string)> {
    return base.append(extra);
}

// The value of the LAST pair named `name`, or "" when none is — "" rather than
// an optional, the convention the request record uses.
pub fn attrValue(attrs: Array<#(string, string)>, name: string) -> string {
    return attrs.fold("", { acc, a -> pickValue(acc, a, name) });
}

fn pickValue(acc: string, a: #(string, string), name: string) -> string {
    val out = if (a._0 == name) a._1 else acc;
    return out;
}

test "classAttr — the class pair" {
    val p = classAttr("card e_1");
    assert p._0 == "class";
    assert p._1 == "card e_1";
}

test "withAttrs — base first, appended, order preserved" {
    val base: Array<#(string, string)> = [#("id", "x")];
    val extra: Array<#(string, string)> = [classAttr("e_1"), #("role", "note")];
    val all = withAttrs(base, extra);
    assert all.length == 3;
    assert attrValue(all, "id") == "x";
    assert attrValue(all, "class") == "e_1";
    val el = Element(tag: "div", value: "", children: [], attrs: all);
    assert renderToString(el)
        == "<div id=\"x\" class=\"e_1\" role=\"note\"></div>";
}

test "attrValue — a missing name is the empty string, the last duplicate wins" {
    val attrs: Array<#(string, string)> = [#("class", "a"), #("class", "b")];
    assert attrValue(attrs, "missing") == "";
    assert attrValue(attrs, "class") == "b";
}
