// document
//
// `htmlTag` carries the `<html>` tag because `html` is already a `pub fn` in
// this package — the `html """…"""` template fn — and two `pub fn html`
// reachable from `import {…} from "jhonstart"` is a collision. The DSL keeps
// the name.
//
// `script` and `style` are the two raw-text elements (`isRawTextTag`): their
// text content must reach the output unescaped.

pub fn htmlTag(
    children: Children,
    attrs: Array<#(string, string)> = [],
) -> Element {
    return el("html", children, attrs);
}

pub fn head(
    children: Children,
    attrs: Array<#(string, string)> = [],
) -> Element {
    return el("head", children, attrs);
}

pub fn body(
    children: Children,
    attrs: Array<#(string, string)> = [],
) -> Element {
    return el("body", children, attrs);
}

pub fn title(
    children: Children,
    attrs: Array<#(string, string)> = [],
) -> Element {
    return el("title", children, attrs);
}

pub fn script(
    children: Children,
    attrs: Array<#(string, string)> = [],
) -> Element {
    return el("script", children, attrs);
}

pub fn style(
    children: Children,
    attrs: Array<#(string, string)> = [],
) -> Element {
    return el("style", children, attrs);
}

// ── the void constructors ──
//
// A void element cannot have children, and with the frozen `Element` record
// that is expressed in the BODY, not in the signature: the uniform
// two-parameter shape is kept — a one-parameter `input(attrs:)` would be a
// second convention, would be unreachable from the `html """…"""` DSL's call
// shape, and would break the `input([], attrs: [...])` the consuming fronts
// already write — and the children argument is dropped. A test asserts the
// drop rather than leaving it to be discovered.

pub fn input(
    _children: Children,
    attrs: Array<#(string, string)> = [],
) -> Element {
    return voidEl("input", attrs);
}

pub fn img(
    _children: Children,
    attrs: Array<#(string, string)> = [],
) -> Element {
    return voidEl("img", attrs);
}

pub fn meta(
    _children: Children,
    attrs: Array<#(string, string)> = [],
) -> Element {
    return voidEl("meta", attrs);
}

pub fn link(
    _children: Children,
    attrs: Array<#(string, string)> = [],
) -> Element {
    return voidEl("link", attrs);
}

pub fn br(
    _children: Children,
    attrs: Array<#(string, string)> = [],
) -> Element {
    return voidEl("br", attrs);
}

pub fn hr(
    _children: Children,
    attrs: Array<#(string, string)> = [],
) -> Element {
    return voidEl("hr", attrs);
}

test "el builds a tag the named surface does not carry" {
    assert renderToString(el("figure", [text("x", attrs: [])], attrs: []))
        == "<figure>x</figure>";
}

test "voidEl stores no children" {
    val w = voidEl("wbr", []);
    assert w.tag == "wbr";
    assert w.children.length == 0;
    assert renderToString(w) == "<wbr></wbr>";
}

test "isVoidTag answers the HTML spec's list and nothing else" {
    assert isVoidTag("area");
    assert isVoidTag("base");
    assert isVoidTag("br");
    assert isVoidTag("col");
    assert isVoidTag("embed");
    assert isVoidTag("hr");
    assert isVoidTag("img");
    assert isVoidTag("input");
    assert isVoidTag("link");
    assert isVoidTag("meta");
    assert isVoidTag("param");
    assert isVoidTag("source");
    assert isVoidTag("track");
    assert isVoidTag("wbr");
    assert isVoidTag("div") == false;
    assert isVoidTag("span") == false;
    assert isVoidTag("form") == false;
    assert isVoidTag("") == false;
}

test "isRawTextTag is script and style — escapable raw text is not raw text" {
    assert isRawTextTag("script");
    assert isRawTextTag("style");
    assert isRawTextTag("title") == false;
    assert isRawTextTag("textarea") == false;
    assert isRawTextTag("div") == false;
}

test "a constructor renders its tag, nested" {
    val out = renderToString(
        section([h2([text("Posts", attrs: [])], attrs: [])], attrs: []),
    );
    assert out == "<section><h2>Posts</h2></section>";
}

test "a renamed constructor still renders the HTML tag" {
    assert htmlTag([], attrs: []).tag == "html";
    assert timeTag([text("now", attrs: [])], attrs: []).tag == "time";
    assert renderToString(timeTag([text("now", attrs: [])], attrs: []))
        == "<time>now</time>";
}

test "attribute order is the array order" {
    val out = renderToString(
        a([text("x", attrs: [])], attrs: [#("href", "/p"), #("rel", "next")]),
    );
    assert out == "<a href=\"/p\" rel=\"next\">x</a>";
}

test "an attribute value is stored verbatim — escaping belongs to the renderer" {
    val out = renderToString(
        a([text("x", attrs: [])], attrs: [#("href", "/a&b")]),
    );
    assert out == "<a href=\"/a&b\">x</a>";
}

test "the form surface builds the shape front 24 binds an action to" {
    val f = form(
        [
            label([text("Title", attrs: [])], attrs: [#("for", "title")]),
            select(
                [option([text("a", attrs: [])], attrs: [#("value", "a")])],
                attrs: [#("name", "kind")],
            ),
            textarea([], attrs: [#("name", "body")]),
            button([text("Save", attrs: [])], attrs: [#("type", "submit")]),
        ],
        attrs: [#("data-jh-a", "createPost")],
    );
    assert renderToString(f)
        == "<form data-jh-a=\"createPost\"><label for=\"title\">Title</label><select name=\"kind\"><option value=\"a\">a</option></select><textarea name=\"body\"></textarea><button type=\"submit\">Save</button></form>";
}

test "the document shell and the table surface build" {
    val doc = htmlTag(
        [
            head([title([text("Home", attrs: [])], attrs: [])], attrs: []),
            body(
                [
                    table(
                        [
                            thead(
                                [
                                    tr(
                                        [th([text("h", attrs: [])], attrs: [])],
                                        attrs: [],
                                    ),
                                ],
                                attrs: [],
                            ),
                            tbody(
                                [
                                    tr(
                                        [td([text("c", attrs: [])], attrs: [])],
                                        attrs: [],
                                    ),
                                ],
                                attrs: [],
                            ),
                        ],
                        attrs: [],
                    ),
                ],
                attrs: [],
            ),
        ],
        attrs: [#("lang", "en")],
    );
    assert renderToString(doc)
        == "<html lang=\"en\"><head><title>Home</title></head><body><table><thead><tr><th>h</th></tr></thead><tbody><tr><td>c</td></tr></tbody></table></body></html>";
}

test "the sectioning tags carry their own names" {
    assert nav([], attrs: []).tag == "nav";
    assert article([], attrs: []).tag == "article";
    assert header([], attrs: []).tag == "header";
    assert footer([], attrs: []).tag == "footer";
    assert main([], attrs: []).tag == "main";
    assert aside([], attrs: []).tag == "aside";
    assert h3([], attrs: []).tag == "h3";
    assert h4([], attrs: []).tag == "h4";
    assert h5([], attrs: []).tag == "h5";
    assert h6([], attrs: []).tag == "h6";
    assert script([], attrs: []).tag == "script";
    assert style([], attrs: []).tag == "style";
}

test "a void constructor type-checks with a bare empty children list" {
    val i = input([], attrs: [#("name", "title")]);
    assert i.tag == "input";
    assert renderToString(i) == "<input name=\"title\"></input>";
}

test "a void element handed children drops them" {
    val i = input([text("x", attrs: [])], attrs: []);
    assert i.children.length == 0;
    assert renderToString(i) == "<input></input>";
}

test "every void constructor's tag is in the void set" {
    assert isVoidTag(input([], attrs: []).tag);
    assert isVoidTag(img([], attrs: []).tag);
    assert isVoidTag(meta([], attrs: []).tag);
    assert isVoidTag(link([], attrs: []).tag);
    assert isVoidTag(br([], attrs: []).tag);
    assert isVoidTag(hr([], attrs: []).tag);
}

test "renderToString closes a void element — the frozen renderer's wrong answer" {
    assert renderToString(meta([], attrs: [#("charset", "utf-8")]))
        == "<meta charset=\"utf-8\"></meta>";
    assert renderToString(br([], attrs: [])) == "<br></br>";
    assert renderToString(link([], attrs: [#("rel", "icon")]))
        == "<link rel=\"icon\"></link>";
}
