//// rakun-ssr — the rakun half of the boot (front 49 step 4, decisions
//// 113–117; the member split is decision pending 49-e).
////
//// The core's `integration.bp` builds rakun-bpp's app (the emilia bridge,
//// the redirect allow-list, the wire names, the bundle tags) and the
//// `rakun.*` entries on both rows; this module hands them to rakun, which
//// is erlang-only (decision 117):
////
////   rakun.*        every entry of `rakunEntries` into rakun's property table
////   pages          rakun-bpp's UI table copied into rakun's: every record
////                  but a page stored as written, every page through rakun's
////                  `page(pattern, render)` — one opaque `PageRenderer` each
////   the renderer   `RequestData` from rakun's `Request`, the segment chain
////                  over the ancestor patterns rakun's layout chain names plus
////                  the page's own, and rakun-bpp's `Response` over rakun's
////                  `ChunkWriter`, `status` / `header` / `write` / `close`
////                  onto `setStatus` / `setHeader` / `write` / `close`
////   static roots   rakun-ssr' roots through rakun-service front 82's
////                  `registerStaticRoot` (the fingerprinted one; the public
////                  one waits on 69-b)
////   the listener   `Rakun.run(App(port, basePath))`, basePath unchanged
////
//// Navigation signals never reach this module: rakun-bpp's render answers
//// them through the `Response` (decision 117). Nothing here imports
//// `routing`, spells an action wire name or calls emilia.

import {io.fs, path, encoding} from "std";
import {Rakun, App, Request, HttpMethod, rkSetProp, rkProp, cookieNames, cookieLookup} from "rakun";
import {ChunkWriter, PageRenderer, page as rakunPage, writeTo, setStatusOn, setHeaderOn, closeOut, servePages, matchPage, PageMatch, appLayoutChain, rkAppStoreEntry} from "rakun-app";
import {StaticRoot, registerStaticRoot, installStatic, bootWeb} from "rakun-service";
import {Response, RequestData, PageContext, PageInput, Element, ElementBase, uiTable, pageFor} from "rakun-bpp";
import {OnzeConfig, SiteRender, bootSite, siteRender, rakunEntries, responseOver, pageInput} from "rakun-ssr";
import {ClientBundleManifest, parseManifest} from "rakun-ssr";
import {AssetRoot, staticRoots, pageRenderHooks} from "rakun-ssr";

// ── the request ─────────────────────────────────────────────────────────────

pub fn methodName(m: HttpMethod) -> string {
    return case m {
        HttpMethod.Get -> "GET";
        HttpMethod.Post -> "POST";
        HttpMethod.Put -> "PUT";
        HttpMethod.Patch -> "PATCH";
        HttpMethod.Delete -> "DELETE";
        HttpMethod.Head -> "HEAD";
        HttpMethod.Options -> "OPTIONS";
    };
}

// rakun's parameter wire (`name\tvalue` lines, `matchPage`'s) as pairs.
pub fn paramPairs(wire: string) -> Array<#(string, string)> {
    var out: Array<#(string, string)> = [];
    for (wire.split("\n")) { line ->
        val tab = line.indexOf("\t");
        if (tab > 0) out.push(#(line.slice(0, tab), line.slice(tab + 1)));
    }
    return out;
}

// The cookies a `cookie` header carries, parsed by rakun's own reader.
pub fn cookiePairs(header: string) -> Array<#(string, string)> {
    return cookieNames(header).map({ n -> #(n, cookieLookup(header, n)) });
}

// rakun-bpp's `RequestData` from rakun's `Request`. rakun's page `Request`
// exposes its path parameters (through `matchPage`) and one header by name;
// it enumerates neither its query nor its headers, so `query` and `headers`
// are empty and `cookies` are read from the `cookie` header (status row
// 49-rakun-request).
pub fn requestData(req: Request) -> RequestData {
    val found: PageMatch = matchPage(req.path);
    return RequestData(
        method: methodName(req.method),
        path: req.path,
        params: paramPairs(found.params),
        query: [],
        headers: [],
        cookies: cookiePairs(req.header("cookie")),
    );
}

// ── the response ────────────────────────────────────────────────────────────

fn statusOn(out: ChunkWriter, code: i32) -> void {
    val _s = setStatusOn(out, code);
}

fn headerOn(out: ChunkWriter, name: string, value: string) -> void {
    val _h = setHeaderOn(out, name, value);
}

// rakun-bpp's `Response` over rakun's `ChunkWriter`, one door to one door.
pub fn responseFor(out: ChunkWriter) -> Response {
    return responseOver({ code -> statusOn(out, code) }, { name, value -> headerOn(out, name, value) }, { chunk -> writeTo(out, chunk) }, { -> closeOut(out) });
}

// ── the pages ───────────────────────────────────────────────────────────────

// The patterns whose segments wrap `pattern`, root first: the layouts rakun's
// chain names, then the page's own segment (its boundaries) when no layout
// sits there.
pub fn chainPatterns(pattern: string) -> string[] {
    val layouts: string[] = appLayoutChain(pattern).map({ e -> e.pattern });
    if (layouts.contains(pattern)) return layouts;
    return layouts.append([pattern]);
}

fn missingPage(route: PageContext) -> @Component<Element> {
    @panic("rakun-ssr: no rakun-bpp page is registered at `"
        + route.pattern
        + "`");
}

fn renderPage(render: SiteRender, build: string, table: string, pattern: string, req: Request, out: ChunkWriter) -> @Task<@Result<void, string>> {
    val data = requestData(req);
    val route = PageContext(pathname: req.path, pattern: pattern, params: data.params, rest: []);
    val view = pageFor(pattern, { r -> missingPage(r) });
    val input = pageInput(build, req.path, pattern, encoding.formStringify(data.params), "", table, [], chainPatterns(pattern), { -> view(route) }, [], []);
    val outcome = await render(input, data, responseFor(out));
    return outcome;
}

// The renderer rakun holds for `pattern`: opaque to rakun, rakun-bpp's render
// inside.
pub fn rendererFor(render: SiteRender, build: string, table: string, pattern: string) -> PageRenderer {
    return { req, out -> renderPage(render, build, table, pattern, req, out) };
}

// rakun-bpp's UI records, as `#(kind, pattern, line)` — the kind and the
// pattern are the first two fields of a contract-1 line.
pub fn uiRecords(table: string) -> Array<#(string, string, string)> {
    var out: Array<#(string, string, string)> = [];
    for (table.split("\n")) { line ->
        val fields = line.split("|");
        if (fields.length >= 2)
            out.push(#(fields.at(0) ?? "", fields.at(1) ?? "", line));
    }
    return out;
}

// Copies rakun-bpp's UI table into rakun's and registers one renderer per
// page; answers the number of pages.
pub fn registerPages(render: SiteRender, build: string) -> i32 {
    val table = uiTable();
    var pages = 0;
    for (uiRecords(table)) { r ->
        if (r._0 == "P") {
            val _p = rakunPage(r._1, rendererFor(render, build, table, r._1));
            pages = pages + 1;
        } else val _e = rkAppStoreEntry(r._2);
    }
    return pages;
}

// ── configuration and static roots ──────────────────────────────────────────

// Writes each `rakun.*` entry into rakun's property table.
pub fn applyEntries(entries: Array<#(string, string)>) -> i32 {
    for (entries) { e ->
        val _s = rkSetProp(e._0, e._1);
    }
    return entries.length;
}

// rakun-ssr' record as rakun-service front 82's, field for field; a root
// serves no directory index, validates no `Last-Modified` and has no
// precompressed variants.
pub fn staticRootOf(r: AssetRoot) -> StaticRoot {
    return StaticRoot(pattern: r.pattern, directory: r.directory, indexFile: "", cacheSeconds: r.cacheSeconds, immutable: r.immutable, useLastModified: false, precompressed: false);
}

// The roots the boot registers today: the fingerprinted one. The public root
// (`/**`) would answer every GET a page answers — front 82 stops the chain on
// a matching pattern and a miss is 404 — so it waits on 69-b.
pub fn servedRoots(config: OnzeConfig, buildId: string) -> Array<StaticRoot> {
    return staticRoots(config.publicDir, config.outDir, buildId)
        .filter({ r -> r.immutable })
        .map({ r -> staticRootOf(r) });
}

pub fn registerRoots(roots: Array<StaticRoot>) -> i32 {
    var n = 0;
    for (roots) { r ->
        n = registerStaticRoot(r);
    }
    return n;
}

// ── the boot ────────────────────────────────────────────────────────────────

// What a build left in `outDir`: its id and its manifest.
pub type BuildOutput(buildId: string, manifest: ClientBundleManifest)

pub fn readBuild(outDir: string) -> @Result<BuildOutput, string> {
    val idFile = path.join([outDir, "build-id"]);
    val manifestFile = path.join([outDir, "client-manifest.txt"]);
    if (fs.exists(idFile) == false)
        throw "rakun-ssr: "
            + idFile
            + " does not exist - run `rakun-ssr build` first";
    if (fs.exists(manifestFile) == false)
        throw "rakun-ssr: "
            + manifestFile
            + " does not exist - run `rakun-ssr build` first";
    val id = try fs.readText(idFile);
    val text = try fs.readText(manifestFile);
    val m = try parseManifest(text);
    return BuildOutput(buildId: id.trim(), manifest: m);
}

// rakun's `rakun.i18n.exclude`, as the application configured it.
fn configuredExclude() -> string[] {
    val raw = rkProp("rakun.i18n.exclude");
    return raw.split(",").map({ e -> e.trim() }).filter({ e -> e != "" });
}

// Everything but the listener: the entries, the app, the pages, the roots
// (rakun-service's static entry in its chain, and the chain handed to the
// listener by `bootWeb`), the page path. Answers the number of pages
// registered.
pub fn bootServer(config: OnzeConfig, build: BuildOutput) -> i32 {
    val _e = applyEntries(rakunEntries(config, configuredExclude()));
    val site = bootSite(config, pageRenderHooks(build.manifest));
    val pages = registerPages(siteRender(site), build.buildId);
    val _r = registerRoots(servedRoots(config, build.buildId));
    val _s = installStatic();
    val _w = bootWeb();
    val _p = servePages();
    return pages;
}

// rakun's `App` for the project: the port, and `basePath` exactly as
// configured — prefixing is rakun's, rakun-ssr does not reimplement it.
pub fn rakunApp(config: OnzeConfig) -> App {
    return App(port: config.port, basePath: config.basePath);
}

pub type Onze() {
    // Boots the project `rakun-ssr build` wrote into `config.outDir` and listens on
    // `config.port`. A missing build is a failure naming the file.
    pub fn run(config: OnzeConfig) {
        val build = case readBuild(config.outDir) {
            Ok(b) -> b;
            Error(e) -> BuildOutput(buildId: "", manifest: failManifest(e));
        };
        val _b = bootServer(config, build);
        Rakun.run(rakunApp(config));
    }
}

fn failManifest(e: string) -> ClientBundleManifest {
    @panic(e);
}
