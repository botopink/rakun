//// rakun-websocket — `#[wsEndpoint(path)]`. Front 20 step 2.
////
//// On a stereotyped record type, it reads the type's `onOpen` / `onMessage` /
//// `onClose` and compiles ONE registration (`compiler.compile`, run before
//// `main`; its names resolve here):
////
////     rkRegisterWsEndpoint("/ws/chat", "ChatEndpoint",
////         { id, principal, at -> ChatEndpoint.make().onOpen(WsSession(id: id, principal: principal, path: at)) },
////         { id, principal, at, message -> ChatEndpoint.make().onMessage(WsSession(…), message) },
////         { id, principal, at, code, reason -> 0 });
////
//// `onMessage(self, session: WsSession, message: string) -> i32` is required;
//// a missing `onOpen` / `onClose` is registered as a no-op. Every connection is
//// served by the one instance `<Type>.make()` keeps. Decorator bodies are
//// comment-free and call no function.

import {compiler, compiler.DeclKind} from "std";
import {ws.WsSession, ws.rkRegisterWsEndpoint};

pub fn wsEndpoint(syntax decl: unknown, comptime path: string) {
    var stereotype = "";
    compiler.annotations(decl).forEach({ a ->
        val isStereo = a.name == "component"
            || a.name == "service"
            || a.name == "controller"
            || a.name == "restController";
        val st = if (isStereo) a.name else stereotype;
        stereotype = st;
    });
    var hasOpen = false;
    var hasMessage = false;
    var hasClose = false;
    compiler.methods(decl).forEach({ m ->
        if (m.name == "onOpen") hasOpen = true;
        if (m.name == "onMessage") hasMessage = true;
        if (m.name == "onClose") hasClose = true;
    });
    if (compiler.kind(decl) != DeclKind.Type || compiler.variants(decl).length > 0)
        compiler.fail(
            "#[wsEndpoint] must annotate a record-shaped type holding onOpen / onMessage / onClose",
            at: decl,
        );
    if (stereotype == "")
        compiler.fail(
            "#[wsEndpoint] needs a stereotype on the same type (#[service] or #[component]) - every connection is served by the one instance "
                + compiler.name(decl)!
                + ".make() keeps",
            at: decl,
        );
    if (hasMessage == false)
        compiler.fail(
            "#[wsEndpoint] "
                + compiler.name(decl)!
                + " has no onMessage(self: Self, session: WsSession, message: string) -> i32 - an endpoint that cannot receive is not an endpoint",
            at: decl,
        );
    if (path.startsWith("/") == false)
        compiler.fail("#[wsEndpoint] path `" + path + "` must start with /", at: decl);
    val declName = compiler.name(decl)!;
    if (hasOpen && hasClose)
        compiler.init({ ->
            rkRegisterWsEndpoint(
                path,
                declName,
                { id, principal, at -> decl.make().onOpen(WsSession(id: id, principal: principal, path: at)) },
                { id, principal, at, message -> decl.make().onMessage(WsSession(id: id, principal: principal, path: at), message) },
                { id, principal, at, code, reason -> decl.make().onClose(WsSession(id: id, principal: principal, path: at), code, reason) },
            );
        })
    else if (hasOpen)
        compiler.init({ ->
            rkRegisterWsEndpoint(
                path,
                declName,
                { id, principal, at -> decl.make().onOpen(WsSession(id: id, principal: principal, path: at)) },
                { id, principal, at, message -> decl.make().onMessage(WsSession(id: id, principal: principal, path: at), message) },
                { id, principal, at, code, reason -> 0 },
            );
        })
    else if (hasClose)
        compiler.init({ ->
            rkRegisterWsEndpoint(
                path,
                declName,
                { id, principal, at -> 0 },
                { id, principal, at, message -> decl.make().onMessage(WsSession(id: id, principal: principal, path: at), message) },
                { id, principal, at, code, reason -> decl.make().onClose(WsSession(id: id, principal: principal, path: at), code, reason) },
            );
        })
    else
        compiler.init({ ->
            rkRegisterWsEndpoint(
                path,
                declName,
                { id, principal, at -> 0 },
                { id, principal, at, message -> decl.make().onMessage(WsSession(id: id, principal: principal, path: at), message) },
                { id, principal, at, code, reason -> 0 },
            );
        });
}
