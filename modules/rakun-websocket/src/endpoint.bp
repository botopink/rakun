//// rakun-websocket — `#[wsEndpoint(path)]`. Front 20 step 2.
////
//// On a stereotyped record type, it reads the type's `onOpen` / `onMessage` /
//// `onClose` and emits ONE registration into the type's module (which imports
//// `rkRegisterWsEndpoint` and `WsSession`):
////
////     val __rkWs_ChatEndpoint = rkRegisterWsEndpoint("/ws/chat", "ChatEndpoint",
////         { id, principal, path -> ChatEndpoint.make().onOpen(WsSession(id: id, principal: principal, path: path)) },
////         { id, principal, path, message -> ChatEndpoint.make().onMessage(WsSession(…), message) },
////         { id, principal, path, code, reason -> 0 });
////
//// `onMessage(self, session: WsSession, message: string) -> i32` is required;
//// a missing `onOpen` / `onClose` is emitted as a no-op. Every connection is
//// served by the one instance `<Type>.make()` keeps. Decorator bodies are
//// comment-free and call no function.

pub fn wsEndpoint(comptime decl: @Decl, comptime path: string) {
    var stereotype = "";
    decl.annotations.forEach({ a ->
        val isStereo = a.name == "component"
            || a.name == "service"
            || a.name == "controller"
            || a.name == "restController";
        val st = if (isStereo) a.name else stereotype;
        stereotype = st;
    });
    var hasOpen = false;
    var hasMessage = false;
    var hasClose = false;
    decl.methods.forEach({ m ->
        if (m.name == "onOpen") hasOpen = true;
        if (m.name == "onMessage") hasMessage = true;
        if (m.name == "onClose") hasClose = true;
    });
    val make = decl.name + ".make()";
    val session = "WsSession(id: id, principal: principal, path: path)";
    val open = if (hasOpen)
        "{ id, principal, path -> " + make + ".onOpen(" + session + ") }"
    else
        "{ id, principal, path -> 0 }";
    val message = "{ id, principal, path, message -> "
        + make
        + ".onMessage("
        + session
        + ", message) }";
    val close = if (hasClose)
        "{ id, principal, path, code, reason -> "
            + make
            + ".onClose("
            + session
            + ", code, reason) }"
    else
        "{ id, principal, path, code, reason -> 0 }";
    if (decl.kind != DeclKind.Type || decl.variants.length > 0)
        decl.fail(
            "#[wsEndpoint] must annotate a record-shaped type holding onOpen / onMessage / onClose",
        );
    if (stereotype == "")
        decl.fail(
            "#[wsEndpoint] needs a stereotype on the same type (#[service] or #[component]) - every connection is served by the one instance "
                + decl.name
                + ".make() keeps",
        );
    if (hasMessage == false)
        decl.fail(
            "#[wsEndpoint] "
                + decl.name
                + " has no onMessage(self: Self, session: WsSession, message: string) -> i32 - an endpoint that cannot receive is not an endpoint",
        );
    if (path.startsWith("/") == false)
        decl.fail("#[wsEndpoint] path `" + path + "` must start with /");
    @emit(
        "val __rkWs_"
            + decl.name
            + " = rkRegisterWsEndpoint(\""
            + path
            + "\", \""
            + decl.name
            + "\", "
            + open
            + ", "
            + message
            + ", "
            + close
            + ");",
    );
}
