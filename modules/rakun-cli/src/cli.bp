//// rakun-cli — the command table and the eight commands (front 88).
////
//// A command is a row (`Command`: name, summary, usage) and dispatch is a
//// lookup; `rakun help` renders the same table, plugin rows included
//// (`#[cliCommand]`, `plugins.bp`). EXIT CODES are the contract CI reads:
//// 0 done · 1 the work failed · 2 usage (unknown command, missing argument,
//// bad flag) · 3 the project did not compile.
////
//// `new` copies `templates/<plain|library|full-stack>/` with `@@name@@` and
//// `@@rakun@@` substituted (`${…}` would be interpolation); `full-stack` needs
//// onze (its dev loop is `onze dev`). `build` and `test` are front ends:
//// `test` runs `botopink test --target erlang` (forwarding `--filter`) and
//// `build` runs `botopink build` then front 81's `buildTarball`; neither
//// reimplements its delegate. `routes`, `beans` and `config` INSPECT without
//// starting: the project is copied to `.rakun-cli/inspect-<n>/` with one
//// generated test that loads the application's modules (so its `@emit`
//// registrations run), prints the registries and returns — no listener, no
//// pool, no broker is ever started. `run` resolves the profile and port into
//// `RAKUN_PROFILES_ACTIVE` / `RAKUN_SERVER_PORT` and runs `botopink run`;
//// `--watch` needs front 80's rakun-devtools among the project's dependencies.
////
//// The botopink binary is `rakun.cli.botopink` / `RAKUN_CLI_BOTOPINK`, else
//// `botopink` on PATH; the templates `rakun.cli.templates` /
//// `RAKUN_CLI_TEMPLATES`, else `templates` under the working directory.
////
//// rakun is the SERVER CLI. A full-stack project (routes, server components,
//// a client bundle) uses front 50's `onze`, which drives rakun's run path;
//// rakun never starts a bundler or writes client output.

import {io.fs, io.process, io.env} from "std";
import {rkProp} from "rakun";
import {sanitizePatterns} from "rakun-actuator/management";
import {release.release.Release, release.release.VmArgs, release.release.buildTarball};
import {args.commandOf, args.hasFlag, args.flagValue, args.positionals, args.usageError, args.usagePrefix};
import {plugins.pluginNames, plugins.pluginSummary, plugins.runPlugin};

pub type Command(
    name: string,
    summary: string,
    usage: string,
)

#[@External.Erlang("""(fun(__L) -> io:format("~ts~n", [__L]), persistent_term:put(rakun_cli_out, persistent_term:get(rakun_cli_out, []) ++ [__L]), 0 end)($0)""")]
pub declare fn say(line: string) -> i32;

#[@External.Erlang("""persistent_term:get(rakun_cli_out, [])""")]
pub declare fn cliOutput() -> string[];

#[@External.Erlang("""(fun() -> persistent_term:erase(rakun_cli_out), persistent_term:erase(rakun_cli_invocations), 0 end)()""")]
pub declare fn clearCliOutput() -> i32;

#[@External.Erlang("""(fun(__L) -> persistent_term:put(rakun_cli_invocations, persistent_term:get(rakun_cli_invocations, []) ++ [__L]), 0 end)($0)""")]
declare fn noteInvocation(line: string) -> i32;

#[@External.Erlang("""persistent_term:get(rakun_cli_invocations, [])""")]
pub declare fn cliInvocations() -> string[];

#[@External.Erlang("""(fun(__F) -> try {ok, __F()} catch _:{panic, __R} when is_binary(__R) -> {error, __R}; _:__R -> {error, iolist_to_binary(io_lib:format("~p", [__R]))} end end)($0)""")]
declare fn guarded(run: fn() -> i32) -> @Result<i32, string>;

#[@External.Erlang("""(fun(__P) -> ok = filelib:ensure_dir(unicode:characters_to_list(__P)), 0 end)($0)""")]
declare fn ensureDir(file: string) -> i32;

#[@External.Erlang("""(fun(__N) -> case os:find_executable(unicode:characters_to_list(__N)) of false -> <<>>; __P -> unicode:characters_to_binary(__P) end end)($0)""")]
declare fn which(name: string) -> string;

#[@External.Erlang("""erlang:unique_integer([positive, monotonic])""")]
declare fn freshId() -> i32;

#[@External.Erlang("""lists:sort($0)""")]
declare fn sortStrings(xs: string[]) -> string[];

pub fn builtinCommands() -> Array<Command> {
    return [
        Command(
            name: "new",
            summary: "create a rakun project from a template",
            usage: "rakun new <name> [--template plain|full-stack|library] [--dir <parent>] [--rakun <path to modules/rakun>]",
        ),
        Command(
            name: "run",
            summary: "run the project (a front end for botopink run)",
            usage: "rakun run [--profile <name>] [--port <n>] [--watch] [--dir <project>]",
        ),
        Command(
            name: "build",
            summary: "build an OTP release (botopink build, then front 81's release builder)",
            usage: "rakun build [--dir <project>] [--out <dir>]",
        ),
        Command(
            name: "test",
            summary: "run the project's tests (a front end for botopink test)",
            usage: "rakun test [--target erlang|commonJS] [--filter <text>] [--dir <project>]",
        ),
        Command(
            name: "routes",
            summary: "list the registered routes without starting the server",
            usage: "rakun routes [--dir <project>]",
        ),
        Command(
            name: "beans",
            summary: "list the registered components without starting the server",
            usage: "rakun beans [--dir <project>]",
        ),
        Command(
            name: "config",
            summary: "print the resolved configuration and where each key came from",
            usage: "rakun config [--dir <project>] [--profile <name>]",
        ),
        Command(name: "help", summary: "print this table", usage: "rakun help"),
    ];
}

pub fn commandTable() -> Array<Command> {
    var out = builtinCommands();
    for (pluginNames()) { n ->
        out.push(
            Command(
                name: n,
                summary: pluginSummary(n),
                usage: "rakun " + n + " [args...]",
            ),
        );
    }
    return out;
}

pub fn helpLines() -> string[] {
    var out: string[] = ["usage: rakun <command> [options]", ""];
    for (commandTable()) { c ->
        out.push("  " + c.name + " - " + c.summary + "\n      " + c.usage);
    }
    out.push("");
    out.push(
        "A full-stack project (server plus a client bundle) uses onze - onze dev, onze build; rakun is the server CLI.",
    );
    return out;
}

fn printHelp() -> i32 {
    for (helpLines()) { l ->
        val _s = say(l);
    }
    return 0;
}

// ── helpers ─────────────────────────────────────────────────────────────────

fn setting(prop: string, envName: string, fallback: string) -> string {
    val p = rkProp(prop).trim();
    if (p != "") return p;
    val e: string = env.read(envName) ?? "";
    return if (e != "") e else fallback;
}

pub fn botopinkBin() -> string {
    return setting("rakun.cli.botopink", "RAKUN_CLI_BOTOPINK", "botopink");
}

fn projectDir(args: Array<string>) -> string {
    return flagValue(args, "--dir", process.cwd());
}

fn quoted(s: string) -> string {
    return "'" + s.replaceAll("'", "'\\''") + "'";
}

pub type Ran(status: i32, output: string)

// Runs `botopink <args>` in `dir` and records the invocation.
fn botopink(dir: string, argv: string[]) -> Ran {
    val line = botopinkBin() + " " + argv.join(" ");
    val _n = noteInvocation(line + " (in " + dir + ")");
    val shell = "cd "
        + quoted(dir)
        + " && exec "
        + quoted(botopinkBin())
        + " "
        + argv.map({ a -> quoted(a) }).join(" ")
        + " < /dev/null";
    val r = process.run("/bin/sh", ["-c", shell]);
    return case r {
        Ok(x) -> Ran(status: x.status, output: x.stdout);
        Error(e) -> Ran(status: 127, output: e);
    };
}

fn compileFailed(output: string) -> bool {
    return output.contains("failed to compile");
}

// ── new ─────────────────────────────────────────────────────────────────────

fn onzeAvailable() -> bool {
    val configured = setting("rakun.cli.onze", "RAKUN_CLI_ONZE", "");
    if (configured != "") return configured != "absent";
    return which("onze") != "";
}

fn templateRoot() -> string {
    return setting(
        "rakun.cli.templates",
        "RAKUN_CLI_TEMPLATES",
        process.cwd() + "/templates",
    );
}

pub fn substitute(text: string, vars: Array<#(string, string)>) -> string {
    var out = text;
    for (vars) { v ->
        out = out.replaceAll("@@" + v._0 + "@@", v._1);
    }
    return out;
}

fn runNew(args: Array<string>) -> i32 {
    val names = positionals(args, ["--template", "--dir", "--rakun"]);
    if (names.length != 1)
        return usageError(
            "new takes one project name - "
                + (builtinCommands().at(0) ?? Command(
                    name: "",
                    summary: "",
                    usage: "",
                )).usage,
        );
    val name = names.at(0) ?? "";
    val template = flagValue(args, "--template", "plain");
    if (["plain", "full-stack", "library"].indexOf(template) < 0)
        return usageError(
            "--template is `" + template + "` - plain, full-stack or library",
        );
    if (template == "full-stack" && onzeAvailable() == false)
        return usageError(
            "--template full-stack needs onze (front 50's CLI) on PATH - its dev loop is onze dev",
        );
    val target = flagValue(args, "--dir", process.cwd()) + "/" + name;
    val existing: string[] = fs.list(target).unwrapOr([]);
    if (fs.exists(target) && existing.length > 0)
        return usageError(
            target
                + " exists and is not empty - rakun new never merges into a project",
        );
    val rakunPath = flagValue(
        args,
        "--rakun",
        setting("rakun.cli.rakun", "RAKUN_CLI_RAKUN", ""),
    );
    val source = templateRoot() + "/" + template;
    val files: string[] = fs.walk(source).unwrapOr([]);
    if (files.length == 0) @panic("rakun-cli: no template at " + source);
    val vars = [#("name", name), #("rakun", rakunPath)];
    for (files) { f ->
        val text = fs.readText(source + "/" + f).unwrapOr("");
        val _d = ensureDir(target + "/" + f);
        val _w = fs.writeText(target + "/" + f, substitute(text, vars));
    }
    val _s = say(
        "created "
            + target
            + " ("
            + template
            + ", "
            + files.length.toString()
            + " files)",
    );
    if (template == "full-stack") val _o = say("develop with: onze dev");
    return 0;
}

// ── test and build ──────────────────────────────────────────────────────────

fn runTest(args: Array<string>) -> i32 {
    val dir = projectDir(args);
    val target = flagValue(args, "--target", "erlang");
    val filter = flagValue(args, "--filter", "");
    var argv: string[] = ["test", "--target", target];
    if (filter != "") {
        argv.push("--filter");
        argv.push(filter);
    }
    val r = botopink(dir, argv);
    val _o = say(r.output);
    if (compileFailed(r.output)) return 3;
    return r.status;
}

fn manifestField(dir: string, field: string) -> string {
    val text = fs.readText(dir + "/botopink.json").unwrapOr("");
    val key = "\"" + field + "\"";
    val at = text.indexOf(key);
    if (at < 0) return "";
    val rest = text.slice(at + key.length(), text.length());
    val open = rest.indexOf("\"");
    if (open < 0) return "";
    val tail = rest.slice(open + 1, rest.length());
    val close = tail.indexOf("\"");
    return if (close < 0) "" else tail.slice(0, close);
}

fn runBuild(args: Array<string>) -> i32 {
    val dir = projectDir(args);
    val out = flagValue(args, "--out", dir + "/.rakun/release");
    val emitted = dir + "/.rakun/build";
    val r = botopink(dir, ["build", "--target", "erlang", "--out", emitted]);
    if (compileFailed(r.output)) {
        val _o = say(r.output);
        return 3;
    }
    if (r.status != 0) {
        val _p = say(r.output);
        return 1;
    }
    val name = manifestField(dir, "name");
    val version = manifestField(dir, "version");
    val rel = Release(
        name: name,
        version: if (version == "") "0.0.1" else version,
        erts: "",
        applications: ["kernel", "stdlib", name],
        vmArgs: VmArgs(
            nodeName: name,
            cookieEnv: "RELEASE_COOKIE",
            schedulers: 0,
            maxProcesses: 0,
            embedded: true,
        ),
        configProfile: "",
    );
    val tar = out + "/" + name + "-" + rel.version + ".tar";
    val built = guarded({ -> buildTarball(rel, [#(name, emitted)], [], tar) });
    if (built.isOk()) {
        val _s = say("built " + tar);
        return 0;
    }
    val _e = say(
        case built {
            Ok(v) -> "";
            Error(e) -> e;
        },
    );
    return 1;
}

// ── run ─────────────────────────────────────────────────────────────────────

fn devtoolsDeclared(dir: string) -> bool {
    return fs
        .readText(dir + "/botopink.json")
        .unwrapOr("")
        .contains("\"rakun-data\"");
}

// The environment `rakun run` hands the application: front 05 reads
// `RAKUN_*` above the files and below command-line arguments.
pub fn runEnvironment(args: Array<string>) -> Array<#(string, string)> {
    var out: Array<#(string, string)> = [];
    val profile = flagValue(args, "--profile", "");
    val port = flagValue(args, "--port", "");
    if (profile != "") out.push(#("RAKUN_PROFILES_ACTIVE", profile));
    if (port != "") out.push(#("RAKUN_SERVER_PORT", port));
    return out;
}

fn runRun(args: Array<string>) -> i32 {
    val dir = projectDir(args);
    if (hasFlag(args, "--watch") && devtoolsDeclared(dir) == false)
        return usageError(
            "--watch needs rakun-data (front 80's devtools) among the project's dependencies - it is the watcher that recompiles and hot-loads",
        );
    val envs = runEnvironment(args);
    val prefix = envs.map({ e -> e._0 + "=" + quoted(e._1) }).join(" ");
    val _n = noteInvocation(botopinkBin() + " run (in " + dir + ") " + prefix);
    val r = process.run(
        "/bin/sh",
        [
            "-c",
            "cd "
                + quoted(dir)
                + " && "
                + prefix
                + " exec "
                + quoted(botopinkBin())
                + " run",
        ],
    );
    return case r {
        Ok(x) -> if (compileFailed(x.stdout)) 3 else x.status;
        Error(e) -> 1;
    };
}

// ── routes, beans, config ───────────────────────────────────────────────────

fn entryFunction(dir: string) -> #(string, string) {
    val entry = manifestField(dir, "entry");
    val file = if (entry == "") "main.bp" else entry;
    val text = fs.readText(dir + "/src/" + file).unwrapOr("");
    val at = text.indexOf("pub fn ");
    if (at < 0) return #(file.replaceAll(".bp", ""), "");
    val rest = text.slice(at + 7, text.length());
    val paren = rest.indexOf("(");
    return #(
        file.replaceAll(".bp", ""),
        if (paren < 0) "" else rest.slice(0, paren).trim(),
    );
}

pub fn inspectMarker() -> string {
    return "@rakun-inspect@";
}

// The generated test: importing a function of the entry module loads the
// application's modules, so their registrations run; it prints and returns.
pub fn inspectSource(
    entryModule: string,
    entryFn: string,
    what: string,
    cliArgs: string[],
) -> string {
    // The entry is a module of the application's own package: imported by its
    // path inside the braces (decision 206 — `from` names a package).
    val imports = "import {rkRoutePaths, rkScannedNames, rkProp, rkConfigLoadFrom, cliEntries, readEnvEntries} from \"rakun\";\n"
        + "import {"
        + entryModule.replaceAll("/", ".")
        + "."
        + entryFn
        + "};\n";
    val cells = "#[@External.Erlang(\"\"\"(fun(__L) -> io:format(\"~ts~n\", [__L]), 0 end)($0)\"\"\")]\ndeclare fn out(line: string) -> i32;\n"
        + "#[@External.Erlang(\"\"\"[<<__K/binary, \"=\", __V/binary>> || {__K, __V} <- lists:sort(ets:tab2list(rakun_props))]\"\"\")]\ndeclare fn props() -> string[];\n";
    val argList = "["
        + cliArgs
            .map(
                { a -> "\"" + a.replaceAll("\\", "\\\\").replaceAll("\"", "\\\"") + "\"" },
            )
            .join(", ")
        + "]";
    val body = if (what == "routes")
        "    val _o = out(\""
            + inspectMarker()
            + "routes \" + rkRoutePaths());\n"
    else if (what == "beans")
        "    val _o = out(\""
            + inspectMarker()
            + "beans \" + rkScannedNames());\n"
    else
        "    val _l = rkConfigLoadFrom("
            + argList
            + ");\n    val cli = cliEntries("
            + argList
            + ").map({ e -> e.key });\n    val envs = readEnvEntries().map({ e -> e.key });\n    val _p = out(\""
            + inspectMarker()
            + "profiles \" + rkProp(\"rakun.profiles.active\"));\n    for (props()) { kv ->\n        val k = kv.slice(0, kv.indexOf(\"=\"));\n        val src = if (cli.indexOf(k) >= 0) \"command line\" else if (envs.indexOf(k) >= 0) \"environment\" else \"application file\";\n        val _k = out(\""
            + inspectMarker()
            + "config \" + kv + \"\\t\" + src);\n    };\n";
    return imports
        + "\n"
        + cells
        + "\ntest \"rakun inspect\" {\n"
        + body
        + "    assert true;\n}\n";
}

pub type Inspection(status: i32, lines: string[])

fn inspect(args: Array<string>, what: string) -> Inspection {
    val dir = projectDir(args);
    val scratch = dir + "/.rakun-cli/inspect-" + freshId().toString();
    val e = entryFunction(dir);
    if (e._1 == "")
        @panic(
            "rakun-cli: "
                + dir
                + "/src/"
                + e._0
                + ".bp declares no pub fn - rakun "
                + what
                + " loads the application through one",
        );
    val copy = process.runShell(
        "mkdir -p "
            + quoted(scratch)
            + " && cp -r "
            + quoted(dir + "/src")
            + " "
            + quoted(dir + "/botopink.json")
            + " "
            + quoted(scratch)
            + "/ && (cp "
            + quoted(dir)
            + "/application.* "
            + quoted(scratch)
            + "/ 2>/dev/null; true) && mkdir -p "
            + quoted(scratch + "/test"),
    );
    val profile = flagValue(args, "--profile", "");
    val cliArgs: string[] = if (profile == "")
        []
    else
        ["--rakun.profiles.active=" + profile];
    val _w = fs.writeText(
        scratch + "/test/rakun_inspect_test.bp",
        inspectSource(e._0, e._1, what, cliArgs),
    );
    val r = botopink(scratch, ["test", "--target", "erlang"]);
    val _c = process.runShell("rm -rf " + quoted(scratch));
    if (compileFailed(r.output)) {
        val _o = say(r.output);
        return Inspection(status: 3, lines: []);
    }
    val lines = r.output
        .split("\n")
        .filter({ l -> l.startsWith(inspectMarker()) })
        .map({ l -> l.slice(inspectMarker().length(), l.length()) });
    return Inspection(status: if (lines.length == 0) 1 else 0, lines: lines);
}

pub fn routeLines(wire: string) -> string[] {
    if (wire.trim() == "") return [];
    val rows = wire
        .split(", ")
        .map({ r ->
            val sp = r.indexOf(" ");
            r.slice(sp + 1, r.length()) + "\t" + r.slice(0, sp);
        });
    return sortStrings(rows).map({ r ->
        val tab = r.indexOf("\t");
        r.slice(tab + 1, r.length()) + " " + r.slice(0, tab);
    });
}

fn runRoutes(args: Array<string>) -> i32 {
    val i = inspect(args, "routes");
    if (i.status != 0) return i.status;
    val wire = (i.lines.at(0) ?? "routes ").slice(
        7,
        (i.lines.at(0) ?? "routes ").length(),
    );
    val lines = routeLines(wire);
    for (lines) { l ->
        val _s = say(l);
    }
    val _c = say(lines.length.toString() + " routes");
    return 0;
}

fn runBeans(args: Array<string>) -> i32 {
    val i = inspect(args, "beans");
    if (i.status != 0) return i.status;
    val first = i.lines.at(0) ?? "beans ";
    val names = first
        .slice(6, first.length())
        .split(",")
        .filter({ n -> n != "" });
    for (names) { n ->
        val _s = say(n);
    }
    val _c = say(names.length.toString() + " components");
    return 0;
}

pub fn maskConfigLine(line: string) -> string {
    val eq = line.indexOf("=");
    val tab = line.indexOf("\t");
    if (eq < 0 || tab < eq) return line;
    val key = line.slice(0, eq);
    val lower = key.toLower();
    val secret = sanitizePatterns().filter(
        { p -> p != "" && lower.contains(p) },
    ).length
        > 0;
    return if (secret)
        key + "=******" + line.slice(tab, line.length())
    else
        line;
}

fn runConfig(args: Array<string>) -> i32 {
    val i = inspect(args, "config");
    if (i.status != 0) return i.status;
    for (i.lines) { l ->
        if (l.startsWith("profiles "))
            val _p = say("active profiles: " + l.slice(9, l.length()))
        else
            val _s = say(maskConfigLine(l.slice(7, l.length())));
    }
    return 0;
}

// ── dispatch ────────────────────────────────────────────────────────────────

fn dispatch(args: Array<string>) -> i32 {
    val c = commandOf(args);
    if (c == "") {
        val _h = printHelp();
        return 2;
    }
    if (c == "help" || c == "--help") return printHelp();
    if (c == "new") return runNew(args);
    if (c == "run") return runRun(args);
    if (c == "build") return runBuild(args);
    if (c == "test") return runTest(args);
    if (c == "routes") return runRoutes(args);
    if (c == "beans") return runBeans(args);
    if (c == "config") return runConfig(args);
    if (pluginNames().indexOf(c) >= 0)
        return runPlugin(c, args.slice(1, args.length));
    val _u = say("rakun: unknown command `" + c + "`");
    val _h = printHelp();
    return 2;
}

// The whole CLI: the exit status for `args`. A usage error prints its
// message and answers 2; any other raise prints the reason and answers 1.
pub fn runCli(args: Array<string>) -> i32 {
    val r = guarded({ -> dispatch(args) });
    if (r.isOk()) return r.unwrapOr(0);
    val reason = case r {
        Ok(v) -> "";
        Error(e) -> e;
    };
    val _s = say(reason);
    return if (reason.startsWith(usagePrefix())) 2 else 1;
}
