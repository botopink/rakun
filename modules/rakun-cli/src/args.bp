//// rakun-cli — argv (front 88 step 1).
////
//// `commandOf(args)` is the first argument, `""` for none. A flag is spelled
//// `--name value` or `--name=value`; `flagValue` answers the fallback when the
//// flag is absent and refuses (a usage error) when it ends the line with no
//// value. `hasFlag` matches the exact name only (`--watchdog` is not
//// `--watch`). A usage error raises with the `rakun-cli usage:` prefix, which
//// the dispatcher turns into exit 2.

pub fn usagePrefix() -> string {
    return "rakun-cli usage: ";
}

pub fn usageError(message: string) -> i32 {
    @panic(usagePrefix() + message);
}

pub fn commandOf(args: Array<string>) -> string {
    return args.at(0) ?? "";
}

pub fn hasFlag(args: Array<string>, name: string) -> bool {
    return args.filter({ a -> a == name || a.startsWith(name + "=") }).length
        > 0;
}

pub fn flagValue(
    args: Array<string>,
    name: string,
    fallback: string,
) -> string {
    var found = fallback;
    var i = 0;
    var missing = false;
    while (i < args.length) {
        val a = args.at(i) ?? "";
        if (a.startsWith(name + "="))
            found = a.slice(name.length() + 1, a.length())
        else if (a == name) {
            val next = args.at(i + 1) ?? "";
            if (i + 1 >= args.length || next.startsWith("--"))
                missing = true
            else
                found = next;
        }
        i = i + 1;
    }
    if (missing) val _u = usageError(name + " needs a value");
    return found;
}

// The arguments after the command that are not flags or flag values.
pub fn positionals(
    args: Array<string>,
    valued: Array<string>,
) -> Array<string> {
    var out: Array<string> = [];
    var skip = false;
    var i = 1;
    while (i < args.length) {
        val a = args.at(i) ?? "";
        if (skip) skip = false else if (a.startsWith("--")) {
            if (valued.indexOf(a) >= 0) skip = true;
        } else out.push(a);
        i = i + 1;
    }
    return out;
}
