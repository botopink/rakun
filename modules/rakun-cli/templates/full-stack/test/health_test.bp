// @@name@@ - the one test a scaffolded service ships with.

import {rkDispatchHttp, Response} from "rakun";
import {health.healthStatus};

test "@@name@@: GET /health answers UP" {
    val res: Response = rkDispatchHttp("GET", "/health", "{}", "{}", "");
    assert healthStatus() == "UP" && res.status == 200 && res.body == "UP", res.body;
}
