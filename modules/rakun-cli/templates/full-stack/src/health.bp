// @@name@@ - the health endpoint every scaffolded service starts with.

import {restController, getMapping, Request, Response} from "rakun";
import {rkScan, rkSingleton, rkEnter, rkDone, rkRegisterRoute} from "rakun";

pub fn healthStatus() -> string {
    return "UP";
}

#[restController]
pub type HealthController() {
    #[getMapping("/health")]
    pub fn health(self: Self, req: Request) -> Response {
        return Response.ok(healthStatus());
    }
}
