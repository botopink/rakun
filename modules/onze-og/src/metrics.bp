//// onze-og — text metrics (front 70 step 6).
////
//// botopink cannot read a font file (no byte type), so front 52 writes a
//// `.metrics.txt` sidecar beside each face: `key value` lines (`unitsPerEm`,
//// `ascent`, `descent`, `lineGap`, `avgCharWidth`) and, when the tool that
//// wrote it could read the glyph table, `codepoint|advance` lines in font
//// units. A codepoint the table lacks takes the face's `.notdef` advance —
//// `avgCharWidth` — never zero.

pub type FontMetrics(family: string, weight: i32, unitsPerEm: i32, ascent: i32, descent: i32, notdef: i32, advances: Array<#(i32, i32)>)

#[@External.Node("""Array.from($0, (__c) => __c.codePointAt(0))""")]
#[@External.Erlang("""unicode:characters_to_list($0, utf8)""")]
declare fn codePoints(s: string) -> Array<i32>;

pub fn parseMetrics(family: string, weight: i32, text: string) -> FontMetrics {
    var upm = 1000;
    var ascent = 0;
    var descent = 0;
    var notdef = 0;
    var advances: Array<#(i32, i32)> = [];
    for (text.split("\n")) { raw ->
        val line = raw.trim();
        if (line.contains("|")) {
            val parts = line.split("|");
            val codepointText = parts.at(0) ?? "";
            val advanceText = parts.at(1) ?? "";
            val codepoint = case codepointText.parseInt() {
                Ok(n) -> n.toI32();
                Error(_) -> 0;
            };
            val advance = case advanceText.parseInt() {
                Ok(n) -> n.toI32();
                Error(_) -> 0;
            };
            advances.push(#(codepoint, advance));
        } else if (line.contains(" ")) {
            val key = line.slice(0, line.indexOf(" "));
            val v = case line
                .slice(line.indexOf(" ") + 1, line.length())
                .trim()
                .parseInt() {
                Ok(n) -> n.toI32();
                Error(_) -> 0;
            };
            if (key == "unitsPerEm") upm = v;
            if (key == "ascent") ascent = v;
            if (key == "descent") descent = v;
            if (key == "avgCharWidth" || key == "notdef") notdef = v;
        }
    }
    return FontMetrics(
        family: family,
        weight: weight,
        unitsPerEm: upm,
        ascent: ascent,
        descent: descent,
        notdef: notdef,
        advances: advances,
    );
}

pub fn advanceOf(m: FontMetrics, codepoint: i32) -> i32 {
    val hit = m.advances.filter({ a -> a._0 == codepoint });
    if (hit.length == 0) return m.notdef;
    val pair = hit.at(0) ?? #(0, m.notdef);
    return pair._1;
}

// The width of `text` at `fontSize` px, rounded up.
pub fn measure(m: FontMetrics, text: string, fontSize: i32) -> i32 {
    var units = 0;
    for (codePoints(text)) { c ->
        units = units + advanceOf(m, c);
    }
    return ((units * fontSize + m.unitsPerEm - 1) / m.unitsPerEm);
}
