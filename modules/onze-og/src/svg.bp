//// onze-og — SVG emission (front 70 step 4).
////
//// `<svg>` with a `<rect>` per box that has a background (a solid colour or a
//// `linear-gradient(<angle>, a, b)` emitted once into `<defs>`), and a
//// `<text>` per line with an explicit `font-family`, `font-weight`,
//// `font-size` and `fill` — nothing inherits from a stylesheet that will not
//// exist. Every text goes through std's `escape.html` and every attribute
//// value through `escape.attribute`: a post title is user input and this is
//// a document. Pure and deterministic — two renders of one tree are
//// byte-identical, which the cache key relies on.

import {escape} from "std";
import {card_style.Style};
import {metrics.FontMetrics};
import {layout.LayoutBox, layout.ImageSize, layout.faceFor, layout.lineHeightOf};

pub type FontRef(family: string, weight: i32, path: string, metricsPath: string)

fn attr(v: string) -> string {
    return escape.attribute(v);
}

// `linear-gradient(90deg,#a,#b)` as `#(angle, from, to)`; the angle is `-1`
// when `background` is not a two-stop linear gradient.
pub fn gradientOf(background: string) -> #(i32, string, string) {
    val none = #(0 - 1, "", "");
    val head = "linear-gradient(";
    val shaped = background.startsWith(head) && background.endsWith(")");
    if (shaped == false) return none;
    val inner = background.slice(head.length(), background.length() - 1);
    val parts = inner.split(",").map({ p -> p.trim() });
    if (parts.length != 3) return none;
    val angleText = parts.at(0) ?? "";
    if (angleText.endsWith("deg") == false) return none;
    val angle = case angleText.slice(0, angleText.length() - 3).parseInt() {
        Ok(n) -> n.toI32();
        Error(_) -> 0;
    };
    return #(angle, parts.at(1) ?? "", parts.at(2) ?? "");
}

fn flatten(b: LayoutBox) -> Array<LayoutBox> {
    var out: Array<LayoutBox> = [b];
    for (b.children) { c ->
        out = out.append(flatten(c));
    }
    return out;
}

fn rectOf(b: LayoutBox, fill: string) -> string {
    val rx = if (b.style.borderRadius > 0)
        " rx=\"" + b.style.borderRadius.toString() + "\""
    else
        "";
    val op = if (b.style.opacity < 100)
        " opacity=\""
            + (b.style.opacity / 100).toString()
            + "."
            + (b.style.opacity - (b.style.opacity / 100) * 100)
                .toString()
                .padStart(2, "0")
            + "\""
    else
        "";
    return "<rect x=\""
        + b.x.toString()
        + "\" y=\""
        + b.y.toString()
        + "\" width=\""
        + b.width.toString()
        + "\" height=\""
        + b.height.toString()
        + "\""
        + rx
        + " fill=\""
        + attr(fill)
        + "\""
        + op
        + "/>";
}

fn textOf(b: LayoutBox, faces: Array<FontMetrics>) -> string {
    val s = b.style;
    val face = faceFor(faces, s.fontFamily, s.fontWeight);
    val ascent = if (face.ascent > 0)
        ((s.fontSize * face.ascent) / face.unitsPerEm)
    else
        ((s.fontSize * 4) / 5);
    val lh = lineHeightOf(s);
    var out: string[] = [];
    var i = 0;
    for (b.lines) { line ->
        val y = b.y + ascent + i * lh;
        out.push(
            "<text x=\""
                + b.x.toString()
                + "\" y=\""
                + y.toString()
                + "\" font-family=\""
                + attr(s.fontFamily)
                + "\" font-weight=\""
                + s.fontWeight.toString()
                + "\" font-size=\""
                + s.fontSize.toString()
                + "\" fill=\""
                + attr(if (s.color == "") "#000000" else s.color)
                + "\">"
                + escape.html(line)
                + "</text>",
        );
        i = i + 1;
    }
    return out.join("");
}

pub fn toSvg(
    root: LayoutBox,
    size: ImageSize,
    faces: Array<FontMetrics>,
) -> string {
    var defs: string[] = [];
    var body: string[] = [];
    for (flatten(root)) { b ->
        val bg = b.style.background;
        if (bg != "") {
            val g = gradientOf(bg);
            if (g._0 >= 0) {
                val id = "g" + defs.length.toString();
                defs.push(
                    "<linearGradient id=\""
                        + id
                        + "\" gradientTransform=\"rotate("
                        + (g._0 - 90).toString()
                        + ")\"><stop offset=\"0\" stop-color=\""
                        + attr(g._1)
                        + "\"/><stop offset=\"1\" stop-color=\""
                        + attr(g._2)
                        + "\"/></linearGradient>",
                );
                body.push(rectOf(b, "url(#" + id + ")"));
            } else body.push(rectOf(b, bg));
        }
        if (b.lines.length > 0) body.push(textOf(b, faces));
    }
    val w = size.width.toString();
    val h = size.height.toString();
    val defsText = if (defs.length == 0)
        ""
    else
        "<defs>" + defs.join("") + "</defs>";
    return "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\""
        + w
        + "\" height=\""
        + h
        + "\" viewBox=\"0 0 "
        + w
        + " "
        + h
        + "\">"
        + defsText
        + body.join("")
        + "</svg>";
}
