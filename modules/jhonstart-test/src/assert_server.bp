//// jhonstart-test/assert_server — the request a server component reads (front 28).
////
//// A server component itself is snapshotted as its tree:
//// `val tree = await Page(params); try assertHtml(@src(), tree);`.

import {RequestData} from "jhonstart";
import {encoding} from "std";
import {assertAs} from "snap";

// Six `key: value` lines: `method`, `path`, then `params`, `query`,
// `headers`, `cookies` as querystrings.
pub fn requestText(r: RequestData) -> string {
    val lines: string[] = [
        "method: " + r.method,
        "path: " + r.path,
        "params: " + encoding.formStringify(r.params),
        "query: " + encoding.formStringify(r.query),
        "headers: " + encoding.formStringify(r.headers),
        "cookies: " + encoding.formStringify(r.cookies),
    ];
    return lines.join("\n");
}

pub fn assertRequest(loc: SourceLocation, r: RequestData) -> @Result<void, string> {
    try assertAs(loc, "request", requestText(r));
    return;
}
