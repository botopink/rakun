//// jhonstart-test/assert_stream — the chunks of a streamed render (front 30).

import {assertAs} from "snap";

// For each chunk `--- chunk <n>` (`--- chunk 0 (shell)` for the first), then
// the chunk.
pub fn streamText(chunks: Array<string>) -> string {
    var lines: string[] = [];
    var n = 0;
    for (chunks) { c ->
        val head = if (n == 0)
            "--- chunk 0 (shell)"
        else
            "--- chunk " + n.toString();
        lines.push(head);
        lines.push(c);
        n = n + 1;
    }
    return lines.join("\n");
}

pub fn assertStream(loc: SourceLocation, chunks: Array<string>) -> @Result<void, string> {
    try assertAs(loc, "stream", streamText(chunks));
    return;
}
