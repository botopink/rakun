//// styled: the two template functions — what a literal renders, its class,
//// its holes — on both targets. Every expected text is a literal.

import {testing.asserts, hash, context.createContext, context.provide} from "std";
import {styled.styled, styled.styledProperty, styled.StyledSheet, styled.Styled, styled.StyledProperty};
import {hash.classHash};

pub val tab4 = styledProperty @`tab-size: 4;`;

fn padAll(n: i32) -> Component<StyledProperty> {
    return styledProperty @`padding: --spacing(${n});`;
}

fn hover(inner: Component<StyledProperty>) -> Component<Styled> {
    return styled @`&:hover { ${inner} }`;
}

// The render's root a test renders under (decisions 352, 354): a component
// computed at render reads `StyledSheet`'s context, so it runs below a provider. This
// sheet keeps nothing — what registers is `context_test.bp`'s.
component fn Render(view: fn() -> Component<Styled>) -> Component<Styled> {
    use provide(createContext(StyledSheet(layer: "components", add: dropped)));
    val out = await view();
    return out;
}

component fn RenderProperty(
    view: fn() -> Component<StyledProperty>,
) -> Component<StyledProperty> {
    use provide(createContext(StyledSheet(layer: "components", add: dropped)));
    val out = await view();
    return out;
}

fn dropped(layer: string, item: Styled) -> void {}

// A call in a hole: computed at render, so a function — a `val` is evaluated
// outside every render.
fn code() -> Component<Styled> {
    return styled @`
  ${tab4}
  font-family: var(--font-mono);
  &:hover { ${padAll(
        2,
    )} }
  @variant md { max-width: --theme(--breakpoint-md); }
`;
}

pub val nested = styled @`
  color: red;
  .icon, & > p { margin: 0; }
  &:focus { &::after { content: "}"; } }
`;

pub val wrapped = styled @`
  display: grid;
  @supports (display: grid) { gap: 1rem; }
  @media (width >= 40rem) { &:hover { gap: 2rem; } }
  @variant max-lg { gap: 0; }
  @variant dark { color: white; }
`;

pub val functions = styled @`
  background: --alpha(var(--color-blue-500) / 80%);
  margin: --spacing(-2) --spacing(0.5);
  /* a comment is not served */
  width: calc(100% - --spacing(4));
`;

fn sized(width: string, columns: i32, ratio: f64) -> Component<Styled> {
    return styled @`width: ${width}; columns: ${columns}; aspect-ratio: ${ratio};`;
}

// Every hole known at build (decision 355), computed at render all the same:
// the template never reads a hole's value (decision 577 (5)).
pub val tabRed = styled @`${tab4} color: red;`;

pub val half = "50%";

pub val sizedAtBuild = styled @`width: ${half}; columns: ${3}; aspect-ratio: ${1.5};`;

test "a property's hole is a value; --spacing() expands" {
    val p = await RenderProperty({ -> padAll(4) });
    try asserts.equals(
        p.rules,
        "." + p.className + "{padding:calc(var(--spacing) * 4)}",
    );
    try asserts.equals(p.declarations, "padding:calc(var(--spacing) * 4)");
}

test "a property with no hole is computed at build, its class std's contentHash of its rules" {
    val t = await tab4;
    try asserts.equals(t.className, "s_e8b00b8b");
    try asserts.equals(t.rules, ".s_e8b00b8b{tab-size:4}");
    try asserts.equals(
        t.className,
        "s_" + hash.contentHash("\u{1}{tab-size:4}"),
    );
}

test "classHash is std's contentHash" {
    val texts = [
        "",
        "a",
        "\u{1}{tab-size:4}",
        "héllo",
        "a much longer text, with spaces and ; : { } punctuation",
    ];
    for (texts) { t ->
        try asserts.equals(classHash(t), hash.contentHash(t));
    }
}

test "a Component<StyledProperty> in a hole inlines its declarations (@apply)" {
    val c = await Render({ -> code() });
    try asserts.isTrue(
        c.rules.contains(
            "." + c.className + "{tab-size:4;font-family:var(--font-mono)}",
        ),
    );
    try asserts.isTrue(
        c.rules.contains(
            "." + c.className + ":hover{padding:calc(var(--spacing) * 2)}",
        ),
    );
}

test "@variant md reads the theme's breakpoint at build" {
    val c = await Render({ -> code() });
    try asserts.isTrue(
        c.rules.contains(
            "@media (width >= 48rem){." + c.className + "{max-width:48rem}}",
        ),
    );
}

test "the whole of a component, in order" {
    val c = await Render({ -> code() });
    val k = "." + c.className;
    try asserts.equals(
        c.rules,
        k
            + "{tab-size:4;font-family:var(--font-mono)}"
            + k
            + ":hover{padding:calc(var(--spacing) * 2)}@media (width >= 48rem){"
            + k
            + "{max-width:48rem}}",
    );
}

test "nesting: & is the class, a selector without & is a descendant, lists cross" {
    val n = await nested;
    val k = "." + n.className;
    try asserts.equals(
        n.rules,
        k
            + "{color:red}"
            + k
            + " .icon,"
            + k
            + " > p{margin:0}"
            + k
            + ":focus::after{content:\"}\"}",
    );
}

test "at-rules and variants wrap the class; the rules nest inside" {
    val w = await wrapped;
    val k = "." + w.className;
    try asserts.equals(
        w.rules,
        k
            + "{display:grid}@supports (display: grid){"
            + k
            + "{gap:1rem}}@media (width >= 40rem){"
            + k
            + ":hover{gap:2rem}}@media (width < 64rem){"
            + k
            + "{gap:0}}@media (prefers-color-scheme: dark){"
            + k
            + "{color:white}}",
    );
}

test "--alpha() and --spacing() expand anywhere in a value; a comment is dropped" {
    val f = await functions;
    val k = "." + f.className;
    try asserts.equals(
        f.rules,
        k
            + "{background:color-mix(in oklab, var(--color-blue-500) 80%, transparent);margin:calc(var(--spacing) * -2) calc(var(--spacing) * 0.5);width:calc(100% - calc(var(--spacing) * 4))}",
    );
}

test "a value hole takes a string, an i32 or an f64" {
    val s = await Render({ -> sized("50%", 3, 1.5) });
    try asserts.equals(
        s.rules,
        "." + s.className + "{width:50%;columns:3;aspect-ratio:1.5}",
    );
}

test "a hole spliced in a nested block" {
    val h = await Render({ -> hover(tab4) });
    try asserts.equals(h.rules, "." + h.className + ":hover{tab-size:4}");
}

test "the same rules are the same class, under the layer's prefix" {
    val a = await RenderProperty({ -> padAll(4) });
    val b = await RenderProperty({ -> padAll(4) });
    val c = await RenderProperty({ -> padAll(8) });
    try asserts.equals(a.className, b.className);
    try asserts.notEquals(a.className, c.className);
    try asserts.isTrue(a.className.startsWith("s_"));
}

test "a computed class is the one a constant literal of the same rules gets" {
    val computed = await RenderProperty({ -> padAll(4) });
    val constant = await styledProperty @`padding: --spacing(4);`;
    try asserts.equals(computed.className, constant.className);
    try asserts.equals(computed.rules, constant.rules);
}

// A hole known at build is computed at render all the same: the template
// never reads a hole's value (decision 577 (5)).
test "a literal whose every hole is known at build is the one the render computes" {
    val built = await Render({ -> tabRed });
    try asserts.equals(built.className, "s_b480a37a");
    try asserts.equals(built.rules, ".s_b480a37a{tab-size:4;color:red}");
    val values = await Render({ -> sizedAtBuild });
    val rendered = await Render({ -> sized("50%", 3, 1.5) });
    try asserts.equals(values.className, rendered.className);
    try asserts.equals(values.rules, rendered.rules);
}

test "toStyled answers the component under its class" {
    val t = await tab4;
    val s = await t.toStyled();
    try asserts.equals(s.className, t.className);
    try asserts.equals(s.rules, t.rules);
}
