// The suite case of front 119's `styled-example.bp`, byte for byte but for
// the header, the import lines (a module of this package names it by path,
// decision 206; an application writes `from "rakun-style"`) and the names this
// package keeps out of its tree (decision 338: `styled` knows no file kind and
// no framework).
//
// Demonstrates: step 1 — the repository `styled`, the base for building CSS
// components (decision 338). `styled "…"` (the package's `pub default fn`) and
// `styledProperty "…"` (declarations only) are template functions: values go
// in `${…}` holes, so the braces stay CSS's; Tailwind v4's CSS syntax works
// where it is CSS (`--spacing()`, `--theme()`, `@variant`); `@apply` is a hole
// of a `StyledPropertyView`. Both answer components in the language's model
// (`@Component<…>`), so a test reads one after `await`. A component computed
// at render registers in the render's sheet through `use
// context(StyledContext)` (decisions 352, 354), so it runs below a provider.

import {styled.styled, styled.styledProperty, styled.StyledView, styled.StyledPropertyView, styled.StyledSheet, styled.Styled, styled.StyledProperty, layers.Sheet, layers.layer};
import {context.createContext, context.provide} from "std";

pub val tab4 = styledProperty "tab-size: 4;";

// Tailwind: @utility p-* { padding: --spacing(--value(integer)); }
fn padAll(n: i32) -> StyledPropertyView {
    return styledProperty "padding: --spacing(${n});";
}

// `${padAll(2)}` is a call, so `code` is computed at render (decision 355):
// a function, run below the render's provider — a `val` is evaluated outside
// every render.
fn code() -> StyledView {
    return styled """
  ${tab4}
  font-family: var(--font-mono);
  &:hover { ${padAll(
        2,
    )} }
  @variant md { max-width: --theme(--breakpoint-md); }
""";
}

// The render's root: whoever renders provides `StyledSheet`'s context — rakun-bpp's
// render, emilia's `flush()` (decision 354 (7)). This one keeps nothing.
fn Render(view: fn() -> StyledView) -> @Component<Styled> {
    use provide(createContext(StyledSheet(layer: "components", add: dropped)));
    val out = await view();
    return out;
}

fn RenderProperty(
    view: fn() -> StyledPropertyView,
) -> @Component<StyledProperty> {
    use provide(createContext(StyledSheet(layer: "components", add: dropped)));
    val out = await view();
    return out;
}

fn dropped(layer: string, item: Styled) -> void {}

test "styled: a property's hole is a value; --spacing() expands" {
    val p = await RenderProperty({ -> padAll(4) });
    assert p.rules == "." + p.className + "{padding:calc(var(--spacing) * 4)}";
}

test "styled: a StyledPropertyView in a hole inlines its declarations (@apply)" {
    val c = await Render({ -> code() });
    assert c.rules.contains(
        "." + c.className + "{tab-size:4;font-family:var(--font-mono)}",
    );
    assert c.rules.contains(
        "." + c.className + ":hover{padding:calc(var(--spacing) * 2)}",
    );
}

test "styled: @variant md reads the theme's breakpoint at build" {
    // the base theme's md (48rem); an app's #[theme] entry moves it once a
    // template function reads the program's catalogue (language-gaps.md)
    val c = await Render({ -> code() });
    assert c.rules.contains(
        "@media (width >= 48rem){." + c.className + "{max-width:48rem}}",
    );
}

test "styled: the same rules are the same class, under the layer's prefix" {
    val a = await RenderProperty({ -> padAll(4) });
    val b = await RenderProperty({ -> padAll(4) });
    val c = await RenderProperty({ -> padAll(8) });
    assert a.className == b.className;
    assert a.className != c.className;
    assert a.className.startsWith("s_");
}

test "styled: a sheet renders its layers in declaration order, each component once" {
    val c = await Render({ -> code() });
    val p = await RenderProperty({ -> padAll(2) });
    // LANGUAGE GAP: a sheet is a value (no assignment to a record's field) and a method's behavior-typed parameter refuses an implementer, so `add` answers the sheet and takes the `Styled` a property's `toStyled()` answers.
    val sheet = Sheet
        .of([layer("base"), layer("components")])
        .add("components", c)
        .add("components", c)
        .add("base", await p.toStyled());
    val out = sheet.render();
    assert out.indexOf("@layer base") < out.indexOf("@layer components");
    assert out.split(c.rules).length == 2;
}

// What does not compile (each a case under `repository/styled/refusals/`):
//
//   styledProperty "&:hover { color: red; }"
//     error: styled: styledProperty holds declarations only — use styled for
//            selectors, variants and at-rules                             at `&`
//
//   styled "@utility tab-* { tab-size: --value(integer); }"
//     error: styled: name a component with a val or a function           at @utility
//
//   styled "@theme { --color-mint-500: oklch(0.72 0.11 178); }"
//     error: styled: the theme is the typed #[theme] (extendTheme, entry) at @theme
//
//   styled "@variant 2xl { … }"            // with 2xl cleared in the theme read
//     error: styled: breakpoint `2xl` was cleared from the theme         at 2xl
