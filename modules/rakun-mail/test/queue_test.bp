//// rakun-mail — the queue, retries and the dead-letter path (front 85 step
//// 4), and front 83's outbox as the durable path.

import {rkSetProp} from "rakun";
import {startDataSource, sqlTemplate} from "rakun-data";
import {installOutbox, relayTick} from "rakun-data";
import {attempt} from "rakun-data/tx/outbox";
import {mail.Mail, mail.send, mail.configureMail, mail.resetMailQueue, mail.mailPending, mail.mailDeadLetters, mail.mailLog, mail.mailQueueStats, mail.publishMailAfterCommit, mail.mailRelayPublisher};
import {fixture.fixtureStart, fixture.fixtureStop, fixture.fixtureMessages, fixture.fixtureConnections, fixture.fixturePeak};

#[@External.Erlang("""(fun(__Ms) -> timer:sleep(__Ms), 0 end)($0)""")]
declare fn pause(ms: i32) -> i32;

#[@External.Erlang("""erlang:monotonic_time(millisecond)""")]
declare fn nowMs() -> i64;

fn configure(port: i32, concurrency: i32, attempts: i32, backoff: i32) -> i32 {
    val _h = rkSetProp("rakun.mail.host", "localhost");
    val _p = rkSetProp("rakun.mail.port", port.toString());
    val _t = rkSetProp("rakun.mail.timeout", "2000");
    val _c = rkSetProp("rakun.mail.queue.concurrency", concurrency.toString());
    val _a = rkSetProp("rakun.mail.retry.max-attempts", attempts.toString());
    val _b = rkSetProp("rakun.mail.retry.backoff-ms", backoff.toString());
    val _r = resetMailQueue();
    return configureMail();
}

fn done() -> i32 {
    for ([
        "host",
        "port",
        "timeout",
        "queue.concurrency",
        "retry.max-attempts",
        "retry.backoff-ms",
    ]) { k ->
        val _u = rkSetProp("rakun.mail." + k, "");
    }
    return resetMailQueue();
}

fn drain(ms: i32) -> i32 {
    var waited = 0;
    while (mailPending() > 0 && waited < ms) {
        val _w = pause(20);
        waited = waited + 20;
    }
    return mailPending();
}

fn note(subject: string) -> Mail {
    return Mail(
        sender: "app@example.com",
        to: ["bob@example.com"],
        cc: [],
        bcc: [],
        replyTo: "",
        subject: subject,
        text: "t",
        html: "",
        attachments: [],
        headers: [],
    );
}

test "queue: send returns before any socket is opened" {
    val port = fixtureStart([]);
    val _c = configure(port, 0, 1, 10);
    val id = send(note("held"));
    val _w = pause(100);
    val opened = fixtureConnections(port);
    val _f = fixtureStop(port);
    val _z = done();
    assert id.startsWith("m-") && opened == 0, opened.toString();
}

test "queue: an unreachable server does not slow the sender - four sends return at once" {
    val port = fixtureStart(["silent"]);
    val _c = configure(port, 2, 1, 10);
    val start = nowMs();
    val _a = send(note("1"));
    val _b = send(note("2"));
    val _d = send(note("3"));
    val _e = send(note("4"));
    val took = nowMs() - start;
    val _f = fixtureStop(port);
    val _z = done();
    assert took < 200, took.toString();
}

test "queue: a retryable failure is retried with backoff to the ceiling, then dead-lettered with its last error" {
    val port = fixtureStart(["fail=MAIL:451"]);
    val _c = configure(port, 1, 3, 100);
    val start = nowMs();
    val id = send(note("retry"));
    val left = drain(5000);
    val took = nowMs() - start;
    val attempts = mailLog().filter(
        { l -> l.contains(id + " attempt") },
    ).length;
    val dead = mailDeadLetters().filter({ d -> d.startsWith(id + "\t") });
    val _f = fixtureStop(port);
    val _z = done();
    assert left == 0 && attempts == 3 && took >= 300, attempts.toString()
        + " "
        + took.toString();
    assert dead.length == 1
        && (dead.at(0) ?? "").startsWith(
            id + "\tretryable\tMAIL FROM answered 451",
        ), dead.join("|");
}

test "queue: a permanent failure goes straight to dead-letter without retries" {
    val port = fixtureStart(["fail=RCPT:550"]);
    val _c = configure(port, 1, 5, 100);
    val id = send(note("bad rcpt"));
    val _d = drain(3000);
    val attempts = mailLog().filter(
        { l -> l.contains(id + " attempt") },
    ).length;
    val dead = mailDeadLetters().filter({ d -> d.startsWith(id + "\t") });
    val _f = fixtureStop(port);
    val _z = done();
    assert attempts == 1
        && (dead.at(0) ?? "").contains(
            "permanent\tRCPT TO answered 550",
        ), dead.join("|");
}

test "queue: N queued messages open at most the configured number of connections" {
    val port = fixtureStart(["slow-data=150"]);
    val _c = configure(port, 2, 1, 10);
    var i = 0;
    while (i < 6) {
        val _s = send(note("m" + i.toString()));
        i = i + 1;
    }
    val left = drain(10000);
    val peak = fixturePeak(port);
    val delivered = fixtureMessages(port).length;
    val stats = mailQueueStats();
    val _f = fixtureStop(port);
    val _z = done();
    assert left == 0
        && delivered == 6
        && peak <= 2
        && peak >= 1
        && stats.contains("peak=2"), stats + " fixture peak " + peak.toString();
}

fn rollbackOne() -> string {
    return attempt({ ->
        sqlTemplate("mailtx").transaction({ t ->
            val _p = publishMailAfterCommit("mailtx", note("rolled back"));
            if (true) @panic("rollback");
            0;
        });
    });
}

test "queue: a mail through front 83's outbox is sent once per relay pass, and never after a rollback" {
    val port = fixtureStart([]);
    val _c = configure(port, 2, 1, 10);
    val _s = startDataSource("mailtx", "ets:memory", 2, 5000, "eager");
    val _i = installOutbox("mailtx");
    val _t = sqlTemplate("mailtx").transaction(
        { t -> publishMailAfterCommit("mailtx", note("committed")) },
    );
    val refused = rollbackOne();
    val first = relayTick("mailtx", mailRelayPublisher());
    val second = relayTick("mailtx", mailRelayPublisher());
    val msgs = fixtureMessages(port);
    val stats = mailQueueStats();
    val _f = fixtureStop(port);
    val _z = done();
    assert refused.contains("rollback")
        && first == 1
        && second == 0
        && msgs.length == 1
        && (msgs.at(0) ?? "").contains("Subject: committed"), msgs.join(
        "\n---\n",
    );
    assert stats.contains("sent=0"), stats;
}
