//// rakun-mail — the SMTP client and the `mail` health indicator (front 85
//// steps 1 and 5) against the fixture server. TLS material is issued once per
//// run with `openssl` (a throwaway CA and a `localhost` leaf); the client
//// trusts the CA through a front 74 bundle.

import {testing.asserts} from "std";
import {rkSetProp, rkProp, bundleKey, sslRegister} from "rakun";
import {healthIndicatorIds} from "rakun";
import {mail.Mail, mail.MailServer, mail.TlsMode, mail.Attachment, mail.deliverNow, mail.mailHealth, mail.mountMail, mail.mailConfigProblem, mail.send, mail.configureMail, mail.resetMailQueue, mail.mailPending, mail.mailLog, mail.mailDeadLetters};
import {fixture.fixtureStart, fixture.fixtureStop, fixture.fixtureMessages, fixture.fixtureTranscript};

#[@External.Erlang("""(fun() -> __D = string:trim(os:cmd("mktemp -d")), __Q = fun(__C) -> os:cmd("cd " ++ __D ++ " && " ++ __C ++ " 2>/dev/null") end, __Q("openssl req -x509 -newkey rsa:2048 -nodes -days 2 -subj /CN=rakun-mail-test-ca -keyout ca.key -out ca.pem"), __Q("printf 'subjectAltName=DNS:localhost' > leaf.ext"), __Q("openssl req -newkey rsa:2048 -nodes -subj /CN=localhost -keyout key.pem -out leaf.csr"), __Q("openssl x509 -req -in leaf.csr -CA ca.pem -CAkey ca.key -CAcreateserial -days 2 -extfile leaf.ext -out cert.pem"), __Q("openssl req -x509 -newkey rsa:2048 -nodes -days 2 -subj /CN=stranger -keyout stranger.key -out stranger.pem"), unicode:characters_to_binary(__D) end)()""")]
declare fn issueMaterial() -> string;
#[@External.Erlang("""(fun(__Ms) -> timer:sleep(__Ms), 0 end)($0)""")]
declare fn pause(ms: i32) -> i32;
#[@External.Erlang("""erlang:monotonic_time(millisecond)""")]
declare fn nowMs() -> i32;
#[@External.Erlang("""(fun(__F, __N) -> ok = file:write_file(unicode:characters_to_list(__F), crypto:strong_rand_bytes(__N)), __F end)($0, $1)""")]
declare fn randomFile(file: string, bytes: i32) -> string;
#[@External.Erlang("""(fun() -> string:trim(unicode:characters_to_binary(os:cmd("mktemp -d"))) end)()""")]
declare fn tempDir() -> string;

fn material() -> string {
    val known: string = rkProp("test.mail.tls.dir");
    if (known != "") return known;
    val d: string = issueMaterial();
    val _s = rkSetProp("test.mail.tls.dir", d);
    return d;
}

fn trust(name: string, caFile: string) -> string {
    val _n = rkSetProp("rakun.ssl.bundle.pem", "mailca,mailstranger");
    val _t = rkSetProp(bundleKey(name, "truststore.certificate"), caFile);
    val _r = sslRegister(name);
    return name;
}

fn tlsOpts(extra: string[]) -> string[] {
    var out: string[] = ["cert=" + material() + "/cert.pem", "key=" + material() + "/key.pem"];
    for (extra) { e -> out.push(e); };
    return out;
}

fn server(port: i32, mode: TlsMode, user: string, bundle: string) -> MailServer {
    return MailServer(host: "localhost", port: port, username: user, password: if (user == "") "" else "hunter2-secret", tlsMode: mode, bundle: bundle, connectTimeoutMs: 2000, readTimeoutMs: 2000, writeTimeoutMs: 2000);
}

fn simple(subject: string) -> Mail {
    return Mail(sender: "App <app@example.com>", to: ["bob@example.com"], cc: [], bcc: [], replyTo: "", subject: subject, text: "hello", html: "", attachments: [], headers: []);
}

fn has(lines: string[], needle: string) -> bool {
    return lines.filter({ l -> l.contains(needle) }).length > 0;
}

fn kindOf(result: string) -> string {
    return result.split("\t").at(0) ?? "";
}

fn setServer(port: i32, tls: string, bundle: string) -> i32 {
    val _h = rkSetProp("rakun.mail.host", "localhost");
    val _p = rkSetProp("rakun.mail.port", port.toString());
    val _t = rkSetProp("rakun.mail.tls", tls);
    val _b = rkSetProp("rakun.mail.ssl.bundle", bundle);
    return 0;
}

fn clearServer() -> i32 {
    for (["host", "port", "tls", "ssl.bundle", "username", "password", "health.timeout-ms", "timeout", "queue.concurrency", "retry.max-attempts", "retry.backoff-ms"]) { k -> val _u = rkSetProp("rakun.mail." + k, ""); };
    return 0;
}

// ── step 1 ──────────────────────────────────────────────────────────────────

test "smtp: EHLO, AUTH PLAIN, MAIL FROM, RCPT TO, DATA and QUIT complete against the fixture" {
    val port = fixtureStart(["auth=PLAIN LOGIN"]);
    val r = deliverNow(server(port, TlsMode.None, "app", ""), simple("hi"));
    val t = fixtureTranscript(port);
    val _s = fixtureStop(port);
    assert r == "", r;
    assert has(t, "EHLO ") && has(t, "MAIL FROM:<app@example.com>") && has(t, "RCPT TO:<bob@example.com>") && has(t, "DATA") && has(t, "QUIT") && has(t, "AUTH-USED PLAIN app hunter2-secret"), t.join(" | ");
}

test "smtp: AUTH LOGIN is used when the server offers it and not PLAIN" {
    val port = fixtureStart(["auth=LOGIN"]);
    val r = deliverNow(server(port, TlsMode.None, "app", ""), simple("hi"));
    val t = fixtureTranscript(port);
    val _s = fixtureStop(port);
    assert r == "" && has(t, "AUTH-USED LOGIN app hunter2-secret") && has(t, "AUTH PLAIN") == false, t.join(" | ");
}

test "smtp: StartTls upgrades the connection, and refuses a server that does not advertise STARTTLS" {
    val bundle = trust("mailca", material() + "/ca.pem");
    val port = fixtureStart(tlsOpts(["starttls"]));
    val r = deliverNow(server(port, TlsMode.StartTls, "", bundle), simple("over tls"));
    val msgs = fixtureMessages(port);
    val _s = fixtureStop(port);
    assert r == "" && msgs.length == 1 && (msgs.at(0) ?? "").split("\n").at(0) == "app@example.com\tbob@example.com\ttrue", msgs.join("\n");
    val plain = fixtureStart([]);
    val refused = deliverNow(server(plain, TlsMode.StartTls, "", bundle), simple("never"));
    val t = fixtureTranscript(plain);
    val _p = fixtureStop(plain);
    assert kindOf(refused) == "permanent" && refused.contains("does not advertise it - no key permits continuing in the clear") && has(t, "MAIL FROM") == false, refused;
}

test "smtp: Implicit is TLS from the first byte, on the configured bundle" {
    val bundle = trust("mailca", material() + "/ca.pem");
    val port = fixtureStart(tlsOpts(["implicit"]));
    val r = deliverNow(server(port, TlsMode.Implicit, "", bundle), simple("implicit"));
    val msgs = fixtureMessages(port);
    val _s = fixtureStop(port);
    assert r == "" && (msgs.at(0) ?? "").contains("\ttrue\n"), r + " " + msgs.join("\n");
}

test "smtp: the connect, read and write timeouts fire independently, each named" {
    val c = deliverNow(MailServer(host: "10.255.255.1", port: 25, username: "", password: "", tlsMode: TlsMode.None, bundle: "", connectTimeoutMs: 200, readTimeoutMs: 5000, writeTimeoutMs: 5000), simple("x"));
    val silent = fixtureStart(["silent"]);
    val r = deliverNow(MailServer(host: "localhost", port: silent, username: "", password: "", tlsMode: TlsMode.None, bundle: "", connectTimeoutMs: 5000, readTimeoutMs: 200, writeTimeoutMs: 5000), simple("x"));
    val _s = fixtureStop(silent);
    val slow = fixtureStart(["slow-data=4000"]);
    val big = randomFile(tempDir() + "/big.bin", 12000000);
    val m = Mail(sender: "app@example.com", to: ["bob@example.com"], cc: [], bcc: [], replyTo: "", subject: "big", text: "x", html: "", attachments: [Attachment(filename: "big.bin", contentType: "application/octet-stream", path: big, inline: false, cid: "")], headers: []);
    val w = deliverNow(MailServer(host: "localhost", port: slow, username: "", password: "", tlsMode: TlsMode.None, bundle: "", connectTimeoutMs: 5000, readTimeoutMs: 5000, writeTimeoutMs: 300), m);
    val _w = fixtureStop(slow);
    assert c.contains("connect-timeout") && r.contains("read-timeout") && w.contains("write-timeout"), c + " / " + r + " / " + w;
}

test "smtp: a 5xx fails permanently and a 4xx retryably" {
    val p5 = fixtureStart(["fail=RCPT:550"]);
    val r5 = deliverNow(server(p5, TlsMode.None, "", ""), simple("x"));
    val _a = fixtureStop(p5);
    val p4 = fixtureStart(["fail=MAIL:451"]);
    val r4 = deliverNow(server(p4, TlsMode.None, "", ""), simple("x"));
    val _b = fixtureStop(p4);
    assert kindOf(r5) == "permanent" && r5.contains("RCPT TO answered 550") && kindOf(r4) == "retryable" && r4.contains("MAIL FROM answered 451"), r5 + " / " + r4;
}

test "smtp: credentials appear in no log line, error or health detail" {
    val port = fixtureStart(["auth=PLAIN", "fail=AUTH:535"]);
    val _r = resetMailQueue();
    val _s = setServer(port, "none", "");
    val _u = rkSetProp("rakun.mail.username", "app");
    val _p = rkSetProp("rakun.mail.password", "hunter2-secret");
    val _c = configureMail();
    val direct = deliverNow(server(port, TlsMode.None, "app", ""), simple("x"));
    val _q = send(simple("queued"));
    var waited = 0;
    while (mailPending() > 0 && waited < 50) {
        val _w = pause(20);
        waited = waited + 1;
    };
    val health = mailHealth();
    val out = direct + mailLog().join("\n") + mailDeadLetters().join("\n") + health.details;
    val _f = fixtureStop(port);
    val _z = clearServer();
    assert direct.contains("535") && mailDeadLetters().length >= 0, direct;
    assert out.contains("hunter2") == false && out.contains("aHVudGVyMi1zZWNyZXQ") == false && health.details.contains("\"app\"") == false, out;
}

// ── step 5 ──────────────────────────────────────────────────────────────────

test "health: absent until mounted, then registered with front 11" {
    assert healthIndicatorIds().indexOf("mail") < 0;
    val _m = mountMail();
    assert healthIndicatorIds().indexOf("mail") >= 0;
}

test "health: UP when EHLO and STARTTLS complete, and nothing is sent" {
    val bundle = trust("mailca", material() + "/ca.pem");
    val port = fixtureStart(tlsOpts(["starttls"]));
    val _s = setServer(port, "starttls", bundle);
    val h = mailHealth();
    val t = fixtureTranscript(port);
    val msgs = fixtureMessages(port);
    val _f = fixtureStop(port);
    val _z = clearServer();
    assert h.status == "UP" && h.details.contains("\"tls\":\"starttls\"") && h.details.contains("\"tlsNegotiated\":true") && h.details.contains("\"port\":" + port.toString()), h.details;
    assert msgs.length == 0 && has(t, "MAIL") == false && has(t, "STARTTLS") && has(t, "QUIT"), t.join(" | ");
}

test "health: DOWN with a reason when the connection or the TLS negotiation fails" {
    val gone = fixtureStart([]);
    val _g = fixtureStop(gone);
    val _s = setServer(gone, "none", "");
    val refused = mailHealth();
    val stranger = trust("mailstranger", material() + "/stranger.pem");
    val port = fixtureStart(tlsOpts(["starttls"]));
    val _t = setServer(port, "starttls", stranger);
    val tls = mailHealth();
    val _f = fixtureStop(port);
    val _z = clearServer();
    assert refused.status == "DOWN" && refused.details.contains("connect"), refused.details;
    assert tls.status == "DOWN" && tls.details.contains("TLS negotiation failed"), tls.details;
}

test "health: the check has its own timeout, shorter than the send timeouts" {
    val silent = fixtureStart(["silent"]);
    val _s = setServer(silent, "none", "");
    val _h = rkSetProp("rakun.mail.health.timeout-ms", "300");
    val start = nowMs();
    val h = mailHealth();
    val took = nowMs() - start;
    val _t = rkSetProp("rakun.mail.health.timeout-ms", "6000");
    val problem = mailConfigProblem();
    val _f = fixtureStop(silent);
    val _z = clearServer();
    assert h.status == "DOWN" && took < 1500, took.toString() + " " + h.details;
    assert problem.contains("rakun.mail.health.timeout-ms (6000) must be shorter than every send timeout (the shortest is 5000 ms)"), problem;
}

test "smtp: rakun.mail.transport=gen_smtp without its adapter refuses the boot, naming the module - no fallback" {
    val _t = rkSetProp("rakun.mail.transport", "gen_smtp");
    try asserts.throwsWith({ -> configureMail() }, "rakun.mail.transport=gen_smtp names the adapter module rakun_mail_gen_smtp, which is not loadable");
    val _u = rkSetProp("rakun.mail.transport", "");
}
