//// rakun-mail — the fixture SMTP server's cells (front 85's test plan; the
//// server is `rakun_mail_fixture.erl`). Test-only, and in `src/` because a
//// `test/` module cannot import a sibling and a sidecar is shipped only for a
//// root-level module.

#[@external(.Erlang("rakun_mail_fixture:start($0)"))]
pub declare fn fixtureStart(opts: string[]) -> i32;

#[@external(.Erlang("rakun_mail_fixture:stop($0)"))]
pub declare fn fixtureStop(port: i32) -> i32;

#[@external(.Erlang("rakun_mail_fixture:messages($0)"))]
pub declare fn fixtureMessages(port: i32) -> string[];

#[@external(.Erlang("rakun_mail_fixture:transcript($0)"))]
pub declare fn fixtureTranscript(port: i32) -> string[];

#[@external(.Erlang("rakun_mail_fixture:connections($0)"))]
pub declare fn fixtureConnections(port: i32) -> i32;

#[@external(.Erlang("rakun_mail_fixture:peak($0)"))]
pub declare fn fixturePeak(port: i32) -> i32;
