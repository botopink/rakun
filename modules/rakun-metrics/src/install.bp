//// rakun-metrics — the boot entry. `installMetrics()` resolves the common
//// tags and refuses a bad SLO property (naming it), attaches the automatic
//// meters to the bus, registers the BEAM VM meters and the three endpoints,
//// installs the trace sampler and starts the OTLP push when configured.
//// Idempotent: a second call registers nothing twice.

import {rkMetricsInstall} from "registry";
import {installAutomaticMeters} from "bus";
import {installVmMetrics} from "vm";
import {installTracing} from "tracing";
import {startOtlpExport} from "export";
import {registerMetricsEndpoints} from "endpoints";

pub fn installMetrics() -> i32 {
    val _i = rkMetricsInstall();
    val _a = installAutomaticMeters();
    val _v = installVmMetrics();
    val _e = registerMetricsEndpoints();
    val _t = installTracing();
    val _o = startOtlpExport();
    return 0;
}
