//// rakun-metrics — the BEAM VM meters (front 75 step 3), in place of JVM
//// meters: run-queue length, process / port / atom counts against their
//// limits, memory by area, GC totals and the longest mailbox, all gauges read
//// at scrape time. `beam.schedulers.utilization` exists only with
//// `rakun.metrics.beam.scheduler-utilization=true`, which turns the VM's
//// `scheduler_wall_time` on once (it is not free). `beam.messages.queue_max`
//// samples the process list and stops at
//// `rakun.metrics.beam.queue-sample-budget` milliseconds (default 20).

#[@External.Erlang("rakun_metrics", "vm_install")]
declare fn rkMetricsVmInstall() -> i32;

#[@External.Erlang("rakun_metrics", "vm_memory")]
pub declare fn rkMetricsVmMemory() -> string;

#[@External.Erlang("rakun_metrics", "queue_max")]
pub declare fn rkMetricsQueueMax(budgetMillis: i32) -> i32;

#[@External.Erlang("rakun_metrics", "swt_enables")]
pub declare fn rkMetricsSwtEnables() -> i32;

// A gauge's current value (a float scaled by 1000), or -1 when absent.
#[@External.Erlang("rakun_metrics", "gauge_read")]
pub declare fn rkMetricsGaugeRead(name: string) -> i64;

pub fn vmMeterNames() -> string[] {
    return [
        "beam.schedulers.run_queue",
        "beam.processes.count", "beam.processes.limit",
        "beam.ports.count", "beam.ports.limit",
        "beam.atoms.count", "beam.atoms.limit",
        "beam.memory.total", "beam.memory.processes", "beam.memory.system", "beam.memory.atom",
        "beam.memory.binary", "beam.memory.code", "beam.memory.ets",
        "beam.gc.count", "beam.gc.words_reclaimed",
        "beam.messages.queue_max",
    ];
}

pub fn installVmMetrics() -> i32 {
    return rkMetricsVmInstall();
}
