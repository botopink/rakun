//// onze-cli — `generate` (front 50 step 4): the check, the staged tree and
//// the module tree.
////
//// `app/blog/[slug]/page.bp` cannot be reached by a `mod` path — `[slug]`,
//// `(marketing)` and `@feed` are not identifiers, `not-found` is not one and
//// `default` is a keyword — so the build STAGES the project's sources under
//// `<outDir>/src/`, renaming each directory and convention file (`d_slug`,
//// `g_marketing`, `s_feed`, `c_rest`, `o_rest`, `not_found`,
//// `default_view` — `onze-bundler`'s `stagedSegment` / `stagedStem`, the one
//// spelling the graph uses too), rewriting every alias prefix of an import
//// with front 49's `resolveAlias`, and generating:
////
////   * a `mod.bp` for every staged directory under the app, one `pub mod`
////     line per child, sorted — an authored `mod.bp` under the app is replaced,
////     since it cannot name `[slug]` or `(group)` children;
////   * `onze_routes.bp`, the registrations the boot owes the conventions
////     without a decorator — `jhLoading` / `jhError` / `jhNotFound` for each
////     `loading.bp`, `error.bp`, `not-found.bp`;
////   * `root.bp` — the project's own root plus `pub mod app;` and
////     `pub mod onze_routes;`;
////   * `<outDir>/botopink.json` — the project's manifest with `src` pointed
////     at the staged tree and each relative `path` dependency re-rooted.
////
//// `checkTree` compares each file's directory with its decorator argument
//// and names the AUTHORED path — the developer has never seen `d_slug`.

import {path, json.Json, json.decode, json.quote} from "std";
import {AliasMap, resolveAlias} from "onze";
import {conventions.classify} from "routing";
import {stagedSegment, stagedStem, publicNamesOf} from "onze-bundler";
import {scan.RouteEntry, scan.decoratorFor};

pub fn banner() -> string {
    return "// GENERATED by onze build — do not edit.";
}

// ── the check ───────────────────────────────────────────────────────────────

pub fn checkTree(appDir: string, entries: Array<RouteEntry>) -> Array<string> {
    var out: string[] = [];
    for (entries) { e ->
        val f = classify(appDir, e.authoredPath);
        val seg = f?.segment ?? "";
        val needs = decoratorFor(e.kind) != "";
        val drift = needs && e.declared != seg;
        if (drift)
            out.push(
                e.authoredPath
                    + ": its decorator says \""
                    + e.declared
                    + "\" but the file lives at \""
                    + seg
                    + "\"",
            );
    }
    return out;
}

// ── staging ─────────────────────────────────────────────────────────────────

// The staged relative path of a source file (relative to the project's
// `src`): every directory staged, the file stem staged.
pub fn stagedPath(rel: string) -> string {
    val parts = rel.split("/");
    val dirs = parts.take(parts.length - 1).map({ d -> stagedSegment(d) });
    val file = parts.at(parts.length - 1) ?? "";
    val stem = if (file.endsWith(".bp"))
        stagedStem(file.slice(0, file.length() - 3)) + ".bp"
    else
        file;
    return dirs.append([stem]).join("/");
}

// `source` with every import `from "<alias>…"` written as the import of the
// module the alias names: a module of the application is imported by its path
// inside the braces (decision 206 — `from` names a package), so
// `import {x, y as z} from "@/lib.format";` stages as
// `import {lib.format.x, lib.format.y as z};`. An import written over several
// lines is read up to its `;`. A `from` no alias names is a package and stays.
pub fn rewriteImports(aliases: AliasMap, source: string) -> string {
    var out: string[] = [];
    var pending: string[] = [];
    for (source.split("\n")) { line ->
        if (pending.length > 0) {
            pending.push(line);
            if (line.indexOf(";") >= 0) {
                out.push(rewriteImport(aliases, pending.join("\n")));
                pending = [];
            }
        } else if (line.trimStart().startsWith("import {")
            && line.indexOf(";") < 0)
            pending.push(line)
        else
            out.push(rewriteImport(aliases, line));
    }
    return out.append(pending).join("\n");
}

fn rewriteImport(aliases: AliasMap, text: string) -> string {
    val marker = "from \"";
    val at = text.indexOf(marker);
    if (at < 0) return text;
    val rest = text.slice(at + marker.length());
    val close = rest.indexOf("\"");
    if (close < 0) return text;
    val spec = rest.slice(0, close);
    val resolved = resolveAlias(aliases, spec);
    if (resolved == spec) return text;
    val open = text.indexOf("{");
    val shut = text.slice(0, at).lastIndexOf("}");
    if (open < 0 || shut < open) return text;
    val prefix = resolved.replaceAll("/", ".") + ".";
    val inner = text.slice(open + 1, shut);
    val items = if (inner.indexOf("{") >= 0)
        [prefix.slice(0, prefix.length() - 1) + ": {" + inner.trim() + "}"]
    else
        inner
            .split(",")
            .map({ i -> i.trim() })
            .filter({ i -> i != "" })
            .map({ i -> prefix + i });
    val tail = rest.slice(close + 1);
    return text.slice(0, open)
        + "{"
        + items.join(", ")
        + "}"
        + tail.trimStart();
}

fn identOf(moduleId: string) -> string {
    return moduleId.replaceAll(".", "_");
}

// The `mod.bp` of every staged directory under `stagedApp` (e.g. `app`) that
// the staged file list does not already hold, as `#(path, text)`.
pub fn modFiles(
    stagedApp: string,
    stagedFiles: string[],
) -> Array<#(string, string)> {
    var dirs: string[] = [stagedApp];
    for (stagedFiles.filter({ f -> f.startsWith(stagedApp + "/") })) { f ->
        val parts = f.split("/");
        var i = 2;
        while (i < parts.length) {
            val d = parts.take(i).join("/");
            if (dirs.contains(d) == false) dirs.push(d);
            i = i + 1;
        }
    }
    var out: Array<#(string, string)> = [];
    for (sortedText(dirs)) { d ->
        val own = d + "/mod.bp";
        if (stagedFiles.contains(own) == false) {
            var children: string[] = [];
            for (dirs) { c ->
                if (path.dirname(c) == d) children.push(path.basename(c));
            }
            for (stagedFiles) { f ->
                val isChild = path.dirname(f) == d
                    && f.endsWith(".bp")
                    && path.basename(f) != "mod.bp";
                if (isChild)
                    children.push(
                        path
                            .basename(f)
                            .slice(0, path.basename(f).length() - 3),
                    );
            }
            val lines = sortedText(children).map({ c -> "pub mod " + c + ";" });
            out.push(#(own, banner() + "\n\n" + lines.join("\n") + "\n"));
        }
    }
    return out;
}

// The registrations of the conventions without a decorator, and one import
// of every decorated convention file (by its first public name, `staged` is
// the staged tree as `#(path under src/, text)`): a program importing this
// module runs the bodies of every module it imports first (decision 140); the
// decorated functions themselves are registered by `onze_main.bp` from
// `@TypeInfo.all` (decision 216). `routeModules()` answers how many app
// modules it imports. Each is a module of the staged package, so it
// is imported by its path inside the braces (decision 206).
pub fn routesModule(
    appDir: string,
    entries: Array<RouteEntry>,
    staged: Array<#(string, string)>,
) -> string {
    var imports: string[] = [];
    var vals: string[] = [];
    var decorated = 0;
    for (entries.filter({ e -> decoratorFor(e.kind) != "" })) { e ->
        val file = e.modulePath.replaceAll(".", "/") + ".bp";
        val text = staged
            .filter({ f -> f._0 == file })
            .map({ f -> f._1 })
            .join("");
        val first = publicNamesOf(text).at(0) ?? "";
        if (first != "") {
            imports.push(
                "import {"
                    + e.modulePath
                    + "."
                    + first
                    + " as onze_"
                    + identOf(e.modulePath)
                    + "};",
            );
            decorated = decorated + 1;
        }
    }
    for (entries) { e ->
        val f = classify(appDir, e.authoredPath);
        val seg = f?.segment ?? "";
        val local = identOf(e.modulePath);
        if (e.kind == "loading") {
            imports.push(
                "import {" + e.modulePath + ".Loading as " + local + "};",
            );
            vals.push(
                "val __onze_"
                    + local
                    + " = jhLoading("
                    + quote(seg)
                    + ", { -> "
                    + local
                    + "() });",
            );
        } else if (e.kind == "error") {
            imports.push(
                "import {" + e.modulePath + ".ErrorPage as " + local + "};",
            );
            vals.push(
                "val __onze_"
                    + local
                    + " = jhError("
                    + quote(seg)
                    + ", { info -> "
                    + local
                    + "(info) });",
            );
        } else if (e.kind == "not-found") {
            imports.push(
                "import {" + e.modulePath + ".NotFound as " + local + "};",
            );
            vals.push(
                "val __onze_"
                    + local
                    + " = jhNotFound("
                    + quote(seg)
                    + ", { -> "
                    + local
                    + "() });",
            );
        }
    }
    val count = decorated + vals.length;
    val head = [
        banner(),
        "",
        "import {jhLoading, jhError, jhNotFound, Element, ErrorInfo} from \"jhonstart\";",
    ];
    val tail = [
        "",
        "pub fn routeModules() -> i32 {",
        "    return " + count.toString() + ";",
        "}",
    ];
    return head
        .append(sortedText(imports))
        .append([""])
        .append(sortedText(vals))
        .append(tail)
        .join("\n")
        + "\n";
}

// The staged package's manifest: the project's own, `src` pointed at the
// staged tree, each relative `path` dependency made absolute against the
// project's `root` (the staged package may sit anywhere — `<root>/<outDir>/`,
// or an `outDir` outside the project), plus `extraDeps` as `#(name, absolute
// directory or git URL)`.
pub fn stagedManifest(
    manifest: string,
    files: string[],
    root: string,
    workspace: Array<#(string, string)>,
    extraDeps: Array<#(string, string)>,
) -> @Result<string, string> {
    val doc = try decode(manifest);
    val members = doc.members();
    var fields: string[] = [];
    for (members) { m ->
        if (m._0 == "src")
            fields.push(quote("src") + ": " + quote("src/"))
        else if (m._0 == "files")
            fields.push(
                quote("files")
                    + ": ["
                    + files.map({ f -> quote(f) }).join(", ")
                    + "]",
            )
        else if (m._0 == "entry")
            fields.push(quote("entry") + ": " + quote("root.bp"))
        else if (m._0 == "dependencies")
            fields.push(
                quote("dependencies")
                    + ": "
                    + rerootDeps(m._1, root, workspace, extraDeps),
            )
        else if (m._0 != "alias")
            fields.push(quote(m._0) + ": " + jsonText(m._1));
    }
    val hasFiles = members.any({ m -> m._0 == "files" });
    if (hasFiles == false)
        fields.push(
            quote("files")
                + ": ["
                + files.map({ f -> quote(f) }).join(", ")
                + "]",
        );
    val hasDeps = members.any({ m -> m._0 == "dependencies" });
    if (hasDeps == false && extraDeps.length > 0)
        fields.push(
            quote("dependencies")
                + ": "
                + rerootDeps(Json.Obj(members: []), root, workspace, extraDeps),
        );
    return "{\n  " + fields.join(",\n  ") + "\n}\n";
}

fn rerootDeps(
    v: Json,
    root: string,
    workspace: Array<#(string, string)>,
    extraDeps: Array<#(string, string)>,
) -> string {
    val deps = v.members();
    val own = deps.map(
        { m -> quote(m._0) + ": " + rerootDep(m._0, m._1, root, workspace) },
    );
    val extra = extraDeps
        .filter({ d -> deps.any({ m -> m._0 == d._0 }) == false })
        .map({ d -> quote(d._0) + ": " + extraDep(d._1) });
    return "{ " + own.append(extra).join(", ") + " }";
}

// An extra dependency's entry: a git URL (`https://…`) is `{ "git": …, "branch": "feat" }` —
// resolved by name through the library roots, as any git dependency —, else a
// directory, `{ "path": … }`.
fn extraDep(source: string) -> string {
    if (source.startsWith("https://"))
        return "{ \"git\": " + quote(source) + ", \"branch\": \"feat\" }";
    return "{ \"path\": " + quote(source) + " }";
}

// A `{ "workspace": true }` dependency becomes a `path` to the member the
// enclosing workspace names — the staged package is no workspace member.
fn rerootDep(
    name: string,
    v: Json,
    root: string,
    workspace: Array<#(string, string)>,
) -> string {
    val members = v.members();
    val isWorkspace = members.any({ m -> m._0 == "workspace" });
    val hit = workspace.filter({ w -> w._0 == name });
    if (isWorkspace && hit.length > 0) {
        val pair = hit.at(0) ?? #("", "");
        return "{ \"path\": " + quote(pair._1) + " }";
    }
    var fields: string[] = [];
    for (members) { m ->
        val value = if (m._0 == "path")
            quote(reroot(m._1.str(), root))
        else
            jsonText(m._1);
        fields.push(quote(m._0) + ": " + value);
    }
    return "{ " + fields.join(", ") + " }";
}

// A dependency path against the project root; an absolute one, or any when
// no root is given, as written.
fn reroot(p: string, root: string) -> string {
    return if (p.startsWith("/") || root == "")
        p
    else
        path.normalize(path.join([root, p]));
}

fn jsonText(v: Json) -> string {
    return case v {
        Null -> "null";
        Bool(value: b) -> if (b) "true" else "false";
        Num(value: n) -> n.toString();
        Str(value: s) -> quote(s);
        Arr(items: xs) -> "[" + xs.map({ x -> jsonText(x) }).join(", ") + "]";
        Obj(members: ms) -> "{ "
            + ms.map({ m -> quote(m._0) + ": " + jsonText(m._1) }).join(", ")
            + " }";
    };
}

pub fn sortedText(xs: string[]) -> string[] {
    var out: string[] = [];
    for (xs) { x ->
        var placed = false;
        var next: string[] = [];
        for (out) { y ->
            val before = placed == false && x < y;
            if (before) {
                next.push(x);
                placed = true;
            }
            next.push(y);
        }
        if (placed == false) next.push(x);
        out = next;
    }
    return out;
}

// The staged package: every source file of the project (`#(path relative to
// its src, text)`), staged and alias-rewritten, the generated `mod.bp`s, the
// routes module and the root. `appRel` is the app directory relative to the
// project's src (`app` for `src/app`). Answers `#(path under <outDir>/, text)`.
pub fn stage(
    aliases: AliasMap,
    appRel: string,
    appDir: string,
    sources: Array<#(string, string)>,
    entries: Array<RouteEntry>,
    manifest: string,
) -> @Result<Array<#(string, string)>, string> {
    return try stageAt(
        aliases,
        appRel,
        appDir,
        sources,
        entries,
        manifest,
        "",
        [],
        [],
        [],
    );
}

// `stage` for the project at `root` (its relative dependency paths made
// absolute against it), with `extraMods` declared by the root beside the app
// (a generated entry, the style modules, the server's main) and `extraDeps`
// added to the manifest.
pub fn stageAt(
    aliases: AliasMap,
    appRel: string,
    appDir: string,
    sources: Array<#(string, string)>,
    entries: Array<RouteEntry>,
    manifest: string,
    root: string,
    extraMods: string[],
    workspace: Array<#(string, string)>,
    extraDeps: Array<#(string, string)>,
) -> @Result<Array<#(string, string)>, string> {
    var staged: Array<#(string, string)> = [];
    var rootText = "";
    for (sources) { s ->
        val authoredAppMod = s._0.startsWith(appRel + "/")
            && s._0.endsWith("mod.bp")
            && (s._0 == appRel + "/mod.bp" || s._0.endsWith("/mod.bp"));
        if (s._0 == "root.bp")
            rootText = s._1
        else if (authoredAppMod)
            rootText = rootText
        else
            staged.push(#(stagedPath(s._0), rewriteImports(aliases, s._1)));
    }
    val stagedApp = stagedPath(appRel + "/x.bp")
        .split("/")
        .take(appRel.split("/").length)
        .join("/");
    val mods = modFiles(stagedApp, staged.map({ f -> f._0 }));
    val all = staged
        .append(mods)
        .append([#("onze_routes.bp", routesModule(appDir, entries, staged))]);
    val appTop = stagedApp.split("/").at(0) ?? "app";
    val declaresApp = rootText
        .split("\n")
        .any({ l -> l.trim() == "pub mod " + appTop + ";" });
    val appLine = if (declaresApp) "" else "pub mod " + appTop + ";\n";
    val extra = extraMods.map({ m -> "pub mod " + m + ";\n" }).join("");
    val rootModule = rootText.trimEnd()
        + "\n\n"
        + banner()
        + "\n"
        + appLine
        + "pub mod onze_routes;\n"
        + extra;
    val withRoot = all.append([#("root.bp", rootModule)]);
    val names = sortedText(withRoot.map({ f -> f._0 }));
    val manifestText = try stagedManifest(
        manifest,
        names,
        root,
        workspace,
        extraDeps,
    );
    var out: Array<#(string, string)> = withRoot.map(
        { f -> #("src/" + f._0, f._1) },
    );
    out.push(#("botopink.json", manifestText));
    return out;
}
