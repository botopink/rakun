//// Response assertions (front 19 step 2).
////
//// Each answers `true` or raises with the expected value, the actual value
//// and the status, so `assert expectStatus(res, 200);` fails with
//// `expected status 200, got 404, body: …` rather than a bare assertion.

import {Response} from "rakun";

pub fn expectStatus(res: Response, code: i32) -> bool {
    assert res.status == code, "expected status " + code.toString() + ", got " + res.status.toString() + ", body: " + res.body;
    return true;
}

pub fn expectBodyEquals(res: Response, body: string) -> bool {
    assert res.body == body, "expected body " + body + ", got " + res.body + " (status " + res.status.toString() + ")";
    return true;
}

pub fn expectBodyContains(res: Response, needle: string) -> bool {
    assert res.body.contains(needle), "expected the body to contain " + needle + ", got " + res.body + " (status " + res.status.toString() + ")";
    return true;
}

// A SUBSTRING CHECK over a known shape, not a JSON parse: it looks for the
// top-level member `"field":"value"` (a space after the colon allowed) in the
// body text. A nested member of the same name matches too, and a value that
// needs escaping must be passed escaped. Enough for a handler's flat object;
// a structured walk waits on a JSON value type in std.
pub fn expectJsonField(res: Response, field: string, value: string) -> bool {
    val tight = "\"" + field + "\":\"" + value + "\"";
    val spaced = "\"" + field + "\": \"" + value + "\"";
    assert res.body.contains(tight) || res.body.contains(spaced), "expected the JSON field " + field + " to be " + value + ", got " + res.body + " (status " + res.status.toString() + ")";
    return true;
}
