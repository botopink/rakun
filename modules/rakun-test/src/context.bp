//// Context control (front 19 step 4).
////
//// A test file's slice is its module graph — it registers what it imports.
//// These clear it: `resetSingletons` drops the instances and keeps the
//// registrations (the next resolution constructs afresh, `rkBuildCount` back
//// to 0); `resetContext` drops the registrations as well — scan registry,
//// route table, fallback, and every registry a member hung off `rkOnReset`
//// (the listener and task registries live in their own members).
//// `contextSnapshot` answers `{"scanned":[…],"routes":[…],"listeners":[…]}`
//// in registration order.
////
//// `botopink test` runs each test FILE in its own process, so a reset reaches
//// what that file registered and nothing another file did; after
//// `resetContext` a file registers again what its next test needs.

import {rkResetSingletons, rkResetContext, rkContextSnapshot} from "rakun";

pub fn resetSingletons() -> i32 {
    return rkResetSingletons();
}

pub fn resetContext() -> i32 {
    return rkResetContext();
}

pub fn contextSnapshot() -> string {
    return rkContextSnapshot();
}
