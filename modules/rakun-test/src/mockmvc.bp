//// `MockMvc` — in-process dispatch through the registered route table
//// (front 19 step 3). `perform` encodes the double's headers and query the
//// way the socket path does and calls `rkDispatchHttp`: the router matches,
//// binds the path parameters, and the handler runs with no socket opened. An
//// unregistered path answers the router's own 404.

import {Request, Response, HttpMethod, rkDispatchHttp} from "rakun";
import {FakeRequest, verbOf, pairsJson} from "fake_request";

pub type MockMvc(basePath: string) {
    pub fn standalone() -> MockMvc {
        return MockMvc(basePath: "");
    }

    pub fn under(basePath: string) -> MockMvc {
        return MockMvc(basePath: basePath);
    }

    pub fn perform(self: Self, req: FakeRequest) -> Response {
        return rkDispatchHttp(verbOf(req.method), self.basePath + req.path, pairsJson(req.wireHeaders()), pairsJson(req.queries), req.bodyText);
    }
}
