//// The `rakun-test` package — module-tree root.
////
//// The test-helper member every library carries (front 95,
//// `specs/1.0.10-beta/02-packaging/README.md` § 5): request doubles, MockMvc,
//// context control, the broker double and the `assert<Subject>(loc, …)
//// -> @Result<void, string>` snapshot helpers of every rakun member
//// (`specs/1.0.10-beta/03-rakun/modules.md` § What `rakun-test` exposes),
//// standing on std's asserts and snapshots. Its `pub` surface is empty until
//// front 19 and the fronts that add a subject fill it. A consumer adds
//// `"rakun-test"` to its dependencies; it never reaches into a member's own
//// `test/`. Nothing from std is re-exported, and mocking is std's
//// (decision 71) — this member keeps only the `#[mocks.mock]` + `#[bean]`
//// injection pairing.

import {toI32} from "rakun";

test "rakun-test: the core member resolves from the test member" {
    assert toI32("42") == 42;
}
