import {testing.asserts} from "std";
import {Response} from "rakun";
import {expectStatus, expectBodyEquals, expectBodyContains, expectJsonField} from "assertions";

test "rakun-test: each assertion answers true on success" {
    val res = Response.ok("{\"name\":\"ana\", \"city\": \"rio\"}");
    assert expectStatus(res, 200);
    assert expectBodyEquals(res, "{\"name\":\"ana\", \"city\": \"rio\"}");
    assert expectBodyContains(res, "ana");
    assert expectJsonField(res, "name", "ana");
    assert expectJsonField(res, "city", "rio");
}

test "rakun-test: expectStatus raises with expected, actual and the body" {
    try asserts.throwsWith({ ->
        val _x = expectStatus(Response.notFound(), 200);
        0;
    }, "expected status 200, got 404, body: ");
}

test "rakun-test: expectBodyEquals raises with both bodies and the status" {
    try asserts.throwsWith({ ->
        val _x = expectBodyEquals(Response.ok("got"), "want");
        0;
    }, "expected body want, got got (status 200)");
}

test "rakun-test: expectBodyContains raises with the needle, the body and the status" {
    try asserts.throwsWith({ ->
        val _x = expectBodyContains(Response.created("made"), "zzz");
        0;
    }, "expected the body to contain zzz, got made (status 201)");
}

test "rakun-test: expectJsonField raises with the field, the value, the body and the status" {
    try asserts.throwsWith({ ->
        val _x = expectJsonField(Response.ok("{\"name\":\"bob\"}"), "name", "ana");
        0;
    }, "expected the JSON field name to be ana, got ");
    try asserts.throwsWith({ ->
        val _x = expectJsonField(Response.withStatus(418, "{}"), "name", "ana");
        0;
    }, "(status 418)");
}
