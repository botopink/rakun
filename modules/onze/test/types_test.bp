// `botopink test` suite for `src/types.bp` (front 49 steps 3 and 6).

import {types.describeAppFiles, types.AliasMap, types.loadAliases, types.resolveAlias, types.describeAliases};
import {assertAs} from "snap";
import {conventions.fileKinds, conventions.classify} from "routing";

fn aliasError(r: @Result<AliasMap, string>) -> string {
    return case r {
        Ok(v) -> "ok";
        Error(message) -> "error: " + message;
    };
}

test "types: the eight routing conventions, no more, no fewer, in wrap order (routing)" {
    assert fileKinds().join(",")
        == "layout,template,error,loading,not-found,page,default,route";
}

test "types: the segment is the decorator argument, brackets and groups kept" {
    assert (classify("app", "app/blog/[slug]/page.bp")?.segment ?? "")
        == "blog/[slug]";
    assert (classify("app", "app/(marketing)/about/page.bp")?.segment ?? "")
        == "(marketing)/about";
    assert (classify("src/app", "src/app/page.bp")?.kind ?? "") == "page";
    assert classify("app", "app/_components/card.bp") == null;
    assert classify("app", "app/_private/page.bp") == null;
    assert classify("app", "lib/page.bp") == null;
}

test "types: app files ---- every routing convention and the group" {
    try assertAs(
        @src(),
        "app files",
        describeAppFiles(
            "app",
            [
                "app/page.bp",
                "app/layout.bp",
                "app/template.bp",
                "app/default.bp",
                "app/loading.bp",
                "app/error.bp",
                "app/not-found.bp",
                "app/blog/[slug]/page.bp",
                "app/(marketing)/about/page.bp",
                "app/api/posts/route.bp",
                "app/docs/[...rest]/page.bp",
                "app/_components/card.bp",
            ],
        ),
    );
}

test "alias: a spec with no matching prefix is returned unchanged" {
    val map = AliasMap(entries: [#("@/components", "components")]);
    assert resolveAlias(map, "@/components.post_card")
        == "components.post_card";
    assert resolveAlias(map, "jhonstart") == "jhonstart";
    assert resolveAlias(map, "@/componentsX.a") == "@/componentsX.a";
}

test "alias: longest prefix ---- @/lib and @/lib/db" {
    val map = try loadAliases(
        "{ \"name\": \"x\", \"alias\": { \"@/components\": \"components\", \"@/lib\": \"lib\", \"@/lib/db\": \"lib/store\" } }",
    );
    try assertAs(
        @src(),
        "aliases",
        describeAliases(
            map,
            [
                "@/components.post_card",
                "@/lib.actions",
                "@/lib/db.posts",
                "jhonstart",
            ],
        ),
    );
}

test "alias: escape ---- a target outside the root is refused at load" {
    val r = loadAliases(
        "{ \"name\": \"x\", \"alias\": { \"@/up\": \"..\", \"@/ok\": \"lib\" } }",
    );
    val abs = loadAliases(
        "{ \"name\": \"x\", \"alias\": { \"@/abs\": \"/etc\" } }",
    );
    val deep = loadAliases(
        "{ \"name\": \"x\", \"alias\": { \"@/deep\": \"lib/../../x\" } }",
    );
    val fine = loadAliases(
        "{ \"name\": \"x\", \"alias\": { \"@/fine\": \"lib/../components\" } }",
    );
    try assertAs(
        @src(),
        "errors",
        [
            aliasError(r),
            aliasError(abs),
            aliasError(deep),
            aliasError(fine),
        ].join("\n"),
    );
}
