// jhonstart/link — the anchor a client transition starts from (front 27 of
// 1.0.10-beta).
//
// Next.js splits `<Link>` into a render-time half and a runtime half. The
// render-time half emits an anchor with the props encoded on it; the runtime
// half, in the browser, intercepts the click, prefetches on viewport entry and
// performs the transition. jhonstart keeps that split, and it is what lets a
// client front render correctly during the server pass.
//
// **This file is the render-time half, and it is the half that exists.** It
// touches no host cell, so it produces the same anchor on every backend and
// every assertion in `test/link_test.bp` RUNS on both rows. The reason the
// 1.0.7 draft never became real — "`Link` must render `<a href=…>`, but the
// `Element` model is `tag`/`value`/`children` with NO attribute slot"
// (`router.d.bp:12-15`) — expired: `element.bp:7` carries
// `attrs: Array<#(string, string)>` and `renderToString` emits every pair.
//
// ── The browser half: four cells, both targets ──────────────────────────────
//
// `__jhLinkMount()`, `__jhLinkPrefetch(href, mode)`, `__jhLinkStatus()` and
// `__jhLinkRouteKind(href)` are declared at the foot of this file over
// `./link_runtime.mjs`, each with an erlang twin in
// `sidecars/jhonstart_link.erl` that answers the server's truth (no link in
// flight, nothing prefetched, the kind unknown). They are dual-target, not
// node-only: this member declares both targets, and a CALLED node-only cell
// reds the erlang compile at its caller — the `modules.md` § 4 row, settled
// as its first option (`decisions-pending.md` 27-a). `linkMount()` is the
// ordinary import onze front 68's entry calls once; `linkStatus()` is the hook.

// ── Why the props are a record ──────────────────────────────────────────────
//
// The props are one record, `linkProps(href)` fills Next's documented
// defaults, and overriding one is `withPrefetch(props, false)` — a helper
// returning a NEW record (a record is immutable), written with the update form
// `LinkProps(..p, prefetch: prefetch)`. The call site is
// `Link(withPrefetch(linkProps(href), false), children)`: the anchor reads its
// options from one value, and a consumer that changes several at once writes
// the update form itself (`val base = linkProps(href);`,
// `LinkProps(..base, replace: true, scroll: false)`).

import {Element, ElementBase} from "jhonstart";

// ── step 1: the props, and the constructor that fills Next's defaults ───────
//
// Six fields. `prefetch`/`replace`/`scroll` are Next's three documented
// booleans with Next's documented defaults; `target` and `className` are the
// only two arbitrary attributes a link may set, and they are FIELDS rather
// than a pass-through `attrs` list on purpose — an anchor that accepts any
// attribute is an anchor that can be handed its own `data-jh-l`, and the
// browser half queries on exactly that marker.
pub type LinkProps(
    href: string,
    prefetch: bool,
    replace: bool,
    scroll: bool,
    target: string,
    className: string,
)

// Next's defaults, verbatim: prefetch on, replace off, scroll on, no target,
// no class.
pub fn linkProps(href: string) -> LinkProps {
    return LinkProps(
        href: href,
        prefetch: true,
        replace: false,
        scroll: true,
        target: "",
        className: "",
    );
}

// The five copy-with-one-field helpers, each the record update form. None of
// them assigns to a field of its argument.
pub fn withPrefetch(p: LinkProps, prefetch: bool) -> LinkProps {
    return LinkProps(..p, prefetch: prefetch);
}

pub fn withReplace(p: LinkProps, replace: bool) -> LinkProps {
    return LinkProps(..p, replace: replace);
}

pub fn withScroll(p: LinkProps, scroll: bool) -> LinkProps {
    return LinkProps(..p, scroll: scroll);
}

pub fn withTarget(p: LinkProps, target: string) -> LinkProps {
    return LinkProps(..p, target: target);
}

pub fn withClass(p: LinkProps, className: string) -> LinkProps {
    return LinkProps(..p, className: className);
}

// ── step 2: the anchor ──────────────────────────────────────────────────────
//
// The props travel to the browser as `data-` attributes ON THE ANCHOR. There
// is no second channel and no registry the server has to serialize: the
// runtime half queries `[data-jh-l]` and reads the rest off the element it
// found.
//
// An attribute is emitted only when it DIFFERS from the default, so the common
// link is `<a href="/blog" data-jh-l="1">Blog</a>` and a page with two
// hundred links does not carry five redundant pairs on each of them.
//
//   | prop        | attribute                | emitted when          |
//   |-------------|--------------------------|-----------------------|
//   | `href`      | `href="…"`               | always                |
//   | —           | `data-jh-l="1"`        | always — the marker   |
//   | `prefetch`  | `data-jh-prefetch="0"` | only when `false`     |
//   | `replace`   | `data-jh-replace="1"`  | only when `true`      |
//   | `scroll`    | `data-jh-scroll="0"`   | only when `false`     |
//   | `target`    | `target="…"`             | only when non-empty   |
//   | `className` | `class="…"`              | only when non-empty   |
//
// `data-jh-` is the milestone's marker family (`contracts.md § 2`); this
// front owns the link markers inside it and adds no other vocabulary.
//
// A plain `-> Element`: `Link` activates no hook, so it is an ordinary function
// (decisions 104 and 118 of botopink 1.0.10-beta — only a body that writes `use`
// returns `@Component<_>`), and a component that renders it calls it
// synchronously.
pub fn Link(props: LinkProps, children: Children) -> Element {
    var pairs: Array<#(string, string)> = [
        #("href", props.href),
        #("data-jh-l", "1"),
    ];
    if (props.prefetch == false)
        pairs = pairs.append([#("data-jh-prefetch", "0")]);
    if (props.replace) pairs = pairs.append([#("data-jh-replace", "1")]);
    if (props.scroll == false) pairs = pairs.append([#("data-jh-scroll", "0")]);
    if (props.target != "") pairs = pairs.append([#("target", props.target)]);
    if (props.className != "")
        pairs = pairs.append([#("class", props.className)]);
    return Element(tag: "a", value: "", children: children, attrs: pairs);
}

// ── step 3: the prefetch decision, and the layout key ───────────────────────
//
// `NEXTJS-DOCS.md § 8` *Prefetching* states the rule and this is it literally,
// as a PURE function so that it is testable without a browser:
//
//   | route kind | `loading` boundary | mode      |
//   |------------|--------------------|-----------|
//   | static     | —                  | `full`    |
//   | dynamic    | yes                | `partial` |
//   | dynamic    | no                 | `skip`    |
//   | any        | `prefetch: false`  | `skip`    |
//
// `kind` and `hasLoading` both come from front 60's route-kind table, which is
// why this front depends on it read-only and owns none of it. An unknown kind
// is NOT static, so it falls through to the `hasLoading` question and answers
// `skip` when there is no boundary — the conservative answer, which is the one
// a missing table should produce.
pub fn prefetchMode(kind: string, hasLoading: bool, requested: bool) -> string {
    if (requested == false) return "skip";
    if (kind == "static") return "full";
    if (hasLoading) return "partial";
    return "skip";
}

// A layout is keyed by its SEGMENT PATH — the `/`-joined prefix of the route's
// segments down to that layout's depth — and never by its position in the
// tree. Two routes under `/docs` produce the same key `"/docs"` for the docs
// layout, so a transition between them reuses it; a route under `/blog`
// produces `"/blog"` and the docs layout is unmounted. That is what keeps a
// sidebar's scroll position and every client component's state inside a shared
// layout across a navigation (`NEXTJS-DOCS.md § 5`, *Preservam estado entre
// navegações*).
//
// `segments` is front 26's `RouterState.segments()` — derived from the matched
// pattern — so the key a client transition computes and the key the server
// rendered under are the same string. The root layout is depth 0 and its key
// is `"/"`.
//
// A depth past the end of the list is the whole list rather than a raise:
// `take` is total on both rows (measured).
pub fn layoutKey(segments: Array<string>, depth: i32) -> string {
    return "/" + segments.take(depth).join("/");
}

// ── step 4: the in-flight status ────────────────────────────────────────────
//
// `LinkStatus` is what a link renders a spinner from while its OWN navigation
// is in flight. The browser half answers the in-flight href — `""` when idle —
// and `linkStatusOf` is the whole derivation from it.
pub type LinkStatus(pending: bool, href: string)

pub fn linkStatusOf(href: string) -> LinkStatus {
    return LinkStatus(pending: href != "", href: href);
}

// ── step 4: the browser cells ───────────────────────────────────────────────

#[@External.Node("./link_runtime.mjs", "mount")]
#[@External.Erlang("jhonstart_link", "mount")]
declare fn __jhLinkMount() -> i32;

#[@External.Node("./link_runtime.mjs", "prefetch")]
#[@External.Erlang("jhonstart_link", "prefetch")]
pub declare fn __jhLinkPrefetch(href: string, mode: string) -> i32;

#[@External.Node("./link_runtime.mjs", "status")]
#[@External.Erlang("jhonstart_link", "status")]
declare fn __jhLinkStatus() -> string;

#[@External.Node("./link_runtime.mjs", "routeKind")]
#[@External.Erlang("jhonstart_link", "route_kind")]
declare fn __jhLinkRouteKind(href: string) -> string;

// Delegated click interception and the viewport prefetcher, installed once —
// a second call registers nothing and answers the same count.
pub fn linkMount() -> i32 {
    return __jhLinkMount();
}

// Warms the client route cache for `href` in the mode `prefetchMode` decided;
// `"skip"` does nothing.
pub fn linkPrefetch(href: string, mode: string) -> i32 {
    return __jhLinkPrefetch(href, mode);
}

// The kind front 60's table gives the route `href` resolves to — `"static"`,
// `"dynamic"` or `"unknown"`; never recomputed here.
pub fn linkRouteKind(href: string) -> string {
    return __jhLinkRouteKind(href);
}

// The hook: `val s = use linkStatus()`, read only inside a `#[client]`
// component (decision 363 (1)) — the browser's island; a server-rendered
// `Link` reads no hook, its pending state is the `data-jh-pending` attribute
// `reconcile.bp`'s driver has the entry set on the active link (363 (4)).
// The `#[clientOnly]` marker and the deletion of the erlang twin wait on
// `05-jhonstart/26` step 8's markers (`01-checker` step 23's `Decl.hooks`);
// until then the refusal of a `use` outside a `#[client]` component is not
// checked.
pub fn linkStatus() -> @Component<LinkStatus> {
    return linkStatusOf(__jhLinkStatus());
}
