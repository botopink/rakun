//// emilia/attributes — front 48: the class-name contract and the merge.
////
//// THE CONTRACT (`contracts.md § 4`, word for word where they overlap): **a
//// consumer's element's emilia class is `e_<hex>`, where `<hex>` is the
//// lowercase hexadecimal djb2-33 fold (seed 5381, masked to 32 bits) of
//// `encodeSheet(tokensToSheet(tokens, theme))`, and `tokens` is the element's
//// token list in author order. Nothing else enters the hash. When a static
//// class is also present, the `class` attribute value is `<static> + " " +
//// <emilia class>` — static first, one ASCII space, no de-duplication, no
//// sorting.** Six clauses, each a test in `emilia.bp` under the front 48 banner:
////
////   1. a pure function of the token list AND THE THEME — no counter, no salt;
////   1b. the theme is an input: the server and the client take ONE `Theme`
////       value, or they compute two classes with no other symptom;
////   2. token order is class identity;
////   3. ASCII-only rule bodies — the JS cell folds UTF-16 units and the erlang
////      cell codepoints, so a non-ASCII payload is REFUSED at the call rather
////      than handed out as a class the two halves disagree on;
////   4. the merge is static-first, one space, and `mergeClass` below is its ONE
////      implementation in the workspace;
////   5. attribute order is argument order — the slot appends, never prepends.
////
//// WHERE THE SLOT LIVES. `className`, `styled`, `styledWith`, `cls` and
//// `clsWith` hash a sheet, so they are in `emilia.bp` beside the hash: a
//// sibling module importing `from "rakun-stylesheet"` compiles alone and does not
//// resolve when emilia is a dependency (emilia `AGENTS.md`, § Maintainer
//// rules). This module holds the two pure pieces — the merge and the ASCII
//// check — and imports nothing.
////
//// THE CLASS-NAME VALUE IS A PLAIN STRING: `e_<hex>`, or `<static>`, one
//// space and `e_<hex>` after the merge. A consumer places it as an element's
//// `class` attribute value as is; emilia spells no template surface.

// The merge, spelled once. `mergeClass("", b)` is `b`; `mergeClass(a, "")` is
// `a`; otherwise `a + " " + b`. No de-duplication, no sorting, no trimming of
// the base's interior spaces.
pub fn mergeClass(base: string, extra: string) -> string {
    val joined = base + " " + extra;
    val withBase = if (extra == "") base else joined;
    val out = if (base == "") extra else withBase;
    return out;
}

fn printableAscii() -> string {
    return " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~\t\n\r";
}

// Every character of `body` outside printable ASCII (and the codec's three
// separators), in order — "" for an ASCII body. Written by REMOVING each
// allowed character rather than by splitting `body` into characters:
// `"a→b".split("")` answers `["a"]` on erlang (everything from the first
// non-ASCII codepoint on is lost — a compiler finding), which would pass the
// very payload this check exists to stop. The allowed set is ASCII, so
// splitting IT is safe on both targets.
pub fn nonAsciiIn(body: string) -> string {
    return printableAscii()
        .split("")
        .fold(body, { acc, c -> acc.split(c).join("") });
}

// ── front 48 · tests (the pure half; the slot's are in `emilia.bp`) ──────────

test "mergeClass — static first, one space, never a leading or trailing one" {
    assert mergeClass("card", "e_abc") == "card e_abc";
    assert mergeClass("", "e_abc") == "e_abc";
    assert mergeClass("card", "") == "card";
    assert mergeClass("", "") == "";
}

test "mergeClass — no sorting, no de-duplication, interior spaces kept" {
    assert mergeClass("a  b", "e_x") == "a  b e_x";
    assert mergeClass("e_x", "e_x") == "e_x e_x";
    assert mergeClass("z", "a") == "z a";
}

test "nonAsciiIn — empty for ASCII, the offending text otherwise" {
    assert nonAsciiIn("content:\"\";color:var(--color-red-500)") == "";
    assert nonAsciiIn("R\tutilities\n") == "";
    assert nonAsciiIn("content:\"→\"") != "";
    assert nonAsciiIn("font-family:Ünïcode") != "";
}
