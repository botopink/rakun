//// emilia/preflight — front 55: the reset Tailwind's utilities are designed
//// against, as `base`-layer rules with literal selectors.
////
//// WHAT THIS MODULE CLAIMS, AND WHAT IT DOES NOT. `§ 4` of the reference lists
//// what preflight does in eight bullets and prints no stylesheet. The rules
//// below cover those eight bullets — one rule per concern, so each is testable
//// on its own — and claim PARITY WITH `§ 4`, not byte-equality with upstream's
//// `preflight.css`, which the reference does not print. The selector grouping
//// is emilia's.
////
//// ONE ADDITION IS A DECISION, NOT A TRANSCRIPTION: rule 1 carries
//// `border-style:solid` beside `border-width:0`. `§ 4` names only the width,
//// but a zero width over the browser's default `border-style: none` leaves
//// every `Border.W.*` token of front 40 inert — `border-width:1px` onto
//// `none` draws nothing — which is the defect this front exists to stop.
////
//// THE OPT-OUT IS AN ARGUMENT. `defaultOptions()` carries `base: []`, so a
//// document has no reset unless the caller passes one:
//// `withBase(defaultOptions(), preflightRules())`. emilia renders into a page
//// it does not own, and a library that silently resets the host's `h1`
//// margins is worse than one that makes you ask. There is no field, file,
//// environment variable or global toggle that turns it on otherwise.
////
//// This module declares no externals and imports only `output` and `theme`.
//// The three tests that flush a real document live in `emilia.bp` under a
//// front 55 banner: a sibling module that imports `from "rakun-stylesheet"` compiles
//// alone and does NOT resolve when emilia is a dependency (§ Maintainer rules).

import {output.Rule, output.Options, output.defaultOptions, output.renderRule};
import {output.withBase, output.withTheme, output.renderDocument, output.encodeSheet, output.declSheet};
import {theme.Theme, theme.ThemeEntry, theme.DarkMode, theme.emptyTheme};
import {failure.panic} from "std";

fn baseRule(selector: string, declarations: string) -> Rule {
    val none: string[] = [];
    return Rule(layer: "base", atRules: none, selector: selector, declarations: declarations, important: false);
}

// The eleven rules, in the order they render. Bullet by bullet (`§ 4`):
// box-sizing on everything → 1; margins off headings and lists → 4, 5, 6;
// links without decoration → 7; images `display:block` → 8 (and 9 keeps them
// inside their container); borders at width 0 → 1; `line-height:1.5` on
// `html` → 2; fonts inherited by form controls → 10; `content:""` on
// `::before`/`::after` → 11. Rule 3 (`body{margin:0}`) is the margin bullet
// applied to the document itself.
pub fn preflightRules() -> Rule[] {
    val out: Rule[] = [
        baseRule("*,::before,::after", "box-sizing:border-box;border-width:0;border-style:solid"),
        baseRule("html", "line-height:1.5;-webkit-text-size-adjust:100%;tab-size:4"),
        baseRule("body", "margin:0"),
        baseRule("h1,h2,h3,h4,h5,h6", "font-size:inherit;font-weight:inherit;margin:0"),
        baseRule("p,blockquote,figure,pre,dl,dd,hr", "margin:0"),
        baseRule("ol,ul,menu", "list-style:none;margin:0;padding:0"),
        baseRule("a", "color:inherit;text-decoration:inherit"),
        baseRule("img,svg,video,canvas,audio,iframe,embed,object", "display:block;vertical-align:middle"),
        baseRule("img,video", "max-width:100%;height:auto"),
        baseRule("button,input,select,optgroup,textarea", "font:inherit;color:inherit;margin:0;padding:0;background-color:transparent"),
        baseRule("::before,::after", "content:\"\""),
    ];
    return out;
}

// The same eleven rules as a plain CSS FRAGMENT — no `<style>`, no `@layer` —
// for a consumer shipping a static `reset.css`. The selectors carry no `&`, so
// the class name (and any prefix) never reaches them.
pub fn preflight() -> string {
    return preflightRules()
        .map({ r -> renderRule("", r, defaultOptions()) })
        .join("");
}

// ── front 55 · tests ─────────────────────────────────────────────────────────
//
// Parity with `§ 4`'s eight bullets, NOT byte-equality with upstream
// `preflight.css` (see the module header). Every assertion runs on commonJS and
// on erlang; the reset is a constant string, so a difference between targets
// would be a renderer divergence.
//
// THE AMBIENT-SWITCH CHECK, recorded as the step-5 box asks: `grep -rn
// preflight modules/rakun-stylesheet/src` finds this module, the `output.bp` comments that
// name front 55, and no field, file, environment read or global cell that turns
// the reset on without `withBase(…, preflightRules())`.

fn noTheme() -> Options {
    return withTheme(defaultOptions(), emptyTheme());
}

fn ruleFor(selector: string) -> string {
    val hits = preflightRules().filter({ r -> r.selector == selector });
    val hit = hits.at(0);
    if (hit == null)
        panic("ruleFor: preflight has no rule for `" + selector + "`");
    return hit.declarations;
}

test "preflight — eleven rules, every one in the base layer with no at-rule" {
    val rs = preflightRules();
    assert rs.length == 11;
    assert rs.filter({ r -> r.layer == "base" }).length == 11;
    assert rs.filter({ r -> r.atRules.length == 0 }).length == 11;
    assert rs.filter({ r -> r.important == false }).length == 11;
}

test "preflight — no selector carries `&`, so a prefix never reaches one" {
    assert preflightRules().filter({ r -> r.selector.indexOf("&") != -1 }).length
        == 0;
}

// The eight bullets of `§ 4`, each named and each found.
test "preflight — box-sizing: border-box on every element (`§ 4` bullet 1)" {
    assert ruleFor("*,::before,::after").startsWith("box-sizing:border-box");
}

test "preflight — margins removed from headings and lists (`§ 4` bullet 2)" {
    assert ruleFor("h1,h2,h3,h4,h5,h6").indexOf("margin:0") != -1;
    assert ruleFor("p,blockquote,figure,pre,dl,dd,hr") == "margin:0";
    assert ruleFor("ol,ul,menu") == "list-style:none;margin:0;padding:0";
}

test "preflight — links without text decoration (`§ 4` bullet 3)" {
    assert ruleFor("a") == "color:inherit;text-decoration:inherit";
}

test "preflight — images display: block (`§ 4` bullet 4)" {
    assert ruleFor("img,svg,video,canvas,audio,iframe,embed,object")
        == "display:block;vertical-align:middle";
}

test "preflight — borders at border-width: 0, and solid (`§ 4` bullet 5)" {
    assert ruleFor("*,::before,::after")
        == "box-sizing:border-box;border-width:0;border-style:solid";
}

test "preflight — line-height: 1.5 on html (`§ 4` bullet 6)" {
    assert ruleFor("html").startsWith("line-height:1.5");
}

test "preflight — fonts inherited by form controls (`§ 4` bullet 7)" {
    assert ruleFor("button,input,select,optgroup,textarea").startsWith("font:inherit;");
}

test "preflight — content: \"\" on ::before and ::after, once (`§ 4` bullet 8)" {
    assert ruleFor("::before,::after") == "content:\"\"";
    assert preflightRules().filter({ r -> r.declarations.indexOf("content:") != -1 }).length
        == 1;
}

// ── step 2 · `border` means what it means in Tailwind ────────────────────────

test "preflight — border-style:solid precedes every utilities body" {
    val o = withBase(noTheme(), preflightRules());
    val doc = renderDocument("e_1\t"
        + encodeSheet(declSheet("border-width:1px")), o);
    assert doc.indexOf("border-style:solid") != -1;
    assert doc.indexOf("border-style:solid") < doc.indexOf("@layer utilities");
}

// ── step 4 · the rendered form ───────────────────────────────────────────────

test "preflight() — a fragment that starts with the box-sizing rule" {
    val css = preflight();
    assert css.startsWith("*,::before,::after{box-sizing:border-box");
    assert css.indexOf("@layer") == -1;
    assert css.indexOf("<style>") == -1;
    assert css.endsWith("::before,::after{content:\"\"}");
}

// Byte-identical on both targets: pinned as a literal both must produce.
test "preflight() — the whole fragment, as one literal" {
    assert preflight()
        == "*,::before,::after{box-sizing:border-box;border-width:0;border-style:solid}html{line-height:1.5;-webkit-text-size-adjust:100%;tab-size:4}body{margin:0}h1,h2,h3,h4,h5,h6{font-size:inherit;font-weight:inherit;margin:0}p,blockquote,figure,pre,dl,dd,hr{margin:0}ol,ul,menu{list-style:none;margin:0;padding:0}a{color:inherit;text-decoration:inherit}img,svg,video,canvas,audio,iframe,embed,object{display:block;vertical-align:middle}img,video{max-width:100%;height:auto}button,input,select,optgroup,textarea{font:inherit;color:inherit;margin:0;padding:0;background-color:transparent}::before,::after{content:\"\"}";
}

// ── step 5 · the opt-out, stated once ────────────────────────────────────────

test "preflight — off by default, on when passed, off again when removed" {
    val none: Rule[] = [];
    val payload = "e_1\t" + encodeSheet(declSheet("color:red"));
    assert renderDocument(payload, defaultOptions()).indexOf("@layer base")
        == -1;
    val on = withBase(defaultOptions(), preflightRules());
    assert renderDocument(payload, on).indexOf("@layer base{*,::before,::after{")
        != -1;
    assert renderDocument(payload, withBase(on, none)).indexOf("@layer base")
        == -1;
}
