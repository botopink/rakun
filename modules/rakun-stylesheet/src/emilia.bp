// The zero steps are a bare `0`, and the axis pairs keep their order.
test "Interact.Scroll — bare zero, left before right, top before bottom" {
    assert tokenDeclarations(.Interact.Scroll.M.__0) == "scroll-margin:0";
    assert tokenDeclarations(.Interact.Scroll.P.__0) == "scroll-padding:0";
    assert tokenDeclarations(.Interact.Scroll.Mx.__4)
        == "scroll-margin-left:calc(var(--spacing) * 4);scroll-margin-right:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Interact.Scroll.My.__4)
        == "scroll-margin-top:calc(var(--spacing) * 4);scroll-margin-bottom:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Interact.Scroll.Mt.__4)
        == "scroll-margin-top:" + spacing(4);
}

