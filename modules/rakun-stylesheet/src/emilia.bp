        Mist(_inner) -> "border-color:"
            + paletteVar("mist", divideColorMistShade(_inner));
        Taupe(_inner) -> "border-color:"
            + paletteVar("taupe", divideColorTaupeShade(_inner));
        White -> "border-color:" + themeVar(nsPrefix(Ns.Color) + "white");
        Black -> "border-color:" + themeVar(nsPrefix(Ns.Color) + "black");
        Transparent -> "border-color:transparent";
        Current -> "border-color:currentColor";
        Inherit -> "border-color:inherit";
    };
    return out;
}

