fn front38FontLeaves() -> Token[] {
    val leaves: Token[] = [
        .Font.Sans,
        .Font.Serif,
        .Font.Mono,
        .Font.Weight.Thin,
        .Font.Weight.Extralight,
        .Font.Weight.Light,
        .Font.Weight.Normal,
        .Font.Weight.Medium,
        .Font.Weight.Semibold,
        .Font.Weight.Bold,
        .Font.Weight.Extrabold,
        .Font.Weight.Black,
        .Font.Smoothing.Antialiased,
        .Font.Smoothing.Subpixel,
        .Font.Style.Italic,
        .Font.Style.Normal,
        .Font.Stretch.UltraCondensed,
        .Font.Stretch.ExtraCondensed,
        .Font.Stretch.Condensed,
        .Font.Stretch.SemiCondensed,
        .Font.Stretch.Normal,
        .Font.Stretch.SemiExpanded,
        .Font.Stretch.Expanded,
        .Font.Stretch.ExtraExpanded,
        .Font.Stretch.UltraExpanded,
        .Font.Nums.Normal,
        .Font.Nums.Ordinal,
        .Font.Nums.SlashedZero,
        .Font.Nums.Lining,
        .Font.Nums.Oldstyle,
        .Font.Nums.Proportional,
        .Font.Nums.Tabular,
        .Font.Nums.DiagonalFractions,
        .Font.Nums.StackedFractions,
    ];
    return leaves;
}

fn front38ListLeaves() -> Token[] {
    val leaves: Token[] = [
        .List.None,
        .List.Disc,
        .List.Decimal,
        .List.Inside,
        .List.Outside,
        .List.ImageNone,
    ];
    return leaves;
}

fn front38Leaves() -> Token[] {
    return front38TextLeaves()
        .append(front38FontLeaves())
        .append(front38ListLeaves());
}

// No leaf of this front may resolve a font size, a leading, a tracking or a
// colour. `px` is NOT in the probe: a decoration thickness and an underline
// offset are `px` counts in the reference itself (`§ 9.20`, `§ 9.21`), so
// banning it would ban a row upstream prints.
fn f38CarriesNoLiteral(decl: string) -> bool {
    return decl.indexOf("rem") == -1
        && decl.indexOf("#") == -1
        && decl.indexOf("oklch(") == -1
        && decl.indexOf("rgb(") == -1
        && decl.indexOf("ui-sans-serif") == -1;
}

// The tracking and leading values, spelled as the reference spells them. A
// resolved `letter-spacing:-0.025em` would be invisible to the probe above —
// `em` cannot be banned outright, because `font-stretch:semi-condensed` carries
// one — so the six values and the five are named.
fn f38ResolvesNoTrackOrLead(decl: string) -> bool {
    return decl.indexOf("0.05em") == -1
        && decl.indexOf("0.025em") == -1
        && decl.indexOf("0em") == -1
        && decl.indexOf("0.1em") == -1
        && decl.indexOf("1.25") == -1
        && decl.indexOf("1.375") == -1
        && decl.indexOf("1.625") == -1;
}

fn f38IsWellFormed(decl: string) -> bool {
    return decl.length > 0 && decl.indexOf(":") != -1;
}

// A Tailwind CLASS NAME where a CSS value belongs. Every fragment below is
// one no legitimate declaration of this front can contain — `tracking-tight`
// and `text-xs` are NOT usable here, because `var(--tracking-tight)` and
// `var(--text-xs)` carry them legitimately, and a probe that fires on correct
// output is a probe that gets deleted.
fn f38CarriesNoClassFragment(decl: string) -> bool {
    return decl.indexOf("font-thin") == -1
        && decl.indexOf("not-italic") == -1
        && decl.indexOf("normal-nums") == -1
        && decl.indexOf("text-balance") == -1
        && decl.indexOf("line-clamp-3") == -1
        && decl.indexOf("list-disc") == -1
        && decl.indexOf("decoration-dotted") == -1
        && decl.indexOf("underline-offset-2") == -1
        && decl.indexOf("break-words") == -1
        && decl.indexOf("indent-8") == -1
        && decl.indexOf("whitespace-pre") == -1
        && decl.indexOf("align-middle") == -1;
}

test "regression — 437 leaves, and every one declares something well formed" {
    val leaves = front38Leaves();
    assert front38TextLeaves().length == 397;
    assert front38FontLeaves().length == 34;
    assert front38ListLeaves().length == 6;
    assert leaves.length == 437;
    assert leaves.all({ t -> f38IsWellFormed(tokenDeclarations(t)) });
}

test "regression — no leaf of this front resolves a size, a leading or a colour" {
    val leaves = front38Leaves();
    assert leaves.all({ t -> f38CarriesNoLiteral(tokenDeclarations(t)) });
    assert leaves.all({ t -> f38ResolvesNoTrackOrLead(tokenDeclarations(t)) });
}

test "regression — no leaf of this front emits a Tailwind class fragment" {
    val leaves = front38Leaves();
    assert leaves.all({ t -> f38CarriesNoClassFragment(tokenDeclarations(t)) });
}

test "regression — the three probes discriminate" {
    // THE CONTROLS THAT MUST FAIL. Front 38 deleted the library's last
    // resolved `rem`, so the literal control is a hand-built declaration —
    // there is no longer a real token that can supply one.
    assert f38CarriesNoLiteral("font-size:1.125rem") == false;
    assert f38CarriesNoLiteral("font-family:ui-sans-serif,system-ui,sans-serif")
        == false;
    assert f38CarriesNoLiteral(tokenDeclarations(.Bg.White)) == false;
    assert f38CarriesNoLiteral(tokenDeclarations(.Text.Size.Lg));
    assert f38ResolvesNoTrackOrLead("letter-spacing:-0.025em") == false;
    assert f38ResolvesNoTrackOrLead("line-height:1.625") == false;
    assert f38ResolvesNoTrackOrLead(tokenDeclarations(.Text.Tracking.Tight));
    assert f38IsWellFormed("") == false;
    assert f38IsWellFormed("font-weight") == false;
    assert f38IsWellFormed("font-weight:700");
    assert f38CarriesNoClassFragment("list-style-type:list-disc") == false;
    assert f38CarriesNoClassFragment("text-decoration-style:decoration-dotted")
        == false;
    assert f38CarriesNoClassFragment("text-wrap:text-balance") == false;
    // and it does NOT fire on correct output, which is the half a probe of
    // this shape usually gets wrong:
    assert f38CarriesNoClassFragment("letter-spacing:var(--tracking-tight)");
    assert f38CarriesNoClassFragment("line-height:var(--leading-relaxed)");
    assert f38CarriesNoClassFragment(
        "font-size:var(--text-xs);line-height:var(--text-xs--line-height)",
    );
}

test "regression — the walk fails when a literal is planted in it" {
    // Run rather than described: one stray literal token appended to the real
    // list, and the whole walk asserted to FAIL. `.Bg.White` is front 39's and
    // still spells `background:#ffffff`.
    val strays: Token[] = [.Bg.White];
    val planted: Token[] = front38Leaves().append(strays);
    assert planted.length == 438;
    assert planted.all({ t -> f38CarriesNoLiteral(tokenDeclarations(t)) })
        == false;
    assert front38Leaves().all(
        { t -> f38CarriesNoLiteral(tokenDeclarations(t)) },
    );
}

test "regression — every decoration colour cell is a reference, and all 286 differ" {
    val leaves = front38TextLeaves();
    // 286 grid cells plus `White` and `Black`, which reference the theme the
    // way front 33's `Color.White`/`Black` do.
    val cells = leaves.filter(
        { t -> tokenDeclarations(t).indexOf("text-decoration-color:var(--color-") != -1 },
    );
    assert cells.length == 288;
    val decls = cells.map({ t -> tokenDeclarations(t) });
    // Duplicates are counted rather than looked up backwards (§ Maintainer
    // rules, `Array.lastIndexOf`). A discarded shade
    // is what this catches — the literal probe alone does not.
    val dupes = decls.filter({ d -> decls.filter({ x -> x == d }).length > 1 });
    assert dupes.length == 0;
}

// ── end front 38 ─────────────────────────────────────────────────────────────

// FRONT 39 OWNS THIS DISPATCHER; front 33 owns the `Color` arm and the theme
// parameter it needs. The four legacy leaves below keep their pre-33 output —
// the `background` SHORTHAND, and a shade the arm discards — so nothing that
// compiled before this front changed meaning. Upstream emits
// `background-color` (`§ 10.3`), which is what the new `Color` sub-section
// emits and what front 39 folds these four into when it lands.
fn bgTokenToCss(t: Token.Bg, th: Theme) -> string {
    val out = case t {
        Color(_inner) -> bgColorTokenToCss(_inner, th);
        Red(_inner) -> "background:red";
        Blue(_inner) -> "background:blue";
        Gray(_inner) -> "background:gray";
        White -> "background:#ffffff";
        Black -> "background:#000000";
        Hex(value) -> "background:" + value;
        Attachment(_inner) -> bgAttachmentTokenToCss(_inner, th);
        Clip(_inner) -> bgClipTokenToCss(_inner, th);
        Origin(_inner) -> bgOriginTokenToCss(_inner, th);
        Pos(_inner) -> bgPosTokenToCss(_inner, th);
        Repeat(_inner) -> bgRepeatTokenToCss(_inner, th);
        Size(_inner) -> bgSizeTokenToCss(_inner, th);
        Image(_inner) -> bgImageTokenToCss(_inner, th);
        // ── front 39 — backgrounds ────────────────────────
        // ── end front 39 ─────────────────────────────
    };
    return out;
}

// ── front 35 — spacing and sizing ────────────────────────────────────────────
//
// FRONT 35 OWNS EVERYTHING BETWEEN THIS BANNER AND ITS CLOSING ONE: the `Pad`,
// `Margin`, `Size` and `Space` sections of `tokens.bp` and the four dispatchers
// they reach.
//
// EMILIA NEVER RESOLVES A SPACING VALUE. Every leaf below answers `spacing(n)`
// or `spacingHalf(n)` from `spacing.bp` — `calc(var(--spacing) * n)` — and
// never a `rem` literal. A resolved `rem` is byte-different from upstream for
// every spacing utility in the library AND it makes a project's
// `--spacing: 4px` override silently ineffective, so it is wrong by contract
// (`contracts.md` 4a) rather than by taste.
//
// WHAT THIS FRONT CORRECTED. Before it, six hand-written ladders lived here and
// had drifted apart: `padTokenToCss` emitted `padding-x:` and `padding-y:`,
// which are not CSS properties and which every browser discards, and
// `marginScaleX` emitted `m-0.25`, `m-0.5`, `m-1`, `m-2` and `margin-auto` —
// Tailwind CLASS FRAGMENTS, in a position where only a declaration is legal.
// Three of emilia's ten sections emitted text that was not CSS and all three
// were here. The paths that compiled before still compile; only the CSS they
// emit changed, and what they emitted was never valid.

// One declaration — `padding-top:calc(var(--spacing) * 4)`.
fn oneDecl(prop: string, value: string) -> string {
    return prop + ":" + value;
}

// The two-property form an axis utility expands to: `px-4` is BOTH
// `padding-left` and `padding-right`, `;`-joined inside one token, because CSS
// has no `padding-x`.
fn axisDecl(first: string, second: string, value: string) -> string {
    return first + ":" + value + ";" + second + ":" + value;
}

// THE NINE DIRECTIONS OF PADDING. Upstream's `p-`, `px-`, `py-`, `pt-`, `pr-`,
// `pb-`, `pl-`, `ps-` and `pe-`, over the 35-leaf scale: the thirty multipliers
// of the default theme, the `Px` step, and `Half { 0, 1, 2, 3 }` for the `0.5`,
// `1.5`, `2.5` and `3.5` rungs. `0.5` cannot be an enum leaf — a numeric leaf is
// a run of digits — so `Half.1` reads "one and a half".
//
// An axis is TWO properties. The logical pair `S`/`E` is
// `padding-inline-start` / `padding-inline-end`, which follow the writing
// direction where `L`/`R` do not.
fn padTokenToCss(t: Token.Pad, th: Theme) -> string {
    val out = case t {
        All(_inner) -> oneDecl("padding", padScaleAll(_inner, th));
        X(_inner) -> axisDecl(
            "padding-left",
            "padding-right",
            padScaleX(_inner, th),
        );
        Y(_inner) -> axisDecl(
            "padding-top",
            "padding-bottom",
            padScaleY(_inner, th),
        );
        T(_inner) -> oneDecl("padding-top", padScaleT(_inner, th));
        R(_inner) -> oneDecl("padding-right", padScaleR(_inner, th));
        B(_inner) -> oneDecl("padding-bottom", padScaleB(_inner, th));
        L(_inner) -> oneDecl("padding-left", padScaleL(_inner, th));
        S(_inner) -> oneDecl("padding-inline-start", padScaleS(_inner, th));
        E(_inner) -> oneDecl("padding-inline-end", padScaleE(_inner, th));
    };
    return out;
}

fn padScaleAll(s: Token.Pad.All, th: Theme) -> string {
    val out = case s {
        __0 -> spacing(0);
        __1 -> spacing(1);
        __2 -> spacing(2);
        __3 -> spacing(3);
        __4 -> spacing(4);
        __5 -> spacing(5);
        __6 -> spacing(6);
        __7 -> spacing(7);
        __8 -> spacing(8);
        __9 -> spacing(9);
        __10 -> spacing(10);
        __11 -> spacing(11);
        __12 -> spacing(12);
        __14 -> spacing(14);
        __16 -> spacing(16);
        __20 -> spacing(20);
        __24 -> spacing(24);
        __28 -> spacing(28);
        __32 -> spacing(32);
        __36 -> spacing(36);
        __40 -> spacing(40);
        __44 -> spacing(44);
        __48 -> spacing(48);
        __52 -> spacing(52);
        __56 -> spacing(56);
        __60 -> spacing(60);
        __64 -> spacing(64);
        __72 -> spacing(72);
        __80 -> spacing(80);
        __96 -> spacing(96);
        Px -> "1px";
        Half(_inner) -> padHalfAll(_inner, th);
    };
    return out;
}

fn padHalfAll(h: Token.Pad.All.Half, th: Theme) -> string {
    val out = case h {
        __0 -> spacingHalf(0);
        __1 -> spacingHalf(1);
        __2 -> spacingHalf(2);
        __3 -> spacingHalf(3);
    };
    return out;
}

