        White -> gradientViaDecl(themeVar(nsPrefix(Ns.Color) + "white"));
        Black -> gradientViaDecl(themeVar(nsPrefix(Ns.Color) + "black"));
        Transparent -> gradientViaDecl("transparent");
        Current -> gradientViaDecl("currentColor");
        Inherit -> gradientViaDecl("inherit");
