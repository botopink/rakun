    };
    return out;
}

// The pre-37 `.Flex.Gap.{1,2,4,8}` paths. They keep compiling and they now
// answer `spacing(n)` — the same declaration `.Gap.All.N` answers, by a
// narrower name. This replaced `flexGapScale`, the seventh and last of the
// hand-written `rem` ladders front 54 found.
fn legacyGapScale(s: Token.Flex.Gap, th: Theme) -> string {
    val out = case s {
        __1 -> spacing(1);
        __2 -> spacing(2);
        __4 -> spacing(4);
        __8 -> spacing(8);
    };
    return out;
}

// ── the grid container and the grid item · `§ 6.8`–`§ 6.14` ─────────────────
//
// `display:grid` is front 36's and was all emilia had: there was no template,
// no span, no start, no end, no flow and no implicit track, so nothing could be
// put inside the box it declares. NOTHING BELOW IS A LENGTH — a column count, a
// span and a line number are integers — so no leaf here reaches `spacing` and
// none spells a `rem`.

// `§ 6.8` prints `grid-cols-N` as `repeat(N, minmax(0, 1fr))`, ONE SPACE after
// each comma. It is a function of the leaf rather than a lookup, so adding a
// column count is one arm and not two, and the text lives here alone.
fn gridRepeat(n: string) -> string {
    return "repeat(" + n + ", " + gridFr() + ")";
}

// The implicit-track `fr` of `§ 6.13`/`§ 6.14` is the same `minmax(0, 1fr)`
// `gridRepeat` puts inside its `repeat()`, so it is written once and read twice.
fn gridFr() -> string {
    return "minmax(0, 1fr)";
}

// `§ 6.9` prints a span DOUBLED — `span 2 / span 2` — because the start and the
// end of the placement are both relative.
fn gridSpan(n: string) -> string {
    return "span " + n + " / span " + n;
}

fn gridTokenToCss(t: Token.Grid, th: Theme) -> string {
    val out = case t {
        Cols(_inner) -> oneDecl(
            "grid-template-columns",
            gridColsToCss(_inner, th),
        );
        Rows(_inner) -> oneDecl(
            "grid-template-rows",
            gridRowsToCss(_inner, th),
        );
        Col(_inner) -> gridColToCss(_inner, th);
        Row(_inner) -> gridRowToCss(_inner, th);
        Flow(_inner) -> oneDecl("grid-auto-flow", gridFlowToCss(_inner, th));
        AutoCols(_inner) -> oneDecl(
            "grid-auto-columns",
            gridAutoColsToCss(_inner, th),
        );
        AutoRows(_inner) -> oneDecl(
            "grid-auto-rows",
            gridAutoRowsToCss(_inner, th),
        );
    };
    return out;
}

fn gridColsToCss(c: Token.Grid.Cols, th: Theme) -> string {
    val out = case c {
        __1 -> gridRepeat("1");
        __2 -> gridRepeat("2");
        __3 -> gridRepeat("3");
        __4 -> gridRepeat("4");
        __5 -> gridRepeat("5");
        __6 -> gridRepeat("6");
        __7 -> gridRepeat("7");
        __8 -> gridRepeat("8");
        __9 -> gridRepeat("9");
        __10 -> gridRepeat("10");
        __11 -> gridRepeat("11");
        __12 -> gridRepeat("12");
        None -> "none";
        Subgrid -> "subgrid";
    };
    return out;
}

fn gridRowsToCss(r: Token.Grid.Rows, th: Theme) -> string {
    val out = case r {
        __1 -> gridRepeat("1");
        __2 -> gridRepeat("2");
        __3 -> gridRepeat("3");
        __4 -> gridRepeat("4");
        __5 -> gridRepeat("5");
        __6 -> gridRepeat("6");
        __7 -> gridRepeat("7");
        __8 -> gridRepeat("8");
        __9 -> gridRepeat("9");
        __10 -> gridRepeat("10");
        __11 -> gridRepeat("11");
        __12 -> gridRepeat("12");
        None -> "none";
        Subgrid -> "subgrid";
    };
    return out;
}

// `col-auto` and `col-span-*` are the `grid-column` SHORTHAND; `col-start-*`
// and `col-end-*` are the two longhands, which is why one section answers three
// property names.
fn gridColToCss(c: Token.Grid.Col, th: Theme) -> string {
    val out = case c {
        Auto -> "grid-column:auto";
        Span(_inner) -> oneDecl("grid-column", gridColSpanToCss(_inner, th));
        Start(_inner) -> oneDecl(
            "grid-column-start",
            gridColStartToCss(_inner, th),
        );
        End(_inner) -> oneDecl("grid-column-end", gridColEndToCss(_inner, th));
    };
    return out;
}

fn gridColSpanToCss(s: Token.Grid.Col.Span, th: Theme) -> string {
    val out = case s {
        __1 -> gridSpan("1");
        __2 -> gridSpan("2");
        __3 -> gridSpan("3");
        __4 -> gridSpan("4");
        __5 -> gridSpan("5");
        __6 -> gridSpan("6");
        __7 -> gridSpan("7");
        __8 -> gridSpan("8");
        __9 -> gridSpan("9");
        __10 -> gridSpan("10");
        __11 -> gridSpan("11");
        __12 -> gridSpan("12");
        Full -> "1 / -1";
    };
    return out;
}

fn gridColStartToCss(s: Token.Grid.Col.Start, th: Theme) -> string {
    val out = case s {
