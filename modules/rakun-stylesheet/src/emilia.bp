test "every Size leaf declares a property, and none of them resolves a rem" {
    val s = tokensToSheet(everySizeToken(), defaultTheme());
    assert s.rules.length == 566;
    val css = declarationsOf(s).join(";");
    assert declarationsOf(s).any({ d -> d == "" }) == false;
    assert css.indexOf("rem") == -1;
    assert css.indexOf("padding") == -1;
    assert css.indexOf("margin") == -1;
}

// ── tests · Space ────────────────────────────────────────────────────────────

fn spaceRule(t: Token) -> Rule {
    return firstRuleOf(tokenToSheet(t, defaultTheme()));
}

test "Space — the declaration is on the CHILDREN, under the sibling selector" {
    val r = spaceRule(.Space.Y.4);
    assert r.selector == ":where(& > :not(:last-child))";
    assert r.declarations
        == "--tw-space-y-reverse:0;margin-block-start:calc(calc(var(--spacing) * 4) * var(--tw-space-y-reverse));margin-block-end:calc(calc(var(--spacing) * 4) * calc(1 - var(--tw-space-y-reverse)))";
    assert r.layer == "utilities";
    assert r.atRules.length == 0;
    assert r.important == false;
}

// UPSTREAM'S REVERSE-AWARE PAIR (verified against `utilities.ts` 2026-09-26):
// the flag reset to 0, the start side times the flag, the end side times one
// minus it — so with no reverse token the gap is on the END, as before, and
// `XReverse` moves it to the start.
test "Space — the X axis is the inline pair, the Y axis the block pair" {
    assert spaceRule(.Space.X.4).declarations
        == "--tw-space-x-reverse:0;margin-inline-start:calc(calc(var(--spacing) * 4) * var(--tw-space-x-reverse));margin-inline-end:calc(calc(var(--spacing) * 4) * calc(1 - var(--tw-space-x-reverse)))";
    assert spaceRule(.Space.Y.4).declarations
        == "--tw-space-y-reverse:0;margin-block-start:calc(calc(var(--spacing) * 4) * var(--tw-space-y-reverse));margin-block-end:calc(calc(var(--spacing) * 4) * calc(1 - var(--tw-space-y-reverse)))";
    assert spaceRule(.Space.X.0).declarations
        == "--tw-space-x-reverse:0;margin-inline-start:0;margin-inline-end:0";
    assert spaceRule(.Space.X.Px).declarations
        == "--tw-space-x-reverse:0;margin-inline-start:calc(1px * var(--tw-space-x-reverse));margin-inline-end:calc(1px * calc(1 - var(--tw-space-x-reverse)))";
    assert spaceRule(.Space.Y.Half.1).declarations
        == "--tw-space-y-reverse:0;margin-block-start:calc(calc(var(--spacing) * 1.5) * var(--tw-space-y-reverse));margin-block-end:calc(calc(var(--spacing) * 1.5) * calc(1 - var(--tw-space-y-reverse)))";
}

test "Space — a negative child margin, the pull-up form" {
    assert spaceRule(.Space.X.Neg.2).declarations
        == "--tw-space-x-reverse:0;margin-inline-start:calc(calc(var(--spacing) * -2) * var(--tw-space-x-reverse));margin-inline-end:calc(calc(var(--spacing) * -2) * calc(1 - var(--tw-space-x-reverse)))";
    assert spaceRule(.Space.Y.Neg.4).declarations
        == "--tw-space-y-reverse:0;margin-block-start:calc(calc(var(--spacing) * -4) * var(--tw-space-y-reverse));margin-block-end:calc(calc(var(--spacing) * -4) * calc(1 - var(--tw-space-y-reverse)))";
    assert spaceRule(.Space.Y.Neg.Px).declarations
        == "--tw-space-y-reverse:0;margin-block-start:calc(-1px * var(--tw-space-y-reverse));margin-block-end:calc(-1px * calc(1 - var(--tw-space-y-reverse)))";
}

test "Space — the two reverse tokens set the upstream custom property" {
    assert spaceRule(.Space.XReverse).declarations == "--tw-space-x-reverse:1";
    assert spaceRule(.Space.YReverse).declarations == "--tw-space-y-reverse:1";
    assert spaceRule(.Space.XReverse).selector
        == ":where(& > :not(:last-child))";
    val tokens: Token[] = [.Space.X.4, .Space.XReverse];
    val decls = declarationsOf(tokensToSheet(tokens, defaultTheme()));
    assert (decls.at(1) ?? "") == "--tw-space-x-reverse:1";
}

// The selector is a nesting template, so it carries EXACTLY ONE `&` — with
// none it would replace the rule it was meant to describe, with two it would
// duplicate it, and front 56 refuses both with no opt-out. Front 40's `divide-*`
// separates the same children the same way and must call `siblingSelector()`
// rather than re-spell it; this is the assertion that makes a divergence
// visible the day it is written.
test "Space — the sibling selector is one template, with exactly one ampersand" {
    val sel = siblingSelector();
    assert sel == ":where(& > :not(:last-child))";
    assert sel.split("&").length - 1 == 1;
    assert spaceRule(.Space.X.4).selector == sel;
    assert spaceRule(.Space.YReverse).selector == sel;
}

test "Space — a modifier wraps the child selector, it does not replace it" {
    val inner: Token[] = [.Space.Y.4];
    val r = firstRuleOf(tokenToSheet(Token.Hover(inner), defaultTheme()));
    assert r.selector == ":where(&:hover > :not(:last-child))";
    assert r.declarations
        == "--tw-space-y-reverse:0;margin-block-start:calc(calc(var(--spacing) * 4) * var(--tw-space-y-reverse));margin-block-end:calc(calc(var(--spacing) * 4) * calc(1 - var(--tw-space-y-reverse)))";
}

// A `Space` token and a plain declaration in ONE token list are two rules of
// one class, because they do not describe the same elements. The spec writes
// the composition as one declaration string; it cannot be one — a declaration
// string has no room for a selector — so what is pinned here is the rendered
// document, which is where the question is actually answered.
test "Space — composing with a Pad token in one list gives two rules, in order" {
    val tokens: Token[] = [.Pad.All.4, .Space.Y.4];
    val cls = emilia(tokens);
    val styles = await flushWith(bareOptions());
    assert styles
        == "<style>@layer theme, base, components, utilities;@layer utilities{."
            + cls
            + "{padding:calc(var(--spacing) * 4)}"
            + ":where(."
            + cls
            + " > :not(:last-child)){--tw-space-y-reverse:0;margin-block-start:calc(calc(var(--spacing) * 4) * var(--tw-space-y-reverse));margin-block-end:calc(calc(var(--spacing) * 4) * calc(1 - var(--tw-space-y-reverse)))}}</style>";
}

// ── tests · end to end ───────────────────────────────────────────────────────

// The centred article shell every layout starts from: a max width from the
// theme's container ladder, `mx-auto`, and horizontal padding. Three tokens,
// one class, and — because all three sit in the same context — ONE rule.
test "end to end — a centred shell is one class, one rule, and no length in it" {
    val tokens: Token[] = [.Size.MaxW.X3xl, .Margin.X.Auto, .Pad.X.6];
    val cls = emilia(tokens);
    val styles = await flushWith(bareOptions());
    assert styles
        == "<style>@layer theme, base, components, utilities;@layer utilities{."
            + cls
            + "{max-width:var(--container-3xl);margin-left:auto;margin-right:auto;"
            + "padding-left:calc(var(--spacing) * 6);padding-right:calc(var(--spacing) * 6)}}</style>";
}

// The same three tokens under the STOCK theme: every length the shell resolves
// to is in the `:root` block rather than in the rule, which is the whole point
// of the front. A project that overrides either variable moves the shell
// without emilia re-emitting a byte of it.
test "end to end — the lengths live in the theme layer, not in the utility" {
    val tokens: Token[] = [.Size.MaxW.X3xl, .Margin.X.Auto, .Pad.X.6];
    val cls = emilia(tokens);
    val styles = await flush();
    assert styles.indexOf("--spacing:0.25rem") != -1;
    assert styles.indexOf("--container-3xl:48rem") != -1;
    assert styles.indexOf(
        "@layer utilities{."
            + cls
            + "{max-width:var(--container-3xl);"
            + "margin-left:auto;margin-right:auto;padding-left:calc(var(--spacing) * 6);"
            + "padding-right:calc(var(--spacing) * 6)}}",
    )
        != -1;
}

// A stacked thread: the children are spaced by `Space.Y` and the last reply is
// pulled back up by a negative margin. Both are front 35's, and they land in
// two different rules because they describe two different sets of elements.
test "end to end — a stacked thread spaces its children and pulls one back up" {
    val stack: Token[] = [.Space.Y.4, .Pad.All.6];
    val pulled: Token[] = [.Margin.T.Neg.2];
    val stackCls = emilia(stack);
    val pulledCls = emilia(pulled);
    val styles = await flushWith(bareOptions());
    assert styles.indexOf("." + stackCls + "{padding:calc(var(--spacing) * 6)}")
        != -1;
    assert styles.indexOf(
        ":where(."
            + stackCls
            + " > :not(:last-child)){--tw-space-y-reverse:0;margin-block-start:calc(calc(var(--spacing) * 4) * var(--tw-space-y-reverse));margin-block-end:calc(calc(var(--spacing) * 4) * calc(1 - var(--tw-space-y-reverse)))}",
    )
        != -1;
    assert styles.indexOf(
        "." + pulledCls + "{margin-top:calc(var(--spacing) * -2)}",
    )
        != -1;
}

// ── end front 35 ─────────────────────────────────────────────────────────────

// ── front 36 — layout ────────────────────────────────────────────────────────
//
// FRONT 36 OWNS EVERYTHING BETWEEN THIS BANNER AND ITS CLOSING ONE: the
// `Layout` section of `tokens.bp` and `layoutTokenToCss` with its
// sub-dispatchers. `Flex`/`Grid` the CONTAINER properties are front 37's —
// `display:flex` is here only because it is a display value.
//
// EMILIA NEVER RESOLVES A LENGTH. `Inset` answers `spacing(n)` /
// `spacingHalf(n)` from `spacing.bp`, the same two functions front 35's
// `Pad`/`Margin` answer, so `.Layout.Inset.T.4` and `.Pad.T.4` carry identical
// length text BY CONSTRUCTION and not by coincidence. A `rem` literal in this
// block would make a project's `--spacing` override silently ineffective
// (`contracts.md` 4a).
//
// `Z` is the one numeric family here that is NOT a length: `z-50` is
// `z-index:50`, a bare integer, and it never reaches `spacing`.
fn layoutTokenToCss(t: Token.Layout, th: Theme) -> string {
    val out = case t {
        Block -> "display:block";
        InlineBlock -> "display:inline-block";
        Inline -> "display:inline";
        InlineFlex -> "display:inline-flex";
        InlineGrid -> "display:inline-grid";
        Contents -> "display:contents";
        FlowRoot -> "display:flow-root";
        ListItem -> "display:list-item";
        Hidden -> "display:none";
        Flex -> "display:flex";
        Grid -> "display:grid";
        Position(_inner) -> layoutPositionToCss(_inner, th);
        Inset(_inner) -> layoutInsetToCss(_inner, th);
        Overflow(_inner) -> layoutOverflowToCss(_inner, th);
        Overscroll(_inner) -> layoutOverscrollToCss(_inner, th);
        Visibility(_inner) -> layoutVisibilityToCss(_inner, th);
        Z(_inner) -> layoutZToCss(_inner, th);
        Isolation(_inner) -> layoutIsolationToCss(_inner, th);
        Float(_inner) -> layoutFloatToCss(_inner, th);
        Clear(_inner) -> layoutClearToCss(_inner, th);
        Object(_inner) -> layoutObjectToCss(_inner, th);
        Aspect(_inner) -> layoutAspectToCss(_inner, th);
        Columns(_inner) -> layoutColumnsToCss(_inner, th);
        BreakAfter(_inner) -> layoutBreakAfterToCss(_inner, th);
        BreakBefore(_inner) -> layoutBreakBeforeToCss(_inner, th);
        BreakInside(_inner) -> layoutBreakInsideToCss(_inner, th);
        Box(_inner) -> layoutBoxToCss(_inner, th);
        BoxDecoration(_inner) -> layoutBoxDecorationToCss(_inner, th);
    };
    return out;
}

fn layoutPositionToCss(p: Token.Layout.Position, th: Theme) -> string {
    val out = case p {
        Static -> "position:static";
        Fixed -> "position:fixed";
        Absolute -> "position:absolute";
        Relative -> "position:relative";
        Sticky -> "position:sticky";
    };
    return out;
}

// THE NINE DIRECTIONS OF INSET. Upstream's `inset-`, `inset-x-`, `inset-y-`,
// `top-`, `right-`, `bottom-`, `left-` and the logical pair `start-`/`end-`.
// `inset` is a real CSS shorthand, so `All` is ONE declaration; `left`/`right`
// and `top`/`bottom` have no shorthand, so `X` and `Y` expand to two — which is
// how `§ 5.17` prints `inset-x-0`.
//
// `oneDecl` and `axisDecl` are front 35's, reused rather than re-spelled: two
// fronts writing `prop + ":" + value` by hand are two fronts that will
// eventually write it differently.
fn layoutInsetToCss(t: Token.Layout.Inset, th: Theme) -> string {
    val out = case t {
        All(_inner) -> oneDecl("inset", insetScaleAll(_inner, th));
        X(_inner) -> axisDecl("left", "right", insetScaleX(_inner, th));
        Y(_inner) -> axisDecl("top", "bottom", insetScaleY(_inner, th));
        T(_inner) -> oneDecl("top", insetScaleT(_inner, th));
        R(_inner) -> oneDecl("right", insetScaleR(_inner, th));
        B(_inner) -> oneDecl("bottom", insetScaleB(_inner, th));
        L(_inner) -> oneDecl("left", insetScaleL(_inner, th));
        S(_inner) -> oneDecl("inset-inline-start", insetScaleS(_inner, th));
        E(_inner) -> oneDecl("inset-inline-end", insetScaleE(_inner, th));
    };
    return out;
}

