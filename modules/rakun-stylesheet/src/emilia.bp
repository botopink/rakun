test "regression — no `Layout` leaf resolves a length; all 776 reference the theme" {
    val leaves = layoutLeaves();
    assert leaves.length == 776;
    assert leaves.all({ t -> tokenDeclarations(t).indexOf("rem") == -1 });
    assert leaves.all({ t -> tokenDeclarations(t).indexOf(":") != -1 });
    assert leaves.all({ t -> tokenDeclarations(t).length > 0 });
    // CONTROL, rewritten by front 38. `.Text.Size.Lg` used to spell
    // `1.125rem` and was the one real token left that resolved a `rem`;
    // it now answers `var(--text-lg)`, so THERE IS NO SUCH TOKEN ANY MORE
    // and the control is a hand-built declaration. The line below it is the
    // same fact asserted from the other side, so this walk reddens again the
    // day some front reintroduces a resolved length on `Text.Size`.
    assert "font-size:1.125rem".indexOf("rem") != -1;
    assert tokenDeclarations(.Text.Size.Lg).indexOf("rem") == -1;
}

test "regression — no `Layout` leaf emits a Tailwind class fragment" {
    val leaves = layoutLeaves();
    assert leaves.all({ t -> tokenDeclarations(t).indexOf("inset-x-") == -1 });
    assert leaves.all({ t -> tokenDeclarations(t).indexOf("inset-y-") == -1 });
    assert leaves.all({ t -> tokenDeclarations(t).indexOf("top-") == -1 });
    assert leaves.all({ t -> tokenDeclarations(t).indexOf("z-50") == -1 });
    assert leaves.all(
        { t -> tokenDeclarations(t).indexOf("overflow-auto") == -1 },
    );
    assert leaves.all(
        { t -> tokenDeclarations(t).indexOf("float-start") == -1 },
    );
    assert leaves.all(
        { t -> tokenDeclarations(t).indexOf("box-border") == -1 },
    );
}

// Every multiplier leaf of every direction carries the multiplier it names,
// through `spacing(n)` and through nothing else. The negatives carry `* -n`.
test "regression — the inset ladder is the spacing ladder, direction by direction" {
    assert tokenDeclarations(.Layout.Inset.All.12) == "inset:" + spacing(12);
    assert tokenDeclarations(.Layout.Inset.T.96) == "top:" + spacing(96);
    assert tokenDeclarations(.Layout.Inset.B.Neg.16)
        == "bottom:" + spacing(-16);
    assert tokenDeclarations(.Layout.Inset.L.Half.2)
        == "left:" + spacingHalf(2);
    assert tokenDeclarations(.Layout.Inset.S.Neg.Half.3)
        == "inset-inline-start:" + spacingNegHalf(3);
    assert tokenDeclarations(.Layout.Inset.E.0) == "inset-inline-end:0";
}

test "columns — a count is an integer, a named width is the theme's container" {
    assert tokenDeclarations(.Layout.Columns.1) == "columns:1";
    assert tokenDeclarations(.Layout.Columns.2) == "columns:2";
    assert tokenDeclarations(.Layout.Columns.3) == "columns:3";
    assert tokenDeclarations(.Layout.Columns.Auto) == "columns:auto";
    assert tokenDeclarations(.Layout.Columns.Md)
        == "columns:var(--container-md)";
    assert tokenDeclarations(.Layout.Columns.X3xs)
        == "columns:var(--container-3xs)";
    assert tokenDeclarations(.Layout.Columns.X7xl)
        == "columns:var(--container-7xl)";
}

test "columns — all fourteen named widths, and the ladder is one ladder" {
    val named: Token[] = [
        .Layout.Columns.X3xs,
        .Layout.Columns.X2xs,
        .Layout.Columns.Xs,
        .Layout.Columns.Sm,
        .Layout.Columns.Md,
        .Layout.Columns.Lg,
        .Layout.Columns.Xl,
        .Layout.Columns.X2xl,
        .Layout.Columns.X3xl,
        .Layout.Columns.X4xl,
        .Layout.Columns.X5xl,
        .Layout.Columns.X6xl,
        .Layout.Columns.X7xl,
    ];
    assert named.all({ t -> tokenDeclarations(t).indexOf("rem") == -1 });
    assert named.all(
        { t -> tokenDeclarations(t).indexOf("columns:var(--container-") == 0 },
    );
    val colMd = tokenDeclarations(.Layout.Columns.Md).split(":").at(1) ?? "";
    val maxWMd = tokenDeclarations(.Size.MaxW.Md).split(":").at(1) ?? "";
    assert colMd == maxWMd;
    assert themeValue(defaultTheme(), "--container-md") == "28rem";
}

test "break — the three properties, with `inside`'s shorter leaf set of its own" {
    assert tokenDeclarations(.Layout.BreakAfter.Auto) == "break-after:auto";
    assert tokenDeclarations(.Layout.BreakAfter.Avoid) == "break-after:avoid";
    assert tokenDeclarations(.Layout.BreakAfter.All) == "break-after:all";
    assert tokenDeclarations(.Layout.BreakAfter.Page) == "break-after:page";
    assert tokenDeclarations(.Layout.BreakAfter.Left) == "break-after:left";
    assert tokenDeclarations(.Layout.BreakAfter.Right) == "break-after:right";
    assert tokenDeclarations(.Layout.BreakAfter.Column) == "break-after:column";
    assert tokenDeclarations(.Layout.BreakBefore.Auto) == "break-before:auto";
    assert tokenDeclarations(.Layout.BreakBefore.Avoid) == "break-before:avoid";
    assert tokenDeclarations(.Layout.BreakBefore.All) == "break-before:all";
    assert tokenDeclarations(.Layout.BreakBefore.Page) == "break-before:page";
    assert tokenDeclarations(.Layout.BreakBefore.Left) == "break-before:left";
    assert tokenDeclarations(.Layout.BreakBefore.Right) == "break-before:right";
    assert tokenDeclarations(.Layout.BreakBefore.Column)
        == "break-before:column";
    assert tokenDeclarations(.Layout.BreakInside.Auto) == "break-inside:auto";
    assert tokenDeclarations(.Layout.BreakInside.Avoid) == "break-inside:avoid";
    assert tokenDeclarations(.Layout.BreakInside.AvoidPage)
        == "break-inside:avoid-page";
    assert tokenDeclarations(.Layout.BreakInside.AvoidColumn)
        == "break-inside:avoid-column";
}

test "box-sizing and box-decoration-break — the suffix moves off the name" {
    assert tokenDeclarations(.Layout.Box.Border) == "box-sizing:border-box";
    assert tokenDeclarations(.Layout.Box.Content) == "box-sizing:content-box";
    assert tokenDeclarations(.Layout.BoxDecoration.Clone)
        == "box-decoration-break:clone";
    assert tokenDeclarations(.Layout.BoxDecoration.Slice)
        == "box-decoration-break:slice";
}

test "end to end — a media card that crops its image and clips its overflow" {
    val card: Token[] = [
        .Layout.Overflow.Hidden,
        .Layout.Isolation.Isolate,
        .Border.Rounded.Lg,
    ];
    val media: Token[] = [
        .Layout.Aspect.Video,
        .Layout.Object.Fit.Cover,
        .Layout.Object.Pos.Center,
    ];
    val cardCls = emilia(card);
    val mediaCls = emilia(media);
    val styles = await flushWith(bareOptions());
    assert styles.indexOf(
        "."
            + cardCls
            + "{overflow:hidden;isolation:isolate;border-radius:var(--radius-lg)}",
    )
        != -1;
    assert styles.indexOf(
        "."
            + mediaCls
            + "{aspect-ratio:16 / 9;object-fit:cover;object-position:center}",
    )
        != -1;
}

test "end to end — a sticky header over a scrolling panel" {
    val header: Token[] = [
        .Layout.Position.Sticky,
        .Layout.Inset.T.0,
        .Layout.Z.50,
    ];
    val panel: Token[] = [.Layout.Overflow.Y.Auto, .Layout.Overscroll.Contain];
    val headerCls = emilia(header);
    val panelCls = emilia(panel);
    val styles = await flushWith(bareOptions());
    assert styles.indexOf(
        "." + headerCls + "{position:sticky;top:0;z-index:50}",
    )
        != -1;
    assert styles.indexOf(
        "." + panelCls + "{overflow-y:auto;overscroll-behavior:contain}",
    )
        != -1;
}

test "end to end — a badge pinned to the corner of a relative card" {
    val card: Token[] = [.Layout.Position.Relative, .Pad.All.4];
    val badge: Token[] = [
        .Layout.Position.Absolute,
        .Layout.Inset.T.Neg.2,
        .Layout.Inset.R.Neg.2,
    ];
    val cardCls = emilia(card);
    val badgeCls = emilia(badge);
    val styles = await flushWith(bareOptions());
    assert styles.indexOf(
        "." + cardCls + "{position:relative;padding:calc(var(--spacing) * 4)}",
    )
        != -1;
    assert styles.indexOf(
        "."
            + badgeCls
            + "{position:absolute;top:calc(var(--spacing) * -2);right:calc(var(--spacing) * -2)}",
    )
        != -1;
}

// ── end front 36 ─────────────────────────────────────────────────────────────

// ── front 37 — flexbox, grid and gap ─────────────────────────────────────────
//
// FRONT 37 OWNS EVERYTHING BETWEEN THIS BANNER AND ITS CLOSING ONE: the `Flex`,
// `Grid` and `Gap` sections of `tokens.bp` and `flexTokenToCss`,
// `gridTokenToCss` and `gapTokenToCss` with their sub-dispatchers. Front 36's
// `display:flex` and `display:grid` stay where they are — they are display
// values; this block is everything a box that already declares one can say
// next.
//
// EMILIA NEVER RESOLVES A LENGTH. `Basis` and the whole of `Gap` answer
// `spacing(n)` / `spacingHalf(n)` from `spacing.bp`, the same two functions
// front 35's `Pad`/`Margin` and front 36's `Inset` answer, so `.Flex.Basis.4`,
// `.Gap.All.4` and `.Pad.All.4` carry identical length text BY CONSTRUCTION.
// `Grow`, `Shrink`, `Order` and `Grid`'s spans, starts and ends are BARE
// NUMBERS and reach `spacing` never — `order-1` is `order:1`, a count and not
// a length.
//
// THE SEVENTH LADDER. Front 54 found seven hand-written `rem` ladders in this
// file and front 35 deleted six of them; `flexGapScale` — `__4 -> "1rem"` —
// was the seventh and was left alone because `Gap` is this front's section
// under a hard ownership rule. It is gone here: `.Flex.Gap.4` now emits what
// `.Gap.All.4` emits, and a walk over every leaf this front declares asserts
// no `rem` survives.

fn flexTokenToCss(t: Token.Flex, th: Theme) -> string {
    val out = case t {
        Row -> "flex-direction:row";
        RowReverse -> "flex-direction:row-reverse";
        Col -> "flex-direction:column";
        ColReverse -> "flex-direction:column-reverse";
        Wrap -> "flex-wrap:wrap";
        WrapReverse -> "flex-wrap:wrap-reverse";
        NoWrap -> "flex-wrap:nowrap";
        Value(_inner) -> oneDecl("flex", flexValueToCss(_inner, th));
        Grow(_inner) -> oneDecl("flex-grow", flexGrowToCss(_inner, th));
        Shrink(_inner) -> oneDecl("flex-shrink", flexShrinkToCss(_inner, th));
        Basis(_inner) -> oneDecl("flex-basis", flexBasisScale(_inner, th));
        Order(_inner) -> oneDecl("order", flexOrderToCss(_inner, th));
        Items(_inner) -> oneDecl("align-items", flexItemsToCss(_inner, th));
        Justify(_inner) -> oneDecl(
            "justify-content",
            flexJustifyToCss(_inner, th),
        );
        JustifyItems(_inner) -> oneDecl(
            "justify-items",
            flexJustifyItemsToCss(_inner, th),
        );
        JustifySelf(_inner) -> oneDecl(
            "justify-self",
            flexJustifySelfToCss(_inner, th),
        );
        AlignSelf(_inner) -> oneDecl(
            "align-self",
            flexAlignSelfToCss(_inner, th),
        );
        Content(_inner) -> oneDecl(
            "align-content",
            flexContentToCss(_inner, th),
        );
        PlaceContent(_inner) -> oneDecl(
            "place-content",
            flexPlaceContentToCss(_inner, th),
        );
        PlaceItems(_inner) -> oneDecl(
            "place-items",
            flexPlaceItemsToCss(_inner, th),
        );
        PlaceSelf(_inner) -> oneDecl(
            "place-self",
            flexPlaceSelfToCss(_inner, th),
        );
        Gap(_inner) -> oneDecl("gap", legacyGapScale(_inner, th));
    };
    return out;
}

// `§ 6.4`'s shorthand, printed the way upstream prints it: three components
// separated by single spaces, except `flex-none`, which is the one row whose
// value is the keyword and NOT `0 0 auto`.
fn flexValueToCss(v: Token.Flex.Value, th: Theme) -> string {
    val out = case v {
        One -> "1 1 0%";
        Auto -> "1 1 auto";
        Initial -> "0 1 auto";
        None -> "none";
    };
    return out;
}

fn flexGrowToCss(g: Token.Flex.Grow, th: Theme) -> string {
    val out = case g {
        __0 -> "0";
        __1 -> "1";
    };
    return out;
}

fn flexShrinkToCss(s: Token.Flex.Shrink, th: Theme) -> string {
    val out = case s {
        __0 -> "0";
        __1 -> "1";
    };
    return out;
}

// `basis-1` is `calc(var(--spacing) * 1)` — the SAME string `p-1` is — because
// `§ 6.1` and `§ 6.15` print it the same way. The fractions are carried by
// name, `1/3` being no identifier, and their percentages are front 35's to the
// last decimal: a test compares `.Flex.Basis.Frac.Third` to `.Size.W.Frac.Third`
// rather than to a literal.
fn flexBasisScale(s: Token.Flex.Basis, th: Theme) -> string {
    val out = case s {
        __0 -> spacing(0);
        __1 -> spacing(1);
        __2 -> spacing(2);
        __3 -> spacing(3);
        __4 -> spacing(4);
        __5 -> spacing(5);
        __6 -> spacing(6);
        __7 -> spacing(7);
        __8 -> spacing(8);
        __9 -> spacing(9);
        __10 -> spacing(10);
        __11 -> spacing(11);
        __12 -> spacing(12);
        __14 -> spacing(14);
        __16 -> spacing(16);
        __20 -> spacing(20);
        __24 -> spacing(24);
        __28 -> spacing(28);
        __32 -> spacing(32);
        __36 -> spacing(36);
        __40 -> spacing(40);
        __44 -> spacing(44);
        __48 -> spacing(48);
        __52 -> spacing(52);
        __56 -> spacing(56);
        __60 -> spacing(60);
        __64 -> spacing(64);
        __72 -> spacing(72);
        __80 -> spacing(80);
        __96 -> spacing(96);
        Px -> "1px";
        Auto -> "auto";
        Full -> "100%";
        Frac(_inner) -> flexBasisFracToCss(_inner, th);
        Half(_inner) -> flexBasisHalfToCss(_inner, th);
    };
    return out;
}

fn flexBasisFracToCss(f: Token.Flex.Basis.Frac, th: Theme) -> string {
    val out = case f {
        Half -> fraction(1, 2);
        Third -> fraction(1, 3);
        TwoThirds -> fraction(2, 3);
    };
    return out;
}

fn flexBasisHalfToCss(h: Token.Flex.Basis.Half, th: Theme) -> string {
    val out = case h {
        __0 -> spacingHalf(0);
        __1 -> spacingHalf(1);
        __2 -> spacingHalf(2);
        __3 -> spacingHalf(3);
    };
    return out;
}

// `order-first` and `order-last` are SENTINEL INTEGERS, not keywords, and
// `order-none` is `0` — `order:none` is not a value at all.
fn flexOrderToCss(o: Token.Flex.Order, th: Theme) -> string {
    val out = case o {
        __1 -> "1";
        __2 -> "2";
        __3 -> "3";
        __4 -> "4";
        __5 -> "5";
        __6 -> "6";
        __7 -> "7";
        __8 -> "8";
        __9 -> "9";
        __10 -> "10";
        __11 -> "11";
        __12 -> "12";
        First -> "-9999";
        Last -> "9999";
        None -> "0";
    };
    return out;
}

// ── the alignment family · `§ 6.16`–`§ 6.24` ────────────────────────────────
//
// ALIGNMENT APPLIES TO GRID AS MUCH AS TO FLEX and it lives under `Flex`
// anyway, because `align-items` and `justify-content` were spelled that way
// before this front and renaming a token that compiles today is what the
// milestone forbids. A grid container writes `.Flex.Justify.Center` and gets
// `justify-content:center`, which is the correct CSS for a grid; only the
// token's SPELLING reads as though it were flex-only.
//
// UPSTREAM IS NOT INTERNALLY CONSISTENT HERE AND THIS FRONT COPIES IT RATHER
// THAN SMOOTHING IT. `justify-content`, `align-items`, `align-self` and
// `align-content` take `flex-start`/`flex-end`; `justify-items`,
// `justify-self` and the whole `place-*` family take `start`/`end`. A test
// asserts both spellings come out of the right tokens, so the asymmetry is
// pinned rather than normalised.
//
// `AlignSelf` AND THE FLAT `place-*` TRIO, not `Self` and `Place { … }`:
// `Self` is a LANGUAGE KEYWORD, so a section cannot be named it — `unexpected
// \`Self\`` at the declaration, and again at every arm. The family is flattened
// the way front 36 flattened `Break`, which is also the 1.0.8 draft's
// spelling, and no emitted byte differs.
fn flexItemsToCss(p: Token.Flex.Items, th: Theme) -> string {
    val out = case p {
        Start -> "flex-start";
        Center -> "center";
        End -> "flex-end";
        Stretch -> "stretch";
        Baseline -> "baseline";
    };
    return out;
}

fn flexJustifyToCss(p: Token.Flex.Justify, th: Theme) -> string {
    val out = case p {
        Normal -> "normal";
        Start -> "flex-start";
        Center -> "center";
        End -> "flex-end";
        Between -> "space-between";
        Around -> "space-around";
        Evenly -> "space-evenly";
        Stretch -> "stretch";
    };
    return out;
}

fn flexJustifyItemsToCss(p: Token.Flex.JustifyItems, th: Theme) -> string {
    val out = case p {
        Start -> "start";
        End -> "end";
        Center -> "center";
        Stretch -> "stretch";
    };
    return out;
}

fn flexJustifySelfToCss(p: Token.Flex.JustifySelf, th: Theme) -> string {
    val out = case p {
        Auto -> "auto";
        Start -> "start";
        End -> "end";
        Center -> "center";
        Stretch -> "stretch";
    };
    return out;
}

fn flexAlignSelfToCss(p: Token.Flex.AlignSelf, th: Theme) -> string {
    val out = case p {
        Auto -> "auto";
        Start -> "flex-start";
        End -> "flex-end";
        Center -> "center";
        Stretch -> "stretch";
        Baseline -> "baseline";
    };
    return out;
}

fn flexContentToCss(p: Token.Flex.Content, th: Theme) -> string {
    val out = case p {
        Normal -> "normal";
        Center -> "center";
        Start -> "flex-start";
        End -> "flex-end";
        Between -> "space-between";
        Around -> "space-around";
        Evenly -> "space-evenly";
        Stretch -> "stretch";
    };
    return out;
}

fn flexPlaceContentToCss(p: Token.Flex.PlaceContent, th: Theme) -> string {
    val out = case p {
        Center -> "center";
        Start -> "start";
        End -> "end";
        Between -> "space-between";
        Around -> "space-around";
        Evenly -> "space-evenly";
