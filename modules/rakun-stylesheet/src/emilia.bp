}

// `§ 13.1`. `th` is the contract `§ 4a` parameter; nothing here reads it,
// because `themeVar` builds a REFERENCE and never resolves one.
fn filterTokenToCss(t: Token.Filter, th: Theme) -> string {
    val out = case t {
        Blur(_inner) -> filterBlurToCss(_inner);
        Brightness(_inner) -> filterFamilyDecl(
            "brightness",
            "brightness(" + filterBrightnessValue(_inner) + ")",
        );
        Contrast(_inner) -> filterFamilyDecl(
            "contrast",
            "contrast(" + filterContrastValue(_inner) + ")",
        );
        DropShadow(_inner) -> filterDropShadowToCss(_inner);
        Grayscale(_inner) -> filterFamilyDecl(
            "grayscale",
            "grayscale(" + filterGrayscaleValue(_inner) + ")",
        );
        HueRotate(_inner) -> filterFamilyDecl(
            "hue-rotate",
            "hue-rotate(" + filterHueRotateValue(_inner) + ")",
        );
        Invert(_inner) -> filterFamilyDecl(
            "invert",
            "invert(" + filterInvertValue(_inner) + ")",
        );
        Saturate(_inner) -> filterFamilyDecl(
            "saturate",
            "saturate(" + filterSaturateValue(_inner) + ")",
        );
        Sepia(_inner) -> filterFamilyDecl(
            "sepia",
            "sepia(" + filterSepiaValue(_inner) + ")",
        );
    };
    return out;
}

// `§ 13.2`, the same families on `backdrop-filter`, `Opacity` in place of
// `DropShadow`.
fn backdropFilterTokenToCss(t: Token.BackdropFilter, th: Theme) -> string {
    val out = case t {
        Blur(_inner) -> backdropBlurToCss(_inner);
        Brightness(_inner) -> backdropFamilyDecl(
            "brightness",
            "brightness(" + backdropBrightnessValue(_inner) + ")",
        );
        Contrast(_inner) -> backdropFamilyDecl(
            "contrast",
            "contrast(" + backdropContrastValue(_inner) + ")",
        );
        Grayscale(_inner) -> backdropFamilyDecl(
            "grayscale",
            "grayscale(" + backdropGrayscaleValue(_inner) + ")",
        );
        HueRotate(_inner) -> backdropFamilyDecl(
            "hue-rotate",
            "hue-rotate(" + backdropHueRotateValue(_inner) + ")",
        );
        Invert(_inner) -> backdropFamilyDecl(
            "invert",
            "invert(" + backdropInvertValue(_inner) + ")",
        );
        Opacity(_inner) -> backdropFamilyDecl(
            "opacity",
            "opacity(" + backdropOpacityValue(_inner) + ")",
        );
        Saturate(_inner) -> backdropFamilyDecl(
            "saturate",
            "saturate(" + backdropSaturateValue(_inner) + ")",
        );
        Sepia(_inner) -> backdropFamilyDecl(
            "sepia",
            "sepia(" + backdropSepiaValue(_inner) + ")",
        );
    };
    return out;
}

// ── the theme entries this front contributes ─────────────────────────────────
//
// The seven `--blur-*` and six `--drop-shadow-*` values, transcribed from
// upstream's `theme.css` (the reference prints the blur lengths in parentheses
// in `§ 13.1` and no drop-shadow value at all). `defaultTheme()` carries
// neither namespace, so a project composes
// `extendTheme(defaultTheme(), filterEntries())`, as with front 33's palette.
pub fn filterEntries() -> ThemeEntry[] {
    val out: ThemeEntry[] = [
        ThemeEntry(name: "--blur-xs", value: "4px"),
        ThemeEntry(name: "--blur-sm", value: "8px"),
        ThemeEntry(name: "--blur-md", value: "12px"),
        ThemeEntry(name: "--blur-lg", value: "16px"),
        ThemeEntry(name: "--blur-xl", value: "24px"),
        ThemeEntry(name: "--blur-2xl", value: "40px"),
        ThemeEntry(name: "--blur-3xl", value: "64px"),
        ThemeEntry(
            name: "--drop-shadow-xs",
            value: "0 1px 1px rgb(0 0 0 / 0.05)",
        ),
        ThemeEntry(
            name: "--drop-shadow-sm",
            value: "0 1px 2px rgb(0 0 0 / 0.15)",
        ),
        ThemeEntry(
            name: "--drop-shadow-md",
            value: "0 3px 3px rgb(0 0 0 / 0.12)",
        ),
        ThemeEntry(
            name: "--drop-shadow-lg",
            value: "0 4px 4px rgb(0 0 0 / 0.15)",
        ),
        ThemeEntry(
            name: "--drop-shadow-xl",
            value: "0 9px 7px rgb(0 0 0 / 0.1)",
        ),
        ThemeEntry(
            name: "--drop-shadow-2xl",
            value: "0 25px 25px rgb(0 0 0 / 0.15)",
        ),
    ];
    return out;
}

// ── the two arbitrary-value wrappers ─────────────────────────────────────────
//
// The readable spelling of `[.FilterRaw("blur(2px)")]`.
pub fn rawFilter(value: string) -> Token {
    return Token.FilterRaw(value: value);
}

pub fn rawBackdropFilter(value: string) -> Token {
    return Token.BackdropRaw(value: value);
}

// ── front 42 · tests ─────────────────────────────────────────────────────────
//
// Every row is asserted WHOLE — the custom property and the reader — because a
// test over the function alone passes a front that forgot the reader.

test "Filter.Blur — the eight rows of `§ 13.1`, as theme references" {
    assert tokenDeclarations(.Filter.Blur.None) == "filter:none";
    assert tokenDeclarations(.Filter.Blur.Xs)
        == "--tw-blur:blur(var(--blur-xs));filter:var(--tw-blur, ) var(--tw-brightness, ) var(--tw-contrast, ) var(--tw-grayscale, ) var(--tw-hue-rotate, ) var(--tw-invert, ) var(--tw-saturate, ) var(--tw-sepia, ) var(--tw-drop-shadow, )";
    assert tokenDeclarations(.Filter.Blur.Sm)
        == "--tw-blur:blur(var(--blur-sm));filter:var(--tw-blur, ) var(--tw-brightness, ) var(--tw-contrast, ) var(--tw-grayscale, ) var(--tw-hue-rotate, ) var(--tw-invert, ) var(--tw-saturate, ) var(--tw-sepia, ) var(--tw-drop-shadow, )";
    assert tokenDeclarations(.Filter.Blur.Md)
        == "--tw-blur:blur(var(--blur-md));filter:var(--tw-blur, ) var(--tw-brightness, ) var(--tw-contrast, ) var(--tw-grayscale, ) var(--tw-hue-rotate, ) var(--tw-invert, ) var(--tw-saturate, ) var(--tw-sepia, ) var(--tw-drop-shadow, )";
    assert tokenDeclarations(.Filter.Blur.Lg)
        == "--tw-blur:blur(var(--blur-lg));filter:var(--tw-blur, ) var(--tw-brightness, ) var(--tw-contrast, ) var(--tw-grayscale, ) var(--tw-hue-rotate, ) var(--tw-invert, ) var(--tw-saturate, ) var(--tw-sepia, ) var(--tw-drop-shadow, )";
    assert tokenDeclarations(.Filter.Blur.Xl)
        == "--tw-blur:blur(var(--blur-xl));filter:var(--tw-blur, ) var(--tw-brightness, ) var(--tw-contrast, ) var(--tw-grayscale, ) var(--tw-hue-rotate, ) var(--tw-invert, ) var(--tw-saturate, ) var(--tw-sepia, ) var(--tw-drop-shadow, )";
    assert tokenDeclarations(.Filter.Blur.X2xl)
        == "--tw-blur:blur(var(--blur-2xl));filter:var(--tw-blur, ) var(--tw-brightness, ) var(--tw-contrast, ) var(--tw-grayscale, ) var(--tw-hue-rotate, ) var(--tw-invert, ) var(--tw-saturate, ) var(--tw-sepia, ) var(--tw-drop-shadow, )";
    assert tokenDeclarations(.Filter.Blur.X3xl)
        == "--tw-blur:blur(var(--blur-3xl));filter:var(--tw-blur, ) var(--tw-brightness, ) var(--tw-contrast, ) var(--tw-grayscale, ) var(--tw-hue-rotate, ) var(--tw-invert, ) var(--tw-saturate, ) var(--tw-sepia, ) var(--tw-drop-shadow, )";
}

