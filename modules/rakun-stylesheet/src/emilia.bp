        .Flex.Basis.32,
        .Flex.Basis.36,
        .Flex.Basis.40,
        .Flex.Basis.44,
        .Flex.Basis.48,
        .Flex.Basis.52,
        .Flex.Basis.56,
        .Flex.Basis.60,
        .Flex.Basis.64,
        .Flex.Basis.72,
        .Flex.Basis.80,
        .Flex.Basis.96,
        .Flex.Basis.Px,
        .Flex.Basis.Auto,
        .Flex.Basis.Full,
        .Flex.Basis.Frac.Half,
        .Flex.Basis.Frac.Third,
        .Flex.Basis.Frac.TwoThirds,
        .Flex.Basis.Half.0,
        .Flex.Basis.Half.1,
        .Flex.Basis.Half.2,
        .Flex.Basis.Half.3,
        .Flex.Order.1,
        .Flex.Order.2,
        .Flex.Order.3,
        .Flex.Order.4,
        .Flex.Order.5,
        .Flex.Order.6,
        .Flex.Order.7,
        .Flex.Order.8,
        .Flex.Order.9,
        .Flex.Order.10,
        .Flex.Order.11,
        .Flex.Order.12,
        .Flex.Order.First,
        .Flex.Order.Last,
        .Flex.Order.None,
        .Flex.Items.Start,
        .Flex.Items.Center,
        .Flex.Items.End,
        .Flex.Items.Stretch,
        .Flex.Items.Baseline,
        .Flex.Justify.Normal,
        .Flex.Justify.Start,
        .Flex.Justify.Center,
        .Flex.Justify.End,
