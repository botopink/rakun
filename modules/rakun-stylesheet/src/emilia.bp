// ── tests · front 35 ─────────────────────────────────────────────────────────
//
// The front's own block of assertions lives HERE, beside the dispatchers it
// covers, rather than at the end of the file: front 33 appends its own block
// there and a front that appends to the same line of the same file cannot be
// merged without a conflict that says nothing.

test "the scale — every shape of leaf, read through the public `Pad.All` path" {
    assert tokenDeclarations(.Pad.All.0) == "padding:0";
    assert tokenDeclarations(.Pad.All.1) == "padding:calc(var(--spacing) * 1)";
    assert tokenDeclarations(.Pad.All.4) == "padding:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Pad.All.96)
        == "padding:calc(var(--spacing) * 96)";
    assert tokenDeclarations(.Pad.All.Half.0)
        == "padding:calc(var(--spacing) * 0.5)";
    assert tokenDeclarations(.Pad.All.Half.1)
        == "padding:calc(var(--spacing) * 1.5)";
    assert tokenDeclarations(.Pad.All.Half.3)
        == "padding:calc(var(--spacing) * 3.5)";
    assert tokenDeclarations(.Pad.All.Px) == "padding:1px";
}

test "the nine padding directions, each with its own property and its own expansion" {
    assert tokenDeclarations(.Pad.All.4) == "padding:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Pad.X.4)
        == "padding-left:calc(var(--spacing) * 4);padding-right:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Pad.Y.4)
        == "padding-top:calc(var(--spacing) * 4);padding-bottom:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Pad.T.4)
        == "padding-top:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Pad.R.4)
        == "padding-right:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Pad.B.4)
        == "padding-bottom:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Pad.L.4)
        == "padding-left:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Pad.S.4)
        == "padding-inline-start:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Pad.E.4)
        == "padding-inline-end:calc(var(--spacing) * 4)";
}

test "the nine margin directions, each with its own property and its own expansion" {
    assert tokenDeclarations(.Margin.All.4)
        == "margin:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Margin.X.4)
        == "margin-left:calc(var(--spacing) * 4);margin-right:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Margin.Y.4)
        == "margin-top:calc(var(--spacing) * 4);margin-bottom:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Margin.T.4)
        == "margin-top:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Margin.R.4)
        == "margin-right:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Margin.B.4)
        == "margin-bottom:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Margin.L.4)
        == "margin-left:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Margin.S.4)
        == "margin-inline-start:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Margin.E.4)
        == "margin-inline-end:calc(var(--spacing) * 4)";
}

test "`Auto` is on every margin direction, not only on the X axis" {
    assert tokenDeclarations(.Margin.All.Auto) == "margin:auto";
    assert tokenDeclarations(.Margin.X.Auto)
        == "margin-left:auto;margin-right:auto";
    assert tokenDeclarations(.Margin.Y.Auto)
        == "margin-top:auto;margin-bottom:auto";
    assert tokenDeclarations(.Margin.T.Auto) == "margin-top:auto";
    assert tokenDeclarations(.Margin.R.Auto) == "margin-right:auto";
    assert tokenDeclarations(.Margin.B.Auto) == "margin-bottom:auto";
    assert tokenDeclarations(.Margin.L.Auto) == "margin-left:auto";
    assert tokenDeclarations(.Margin.S.Auto) == "margin-inline-start:auto";
    assert tokenDeclarations(.Margin.E.Auto) == "margin-inline-end:auto";
}

test "`Neg` is on every margin direction — the `-mt-4` form, spelled as a path" {
    assert tokenDeclarations(.Margin.All.Neg.4)
        == "margin:calc(var(--spacing) * -4)";
    assert tokenDeclarations(.Margin.X.Neg.4)
        == "margin-left:calc(var(--spacing) * -4);margin-right:calc(var(--spacing) * -4)";
    assert tokenDeclarations(.Margin.Y.Neg.4)
        == "margin-top:calc(var(--spacing) * -4);margin-bottom:calc(var(--spacing) * -4)";
    assert tokenDeclarations(.Margin.T.Neg.4)
        == "margin-top:calc(var(--spacing) * -4)";
    assert tokenDeclarations(.Margin.R.Neg.4)
        == "margin-right:calc(var(--spacing) * -4)";
    assert tokenDeclarations(.Margin.B.Neg.4)
        == "margin-bottom:calc(var(--spacing) * -4)";
    assert tokenDeclarations(.Margin.L.Neg.4)
        == "margin-left:calc(var(--spacing) * -4)";
    assert tokenDeclarations(.Margin.S.Neg.4)
        == "margin-inline-start:calc(var(--spacing) * -4)";
    assert tokenDeclarations(.Margin.E.Neg.4)
        == "margin-inline-end:calc(var(--spacing) * -4)";
}

test "a negative margin carries the pixel step and the half steps too" {
    assert tokenDeclarations(.Margin.T.Neg.Px) == "margin-top:-1px";
    assert tokenDeclarations(.Margin.T.Neg.Half.1)
        == "margin-top:calc(var(--spacing) * -1.5)";
    assert tokenDeclarations(.Margin.X.Neg.2)
        == "margin-left:calc(var(--spacing) * -2);margin-right:calc(var(--spacing) * -2)";
}

// THE `-0.5` RUNG, which `spacingHalf(-0)` could not spell: front 54's
// `spacingNegHalf(0)`. Upstream 4.3.2 compiles `-mt-0.5` and `-inset-0.5` to
// exactly these values.
test "the `-0.5` rung — `-mt-0.5` and `-inset-0.5` are tokens, and distinct from `0.5`" {
    assert tokenDeclarations(.Margin.T.Neg.Half.0)
        == "margin-top:calc(var(--spacing) * -0.5)";
    assert tokenDeclarations(.Margin.All.Neg.Half.0)
        == "margin:calc(var(--spacing) * -0.5)";
    assert tokenDeclarations(.Layout.Inset.All.Neg.Half.0)
        == "inset:calc(var(--spacing) * -0.5)";
    assert tokenDeclarations(.Layout.Inset.T.Neg.Half.0)
        == "top:calc(var(--spacing) * -0.5)";
    assert tokenDeclarations(.Margin.T.Neg.Half.0)
        != tokenDeclarations(.Margin.T.Half.0);
}

// A NEGATIVE WHOLE PART IS REFUSED, not read as a negative half step: there
// is one spelling per rung, and `-0.5` could never have had the other.
test "spacingHalf refuses a negative whole part, naming spacingNegHalf" {
    val m = panicMessage({ ->
        val v = spacingHalf(0 - 1);
        0
    });
    assert m.indexOf("spacingNegHalf(1)") != -1;
    assert panicMessage({ ->
        val v = spacingNegHalf(0 - 2);
        0
    }).indexOf("never negative")
        != -1;
}

