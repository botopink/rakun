test "Interact.Snap.Type — each axis reads the strictness, proximity by default" {
    assert tokenDeclarations(.Interact.Snap.Type.X)
        == "scroll-snap-type:x var(--tw-scroll-snap-strictness, proximity)";
    assert tokenDeclarations(.Interact.Snap.Type.Y)
        == "scroll-snap-type:y var(--tw-scroll-snap-strictness, proximity)";
    assert tokenDeclarations(.Interact.Snap.Type.Both)
        == "scroll-snap-type:both var(--tw-scroll-snap-strictness, proximity)";
    assert tokenDeclarations(.Interact.Snap.Strictness.Mandatory)
        == "--tw-scroll-snap-strictness:mandatory";
    assert tokenDeclarations(.Interact.Snap.Strictness.Proximity)
        == "--tw-scroll-snap-strictness:proximity";
}

// THE PAIRING: the variable written and read in one class.
test "Interact.Snap — an axis and a strictness in one list, both declared" {
    val tokens: Token[] = [
        .Interact.Snap.Type.X,
        .Interact.Snap.Strictness.Mandatory,
    ];
    val decls = declarationsOf(tokensToSheet(tokens, defaultTheme()));
    assert decls.length == 2;
    assert (decls.at(0) ?? "")
        == "scroll-snap-type:x var(--tw-scroll-snap-strictness, proximity)";
    assert (decls.at(1) ?? "") == "--tw-scroll-snap-strictness:mandatory";
}

// THE COLOUR VARIANTS CONSTRUCT, and carry the palette reference.
test "InteractAccent / InteractCaret / InteractScrollbarColor — construct and emit" {
    val a = Token.InteractAccent(value: paletteVar("indigo", "600"));
    assert tokenDeclarations(a) == "accent-color:var(--color-indigo-600)";
    val c = Token.InteractCaret(value: paletteVar("red", "500"));
    assert tokenDeclarations(c) == "caret-color:var(--color-red-500)";
    val s = Token.InteractScrollbarColor(
        thumb: paletteVar("red", "500"),
        track: paletteVar("gray", "200"),
    );
    assert tokenDeclarations(s)
        == "scrollbar-color:var(--color-red-500) var(--color-gray-200)";
    assert tokenDeclarations(accent(paletteVar("teal", "400")))
        == "accent-color:var(--color-teal-400)";
    assert tokenDeclarations(caret(paletteVar("blue", "700")))
        == "caret-color:var(--color-blue-700)";
    assert tokenDeclarations(
        scrollbarColor(paletteVar("zinc", "400"), paletteVar("zinc", "100")),
    )
        == "scrollbar-color:var(--color-zinc-400) var(--color-zinc-100)";
}

// The accent and the background of one palette entry read ONE variable.
test "InteractAccent — the same theme entry as Bg.Color" {
    val a = tokenDeclarations(
        Token.InteractAccent(value: paletteVar("indigo", "500")),
    );
    val b = tokenDeclarations(.Bg.Color.Indigo.__500);
    assert (a.split(":").at(1) ?? "x") == (b.split(":").at(1) ?? "y");
}

test "Interact — a grabbing cursor under Hover reaches front 34's variant" {
    val inner: Token[] = [.Interact.Cursor.Grabbing];
    val outer: Token[] = [Token.Hover(inner)];
    val s = tokensToSheet(outer, defaultTheme());
    assert declarationsOf(s).join(";") == "cursor:grabbing";
    assert firstRuleOf(s).selector == "&:hover";
}

