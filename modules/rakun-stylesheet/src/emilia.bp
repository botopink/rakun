// One property per side, `;`-joined — `scroll-mx-4` is left THEN right.
fn interactOffsetDecl(props: string[], value: string) -> string {
    return props.map({ p -> oneDecl(p, value) }).join(";");
}

fn interactScrollToCss(s: Token.Interact.Scroll) -> string {
    val out = case s {
        Behavior(_inner) -> interactScrollBehaviorToCss(_inner);
        M(_inner) -> interactOffsetDecl(
            ["scroll-margin"],
            interactScrollMValue(_inner),
        );
        Mx(_inner) -> interactOffsetDecl(
            ["scroll-margin-left", "scroll-margin-right"],
            interactScrollMxValue(_inner),
        );
        My(_inner) -> interactOffsetDecl(
            ["scroll-margin-top", "scroll-margin-bottom"],
            interactScrollMyValue(_inner),
        );
        Mt(_inner) -> interactOffsetDecl(
            ["scroll-margin-top"],
            interactScrollMtValue(_inner),
        );
        Mr(_inner) -> interactOffsetDecl(
            ["scroll-margin-right"],
            interactScrollMrValue(_inner),
        );
        Mb(_inner) -> interactOffsetDecl(
            ["scroll-margin-bottom"],
            interactScrollMbValue(_inner),
        );
        Ml(_inner) -> interactOffsetDecl(
            ["scroll-margin-left"],
            interactScrollMlValue(_inner),
        );
        P(_inner) -> interactOffsetDecl(
            ["scroll-padding"],
            interactScrollPValue(_inner),
        );
        Px(_inner) -> interactOffsetDecl(
            ["scroll-padding-left", "scroll-padding-right"],
            interactScrollPxValue(_inner),
        );
        Py(_inner) -> interactOffsetDecl(
            ["scroll-padding-top", "scroll-padding-bottom"],
            interactScrollPyValue(_inner),
        );
        Pt(_inner) -> interactOffsetDecl(
            ["scroll-padding-top"],
            interactScrollPtValue(_inner),
        );
        Pr(_inner) -> interactOffsetDecl(
            ["scroll-padding-right"],
            interactScrollPrValue(_inner),
        );
        Pb(_inner) -> interactOffsetDecl(
            ["scroll-padding-bottom"],
            interactScrollPbValue(_inner),
        );
        Pl(_inner) -> interactOffsetDecl(
            ["scroll-padding-left"],
            interactScrollPlValue(_inner),
        );
    };
    return out;
}

fn interactScrollbarWidthToCss(v: Token.Interact.Scrollbar.Width) -> string {
    val out = case v {
        Auto -> "scrollbar-width:auto";
        Thin -> "scrollbar-width:thin";
        None -> "scrollbar-width:none";
    };
    return out;
}

fn interactScrollbarGutterToCss(v: Token.Interact.Scrollbar.Gutter) -> string {
    val out = case v {
        Auto -> "scrollbar-gutter:auto";
        Stable -> "scrollbar-gutter:stable";
        StableBothEdges -> "scrollbar-gutter:stable both-edges";
    };
    return out;
}

fn interactScrollbarToCss(s: Token.Interact.Scrollbar) -> string {
    val out = case s {
        Width(_inner) -> interactScrollbarWidthToCss(_inner);
        Gutter(_inner) -> interactScrollbarGutterToCss(_inner);
    };
    return out;
}

fn interactSnapAlignToCss(v: Token.Interact.Snap.Align) -> string {
    val out = case v {
        Start -> "scroll-snap-align:start";
        End -> "scroll-snap-align:end";
        Center -> "scroll-snap-align:center";
        None -> "scroll-snap-align:none";
    };
    return out;
}

fn interactSnapStopToCss(v: Token.Interact.Snap.Stop) -> string {
    val out = case v {
        Normal -> "scroll-snap-stop:normal";
        Always -> "scroll-snap-stop:always";
    };
    return out;
}

fn snapStrictnessVar() -> string {
    return "--tw-scroll-snap-strictness";
}

fn interactSnapTypeToCss(v: Token.Interact.Snap.Type) -> string {
    val strict = cssVarOr(snapStrictnessVar(), "proximity");
    val out = case v {
        None -> "scroll-snap-type:none";
        X -> "scroll-snap-type:x " + strict;
        Y -> "scroll-snap-type:y " + strict;
        Both -> "scroll-snap-type:both " + strict;
    };
    return out;
}

fn interactSnapStrictnessToCss(v: Token.Interact.Snap.Strictness) -> string {
    val out = case v {
        Mandatory -> oneDecl(snapStrictnessVar(), "mandatory");
        Proximity -> oneDecl(snapStrictnessVar(), "proximity");
    };
    return out;
}

fn interactSnapToCss(s: Token.Interact.Snap) -> string {
    val out = case s {
        Align(_inner) -> interactSnapAlignToCss(_inner);
        Stop(_inner) -> interactSnapStopToCss(_inner);
        Type(_inner) -> interactSnapTypeToCss(_inner);
        Strictness(_inner) -> interactSnapStrictnessToCss(_inner);
    };
    return out;
}

// `§ 17`. `th` is the contract `§ 4a` parameter; nothing here reads it.
fn interactTokenToCss(t: Token.Interact, th: Theme) -> string {
    val out = case t {
        AccentAuto -> "accent-color:auto";
        Cursor(_inner) -> interactCursorToCss(_inner);
        Appearance(_inner) -> interactAppearanceToCss(_inner);
        FieldSizing(_inner) -> interactFieldSizingToCss(_inner);
        ColorScheme(_inner) -> interactColorSchemeToCss(_inner);
        PointerEvents(_inner) -> interactPointerEventsToCss(_inner);
        Resize(_inner) -> interactResizeToCss(_inner);
        Select(_inner) -> interactSelectToCss(_inner);
        WillChange(_inner) -> interactWillChangeToCss(_inner);
        Touch(_inner) -> interactTouchToCss(_inner);
        Scroll(_inner) -> interactScrollToCss(_inner);
        Scrollbar(_inner) -> interactScrollbarToCss(_inner);
        Snap(_inner) -> interactSnapToCss(_inner);
    };
    return out;
}

// The wrappers a typed list needs: a leading-dot path followed by a payload
// call does not carry the array's context. Each takes a `paletteVar` result.
pub fn accent(value: string) -> Token {
    return Token.InteractAccent(value: value);
}

pub fn caret(value: string) -> Token {
    return Token.InteractCaret(value: value);
}

pub fn scrollbarColor(thumb: string, track: string) -> Token {
    return Token.InteractScrollbarColor(thumb: thumb, track: track);
}

