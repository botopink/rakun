// 78 shade dispatchers, one per (stop, family): a section of `Token` is a type
// written by its path, so `Token.Gradient.From.Red` and
// `Token.Gradient.Via.Red` are two types and one `case` cannot serve both.
// Front 33 pays the same 52 for `Color` and `Bg.Color`.

fn gradientFromRedShade(s: Token.Gradient.From.Red) -> string {
    val out = case s {
        __50 -> "50";
        __100 -> "100";
        __200 -> "200";
        __300 -> "300";
        __400 -> "400";
        __500 -> "500";
        __600 -> "600";
        __700 -> "700";
        __800 -> "800";
        __900 -> "900";
        __950 -> "950";
    };
    return out;
}

fn gradientFromOrangeShade(s: Token.Gradient.From.Orange) -> string {
    val out = case s {
        __50 -> "50";
        __100 -> "100";
        __200 -> "200";
        __300 -> "300";
        __400 -> "400";
        __500 -> "500";
        __600 -> "600";
        __700 -> "700";
        __800 -> "800";
        __900 -> "900";
        __950 -> "950";
    };
    return out;
}

fn gradientFromAmberShade(s: Token.Gradient.From.Amber) -> string {
    val out = case s {
        __50 -> "50";
        __100 -> "100";
        __200 -> "200";
        __300 -> "300";
        __400 -> "400";
        __500 -> "500";
        __600 -> "600";
        __700 -> "700";
        __800 -> "800";
