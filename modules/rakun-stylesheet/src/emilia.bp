        == "--tw-backdrop-saturate:saturate(1);backdrop-filter:var(--tw-backdrop-blur, ) var(--tw-backdrop-brightness, ) var(--tw-backdrop-contrast, ) var(--tw-backdrop-grayscale, ) var(--tw-backdrop-hue-rotate, ) var(--tw-backdrop-invert, ) var(--tw-backdrop-opacity, ) var(--tw-backdrop-saturate, ) var(--tw-backdrop-sepia, )";
    assert tokenDeclarations(.BackdropFilter.Saturate.__150)
        == "--tw-backdrop-saturate:saturate(1.5);backdrop-filter:var(--tw-backdrop-blur, ) var(--tw-backdrop-brightness, ) var(--tw-backdrop-contrast, ) var(--tw-backdrop-grayscale, ) var(--tw-backdrop-hue-rotate, ) var(--tw-backdrop-invert, ) var(--tw-backdrop-opacity, ) var(--tw-backdrop-saturate, ) var(--tw-backdrop-sepia, )";
    assert tokenDeclarations(.BackdropFilter.Saturate.__200)
        == "--tw-backdrop-saturate:saturate(2);backdrop-filter:var(--tw-backdrop-blur, ) var(--tw-backdrop-brightness, ) var(--tw-backdrop-contrast, ) var(--tw-backdrop-grayscale, ) var(--tw-backdrop-hue-rotate, ) var(--tw-backdrop-invert, ) var(--tw-backdrop-opacity, ) var(--tw-backdrop-saturate, ) var(--tw-backdrop-sepia, )";
}

test "BackdropFilter.Sepia — every step, custom property and reader" {
    assert tokenDeclarations(.BackdropFilter.Sepia.__0)
        == "--tw-backdrop-sepia:sepia(0);backdrop-filter:var(--tw-backdrop-blur, ) var(--tw-backdrop-brightness, ) var(--tw-backdrop-contrast, ) var(--tw-backdrop-grayscale, ) var(--tw-backdrop-hue-rotate, ) var(--tw-backdrop-invert, ) var(--tw-backdrop-opacity, ) var(--tw-backdrop-saturate, ) var(--tw-backdrop-sepia, )";
    assert tokenDeclarations(.BackdropFilter.Sepia.__100)
        == "--tw-backdrop-sepia:sepia(100%);backdrop-filter:var(--tw-backdrop-blur, ) var(--tw-backdrop-brightness, ) var(--tw-backdrop-contrast, ) var(--tw-backdrop-grayscale, ) var(--tw-backdrop-hue-rotate, ) var(--tw-backdrop-invert, ) var(--tw-backdrop-opacity, ) var(--tw-backdrop-saturate, ) var(--tw-backdrop-sepia, )";
}

// The value half of a two-declaration token: `--tw-blur:blur(…)` → `blur(…)`.
fn f42FamilyCall(t: Token) -> string {
    val first = tokenDeclarations(t).split(";").at(0) ?? "";
    val out = first.split(":").at(1) ?? "";
    return out;
}

// The family a two-declaration token names, with `prefix` taken off its
// custom property: `--tw-blur:…` under `--tw-` → `blur`. Answers "" when the
// token's first declaration does not start with `prefix`.
fn f42FamilyProp(t: Token, prefix: string) -> string {
    val first = tokenDeclarations(t).split(";").at(0) ?? "";
    val prop = first.split(":").at(0) ?? "";
    val rest = prop.split(prefix).at(1) ?? "";
    val out = if (prop.startsWith(prefix)) rest else "";
    return out;
}

fn f42FilterTwins() -> Token[] {
    val leaves: Token[] = [
        .Filter.Brightness.__0,
        .Filter.Brightness.__50,
        .Filter.Brightness.__75,
        .Filter.Brightness.__90,
        .Filter.Brightness.__95,
        .Filter.Brightness.__100,
        .Filter.Brightness.__105,
        .Filter.Brightness.__110,
        .Filter.Brightness.__125,
        .Filter.Brightness.__150,
        .Filter.Brightness.__200,
        .Filter.Contrast.__0,
        .Filter.Contrast.__50,
        .Filter.Contrast.__75,
        .Filter.Contrast.__100,
        .Filter.Contrast.__125,
        .Filter.Contrast.__150,
        .Filter.Contrast.__200,
        .Filter.Grayscale.__0,
        .Filter.Grayscale.__100,
        .Filter.HueRotate.__0,
        .Filter.HueRotate.__15,
        .Filter.HueRotate.__30,
        .Filter.HueRotate.__60,
        .Filter.HueRotate.__90,
        .Filter.HueRotate.__180,
        .Filter.Invert.__0,
        .Filter.Invert.__100,
        .Filter.Saturate.__0,
        .Filter.Saturate.__50,
        .Filter.Saturate.__100,
        .Filter.Saturate.__150,
        .Filter.Saturate.__200,
        .Filter.Sepia.__0,
        .Filter.Sepia.__100,
        .Filter.Blur.Xs,
        .Filter.Blur.Sm,
        .Filter.Blur.Md,
        .Filter.Blur.Lg,
        .Filter.Blur.Xl,
        .Filter.Blur.X2xl,
        .Filter.Blur.X3xl,
    ];
    return leaves;
}

fn f42BackdropTwins() -> Token[] {
    val leaves: Token[] = [
        .BackdropFilter.Brightness.__0,
        .BackdropFilter.Brightness.__50,
        .BackdropFilter.Brightness.__75,
        .BackdropFilter.Brightness.__90,
        .BackdropFilter.Brightness.__95,
        .BackdropFilter.Brightness.__100,
        .BackdropFilter.Brightness.__105,
        .BackdropFilter.Brightness.__110,
        .BackdropFilter.Brightness.__125,
        .BackdropFilter.Brightness.__150,
        .BackdropFilter.Brightness.__200,
        .BackdropFilter.Contrast.__0,
        .BackdropFilter.Contrast.__50,
        .BackdropFilter.Contrast.__75,
        .BackdropFilter.Contrast.__100,
        .BackdropFilter.Contrast.__125,
        .BackdropFilter.Contrast.__150,
        .BackdropFilter.Contrast.__200,
        .BackdropFilter.Grayscale.__0,
        .BackdropFilter.Grayscale.__100,
        .BackdropFilter.HueRotate.__0,
        .BackdropFilter.HueRotate.__15,
        .BackdropFilter.HueRotate.__30,
        .BackdropFilter.HueRotate.__60,
        .BackdropFilter.HueRotate.__90,
        .BackdropFilter.HueRotate.__180,
        .BackdropFilter.Invert.__0,
        .BackdropFilter.Invert.__100,
        .BackdropFilter.Saturate.__0,
        .BackdropFilter.Saturate.__50,
        .BackdropFilter.Saturate.__100,
        .BackdropFilter.Saturate.__150,
        .BackdropFilter.Saturate.__200,
        .BackdropFilter.Sepia.__0,
        .BackdropFilter.Sepia.__100,
        .BackdropFilter.Blur.Xs,
        .BackdropFilter.Blur.Sm,
        .BackdropFilter.Blur.Md,
        .BackdropFilter.Blur.Lg,
        .BackdropFilter.Blur.Xl,
        .BackdropFilter.Blur.X2xl,
        .BackdropFilter.Blur.X3xl,
    ];
    return leaves;
}

// THE MIRROR IS A MIRROR. Every `BackdropFilter` leaf with a `Filter` twin
// writes the SAME function call into the `--tw-backdrop-` twin of the
// `--tw-` property, walked over both lists index for index.
test "BackdropFilter — every twin writes the Filter leaf's function call" {
    val fs = f42FilterTwins();
    val bs = f42BackdropTwins();
    assert fs.length == bs.length;
    assert fs.length == 42;
    val fCalls = fs.map({ t -> f42FamilyCall(t) });
    val bCalls = bs.map({ t -> f42FamilyCall(t) });
    assert fCalls.filter({ c -> c == "" }).length == 0;
    assert fCalls.join("|") == bCalls.join("|");
    val fProps = fs.map({ t -> f42FamilyProp(t, "--tw-") });
    val bProps = bs.map({ t -> f42FamilyProp(t, "--tw-backdrop-") });
    assert fProps.filter({ p -> p == "" }).length == 0;
    assert fProps.join("|") == bProps.join("|");
}

// `brightness(.5)` IS NOT `brightness(0.5)`. The reference writes the leading
// dot off, and byte-equality is the gate — a normaliser that added the zero
// would pass a test over the function name and fail this one.
test "Filter — the leading-dot decimals and the percent signs of `§ 13.1`" {
    assert f42FamilyCall(.Filter.Brightness.__50) == "brightness(.5)";
    assert f42FamilyCall(.Filter.Saturate.__50) == "saturate(.5)";
    assert f42FamilyCall(.Filter.Contrast.__75) == "contrast(.75)";
    assert tokenDeclarations(.Filter.Brightness.__50).indexOf("0.5") == -1;
    assert f42FamilyCall(.Filter.Grayscale.__100) == "grayscale(100%)";
    assert f42FamilyCall(.Filter.Invert.__100) == "invert(100%)";
    assert f42FamilyCall(.Filter.Sepia.__100) == "sepia(100%)";
    assert f42FamilyCall(.Filter.Brightness.__100) == "brightness(1)";
    assert tokenDeclarations(.Filter.Brightness.__100).indexOf("%") == -1;
}

// `backdrop-opacity-*` takes `§ 12.3`'s fifteen steps, which DO carry their
// leading zero — that table writes `opacity: 0.05`.
test "BackdropFilter.Opacity — the fifteen steps of `§ 12.3`, leading zero kept" {
    assert f42FamilyCall(.BackdropFilter.Opacity.__5) == "opacity(0.05)";
    assert f42FamilyCall(.BackdropFilter.Opacity.__50) == "opacity(0.5)";
    assert f42FamilyCall(.BackdropFilter.Opacity.__100) == "opacity(1)";
}

// THE COMPOSITION, ASSERTED AS COMPOSITION. Two filter families in one list
// are two custom properties and two IDENTICAL readers in one rule: both
// families survive, and the duplicate reader is idempotent.
test "Filter — blur and grayscale in one list compose instead of overwriting" {
    val tokens: Token[] = [.Filter.Blur.Sm, .Filter.Grayscale.__100];
    val s = tokensToSheet(tokens, defaultTheme());
    assert s.rules.length == 2;
    val decls = declarationsOf(s).join(";").split(";");
    assert decls.length == 4;
    assert (decls.at(0) ?? "") == "--tw-blur:blur(var(--blur-sm))";
    assert (decls.at(2) ?? "") == "--tw-grayscale:grayscale(100%)";
    assert (decls.at(1) ?? "") == "filter:" + filterChain();
    assert (decls.at(3) ?? "") == (decls.at(1) ?? "x");
    assert filterChain().indexOf("var(--tw-blur, )") != -1;
    assert filterChain().indexOf("var(--tw-grayscale, )") != -1;
}

// THE READER IS SELF-CONTAINED: it names no `--tw-filter` (a variable no theme
// entry can hold and no `:root` rule could compose), and every family carries
// an empty fallback so an unset one contributes nothing.
test "Filter — the reader names every family, each with an empty fallback" {
    assert filterChain()
        == "var(--tw-blur, ) var(--tw-brightness, ) var(--tw-contrast, ) var(--tw-grayscale, ) var(--tw-hue-rotate, ) var(--tw-invert, ) var(--tw-saturate, ) var(--tw-sepia, ) var(--tw-drop-shadow, )";
    assert backdropFilterChain()
        == "var(--tw-backdrop-blur, ) var(--tw-backdrop-brightness, ) var(--tw-backdrop-contrast, ) var(--tw-backdrop-grayscale, ) var(--tw-backdrop-hue-rotate, ) var(--tw-backdrop-invert, ) var(--tw-backdrop-opacity, ) var(--tw-backdrop-saturate, ) var(--tw-backdrop-sepia, )";
    assert tokenDeclarations(.Filter.Blur.Md).indexOf("--tw-filter") == -1;
    assert tokenDeclarations(.BackdropFilter.Blur.Md).indexOf(
        "--tw-backdrop-filter",
    )
        == -1;
}

// A frosted panel: a backdrop blur and a backdrop saturate compose the same way.
test "BackdropFilter — blur and saturate in one list compose" {
    val tokens: Token[] = [
        .BackdropFilter.Blur.Md,
        .BackdropFilter.Saturate.__150,
    ];
    val decls = declarationsOf(tokensToSheet(tokens, defaultTheme()))
        .join(";")
        .split(";");
    assert decls.length == 4;
    assert (decls.at(0) ?? "") == "--tw-backdrop-blur:blur(var(--blur-md))";
    assert (decls.at(2) ?? "") == "--tw-backdrop-saturate:saturate(1.5)";
    assert (decls.at(3) ?? "") == "backdrop-filter:" + backdropFilterChain();
}

test "FilterRaw / BackdropRaw — the escape hatches construct and emit" {
    val f = Token.FilterRaw(value: "blur(8px) grayscale(100%)");
    val b = Token.BackdropRaw(value: "blur(2px)");
    assert tokenDeclarations(f) == "filter:blur(8px) grayscale(100%)";
    assert tokenDeclarations(b) == "backdrop-filter:blur(2px)";
    assert tokenDeclarations(rawFilter("sepia(40%)")) == "filter:sepia(40%)";
    assert tokenDeclarations(rawBackdropFilter("invert(1)"))
        == "backdrop-filter:invert(1)";
}

test "Filter — a brightness under Hover reaches front 34's variant" {
    val inner: Token[] = [.Filter.Brightness.__110];
    val outer: Token[] = [Token.Hover(inner)];
    val s = tokensToSheet(outer, defaultTheme());
    assert declarationsOf(s).join(";")
        == "--tw-brightness:brightness(1.1);filter:" + filterChain();
    assert firstRuleOf(s).selector == "&:hover";
}

test "filterEntries — seven blurs and six drop shadows, composed into a theme" {
    val es = filterEntries();
    assert es.length == 13;
    assert es.filter({ e -> e.name.startsWith(nsPrefix(Ns.Blur)) }).length == 7;
    assert es.filter({ e -> e.name.startsWith(nsPrefix(Ns.DropShadow)) }).length
        == 6;
    val th = extendTheme(defaultTheme(), filterEntries());
    assert themeValue(th, "--blur-sm") == "8px";
    assert themeValue(th, "--blur-3xl") == "64px";
    assert themeValue(th, "--drop-shadow-md") == "0 3px 3px rgb(0 0 0 / 0.12)";
    assert themeValue(defaultTheme(), "--blur-sm") == "";
}

// ── the regression walk ──────────────────────────────────────────────────────

fn f42AllLeaves() -> Token[] {
    val extra: Token[] = [
        .Filter.Blur.None,
        .BackdropFilter.Blur.None,
        .Filter.DropShadow.None,
        .Filter.DropShadow.Xs,
        .Filter.DropShadow.Sm,
        .Filter.DropShadow.Md,
        .Filter.DropShadow.Lg,
        .Filter.DropShadow.Xl,
        .Filter.DropShadow.X2xl,
        .BackdropFilter.Opacity.__0,
        .BackdropFilter.Opacity.__5,
        .BackdropFilter.Opacity.__10,
        .BackdropFilter.Opacity.__20,
        .BackdropFilter.Opacity.__25,
        .BackdropFilter.Opacity.__30,
        .BackdropFilter.Opacity.__40,
        .BackdropFilter.Opacity.__50,
        .BackdropFilter.Opacity.__60,
        .BackdropFilter.Opacity.__70,
        .BackdropFilter.Opacity.__75,
        .BackdropFilter.Opacity.__80,
        .BackdropFilter.Opacity.__90,
        .BackdropFilter.Opacity.__95,
        .BackdropFilter.Opacity.__100,
    ];
    return f42FilterTwins().append(f42BackdropTwins()).append(extra);
}

// A resolved length or shadow inside a filter declaration: a `px` or a colour
// function. The predicate takes a STRING, so its control is a string.
fn f42CarriesNoLiteral(decl: string) -> bool {
    return decl.indexOf("px") == -1
        && decl.indexOf("rgb(") == -1
        && decl.indexOf("rem") == -1;
}

test "front 42 — 108 leaves, every one well-formed, none resolving a length" {
    val leaves = f42AllLeaves();
    assert leaves.length == 108;
    val decls = leaves.map({ t -> tokenDeclarations(t) });
    assert decls.filter({ d -> d == "" || d.indexOf(":") == -1 }).length == 0;
    assert decls.filter({ d -> !f42CarriesNoLiteral(d) }).length == 0;
    assert f42CarriesNoLiteral("--tw-blur:blur(8px)") == false;
    assert f42CarriesNoLiteral(
        "--tw-drop-shadow:drop-shadow(0 1px 1px rgb(0 0 0 / 0.05))",
    )
        == false;
    val readers = decls.filter(
        { d -> d.indexOf(";filter:") != -1 || d.indexOf(";backdrop-filter:") != -1 },
    );
    assert readers.length == 106;
}

// DETERMINISM ACROSS TARGETS: the class name for a fixed list under a fixed
// theme is a literal both targets must fold to.
test "Filter — the class name is a literal, and both targets must agree" {
    val tokens: Token[] = [
        .Filter.Blur.Sm,
        .Filter.Grayscale.__100,
        .BackdropFilter.Blur.Md,
    ];
    assert emiliaWith(tokens, defaultTheme()) == "e_34f2e193";
}
// ── end front 42 ─────────────────────────────────────────────────────────────

// ── front 43 — tables ────────────────────────────────────────────────────────
//
// FRONT 43 OWNS EVERYTHING BETWEEN THIS BANNER AND ITS CLOSING ONE: the
// `Table` dispatcher and its sub-dispatchers, the wrapper `rawTableSpacing`
// and the tests under the same name.
//
// NO LEAF RESOLVES A LENGTH. `border-spacing-2` is front 54's `spacing(2)`,
// `calc(var(--spacing) * 2)`, which is `§ 14.2`'s `0.5rem` under the default
// theme and follows a project's `--spacing` otherwise. `spacing(0)` is the
// bare `0` `§ 14.2` prints, so the zero rows need no special case.
//
// THE AXES ARE THE ONE- AND TWO-VALUE FORMS OF ONE PROPERTY, as the spec
// designs them: `SpacingX.2` is `border-spacing:calc(…) 0`, so an X and a Y
// token in one list are two `border-spacing` declarations and the last wins.
// Upstream composes them through `--tw-border-spacing-x/-y`; this front does
// not, and says so here rather than in a test that would pass by accident.

fn tableSpacingValue(v: Token.Table.Spacing) -> string {
    val out = case v {
        __0 -> spacing(0);
        __1 -> spacing(1);
        __2 -> spacing(2);
        __4 -> spacing(4);
        __8 -> spacing(8);
    };
    return out;
}

fn tableSpacingXValue(v: Token.Table.SpacingX) -> string {
    val out = case v {
        __0 -> spacing(0);
        __1 -> spacing(1);
        __2 -> spacing(2);
        __4 -> spacing(4);
        __8 -> spacing(8);
    };
    return out;
}

fn tableSpacingYValue(v: Token.Table.SpacingY) -> string {
    val out = case v {
        __0 -> spacing(0);
        __1 -> spacing(1);
        __2 -> spacing(2);
        __4 -> spacing(4);
        __8 -> spacing(8);
    };
    return out;
}

fn tableLayoutToCss(l: Token.Table.Layout) -> string {
    val out = case l {
        Auto -> "table-layout:auto";
        Fixed -> "table-layout:fixed";
    };
    return out;
}

fn tableCaptionToCss(c: Token.Table.Caption) -> string {
    val out = case c {
        Top -> "caption-side:top";
        Bottom -> "caption-side:bottom";
    };
    return out;
}

// `§ 14`. `th` is the contract `§ 4a` parameter; `spacing(n)` builds a
// REFERENCE and never resolves one.
fn tableTokenToCss(t: Token.Table, th: Theme) -> string {
    val out = case t {
        Collapse -> "border-collapse:collapse";
        Separate -> "border-collapse:separate";
        Layout(_inner) -> tableLayoutToCss(_inner);
        Spacing(_inner) -> oneDecl("border-spacing", tableSpacingValue(_inner));
        SpacingX(_inner) -> oneDecl(
            "border-spacing",
            tableSpacingXValue(_inner) + " 0",
        );
        SpacingY(_inner) -> oneDecl(
            "border-spacing",
            "0 " + tableSpacingYValue(_inner),
        );
        Caption(_inner) -> tableCaptionToCss(_inner);
    };
    return out;
}

// The readable spelling of `[.TableSpacingRaw("1px 2px")]`.
pub fn rawTableSpacing(value: string) -> Token {
    return Token.TableSpacingRaw(value: value);
}

// ── front 43 · tests ─────────────────────────────────────────────────────────

test "Table — border-collapse and table-layout, `§ 14.1` and `§ 14.3`" {
    assert tokenDeclarations(.Table.Collapse) == "border-collapse:collapse";
    assert tokenDeclarations(.Table.Separate) == "border-collapse:separate";
    assert tokenDeclarations(.Table.Layout.Auto) == "table-layout:auto";
    assert tokenDeclarations(.Table.Layout.Fixed) == "table-layout:fixed";
}

test "Table.Spacing — the five steps as spacing multipliers, `§ 14.2`" {
    assert tokenDeclarations(.Table.Spacing.__0) == "border-spacing:0";
    assert tokenDeclarations(.Table.Spacing.__1)
        == "border-spacing:calc(var(--spacing) * 1)";
    assert tokenDeclarations(.Table.Spacing.__2)
        == "border-spacing:calc(var(--spacing) * 2)";
    assert tokenDeclarations(.Table.Spacing.__4)
        == "border-spacing:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Table.Spacing.__8)
        == "border-spacing:calc(var(--spacing) * 8)";
}

// THE TWO AXES IN ADJACENT LINES: a copy-paste between them is the likeliest
// defect in this front and a one-sided test cannot see it.
test "Table.SpacingX / SpacingY — the axes are not interchangeable" {
    assert tokenDeclarations(.Table.SpacingX.__2)
        == "border-spacing:calc(var(--spacing) * 2) 0";
    assert tokenDeclarations(.Table.SpacingY.__2)
        == "border-spacing:0 calc(var(--spacing) * 2)";
    assert tokenDeclarations(.Table.SpacingX.__1)
        == "border-spacing:calc(var(--spacing) * 1) 0";
    assert tokenDeclarations(.Table.SpacingX.__4)
        == "border-spacing:calc(var(--spacing) * 4) 0";
    assert tokenDeclarations(.Table.SpacingX.__8)
        == "border-spacing:calc(var(--spacing) * 8) 0";
    assert tokenDeclarations(.Table.SpacingY.__1)
        == "border-spacing:0 calc(var(--spacing) * 1)";
    assert tokenDeclarations(.Table.SpacingY.__4)
        == "border-spacing:0 calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Table.SpacingY.__8)
        == "border-spacing:0 calc(var(--spacing) * 8)";
}

// The one place the two axes agree, and the unitless zero with no `calc`.
test "Table.Spacing — the zero rows carry no unit and no calc" {
    assert tokenDeclarations(.Table.SpacingX.__0) == "border-spacing:0 0";
    assert tokenDeclarations(.Table.SpacingY.__0) == "border-spacing:0 0";
    assert tokenDeclarations(.Table.Spacing.__0).indexOf("calc") == -1;
}

test "Table.Caption — the two rows of `§ 14.4`" {
    assert tokenDeclarations(.Table.Caption.Top) == "caption-side:top";
    assert tokenDeclarations(.Table.Caption.Bottom) == "caption-side:bottom";
}

test "TableSpacingRaw — the escape hatch constructs and emits" {
    val t = Token.TableSpacingRaw(value: "1px 2px");
    assert tokenDeclarations(t) == "border-spacing:1px 2px";
    assert tokenDeclarations(rawTableSpacing("3px")) == "border-spacing:3px";
}

// THE REAL RULE: four properties in list order, one rule per token.
test "Table — a separated, row-gapped, fixed table with a bottom caption" {
    val tokens: Token[] = [
        .Table.Separate,
        .Table.SpacingY.__2,
        .Table.Layout.Fixed,
        .Table.Caption.Bottom,
    ];
    val decls = declarationsOf(tokensToSheet(tokens, defaultTheme()));
    assert decls.join(";")
        == "border-collapse:separate;border-spacing:0 calc(var(--spacing) * 2);table-layout:fixed;caption-side:bottom";
}

test "Table — a fixed layout under Md reaches front 34's variant" {
    val inner: Token[] = [.Table.Layout.Fixed];
    val outer: Token[] = [Token.Md(inner)];
    val s = tokensToSheet(outer, defaultTheme());
    assert declarationsOf(s).join(";") == "table-layout:fixed";
    assert (firstRuleOf(s).atRules.at(0) ?? "") != "";
}

fn f43AllLeaves() -> Token[] {
    val leaves: Token[] = [
        .Table.Collapse,
        .Table.Separate,
        .Table.Layout.Auto,
        .Table.Layout.Fixed,
        .Table.Spacing.__0,
        .Table.Spacing.__1,
        .Table.Spacing.__2,
        .Table.Spacing.__4,
        .Table.Spacing.__8,
        .Table.SpacingX.__0,
        .Table.SpacingX.__1,
        .Table.SpacingX.__2,
        .Table.SpacingX.__4,
        .Table.SpacingX.__8,
        .Table.SpacingY.__0,
        .Table.SpacingY.__1,
        .Table.SpacingY.__2,
        .Table.SpacingY.__4,
        .Table.SpacingY.__8,
        .Table.Caption.Top,
        .Table.Caption.Bottom,
    ];
    return leaves;
}

// NO LEAF RESOLVES A LENGTH — and the probe is shown to discriminate on a
// hand-built string, `§ 14.2`'s own resolved row.
test "front 43 — 21 leaves, every one well-formed, none resolving a length" {
    val decls = f43AllLeaves().map({ t -> tokenDeclarations(t) });
    assert decls.length == 21;
    assert decls.filter({ d -> d == "" || d.indexOf(":") == -1 }).length == 0;
    assert decls.filter(
        { d -> d.indexOf("rem") != -1 || d.indexOf("px") != -1 },
    ).length
        == 0;
    assert "border-spacing:0.5rem".indexOf("rem") != -1;
}

test "Table — the class name is a literal, and both targets must agree" {
    val tokens: Token[] = [
        .Table.Collapse,
        .Table.Spacing.__2,
        .Table.Caption.Top,
    ];
    assert emiliaWith(tokens, defaultTheme()) == "e_62f1e28f";
}
// ── end front 43 ─────────────────────────────────────────────────────────────

// ── front 44 — transitions and animation ─────────────────────────────────────
//
// FRONT 44 OWNS EVERYTHING BETWEEN THIS BANNER AND ITS CLOSING ONE: the
// `Transition` and `Animate` dispatchers, their sub-dispatchers, the two
// arbitrary-value wrappers, `transitionEntries()` and the tests under the same
// name.
//
// THE GAP THIS FRONT CLOSES. emilia had no `transition`, no `duration`, no
// timing function and no `animation` at all, so the six state modifiers front
// 34 shipped were all instantaneous: a button that darkens on hover darkened in
// one frame and a panel that faded in did not fade. The loading half was worse
// than cosmetic — there was no token for `animate-spin`, so a spinner meant a
// hand-written stylesheet beside emilia in the same codebase.
//
// NO LEAF RESOLVES A TIMING FUNCTION OR AN ANIMATION — fronts 35-41's rule, one
// family further on. `§ 15.4` prints `transition-timing-function: var(--ease-in)`
// and `§ 15.6` prints `animation: var(--animate-spin)`, so both are `themeVar`
// lookups against front 54's `Ns.Ease` and `Ns.Animate` prefixes, and the four
// animation shorthands (`spin 1s linear infinite`, …) and the three easing
// cubic-beziers are THEME ENTRIES rather than dispatcher constants. The walk at
// the bottom asserts that from both sides: no declaration this front emits
// carries `cubic-bezier(` or `infinite`, and the theme does carry both.
//
// `duration-*` AND `delay-*` ARE NOT THEME LOOKUPS, and that is the reference's
// call, not a shortcut: `§ 15.3` and `§ 15.5` print `transition-duration: 150ms`
// literally and upstream has no `--duration-*` namespace. The `150ms` inside
// the six presets is the same literal from the same rows of `§ 15.1`.
//
// THE ONE `…TokenToSheet` ARM IN FRONTS 41-47. `animateTokenToSheet` answers a
// `Sheet`, not a declaration string, because `animation:var(--animate-spin)`
// is only half of what `animate-spin` means — the other half is the
// `@keyframes spin` block, which is not a style rule and cannot be nested in
// one. Front 56's `blockSheet(header, body)` and `Sheet.blocks` carry it and
// `renderDocument` hoists it; `dedupeBlocks` there is what makes two spinners
// on a page one block.
//
// THE KEYFRAMES GATE THE SPEC OPENS WAS ALREADY CLOSED BY FRONT 54, and this
// front reads the tree rather than re-transcribing the upstream page. The four
// `--animate-*` entries are in `theme.bp`'s `animateEntries()` and the four
// `@keyframes` BODIES in its `keyframeEntries()`, both inside `defaultTheme()`,
// and `renderDocument` already hoists them through `themeBlocks`. So
// `animateTokenToSheet` READS THE BODY OUT OF THE THEME IT IS HANDED instead of
// pasting a second copy beside it — a second transcription of one table is how
// two tables drift (front 38 declined the same invitation over `--text-*`). The
// consequence worth knowing, and asserted below: under a theme that carries no
// keyframes body for a name, the token still emits its declaration and hoists
// NO block, which is also what makes `.Animate.None` and `AnimateRaw` blockless
// without a special case.
//
// WHAT THIS FRONT DOES OWE THE THEME: the three `--ease-*` entries, in
// `transitionEntries()` below. `defaultTheme()` carries the four `--animate-*`
// and neither `--ease-*` nor a cubic-bezier, so `.Transition.All` under the
// stock theme references a variable the stock document does not define. The
// three values are upstream's — see the note at the declaration.

// The two reference builders, and the only places this front spells a
// namespace prefix.
fn easeVar(name: string) -> string {
    return themeVar(nsPrefix(Ns.Ease) + name);
}

fn animateVar(name: string) -> string {
    return themeVar(nsPrefix(Ns.Animate) + name);
}

// `§ 15.1`'s six preset rows are THREE DECLARATIONS FROM ONE UTILITY, and this
// is the only place the shared tail is written. `tokensToCss` joins tokens with
// `;` already, so a leaf whose body is itself several `;`-joined declarations
// drops into a rule body with no special handling and the token-to-class
// mapping stays one-to-one.
//
// NOTE THE SPACE AFTER EACH COMMA in the property lists below — `color,
// background-color, …`. That is the reference's own spelling and byte-equality
// is the gate, so a well-meaning whitespace normaliser fails a test rather than
// changing the output quietly.
fn transitionPreset(properties: string) -> string {
    return "transition-property:"
        + properties
        + ";transition-timing-function:"
        + easeVar("out")
        + ";transition-duration:150ms";
}

// `§ 15.1`-`§ 15.5`. `th` is the contract `§ 4a` parameter; nothing here reads
// it, because `themeVar` builds a REFERENCE and never resolves one.
fn transitionTokenToCss(t: Token.Transition, th: Theme) -> string {
    val out = case t {
        None -> "transition-property:none";
        Base -> transitionPreset(
            "color, background-color, border-color, text-decoration-color, fill, stroke, opacity, box-shadow, transform, filter, backdrop-filter",
        );
        All -> transitionPreset("all");
        Colors -> transitionPreset(
            "color, background-color, border-color, text-decoration-color, fill, stroke",
        );
        Opacity -> transitionPreset("opacity");
        Shadow -> transitionPreset("box-shadow");
        Transform -> transitionPreset("transform");
        Behavior(_inner) -> "transition-behavior:"
            + transitionBehaviorValue(_inner);
        Duration(_inner) -> "transition-duration:"
            + transitionDurationValue(_inner);
        Ease(_inner) -> "transition-timing-function:"
            + transitionEaseValue(_inner);
        Delay(_inner) -> "transition-delay:" + transitionDelayValue(_inner);
        // The one row of `§ 15.1` that is a single declaration.
        // `transition` bare — spelled `Base` because `default` is a keyword AND
        // `Default(inner)` is already a top-level modifier.
    };
    return out;
}

// `§ 15.2`. THE CLASS NAME AND THE CSS VALUE DO NOT MATCH: `transition-discrete`
// emits `allow-discrete`. That is exactly the kind of row that gets written
// from memory and gets written wrong, so it has a test of its own below.
fn transitionBehaviorValue(b: Token.Transition.Behavior) -> string {
    val out = case b {
        Normal -> "normal";
        Discrete -> "allow-discrete";
    };
    return out;
}

// `§ 15.3`. Nine steps, every one carrying the `ms` unit — `0ms` included,
// which is what the reference prints and what a bare `0` would not be.
fn transitionDurationValue(d: Token.Transition.Duration) -> string {
    val out = case d {
        __0 -> "0ms";
        __75 -> "75ms";
        __100 -> "100ms";
        __150 -> "150ms";
        __200 -> "200ms";
        __300 -> "300ms";
        __500 -> "500ms";
        __700 -> "700ms";
        __1000 -> "1000ms";
    };
    return out;
}

// `§ 15.4`. `ease-linear` is a CSS KEYWORD and not a lookup — upstream has no
// `--ease-linear` — and the other three are `--ease-*` references whose
// cubic-beziers live in `transitionEntries()` below.
fn transitionEaseValue(e: Token.Transition.Ease) -> string {
    val out = case e {
        Linear -> "linear";
        In -> easeVar("in");
        Out -> easeVar("out");
        InOut -> easeVar("in-out");
    };
    return out;
}

// `§ 15.5`. The same nine steps as `§ 15.3` on a different property. The two
// tables are written twice because `Token.Transition.Duration` and
// `Token.Transition.Delay` are two distinct types and a `case` cannot be
// generic over them — front 41 carries `blendMixValue` beside `blendBgValue`
// for the same reason. A test below asserts the two agree value for value, so
// a typo in one and not the other is a red and not a drift.
fn transitionDelayValue(d: Token.Transition.Delay) -> string {
    val out = case d {
        __0 -> "0ms";
        __75 -> "75ms";
        __100 -> "100ms";
        __150 -> "150ms";
        __200 -> "200ms";
        __300 -> "300ms";
        __500 -> "500ms";
        __700 -> "700ms";
        __1000 -> "1000ms";
    };
    return out;
}

// The `@keyframes` body a theme carries for one animation name, or `""` when it
// carries none. `keyframeCss(th)` is front 54's accessor and `Ns.Keyframes` its
// prefix; this front spells neither the bodies nor the at-rule.
fn keyframeBody(th: Theme, name: string) -> string {
    val bodies = keyframeCss(th)
        .filter({ e -> e.name == name })
        .map({ e -> e.value });
    return bodies.at(0) ?? "";
}

// One built-in animation: the declaration, plus the theme's `@keyframes` block
// for it when the theme has one. A theme with the namespace emptied still gets
// a correct declaration and hoists nothing, which is the honest answer — there
// is no block to hoist.
fn animationSheet(th: Theme, name: string) -> Sheet {
    val decl = declSheet("animation:" + animateVar(name));
    val body = keyframeBody(th, name);
    val block = if (body == "")
        emptySheet()
    else
        blockSheet(nsPrefix(Ns.Keyframes) + name, body);
    return mergeSheet(decl, block);
}

// `§ 15.6`. FIVE leaves — the front README says six and counts `AnimateRaw`,
// which is a top-level variant with its own `tokenToSheet` arm and never
// reaches this `case`.
fn animateTokenToSheet(t: Token.Animate, th: Theme) -> Sheet {
    val out = case t {
        None -> declSheet("animation:none");
        Spin -> animationSheet(th, "spin");
        Ping -> animationSheet(th, "ping");
        Pulse -> animationSheet(th, "pulse");
        Bounce -> animationSheet(th, "bounce");
        // A keyword, and the one leaf here that names no keyframes.
    };
    return out;
}

// ── the theme entries this front contributes ─────────────────────────────────
//
// THE THREE VALUES ARE UPSTREAM'S. `§ 15.4` prints the three NAMES and no value
// for any of them; the cubic-beziers below are CONFIRMED against upstream v4's
// `theme.css` (4.3.2), byte for byte. The NAMESPACE is front 54's `Ns.Ease`, so
// `extendTheme` accepts them and `clearNamespace(th, Ns.Ease)` drops exactly
// these three; every rule this front emits names the variable, never its value.
//
// `defaultTheme()` does NOT carry these — front 54 ships the four `--animate-*`
// and stops there — so a project composes them the way front 33's palette is
// composed: `extendTheme(defaultTheme(), transitionEntries())`.
pub fn transitionEntries() -> ThemeEntry[] {
    val out: ThemeEntry[] = [
        ThemeEntry(
            name: "--ease-in",
            value: "cubic-bezier(0.4, 0, 1, 1)",
        ), // upstream `theme.css`
        ThemeEntry(
            name: "--ease-out",
            value: "cubic-bezier(0, 0, 0.2, 1)",
        ), // upstream `theme.css`
        ThemeEntry(
            name: "--ease-in-out",
            value: "cubic-bezier(0.4, 0, 0.2, 1)",
        ), // upstream `theme.css`
    ];
    return out;
}

// ── the two arbitrary-value wrappers ─────────────────────────────────────────
//
// `§ 15` prints no arbitrary-value row; both were measured against upstream v4
// (4.3.2, compiled). `animate-[…]` is `animation:<value>` — CONFIRMED.
// `transition-[…]` writes the property AND the timing and duration defaults,
// as every preset does, so `rawTransitionProperty` goes through
// `transitionPreset` and matches the presets beside it (whose defaults are the
// family's `var(--ease-out)` / `150ms`).
//
// WHY THESE ARE TOP-LEVEL VARIANTS and not `Transition.Property(…)` /
// `Animate.Raw(…)`: a payload leaf nested inside an enum section cannot be
// constructed by any spelling (front 41's banner records the two error texts).
// For `AnimateRaw` that is not an inconvenience — it is the ONLY way to name an
// animation this library does not ship, so the nested spelling would have shut
// the door rather than narrowed it.
//
// The wrappers are the readable form and the one the example uses;
// `[.AnimateRaw("fade 300ms")]` builds the same token.
pub fn rawTransitionProperty(value: string) -> Token {
    return Token.TransitionProperty(value: value);
}

pub fn rawAnimate(value: string) -> Token {
    return Token.AnimateRaw(value: value);
}

// ── front 44 · tests ─────────────────────────────────────────────────────────
//
// Every row of `§ 15.1`-`§ 15.6` is asserted individually: a reference row and
// a test line are the same fact written twice, and a mismatch fails the build.
// The six multi-declaration presets are asserted WHOLE and never with a
// `contains` — the whole point of those rows is the exact property list and its
// exact punctuation. The walks at the bottom are the part a per-row table
// cannot do.

// What one token hoists. `firstDeclaration` (front 40's) reads the rule half;
// this reads the other half, which only `Animate` has.
fn f44Blocks(t: Token) -> Block[] {
    return tokenToSheet(t, defaultTheme()).blocks;
}

fn f44BlockHeaders(t: Token) -> string {
    return f44Blocks(t).map({ b -> b.header }).join("|");
}

fn f44BlockBodies(t: Token) -> string {
    return f44Blocks(t).map({ b -> b.body }).join("|");
}

// ── `§ 15.1` · transition-property ───────────────────────────────────────────

// ONE DECLARATION, NOT THREE. `transition-none` is the one row of `§ 15.1` that
// does not carry the timing function and the duration with it.
test "Transition.None — one declaration, and none of the preset tail" {
    assert firstDeclaration(.Transition.None) == "transition-property:none";
    assert firstDeclaration(.Transition.None).indexOf("transition-duration")
        == -1;
    assert firstDeclaration(.Transition.None).indexOf(
        "transition-timing-function",
    )
        == -1;
}

// THE WHOLE STRING, ELEVEN PROPERTIES, THE REFERENCE'S ORDER. A `contains`
// here would pass on a list that had lost `backdrop-filter` or reordered
// `fill` and `stroke`, which is exactly the failure this row has.
test "Transition.Base — the eleven properties of the bare `transition` utility" {
    assert firstDeclaration(.Transition.Base)
        == "transition-property:color, background-color, border-color, "
            + "text-decoration-color, fill, stroke, opacity, box-shadow, transform, "
            + "filter, backdrop-filter;transition-timing-function:var(--ease-out);"
            + "transition-duration:150ms";
}

// THE SPACE AFTER EACH COMMA IS THE REFERENCE'S and byte-equality is the gate,
// so it is counted as well as spelled: eleven properties means ten separators,
// and a serialiser that stripped the spaces would leave the count intact and
// this assertion would still catch it.
test "Transition.Base — eleven properties, ten `, ` separators, none bare" {
    val decl = firstDeclaration(.Transition.Base);
    val list = decl.split(";").at(0) ?? "";
    assert list.split(", ").length == 11;
    assert list.split(",").length == 11;
    assert decl.indexOf("color,background-color") == -1;
}

test "Transition — the five narrow presets, whole, with their shared tail" {
    assert firstDeclaration(.Transition.All)
        == "transition-property:all;transition-timing-function:var(--ease-out);"
            + "transition-duration:150ms";
    assert firstDeclaration(.Transition.Colors)
        == "transition-property:color, background-color, border-color, "
            + "text-decoration-color, fill, stroke;"
            + "transition-timing-function:var(--ease-out);transition-duration:150ms";
    assert firstDeclaration(.Transition.Opacity)
        == "transition-property:opacity;transition-timing-function:var(--ease-out);"
            + "transition-duration:150ms";
    assert firstDeclaration(.Transition.Shadow)
        == "transition-property:box-shadow;transition-timing-function:var(--ease-out);"
            + "transition-duration:150ms";
    assert firstDeclaration(.Transition.Transform)
        == "transition-property:transform;transition-timing-function:var(--ease-out);"
            + "transition-duration:150ms";
}

// THE SIX PRESETS ARE THREE DECLARATIONS EACH and `None` is one — the count is
// what a reader checks first and what a refactor of `transitionPreset` breaks
// first.
test "Transition — six presets of three declarations, one preset of one" {
    val presets: Token[] = [
        .Transition.Base,
        .Transition.All,
        .Transition.Colors,
        .Transition.Opacity,
        .Transition.Shadow,
        .Transition.Transform,
    ];
    assert presets.all({ t -> firstDeclaration(t).split(";").length == 3 });
    assert presets.all(
        { t -> firstDeclaration(t).endsWith(";transition-duration:150ms") },
    );
    assert firstDeclaration(.Transition.None).split(";").length == 1;
}

// FOUR LEAVES OF THIS SECTION REPEAT A SECTION HEAD DECLARED ELSEWHERE — the
// head audit's empirical half, run rather than reasoned about. `Transition.All`
// sits beside `Pad.All` and `Gap.All`; `Transition.Opacity` and
// `Transition.Shadow` beside `Effect.Opacity` and `Effect.Shadow`. A shadowed
// pattern does not red — it falls out of its `case` and the token declares the
// empty string, on one target only — so each of the four is asserted to declare
// its own property and not the other section's.
// WHAT FRONT 45 INHERITS, stated here because front 45 lands next inside this
// level and `Transform` is the name it will want: `Transition.Transform` is a
// LEAF, so a `Transform` SECTION beside it is a head beside a leaf — safe, and
// measured safe by front 41. What front 45 must NOT declare is a TOP-LEVEL
// `Transform(…)` PAYLOAD variant, which would silently break this leaf's
// section the way front 36's `Break { After }` broke front 34's `After`.
test "the head audit — four leaves repeat a head elsewhere and none of them is shadowed" {
    assert firstDeclaration(.Transition.All).startsWith(
        "transition-property:all",
    );
    assert firstDeclaration(.Transition.Opacity).startsWith(
        "transition-property:opacity",
    );
    assert firstDeclaration(.Transition.Shadow).startsWith(
        "transition-property:box-shadow",
    );
    assert firstDeclaration(.Transition.Transform).startsWith(
        "transition-property:transform",
    );
    // and the sections whose HEADS carry those names are untouched
    assert firstDeclaration(.Effect.Opacity.__50) == "opacity:50%";
    assert firstDeclaration(.Effect.Shadow.Md)
        == "--tw-shadow:var(--shadow-md);box-shadow:" + boxShadowChain();
    assert firstDeclaration(.Pad.All.__4) == "padding:calc(var(--spacing) * 4)";
}

// ── `§ 15.2` · transition-behavior ───────────────────────────────────────────

// THE CLASS SAYS `discrete` AND THE VALUE SAYS `allow-discrete`. Asserted by
// itself, and against the value it is not, because this is the row that gets
// written from memory and gets written wrong.
test "Transition.Behavior — `transition-discrete` emits allow-discrete, not discrete" {
    assert firstDeclaration(.Transition.Behavior.Discrete)
        == "transition-behavior:allow-discrete";
    assert firstDeclaration(.Transition.Behavior.Discrete)
        != "transition-behavior:discrete";
    assert firstDeclaration(.Transition.Behavior.Normal)
        == "transition-behavior:normal";
}

// ── `§ 15.3` · transition-duration ───────────────────────────────────────────

// EVERY STEP CARRIES `ms`, `0ms` INCLUDED. A bare `0` is legal CSS for a length
// and is not what `§ 15.3` prints, so the zero step is asserted twice.
test "Transition.Duration — the nine steps of `§ 15.3`, every one with its unit" {
    assert firstDeclaration(.Transition.Duration.__0)
        == "transition-duration:0ms";
    assert firstDeclaration(.Transition.Duration.__75)
        == "transition-duration:75ms";
    assert firstDeclaration(.Transition.Duration.__100)
        == "transition-duration:100ms";
    assert firstDeclaration(.Transition.Duration.__150)
        == "transition-duration:150ms";
    assert firstDeclaration(.Transition.Duration.__200)
        == "transition-duration:200ms";
    assert firstDeclaration(.Transition.Duration.__300)
        == "transition-duration:300ms";
    assert firstDeclaration(.Transition.Duration.__500)
        == "transition-duration:500ms";
    assert firstDeclaration(.Transition.Duration.__700)
        == "transition-duration:700ms";
    assert firstDeclaration(.Transition.Duration.__1000)
        == "transition-duration:1000ms";
    assert firstDeclaration(.Transition.Duration.__0)
        != "transition-duration:0";
}

// ── `§ 15.5` · transition-delay ──────────────────────────────────────────────

test "Transition.Delay — the nine steps of `§ 15.5`, every one with its unit" {
    assert firstDeclaration(.Transition.Delay.__0) == "transition-delay:0ms";
    assert firstDeclaration(.Transition.Delay.__75) == "transition-delay:75ms";
    assert firstDeclaration(.Transition.Delay.__100)
        == "transition-delay:100ms";
    assert firstDeclaration(.Transition.Delay.__150)
        == "transition-delay:150ms";
    assert firstDeclaration(.Transition.Delay.__200)
        == "transition-delay:200ms";
    assert firstDeclaration(.Transition.Delay.__300)
        == "transition-delay:300ms";
    assert firstDeclaration(.Transition.Delay.__500)
        == "transition-delay:500ms";
    assert firstDeclaration(.Transition.Delay.__700)
        == "transition-delay:700ms";
    assert firstDeclaration(.Transition.Delay.__1000)
        == "transition-delay:1000ms";
    assert firstDeclaration(.Transition.Delay.__0) != "transition-delay:0";
}

// THE TWO NINE-STEP TABLES ARE WRITTEN TWICE because the two sections are two
// types. They are compared to EACH OTHER rather than to a third list of
// literals, so a typo in one and not the other is a red rather than a drift.
test "Duration and Delay — two properties over one value table, compared value for value" {
    val durations: Token[] = [
        .Transition.Duration.__0,
        .Transition.Duration.__75,
        .Transition.Duration.__100,
        .Transition.Duration.__150,
        .Transition.Duration.__200,
        .Transition.Duration.__300,
        .Transition.Duration.__500,
        .Transition.Duration.__700,
        .Transition.Duration.__1000,
    ];
    val delays: Token[] = [
        .Transition.Delay.__0,
        .Transition.Delay.__75,
        .Transition.Delay.__100,
        .Transition.Delay.__150,
        .Transition.Delay.__200,
        .Transition.Delay.__300,
        .Transition.Delay.__500,
        .Transition.Delay.__700,
        .Transition.Delay.__1000,
    ];
    val dv = durations.map({ t -> firstDeclaration(t).split(":").at(1) ?? "" });
    val yv = delays.map({ t -> firstDeclaration(t).split(":").at(1) ?? "" });
    assert dv.join("|") == yv.join("|");
    assert dv.length == 9;
    assert dv.all({ v -> v.endsWith("ms") });
}

// ── `§ 15.4` · transition-timing-function ────────────────────────────────────

// `ease-linear` IS A KEYWORD AND THE OTHER THREE ARE REFERENCES. Upstream has
// no `--ease-linear`, so a "consistency" patch that invented one would be
// emitting a variable no row of the reference carries.
test "Transition.Ease — one CSS keyword and three theme references" {
    assert firstDeclaration(.Transition.Ease.Linear)
        == "transition-timing-function:linear";
    assert firstDeclaration(.Transition.Ease.In)
        == "transition-timing-function:" + themeVar("--ease-in");
    assert firstDeclaration(.Transition.Ease.Out)
        == "transition-timing-function:" + themeVar("--ease-out");
    assert firstDeclaration(.Transition.Ease.InOut)
        == "transition-timing-function:" + themeVar("--ease-in-out");
    assert firstDeclaration(.Transition.Ease.Linear).indexOf("var(") == -1;
}

// NO `cubic-bezier(` IN ANY `Ease` ARM, nor in the preset tail that references
// the same variable. The literals live in `transitionEntries()` and the
// assertion below is the other half of that fact.
test "Transition.Ease — no arm resolves a cubic-bezier, and the preset tail does not either" {
    val eases: Token[] = [
        .Transition.Ease.Linear,
        .Transition.Ease.In,
        .Transition.Ease.Out,
        .Transition.Ease.InOut,
    ];
    assert eases.all(
        { t -> firstDeclaration(t).indexOf("cubic-bezier(") == -1 },
    );
    assert firstDeclaration(.Transition.All).indexOf("cubic-bezier(") == -1;
    assert firstDeclaration(.Transition.All).indexOf("var(--ease-out)") != -1;
}

// ── the theme entries this front contributes ─────────────────────────────────

// THE THREE VALUES, ASSERTED WHERE THEY LIVE. `cubic-bezier(0.4, 0, 1, 1)`
// keeps all three spaces after its commas — the same punctuation rule the
// property lists above follow — and these are the ONLY three places this front
// writes a timing function at all.
test "transitionEntries — upstream's three `--ease-*` values, and their punctuation" {
    val es = transitionEntries();
    assert es.length == 3;
    assert es.map({ e -> e.name }).join("|")
        == "--ease-in|--ease-out|--ease-in-out";
    val e0 = es.at(0);
    val e1 = es.at(1);
    val e2 = es.at(2);
    if (e0 == null || e1 == null || e2 == null) {
        assert false;
        return;
    }
    assert e0.value == "cubic-bezier(0.4, 0, 1, 1)";
    assert e1.value == "cubic-bezier(0, 0, 0.2, 1)";
    assert e2.value == "cubic-bezier(0.4, 0, 0.2, 1)";
}

// THE NAMESPACE. The three land in front 54's `Ease`
// namespace, `clearNamespace` drops exactly these three, and the stock theme
// carries none of them — which is why a project has to compose them.
test "transitionEntries — the stock theme has no `--ease-*`, and a project composes them" {
    assert themeValue(defaultTheme(), "--ease-out") == "";
    assert namespace(defaultTheme(), Ns.Ease).length == 0;
    val th = extendTheme(defaultTheme(), transitionEntries());
    assert namespace(th, Ns.Ease).length == 3;
    assert themeValue(th, "--ease-out") == "cubic-bezier(0, 0, 0.2, 1)";
    assert nsPrefix(Ns.Ease) == "--ease-";
}

// THE REFERENCE FORM IS WHY THE CLASS DOES NOT MOVE. Every rule this front
// emits names `--ease-out` and never its value, so the stock theme and a
// project's give the SAME class and the SAME declarations — only the theme
// layer moves. A dispatcher that resolved the easing would give two classes
// here and every themed project would ship two copies of every rule.
test "transitionEntries — a project's easing moves the theme layer and not one rule" {
    val tokens: Token[] = [.Transition.Colors, .Transition.Ease.InOut];
    val stock = defaultTheme();
    val mine: ThemeEntry[] = [
        ThemeEntry(
            name: "--ease-in-out",
            value: "cubic-bezier(0.65, 0, 0.35, 1)",
        ),
    ];
    val th = extendTheme(extendTheme(stock, transitionEntries()), mine);
    assert emiliaWith(tokens, stock) == emiliaWith(tokens, th);
    assert declarationsOf(tokensToSheet(tokens, stock)).join("|")
        == declarationsOf(tokensToSheet(tokens, th)).join("|");
    assert themeValue(th, "--ease-in-out") == "cubic-bezier(0.65, 0, 0.35, 1)";
}

// ── `§ 15.6` · animation ─────────────────────────────────────────────────────

// A DECLARATION AND A BLOCK, from one token. The declaration references the
// theme's `--animate-*`; the block is the theme's own `@keyframes` body, read
// out of the theme rather than transcribed a second time beside it.
test "Animate — the four built-ins are a reference plus the theme's keyframes block" {
    assert firstDeclaration(.Animate.Spin)
        == "animation:" + themeVar("--animate-spin");
    assert firstDeclaration(.Animate.Ping)
        == "animation:" + themeVar("--animate-ping");
    assert firstDeclaration(.Animate.Pulse)
        == "animation:" + themeVar("--animate-pulse");
    assert firstDeclaration(.Animate.Bounce)
        == "animation:" + themeVar("--animate-bounce");
    assert f44BlockHeaders(.Animate.Spin) == "@keyframes spin";
    assert f44BlockHeaders(.Animate.Ping) == "@keyframes ping";
    assert f44BlockHeaders(.Animate.Pulse) == "@keyframes pulse";
    assert f44BlockHeaders(.Animate.Bounce) == "@keyframes bounce";
}

// THE FOUR BODIES AS LITERALS, so a later tidy-up of the keyframes fails a test
// rather than changing what a spinner does. They are front 54's data and they
// are asserted through THIS front's dispatcher, which is the only thing that
// proves the lookup finds the right one of the four.
test "Animate — the four keyframes bodies, as literals, through the dispatcher" {
    assert f44BlockBodies(.Animate.Spin) == "{to{transform:rotate(360deg)}}";
    assert f44BlockBodies(.Animate.Ping)
        == "{75%,100%{transform:scale(2);opacity:0}}";
    assert f44BlockBodies(.Animate.Pulse) == "{50%{opacity:0.5}}";
    assert f44BlockBodies(.Animate.Bounce)
        == "{0%,100%{transform:translateY(-25%);"
            + "animation-timing-function:cubic-bezier(0.8,0,1,1)}"
            + "50%{transform:none;animation-timing-function:cubic-bezier(0,0,0.2,1)}}";
}

// `animate-none` NAMES NO KEYFRAMES, so it hoists none — and neither does the
// arbitrary-value variant, which names an animation this library does not own.
test "Animate.None and AnimateRaw — a declaration, and an empty blocks list" {
    assert firstDeclaration(.Animate.None) == "animation:none";
    assert f44Blocks(.Animate.None).length == 0;
    assert firstDeclaration(rawAnimate("fade 300ms ease-out"))
        == "animation:fade 300ms ease-out";
    assert f44Blocks(rawAnimate("fade 300ms ease-out")).length == 0;
}

// A THEME WITH NO KEYFRAMES STILL GETS A CORRECT DECLARATION. This is the
// consequence of reading the body out of the theme instead of pasting it here,
// and it is the honest answer: there is no block to hoist.
test "Animate — under a theme carrying no keyframes body, the declaration stands alone" {
    val s = tokenToSheet(.Animate.Spin, emptyTheme());
    assert declarationsOf(s).join("") == "animation:var(--animate-spin)";
    assert s.blocks.length == 0;
    // and the stock theme is the control: it DOES carry the four
    assert keyframeCss(defaultTheme()).length == 4;
}

// TWO SPINNERS ARE ONE BLOCK. `dedupeBlocks` is front 56's and keys on the
// header; this front is what makes it observable from a token list.
test "Animate — two tokens naming one animation hoist one block, not two" {
    val twice: Token[] = [.Animate.Spin, .Animate.Spin];
    val s = tokensToSheet(twice, defaultTheme());
    assert s.rules.length == 2;
    assert s.blocks.length == 2;
    val doc = renderDocument("x\t" + encodeSheet(s), bareOptions());
    assert doc.split("@keyframes spin").length - 1 == 1;
    val two: Token[] = [.Animate.Spin, .Animate.Pulse];
    val doc2 = renderDocument(
        "y\t" + encodeSheet(tokensToSheet(two, defaultTheme())),
        bareOptions(),
    );
    assert doc2.split("@keyframes spin").length - 1 == 1;
    assert doc2.split("@keyframes pulse").length - 1 == 1;
}

// ── the two arbitrary-value variants ─────────────────────────────────────────

// THEY CONSTRUCT — the check that would have failed against the nested
// spelling, and the reason both sit at the top level of `Token`.
test "TransitionProperty and AnimateRaw — both construct, qualified and through the wrapper" {
    val a: Token = Token.TransitionProperty(value: "width");
    val b: Token = Token.AnimateRaw(value: "fade 300ms ease-out");
    assert firstDeclaration(a)
        == "transition-property:width;transition-timing-function:var(--ease-out);transition-duration:150ms";
    assert firstDeclaration(b) == "animation:fade 300ms ease-out";
    assert firstDeclaration(rawTransitionProperty("width"))
        == "transition-property:width;transition-timing-function:var(--ease-out);transition-duration:150ms";
    assert emilia([a]) == emilia([rawTransitionProperty("width")]);
}

// ── composition, nesting and determinism ─────────────────────────────────────

// THE OVERRIDE IS LAST AND THEREFORE WINS. A preset sets the duration to 150ms
// and a `Duration` token after it sets it again; both declarations are in the
// rule, in list order, which is the ordering contract the class hash rests on.
test "composition — a preset then its overrides, in list order, the later winning" {
    val tokens: Token[] = [
        .Transition.All,
        .Transition.Duration.__700,
        .Transition.Ease.Linear,
    ];
    val s = tokensToSheet(tokens, defaultTheme());
    assert s.rules.length == 3;
    assert declarationsOf(s).join("|")
        == "transition-property:all;transition-timing-function:var(--ease-out);"
            + "transition-duration:150ms"
            + "|transition-duration:700ms"
            + "|transition-timing-function:linear";
}

test "composition — the README's row: Colors then Duration.300" {
    val tokens: Token[] = [.Transition.Colors, .Transition.Duration.__300];
    val decls = declarationsOf(tokensToSheet(tokens, defaultTheme()));
    assert decls.length == 2;
    assert (decls.at(0) ?? "").endsWith("transition-duration:150ms");
    assert (decls.at(1) ?? "") == "transition-duration:300ms";
}

// A MULTI-DECLARATION BODY SURVIVES THE RECURSIVE PATH. This front asserts the
// declarations and not the wrap — the at-rule and the selector are front 34's
// contract and are asserted in front 34's tests.
test "nesting — a three-declaration preset under Hover keeps all three" {
    val inner: Token[] = [.Transition.Colors];
    val r = firstRuleOf(tokenToSheet(Token.Hover(inner), defaultTheme()));
    assert r.declarations.split(";").length == 3;
    assert r.declarations.startsWith(
        "transition-property:color, background-color",
    );
    assert r.selector != "&";
}

// A KEYFRAMES BLOCK IS NOT WRAPPED BY A VARIANT — an at-rule does not wrap a
// keyframes rule, which is front 56's `nestVariant` passing blocks through.
test "nesting — a spinner under Md keeps its block unwrapped" {
    val inner: Token[] = [.Animate.Spin];
    val s = tokenToSheet(Token.Md(inner), defaultTheme());
    assert s.blocks.length == 1;
    assert (s.blocks.map({ b -> b.header }).at(0) ?? "") == "@keyframes spin";
    assert firstRuleOf(s).atRules.length == 1;
}

// CONTRACT `§ 4` — the class name is a pure function of the token list AND the
// theme, so a fixed pair pins a literal hex that `commonJS` and `erlang` must
// both produce. Every value this front emits is ASCII, which is the condition
// the two `djb2` implementations need to agree.
test "determinism — a fixed transitions list hashes to the same class on both targets" {
    val tokens: Token[] = [
        .Transition.Colors,
        .Transition.Duration.__300,
        .Animate.Pulse,
    ];
    assert emiliaWith(tokens, defaultTheme()) == "e_a2e03d97";
}

// ── the regression walks ─────────────────────────────────────────────────────

fn transitionLeaves() -> Token[] {
    val leaves: Token[] = [
        .Transition.None,
        .Transition.Base,
        .Transition.All,
        .Transition.Colors,
        .Transition.Opacity,
        .Transition.Shadow,
        .Transition.Transform,
        .Transition.Behavior.Normal,
        .Transition.Behavior.Discrete,
        .Transition.Duration.__0,
        .Transition.Duration.__75,
        .Transition.Duration.__100,
        .Transition.Duration.__150,
        .Transition.Duration.__200,
        .Transition.Duration.__300,
        .Transition.Duration.__500,
        .Transition.Duration.__700,
        .Transition.Duration.__1000,
        .Transition.Ease.Linear,
        .Transition.Ease.In,
        .Transition.Ease.Out,
        .Transition.Ease.InOut,
        .Transition.Delay.__0,
        .Transition.Delay.__75,
        .Transition.Delay.__100,
        .Transition.Delay.__150,
        .Transition.Delay.__200,
        .Transition.Delay.__300,
        .Transition.Delay.__500,
        .Transition.Delay.__700,
        .Transition.Delay.__1000,
    ];
    return leaves;
}

fn animateLeaves() -> Token[] {
    val leaves: Token[] = [
        .Animate.None,
        .Animate.Spin,
        .Animate.Ping,
        .Animate.Pulse,
        .Animate.Bounce,
    ];
    return leaves;
}

fn front44Leaves() -> Token[] {
    return transitionLeaves().append(animateLeaves());
}

fn f44IsWellFormed(decl: string) -> bool {
    return decl.length > 0 && decl.indexOf(":") != -1;
}

// A RESOLVED TIMING FUNCTION OR ANIMATION. These are the two strings a "make it
// work without composing the theme" patch would put back into a dispatcher, and
// they are the two the reference puts in `§ 21.6` and in no dispatcher row.
//
// IT WALKS DECLARATIONS AND NOT SHEETS, deliberately: the `@keyframes bounce`
// BODY legitimately carries `cubic-bezier(0.8,0,1,1)`, and it is a BLOCK, not a
// declaration. The body is front 54's data and is pinned as a literal above.
fn f44CarriesNoResolvedTiming(decl: string) -> bool {
    return decl.indexOf("cubic-bezier(") == -1
        && decl.indexOf("infinite") == -1;
}

// The class-fragment probe. Each fragment below is a CLASS name, hyphenated,
// and none of them can occur in a correct declaration of this front — the
// properties are `transition-property:`, `transition-duration:` and so on, with
// a COLON where the class has a hyphen.
//
// `animate-*` AND `ease-in-out` ARE DELIBERATELY ABSENT FROM THIS LIST, and
// that is the point of the control beside it: `var(--animate-spin)` CONTAINS
// the class name `animate-spin` and `var(--ease-in-out)` contains `ease-in-out`,
// so a probe that named them would fire on correct output and be deleted by the
// next front. `animate-none` is safe to name — there is no `--animate-none`.
fn f44CarriesNoClassFragment(decl: string) -> bool {
    return decl.indexOf("transition-none") == -1
        && decl.indexOf("transition-all") == -1
        && decl.indexOf("transition-colors") == -1
        && decl.indexOf("transition-opacity") == -1
        && decl.indexOf("transition-shadow") == -1
        && decl.indexOf("transition-transform") == -1
        && decl.indexOf("transition-discrete") == -1
        && decl.indexOf("transition-normal") == -1
        && decl.indexOf("duration-") == -1
        && decl.indexOf("delay-") == -1
        && decl.indexOf("ease-linear") == -1
        && decl.indexOf("animate-none") == -1;
}

// A BARE SCALE STEP AS A VALUE — front 41's defect, in this front's vocabulary.
// `transition-duration:300` without the unit is the shape of it here, so the
// probe anchors on a colon followed by digits with nothing after them.
fn f44CarriesItsUnit(decl: string) -> bool {
    val isTimed = decl.startsWith("transition-duration:")
        || decl.startsWith("transition-delay:");
    val out = if (isTimed) decl.endsWith("ms") else true;
    return out;
}

test "regression — every one of the 36 leaves of this front declares something" {
    assert transitionLeaves().length == 31;
    assert animateLeaves().length == 5;
    val leaves = front44Leaves();
    assert leaves.length == 36;
    assert leaves.all({ t -> f44IsWellFormed(firstDeclaration(t)) });
}

test "regression — no leaf of this front resolves a timing function or an animation" {
    assert front44Leaves().all(
        { t -> f44CarriesNoResolvedTiming(firstDeclaration(t)) },
    );
}

test "regression — no transitions leaf emits a Tailwind class fragment" {
    assert front44Leaves().all(
        { t -> f44CarriesNoClassFragment(firstDeclaration(t)) },
    );
}

test "regression — every timed declaration carries its `ms` unit" {
    assert front44Leaves().all({ t -> f44CarriesItsUnit(firstDeclaration(t)) });
    val timed = front44Leaves().filter(
        { t -> f44CarriesItsUnit(firstDeclaration(t)) },
    );
    assert timed.length == 36;
}

// EVERY `Animate` LEAF BUT `None` IS A DISTINCT THEME REFERENCE — the assertion
// a name-discarding arm cannot survive, and the reason `animationSheet` takes
// the name rather than hard-coding four bodies.
test "regression — the four animations are four distinct references and four distinct blocks" {
    val named = animateLeaves().filter(
        { t -> firstDeclaration(t).indexOf("var(--") != -1 },
    );
    assert named.length == 4;
    val decls = named.map({ t -> firstDeclaration(t) });
    // Duplicates are counted rather than searched — front 40's rule, followed
    // here (§ Maintainer rules, `Array.lastIndexOf`).
    assert decls.filter(
        { d -> decls.filter({ x -> x == d }).length > 1 },
    ).length
        == 0;
    val heads = named.map({ t -> f44BlockHeaders(t) });
    assert heads.filter(
        { h -> heads.filter({ x -> x == h }).length > 1 },
    ).length
        == 0;
    assert named.all({ t -> f44Blocks(t).length == 1 });
}

// THE CONTROLS THAT MUST FAIL, and — for the string probes — the controls that
// must NOT. A probe that fires on valid output is one the next front deletes,
// so each is shown on a real emission as well as on the defect.
test "regression — the four transitions probes discriminate, in both directions" {
    assert f44IsWellFormed("") == false;
    assert f44IsWellFormed("transition-property") == false;
    assert f44IsWellFormed("transition-property:none");

    // the resolved values this front refuses, and the fact that they DO exist
    // in the library — in the theme, which is where they belong
    assert f44CarriesNoResolvedTiming(
        "transition-timing-function:cubic-bezier(0, 0, 0.2, 1)",
    )
        == false;
    assert f44CarriesNoResolvedTiming("animation:spin 1s linear infinite")
        == false;
    assert f44CarriesNoResolvedTiming(
        "transition-timing-function:var(--ease-out)",
    );
    val ease = transitionEntries().at(0);
    if (ease == null) {
        assert false;
        return;
    }
    assert ease.value.indexOf("cubic-bezier(") != -1;
    assert themeValue(defaultTheme(), "--animate-spin").indexOf("infinite")
        != -1;

    // the class fragments, on strings shaped like the defect
    assert f44CarriesNoClassFragment("transition-property:transition-all")
        == false;
    assert f44CarriesNoClassFragment("transition-duration:duration-300")
        == false;
    assert f44CarriesNoClassFragment("transition-delay:delay-150") == false;
    assert f44CarriesNoClassFragment("transition-timing-function:ease-linear")
        == false;
    assert f44CarriesNoClassFragment("animation:animate-none") == false;
    // AND NOT on correct output that merely contains a class name inside a
    // variable reference — the half that usually goes wrong
    assert f44CarriesNoClassFragment("animation:var(--animate-spin)");
    assert f44CarriesNoClassFragment(
        "transition-timing-function:var(--ease-in-out)",
    );
    assert f44CarriesNoClassFragment(firstDeclaration(.Transition.Base));

    // the unit probe, both ways
    assert f44CarriesItsUnit("transition-duration:300") == false;
    assert f44CarriesItsUnit("transition-delay:0") == false;
    assert f44CarriesItsUnit("transition-duration:300ms");
    assert f44CarriesItsUnit("transition-property:none");
}

// ── end to end ───────────────────────────────────────────────────────────────

// THE WHOLE POINT OF THE FRONT, in one document: a button whose colours move
// over 200ms on hover instead of snapping, and a spinner whose keyframes block
// is hoisted out of every layer to the end of the stylesheet.
test "end to end — a transitioned button and a hoisted spinner in one document" {
    val hovered: Token[] = [.Bg.Color.Indigo.700];
    val button: Token[] = [
        .Bg.Color.Indigo.600,
        .Transition.Colors,
        .Transition.Duration.__200,
        Token.Hover(hovered),
    ];
    val spinner: Token[] = [.Animate.Spin];
    val b = emiliaWith(button, defaultTheme());
    val s = emiliaWith(spinner, defaultTheme());
    val doc = await flushWith(bareOptions());
    assert doc.indexOf(
        "."
            + b
            + "{background-color:var(--color-indigo-600);"
            + "transition-property:color, background-color, border-color, "
            + "text-decoration-color, fill, stroke;"
            + "transition-timing-function:var(--ease-out);transition-duration:150ms;"
            + "transition-duration:200ms}",
    )
        != -1;
    assert doc.indexOf(
        "@media (hover: hover){."
            + b
            + ":hover{background-color:var(--color-indigo-700)}}",
    )
        != -1;
    assert doc.indexOf("." + s + "{animation:var(--animate-spin)}") != -1;
    // the block is OUTSIDE every layer, at the end of the document
    assert doc.endsWith(
        "@keyframes spin{to{transform:rotate(360deg)}}</style>",
    );
    assert doc.indexOf("@layer utilities{@keyframes") == -1;
}

// ── end front 44 ─────────────────────────────────────────────────────────────

// ── front 45 — transforms ────────────────────────────────────────────────────
//
// FRONT 45 OWNS EVERYTHING BETWEEN THIS BANNER AND ITS CLOSING ONE: the
// `Transform` dispatcher and its sixteen sub-dispatchers, the two
// arbitrary-value wrappers, `transformEntries()` and the tests under the same
// name.
//
// THE GAP THIS FRONT CLOSES. Front 44 shipped `Transition.Transform`, which
// emits `transition-property:transform` — a transition over a property NO
// OTHER TOKEN IN THE LIBRARY COULD SET. A card that lifts on hover, a chevron
// that flips when a disclosure opens, a toast that slides in and a modal that
// scales in are all one property, and `emilia` had a token for none of them.
//
// NO LEAF RESOLVES A LENGTH — fronts 35-41's rule, in this front's vocabulary.
// `translate-x-1` is front 54's `spacing(1)` and never a `rem`; the five
// perspective keywords are `--perspective-*` references and never the `100px`
// / `300px` / `500px` / `800px` / `1200px` the reference prints in parentheses,
// which are THEME ENTRIES in `transformEntries()` below. The two exceptions are
// `TranslateX.Px` and `TranslateY.Px`, whose `1px` is the reference's own
// literal value and not a theme lookup, and the walk at the bottom asserts that
// from both sides.
//
// ── THREE ROWS OF THE REFERENCE DO NOT SURVIVE, AND EACH IS FLAGGED AT ITS ARM
//
// (1) `§ 16.6`'s PROPERTY COLUMN IS WRONG. The reference writes `skew-x: 1deg`
// and `skew-y: 1deg`; neither is a registered CSS property. Upstream Tailwind
// v4 (4.3.2, compiled) writes the axis into a variable and composes the chain:
// `--tw-skew-x: skewX(3deg); transform: var(--tw-rotate-x,) var(--tw-rotate-y,)
// var(--tw-rotate-z,) var(--tw-skew-x,) var(--tw-skew-y,)`. The twelve leaves
// emit exactly that, so `[.SkewX.3, .SkewY.6]` skews on both axes, and the
// reference file's spelling is asserted ABSENT.
//
// (2) `§ 16.10`'s ONE-AXIS `translate:` ROWS COMPOSE THROUGH TWO VARIABLES.
// Upstream v4 writes the utility's own axis into `--tw-translate-<axis>` and
// then `translate: var(--tw-translate-x) var(--tw-translate-y)`; the other axis
// reads its `@property` initial value `0` unless a sibling token set it. The
// identity default is not a theme entry — front 54's `extendTheme` panics on a
// name in no namespace and `--tw-` is in none of `Ns`'s nineteen — it is an
// `@property` BLOCK each translate sheet carries (`twProperty`, deduplicated by
// header at flush), plus the `@layer properties` fallback `output.bp` writes for
// an engine without `@property`. So `[.TranslateX.Half, .TranslateY.Half]`
// moves diagonally, as upstream's does.
//
// (3) `§ 16.7`'s `transform-cpu` / `transform-gpu` ROWS ARE v3's. The reference
// prints a `translate(…) rotate(…) skewX(…) scaleX(…)` chain over seven
// variables; upstream v4 prints the five-variable chain of (1) — the one the
// skew leaves write — with `translateZ(0)` in front for `Gpu`. The leaves emit
// upstream's, so a `Cpu` beside a `SkewX` keeps the skew.

// The one place this front spells a namespace prefix.
fn perspectiveVar(name: string) -> string {
    return themeVar(nsPrefix(Ns.Perspective) + name);
}

// The `--tw-*` axis names of `§ 16.10` and `§ 16.7`, each written once and read
// from every side that needs it. They are NOT theme names — see note (2) above,
// and the walk at the foot of this block, which pins the reason.
fn twTranslateX() -> string {
    return "--tw-translate-x";
}

fn twTranslateY() -> string {
    return "--tw-translate-y";
}

// ── `§ 16.4` · rotate ────────────────────────────────────────────────────────
//
// `rotate` is an INDEPENDENT CSS PROPERTY in v4 and not a `transform` function,
// which is what lets `.Transform.Rotate.180` and `.Transform.Origin.TopLeft`
// compose in one rule with no chain behind them.

fn transformRotateDecl(value: string) -> string {
    return "rotate:" + value + "deg";
}

fn transformRotateToCss(r: Token.Transform.Rotate, th: Theme) -> string {
    val out = case r {
        __0 -> transformRotateDecl("0");
        __1 -> transformRotateDecl("1");
        __45 -> transformRotateDecl("45");
        __90 -> transformRotateDecl("90");
        __180 -> transformRotateDecl("180");
        Neg(_inner) -> transformRotateNegToCss(_inner);
    };
    return out;
}

// The negative half. `§ 16.4`'s HTML example names `-rotate-12`; the other four
// magnitudes mirror the positive table. All five are CONFIRMED against
// upstream v4 (4.3.2, compiled), which negates by multiplying rather than by a
// sign in the literal: `-rotate-12` is `rotate: calc(12deg * -1)`, the shape
// every negative v4 utility takes.
fn transformRotateNegDecl(value: string) -> string {
    return "rotate:calc(" + value + "deg * -1)";
}

fn transformRotateNegToCss(r: Token.Transform.Rotate.Neg) -> string {
    val out = case r {
        __1 -> transformRotateNegDecl("1");
        __12 -> transformRotateNegDecl("12");
        __45 -> transformRotateNegDecl("45");
        __90 -> transformRotateNegDecl("90");
        __180 -> transformRotateNegDecl("180");
    };
    return out;
}

// ── `§ 16.5` · scale ─────────────────────────────────────────────────────────
//
// UPSTREAM v4's FORM (4.3.2, compiled), the correction front 45's translate
// took: a step is a PERCENTAGE written into `--tw-scale-<axis>`, and the
// utility then writes `scale:var(--tw-scale-x) var(--tw-scale-y)`. `scale-50`
// is `--tw-scale-x:50%;--tw-scale-y:50%;--tw-scale-z:50%` + the reader;
// `scale-x-50` writes its own axis only, so `[.ScaleX.50, .ScaleY.150]`
// composes into one `scale`, as upstream's does. The three variables are
// registered with `@property` (initial value `1`, `scaleProperties()`), so an
// axis nobody set reads as identity. The reference file's `scale:.5` /
// `scale:.5 1` spelling is v3's shape and is asserted ABSENT.
//
// THE TEN STEPS ARE WRITTEN THREE TIMES because `Token.Transform.Scale`,
// `Token.Transform.ScaleX` and `Token.Transform.ScaleY` are three distinct
// types and a `case` cannot be generic over them — front 44 carries
// `transitionDelayValue` beside `transitionDurationValue` for the same reason,
// and takes the same insurance: a test below asserts the three ladders agree
// step for step. Every step on every axis is CONFIRMED against upstream's
// compiled output (upstream's scale is functional over any integer).
fn transformScaleValue(s: Token.Transform.Scale, th: Theme) -> string {
    val out = case s {
        __0 -> "0%";
        __50 -> "50%";
        __75 -> "75%";
        __90 -> "90%";
        __95 -> "95%";
        __100 -> "100%";
        __105 -> "105%";
        __110 -> "110%";
        __125 -> "125%";
        __150 -> "150%";
    };
    return out;
}

fn transformScaleXValue(s: Token.Transform.ScaleX, th: Theme) -> string {
    val out = case s {
        __0 -> "0%";
        __50 -> "50%";
        __75 -> "75%";
        __90 -> "90%";
        __95 -> "95%";
        __100 -> "100%";
        __105 -> "105%";
        __110 -> "110%";
        __125 -> "125%";
        __150 -> "150%";
    };
    return out;
}

fn transformScaleYValue(s: Token.Transform.ScaleY, th: Theme) -> string {
    val out = case s {
        __0 -> "0%";
        __50 -> "50%";
        __75 -> "75%";
        __90 -> "90%";
        __95 -> "95%";
        __100 -> "100%";
        __105 -> "105%";
        __110 -> "110%";
        __125 -> "125%";
        __150 -> "150%";
    };
    return out;
}

fn scaleCompose() -> string {
    return "scale:" + cssVar("--tw-scale-x") + " " + cssVar("--tw-scale-y");
}

// `scale-<n>`: all three variables (upstream writes `z` too), then the reader.
fn transformScaleDecl(value: string) -> string {
    return "--tw-scale-x:"
        + value
        + ";--tw-scale-y:"
        + value
        + ";--tw-scale-z:"
        + value
        + ";"
        + scaleCompose();
}

fn transformScaleAxisDecl(axis: string, value: string) -> string {
    return "--tw-scale-" + axis + ":" + value + ";" + scaleCompose();
}

// ── `§ 16.10` · translate ────────────────────────────────────────────────────
//
// See note (2) in the banner: upstream v4's two-variable form. Every translate
// sheet also carries the three `@property` registrations (`translateProperties`).

fn translateCompose() -> string {
    return "translate:" + cssVar(twTranslateX()) + " " + cssVar(twTranslateY());
}

// `translate-<n>`, both axes at once: both variables, then the composition.
fn transformTranslateDecl(value: string) -> string {
    return twTranslateX()
        + ":"
        + value
        + ";"
        + twTranslateY()
        + ":"
        + value
        + ";"
        + translateCompose();
}

fn transformTranslateValue(t: Token.Transform.Translate, th: Theme) -> string {
    val out = case t {
        __0 -> spacing(0);
        Px -> "1px";
        __1 -> spacing(1);
        Half -> fraction(1, 2);
        Full -> "100%";
    };
    return out;
}

fn transformTranslateXDecl(value: string) -> string {
    return twTranslateX() + ":" + value + ";" + translateCompose();
}

fn transformTranslateYDecl(value: string) -> string {
    return twTranslateY() + ":" + value + ";" + translateCompose();
}

// The five steps, shared by both axes: `0`, the `1px` of `translate-x-px`
// — the reference's own literal, not a theme lookup — front 54's `spacing(1)`,
// and the two percentages. `spacing(0)` answers the bare `0` the reference
// prints, so this front spells neither a `0` nor a `rem`.
fn transformTranslateXValue(
    t: Token.Transform.TranslateX,
    th: Theme,
) -> string {
    val out = case t {
        __0 -> spacing(0);
        Px -> "1px";
        __1 -> spacing(1);
        Half -> fraction(1, 2);
        Full -> "100%";
        Neg(_inner) -> transformTranslateXNegValue(_inner);
    };
    return out;
}

// The negative half (decision 401; 314's `Neg`), upstream 4.3.2's values:
// `-translate-x-2` is `calc(var(--spacing) * -2)`, `-translate-x-px` is `-1px`,
// `-translate-x-1/2` is `calc(calc(1 / 2 * 100%) * -1)` and
// `-translate-x-full` is `-100%`.
fn transformTranslateXNegValue(t: Token.Transform.TranslateX.Neg) -> string {
    val out = case t {
        Px -> "-1px";
        __1 -> spacing(-1);
        __2 -> spacing(-2);
        Half -> "calc(" + fraction(1, 2) + " * -1)";
        Full -> "-100%";
    };
    return out;
}

fn transformTranslateYValue(
    t: Token.Transform.TranslateY,
    th: Theme,
) -> string {
    val out = case t {
        __0 -> spacing(0);
        Px -> "1px";
        __1 -> spacing(1);
        Half -> fraction(1, 2);
        Full -> "100%";
        Neg(_inner) -> transformTranslateYNegValue(_inner);
    };
    return out;
}

// The negative half (decision 401; 314's `Neg`), upstream 4.3.2's values:
// `-translate-y-2` is `calc(var(--spacing) * -2)`, `-translate-y-px` is `-1px`,
// `-translate-y-1/2` is `calc(calc(1 / 2 * 100%) * -1)` and
// `-translate-y-full` is `-100%`.
fn transformTranslateYNegValue(t: Token.Transform.TranslateY.Neg) -> string {
    val out = case t {
        Px -> "-1px";
        __1 -> spacing(-1);
        __2 -> spacing(-2);
        Half -> "calc(" + fraction(1, 2) + " * -1)";
        Full -> "-100%";
    };
    return out;
}

// ── `§ 16.6` · skew ──────────────────────────────────────────────────────────
//
// See note (1) in the banner: upstream v4's variable and chain, so the two axes
// compose. Every skew sheet carries the chain's five `@property` registrations.

// The chain upstream's skew leaves and `transform-cpu` write: every variable
// with an EMPTY fallback (`var(--tw-skew-x,)`), so an unset one is nothing.
fn transformChain() -> string {
    val names: string[] = [
        "--tw-rotate-x",
        "--tw-rotate-y",
        "--tw-rotate-z",
        "--tw-skew-x",
        "--tw-skew-y",
    ];
    return names.map({ n -> "var(" + n + ",)" }).join(" ");
}

fn transformSkewXDecl(value: string) -> string {
    return "--tw-skew-x:skewX(" + value + "deg);transform:" + transformChain();
}

fn transformSkewYDecl(value: string) -> string {
    return "--tw-skew-y:skewY(" + value + "deg);transform:" + transformChain();
}

fn transformSkewXToCss(s: Token.Transform.SkewX, th: Theme) -> string {
    val out = case s {
        __0 -> transformSkewXDecl("0");
        __1 -> transformSkewXDecl("1");
        __2 -> transformSkewXDecl("2");
        __3 -> transformSkewXDecl("3");
        __6 -> transformSkewXDecl("6");
        __12 -> transformSkewXDecl("12");
    };
    return out;
}

fn transformSkewYToCss(s: Token.Transform.SkewY, th: Theme) -> string {
    val out = case s {
        __0 -> transformSkewYDecl("0");
        __1 -> transformSkewYDecl("1");
        __2 -> transformSkewYDecl("2");
        __3 -> transformSkewYDecl("3");
        __6 -> transformSkewYDecl("6");
        __12 -> transformSkewYDecl("12");
    };
    return out;
}

// ── `§ 16.8` · transform-origin ──────────────────────────────────────────────
//
// A corner is TWO KEYWORDS SEPARATED BY A SPACE — `top right`, never
// `top-right` — the same trap front 39's eight gradient directions carry.
fn transformOriginToCss(o: Token.Transform.Origin, th: Theme) -> string {
    val out = case o {
        Center -> "transform-origin:center";
        Top -> "transform-origin:top";
        TopRight -> "transform-origin:top right";
        Right -> "transform-origin:right";
        BottomRight -> "transform-origin:bottom right";
        Bottom -> "transform-origin:bottom";
        BottomLeft -> "transform-origin:bottom left";
        Left -> "transform-origin:left";
        TopLeft -> "transform-origin:top left";
    };
    return out;
}

// ── `§ 16.9` · transform-style · `§ 16.1` · backface-visibility ──────────────
//
// THE CLASS NAME AND THE CSS VALUE DO NOT MATCH on the second row:
// `transform-3d` emits `preserve-3d`. Front 44's `transition-discrete` →
// `allow-discrete` is the same shape and gets the same treatment — a test of
// its own, because that is the row that gets written from memory and wrong.
fn transformStyleToCss(s: Token.Transform.Style, th: Theme) -> string {
    val out = case s {
        Flat -> "transform-style:flat";
        Preserve3d -> "transform-style:preserve-3d";
    };
    return out;
}

fn transformBackfaceToCss(b: Token.Transform.Backface, th: Theme) -> string {
    val out = case b {
        Visible -> "backface-visibility:visible";
        Hidden -> "backface-visibility:hidden";
    };
    return out;
}

// ── `§ 16.2` · perspective · `§ 16.3` · perspective-origin ───────────────────
//
// `perspective-none` IS A KEYWORD AND NOT A LOOKUP — upstream has no
// `--perspective-none` — and the other five are `--perspective-*` references
// whose lengths live in `transformEntries()` below. The reference prints the
// five values in parentheses beside the variable; printing the value is not
// printing a declaration, and contract `§ 4a` refuses a dispatcher that
// resolves a theme variable.
fn transformPerspectiveToCss(
    p: Token.Transform.Perspective,
    th: Theme,
) -> string {
    val out = case p {
        None -> "perspective:none";
        Dramatic -> "perspective:" + perspectiveVar("dramatic");
        Near -> "perspective:" + perspectiveVar("near");
        Normal -> "perspective:" + perspectiveVar("normal");
        Midrange -> "perspective:" + perspectiveVar("midrange");
        Distant -> "perspective:" + perspectiveVar("distant");
    };
    return out;
}

fn transformPerspectiveOriginToCss(
    p: Token.Transform.PerspectiveOrigin,
    th: Theme,
) -> string {
    val out = case p {
        Center -> "perspective-origin:center";
        Top -> "perspective-origin:top";
        Bottom -> "perspective-origin:bottom";
        Left -> "perspective-origin:left";
        Right -> "perspective-origin:right";
    };
    return out;
}

// ── `§ 16.11` · zoom ─────────────────────────────────────────────────────────
//
// `zoom-50` IS `0.5` WITH THE LEADING ZERO, four subsections away from
// `scale-50`'s `.5` WITHOUT one. Both are the reference's; neither is a typo;
// the two are asserted in adjacent lines below so that the next person to
// "normalise" one of them fails a test instead of shipping a divergence.
fn transformZoomToCss(z: Token.Transform.Zoom, th: Theme) -> string {
    val out = case z {
        __0 -> "zoom:0";
        __50 -> "zoom:0.5";
        __75 -> "zoom:0.75";
        __100 -> "zoom:1";
        __125 -> "zoom:1.25";
        __150 -> "zoom:1.5";
        __200 -> "zoom:2";
    };
    return out;
}

// ── `§ 16.7` · transform ─────────────────────────────────────────────────────
//
// See note (3) in the banner: upstream v4's rows. `transform` and
// `transform-cpu` are one leaf — `Cpu` — because upstream gives them one value.
// Neither registers a variable (upstream's `transform-cpu` emits no
// `@property`): the empty fallbacks make an unset variable nothing.
fn transformShorthandToCss(s: Token.Transform.Shorthand, th: Theme) -> string {
    val out = case s {
        None -> "transform:none";
        Cpu -> "transform:" + transformChain();
        Gpu -> "transform:translateZ(0) " + transformChain();
    };
    return out;
}

// ── the `@property` registrations ────────────────────────────────────────────
//
// Upstream registers every `--tw-*` its transform utilities write with
// `@property` (`syntax: "*"`, not inherited), the translate axes with the
// initial value `0`, the scale axes with `1` and the chain's five with none. Each is one `Block`, and
// `renderBlocks` deduplicates by header, so a class of three translate tokens
// registers each variable once.
fn twProperty(name: string, initial: string) -> Sheet {
    val tail = if (initial == "") "" else ";initial-value:" + initial;
    return blockSheet(
        "@property " + name,
        "{syntax:\"*\";inherits:false" + tail + "}",
    );
}

fn translateProperties() -> Sheet {
    return mergeSheet(
        mergeSheet(
            twProperty(twTranslateX(), "0"),
            twProperty(twTranslateY(), "0"),
        ),
        twProperty("--tw-translate-z", "0"),
    );
}

// The three scale axes, initial value `1` — upstream registers all three for
// any scale utility, so a lone `scale-x-50` reads `--tw-scale-y` as `1`.
fn scaleProperties() -> Sheet {
    return mergeSheet(
        mergeSheet(
            twProperty("--tw-scale-x", "1"),
            twProperty("--tw-scale-y", "1"),
        ),
        twProperty("--tw-scale-z", "1"),
    );
}

fn chainProperties() -> Sheet {
    val names: string[] = [
        "--tw-rotate-x",
        "--tw-rotate-y",
        "--tw-rotate-z",
        "--tw-skew-x",
        "--tw-skew-y",
    ];
    return names.fold(
        emptySheet(),
        { acc, n -> mergeSheet(acc, twProperty(n, "")) },
    );
}

// The `Transform` arm of `tokenToSheet`: the declarations, and the
// registrations of the variables they write.
fn transformSheet(t: Token.Transform, th: Theme) -> Sheet {
    val decls = declSheet(transformTokenToCss(t, th));
    val out = case t {
        TranslateX(_inner) -> mergeSheet(decls, translateProperties());
        TranslateY(_inner) -> mergeSheet(decls, translateProperties());
        Translate(_inner) -> mergeSheet(decls, translateProperties());
        SkewX(_inner) -> mergeSheet(decls, chainProperties());
        SkewY(_inner) -> mergeSheet(decls, chainProperties());
        Rotate(_inner) -> decls;
        Scale(_inner) -> mergeSheet(decls, scaleProperties());
        ScaleX(_inner) -> mergeSheet(decls, scaleProperties());
        ScaleY(_inner) -> mergeSheet(decls, scaleProperties());
        Origin(_inner) -> decls;
        Style(_inner) -> decls;
        Backface(_inner) -> decls;
        Perspective(_inner) -> decls;
        PerspectiveOrigin(_inner) -> decls;
        Zoom(_inner) -> decls;
        Shorthand(_inner) -> decls;
    };
    return out;
}

// `§ 16.1`-`§ 16.11`. `th` is the contract `§ 4a` parameter; nothing here reads
// it, because `themeVar` builds a REFERENCE and never resolves one.
fn transformTokenToCss(t: Token.Transform, th: Theme) -> string {
    val out = case t {
        Rotate(_inner) -> transformRotateToCss(_inner, th);
        Scale(_inner) -> transformScaleDecl(transformScaleValue(_inner, th));
        ScaleX(_inner) -> transformScaleAxisDecl(
            "x",
            transformScaleXValue(_inner, th),
        );
        ScaleY(_inner) -> transformScaleAxisDecl(
            "y",
            transformScaleYValue(_inner, th),
        );
        TranslateX(_inner) -> transformTranslateXDecl(
            transformTranslateXValue(_inner, th),
        );
        TranslateY(_inner) -> transformTranslateYDecl(
            transformTranslateYValue(_inner, th),
        );
        Translate(_inner) -> transformTranslateDecl(
            transformTranslateValue(_inner, th),
        );
        SkewX(_inner) -> transformSkewXToCss(_inner, th);
        SkewY(_inner) -> transformSkewYToCss(_inner, th);
        Origin(_inner) -> transformOriginToCss(_inner, th);
        Style(_inner) -> transformStyleToCss(_inner, th);
        Backface(_inner) -> transformBackfaceToCss(_inner, th);
        Perspective(_inner) -> transformPerspectiveToCss(_inner, th);
        PerspectiveOrigin(_inner) -> transformPerspectiveOriginToCss(
            _inner,
            th,
        );
        Zoom(_inner) -> transformZoomToCss(_inner, th);
        Shorthand(_inner) -> transformShorthandToCss(_inner, th);
    };
    return out;
}

// ── the theme entries this front contributes ─────────────────────────────────
//
// THE FIVE VALUES ARE NOT PROVISIONAL, and that is worth stating as plainly as
// front 44 stated the opposite about its three `--ease-*`: `§ 16.2` prints the
// variable AND its length in parentheses on every one of the five rows, so the
// names, the namespace, the shape and the VALUES are all the reference's. What
// `defaultTheme()` does not carry is the namespace at all — front 54 ships
// nineteen prefixes and populates `--color-*`, `--text-*`, `--container-*`,
// `--shadow-*` and `--animate-*` — so a project composes these the way front
// 33's palette and front 44's easings are composed:
// `extendTheme(defaultTheme(), transformEntries())`.
//
// `perspective-none` IS ABSENT ON PURPOSE. It is a CSS keyword, upstream has no
// `--perspective-none`, and an entry for it would be a sixth name this front
// invented.
pub fn transformEntries() -> ThemeEntry[] {
    val out: ThemeEntry[] = [
        ThemeEntry(name: "--perspective-dramatic", value: "100px"),
        ThemeEntry(name: "--perspective-near", value: "300px"),
        ThemeEntry(name: "--perspective-normal", value: "500px"),
        ThemeEntry(name: "--perspective-midrange", value: "800px"),
        ThemeEntry(name: "--perspective-distant", value: "1200px"),
    ];
    return out;
}

// ── the two arbitrary-value wrappers ─────────────────────────────────────────
//
// `rotate-[17deg]` IS IN THE REFERENCE — `§ 16.4`'s HTML example prints it —
// so the ROTATE escape hatch has a class behind it; what it has no column for
// is the CSS, which is `rotate:<value>` by the same `§ 16.4` table every other
// rotate row uses. The TRANSLATE escape hatch is PROVISIONAL: `§ 16` prints no
// arbitrary translate anywhere, and it exists because a translate the five
// steps do not name has no other spelling. Its property, `translate`, is the
// one `§ 16.10` sets; only the value is the author's. It writes BOTH AXES at
// once and reads neither variable — an author spelling a translate by hand is
// spelling the whole of it.
//
// WHY THESE ARE TOP-LEVEL VARIANTS and not `Transform.Rotate.Raw(…)`: a payload
// leaf nested inside an enum section cannot be constructed by any spelling
// (fronts 41 and 44 record the two error texts). The wrappers are the
// readable spelling; `[.TransformRotateRaw("17deg")]` builds the same token.
pub fn rawRotate(value: string) -> Token {
    return Token.TransformRotateRaw(value: value);
}

pub fn rawTranslate(value: string) -> Token {
    return Token.TransformTranslateRaw(value: value);
}

// ── front 45 · tests ─────────────────────────────────────────────────────────
//
// Every row of `§ 16.1`-`§ 16.11` is asserted individually: a reference row and
// a test line are the same fact written twice, and a mismatch fails the build.
// The rows the reference and upstream disagree about are asserted for what they
// DO emit and again for what they must NEVER emit, which is the half a
// one-sided test leaves open.

// ── `§ 16.4` · rotate ────────────────────────────────────────────────────────

test "Transform.Rotate — the five positive steps of `§ 16.4`" {
    assert tokenDeclarations(.Transform.Rotate.__0) == "rotate:0deg";
    assert tokenDeclarations(.Transform.Rotate.__1) == "rotate:1deg";
    assert tokenDeclarations(.Transform.Rotate.__45) == "rotate:45deg";
    assert tokenDeclarations(.Transform.Rotate.__90) == "rotate:90deg";
    assert tokenDeclarations(.Transform.Rotate.__180) == "rotate:180deg";
}

// ONE `-`, NO SPACE. A sign built by concatenation is how `rotate: - 12deg`
// gets shipped, so the whole string is asserted and the space is asserted
// absent besides.
test "Transform.Rotate.Neg — the negative half, upstream's `calc(Ndeg * -1)`" {
    assert tokenDeclarations(.Transform.Rotate.Neg.__1)
        == "rotate:calc(1deg * -1)";
    assert tokenDeclarations(.Transform.Rotate.Neg.__12)
        == "rotate:calc(12deg * -1)";
    assert tokenDeclarations(.Transform.Rotate.Neg.__45)
        == "rotate:calc(45deg * -1)";
    assert tokenDeclarations(.Transform.Rotate.Neg.__90)
        == "rotate:calc(90deg * -1)";
    assert tokenDeclarations(.Transform.Rotate.Neg.__180)
        == "rotate:calc(180deg * -1)";
    assert tokenDeclarations(.Transform.Rotate.Neg.__12).indexOf(
        "rotate:-12deg",
    )
        == -1;
    assert tokenDeclarations(.Transform.Rotate.Neg.__12).indexOf("--") == -1;
}

// `rotate` IS AN INDEPENDENT PROPERTY IN v4, not a `transform` function. A
// front that "fixed" this into `transform:rotate(45deg)` would break the
// composition the next test proves.
test "Transform.Rotate — the v4 property, never the v3 `transform:` function" {
    assert tokenDeclarations(.Transform.Rotate.__45).indexOf("transform:")
        == -1;
    assert tokenDeclarations(.Transform.Rotate.__45).indexOf("rotate(") == -1;
    assert tokenDeclarations(.Transform.Rotate.__45).startsWith("rotate:");
}

test "Transform.Translate — both axes: both variables, then the composition" {
    val c = ";translate:var(--tw-translate-x) var(--tw-translate-y)";
    assert tokenDeclarations(.Transform.Translate.__0)
        == "--tw-translate-x:0;--tw-translate-y:0" + c;
    assert tokenDeclarations(.Transform.Translate.Px)
        == "--tw-translate-x:1px;--tw-translate-y:1px" + c;
    assert tokenDeclarations(.Transform.Translate.__1)
        == "--tw-translate-x:calc(var(--spacing) * 1);--tw-translate-y:calc(var(--spacing) * 1)"
            + c;
    assert tokenDeclarations(.Transform.Translate.Half)
        == "--tw-translate-x:calc(1 / 2 * 100%);--tw-translate-y:calc(1 / 2 * 100%)"
            + c;
    assert tokenDeclarations(.Transform.Translate.Full)
        == "--tw-translate-x:100%;--tw-translate-y:100%" + c;
}

// ── `§ 16.5` · scale ─────────────────────────────────────────────────────────

test "Transform.Scale — the ten unaxed steps, upstream v4's three variables and reader" {
    val c = ";scale:var(--tw-scale-x) var(--tw-scale-y)";
    assert tokenDeclarations(.Transform.Scale.__0)
        == "--tw-scale-x:0%;--tw-scale-y:0%;--tw-scale-z:0%" + c;
    assert tokenDeclarations(.Transform.Scale.__50)
        == "--tw-scale-x:50%;--tw-scale-y:50%;--tw-scale-z:50%" + c;
    assert tokenDeclarations(.Transform.Scale.__75)
        == "--tw-scale-x:75%;--tw-scale-y:75%;--tw-scale-z:75%" + c;
    assert tokenDeclarations(.Transform.Scale.__90)
        == "--tw-scale-x:90%;--tw-scale-y:90%;--tw-scale-z:90%" + c;
    assert tokenDeclarations(.Transform.Scale.__95)
        == "--tw-scale-x:95%;--tw-scale-y:95%;--tw-scale-z:95%" + c;
    assert tokenDeclarations(.Transform.Scale.__100)
        == "--tw-scale-x:100%;--tw-scale-y:100%;--tw-scale-z:100%" + c;
    assert tokenDeclarations(.Transform.Scale.__105)
        == "--tw-scale-x:105%;--tw-scale-y:105%;--tw-scale-z:105%" + c;
    assert tokenDeclarations(.Transform.Scale.__110)
        == "--tw-scale-x:110%;--tw-scale-y:110%;--tw-scale-z:110%" + c;
    assert tokenDeclarations(.Transform.Scale.__125)
        == "--tw-scale-x:125%;--tw-scale-y:125%;--tw-scale-z:125%" + c;
    assert tokenDeclarations(.Transform.Scale.__150)
        == "--tw-scale-x:150%;--tw-scale-y:150%;--tw-scale-z:150%" + c;
}

// THE REFERENCE FILE'S v3 SHAPE IS ABSENT: no bare `scale:.5`, no two-value
// `scale:.5 1`, and no step without its `%`.
test "Transform.Scale — the reference's `scale:.5` / `scale:.5 1` spelling is absent" {
    assert tokenDeclarations(.Transform.Scale.__50).indexOf("scale:.5") == -1;
    assert tokenDeclarations(.Transform.ScaleX.__50).indexOf("scale:.5 1")
        == -1;
    assert tokenDeclarations(.Transform.ScaleY.__50).indexOf("scale:1 .5")
        == -1;
    assert tokenDeclarations(.Transform.Scale.__100).indexOf("scale:1;") == -1;
}

// THE TWO AXES, IN ADJACENT LINES. A copy-paste between them — the axis
// letter — is invisible to a one-sided test and is the likeliest defect.
test "Transform.ScaleX / ScaleY — each writes its own axis, and the one reader" {
    val c = ";scale:var(--tw-scale-x) var(--tw-scale-y)";
    assert tokenDeclarations(.Transform.ScaleX.__50) == "--tw-scale-x:50%" + c;
    assert tokenDeclarations(.Transform.ScaleY.__50) == "--tw-scale-y:50%" + c;
    assert tokenDeclarations(.Transform.ScaleX.__150)
        == "--tw-scale-x:150%" + c;
    assert tokenDeclarations(.Transform.ScaleY.__150)
        == "--tw-scale-y:150%" + c;
}

// THE TWO AXES COMPOSE: one reader, two variables — the reason for the change.
test "Transform.ScaleX + ScaleY — two tokens, one scale, and the axes registered at 1" {
    val tokens: Token[] = [.Transform.ScaleX.__50, .Transform.ScaleY.__150];
    val sheet = tokensToSheet(tokens, defaultTheme());
    assert declarationsOf(sheet).join(";")
        == "--tw-scale-x:50%;scale:var(--tw-scale-x) var(--tw-scale-y);--tw-scale-y:150%;scale:var(--tw-scale-x) var(--tw-scale-y)";
    assert sheet.blocks.any(
        { b -> b.header == "@property --tw-scale-y" && b.body.endsWith("initial-value:1}") },
    );
    assert sheet.blocks.any(
        { b -> b.header == "@property --tw-scale-z" && b.body.endsWith("initial-value:1}") },
    );
}

// THE THREE LADDERS ARE COMPARED TO EACH OTHER AND NOT TO A FOURTH LIST OF
// LITERALS — front 44's insurance over `Duration` and `Delay`, for the same
// reason: the three `case`s exist only because the three types are distinct.
test "Transform.Scale — the three ladders agree step for step" {
    val unaxed: Token[] = [
        .Transform.Scale.__0,
        .Transform.Scale.__50,
        .Transform.Scale.__75,
        .Transform.Scale.__90,
        .Transform.Scale.__95,
        .Transform.Scale.__100,
        .Transform.Scale.__105,
        .Transform.Scale.__110,
        .Transform.Scale.__125,
        .Transform.Scale.__150,
    ];
    val xs: Token[] = [
        .Transform.ScaleX.__0,
        .Transform.ScaleX.__50,
        .Transform.ScaleX.__75,
        .Transform.ScaleX.__90,
        .Transform.ScaleX.__95,
        .Transform.ScaleX.__100,
        .Transform.ScaleX.__105,
        .Transform.ScaleX.__110,
        .Transform.ScaleX.__125,
        .Transform.ScaleX.__150,
    ];
    val ys: Token[] = [
        .Transform.ScaleY.__0,
        .Transform.ScaleY.__50,
        .Transform.ScaleY.__75,
        .Transform.ScaleY.__90,
        .Transform.ScaleY.__95,
        .Transform.ScaleY.__100,
        .Transform.ScaleY.__105,
        .Transform.ScaleY.__110,
        .Transform.ScaleY.__125,
        .Transform.ScaleY.__150,
    ];
    val c = ";scale:var(--tw-scale-x) var(--tw-scale-y)";
    val steps = unaxed.map(
        { t -> (tokenDeclarations(t).split(";").at(0) ?? "").split(":").at(1) ?? "" },
    );
    val fromX = xs.map({ t -> tokenDeclarations(t) });
    val fromY = ys.map({ t -> tokenDeclarations(t) });
    assert steps.length == 10;
    assert steps.all({ v -> v.endsWith("%") });
    assert fromX.join("|")
        == steps.map({ v -> "--tw-scale-x:" + v + c }).join("|");
    assert fromY.join("|")
        == steps.map({ v -> "--tw-scale-y:" + v + c }).join("|");
}

// ── `§ 16.10` · translate ────────────────────────────────────────────────────

test "Transform.TranslateX — the five rows of `§ 16.10`, upstream v4's form" {
    val c = ";translate:var(--tw-translate-x) var(--tw-translate-y)";
    assert tokenDeclarations(.Transform.TranslateX.__0)
        == "--tw-translate-x:0" + c;
    assert tokenDeclarations(.Transform.TranslateX.Px)
        == "--tw-translate-x:1px" + c;
    assert tokenDeclarations(.Transform.TranslateX.__1)
        == "--tw-translate-x:calc(var(--spacing) * 1)" + c;
    assert tokenDeclarations(.Transform.TranslateX.Half)
        == "--tw-translate-x:calc(1 / 2 * 100%)" + c;
    assert tokenDeclarations(.Transform.TranslateX.Full)
        == "--tw-translate-x:100%" + c;
}

// THE Y MIRROR, IN ADJACENT LINES, and CONFIRMED rather than interpolated: the
// reference file omits the five `translate-y-*` rows and upstream prints them.
// A swapped variable is the likeliest defect here.
test "Transform.TranslateY — the same five rows on the other axis" {
    val c = ";translate:var(--tw-translate-x) var(--tw-translate-y)";
    assert tokenDeclarations(.Transform.TranslateY.__0)
        == "--tw-translate-y:0" + c;
    assert tokenDeclarations(.Transform.TranslateY.Px)
        == "--tw-translate-y:1px" + c;
    assert tokenDeclarations(.Transform.TranslateY.__1)
        == "--tw-translate-y:calc(var(--spacing) * 1)" + c;
    assert tokenDeclarations(.Transform.TranslateY.Half)
        == "--tw-translate-y:calc(1 / 2 * 100%)" + c;
    assert tokenDeclarations(.Transform.TranslateY.Full)
        == "--tw-translate-y:100%" + c;
}

// Decision 401 · MEASURED AGAINST TAILWIND 4.3.2 (`compile().build()` of
// `-translate-y-2 -translate-x-2 -translate-x-px -translate-y-1/2
// -translate-x-full -translate-y-full -translate-x-1`): each utility is
// `--tw-translate-<axis>: <value>; translate: var(--tw-translate-x)
// var(--tw-translate-y)` with the values below.
test "Transform.TranslateX.Neg / TranslateY.Neg — 4.3.2's negative values" {
    val c = ";translate:var(--tw-translate-x) var(--tw-translate-y)";
    assert tokenDeclarations(.Transform.TranslateY.Neg.__2)
        == "--tw-translate-y:calc(var(--spacing) * -2)" + c;
    assert tokenDeclarations(.Transform.TranslateX.Neg.__2)
        == "--tw-translate-x:calc(var(--spacing) * -2)" + c;
    assert tokenDeclarations(.Transform.TranslateX.Neg.__1)
        == "--tw-translate-x:calc(var(--spacing) * -1)" + c;
    assert tokenDeclarations(.Transform.TranslateX.Neg.Px)
        == "--tw-translate-x:-1px" + c;
    assert tokenDeclarations(.Transform.TranslateY.Neg.Half)
        == "--tw-translate-y:calc(calc(1 / 2 * 100%) * -1)" + c;
    assert tokenDeclarations(.Transform.TranslateX.Neg.Full)
        == "--tw-translate-x:-100%" + c;
    assert tokenDeclarations(.Transform.TranslateY.Neg.Full)
        == "--tw-translate-y:-100%" + c;
}

test "Transform.TranslateY.Neg — the sheet carries the three `@property` blocks" {
    val one: Token[] = [.Transform.TranslateY.Neg.__2];
    val blocks = tokensToSheet(one, defaultTheme()).blocks;
    assert blocks.map({ b -> b.header }).join("|")
        == "@property --tw-translate-x|@property --tw-translate-y|@property --tw-translate-z";
}

// `translate-x-1` IS `spacing(1)` AND NEVER A `rem`. Asserted against front
// 54's function's OUTPUT and not against a second transcription of it, which is
// the only version of this assertion that survives a change to the ladder.
test "Transform.TranslateX.1 — front 54's spacing, not a resolved length" {
    assert tokenDeclarations(.Transform.TranslateX.__1).indexOf(spacing(1))
        != -1;
    assert tokenDeclarations(.Transform.TranslateX.__1).indexOf("rem") == -1;
    assert spacing(1) == "calc(var(--spacing) * 1)";
    assert tokenDeclarations(.Transform.TranslateX.__0).indexOf("calc(") == -1;
}

// THE TWO AXES COMPOSE: each token writes its own variable, and the
// composition both repeat reads the two, so `[.TranslateX.Half,
// .TranslateY.Half]` moves an element diagonally — upstream v4's behaviour.
test "Transform.Translate — two axes write two variables, and the element moves on both" {
    val both: Token[] = [
        .Transform.TranslateX.Half,
        .Transform.TranslateY.Half,
    ];
    val decls = declarationsOf(tokensToSheet(both, defaultTheme()));
    assert decls.length == 2;
    assert decls.join(";").indexOf("--tw-translate-x:calc(1 / 2 * 100%)") != -1;
    assert decls.join(";").indexOf("--tw-translate-y:calc(1 / 2 * 100%)") != -1;
    assert decls.all(
        { d -> d.endsWith(";translate:var(--tw-translate-x) var(--tw-translate-y)") },
    );
}

// EVERY TRANSLATE SHEET REGISTERS THE THREE AXES, the translate axes with
// upstream's initial `0`, and nothing else does. Unregistered, a lone
// `translate-x-4` would read an unset `--tw-translate-y` and move nothing.
test "Transform.Translate — the sheet carries upstream's three `@property` blocks" {
    val one: Token[] = [.Transform.TranslateX.Half];
    val blocks = tokensToSheet(one, defaultTheme()).blocks;
    assert blocks.map({ b -> b.header }).join("|")
        == "@property --tw-translate-x|@property --tw-translate-y|@property --tw-translate-z";
    assert blocks.all(
        { b -> b.body == "{syntax:\"*\";inherits:false;initial-value:0}" },
    );
    val rot: Token[] = [.Transform.Rotate.__45];
    assert tokensToSheet(rot, defaultTheme()).blocks.length == 0;
}

// ── `§ 16.6` · skew ──────────────────────────────────────────────────────────

fn skewChain() -> string {
    return ";transform:var(--tw-rotate-x,) var(--tw-rotate-y,) var(--tw-rotate-z,) var(--tw-skew-x,) var(--tw-skew-y,)";
}

test "Transform.SkewX — upstream v4's variable and chain, all six steps" {
    assert tokenDeclarations(.Transform.SkewX.__0)
        == "--tw-skew-x:skewX(0deg)" + skewChain();
    assert tokenDeclarations(.Transform.SkewX.__1)
        == "--tw-skew-x:skewX(1deg)" + skewChain();
    assert tokenDeclarations(.Transform.SkewX.__2)
        == "--tw-skew-x:skewX(2deg)" + skewChain();
    assert tokenDeclarations(.Transform.SkewX.__3)
        == "--tw-skew-x:skewX(3deg)" + skewChain();
    assert tokenDeclarations(.Transform.SkewX.__6)
        == "--tw-skew-x:skewX(6deg)" + skewChain();
    assert tokenDeclarations(.Transform.SkewX.__12)
        == "--tw-skew-x:skewX(12deg)" + skewChain();
}

test "Transform.SkewY — the same six on the other axis" {
    assert tokenDeclarations(.Transform.SkewY.__0)
        == "--tw-skew-y:skewY(0deg)" + skewChain();
    assert tokenDeclarations(.Transform.SkewY.__1)
        == "--tw-skew-y:skewY(1deg)" + skewChain();
    assert tokenDeclarations(.Transform.SkewY.__2)
        == "--tw-skew-y:skewY(2deg)" + skewChain();
    assert tokenDeclarations(.Transform.SkewY.__3)
        == "--tw-skew-y:skewY(3deg)" + skewChain();
    assert tokenDeclarations(.Transform.SkewY.__6)
        == "--tw-skew-y:skewY(6deg)" + skewChain();
    assert tokenDeclarations(.Transform.SkewY.__12)
        == "--tw-skew-y:skewY(12deg)" + skewChain();
}

// The chain's five variables are registered, with no initial value — the
// empty fallbacks carry an unset one — on every skew sheet.
test "Transform.Skew — the sheet carries the chain's five `@property` blocks" {
    val one: Token[] = [.Transform.SkewY.__6];
    val blocks = tokensToSheet(one, defaultTheme()).blocks;
    assert blocks.map({ b -> b.header }).join("|")
        == "@property --tw-rotate-x|@property --tw-rotate-y|@property --tw-rotate-z|@property --tw-skew-x|@property --tw-skew-y";
    assert blocks.all({ b -> b.body == "{syntax:\"*\";inherits:false}" });
}

// THE REFERENCE FILE'S OWN COLUMN, ASSERTED ABSENT. `§ 16.6` writes
// `skew-x: 1deg`; it is not a registered CSS property, and upstream writes the
// variable and the chain instead. If a later front restores the reference
// file's column, this reds.
test "Transform.Skew — the reference file's `skew-x:` column is never emitted, and the axes compose" {
    assert tokenDeclarations(.Transform.SkewX.__1).startsWith("skew-x")
        == false;
    assert tokenDeclarations(.Transform.SkewX.__1).indexOf(";skew-x:") == -1;
    assert tokenDeclarations(.Transform.SkewY.__1).indexOf(";skew-y:") == -1;
    // each axis writes its own variable, and both read the one chain
    val both: Token[] = [.Transform.SkewX.__3, .Transform.SkewY.__6];
    val decls = declarationsOf(tokensToSheet(both, defaultTheme())).join(";");
    assert decls.indexOf("--tw-skew-x:skewX(3deg)") != -1;
    assert decls.indexOf("--tw-skew-y:skewY(6deg)") != -1;
}

// ── `§ 16.8` · transform-origin ──────────────────────────────────────────────

test "Transform.Origin — the nine rows of `§ 16.8`" {
    assert tokenDeclarations(.Transform.Origin.Center)
        == "transform-origin:center";
    assert tokenDeclarations(.Transform.Origin.Top) == "transform-origin:top";
    assert tokenDeclarations(.Transform.Origin.TopRight)
        == "transform-origin:top right";
    assert tokenDeclarations(.Transform.Origin.Right)
        == "transform-origin:right";
    assert tokenDeclarations(.Transform.Origin.BottomRight)
        == "transform-origin:bottom right";
    assert tokenDeclarations(.Transform.Origin.Bottom)
        == "transform-origin:bottom";
    assert tokenDeclarations(.Transform.Origin.BottomLeft)
        == "transform-origin:bottom left";
    assert tokenDeclarations(.Transform.Origin.Left) == "transform-origin:left";
    assert tokenDeclarations(.Transform.Origin.TopLeft)
        == "transform-origin:top left";
}

test "Transform.Origin — a corner is two keywords, not a hyphenated one" {
    assert tokenDeclarations(.Transform.Origin.TopRight).indexOf("top-right")
        == -1;
    assert tokenDeclarations(.Transform.Origin.BottomLeft).indexOf(
        "bottom-left",
    )
        == -1;
    assert tokenDeclarations(.Transform.Origin.TopLeft).indexOf("top left")
        != -1;
}

// ── `§ 16.9`, `§ 16.1` · transform-style and backface-visibility ─────────────

// THE NAME-VERSUS-VALUE TRAP: `transform-3d` emits `preserve-3d`.
test "Transform.Style / Backface — four rows, and the `3d` → `preserve-3d` trap" {
    assert tokenDeclarations(.Transform.Style.Flat) == "transform-style:flat";
    assert tokenDeclarations(.Transform.Style.Preserve3d)
        == "transform-style:preserve-3d";
    assert tokenDeclarations(.Transform.Style.Preserve3d).indexOf(
        "transform-style:3d",
    )
        == -1;
    assert tokenDeclarations(.Transform.Backface.Visible)
        == "backface-visibility:visible";
    assert tokenDeclarations(.Transform.Backface.Hidden)
        == "backface-visibility:hidden";
}

// ── `§ 16.2`, `§ 16.3` · perspective and perspective-origin ──────────────────

// FIVE REFERENCES AND ONE KEYWORD, AND NO `px` ANYWHERE. The lengths the
// reference prints in parentheses are in `transformEntries()`, which is the
// whole point of the row.
test "Transform.Perspective — six rows, five of them theme references" {
    assert tokenDeclarations(.Transform.Perspective.None) == "perspective:none";
    assert tokenDeclarations(.Transform.Perspective.Dramatic)
        == "perspective:var(--perspective-dramatic)";
    assert tokenDeclarations(.Transform.Perspective.Near)
        == "perspective:var(--perspective-near)";
    assert tokenDeclarations(.Transform.Perspective.Normal)
        == "perspective:var(--perspective-normal)";
    assert tokenDeclarations(.Transform.Perspective.Midrange)
        == "perspective:var(--perspective-midrange)";
    assert tokenDeclarations(.Transform.Perspective.Distant)
        == "perspective:var(--perspective-distant)";
}

// THE REFERENCE BUILDER'S OUTPUT, NOT A RETYPED LITERAL — and the namespace is
// front 54's, not a prefix this front spells by hand.
test "Transform.Perspective — the reference is front 54's, prefix included" {
    assert tokenDeclarations(.Transform.Perspective.Near)
        == "perspective:" + themeVar(nsPrefix(Ns.Perspective) + "near");
    assert nsPrefix(Ns.Perspective) == "--perspective-";
    assert tokenDeclarations(.Transform.Perspective.Near).indexOf("300px")
        == -1;
    assert tokenDeclarations(.Transform.Perspective.Distant).indexOf("px")
        == -1;
}

test "Transform.PerspectiveOrigin — the five rows of `§ 16.3`" {
    assert tokenDeclarations(.Transform.PerspectiveOrigin.Center)
        == "perspective-origin:center";
    assert tokenDeclarations(.Transform.PerspectiveOrigin.Top)
        == "perspective-origin:top";
    assert tokenDeclarations(.Transform.PerspectiveOrigin.Bottom)
        == "perspective-origin:bottom";
    assert tokenDeclarations(.Transform.PerspectiveOrigin.Left)
        == "perspective-origin:left";
    assert tokenDeclarations(.Transform.PerspectiveOrigin.Right)
        == "perspective-origin:right";
}

// ── `§ 16.11` · zoom, and the two decimal conventions ────────────────────────

test "Transform.Zoom — the seven rows of `§ 16.11`" {
    assert tokenDeclarations(.Transform.Zoom.__0) == "zoom:0";
    assert tokenDeclarations(.Transform.Zoom.__50) == "zoom:0.5";
    assert tokenDeclarations(.Transform.Zoom.__75) == "zoom:0.75";
    assert tokenDeclarations(.Transform.Zoom.__100) == "zoom:1";
    assert tokenDeclarations(.Transform.Zoom.__125) == "zoom:1.25";
    assert tokenDeclarations(.Transform.Zoom.__150) == "zoom:1.5";
    assert tokenDeclarations(.Transform.Zoom.__200) == "zoom:2";
}

// THE TWO CONVENTIONS, IN ADJACENT LINES. A scale step is a percentage in a
// variable (upstream v4) and `§ 16.11`'s zoom is a bare number with its leading
// zero. Whoever "normalises" one into the other fails this test.
test "Transform — `--tw-scale-x:50%` and `zoom:0.5`, two conventions on purpose" {
    assert tokenDeclarations(.Transform.ScaleX.__50).startsWith(
        "--tw-scale-x:50%;",
    );
    assert tokenDeclarations(.Transform.Zoom.__50) == "zoom:0.5";
}

// ── `§ 16.7` · the shorthand, verbatim and inert ─────────────────────────────

test "Transform.Shorthand — upstream v4's three rows" {
    assert tokenDeclarations(.Transform.Shorthand.None) == "transform:none";
    assert tokenDeclarations(.Transform.Shorthand.Cpu)
        == "transform:var(--tw-rotate-x,) var(--tw-rotate-y,) var(--tw-rotate-z,) var(--tw-skew-x,) var(--tw-skew-y,)";
    assert tokenDeclarations(.Transform.Shorthand.Gpu)
        == "transform:translateZ(0) var(--tw-rotate-x,) var(--tw-rotate-y,) var(--tw-rotate-z,) var(--tw-skew-x,) var(--tw-skew-y,)";
}

// THE CHAIN `Cpu` READS IS THE ONE THE SKEW LEAVES WRITE, so a `Cpu` beside a
// `SkewX` keeps the skew rather than overwriting it with an identity. The
// variables are written by the translate, scale and skew leaves and by nothing else.
test "Transform.Shorthand — the chain it reads is the skew leaves' chain" {
    val cpu = tokenDeclarations(.Transform.Shorthand.Cpu);
    assert tokenDeclarations(.Transform.SkewX.__3).endsWith(cpu);
    assert tokenDeclarations(.Transform.Shorthand.Gpu).startsWith(
        "transform:translateZ(0) ",
    );
    val writers = front45Leaves().filter(
        { t -> tokenDeclarations(t).startsWith("--tw-") },
    );
    assert writers.length == 54;
    val shorthand: Token[] = [.Transform.Shorthand.Cpu];
    assert tokensToSheet(shorthand, defaultTheme()).blocks.length == 0;
}

// ── the two arbitrary-value variants ─────────────────────────────────────────

// THE CHECK THAT WOULD HAVE FAILED AGAINST A NESTED `Transform.Rotate.Raw`: a
// payload leaf inside a section type-checks in a `case` arm and is reachable by
// no spelling, so this test is the one that distinguishes a surface that works
// from one that only looks complete.
test "TransformRotateRaw / TransformTranslateRaw — they construct, and they emit" {
    val r = Token.TransformRotateRaw(value: "17deg");
    val t = Token.TransformTranslateRaw(value: "10px 20px");
    val list: Token[] = [r, t];
    val decls = declarationsOf(tokensToSheet(list, defaultTheme()));
    assert (decls.at(0) ?? "") == "rotate:17deg";
    assert (decls.at(1) ?? "") == "translate:10px 20px";
}

// The wrappers and the leading-dot payload call build the same token.
test "rawRotate / rawTranslate — the wrappers, and the leading-dot form beside them" {
    val list: Token[] = [rawRotate("17deg"), rawTranslate("-50% -50%")];
    val decls = declarationsOf(tokensToSheet(list, defaultTheme()));
    assert (decls.at(0) ?? "") == "rotate:17deg";
    assert (decls.at(1) ?? "") == "translate:-50% -50%";
    val dotted: Token[] = [
        .TransformRotateRaw("17deg"),
        .TransformTranslateRaw("-50% -50%"),
    ];
    assert declarationsOf(tokensToSheet(dotted, defaultTheme())).join(";")
        == decls.join(";");
}

// ── the theme entries ────────────────────────────────────────────────────────

test "transformEntries — the five `--perspective-*` of `§ 16.2`" {
    val es = transformEntries();
    assert es.length == 5;
    assert es.all({ e -> e.name.startsWith(nsPrefix(Ns.Perspective)) });
    val th = extendTheme(defaultTheme(), transformEntries());
    assert themeValue(th, "--perspective-dramatic") == "100px";
    assert themeValue(th, "--perspective-near") == "300px";
    assert themeValue(th, "--perspective-normal") == "500px";
    assert themeValue(th, "--perspective-midrange") == "800px";
    assert themeValue(th, "--perspective-distant") == "1200px";
}

// `defaultTheme()` DOES NOT CARRY THE NAMESPACE — front 54 populates five of
// its nineteen and this is a sixth. Asserted so that a later front adding
// `--perspective-*` to `defaultTheme()` finds this line rather than shipping
// two transcriptions of one table (front 38 and front 44's rule).
test "transformEntries — front 54's stock theme carries none of them" {
    assert themeValue(defaultTheme(), "--perspective-near") == "";
    assert namespace(defaultTheme(), Ns.Perspective).length == 0;
    assert namespace(
        extendTheme(defaultTheme(), transformEntries()),
        Ns.Perspective,
    ).length
        == 5;
}

// A PROJECT'S OWN PERSPECTIVE REACHES THE RULE AND THE CLASS DOES NOT MOVE —
// the argument for a reference over a literal, asserted rather than claimed.
test "transformEntries — an override moves the theme layer and not one rule" {
    val mine: ThemeEntry[] = [
        ThemeEntry(name: "--perspective-near", value: "42px"),
    ];
    val a = extendTheme(defaultTheme(), transformEntries());
    val b = extendTheme(a, mine);
    val tokens: Token[] = [.Transform.Perspective.Near];
    assert emiliaWith(tokens, a) == emiliaWith(tokens, b);
    assert declarationsOf(tokensToSheet(tokens, b)).join(";")
        == "perspective:var(--perspective-near)";
    assert themeValue(b, "--perspective-near") == "42px";
}

// ── composition, nesting and determinism ─────────────────────────────────────

// THE REALISTIC USE OF THIS FRONT, and the one that needs no chain: `rotate`
// and `transform-origin` are two independent properties in v4, so one rule
// carries both and neither overwrites the other.
test "Transform — a rotation about a corner is two properties in one rule" {
    val tokens: Token[] = [.Transform.Rotate.__180, .Transform.Origin.TopLeft];
    val decls = declarationsOf(tokensToSheet(tokens, defaultTheme()));
    assert decls.length == 2;
    assert (decls.at(0) ?? "") == "rotate:180deg";
    assert (decls.at(1) ?? "") == "transform-origin:top left";
}

// `rotate`, `scale` AND `translate` ARE THREE PROPERTIES, so all three compose
// — which is the v4 change the whole front rests on and the reason the 1.0.8
// draft's `transform:rotate(…) scale(…)` shape is superseded.
test "Transform — rotate, scale and translate coexist in one rule" {
    val tokens: Token[] = [
        .Transform.Rotate.__45,
        .Transform.Scale.__110,
        .Transform.TranslateY.Full,
    ];
    val decls = declarationsOf(tokensToSheet(tokens, defaultTheme()));
    assert decls.length == 3;
    assert decls.join(";")
        == "rotate:45deg;--tw-scale-x:110%;--tw-scale-y:110%;--tw-scale-z:110%;scale:var(--tw-scale-x) var(--tw-scale-y);--tw-translate-y:100%;translate:var(--tw-translate-x) var(--tw-translate-y)";
}

// A TRANSFORM UNDER A MODIFIER — front 34's `nestVariant`, asserted for the
// DECLARATION rather than for the wrap, which is front 34's to assert.
test "Transform — a scale under Hover reaches front 34's variant" {
    val inner: Token[] = [.Transform.Scale.__105];
    val outer: Token[] = [Token.Hover(inner)];
    val s = tokensToSheet(outer, defaultTheme());
    assert declarationsOf(s).join(";")
        == "--tw-scale-x:105%;--tw-scale-y:105%;--tw-scale-z:105%;scale:var(--tw-scale-x) var(--tw-scale-y)";
    assert firstRuleOf(s).selector == "&:hover";
}

// DETERMINISM ACROSS TARGETS. The class name for a fixed token list under a
// fixed theme is asserted as a LITERAL, so `commonJS` and `erlang` must fold
// the same djb2 over the same encoded sheet. Every byte here is ASCII, which is
// the condition the two hashes agree under.
test "Transform — the class name is a literal, and both targets must agree" {
    val tokens: Token[] = [
        .Transform.Rotate.Neg.__12,
        .Transform.Origin.BottomRight,
        .Transform.Perspective.Near,
    ];
    assert emiliaWith(tokens, defaultTheme()) == "e_aba4fd6f";
}

// ── the regression walks ─────────────────────────────────────────────────────

fn f45RotateLeaves() -> Token[] {
    val leaves: Token[] = [
        .Transform.Rotate.__0,
        .Transform.Rotate.__1,
        .Transform.Rotate.__45,
        .Transform.Rotate.__90,
        .Transform.Rotate.__180,
        .Transform.Rotate.Neg.__1,
        .Transform.Rotate.Neg.__12,
        .Transform.Rotate.Neg.__45,
        .Transform.Rotate.Neg.__90,
        .Transform.Rotate.Neg.__180,
    ];
    return leaves;
}

fn f45ScaleLeaves() -> Token[] {
    val leaves: Token[] = [
        .Transform.Scale.__0,
        .Transform.Scale.__50,
        .Transform.Scale.__75,
        .Transform.Scale.__90,
        .Transform.Scale.__95,
        .Transform.Scale.__100,
        .Transform.Scale.__105,
        .Transform.Scale.__110,
        .Transform.Scale.__125,
        .Transform.Scale.__150,
        .Transform.ScaleX.__0,
        .Transform.ScaleX.__50,
        .Transform.ScaleX.__75,
        .Transform.ScaleX.__90,
        .Transform.ScaleX.__95,
        .Transform.ScaleX.__100,
        .Transform.ScaleX.__105,
        .Transform.ScaleX.__110,
        .Transform.ScaleX.__125,
        .Transform.ScaleX.__150,
        .Transform.ScaleY.__0,
        .Transform.ScaleY.__50,
        .Transform.ScaleY.__75,
        .Transform.ScaleY.__90,
        .Transform.ScaleY.__95,
        .Transform.ScaleY.__100,
        .Transform.ScaleY.__105,
        .Transform.ScaleY.__110,
        .Transform.ScaleY.__125,
        .Transform.ScaleY.__150,
    ];
    return leaves;
}

// THE TWO `Px` LEAVES ARE NOT IN THIS LIST. Their `1px` is the reference's own
// literal value — `translate-x-px` IS a pixel utility — so they would fail the
// length probe for the one reason that is correct. They are asserted from the
// other side in the controls test, which is front 41's treatment of
// `Shadow.Inner`.
fn f45TranslateLeaves() -> Token[] {
    val leaves: Token[] = [
        .Transform.TranslateX.__0,
        .Transform.TranslateX.__1,
        .Transform.TranslateX.Half,
        .Transform.TranslateX.Full,
        .Transform.TranslateY.__0,
        .Transform.TranslateY.__1,
        .Transform.TranslateY.Half,
        .Transform.TranslateY.Full,
        .Transform.Translate.__0,
        .Transform.Translate.__1,
        .Transform.Translate.Half,
        .Transform.Translate.Full,
    ];
    return leaves;
}

fn f45SkewLeaves() -> Token[] {
    val leaves: Token[] = [
        .Transform.SkewX.__0,
        .Transform.SkewX.__1,
        .Transform.SkewX.__2,
        .Transform.SkewX.__3,
        .Transform.SkewX.__6,
        .Transform.SkewX.__12,
        .Transform.SkewY.__0,
        .Transform.SkewY.__1,
        .Transform.SkewY.__2,
        .Transform.SkewY.__3,
        .Transform.SkewY.__6,
        .Transform.SkewY.__12,
    ];
    return leaves;
}

fn f45KeywordLeaves() -> Token[] {
    val leaves: Token[] = [
        .Transform.Origin.Center,
        .Transform.Origin.Top,
        .Transform.Origin.TopRight,
        .Transform.Origin.Right,
        .Transform.Origin.BottomRight,
        .Transform.Origin.Bottom,
        .Transform.Origin.BottomLeft,
        .Transform.Origin.Left,
        .Transform.Origin.TopLeft,
        .Transform.Style.Flat,
        .Transform.Style.Preserve3d,
        .Transform.Backface.Visible,
        .Transform.Backface.Hidden,
        .Transform.Perspective.None,
        .Transform.Perspective.Dramatic,
        .Transform.Perspective.Near,
        .Transform.Perspective.Normal,
        .Transform.Perspective.Midrange,
        .Transform.Perspective.Distant,
        .Transform.PerspectiveOrigin.Center,
        .Transform.PerspectiveOrigin.Top,
        .Transform.PerspectiveOrigin.Bottom,
        .Transform.PerspectiveOrigin.Left,
        .Transform.PerspectiveOrigin.Right,
        .Transform.Zoom.__0,
        .Transform.Zoom.__50,
        .Transform.Zoom.__75,
        .Transform.Zoom.__100,
        .Transform.Zoom.__125,
        .Transform.Zoom.__150,
        .Transform.Zoom.__200,
        .Transform.Shorthand.None,
        .Transform.Shorthand.Cpu,
        .Transform.Shorthand.Gpu,
    ];
    return leaves;
}

fn front45Leaves() -> Token[] {
    return f45RotateLeaves()
        .append(f45ScaleLeaves())
        .append(f45TranslateLeaves())
        .append(f45SkewLeaves())
        .append(f45KeywordLeaves());
}

fn f45IsWellFormed(decl: string) -> bool {
    return decl.length > 0 && decl.indexOf(":") != -1;
}

// A RESOLVED LENGTH. `rem` can be banned outright — nothing in `§ 16` carries
// one — and `px` can be banned over the walk list because the two leaves whose
// value IS `1px` are held out of it deliberately. The five perspective lengths
// are the ones a "make it work without composing the theme" patch would inline,
// so they are named as well.
fn f45CarriesNoResolvedLength(decl: string) -> bool {
    return decl.indexOf("rem") == -1 && decl.indexOf("px") == -1;
}

// The class-fragment probe. Each fragment is a CLASS name, hyphenated, and none
// can occur in a correct declaration of this front — the properties carry a
// COLON where the class has a hyphen.
//
// EVERY FRAGMENT CARRIES ITS SUFFIX, and that is not tidiness — it is the whole
// difficulty of this probe in this front. `var(--tw-scale-x)` CONTAINS
// `scale-x`, `var(--tw-skew-y)` contains `skew-y` and `var(--tw-translate-x)`
// contains `translate-x`, so the bare stems `scale-`, `skew-x` and
// `translate-x-` fire on `§ 16.7`'s two composed rows, which are correct output.
// The first draft of this list used the stems and the control below caught it.
// `perspective-*` is absent for the same reason one step further on:
// `var(--perspective-near)` contains the class name `perspective-near` exactly —
// front 44's `var(--animate-spin)` lesson, in this front's vocabulary.
// `perspective-none` is safe to name, because there is no `--perspective-none`.
fn f45CarriesNoClassFragment(decl: string) -> bool {
    return decl.indexOf("rotate-45") == -1
        && decl.indexOf("rotate-180") == -1
        && decl.indexOf("scale-50") == -1
        && decl.indexOf("scale-105") == -1
        && decl.indexOf("scale-x-50") == -1
        && decl.indexOf("scale-y-50") == -1
        && decl.indexOf("skew-x-3") == -1
        && decl.indexOf("skew-y-6") == -1
        && decl.indexOf("translate-x-px") == -1
        && decl.indexOf("translate-x-full") == -1
        && decl.indexOf("translate-y-full") == -1
        && decl.indexOf("origin-center") == -1
        && decl.indexOf("origin-top-left") == -1
        && decl.indexOf("transform-flat") == -1
        && decl.indexOf("transform-3d") == -1
        && decl.indexOf("transform-none") == -1
        && decl.indexOf("transform-cpu") == -1
        && decl.indexOf("transform-gpu") == -1
        && decl.indexOf("backface-visible") == -1
        && decl.indexOf("backface-hidden") == -1
        && decl.indexOf("perspective-none") == -1
        && decl.indexOf("perspective-origin-top") == -1
        && decl.indexOf("zoom-50") == -1
        && decl.indexOf("zoom-200") == -1;
}

// EVERY ANGLE CARRIES ITS UNIT. `rotate:90` and `skewX(3)` are the two shapes
// of the defect and neither is valid CSS; the probe anchors on the property so
// that a scale step and `zoom:2`, which carry no angle, are not
// swept up with them.
fn f45CarriesItsUnit(decl: string) -> bool {
    val isAngle = decl.startsWith("rotate:")
        || decl.startsWith("transform:skew");
    val out = if (isAngle) decl.indexOf("deg") != -1 else true;
    return out;
}

test "regression — every one of the 98 walked leaves of this front declares something" {
    assert f45RotateLeaves().length == 10;
    assert f45ScaleLeaves().length == 30;
    assert f45TranslateLeaves().length == 12;
    assert f45SkewLeaves().length == 12;
    assert f45KeywordLeaves().length == 34;
    val leaves = front45Leaves();
    assert leaves.length == 98;
    assert leaves.all({ t -> f45IsWellFormed(tokenDeclarations(t)) });
}

test "regression — no walked leaf of this front resolves a length" {
    assert front45Leaves().all(
        { t -> f45CarriesNoResolvedLength(tokenDeclarations(t)) },
    );
}

test "regression — no transform leaf emits a Tailwind class fragment" {
    assert front45Leaves().all(
        { t -> f45CarriesNoClassFragment(tokenDeclarations(t)) },
    );
}

test "regression — every angle this front emits carries its `deg`" {
    assert front45Leaves().all(
        { t -> f45CarriesItsUnit(tokenDeclarations(t)) },
    );
    val angles = front45Leaves().filter(
        { t -> tokenDeclarations(t).indexOf("deg") != -1 },
    );
    assert angles.length == 22;
}

// EVERY LEAF IS DISTINCT. A sub-dispatcher that discarded its payload — front
// 40's historical defect, `border-color:red` for all 286 cells — passes every
// probe above and fails this one. The 101 tokens include the three `Px` leaves
// the length walk holds out.
//
// `scale-x-100` and `scale-y-100` COLLIDED under the reference's two-value
// shape (both `scale:1 1`); upstream's form writes each axis's own variable, so
// the two identities are now distinct declarations, and the walk says so.
test "regression — the 101 leaves emit 101 distinct declarations" {
    val px: Token[] = [
        .Transform.TranslateX.Px,
        .Transform.TranslateY.Px,
        .Transform.Translate.Px,
    ];
    val all = front45Leaves().append(px);
    assert all.length == 101;
    val decls = all.map({ t -> tokenDeclarations(t) });
    // Duplicates are counted rather than searched — front 40's rule, followed
    // here (§ Maintainer rules, `Array.lastIndexOf`).
    val dupes = decls.filter({ d -> decls.filter({ x -> x == d }).length > 1 });
    assert dupes.length == 0;
    assert tokenDeclarations(.Transform.ScaleX.__100)
        != tokenDeclarations(.Transform.ScaleY.__100);
}

// THE CONTROLS THAT MUST FAIL, and — for the string probes — the controls that
// must NOT. A probe that fires on valid output is one the next front deletes,
// so each is shown on a real emission as well as on the defect.
test "regression — the four transform probes discriminate, in both directions" {
    assert f45IsWellFormed("") == false;
    assert f45IsWellFormed("transform-origin") == false;
    assert f45IsWellFormed("transform-origin:center");

    // the resolved lengths this front refuses, and the fact that they DO exist
    // in the library — in the theme, which is where they belong
    assert f45CarriesNoResolvedLength("perspective:300px") == false;
    assert f45CarriesNoResolvedLength("translate:0.25rem 0") == false;
    assert f45CarriesNoResolvedLength("perspective:var(--perspective-near)");
    val near = transformEntries().at(1);
    if (near == null) {
        assert false;
        return;
    }
    assert near.value == "300px";
    // AND the two leaves held out of the walk, asserted from the other side:
    // their `1px` is the reference's own literal and they DO carry it
    assert f45CarriesNoResolvedLength(
        tokenDeclarations(.Transform.TranslateX.Px),
    )
        == false;
    assert tokenDeclarations(.Transform.TranslateY.Px).indexOf("1px") != -1;

    // the class fragments, on strings shaped like the defect
    assert f45CarriesNoClassFragment("rotate:rotate-45") == false;
    assert f45CarriesNoClassFragment("scale:scale-105") == false;
    assert f45CarriesNoClassFragment("transform:skew-x-3") == false;
    assert f45CarriesNoClassFragment("translate:translate-x-full") == false;
    assert f45CarriesNoClassFragment("transform-style:transform-3d") == false;
    assert f45CarriesNoClassFragment("zoom:zoom-50") == false;
    assert f45CarriesNoClassFragment(
        "perspective-origin:perspective-origin-top",
    )
        == false;
    // AND NOT on correct output that merely contains a class name inside a
    // variable reference — the half that usually goes wrong
    assert f45CarriesNoClassFragment("perspective:var(--perspective-near)");
    assert f45CarriesNoClassFragment("perspective:var(--perspective-midrange)");
    assert f45CarriesNoClassFragment(
        tokenDeclarations(.Transform.Shorthand.Gpu),
    );
    assert f45CarriesNoClassFragment(
        tokenDeclarations(.Transform.TranslateX.Half),
    );

    // the unit probe, both ways — and NOT on the two unitless families
    assert f45CarriesItsUnit("rotate:90") == false;
    assert f45CarriesItsUnit("transform:skewX(3)") == false;
    assert f45CarriesItsUnit("rotate:90deg");
    assert f45CarriesItsUnit("--tw-scale-x:110%");
    assert f45CarriesItsUnit("zoom:2");
}

// WHY THE `--tw-translate-*` IDENTITY DEFAULTS ARE `@property` BLOCKS AND NOT
// THEME ENTRIES, pinned rather than left as prose in the banner: `Ns` has
// nineteen prefixes and none of them is `--tw-`, so `extendTheme` would refuse
// the entry. The `0` upstream registers travels in the sheet's `@property`
// block, and the declaration reads the variable bare, as upstream's does.
test "regression — `--tw-*` is in no namespace, which is why the `0` is a `@property`" {
    // the namespace this front DOES own is real and reachable
    assert nsPrefix(Ns.Perspective) == "--perspective-";
    assert namespace(
        extendTheme(defaultTheme(), transformEntries()),
        Ns.Perspective,
    ).length
        == 5;
    // and no theme in this library carries a `--tw-` name, because no `Ns`
    // prefix admits one — `extendTheme` panics on an entry in no namespace,
    // which is why the identity default is a fallback in the declaration
    assert defaultTheme().entries.all(
        { e -> e.name.startsWith("--tw-") == false },
    );
    assert tokenDeclarations(.Transform.TranslateX.Half).indexOf(", 0)") == -1;
    val one: Token[] = [.Transform.TranslateY.Half];
    assert tokensToSheet(one, defaultTheme()).blocks.any(
        { b -> b.header == "@property --tw-translate-x" && b.body.endsWith("initial-value:0}") },
    );
}

// ── end to end ───────────────────────────────────────────────────────────────

// THE WHOLE POINT OF THE FRONT, in one document: a card that lifts and grows
// under the pointer, with front 44's transition making the motion visible
// rather than instantaneous, and a disclosure chevron that flips when its
// parent opens.
test "end to end — a lifting card and a flipping chevron in one document" {
    val lifted: Token[] = [.Transform.TranslateY.Px, .Transform.Scale.__105];
    val card: Token[] = [
        .Transition.Transform,
        .Transition.Duration.__200,
        Token.Hover(lifted),
    ];
    val flipped: Token[] = [.Transform.Rotate.__180];
    val chevron: Token[] = [
        .Transition.Transform,
        .Transform.Origin.Center,
        Token.GroupOpen(flipped),
    ];
    val c = emiliaWith(card, defaultTheme());
    val v = emiliaWith(chevron, defaultTheme());
    val doc = await flushWith(bareOptions());
    assert doc.indexOf(
        "."
            + c
            + "{transition-property:transform;"
            + "transition-timing-function:var(--ease-out);transition-duration:150ms;"
            + "transition-duration:200ms}",
    )
        != -1;
    assert doc.indexOf(
        "@media (hover: hover){."
            + c
            + ":hover{--tw-translate-y:1px;translate:var(--tw-translate-x) var(--tw-translate-y);--tw-scale-x:105%;--tw-scale-y:105%;--tw-scale-z:105%;scale:var(--tw-scale-x) var(--tw-scale-y)}}",
    )
        != -1;
    assert doc.indexOf(
        "@property --tw-scale-x{syntax:\"*\";inherits:false;initial-value:1}",
    )
        != -1;
    assert doc.indexOf(
        "@property --tw-translate-y{syntax:\"*\";inherits:false;initial-value:0}",
    )
        != -1;
    assert doc.startsWith("<style>@layer properties;");
    assert doc.indexOf(
        "."
            + v
            + "{transition-property:transform;"
            + "transition-timing-function:var(--ease-out);transition-duration:150ms;"
            + "transform-origin:center}",
    )
        != -1;
    assert doc.indexOf(":is(:where(.group):is([open], :popover-open, :open) *)")
        != -1;
    assert doc.indexOf("rotate:180deg}") != -1;
}

// ── end front 45 ─────────────────────────────────────────────────────────────

// ── front 46 — interactivity ─────────────────────────────────────────────────
//
// FRONT 46 OWNS EVERYTHING BETWEEN THIS BANNER AND ITS CLOSING ONE: the
// `Interact` dispatcher and its sub-dispatchers, the three colour wrappers and
// the tests under the same name.
//
// NO LEAF RESOLVES A LENGTH OR A COLOUR. The fourteen scroll-offset families
// answer front 54's `spacing(n)`; the three colour variants carry front 33's
// `paletteVar` in their payload, so `accent-indigo-500` and `bg-indigo-500`
// read one theme entry.
//
// THREE CLASS NAMES LIE ABOUT THEIR VALUE and each is asserted on its own:
// `resize-y` is `vertical`, `resize-x` is `horizontal`, `will-change-scroll`
// is `scroll-position`.
//
// THE SNAP STRICTNESS IS NOT A THEME ENTRY. The spec has front 54 carry a
// `--tw-scroll-snap-strictness` default; `extendTheme` refuses `--tw-` (the
// wall fronts 42 and 45 met) and a `:root` value would be the wrong mechanism
// anyway. Upstream registers `proximity` as the variable's initial value, so
// the reader carries it as front 39's `cssVarOr` fallback:
// `scroll-snap-type:x var(--tw-scroll-snap-strictness, proximity)`. A lone
// `Snap.Type.X` renders; a `Snap.Strictness` token in the same rule wins.

fn interactCursorToCss(v: Token.Interact.Cursor) -> string {
    val out = case v {
        Auto -> "cursor:auto";
        Standard -> "cursor:default";
        Pointer -> "cursor:pointer";
        Wait -> "cursor:wait";
        Text -> "cursor:text";
        Move -> "cursor:move";
        Help -> "cursor:help";
        NotAllowed -> "cursor:not-allowed";
        None -> "cursor:none";
        ContextMenu -> "cursor:context-menu";
        Progress -> "cursor:progress";
        Cell -> "cursor:cell";
        Crosshair -> "cursor:crosshair";
        VerticalText -> "cursor:vertical-text";
        Alias -> "cursor:alias";
        Copy -> "cursor:copy";
        NoDrop -> "cursor:no-drop";
        Grab -> "cursor:grab";
        Grabbing -> "cursor:grabbing";
        AllScroll -> "cursor:all-scroll";
        ColResize -> "cursor:col-resize";
        RowResize -> "cursor:row-resize";
        NResize -> "cursor:n-resize";
        EResize -> "cursor:e-resize";
        SResize -> "cursor:s-resize";
        WResize -> "cursor:w-resize";
        NeResize -> "cursor:ne-resize";
        NwResize -> "cursor:nw-resize";
        SeResize -> "cursor:se-resize";
        SwResize -> "cursor:sw-resize";
        EwResize -> "cursor:ew-resize";
        NsResize -> "cursor:ns-resize";
        NeswResize -> "cursor:nesw-resize";
        NwseResize -> "cursor:nwse-resize";
        ZoomIn -> "cursor:zoom-in";
        ZoomOut -> "cursor:zoom-out";
    };
    return out;
}

fn interactAppearanceToCss(v: Token.Interact.Appearance) -> string {
    val out = case v {
        None -> "appearance:none";
        Auto -> "appearance:auto";
    };
    return out;
}

fn interactFieldSizingToCss(v: Token.Interact.FieldSizing) -> string {
    val out = case v {
