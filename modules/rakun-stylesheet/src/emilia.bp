// The value `paletteEntries()` carries for a name, or `""` when it carries
// none. `themeValue` reads a `Theme`; this reads the list before it is one.
fn paletteValue(name: string) -> string {
    return paletteEntries()
        .filter({ e -> e.name == name })
        .map({ e -> e.value })
        .join("");
}

// ── tests · the theme contribution ───────────────────────────────────────────

test "paletteEntries — 286 entries, 26 families x 11 shades, and nothing else" {
    assert paletteEntries().length == 286;
    assert paletteEntries().filter(
        { e -> e.name.startsWith("--color-") },
    ).length
        == 286;
    assert paletteEntries().filter(
        { e -> e.name.startsWith("--color-red-") },
    ).length
        == 11;
    assert paletteEntries().filter(
        { e -> e.name.startsWith("--color-taupe-") },
    ).length
        == 11;
}

test "paletteEntries — the two values the reference prints, in upstream's spelling" {
    assert paletteValue("--color-red-500") == "oklch(63.7% 0.237 25.331)";
    assert paletteValue("--color-blue-500") == "oklch(62.3% 0.214 259.815)";
}

test "paletteEntries — white and black stay front 54's and are not duplicated" {
    assert paletteValue("--color-white") == "";
    assert paletteValue("--color-black") == "";
    assert themeValue(defaultTheme(), "--color-white") == "#fff";
    assert themeValue(defaultTheme(), "--color-black") == "#000";
}

test "paletteEntries — every entry's name is one a utility can reference" {
    val th = extendTheme(defaultTheme(), paletteEntries());
    assert themeValue(th, "--color-red-500") == "oklch(63.7% 0.237 25.331)";
    assert themeValue(th, "--color-slate-900") == "oklch(20.8% 0.042 265.755)";
    assert themeValue(th, "--color-mist-50") != "";
    assert paletteVar("red", "500") == "var(--color-red-500)";
    assert themeValue(th, "--color-white") == "#fff";
}

test "paletteEntries — composing it does not disturb the rest of the theme" {
    val th = extendTheme(defaultTheme(), paletteEntries());
    assert themeValue(th, "--spacing") == "0.25rem";
    assert themeValue(th, "--breakpoint-md") == "48rem";
    assert namespace(th, Ns.Color).length == 288;
    assert th.keyframes.length == defaultTheme().keyframes.length;
}

test "emilia emits no @theme block of its own — composing the palette is the caller's" {
    val tokens: Token[] = [.Color.Sky.500, .Bg.Color.Slate.900];
    val _cls = emilia(tokens);
    val styles = await flushWith(bareOptions());
    assert styles.indexOf("@theme") == -1;
    assert styles.indexOf("oklch") == -1;
    assert styles.indexOf("var(--color-sky-500)") != -1;
}

test "end to end — a two-token list renders one rule of two theme references" {
    val tokens: Token[] = [.Bg.Color.Slate.900, .Color.Slate.50];
    val cls = emilia(tokens);
    val styles = await flushWith(bareOptions());
    assert styles
        == "<style>@layer theme, base, components, utilities;@layer utilities{."
            + cls
            + "{background-color:var(--color-slate-900);color:var(--color-slate-50)}}</style>";
}

// ── the `Alpha` wrapper · upstream's `/N` opacity suffix ─────────────────────
//
// `bg-red-500/50` is the most used colour form in real markup and v0 had no
// token that expressed it. Upstream expands the suffix by MIXING the colour
// with transparent, so `bg-red-500/50` is
// `background-color: color-mix(in oklab, var(--color-red-500) 50%,
// transparent)`; `oklab` is the mixing space, and it is the one piece of this
// front the local reference does not print — `§ 3.6` shows the class form and
// never its CSS. Checked against upstream before it was written here.
//
// WHY IT IS A WRAPPER AND NOT A LEAF. Opacity cannot hang under the family:
// the shade is already the leaf, and a second numeric level would multiply the
// grid to 26 x 11 x 21. It cannot be a payload leaf inside the section either
// — a payload variant nested in a section has no constructible spelling
// (`Tok.Color.Hex("#abc")` reds `'Hex' is not declared in any behavior
// implemented for 'Tok'`). A TOP-LEVEL variant with a builtin-typed field is
// the one shape that builds, which is the shape `Hover(inner: Token[])`
// already has.
//
// IT REWRITES A SHEET, NOT A STRING. The spec's `alphaWrap(percent,
// tokensToCss(inner))` predates front 56: a token list produces a `Sheet` now,
// and folding it back to one string would flatten away the selector and the
// at-rule of any modifier inside it. Mapping the rewrite over each rule's
// declarations keeps both, which is what makes `Alpha` nest with a modifier in
// EITHER order — `Hover([Alpha(…)])` and `Alpha([Hover(…)])` both work, and
// the tests pin both.
//
// A NON-COLOUR TOKEN IS REWRITTEN TOO, and the result is meaningless CSS
// (`font-weight:color-mix(in oklab, bold 50%, transparent)`). That is
// deliberate: silently dropping the declaration would hide the mistake, and a
// declaration a browser discards is visible in devtools the moment it is
// looked for. The type system is where that gets refused, if it ever is.

// Split one `prop:value` declaration at its FIRST colon and rebuild the value
// as a mix with transparent. A declaration with no colon is returned
// unchanged — there is nothing to rewrite and inventing one would be worse.
//
// `String.slice` is never called here, in this file or anywhere in this
// library: the commonJS `String` prelude's `charCodeAt` patch is
// self-recursive, and one `slice` installs the prelude and blows the stack
// program-wide. `split` + `at` + the ARRAY `slice` do the same job.
fn alphaDecl(percent: i32, d: string) -> string {
    val parts = d.split(":");
    val prop = parts.at(0) ?? "";
    val value = parts.slice(1, parts.length).join(":");
    val mixed = "color-mix(in oklab, "
        + value
        + " "
        + percent.toString()
        + "%, transparent)";
    val out = if (parts.length < 2) d else prop + ":" + mixed;
    return out;
}

// Rewrite every declaration of a `;`-joined declaration string. Public because
// it takes and answers plain STRINGS — front 57's escape hatch can hand it a
// declaration it did not get from a token and get the same rewrite.
pub fn alphaWrap(percent: i32, css: string) -> string {
    return css.split(";").map({ d -> alphaDecl(percent, d) }).join(";");
}

fn alphaRule(r: Rule, percent: i32) -> Rule {
    return Rule(
        layer: r.layer,
        atRules: r.atRules,
        selector: r.selector,
        declarations: alphaWrap(percent, r.declarations),
        important: r.important,
    );
}

// The declarations change; the layer, the at-rules, the selector and the
// important flag do not, so a variant wrapped inside an `Alpha` keeps
// everything that made it a variant. Blocks pass through — a `@keyframes` body
// is not a declaration list.
fn alphaSheet(s: Sheet, percent: i32) -> Sheet {
    return Sheet(
        rules: s.rules.map({ r -> alphaRule(r, percent) }),
        blocks: s.blocks,
    );
}

// ── tests · the `Alpha` wrapper ──────────────────────────────────────────────

test "Alpha — the two rows the reference shows as classes" {
    val bg: Token[] = [.Bg.Color.Red.500];
    assert tokenDeclarations(Token.Alpha(percent: 50, inner: bg))
        == "background-color:color-mix(in oklab, var(--color-red-500) 50%, transparent)";
    val fg: Token[] = [.Color.Blue.600];
    assert tokenDeclarations(Token.Alpha(percent: 80, inner: fg))
        == "color:color-mix(in oklab, var(--color-blue-600) 80%, transparent)";
}

test "Alpha — four percentages over the same colour" {
    val inner: Token[] = [.Color.Sky.500];
    assert tokenDeclarations(Token.Alpha(percent: 5, inner: inner))
        == "color:color-mix(in oklab, var(--color-sky-500) 5%, transparent)";
    assert tokenDeclarations(Token.Alpha(percent: 25, inner: inner))
        == "color:color-mix(in oklab, var(--color-sky-500) 25%, transparent)";
    assert tokenDeclarations(Token.Alpha(percent: 75, inner: inner))
        == "color:color-mix(in oklab, var(--color-sky-500) 75%, transparent)";
    assert tokenDeclarations(Token.Alpha(percent: 100, inner: inner))
        == "color:color-mix(in oklab, var(--color-sky-500) 100%, transparent)";
}

test "Alpha — over two colour tokens, both declarations are rewritten" {
    val inner: Token[] = [.Color.Blue.600, .Bg.Color.Red.500];
    val s = tokenToSheet(
        Token.Alpha(percent: 40, inner: inner),
        defaultTheme(),
    );
    assert s.rules.length == 2;
    assert declarationsOf(s).join(";")
        == "color:color-mix(in oklab, var(--color-blue-600) 40%, transparent);"
            + "background-color:color-mix(in oklab, var(--color-red-500) 40%, transparent)";
}

test "Alpha — a non-colour token is rewritten too, and the result is meaningless CSS" {
    val inner: Token[] = [.Text.Bold];
    assert tokenDeclarations(Token.Alpha(percent: 50, inner: inner))
        == "font-weight:color-mix(in oklab, bold 50%, transparent)";
}

test "Alpha — a keyword colour survives structurally, mixed with transparent" {
    val inner: Token[] = [.Color.Current];
    assert tokenDeclarations(Token.Alpha(percent: 60, inner: inner))
        == "color:color-mix(in oklab, currentColor 60%, transparent)";
}

test "Alpha nests inside Hover, and the variant keeps its selector and at-rule" {
    val deepest: Token[] = [.Color.Red.600];
    val alpha: Token[] = [Token.Alpha(percent: 50, inner: deepest)];
    val r = firstRuleOf(tokenToSheet(Token.Hover(alpha), defaultTheme()));
    assert r.selector == "&:hover";
    assert r.atRules.join("|") == "@media (hover: hover)";
    assert r.declarations
        == "color:color-mix(in oklab, var(--color-red-600) 50%, transparent)";
}

test "Hover nests inside Alpha, and the rewrite reaches the varied rule" {
    val deepest: Token[] = [.Color.Red.600];
    val hover: Token[] = [Token.Hover(deepest)];
    val r = firstRuleOf(
        tokenToSheet(Token.Alpha(percent: 50, inner: hover), defaultTheme()),
    );
    assert r.selector == "&:hover";
    assert r.atRules.join("|") == "@media (hover: hover)";
    assert r.declarations
        == "color:color-mix(in oklab, var(--color-red-600) 50%, transparent)";
}

test "alphaWrap — plain strings in, plain strings out, and a colonless one is untouched" {
    assert alphaWrap(50, "color:red")
        == "color:color-mix(in oklab, red 50%, transparent)";
    assert alphaWrap(50, "") == "";
    assert alphaWrap(50, "nonsense") == "nonsense";
    assert alphaWrap(50, "background-image:url(a:b)")
        == "background-image:color-mix(in oklab, url(a:b) 50%, transparent)";
}

test "Alpha — the rewritten declaration carries no codec separator" {
    val inner: Token[] = [.Bg.Color.Red.500];
    val s = tokenToSheet(
        Token.Alpha(percent: 50, inner: inner),
        defaultTheme(),
    );
    assert declarationsOf(s).any({ d -> carriesSeparator(d) }) == false;
    assert encodeSheet(decodeSheet(encodeSheet(s))) == encodeSheet(s);
}

test "Alpha — end to end, the `bg-red-500/50` row as a document" {
    val inner: Token[] = [.Bg.Color.Red.500];
    val tokens: Token[] = [Token.Alpha(percent: 50, inner: inner)];
    val cls = emilia(tokens);
    val styles = await flushWith(bareOptions());
    assert styles
        == "<style>@layer theme, base, components, utilities;@layer utilities{."
            + cls
            + "{background-color:color-mix(in oklab, var(--color-red-500) 50%, transparent)}}</style>";
}

// ── the palette is a string-to-string mapping, with the enum at its edge ─────
//
// Front 57 will need to hand a colour emilia's enum does not carry — an
// arbitrary value — to the same formatter and get a well-formed declaration
// back. Nothing in this front stands in the way, and that is a design
// constraint rather than an accident:
//
//   - `paletteVar(family, shade)` takes two plain STRINGS and is `pub`. It
//     never sees a `Token.Color`, so a family and a shade that did not come
//     from a leaf format identically.
//   - `alphaWrap(percent, css)` takes a declaration string and is `pub`, for
//     the same reason.
//   - THE PROPERTY NAME LIVES IN THE DISPATCHER, not in the value. `color:` and
//     `background-color:` are written in `colorTokenToCss` / `bgColorTokenToCss`
//     and nowhere else, so a front that needs a third property reuses the value
//     half without a second palette table.
//   - No function in this front takes a `Token.Color` where a `string` would do.
//
// `Color.Hex(value: string)` is the proof that a string payload splices into
// the emitted CSS, and its arm is retained unchanged. It is also
// UNCONSTRUCTIBLE, and measured rather than assumed — against
// `zig-out/bin/botopink`, on this enum:
//
//     Token.Color.Hex("#abc")
//       error: 'Hex' is not declared in any behavior implemented for 'Token'
//     val h: Token = .Color.Hex("#abc");
//       error: unbound variable 'Color'
//
// A payload leaf NESTED INSIDE A SECTION has no constructible spelling; the
// variant type-checks in a `case` pattern, so the surface looks complete and
// is not. The shape that does build is a TOP-LEVEL variant with builtin-typed
// fields — which is what `Token.Alpha(percent: i32, inner: Token[])` above is,
// and what front 57's escape hatch will have to be. Contract 4a says so for
// every payload-carrying token in the milestone.

test "the palette formats a family and a shade it did not get from a leaf" {
    assert paletteVar("brand", "500") == "var(--color-brand-500)";
    assert paletteVar("red", "550") == "var(--color-red-550)";
    assert alphaWrap(30, "color:" + paletteVar("brand", "500"))
        == "color:color-mix(in oklab, var(--color-brand-500) 30%, transparent)";
}

test "the property name is the dispatcher's, so the same value serves both" {
    val shared = paletteVar("red", "500");
    assert tokenDeclarations(.Color.Red.600).indexOf(paletteVar("red", "600"))
        != -1;
    assert tokenDeclarations(.Bg.Color.Red.500) == "background-color:" + shared;
    assert tokenDeclarations(.Color.Red.400)
        == "color:" + paletteVar("red", "400");
}

test "a project override reaches every rule, because the token emits a reference" {
    val brand: ThemeEntry[] = [
        ThemeEntry(name: "--color-red-500", value: "#ff0000"),
    ];
    val th = extendTheme(extendTheme(defaultTheme(), paletteEntries()), brand);
    assert themeValue(th, "--color-red-500") == "#ff0000";
    assert tokenDeclarations(.Bg.Color.Red.500)
        == "background-color:var(--color-red-500)";
    assert themeValue(th, "--color-red-600") == "oklch(57.7% 0.245 27.325)";
}

// ── front 39 — backgrounds ───────────────────────────────────────────────────
//
// FRONT 39 OWNS EVERYTHING BETWEEN THIS BANNER AND ITS CLOSING ONE: the seven
// non-colour sub-sections of `Bg` and the top-level `Gradient` section of
// `tokens.bp`, and the dispatchers below. `Bg.Color` and the six legacy `Bg`
// leaves are front 33's and are not touched here; the `Bg` arms this front
// added to `bgTokenToCss` sit under the same banner, up beside that dispatcher.
//
// Every declaration here is a PLAIN DECLARATION with no selector, so each
// sub-dispatcher keeps the `fn <name>(t: Token.<section>, th: Theme) -> string`
// shape contract 4a prescribes and front 56's `declSheet(…)` adapts it. This
// front adds no `…TokenToSheet`.
//
// `th` is unused by every function below and is taken anyway: the contract is
// what makes a front that later needs the theme a one-line change here rather
// than a signature change in the shared dispatcher.

// ── `Bg` · attachment, clip and origin — `§ 10.1`, `§ 10.2`, `§ 10.5` ────────

fn bgAttachmentTokenToCss(a: Token.Bg.Attachment, th: Theme) -> string {
    val out = case a {
        Fixed -> "background-attachment:fixed";
        Local -> "background-attachment:local";
        Scroll -> "background-attachment:scroll";
    };
    return out;
}

// `Text` is the one clip value that is not a `*-box`, which is why the suffix
// is spelled per arm rather than appended to the leaf's name: `bg-clip-text`
// would come out `text-box` under any rule that derived the value from the
// leaf, and `text-box` is a different CSS value that exists.
fn bgClipTokenToCss(c: Token.Bg.Clip, th: Theme) -> string {
    val out = case c {
        Border -> "background-clip:border-box";
        Padding -> "background-clip:padding-box";
        Content -> "background-clip:content-box";
        Text -> "background-clip:text";
    };
    return out;
}

fn bgOriginTokenToCss(o: Token.Bg.Origin, th: Theme) -> string {
    val out = case o {
        Border -> "background-origin:border-box";
        Padding -> "background-origin:padding-box";
        Content -> "background-origin:content-box";
    };
    return out;
}

// ── `Bg.Pos` · `§ 10.6` ──────────────────────────────────────────────────────
//
// The sub-section is `Pos` and not `Position`, so `.Bg.Pos.*` stays four
// segments and reads differently from `.Layout.Position.*` — two unrelated
// properties Tailwind spells with the same English word.
//
// The four two-word values carry EXACTLY ONE SPACE and no hyphen: `left bottom`
// is two CSS keywords, and `left-bottom` is not a value.
fn bgPosTokenToCss(p: Token.Bg.Pos, th: Theme) -> string {
    val out = case p {
        Bottom -> "background-position:bottom";
        Center -> "background-position:center";
        Left -> "background-position:left";
        LeftBottom -> "background-position:left bottom";
        LeftTop -> "background-position:left top";
        Right -> "background-position:right";
        RightBottom -> "background-position:right bottom";
        RightTop -> "background-position:right top";
        Top -> "background-position:top";
    };
    return out;
}

// ── `Bg.Repeat` and `Bg.Size` · `§ 10.7`, `§ 10.8` ───────────────────────────
//
// `.Bg.Repeat.None` rather than `.Bg.Repeat.NoRepeat`: the CSS value keeps its
// `no-` prefix, the token does not repeat the word its own section already
// says.
fn bgRepeatTokenToCss(r: Token.Bg.Repeat, th: Theme) -> string {
    val out = case r {
        Repeat -> "background-repeat:repeat";
        None -> "background-repeat:no-repeat";
        X -> "background-repeat:repeat-x";
        Y -> "background-repeat:repeat-y";
        Round -> "background-repeat:round";
        Space -> "background-repeat:space";
    };
    return out;
}

fn bgSizeTokenToCss(z: Token.Bg.Size, th: Theme) -> string {
    val out = case z {
        Auto -> "background-size:auto";
        Cover -> "background-size:cover";
        Contain -> "background-size:contain";
    };
    return out;
}

// ── `Bg.Image` · `§ 10.4`, the half that is not a gradient ───────────────────
//
// `bg-none` is the only `background-image` utility the reference prints that is
// not a gradient; `bg-[url(…)]` and every other arbitrary image is front 57's
// escape hatch. The section is a section rather than a bare `Bg.None` leaf so
// that the escape hatch has somewhere to land.
fn bgImageTokenToCss(i: Token.Bg.Image, th: Theme) -> string {
    val out = case i {
        None -> "background-image:none";
    };
    return out;
}

// ── front 39 · tests ─────────────────────────────────────────────────────────

test "background-attachment — the three values of `§ 10.1`" {
    assert tokenDeclarations(.Bg.Attachment.Fixed)
        == "background-attachment:fixed";
    assert tokenDeclarations(.Bg.Attachment.Local)
        == "background-attachment:local";
    assert tokenDeclarations(.Bg.Attachment.Scroll)
        == "background-attachment:scroll";
}

test "background-clip — the four values of `§ 10.2`" {
    assert tokenDeclarations(.Bg.Clip.Border) == "background-clip:border-box";
    assert tokenDeclarations(.Bg.Clip.Padding) == "background-clip:padding-box";
    assert tokenDeclarations(.Bg.Clip.Content) == "background-clip:content-box";
    assert tokenDeclarations(.Bg.Clip.Text) == "background-clip:text";
}

test "background-clip — `text` is the one value that is not a `*-box`" {
    assert tokenDeclarations(.Bg.Clip.Text) == "background-clip:text";
    assert tokenDeclarations(.Bg.Clip.Text).indexOf("box") == -1;
}

test "background-origin — the three values of `§ 10.5`, and no `text` among them" {
    assert tokenDeclarations(.Bg.Origin.Border)
        == "background-origin:border-box";
    assert tokenDeclarations(.Bg.Origin.Padding)
        == "background-origin:padding-box";
    assert tokenDeclarations(.Bg.Origin.Content)
        == "background-origin:content-box";
}

test "background-position — the nine values of `§ 10.6`" {
    assert tokenDeclarations(.Bg.Pos.Bottom) == "background-position:bottom";
    assert tokenDeclarations(.Bg.Pos.Center) == "background-position:center";
    assert tokenDeclarations(.Bg.Pos.Left) == "background-position:left";
    assert tokenDeclarations(.Bg.Pos.LeftBottom)
        == "background-position:left bottom";
    assert tokenDeclarations(.Bg.Pos.LeftTop) == "background-position:left top";
    assert tokenDeclarations(.Bg.Pos.Right) == "background-position:right";
    assert tokenDeclarations(.Bg.Pos.RightBottom)
        == "background-position:right bottom";
    assert tokenDeclarations(.Bg.Pos.RightTop)
        == "background-position:right top";
    assert tokenDeclarations(.Bg.Pos.Top) == "background-position:top";
}

test "background-position — each two-word value carries exactly one space and no hyphen" {
    assert tokenDeclarations(.Bg.Pos.LeftBottom).split(" ").length == 2;
    assert tokenDeclarations(.Bg.Pos.LeftTop).split(" ").length == 2;
    assert tokenDeclarations(.Bg.Pos.RightBottom).split(" ").length == 2;
    assert tokenDeclarations(.Bg.Pos.RightTop).split(" ").length == 2;
    assert tokenDeclarations(.Bg.Pos.LeftBottom).indexOf("left-bottom") == -1;
    assert tokenDeclarations(.Bg.Pos.RightTop).indexOf("right-top") == -1;
    assert tokenDeclarations(.Bg.Pos.Center).split(" ").length == 1;
}

test "background-position — `.Bg.Pos` and `.Layout.Position` are two properties" {
    assert tokenDeclarations(.Bg.Pos.Center) == "background-position:center";
    assert tokenDeclarations(.Layout.Position.Fixed) == "position:fixed";
    assert tokenDeclarations(.Bg.Pos.Center).indexOf("background-") != -1;
    assert tokenDeclarations(.Layout.Position.Fixed).indexOf("background-")
        == -1;
}

test "background-repeat — the six values of `§ 10.7`, `None` spelling `no-repeat`" {
    assert tokenDeclarations(.Bg.Repeat.Repeat) == "background-repeat:repeat";
    assert tokenDeclarations(.Bg.Repeat.None) == "background-repeat:no-repeat";
    assert tokenDeclarations(.Bg.Repeat.X) == "background-repeat:repeat-x";
    assert tokenDeclarations(.Bg.Repeat.Y) == "background-repeat:repeat-y";
    assert tokenDeclarations(.Bg.Repeat.Round) == "background-repeat:round";
    assert tokenDeclarations(.Bg.Repeat.Space) == "background-repeat:space";
}

test "background-size — the three values of `§ 10.8`, beside the `Size` section" {
    assert tokenDeclarations(.Bg.Size.Auto) == "background-size:auto";
    assert tokenDeclarations(.Bg.Size.Cover) == "background-size:cover";
    assert tokenDeclarations(.Bg.Size.Contain) == "background-size:contain";
    assert tokenDeclarations(.Size.W.4) == "width:calc(var(--spacing) * 4)";
}

test "background-image — `bg-none` is the one non-gradient row of `§ 10.4`" {
    assert tokenDeclarations(.Bg.Image.None) == "background-image:none";
}

test "the legacy `Bg` leaves are byte-identical after this front" {
    assert tokenDeclarations(.Bg.White) == "background:#ffffff";
    assert tokenDeclarations(.Bg.Black) == "background:#000000";
    assert tokenDeclarations(.Bg.Red.500) == "background:red";
    assert tokenDeclarations(.Bg.Blue.100) == "background:blue";
    assert tokenDeclarations(.Bg.Gray.900) == "background:gray";
    assert tokenDeclarations(.Bg.Color.Indigo.500)
        == "background-color:var(--color-indigo-500)";
}

// ── `Gradient` · `§ 10.4` ────────────────────────────────────────────────────
//
// `To` is the DIRECTION and `Stop` the terminal colour — the one place this
// front diverges from Tailwind's own naming, where `bg-gradient-to-r` and
// `to-pink-500` share the word `to` while setting unrelated things.

fn gradientTokenToCss(g: Token.Gradient, th: Theme) -> string {
    val out = case g {
        To(_inner) -> gradientToTokenToCss(_inner, th);
        From(_inner) -> gradientFromTokenToCss(_inner, th);
        Via(_inner) -> gradientViaTokenToCss(_inner, th);
        Stop(_inner) -> gradientStopTokenToCss(_inner, th);
    };
    return out;
}

// The eight direction PHRASES are spelled here and nowhere else, and the
// declaration around them is `linearGradient`'s: adding a direction is one arm
// and adding a gradient function is one function.
//
// The phrase is `to top right` and not `to top-right`: two CSS keywords after
// the `to`, exactly as `§ 10.4` prints them, and exactly one space after the
// comma that separates the direction from the stop list.
fn gradientToTokenToCss(d: Token.Gradient.To, th: Theme) -> string {
    val out = case d {
        T -> linearGradient("to top");
        Tr -> linearGradient("to top right");
        R -> linearGradient("to right");
        Br -> linearGradient("to bottom right");
        B -> linearGradient("to bottom");
        Bl -> linearGradient("to bottom left");
        L -> linearGradient("to left");
        Tl -> linearGradient("to top left");
    };
    return out;
}

fn linearGradient(phrase: string) -> string {
    return "background-image:linear-gradient("
        + phrase
        + ", "
        + gradientStopsRef()
        + ")";
}

// `--tw-gradient-stops` is the one name the direction and the three stops have
// to agree on, so it is written once and read from both sides.
fn gradientStopsVar() -> string {
    return "--tw-gradient-stops";
}

fn gradientStopsRef() -> string {
    return cssVar(gradientStopsVar());
}

fn cssVar(name: string) -> string {
    return "var(" + name + ")";
}

// A stop list names a custom property that a SIBLING token sets, so every
// reference but the one the declaration itself is setting carries a fallback.
// Upstream registers the same defaults with `@property` (`#0000` on each of
// the three stop colours); emilia emits no `@property` block, so the fallback
// is written into the reference, which is what the 1.0.8 draft did too. See
// the note above `gradientFromDecl`.
fn cssVarOr(name: string, fallback: string) -> string {
    return "var(" + name + ", " + fallback + ")";
}

test "gradient direction — the eight phrases of `§ 10.4`" {
    assert tokenDeclarations(.Gradient.To.T)
        == "background-image:linear-gradient(to top, var(--tw-gradient-stops))";
    assert tokenDeclarations(.Gradient.To.Tr)
        == "background-image:linear-gradient(to top right, var(--tw-gradient-stops))";
    assert tokenDeclarations(.Gradient.To.R)
        == "background-image:linear-gradient(to right, var(--tw-gradient-stops))";
    assert tokenDeclarations(.Gradient.To.Br)
        == "background-image:linear-gradient(to bottom right, var(--tw-gradient-stops))";
    assert tokenDeclarations(.Gradient.To.B)
        == "background-image:linear-gradient(to bottom, var(--tw-gradient-stops))";
    assert tokenDeclarations(.Gradient.To.Bl)
        == "background-image:linear-gradient(to bottom left, var(--tw-gradient-stops))";
    assert tokenDeclarations(.Gradient.To.L)
        == "background-image:linear-gradient(to left, var(--tw-gradient-stops))";
    assert tokenDeclarations(.Gradient.To.Tl)
        == "background-image:linear-gradient(to top left, var(--tw-gradient-stops))";
}

test "gradient direction — a corner is two keywords, not a hyphenated one" {
    assert tokenDeclarations(.Gradient.To.Tr).indexOf("to top-right") == -1;
    assert tokenDeclarations(.Gradient.To.Bl).indexOf("to bottom-left") == -1;
    assert tokenDeclarations(.Gradient.To.Tr).indexOf("to top right") != -1;
    assert tokenDeclarations(.Gradient.To.Bl).indexOf("to bottom left") != -1;
}

test "gradient direction — exactly one space after the comma, on all eight" {
    assert tokenDeclarations(.Gradient.To.T).indexOf(",  ") == -1;
    assert tokenDeclarations(.Gradient.To.T).indexOf(",var") == -1;
    assert tokenDeclarations(.Gradient.To.R).indexOf(
        ", var(--tw-gradient-stops))",
    )
        != -1;
    assert tokenDeclarations(.Gradient.To.Bl).indexOf(
        ", var(--tw-gradient-stops))",
    )
        != -1;
}

test "gradient direction — `.Gradient.To` is the direction, never a colour" {
    assert tokenDeclarations(.Gradient.To.R).indexOf("--color-") == -1;
    assert tokenDeclarations(.Gradient.To.R).indexOf("background-image:") == 0;
}

// ── `Gradient.From` / `.Via` / `.Stop` · the colour stops ───────────────
//
// THE COLOUR HALF IS FRONT 33's. Every cell below is `paletteVar(family,
// shade)` — the same function `.Bg.Color.Indigo.500` calls — so
// `.Gradient.From.Indigo.500` and `.Bg.Color.Indigo.500` reference one custom
// property by CONSTRUCTION rather than by two transcriptions agreeing. This
// front holds no colour table.
//
// THE STOP LIST DIVERGES FROM THE FRONT's SPEC, AFTER THE UPSTREAM CHECK ITS
// OWN *Reference gaps* ASKED FOR. The three custom-property NAMES check out
// exactly (`--tw-gradient-from`, `--tw-gradient-via`, `--tw-gradient-to`), and
// so does the direction's `var(--tw-gradient-stops)`. The COMPOSITION does
// not: upstream v4 threads four position variables through the list
// (`--tw-gradient-position`, `--tw-gradient-{from,via,to}-position`) and
// hands `via-*` its own `--tw-gradient-via-stops` so that a later `to-*` does
// not drop the via colour. Both rest on `@property` registration for their
// defaults, which emilia does not emit — copying the shape without the
// registration would emit a list that is INVALID AT COMPUTED-VALUE TIME in
// every browser, which is worse than simplifying. Colour-stop POSITIONS are
// not this front's, so the position variables have nothing to carry here.
//
// What is kept from upstream is the part that makes the simplification
// correct rather than merely short: the `#0000` default upstream registers
// is written as a `var(…, transparent)` FALLBACK, so `.Gradient.From.X` alone
// still paints X → transparent instead of resolving to nothing. That is the
// 1.0.8 draft's shape, which the front carried forward `to weigh in the
// upstream check`; the check weighed it in.
//
// `Stop` sets `--tw-gradient-to` AND NOTHING ELSE, which is what makes token
// order load-bearing in the way contract 4 wants: `Via`'s three-stop list
// overrides `From`'s two-stop list because it is listed after it. Were `Stop`
// to write a list too, it would overwrite `Via`'s — which is the whole reason
// upstream needs `--tw-gradient-via-stops`, and the reason this front does
// not need it.

fn gradientFromVar() -> string {
    return "--tw-gradient-from";
}

fn gradientViaVar() -> string {
    return "--tw-gradient-via";
}

fn gradientToVar() -> string {
    return "--tw-gradient-to";
}

fn gradientFromDecl(color: string) -> string {
    return gradientFromVar()
        + ":"
        + color
        + ";"
        + gradientStopsVar()
        + ":"
        + cssVar(gradientFromVar())
        + ", "
        + cssVarOr(gradientToVar(), "transparent");
}

fn gradientViaDecl(color: string) -> string {
    return gradientViaVar()
        + ":"
        + color
        + ";"
        + gradientStopsVar()
        + ":"
        + cssVarOr(gradientFromVar(), "transparent")
        + ", "
        + cssVar(gradientViaVar())
        + ", "
        + cssVarOr(gradientToVar(), "transparent");
}

fn gradientStopDecl(color: string) -> string {
    return gradientToVar() + ":" + color;
}

fn gradientFromTokenToCss(c: Token.Gradient.From, th: Theme) -> string {
    val out = case c {
        Red(_inner) -> gradientFromDecl(
            paletteVar("red", gradientFromRedShade(_inner)),
        );
        Orange(_inner) -> gradientFromDecl(
            paletteVar("orange", gradientFromOrangeShade(_inner)),
        );
        Amber(_inner) -> gradientFromDecl(
            paletteVar("amber", gradientFromAmberShade(_inner)),
        );
        Yellow(_inner) -> gradientFromDecl(
            paletteVar("yellow", gradientFromYellowShade(_inner)),
        );
        Lime(_inner) -> gradientFromDecl(
            paletteVar("lime", gradientFromLimeShade(_inner)),
        );
        Green(_inner) -> gradientFromDecl(
            paletteVar("green", gradientFromGreenShade(_inner)),
        );
        Emerald(_inner) -> gradientFromDecl(
            paletteVar("emerald", gradientFromEmeraldShade(_inner)),
        );
        Teal(_inner) -> gradientFromDecl(
            paletteVar("teal", gradientFromTealShade(_inner)),
        );
        Cyan(_inner) -> gradientFromDecl(
            paletteVar("cyan", gradientFromCyanShade(_inner)),
        );
        Sky(_inner) -> gradientFromDecl(
            paletteVar("sky", gradientFromSkyShade(_inner)),
        );
        Blue(_inner) -> gradientFromDecl(
            paletteVar("blue", gradientFromBlueShade(_inner)),
        );
        Indigo(_inner) -> gradientFromDecl(
            paletteVar("indigo", gradientFromIndigoShade(_inner)),
        );
        Violet(_inner) -> gradientFromDecl(
            paletteVar("violet", gradientFromVioletShade(_inner)),
        );
        Purple(_inner) -> gradientFromDecl(
            paletteVar("purple", gradientFromPurpleShade(_inner)),
        );
        Fuchsia(_inner) -> gradientFromDecl(
            paletteVar("fuchsia", gradientFromFuchsiaShade(_inner)),
        );
        Pink(_inner) -> gradientFromDecl(
            paletteVar("pink", gradientFromPinkShade(_inner)),
        );
        Rose(_inner) -> gradientFromDecl(
            paletteVar("rose", gradientFromRoseShade(_inner)),
        );
        Slate(_inner) -> gradientFromDecl(
            paletteVar("slate", gradientFromSlateShade(_inner)),
        );
        Gray(_inner) -> gradientFromDecl(
            paletteVar("gray", gradientFromGrayShade(_inner)),
        );
        Zinc(_inner) -> gradientFromDecl(
            paletteVar("zinc", gradientFromZincShade(_inner)),
        );
        Neutral(_inner) -> gradientFromDecl(
            paletteVar("neutral", gradientFromNeutralShade(_inner)),
        );
        Stone(_inner) -> gradientFromDecl(
            paletteVar("stone", gradientFromStoneShade(_inner)),
        );
        Mauve(_inner) -> gradientFromDecl(
            paletteVar("mauve", gradientFromMauveShade(_inner)),
        );
        Olive(_inner) -> gradientFromDecl(
            paletteVar("olive", gradientFromOliveShade(_inner)),
        );
        Mist(_inner) -> gradientFromDecl(
            paletteVar("mist", gradientFromMistShade(_inner)),
        );
        Taupe(_inner) -> gradientFromDecl(
            paletteVar("taupe", gradientFromTaupeShade(_inner)),
        );
        White -> gradientFromDecl(themeVar(nsPrefix(Ns.Color) + "white"));
        Black -> gradientFromDecl(themeVar(nsPrefix(Ns.Color) + "black"));
        Transparent -> gradientFromDecl("transparent");
        Current -> gradientFromDecl("currentColor");
        Inherit -> gradientFromDecl("inherit");
    };
    return out;
}

fn gradientViaTokenToCss(c: Token.Gradient.Via, th: Theme) -> string {
    val out = case c {
        Red(_inner) -> gradientViaDecl(
            paletteVar("red", gradientViaRedShade(_inner)),
