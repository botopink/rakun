// `grid-flow-row-dense` is TWO WORDS separated by one space, and `grid-flow-col`
// is `column` — the utility abbreviates where the CSS value does not.
fn gridFlowToCss(f: Token.Grid.Flow, th: Theme) -> string {
    val out = case f {
        Row -> "row";
        Col -> "column";
        Dense -> "dense";
        RowDense -> "row dense";
        ColDense -> "column dense";
    };
    return out;
}

fn gridAutoColsToCss(a: Token.Grid.AutoCols, th: Theme) -> string {
    val out = case a {
