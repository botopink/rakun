fn borderStyleToCss(s: Token.Border.Style) -> string {
    val out = case s {
        Solid -> "border-style:solid";
        Dashed -> "border-style:dashed";
        Dotted -> "border-style:dotted";
        Double -> "border-style:double";
        Hidden -> "border-style:hidden";
        None -> "border-style:none";
    };
    return out;
}

fn borderColorToCss(c: Token.Border.Color, th: Theme) -> string {
    val out = case c {
        Red(_inner) -> "border-color:"
            + paletteVar("red", borderColorRedShade(_inner));
        Orange(_inner) -> "border-color:"
            + paletteVar("orange", borderColorOrangeShade(_inner));
        Amber(_inner) -> "border-color:"
            + paletteVar("amber", borderColorAmberShade(_inner));
        Yellow(_inner) -> "border-color:"
            + paletteVar("yellow", borderColorYellowShade(_inner));
        Lime(_inner) -> "border-color:"
            + paletteVar("lime", borderColorLimeShade(_inner));
        Green(_inner) -> "border-color:"
            + paletteVar("green", borderColorGreenShade(_inner));
        Emerald(_inner) -> "border-color:"
            + paletteVar("emerald", borderColorEmeraldShade(_inner));
        Teal(_inner) -> "border-color:"
            + paletteVar("teal", borderColorTealShade(_inner));
        Cyan(_inner) -> "border-color:"
            + paletteVar("cyan", borderColorCyanShade(_inner));
        Sky(_inner) -> "border-color:"
            + paletteVar("sky", borderColorSkyShade(_inner));
        Blue(_inner) -> "border-color:"
            + paletteVar("blue", borderColorBlueShade(_inner));
        Indigo(_inner) -> "border-color:"
            + paletteVar("indigo", borderColorIndigoShade(_inner));
        Violet(_inner) -> "border-color:"
            + paletteVar("violet", borderColorVioletShade(_inner));
        Purple(_inner) -> "border-color:"
            + paletteVar("purple", borderColorPurpleShade(_inner));
        Fuchsia(_inner) -> "border-color:"
            + paletteVar("fuchsia", borderColorFuchsiaShade(_inner));
        Pink(_inner) -> "border-color:"
            + paletteVar("pink", borderColorPinkShade(_inner));
        Rose(_inner) -> "border-color:"
            + paletteVar("rose", borderColorRoseShade(_inner));
        Slate(_inner) -> "border-color:"
            + paletteVar("slate", borderColorSlateShade(_inner));
        Gray(_inner) -> "border-color:"
            + paletteVar("gray", borderColorGrayShade(_inner));
        Zinc(_inner) -> "border-color:"
            + paletteVar("zinc", borderColorZincShade(_inner));
        Neutral(_inner) -> "border-color:"
            + paletteVar("neutral", borderColorNeutralShade(_inner));
        Stone(_inner) -> "border-color:"
            + paletteVar("stone", borderColorStoneShade(_inner));
        Mauve(_inner) -> "border-color:"
            + paletteVar("mauve", borderColorMauveShade(_inner));
        Olive(_inner) -> "border-color:"
            + paletteVar("olive", borderColorOliveShade(_inner));
        Mist(_inner) -> "border-color:"
            + paletteVar("mist", borderColorMistShade(_inner));
        Taupe(_inner) -> "border-color:"
            + paletteVar("taupe", borderColorTaupeShade(_inner));
        White -> "border-color:" + themeVar(nsPrefix(Ns.Color) + "white");
        Black -> "border-color:" + themeVar(nsPrefix(Ns.Color) + "black");
        Transparent -> "border-color:transparent";
        Current -> "border-color:currentColor";
        Inherit -> "border-color:inherit";
        Hex(value) -> "border-color:" + value;
    };
    return out;
}

