// `§ 9.28`.
fn textWhitespaceToCss(t: Token.Text.Whitespace, th: Theme) -> string {
    val out = case t {
        Normal -> "white-space:normal";
        Nowrap -> "white-space:nowrap";
        Pre -> "white-space:pre";
        PreLine -> "white-space:pre-line";
        PreWrap -> "white-space:pre-wrap";
        BreakSpaces -> "white-space:break-spaces";
    };
    return out;
}

// `§ 9.29`, `word-break`. `Normal` is TWO declarations because upstream's
// `break-normal` resets both properties; `Words` is one, and it is an
// `overflow-wrap` even though the utility is spelled `break-*`. That asymmetry
// is the reference's, and it is why `OverflowWrap` below is a separate section
// rather than a merge.
fn textBreakToCss(t: Token.Text.Break, th: Theme) -> string {
    val out = case t {
        Normal -> "overflow-wrap:normal;word-break:normal";
        Words -> "overflow-wrap:break-word";
        All -> "word-break:break-all";
        Keep -> "word-break:keep-all";
    };
    return out;
}

// `§ 9.30`, `overflow-wrap`. `Anywhere` has no `break-*` spelling at all,
// which is what a merge with `Break` would have lost.
fn textOverflowWrapToCss(t: Token.Text.OverflowWrap, th: Theme) -> string {
    val out = case t {
        Normal -> "overflow-wrap:normal";
        BreakWord -> "overflow-wrap:break-word";
        Anywhere -> "overflow-wrap:anywhere";
    };
    return out;
}

// `§ 9.31`.
fn textHyphensToCss(t: Token.Text.Hyphens, th: Theme) -> string {
    val out = case t {
        None -> "hyphens:none";
        Manual -> "hyphens:manual";
        Auto -> "hyphens:auto";
    };
    return out;
}

// `§ 9.25`. The reference prints `indent-8` as HTML with no CSS beside it; the
// `calc(var(--spacing) * N)` shape is CONFIRMED against upstream v4 (4.3.2,
// compiled: `text-indent: calc(var(--spacing) * 8)`), and it goes through
// front 54's `spacing(n)`, the form `.Pad.All.8` already uses.
fn textIndentToCss(t: Token.Text.Indent, th: Theme) -> string {
    val out = case t {
        __0 -> "text-indent:" + spacing(0);
        __1 -> "text-indent:" + spacing(1);
        __2 -> "text-indent:" + spacing(2);
        __4 -> "text-indent:" + spacing(4);
        __8 -> "text-indent:" + spacing(8);
    };
    return out;
}

// `§ 9.27`.
fn textAlignToCss(t: Token.Text.Align, th: Theme) -> string {
    val out = case t {
        Baseline -> "vertical-align:baseline";
        Top -> "vertical-align:top";
        Middle -> "vertical-align:middle";
        Bottom -> "vertical-align:bottom";
        TextTop -> "vertical-align:text-top";
        TextBottom -> "vertical-align:text-bottom";
        Sub -> "vertical-align:sub";
        Super -> "vertical-align:super";
    };
    return out;
}

// `§ 9.26`. A tab size is a COUNT, not a length — no `px`, no `--spacing`.
fn textTabToCss(t: Token.Text.Tab, th: Theme) -> string {
    val out = case t {
        __0 -> "tab-size:0";
        __2 -> "tab-size:2";
        __4 -> "tab-size:4";
        __8 -> "tab-size:8";
    };
    return out;
}

// `§ 9.32`. The two non-arbitrary cases; `content-['Hello']` is the escape-hatch
// front's. `Empty` carries two QUOTE CHARACTERS inside the CSS value, which is
// a real thing for the codec to carry — the separators are `\t`, `\n` and
// `\r`, and a `"` is none of them.
fn textContentToCss(t: Token.Text.Content, th: Theme) -> string {
    val out = case t {
        None -> "content:none";
        Empty -> "content:\"\"";
    };
    return out;
}

// `§ 9.1`. The three family stacks that used to be spelled here are now
// `typographyEntries()`'s `--font-sans` / `--font-serif` / `--font-mono`, so a
// project overriding one moves every `.Font.*` that references it.
fn fontTokenToCss(t: Token.Font, th: Theme) -> string {
    val out = case t {
        Sans -> "font-family:" + themeVar(nsPrefix(Ns.Font) + "sans");
        Serif -> "font-family:" + themeVar(nsPrefix(Ns.Font) + "serif");
        Mono -> "font-family:" + themeVar(nsPrefix(Ns.Font) + "mono");
        Weight(_inner) -> fontWeightToCss(_inner, th);
        Smoothing(_inner) -> fontSmoothingToCss(_inner, th);
        Style(_inner) -> fontStyleToCss(_inner, th);
        Stretch(_inner) -> fontStretchToCss(_inner, th);
        Nums(_inner) -> fontNumsToCss(_inner, th);
    };
    return out;
}

// `§ 9.5`. NINE numeric weights, and they stay LITERAL: the reference prints
// `font-bold` as `font-weight: 700` and not as a `var(--font-weight-bold)`.
// The `--font-weight-*` entries are contributed anyway (`typographyEntries()`),
// because `§ 21` gives the namespace and a project reads it with `themeValue`.
fn fontWeightToCss(w: Token.Font.Weight, th: Theme) -> string {
    val out = case w {
        Light -> "font-weight:300";
        Normal -> "font-weight:400";
        Medium -> "font-weight:500";
        Bold -> "font-weight:700";
        Black -> "font-weight:900";
        Thin -> "font-weight:100";
        Extralight -> "font-weight:200";
        Semibold -> "font-weight:600";
        Extrabold -> "font-weight:800";
    };
    return out;
}

// `§ 9.3`. Two vendor properties from one token, in the reference's order.
fn fontSmoothingToCss(t: Token.Font.Smoothing, th: Theme) -> string {
    val out = case t {
        Antialiased -> "-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale";
        Subpixel -> "-webkit-font-smoothing:auto;-moz-osx-font-smoothing:auto";
    };
    return out;
}

// `§ 9.4`. The Tailwind name of `Normal` is `not-italic` and the CSS value is
// `normal`; the name-versus-value gap is the whole reason this row has a test.
fn fontStyleToCss(t: Token.Font.Style, th: Theme) -> string {
    val out = case t {
        Italic -> "font-style:italic";
        Normal -> "font-style:normal";
    };
    return out;
}

// `§ 9.6`.
fn fontStretchToCss(t: Token.Font.Stretch, th: Theme) -> string {
    val out = case t {
        UltraCondensed -> "font-stretch:ultra-condensed";
        ExtraCondensed -> "font-stretch:extra-condensed";
        Condensed -> "font-stretch:condensed";
        SemiCondensed -> "font-stretch:semi-condensed";
        Normal -> "font-stretch:normal";
        SemiExpanded -> "font-stretch:semi-expanded";
        Expanded -> "font-stretch:expanded";
        ExtraExpanded -> "font-stretch:extra-expanded";
        UltraExpanded -> "font-stretch:ultra-expanded";
    };
    return out;
}

// `§ 9.7`. The leaf names are shortened where the utility repeats the property
// (`lining-nums` is `Lining`, not `LiningNums`); the VALUES are upstream's
// verbatim, so `Lining` emits `lining-nums` and not `lining`.
fn fontNumsToCss(t: Token.Font.Nums, th: Theme) -> string {
    val out = case t {
        Normal -> "font-variant-numeric:normal";
        Ordinal -> "font-variant-numeric:ordinal";
        SlashedZero -> "font-variant-numeric:slashed-zero";
        Lining -> "font-variant-numeric:lining-nums";
        Oldstyle -> "font-variant-numeric:oldstyle-nums";
        Proportional -> "font-variant-numeric:proportional-nums";
        Tabular -> "font-variant-numeric:tabular-nums";
        DiagonalFractions -> "font-variant-numeric:diagonal-fractions";
        StackedFractions -> "font-variant-numeric:stacked-fractions";
    };
    return out;
}

// `§ 9.12`-`§ 9.14`. Six leaves over three properties.
fn listTokenToCss(t: Token.List, th: Theme) -> string {
    val out = case t {
        None -> "list-style-type:none";
        Disc -> "list-style-type:disc";
        Decimal -> "list-style-type:decimal";
        Inside -> "list-style-position:inside";
        Outside -> "list-style-position:outside";
        ImageNone -> "list-style-image:none";
    };
    return out;
}

// ── front 38 · the theme entries ─────────────────────────────────────────────
//
// The half of the theme this front references, handed over as a `ThemeEntry[]`
// the way front 33 hands over `paletteEntries()`:
// `extendTheme(defaultTheme(), typographyEntries())`.
//
// `--text-*` IS NOT HERE, and that is deliberate: front 54's `defaultTheme()`
// already carries all thirteen sizes and all thirteen paired line-heights with
// the values `§ 21.3` prints, so restating them would be a second
// transcription of one table. The test `typographyEntries — the --text-* half
// is front 54's` pins that.
//
// THE THREE FAMILY STACKS ARE UPSTREAM'S: `--font-sans`, `--font-serif` and
// `--font-mono` carry NO VALUE in the reference (`§ 9.1` prints the reference
// form `var(--font-sans)`, `§ 21.3` only the size scale), so they are copied
// from upstream v4's `theme.css` (4.3.2) byte for byte, emoji families and
// single quotes included — they replaced emilia's shorter pre-38 stacks.
//
// The rest are transcribed: `--font-weight-*` from `§ 9.5`, `--tracking-*` from
// the parenthesised values of `§ 9.9`, `--leading-*` from those of `§ 9.11`.
// There is no `--leading-none`: `§ 9.11` prints `leading-none` as the literal
// `1`, with no entry behind it.
pub fn typographyEntries() -> ThemeEntry[] {
    val families: ThemeEntry[] = [
        ThemeEntry(
            name: "--font-sans",
            value: "ui-sans-serif, system-ui, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol', 'Noto Color Emoji'",
        ),
        ThemeEntry(
            name: "--font-serif",
            value: "ui-serif, Georgia, Cambria, 'Times New Roman', Times, serif",
        ),
        ThemeEntry(
            name: "--font-mono",
            value: "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace",
        ),
    ];
    val weights: ThemeEntry[] = [
        ThemeEntry(name: "--font-weight-thin", value: "100"),
        ThemeEntry(name: "--font-weight-extralight", value: "200"),
        ThemeEntry(name: "--font-weight-light", value: "300"),
        ThemeEntry(name: "--font-weight-normal", value: "400"),
        ThemeEntry(name: "--font-weight-medium", value: "500"),
        ThemeEntry(name: "--font-weight-semibold", value: "600"),
        ThemeEntry(name: "--font-weight-bold", value: "700"),
        ThemeEntry(name: "--font-weight-extrabold", value: "800"),
        ThemeEntry(name: "--font-weight-black", value: "900"),
    ];
    val tracking: ThemeEntry[] = [
        ThemeEntry(name: "--tracking-tighter", value: "-0.05em"),
        ThemeEntry(name: "--tracking-tight", value: "-0.025em"),
        ThemeEntry(name: "--tracking-normal", value: "0em"),
        ThemeEntry(name: "--tracking-wide", value: "0.025em"),
        ThemeEntry(name: "--tracking-wider", value: "0.05em"),
        ThemeEntry(name: "--tracking-widest", value: "0.1em"),
    ];
    val leading: ThemeEntry[] = [
        ThemeEntry(name: "--leading-tight", value: "1.25"),
        ThemeEntry(name: "--leading-snug", value: "1.375"),
        ThemeEntry(name: "--leading-normal", value: "1.5"),
        ThemeEntry(name: "--leading-relaxed", value: "1.625"),
        ThemeEntry(name: "--leading-loose", value: "2"),
    ];
    return families.append(weights).append(tracking).append(leading);
}

// ── front 38 · tests ─────────────────────────────────────────────────────────
//
// The walk at the foot of this block is the front's REGRESSION and the reason
// the per-leaf tests above it are not the whole story: a shadowed `case` arm
// does not red, it falls out of the `case` and the token declares the EMPTY
// STRING, on one target only (§ Maintainer rules). 437 leaves are asserted to
// declare something, to carry a `:`, to resolve no length and no colour, and
// to emit no Tailwind class fragment — each probe with a control that FAILS.

// ── the four corrections ─────────────────────────────────────────────────────

test "front 38 — a size token is the --text-* PAIR, and no longer a rem" {
    assert tokenDeclarations(.Text.Size.Lg)
        == "font-size:var(--text-lg);line-height:var(--text-lg--line-height)";
    assert tokenDeclarations(.Text.Size.Lg).indexOf("1.125rem") == -1;
    assert tokenDeclarations(.Text.Size.Lg).indexOf("rem") == -1;
    assert declarationsOf(tokenToSheet(.Text.Size.Lg, defaultTheme())).length
        == 1;
}

test "front 38 — a family references var(--font-*), not a literal stack" {
    assert tokenDeclarations(.Font.Sans) == "font-family:var(--font-sans)";
    assert tokenDeclarations(.Font.Serif) == "font-family:var(--font-serif)";
    assert tokenDeclarations(.Font.Mono) == "font-family:var(--font-mono)";
    assert tokenDeclarations(.Font.Sans).indexOf("ui-sans-serif") == -1;
    assert tokenDeclarations(.Font.Serif).indexOf("Georgia") == -1;
    assert tokenDeclarations(.Font.Mono).indexOf("SFMono-Regular") == -1;
}

test "front 38 — underline is the text-decoration-line LONGHAND" {
    assert tokenDeclarations(.Text.Underline)
        == "text-decoration-line:underline";
    assert tokenDeclarations(.Text.LineThrough)
        == "text-decoration-line:line-through";
    assert tokenDeclarations(.Text.Overline) == "text-decoration-line:overline";
    assert tokenDeclarations(.Text.NoUnderline) == "text-decoration-line:none";
    // The shorthand is gone, which is what makes a line compose with a style
    // rather than overwrite it: two tokens, two properties, one rule.
    assert tokenDeclarations(.Text.Underline).indexOf("text-decoration:") == -1;
    val both: Token[] = [.Text.Underline, .Text.Decoration.Style.Dotted];
    assert declarationsOf(tokensToSheet(both, defaultTheme())).join(";")
        == "text-decoration-line:underline;text-decoration-style:dotted";
}

test "front 38 — .Text.Bold is untouched, and sits next to three that changed" {
    assert tokenDeclarations(.Text.Bold) == "font-weight:bold";
    assert tokenDeclarations(.Text.Italic) == "font-style:italic";
    assert tokenDeclarations(.Text.Left) == "text-align:left";
    assert tokenDeclarations(.Text.Center) == "text-align:center";
    assert tokenDeclarations(.Text.Right) == "text-align:right";
    assert tokenDeclarations(.Text.Justify) == "text-align:justify";
}

// ── size, weight, family ─────────────────────────────────────────────────────

test "front 38 — thirteen sizes, each a --text-* pair" {
    assert tokenDeclarations(.Text.Size.Xs)
        == "font-size:var(--text-xs);line-height:var(--text-xs--line-height)";
    assert tokenDeclarations(.Text.Size.Sm)
        == "font-size:var(--text-sm);line-height:var(--text-sm--line-height)";
    assert tokenDeclarations(.Text.Size.Base)
        == "font-size:var(--text-base);line-height:var(--text-base--line-height)";
    assert tokenDeclarations(.Text.Size.Lg)
        == "font-size:var(--text-lg);line-height:var(--text-lg--line-height)";
    assert tokenDeclarations(.Text.Size.Xl)
        == "font-size:var(--text-xl);line-height:var(--text-xl--line-height)";
    assert tokenDeclarations(.Text.Size.X2xl)
        == "font-size:var(--text-2xl);line-height:var(--text-2xl--line-height)";
    assert tokenDeclarations(.Text.Size.X3xl)
        == "font-size:var(--text-3xl);line-height:var(--text-3xl--line-height)";
    assert tokenDeclarations(.Text.Size.X4xl)
        == "font-size:var(--text-4xl);line-height:var(--text-4xl--line-height)";
    assert tokenDeclarations(.Text.Size.X5xl)
        == "font-size:var(--text-5xl);line-height:var(--text-5xl--line-height)";
    assert tokenDeclarations(.Text.Size.X6xl)
        == "font-size:var(--text-6xl);line-height:var(--text-6xl--line-height)";
    assert tokenDeclarations(.Text.Size.X7xl)
        == "font-size:var(--text-7xl);line-height:var(--text-7xl--line-height)";
    assert tokenDeclarations(.Text.Size.X8xl)
        == "font-size:var(--text-8xl);line-height:var(--text-8xl--line-height)";
    assert tokenDeclarations(.Text.Size.X9xl)
        == "font-size:var(--text-9xl);line-height:var(--text-9xl--line-height)";
}

test "front 38 — the --text-* half of the theme is front 54's, not a second copy" {
    // `§ 21.3` distinguishes two shapes and `defaultTheme()` already carries
    // both, so `typographyEntries()` does NOT restate them. These two cells
    // are the shapes: a computed ratio, and a bare `1` from `5xl` up.
    val th = defaultTheme();
    assert themeValue(th, "--text-xs") == "0.75rem";
    assert themeValue(th, "--text-xs--line-height") == "calc(1 / 0.75)";
    assert themeValue(th, "--text-5xl") == "3rem";
    assert themeValue(th, "--text-5xl--line-height") == "1";
    assert typographyEntries().filter(
        { e -> e.name.startsWith("--text-") },
    ).length
        == 0;
}

test "front 38 — nine weights, 100 through 900" {
    assert tokenDeclarations(.Font.Weight.Thin) == "font-weight:100";
    assert tokenDeclarations(.Font.Weight.Extralight) == "font-weight:200";
    assert tokenDeclarations(.Font.Weight.Light) == "font-weight:300";
    assert tokenDeclarations(.Font.Weight.Normal) == "font-weight:400";
    assert tokenDeclarations(.Font.Weight.Medium) == "font-weight:500";
    assert tokenDeclarations(.Font.Weight.Semibold) == "font-weight:600";
    assert tokenDeclarations(.Font.Weight.Bold) == "font-weight:700";
    assert tokenDeclarations(.Font.Weight.Extrabold) == "font-weight:800";
    assert tokenDeclarations(.Font.Weight.Black) == "font-weight:900";
}

test "front 38 — two alignments the section was missing" {
    assert tokenDeclarations(.Text.Start) == "text-align:start";
    assert tokenDeclarations(.Text.End) == "text-align:end";
}

// ── the multi-declaration tokens, in the reference's order ───────────────────

test "front 38 — antialiased is two vendor properties from one token" {
    assert tokenDeclarations(.Font.Smoothing.Antialiased)
        == "-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale";
    assert tokenDeclarations(.Font.Smoothing.Subpixel)
        == "-webkit-font-smoothing:auto;-moz-osx-font-smoothing:auto";
}

test "front 38 — truncate is three declarations" {
    assert tokenDeclarations(.Text.Truncate)
        == "overflow:hidden;text-overflow:ellipsis;white-space:nowrap";
}

test "front 38 — break-normal is two, break-words is one, and they differ in property" {
    assert tokenDeclarations(.Text.Break.Normal)
        == "overflow-wrap:normal;word-break:normal";
    assert tokenDeclarations(.Text.Break.Words) == "overflow-wrap:break-word";
    assert tokenDeclarations(.Text.Break.All) == "word-break:break-all";
    assert tokenDeclarations(.Text.Break.Keep) == "word-break:keep-all";
}

test "front 38 — OverflowWrap is a separate section, and wrap-anywhere is why" {
    assert tokenDeclarations(.Text.OverflowWrap.Normal)
        == "overflow-wrap:normal";
    assert tokenDeclarations(.Text.OverflowWrap.BreakWord)
        == "overflow-wrap:break-word";
    assert tokenDeclarations(.Text.OverflowWrap.Anywhere)
        == "overflow-wrap:anywhere";
    // `wrap-anywhere` has no `break-*` spelling at all — merging the two
    // sections would have lost it.
    assert tokenDeclarations(.Text.Break.Words)
        == tokenDeclarations(.Text.OverflowWrap.BreakWord);
}

test "front 38 — line-clamp-N is four declarations in the reference's order" {
    assert tokenDeclarations(.Text.Clamp.3)
        == "overflow:hidden;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3";
    assert tokenDeclarations(.Text.Clamp.1).indexOf("-webkit-line-clamp:1")
        != -1;
    assert tokenDeclarations(.Text.Clamp.6).indexOf("-webkit-line-clamp:6")
        != -1;
}

test "front 38 — line-clamp-none is the four-declaration RESET, not an omission" {
    assert tokenDeclarations(.Text.Clamp.None)
        == "overflow:visible;display:block;-webkit-box-orient:horizontal;-webkit-line-clamp:none";
}

// ── tracking and leading ─────────────────────────────────────────────────────

test "front 38 — six tracking values, each a var(--tracking-*)" {
    assert tokenDeclarations(.Text.Tracking.Tighter)
        == "letter-spacing:var(--tracking-tighter)";
    assert tokenDeclarations(.Text.Tracking.Tight)
        == "letter-spacing:var(--tracking-tight)";
    assert tokenDeclarations(.Text.Tracking.Normal)
        == "letter-spacing:var(--tracking-normal)";
    assert tokenDeclarations(.Text.Tracking.Wide)
        == "letter-spacing:var(--tracking-wide)";
    assert tokenDeclarations(.Text.Tracking.Wider)
        == "letter-spacing:var(--tracking-wider)";
    assert tokenDeclarations(.Text.Tracking.Widest)
        == "letter-spacing:var(--tracking-widest)";
}

test "front 38 — six leading values, five references and one literal" {
    assert tokenDeclarations(.Text.Leading.Tight)
        == "line-height:var(--leading-tight)";
    assert tokenDeclarations(.Text.Leading.Snug)
        == "line-height:var(--leading-snug)";
    assert tokenDeclarations(.Text.Leading.Normal)
        == "line-height:var(--leading-normal)";
    assert tokenDeclarations(.Text.Leading.Relaxed)
        == "line-height:var(--leading-relaxed)";
    assert tokenDeclarations(.Text.Leading.Loose)
        == "line-height:var(--leading-loose)";
    // `leading-none` is the one leaf here the reference prints as a literal:
    // `§ 9.11` gives `line-height: 1` with no `--leading-none` behind it.
    assert tokenDeclarations(.Text.Leading.None) == "line-height:1";
    assert typographyEntries().filter(
        { e -> e.name == "--leading-none" },
    ).length
        == 0;
}

// ── style, stretch, variant-numeric ──────────────────────────────────────────

test "front 38 — not-italic is Style.Normal, and the CSS value is normal" {
    assert tokenDeclarations(.Font.Style.Italic) == "font-style:italic";
    assert tokenDeclarations(.Font.Style.Normal) == "font-style:normal";
    // The v0 leaf and the v4-shaped spelling emit the same declaration.
    assert tokenDeclarations(.Text.Italic)
        == tokenDeclarations(.Font.Style.Italic);
}

test "front 38 — nine font-stretch values" {
    assert tokenDeclarations(.Font.Stretch.UltraCondensed)
        == "font-stretch:ultra-condensed";
    assert tokenDeclarations(.Font.Stretch.ExtraCondensed)
        == "font-stretch:extra-condensed";
    assert tokenDeclarations(.Font.Stretch.Condensed)
        == "font-stretch:condensed";
    assert tokenDeclarations(.Font.Stretch.SemiCondensed)
        == "font-stretch:semi-condensed";
    assert tokenDeclarations(.Font.Stretch.Normal) == "font-stretch:normal";
    assert tokenDeclarations(.Font.Stretch.SemiExpanded)
        == "font-stretch:semi-expanded";
    assert tokenDeclarations(.Font.Stretch.Expanded) == "font-stretch:expanded";
    assert tokenDeclarations(.Font.Stretch.ExtraExpanded)
        == "font-stretch:extra-expanded";
    assert tokenDeclarations(.Font.Stretch.UltraExpanded)
        == "font-stretch:ultra-expanded";
}

test "front 38 — nine font-variant-numeric values, upstream's spelling" {
    assert tokenDeclarations(.Font.Nums.Normal)
        == "font-variant-numeric:normal";
    assert tokenDeclarations(.Font.Nums.Ordinal)
        == "font-variant-numeric:ordinal";
    assert tokenDeclarations(.Font.Nums.SlashedZero)
        == "font-variant-numeric:slashed-zero";
    assert tokenDeclarations(.Font.Nums.Lining)
        == "font-variant-numeric:lining-nums";
    assert tokenDeclarations(.Font.Nums.Oldstyle)
        == "font-variant-numeric:oldstyle-nums";
    assert tokenDeclarations(.Font.Nums.Proportional)
        == "font-variant-numeric:proportional-nums";
    assert tokenDeclarations(.Font.Nums.Tabular)
        == "font-variant-numeric:tabular-nums";
    assert tokenDeclarations(.Font.Nums.DiagonalFractions)
        == "font-variant-numeric:diagonal-fractions";
    assert tokenDeclarations(.Font.Nums.StackedFractions)
        == "font-variant-numeric:stacked-fractions";
}

// ── transform, overflow, wrap ────────────────────────────────────────────────

test "front 38 — four text-transform values; normal-case is the value `none`" {
    assert tokenDeclarations(.Text.Transform.Uppercase)
        == "text-transform:uppercase";
    assert tokenDeclarations(.Text.Transform.Lowercase)
        == "text-transform:lowercase";
    assert tokenDeclarations(.Text.Transform.Capitalize)
        == "text-transform:capitalize";
    assert tokenDeclarations(.Text.Transform.None) == "text-transform:none";
}

test "front 38 — text-overflow and text-wrap" {
    assert tokenDeclarations(.Text.Overflow.Ellipsis)
        == "text-overflow:ellipsis";
    assert tokenDeclarations(.Text.Overflow.Clip) == "text-overflow:clip";
    assert tokenDeclarations(.Text.Wrap.Wrap) == "text-wrap:wrap";
    assert tokenDeclarations(.Text.Wrap.Nowrap) == "text-wrap:nowrap";
    assert tokenDeclarations(.Text.Wrap.Balance) == "text-wrap:balance";
    assert tokenDeclarations(.Text.Wrap.Pretty) == "text-wrap:pretty";
}

// ── decoration ───────────────────────────────────────────────────────────────

test "front 38 — five decoration styles" {
    assert tokenDeclarations(.Text.Decoration.Style.Solid)
        == "text-decoration-style:solid";
    assert tokenDeclarations(.Text.Decoration.Style.Double)
        == "text-decoration-style:double";
    assert tokenDeclarations(.Text.Decoration.Style.Dotted)
        == "text-decoration-style:dotted";
    assert tokenDeclarations(.Text.Decoration.Style.Dashed)
        == "text-decoration-style:dashed";
    assert tokenDeclarations(.Text.Decoration.Style.Wavy)
        == "text-decoration-style:wavy";
}

test "front 38 — six thicknesses and five offsets, the reference's extent" {
    assert tokenDeclarations(.Text.Decoration.Thickness.Auto)
        == "text-decoration-thickness:auto";
    assert tokenDeclarations(.Text.Decoration.Thickness.FromFont)
        == "text-decoration-thickness:from-font";
    assert tokenDeclarations(.Text.Decoration.Thickness.0)
        == "text-decoration-thickness:0px";
    assert tokenDeclarations(.Text.Decoration.Thickness.1)
        == "text-decoration-thickness:1px";
    assert tokenDeclarations(.Text.Decoration.Thickness.2)
        == "text-decoration-thickness:2px";
    assert tokenDeclarations(.Text.Decoration.Thickness.4)
        == "text-decoration-thickness:4px";
    assert tokenDeclarations(.Text.Decoration.Offset.Auto)
        == "text-underline-offset:auto";
    assert tokenDeclarations(.Text.Decoration.Offset.0)
        == "text-underline-offset:0px";
    assert tokenDeclarations(.Text.Decoration.Offset.1)
        == "text-underline-offset:1px";
    assert tokenDeclarations(.Text.Decoration.Offset.2)
        == "text-underline-offset:2px";
    assert tokenDeclarations(.Text.Decoration.Offset.4)
        == "text-underline-offset:4px";
}

test "front 38 — a decoration colour is front 33's reference, not a copy" {
    assert tokenDeclarations(.Text.Decoration.Color.Red.500)
        == "text-decoration-color:var(--color-red-500)";
    // Asserted against the HELPER rather than against a second literal: if
    // front 33 moves the reference form, this row moves with it.
    assert tokenDeclarations(.Text.Decoration.Color.Red.500)
        == "text-decoration-color:" + paletteVar("red", "500");
    assert tokenDeclarations(.Text.Decoration.Color.Taupe.50)
        == "text-decoration-color:" + paletteVar("taupe", "50");
    // No arm discards its shade — the defect front 40 inherited from the
    // two-family `Border.Color` stub.
    assert tokenDeclarations(.Text.Decoration.Color.Red.100)
        != tokenDeclarations(.Text.Decoration.Color.Red.900);
    assert tokenDeclarations(.Text.Decoration.Color.White)
        == "text-decoration-color:var(--color-white)";
    assert tokenDeclarations(.Text.Decoration.Color.Black)
        == "text-decoration-color:var(--color-black)";
    assert tokenDeclarations(.Text.Decoration.Color.Transparent)
        == "text-decoration-color:transparent";
    assert tokenDeclarations(.Text.Decoration.Color.Current)
        == "text-decoration-color:currentColor";
    assert tokenDeclarations(.Text.Decoration.Color.Inherit)
        == "text-decoration-color:inherit";
}

test "front 38 — a decoration colour and a text colour reference ONE property" {
    val a = tokenDeclarations(.Color.Indigo.500);
    val b = tokenDeclarations(.Text.Decoration.Color.Indigo.500);
    assert a == "color:var(--color-indigo-500)";
    assert b == "text-decoration-color:var(--color-indigo-500)";
    assert a.indexOf("var(--color-indigo-500)") != -1;
    assert b.indexOf("var(--color-indigo-500)") != -1;
}

// ── whitespace, hyphens, indent, align, tab, content, lists ──────────────────

test "front 38 — six whitespace values" {
    assert tokenDeclarations(.Text.Whitespace.Normal) == "white-space:normal";
    assert tokenDeclarations(.Text.Whitespace.Nowrap) == "white-space:nowrap";
    assert tokenDeclarations(.Text.Whitespace.Pre) == "white-space:pre";
    assert tokenDeclarations(.Text.Whitespace.PreLine)
        == "white-space:pre-line";
    assert tokenDeclarations(.Text.Whitespace.PreWrap)
        == "white-space:pre-wrap";
    assert tokenDeclarations(.Text.Whitespace.BreakSpaces)
        == "white-space:break-spaces";
}

test "front 38 — three hyphens values" {
    assert tokenDeclarations(.Text.Hyphens.None) == "hyphens:none";
    assert tokenDeclarations(.Text.Hyphens.Manual) == "hyphens:manual";
    assert tokenDeclarations(.Text.Hyphens.Auto) == "hyphens:auto";
}

test "front 38 — indent answers front 54's spacing(n), and resolves nothing" {
    assert tokenDeclarations(.Text.Indent.8)
        == "text-indent:calc(var(--spacing) * 8)";
    assert tokenDeclarations(.Text.Indent.8) == "text-indent:" + spacing(8);
    assert tokenDeclarations(.Text.Indent.0) == "text-indent:0";
    // The same function `.Pad.All.8` answers, so the two agree by construction
    // and halving `--spacing` moves both.
    assert tokenDeclarations(.Text.Indent.8).indexOf(spacing(8)) != -1;
    assert tokenDeclarations(.Pad.All.8).indexOf(spacing(8)) != -1;
}

test "front 38 — eight vertical-align values" {
    assert tokenDeclarations(.Text.Align.Baseline) == "vertical-align:baseline";
    assert tokenDeclarations(.Text.Align.Top) == "vertical-align:top";
    assert tokenDeclarations(.Text.Align.Middle) == "vertical-align:middle";
    assert tokenDeclarations(.Text.Align.Bottom) == "vertical-align:bottom";
    assert tokenDeclarations(.Text.Align.TextTop) == "vertical-align:text-top";
    assert tokenDeclarations(.Text.Align.TextBottom)
        == "vertical-align:text-bottom";
    assert tokenDeclarations(.Text.Align.Sub) == "vertical-align:sub";
    assert tokenDeclarations(.Text.Align.Super) == "vertical-align:super";
}

test "front 38 — four tab sizes, each a COUNT and not a length" {
    assert tokenDeclarations(.Text.Tab.0) == "tab-size:0";
    assert tokenDeclarations(.Text.Tab.2) == "tab-size:2";
    assert tokenDeclarations(.Text.Tab.4) == "tab-size:4";
    assert tokenDeclarations(.Text.Tab.8) == "tab-size:8";
    assert tokenDeclarations(.Text.Tab.4).indexOf("px") == -1;
    assert tokenDeclarations(.Text.Tab.4).indexOf("var(") == -1;
}

test "front 38 — content-none and content-[''], two quote characters and all" {
    assert tokenDeclarations(.Text.Content.None) == "content:none";
    assert tokenDeclarations(.Text.Content.Empty) == "content:\"\"";
    // The codec's separators are tab, newline and carriage return; a quote is
    // none of them, so the value survives a round trip through the host cell.
    assert carriesSeparator(tokenDeclarations(.Text.Content.Empty)) == false;
    assert decodeSheet(
        encodeSheet(tokenToSheet(.Text.Content.Empty, defaultTheme())),
    ).rules.length
        == 1;
}

test "front 38 — List answers six leaves across three properties" {
    assert tokenDeclarations(.List.None) == "list-style-type:none";
    assert tokenDeclarations(.List.Disc) == "list-style-type:disc";
    assert tokenDeclarations(.List.Decimal) == "list-style-type:decimal";
    assert tokenDeclarations(.List.Inside) == "list-style-position:inside";
    assert tokenDeclarations(.List.Outside) == "list-style-position:outside";
    assert tokenDeclarations(.List.ImageNone) == "list-style-image:none";
}

// ── the theme entries ────────────────────────────────────────────────────────

test "front 38 — typographyEntries carries 23 entries in four namespaces" {
    val es = typographyEntries();
    assert es.length == 23;
    assert es.filter({ e -> e.name.startsWith("--font-weight-") }).length == 9;
    assert es.filter({ e -> e.name.startsWith("--tracking-") }).length == 6;
    assert es.filter({ e -> e.name.startsWith("--leading-") }).length == 5;
    // The three family entries: the reference prints the reference FORM
    // (`var(--font-sans)`) and no value, so these are upstream's `theme.css`.
    assert es.filter({ e -> e.name == "--font-sans" }).length == 1;
    val sans = es.filter({ e -> e.name == "--font-sans" }).at(0);
    if (sans == null) {
        assert false;
        return;
    }
    assert sans.value.startsWith(
        "ui-sans-serif, system-ui, sans-serif, 'Apple Color Emoji'",
    );
    assert es.filter({ e -> e.name == "--font-serif" }).length == 1;
    assert es.filter({ e -> e.name == "--font-mono" }).length == 1;
}

test "front 38 — the tracking and leading values the reference prints" {
    val th = extendTheme(defaultTheme(), typographyEntries());
    assert themeValue(th, "--tracking-tighter") == "-0.05em";
    assert themeValue(th, "--tracking-tight") == "-0.025em";
    assert themeValue(th, "--tracking-normal") == "0em";
    assert themeValue(th, "--tracking-wide") == "0.025em";
    assert themeValue(th, "--tracking-wider") == "0.05em";
    assert themeValue(th, "--tracking-widest") == "0.1em";
    assert themeValue(th, "--leading-tight") == "1.25";
    assert themeValue(th, "--leading-snug") == "1.375";
    assert themeValue(th, "--leading-normal") == "1.5";
    assert themeValue(th, "--leading-relaxed") == "1.625";
    assert themeValue(th, "--leading-loose") == "2";
    assert themeValue(th, "--font-weight-bold") == "700";
}

test "front 38 — composing the entries disturbs nothing else, and the sizes stay" {
    val th = extendTheme(defaultTheme(), typographyEntries());
    assert themeValue(th, "--spacing") == "0.25rem";
    assert themeValue(th, "--breakpoint-md") == "48rem";
    assert themeValue(th, "--text-lg") == "1.125rem";
    assert themeValue(th, "--text-lg--line-height") == "calc(1.75 / 1.125)";
    assert th.entries.length == defaultTheme().entries.length + 23;
}

test "front 38 — a project's own type scale reaches every size token" {
    // The front's whole argument: the utility emits a REFERENCE, so moving
    // `--text-lg` moves the rule without moving one byte of the class body.
    val brand: ThemeEntry[] = [ThemeEntry(name: "--text-lg", value: "1.2rem")];
    val th = extendTheme(defaultTheme(), brand);
    assert themeValue(th, "--text-lg") == "1.2rem";
    assert declarationsOf(tokenToSheet(.Text.Size.Lg, th)).join(";")
        == declarationsOf(tokenToSheet(.Text.Size.Lg, defaultTheme())).join(
            ";",
        );
}

// ── end to end ───────────────────────────────────────────────────────────────

test "front 38 — end to end: a display heading is one class and one rule" {
    // The spec writes this list as `.Text.Balance`; the token above is
    // `.Text.Wrap.Balance` — `text-wrap` is a property group of its own and a
    // bare leaf would put four values of one property beside `Bold`.
    val tokens: Token[] = [
        .Font.Sans,
        .Text.Size.X3xl,
        .Text.Tracking.Tight,
        .Text.Wrap.Balance,
    ];
    val cls = emilia(tokens);
    val styles = await flushWith(bareOptions());
    assert styles
        == "<style>@layer theme, base, components, utilities;@layer utilities{."
            + cls
            + "{font-family:var(--font-sans);"
            + "font-size:var(--text-3xl);line-height:var(--text-3xl--line-height);"
            + "letter-spacing:var(--tracking-tight);text-wrap:balance}}</style>";
}

test "front 38 — end to end: a clamped excerpt with a wavy underlined link" {
    val tokens: Token[] = [
        .Text.Size.Sm,
        .Text.Leading.Relaxed,
        .Text.Clamp.3,
        .Text.Underline,
        .Text.Decoration.Style.Wavy,
        .Text.Decoration.Color.Sky.500,
        .Text.Decoration.Offset.2,
    ];
    val cls = emilia(tokens);
    val styles = await flushWith(bareOptions());
    assert styles
        == "<style>@layer theme, base, components, utilities;@layer utilities{."
            + cls
            + "{font-size:var(--text-sm);line-height:var(--text-sm--line-height);"
            + "line-height:var(--leading-relaxed);"
            + "overflow:hidden;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3;"
            + "text-decoration-line:underline;text-decoration-style:wavy;"
            + "text-decoration-color:var(--color-sky-500);text-underline-offset:2px}}</style>";
}

