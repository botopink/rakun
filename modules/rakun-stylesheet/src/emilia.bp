// `ringTokenToSheet` IS A `…ToSheet`, front 56's second shape — the first of
// the two this front adds. A ring is a BOX-SHADOW, not a border, so a width
// leaf is not one declaration but two that must arrive in order: the custom
// property that carries the ring, and the composed `box-shadow` that lists
// it beside `var(--tw-shadow)`. Listing rather than overwriting is the whole
// point — front 41's `Effect.Shadow` sets `--tw-shadow` and the two compose
// instead of the later one winning.
//
// The `--tw-ring-shadow` VALUE is what v4 documents, `0 0 0 Npx`, and not the
// README's `var(--tw-ring-inset) 0 0 0 calc(Npx + var(--tw-ring-offset-width))
// var(--tw-ring-color)`, which is the v3 shape. The composed list itself is
// still unverified — see the banner's reference-gap note.
fn ringTokenToSheet(t: Token.Ring, th: Theme) -> Sheet {
    val out = case t {
        W(_inner) -> declSheet(ringWidthDecls(ringWidthValue(_inner)));
        Color(_inner) -> declSheet(ringColorToCss(_inner, th));
        Offset(_inner) -> declSheet(ringOffsetToCss(_inner, th));
        Inset -> declSheet(oneDecl("--tw-ring-inset", "inset"));
    };
    return out;
}

// THE COMPOSED `box-shadow`, spelled ONCE for fronts 40 and 41 — upstream v4's
// five channels (`utilities.ts`, `cssBoxShadowValue`, read 2026-09-26). Each
// token writes ONE channel and this same reader, so a ring and a shadow in one
// class compose instead of the last `box-shadow` winning. Upstream registers
// every channel with `@property` and the initial `0 0 #0000`; emilia emits no
// `@property` block, so each reference carries that null shadow as its
// fallback (`transparent` rather than `#0000`, the same colour with no hex
// literal) — WITHOUT it an unset channel makes the whole declaration invalid
// at computed-value time, which is what the pre-fix `ringShadowList()` did:
// a lone `Ring.W.2` rendered no ring at all.
fn boxShadowChain() -> string {
    val chans: string[] = [
        "--tw-inset-shadow",
        "--tw-inset-ring-shadow",
        "--tw-ring-offset-shadow",
        "--tw-ring-shadow",
        "--tw-shadow",
    ];
    return chans.map({ c -> cssVarOr(c, "0 0 transparent") }).join(", ");
}

// One channel and the reader: the shape every box-shadow token has.
fn shadowChannel(channel: string, value: string) -> string {
    return oneDecl(channel, value)
        + ";"
        + oneDecl("box-shadow", boxShadowChain());
}

// Upstream's `ringShadowValue`: the inset flag, the width grown by the offset,
// the ring colour with `currentcolor` as its default.
fn ringWidthDecls(w: string) -> string {
    return shadowChannel(
        "--tw-ring-shadow",
        cssVarOr("--tw-ring-inset", "")
            + " 0 0 0 calc("
            + w
            + " + "
            + cssVarOr("--tw-ring-offset-width", "0px")
            + ") "
            + cssVarOr("--tw-ring-color", "currentcolor"),
    );
}

// Upstream's `ringOffsetShadowValue`, written beside the width it reads.
fn ringOffsetDecls(w: string) -> string {
    return oneDecl("--tw-ring-offset-width", w)
        + ";"
        + oneDecl(
            "--tw-ring-offset-shadow",
            cssVarOr("--tw-ring-inset", "")
                + " 0 0 0 var(--tw-ring-offset-width) "
                + cssVarOr(
                    "--tw-ring-offset-color",
                    themeVar(nsPrefix(Ns.Color) + "white"),
                ),
        );
}

fn ringWidthValue(s: Token.Ring.W) -> string {
    val out = case s {
        __0 -> "0px";
        __1 -> "1px";
        __2 -> "2px";
        __4 -> "4px";
        __8 -> "8px";
    };
    return out;
}

fn ringColorToCss(c: Token.Ring.Color, th: Theme) -> string {
    val out = case c {
        Red(_inner) -> "--tw-ring-color:"
            + paletteVar("red", ringColorRedShade(_inner));
        Orange(_inner) -> "--tw-ring-color:"
            + paletteVar("orange", ringColorOrangeShade(_inner));
        Amber(_inner) -> "--tw-ring-color:"
            + paletteVar("amber", ringColorAmberShade(_inner));
        Yellow(_inner) -> "--tw-ring-color:"
            + paletteVar("yellow", ringColorYellowShade(_inner));
        Lime(_inner) -> "--tw-ring-color:"
            + paletteVar("lime", ringColorLimeShade(_inner));
        Green(_inner) -> "--tw-ring-color:"
            + paletteVar("green", ringColorGreenShade(_inner));
        Emerald(_inner) -> "--tw-ring-color:"
            + paletteVar("emerald", ringColorEmeraldShade(_inner));
        Teal(_inner) -> "--tw-ring-color:"
            + paletteVar("teal", ringColorTealShade(_inner));
        Cyan(_inner) -> "--tw-ring-color:"
            + paletteVar("cyan", ringColorCyanShade(_inner));
        Sky(_inner) -> "--tw-ring-color:"
            + paletteVar("sky", ringColorSkyShade(_inner));
        Blue(_inner) -> "--tw-ring-color:"
            + paletteVar("blue", ringColorBlueShade(_inner));
        Indigo(_inner) -> "--tw-ring-color:"
            + paletteVar("indigo", ringColorIndigoShade(_inner));
        Violet(_inner) -> "--tw-ring-color:"
            + paletteVar("violet", ringColorVioletShade(_inner));
        Purple(_inner) -> "--tw-ring-color:"
            + paletteVar("purple", ringColorPurpleShade(_inner));
        Fuchsia(_inner) -> "--tw-ring-color:"
            + paletteVar("fuchsia", ringColorFuchsiaShade(_inner));
        Pink(_inner) -> "--tw-ring-color:"
            + paletteVar("pink", ringColorPinkShade(_inner));
        Rose(_inner) -> "--tw-ring-color:"
            + paletteVar("rose", ringColorRoseShade(_inner));
        Slate(_inner) -> "--tw-ring-color:"
            + paletteVar("slate", ringColorSlateShade(_inner));
        Gray(_inner) -> "--tw-ring-color:"
            + paletteVar("gray", ringColorGrayShade(_inner));
        Zinc(_inner) -> "--tw-ring-color:"
            + paletteVar("zinc", ringColorZincShade(_inner));
        Neutral(_inner) -> "--tw-ring-color:"
            + paletteVar("neutral", ringColorNeutralShade(_inner));
        Stone(_inner) -> "--tw-ring-color:"
            + paletteVar("stone", ringColorStoneShade(_inner));
        Mauve(_inner) -> "--tw-ring-color:"
            + paletteVar("mauve", ringColorMauveShade(_inner));
        Olive(_inner) -> "--tw-ring-color:"
            + paletteVar("olive", ringColorOliveShade(_inner));
        Mist(_inner) -> "--tw-ring-color:"
            + paletteVar("mist", ringColorMistShade(_inner));
        Taupe(_inner) -> "--tw-ring-color:"
            + paletteVar("taupe", ringColorTaupeShade(_inner));
        White -> "--tw-ring-color:" + themeVar(nsPrefix(Ns.Color) + "white");
        Black -> "--tw-ring-color:" + themeVar(nsPrefix(Ns.Color) + "black");
        Transparent -> "--tw-ring-color:transparent";
        Current -> "--tw-ring-color:currentColor";
        Inherit -> "--tw-ring-color:inherit";
    };
    return out;
}

