fn front37Leaves() -> Token[] {
    return flexLeaves().append(gridLeaves()).append(gapLeaves());
}

test "regression — no leaf of this front resolves a length; all 356 declare" {
    val leaves = front37Leaves();
    assert flexLeaves().length == 126;
    assert gridLeaves().length == 125;
    assert gapLeaves().length == 105;
    assert leaves.length == 356;
    assert leaves.all({ t -> tokenDeclarations(t).indexOf("rem") == -1 });
    assert leaves.all({ t -> tokenDeclarations(t).indexOf(":") != -1 });
    assert leaves.all({ t -> tokenDeclarations(t).length > 0 });
    // CONTROL, rewritten by front 38. `.Text.Size.Lg` used to spell
    // `1.125rem` and was the one real token left that resolved a `rem`;
    // it now answers `var(--text-lg)`, so THERE IS NO SUCH TOKEN ANY MORE
    // and the control is a hand-built declaration. The line below it is the
    // same fact asserted from the other side, so this walk reddens again the
    // day some front reintroduces a resolved length on `Text.Size`.
    assert "font-size:1.125rem".indexOf("rem") != -1;
    assert tokenDeclarations(.Text.Size.Lg).indexOf("rem") == -1;
}

test "regression — no leaf of this front emits a Tailwind class fragment" {
    val leaves = front37Leaves();
    assert leaves.all({ t -> tokenDeclarations(t).indexOf("gap-1") == -1 });
    assert leaves.all({ t -> tokenDeclarations(t).indexOf("gap-x-") == -1 });
    assert leaves.all({ t -> tokenDeclarations(t).indexOf("basis-") == -1 });
    assert leaves.all({ t -> tokenDeclarations(t).indexOf("order-") == -1 });
    assert leaves.all({ t -> tokenDeclarations(t).indexOf("flex-1") == -1 });
    assert leaves.all(
        { t -> tokenDeclarations(t).indexOf("grid-cols-") == -1 },
    );
    assert leaves.all({ t -> tokenDeclarations(t).indexOf("col-span-") == -1 });
    assert leaves.all(
        { t -> tokenDeclarations(t).indexOf("auto-cols-") == -1 },
    );
    assert leaves.all(
        { t -> tokenDeclarations(t).indexOf("grid-flow-") == -1 },
    );
    assert leaves.all(
        { t -> tokenDeclarations(t).indexOf("place-content-") == -1 },
    );
    assert leaves.all(
        { t -> tokenDeclarations(t).indexOf("items-start") == -1 },
    );
}

// The spacing families of this front ARE front 35's spacing family. Comparing
// them to each other rather than to expected strings is what makes them one
// ladder instead of three that agree today.
test "regression — `Gap` and `Basis` are the ladder `Pad` is, property aside" {
    val gap4 = tokenDeclarations(.Gap.All.4).split(":").at(1) ?? "";
    val pad4 = tokenDeclarations(.Pad.All.4).split(":").at(1) ?? "";
    val gapX12 = tokenDeclarations(.Gap.X.12).split(":").at(1) ?? "";
    val padT12 = tokenDeclarations(.Pad.T.12).split(":").at(1) ?? "";
    val basis8 = tokenDeclarations(.Flex.Basis.8).split(":").at(1) ?? "";
    val pad8 = tokenDeclarations(.Pad.All.8).split(":").at(1) ?? "";
    val gapHalf3 = tokenDeclarations(.Gap.All.Half.3).split(":").at(1) ?? "";
    val padHalf3 = tokenDeclarations(.Pad.All.Half.3).split(":").at(1) ?? "";
    assert gap4 == pad4;
    assert gapX12 == padT12;
    assert basis8 == pad8;
    assert gapHalf3 == padHalf3;
    assert tokenDeclarations(.Gap.All.Px) == "gap:1px";
    assert tokenDeclarations(.Pad.All.Px) == "padding:1px";
}

// ── end front 37 ─────────────────────────────────────────────────────────────

// ── front 40 — borders, outlines, rings and divides ──────────────────────────
//
// `§ 11` in four families. Two shapes, exactly as front 56 defines them:
// `borderTokenToCss` and `outlineTokenToCss` answer a DECLARATION STRING and
// the shared `case` adapts them with `declSheet`; `ringTokenToSheet` and
// `divideTokenToSheet` answer a `SHEET`, because neither family is a bare
// declaration. Those two are the only `…ToSheet` dispatchers this front adds.
//
// NO LEAF RESOLVES A COLOUR OR A RADIUS — fronts 35/36/37's rule, one level
// up. All five colour sub-sections (`Border.Color`, `Outline.Color`,
// `Ring.Color`, `Ring.Offset.Color` and `Divide.Color`) go through front 33's
// `paletteVar`, and this front holds NO COLOUR TABLE: four — five — tables
// would be five chances to drift. Every radius answers `radiusVar`, which is
// front 54's `--radius-*` ladder and the only place this front spells one.
//
// `.Border.Color.Red.500` USED TO DISCARD ITS SHADE (`border-color:red`), and
// this front's own stub — Red and Gray at 100/500/700 — is what collided with
// `Token.Color` and made six of front 33's cells unreachable in every
// spelling. botopink-lang `f01c508a` fixed the resolver (the expected type
// decides, the fully qualified spelling resolves, an ambiguous path is
// refused naming both candidates), so the grid below is the FULL one and
// nothing was renamed to dodge a hash.
//
// HEAD AUDIT, the rule fronts 36 and 37 paid for. The three new section heads
// — `Outline`, `Ring`, `Divide` — were checked against the 84 top-level
// payload variants, against the fifteen existing section heads, and against
// the lexer's keyword table. No collision. `Ring.Inset`, `Divide.XReverse`
// and `Divide.YReverse` are LEAVES, which are safe by the same rule.
//
// REFERENCE GAPS, recorded rather than hidden — see the front's README.
//   VERIFIED against upstream v4 while writing this: the `divide` child
//     selector IS `& > :not(:last-child)` (so front 35's `siblingSelector()`
//     is right and is called here rather than re-spelled); `divide-x-N` is
//     `border-inline-start-width:0px;border-inline-end-width:Npx` and
//     `divide-y-N` the block pair; `--tw-divide-x-reverse`/`-y-reverse` are
//     the reverse properties; `ring-<color>` is `--tw-ring-color`;
//     `ring-inset` is `--tw-ring-inset:inset`; and the DEFAULT RING WIDTH IN
//     V4 IS 1px, not v3's 3px — which the README told us to read rather than
//     remember, and which is why `.Ring.W.1` is upstream's bare `ring`.
//   NOT VERIFIED, and left as the README specifies them: the composed
//     `box-shadow` list, and the whole `ring-offset-*` family, which v4's
//     documentation no longer carries at all (it is a v3 carry-over). The
//     `--tw-ring-shadow` VALUE follows what v4 documents — `0 0 0 Npx` — and
//     not the README's v3-shaped `calc(...)` form.

// The only place this front spells a radius reference. Front 54's ladder
// carries `--radius-xs` through `--radius-4xl`; `rounded-none` and
// `rounded-full` are literals upstream and stay literals here.
fn radiusVar(name: string) -> string {
    return themeVar(nsPrefix(Ns.Radius) + name);
}

fn borderTokenToCss(t: Token.Border, th: Theme) -> string {
    val out = case t {
        W(_inner) -> borderWidthToCss(_inner);
        Style(_inner) -> borderStyleToCss(_inner);
        Color(_inner) -> borderColorToCss(_inner, th);
        Rounded(_inner) -> borderRoundedToCss(_inner, th);
    };
    return out;
}

// THE SHORTHAND KEEPS ITS PRE-40 OUTPUT. `.Border.W.0` is `border-width:0`
// and not `0px`: the README's own acceptance bullet says the four existing
// leaves emit exactly what they emit today, and its table says `0px`. The
// bullet wins, and the eight directional sub-sections follow the shorthand so
// that one section speaks one way.
fn borderWidthToCss(s: Token.Border.W) -> string {
    val out = case s {
        __0 -> "border-width:0";
        __1 -> "border-width:1px";
        __2 -> "border-width:2px";
        __4 -> "border-width:4px";
        __8 -> "border-width:8px";
        X(_inner) -> axisDecl(
            "border-left-width",
            "border-right-width",
            borderWidthXValue(_inner),
        );
        Y(_inner) -> axisDecl(
            "border-top-width",
            "border-bottom-width",
            borderWidthYValue(_inner),
        );
        T(_inner) -> oneDecl("border-top-width", borderWidthTValue(_inner));
        R(_inner) -> oneDecl("border-right-width", borderWidthRValue(_inner));
        B(_inner) -> oneDecl("border-bottom-width", borderWidthBValue(_inner));
        L(_inner) -> oneDecl("border-left-width", borderWidthLValue(_inner));
        S(_inner) -> oneDecl(
            "border-inline-start-width",
            borderWidthSValue(_inner),
        );
        E(_inner) -> oneDecl(
            "border-inline-end-width",
            borderWidthEValue(_inner),
        );
    };
    return out;
}

fn borderWidthXValue(s: Token.Border.W.X) -> string {
    val out = case s {
        __0 -> "0";
        __1 -> "1px";
        __2 -> "2px";
        __4 -> "4px";
        __8 -> "8px";
    };
    return out;
}

