        .Divide.Color.Taupe.200,
        .Divide.Color.Taupe.300,
        .Divide.Color.Taupe.400,
        .Divide.Color.Taupe.500,
        .Divide.Color.Taupe.600,
        .Divide.Color.Taupe.700,
        .Divide.Color.Taupe.800,
        .Divide.Color.Taupe.900,
        .Divide.Color.Taupe.950,
        .Divide.Color.White,
        .Divide.Color.Black,
        .Divide.Color.Transparent,
        .Divide.Color.Current,
        .Divide.Color.Inherit,
        .Divide.Style.Solid,
        .Divide.Style.Dashed,
        .Divide.Style.Dotted,
        .Divide.Style.Double,
        .Divide.Style.Hidden,
        .Divide.Style.None,
        .Divide.XReverse,
        .Divide.YReverse,
    ];
    return leaves;
}

fn front40Leaves() -> Token[] {
    return borderLeaves()
        .append(outlineLeaves())
        .append(ringLeaves())
        .append(divideLeaves());
}

// WHERE a token declares and WHAT it declares. `tokenDeclarations` above
// answers the second and flattens the first away, which is right for the
// fourteen sections that declare on the element — but `Divide` declares on the
// element's CHILDREN, so its tests read the rule. Both go through front 56's
// `firstRuleOf`, which is already the house helper for this.
fn tokenSelector(t: Token) -> string {
    return firstRuleOf(tokenToSheet(t, defaultTheme())).selector;
}

fn firstDeclaration(t: Token) -> string {
    return firstRuleOf(tokenToSheet(t, defaultTheme())).declarations;
}

// ── width ────────────────────────────────────────────────────────────────────

test "Border.W — the four pre-40 leaves emit exactly what they emitted before" {
    assert tokenDeclarations(.Border.W.0) == "border-width:0";
    assert tokenDeclarations(.Border.W.1) == "border-width:1px";
    assert tokenDeclarations(.Border.W.2) == "border-width:2px";
    assert tokenDeclarations(.Border.W.4) == "border-width:4px";
}

test "Border.W.8 — the fifth width the section did not have" {
    assert tokenDeclarations(.Border.W.8) == "border-width:8px";
}

test "Border.W — an AXIS is two declarations and a SIDE is one" {
    assert tokenDeclarations(.Border.W.X.1)
        == "border-left-width:1px;border-right-width:1px";
    assert tokenDeclarations(.Border.W.Y.1)
        == "border-top-width:1px;border-bottom-width:1px";
    assert tokenDeclarations(.Border.W.T.1) == "border-top-width:1px";
    assert tokenDeclarations(.Border.W.R.1) == "border-right-width:1px";
    assert tokenDeclarations(.Border.W.B.1) == "border-bottom-width:1px";
    assert tokenDeclarations(.Border.W.L.1) == "border-left-width:1px";
}

test "Border.W — the logical pair follows the writing direction" {
    assert tokenDeclarations(.Border.W.S.1) == "border-inline-start-width:1px";
    assert tokenDeclarations(.Border.W.E.1) == "border-inline-end-width:1px";
}

test "Border.W — every directional sub-section answers all five widths" {
    assert tokenDeclarations(.Border.W.T.0) == "border-top-width:0";
    assert tokenDeclarations(.Border.W.T.2) == "border-top-width:2px";
    assert tokenDeclarations(.Border.W.T.4) == "border-top-width:4px";
    assert tokenDeclarations(.Border.W.T.8) == "border-top-width:8px";
    assert tokenDeclarations(.Border.W.X.4)
        == "border-left-width:4px;border-right-width:4px";
    assert tokenDeclarations(.Border.W.E.8) == "border-inline-end-width:8px";
}

// ── style ────────────────────────────────────────────────────────────────────

test "Border.Style — six values, and `Hidden` is not `None`" {
    assert tokenDeclarations(.Border.Style.Solid) == "border-style:solid";
    assert tokenDeclarations(.Border.Style.Dashed) == "border-style:dashed";
    assert tokenDeclarations(.Border.Style.Dotted) == "border-style:dotted";
    assert tokenDeclarations(.Border.Style.Double) == "border-style:double";
    assert tokenDeclarations(.Border.Style.Hidden) == "border-style:hidden";
    assert tokenDeclarations(.Border.Style.None) == "border-style:none";
}

// ── colour ───────────────────────────────────────────────────────────────────

test "Border.Color — THE SHADE IS NO LONGER DISCARDED" {
    assert tokenDeclarations(.Border.Color.Slate.200)
        == "border-color:var(--color-slate-200)";
    assert tokenDeclarations(.Border.Color.Red.500)
        == "border-color:var(--color-red-500)";
    assert tokenDeclarations(.Border.Color.Red.100)
        != tokenDeclarations(.Border.Color.Red.900);
}

test "Border.Color — the named colours and the two CSS-wide keywords" {
    assert tokenDeclarations(.Border.Color.White)
        == "border-color:var(--color-white)";
    assert tokenDeclarations(.Border.Color.Transparent)
        == "border-color:transparent";
    assert tokenDeclarations(.Border.Color.Current)
        == "border-color:currentColor";
}

// THE SIX CELLS THE STUB MADE UNREACHABLE. `Border.Color`'s Red and Gray ran
// 100/500/700, which is exactly the set `Token.Color` also carries, and the
// resolver picked between the two enums by HASH ORDER — so every spelling of
// `.Color.Red.500` red, the fully qualified one included. botopink-lang
// `f01c508a` made the expected type decide. Both sections are asserted here,
// in the plain and the fully qualified spelling, because the defect was that
// ONE of them captured the other.
test "regression — the six cells the Border stub used to capture all resolve" {
    assert tokenDeclarations(.Color.Red.100) == "color:var(--color-red-100)";
    assert tokenDeclarations(.Color.Red.500) == "color:var(--color-red-500)";
    assert tokenDeclarations(.Color.Red.700) == "color:var(--color-red-700)";
    assert tokenDeclarations(.Color.Gray.100) == "color:var(--color-gray-100)";
    assert tokenDeclarations(.Color.Gray.500) == "color:var(--color-gray-500)";
    assert tokenDeclarations(.Color.Gray.700) == "color:var(--color-gray-700)";
    assert tokenDeclarations(.Border.Color.Red.100)
        == "border-color:var(--color-red-100)";
    assert tokenDeclarations(.Border.Color.Red.500)
        == "border-color:var(--color-red-500)";
    assert tokenDeclarations(.Border.Color.Red.700)
        == "border-color:var(--color-red-700)";
    assert tokenDeclarations(.Border.Color.Gray.100)
        == "border-color:var(--color-gray-100)";
    assert tokenDeclarations(.Border.Color.Gray.500)
        == "border-color:var(--color-gray-500)";
    assert tokenDeclarations(.Border.Color.Gray.700)
        == "border-color:var(--color-gray-700)";
}

test "regression — the fully qualified spelling resolves in both enums" {
    val a: Token = Token.Color.Red.500;
    val b: Token = Token.Border.Color.Red.500;
    assert tokenDeclarations(a) == "color:var(--color-red-500)";
    assert tokenDeclarations(b) == "border-color:var(--color-red-500)";
}

// ONE PALETTE, FIVE CONSUMERS. The five colour sub-sections differ only in the
// PROPERTY they name; the reference itself is `paletteVar`'s and is therefore
// the same text in all five. Five colour tables would be five chances to drift,
// which is what this assert exists to catch.
test "the five colour sub-sections agree, because all five call paletteVar" {
    val want = "var(--color-emerald-600)";
    assert tokenDeclarations(.Border.Color.Emerald.600)
        == "border-color:" + want;
    assert tokenDeclarations(.Outline.Color.Emerald.600)
        == "outline-color:" + want;
    assert tokenDeclarations(.Ring.Color.Emerald.600)
        == "--tw-ring-color:" + want;
    assert tokenDeclarations(.Ring.Offset.Color.Emerald.600)
        == "--tw-ring-offset-color:" + want;
    assert firstDeclaration(.Divide.Color.Emerald.600)
        == "border-color:" + want;
}

// ── radius ───────────────────────────────────────────────────────────────────

test "Border.Rounded — ten leaves, eight of them theme references" {
    assert tokenDeclarations(.Border.Rounded.None) == "border-radius:0";
    assert tokenDeclarations(.Border.Rounded.Xs)
        == "border-radius:var(--radius-xs)";
    assert tokenDeclarations(.Border.Rounded.Sm)
        == "border-radius:var(--radius-sm)";
    assert tokenDeclarations(.Border.Rounded.Md)
        == "border-radius:var(--radius-md)";
    assert tokenDeclarations(.Border.Rounded.Lg)
        == "border-radius:var(--radius-lg)";
    assert tokenDeclarations(.Border.Rounded.Xl)
        == "border-radius:var(--radius-xl)";
    assert tokenDeclarations(.Border.Rounded.X2xl)
        == "border-radius:var(--radius-2xl)";
    assert tokenDeclarations(.Border.Rounded.X3xl)
        == "border-radius:var(--radius-3xl)";
    assert tokenDeclarations(.Border.Rounded.X4xl)
        == "border-radius:var(--radius-4xl)";
    assert tokenDeclarations(.Border.Rounded.Full) == "border-radius:9999px";
}

// The regression the README asks for in both directions: `Full` is still the
// literal upstream prints, and `Lg` is no longer the literal it used to be.
test "regression — Full stays 9999px and Lg stops being a rem" {
    assert tokenDeclarations(.Border.Rounded.Full) == "border-radius:9999px";
    assert tokenDeclarations(.Border.Rounded.Lg).indexOf("rem") == -1;
    assert tokenDeclarations(.Border.Rounded.Lg).indexOf("0.5rem") == -1;
    assert tokenDeclarations(.Border.Rounded.Lg)
        == "border-radius:var(--radius-lg)";
}

test "Border.Rounded — a SIDE form is two corner properties" {
    assert tokenDeclarations(.Border.Rounded.T.Lg)
        == "border-top-left-radius:var(--radius-lg);border-top-right-radius:var(--radius-lg)";
    assert tokenDeclarations(.Border.Rounded.R.Lg)
        == "border-top-right-radius:var(--radius-lg);border-bottom-right-radius:var(--radius-lg)";
    assert tokenDeclarations(.Border.Rounded.B.Lg)
        == "border-bottom-right-radius:var(--radius-lg);border-bottom-left-radius:var(--radius-lg)";
    assert tokenDeclarations(.Border.Rounded.L.Lg)
        == "border-top-left-radius:var(--radius-lg);border-bottom-left-radius:var(--radius-lg)";
}

test "Border.Rounded — a CORNER form is one corner property" {
    assert tokenDeclarations(.Border.Rounded.Tl.Lg)
        == "border-top-left-radius:var(--radius-lg)";
    assert tokenDeclarations(.Border.Rounded.Tr.Lg)
        == "border-top-right-radius:var(--radius-lg)";
    assert tokenDeclarations(.Border.Rounded.Br.Lg)
        == "border-bottom-right-radius:var(--radius-lg)";
    assert tokenDeclarations(.Border.Rounded.Bl.Lg)
        == "border-bottom-left-radius:var(--radius-lg)";
}

test "Border.Rounded — the eight logical corners follow the writing direction" {
    assert tokenDeclarations(.Border.Rounded.S.Lg)
        == "border-start-start-radius:var(--radius-lg);border-end-start-radius:var(--radius-lg)";
    assert tokenDeclarations(.Border.Rounded.E.Lg)
        == "border-start-end-radius:var(--radius-lg);border-end-end-radius:var(--radius-lg)";
    assert tokenDeclarations(.Border.Rounded.Ss.Lg)
        == "border-start-start-radius:var(--radius-lg)";
    assert tokenDeclarations(.Border.Rounded.Se.Lg)
        == "border-start-end-radius:var(--radius-lg)";
    assert tokenDeclarations(.Border.Rounded.Es.Lg)
        == "border-end-start-radius:var(--radius-lg)";
    assert tokenDeclarations(.Border.Rounded.Ee.Lg)
        == "border-end-end-radius:var(--radius-lg)";
}

test "Border.Rounded — every directional sub-section carries the FULL ladder" {
    assert tokenDeclarations(.Border.Rounded.Tl.Full)
        == "border-top-left-radius:9999px";
    assert tokenDeclarations(.Border.Rounded.Tl.None)
        == "border-top-left-radius:0";
    assert tokenDeclarations(.Border.Rounded.Ee.X4xl)
        == "border-end-end-radius:var(--radius-4xl)";
    assert tokenDeclarations(.Border.Rounded.B.Xs)
        == "border-bottom-right-radius:var(--radius-xs);border-bottom-left-radius:var(--radius-xs)";
}

// The ladder is front 54's and this front does not restate it — but a radius
// token that referenced a name the theme does not carry would emit a `var()`
// that resolves to nothing, so the eight are read back here.
test "the eight --radius-* names this front references are all in the theme" {
    val es = defaultTheme();
    assert themeValue(es, "--radius-xs") != "";
    assert themeValue(es, "--radius-sm") != "";
    assert themeValue(es, "--radius-md") != "";
    assert themeValue(es, "--radius-lg") != "";
    assert themeValue(es, "--radius-xl") != "";
    assert themeValue(es, "--radius-2xl") != "";
    assert themeValue(es, "--radius-3xl") != "";
    assert themeValue(es, "--radius-4xl") != "";
}

// ── outline ──────────────────────────────────────────────────────────────────

test "Outline.W and Outline.Style — five widths and four real styles" {
    assert tokenDeclarations(.Outline.W.0) == "outline-width:0px";
    assert tokenDeclarations(.Outline.W.1) == "outline-width:1px";
    assert tokenDeclarations(.Outline.W.2) == "outline-width:2px";
    assert tokenDeclarations(.Outline.W.4) == "outline-width:4px";
    assert tokenDeclarations(.Outline.W.8) == "outline-width:8px";
    assert tokenDeclarations(.Outline.Style.Solid) == "outline-style:solid";
    assert tokenDeclarations(.Outline.Style.Dashed) == "outline-style:dashed";
    assert tokenDeclarations(.Outline.Style.Dotted) == "outline-style:dotted";
    assert tokenDeclarations(.Outline.Style.Double) == "outline-style:double";
}

// `outline-none` IS NOT `outline-style:none`. Upstream prints it as the
// shorthand at two pixels of TRANSPARENT outline plus an offset, so a
// high-contrast mode still renders a ring where the design removed one. A
// transcription that wrote `outline-style:none` would be silently
// inaccessible, which is why the absence is asserted and not only the presence.
test "Outline.Style.None — two declarations, and never outline-style:none" {
    val decl = tokenDeclarations(.Outline.Style.None);
    assert decl == "outline:2px solid transparent;outline-offset:2px";
    assert decl.indexOf("outline-style:none") == -1;
    assert decl.indexOf("outline-style") == -1;
}

test "Outline.Offset — five positive offsets and four negative ones" {
    assert tokenDeclarations(.Outline.Offset.0) == "outline-offset:0px";
    assert tokenDeclarations(.Outline.Offset.1) == "outline-offset:1px";
    assert tokenDeclarations(.Outline.Offset.2) == "outline-offset:2px";
    assert tokenDeclarations(.Outline.Offset.4) == "outline-offset:4px";
    assert tokenDeclarations(.Outline.Offset.8) == "outline-offset:8px";
    assert tokenDeclarations(.Outline.Offset.Neg.1) == "outline-offset:-1px";
    assert tokenDeclarations(.Outline.Offset.Neg.2) == "outline-offset:-2px";
    assert tokenDeclarations(.Outline.Offset.Neg.4) == "outline-offset:-4px";
    assert tokenDeclarations(.Outline.Offset.Neg.8) == "outline-offset:-8px";
}

test "Outline.Color goes through paletteVar, like the other four" {
    assert tokenDeclarations(.Outline.Color.Blue.500)
        == "outline-color:var(--color-blue-500)";
    assert tokenDeclarations(.Outline.Color.Transparent)
        == "outline-color:transparent";
}

// A FOCUS RING THAT DOES NOT MOVE LAYOUT, composed with front 34's modifier —
// the acceptance bullet of Step 3. The outline is the ring; `focus-visible` is
// the keyboard-only state; and the two declarations land in ONE sibling rule
// under the modifier's selector, not in the class body.
test "end to end — a focus-visible outline ring is one modified rule" {
    val ring: Token[] = [.Outline.W.2, .Outline.Color.Indigo.500];
    val tokens: Token[] = [Token.FocusVisible(ring)];
    val cls = emilia(tokens);
    val doc = await flushWith(bareOptions());
    assert doc.indexOf(
        "."
            + cls
            + ":focus-visible{outline-width:2px;"
            + "outline-color:var(--color-indigo-500)}",
    )
        != -1;
    // The ring does not move layout: no `border-*` and no `box-shadow` reached
    // the document, which is the whole reason `outline-*` exists beside them.
    assert doc.indexOf("border-width") == -1;
    assert doc.indexOf("box-shadow") == -1;
}

// ── ring ─────────────────────────────────────────────────────────────────────

test "Ring.W — the custom property AND the composed box-shadow" {
    val decl = tokenDeclarations(.Ring.W.2);
    assert decl
        == "--tw-ring-shadow:var(--tw-ring-inset, ) 0 0 0 calc(2px + var(--tw-ring-offset-width, 0px)) var(--tw-ring-color, currentcolor);box-shadow:"
            + "var(--tw-inset-shadow, 0 0 transparent), var(--tw-inset-ring-shadow, 0 0 transparent), "
            + "var(--tw-ring-offset-shadow, 0 0 transparent), var(--tw-ring-shadow, 0 0 transparent), "
            + "var(--tw-shadow, 0 0 transparent)";
    assert decl.indexOf("--tw-ring-shadow:") != -1;
    assert decl.indexOf("box-shadow:") != -1;
}

// EVERY CHANNEL CARRIES ITS NULL SHADOW. Without the fallback, an unset channel
// makes the whole `box-shadow` invalid at computed-value time, and a lone ring
// renders nothing — the pre-fix list read three channels with no fallback.
test "the box-shadow reader — five channels, each with a fallback" {
    val chain = boxShadowChain();
    assert chain.split("var(").length == 6;
    assert chain.split(", 0 0 transparent)").length == 6;
    assert chain.indexOf("#") == -1;
}

// UPSTREAM V4'S DEFAULT RING IS 1px, NOT V3'S 3px. The README's reference-gap
// table said to read this rather than remember it; it was read, and `.Ring.W.1`
// is upstream's bare `ring`.
test "Ring.W — the ladder, and the v4 default the README told us to verify" {
    assert tokenDeclarations(.Ring.W.0).indexOf(" 0 0 0 calc(0px + ") != -1;
    assert tokenDeclarations(.Ring.W.1).indexOf(" 0 0 0 calc(1px + ") != -1;
    assert tokenDeclarations(.Ring.W.4).indexOf(" 0 0 0 calc(4px + ") != -1;
    assert tokenDeclarations(.Ring.W.8).indexOf(" 0 0 0 calc(8px + ") != -1;
    assert tokenDeclarations(.Ring.W.1).indexOf("3px") == -1;
}

test "Ring.Inset and Ring.Offset — the inset flag and the two offset families" {
    assert tokenDeclarations(.Ring.Inset) == "--tw-ring-inset:inset";
    assert tokenDeclarations(.Ring.Offset.W.2)
        == "--tw-ring-offset-width:2px;"
            + "--tw-ring-offset-shadow:var(--tw-ring-inset, ) 0 0 0 var(--tw-ring-offset-width) "
            + "var(--tw-ring-offset-color, var(--color-white))";
    assert tokenDeclarations(.Ring.Offset.Color.White)
        == "--tw-ring-offset-color:var(--color-white)";
}

// COMPOSITION, NOT CLOBBERING. Every ring and shadow token writes ONE channel of
// the shared `boxShadowChain()` reader; the pre-audit wording below predates it.
// The ring's `box-shadow` LISTS `var(--tw-shadow)`
// rather than writing a shadow of its own, so front 41's `Effect.Shadow` — once
// it sets `--tw-shadow` — flows through the same declaration instead of being
// overwritten by it. That is the whole reason `ringTokenToSheet` exists.
test "Ring composes with Effect.Shadow rather than overwriting it" {
    val tokens: Token[] = [.Ring.W.2, .Effect.Shadow.Md];
    val decls = declarationsOf(tokensToSheet(tokens, defaultTheme()))
        .join(";")
        .split(";");
    assert decls.length == 4;
    assert (decls.at(0) ?? "").startsWith("--tw-ring-shadow:");
    assert (decls.at(2) ?? "") == "--tw-shadow:var(--shadow-md)";
    assert (decls.at(1) ?? "") == "box-shadow:" + boxShadowChain();
    assert (decls.at(3) ?? "x") == (decls.at(1) ?? "y");
}

// CONTRACT 4 — the class name is a pure function of the token list AND token
// ORDER IS CLASS IDENTITY. The ring and the shadow both reach `box-shadow`, so
// swapping them is the sharpest case the contract has: two different classes,
// and the declarations in the order they were written.
test "contract 4 — swapping Ring and Effect.Shadow changes the class" {
    val a: Token[] = [.Ring.W.2, .Effect.Shadow.Md];
    val b: Token[] = [.Effect.Shadow.Md, .Ring.W.2];
    val clsA = emilia(a);
    val clsB = emilia(b);
    assert clsA != clsB;
    assert emilia(a) == clsA;
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("." + clsA) != -1;
    assert doc.indexOf("." + clsB) != -1;
}

// ── divide ───────────────────────────────────────────────────────────────────

test "Divide.Y — a rule on the CHILDREN, upstream's reverse-aware pair" {
    assert firstDeclaration(.Divide.Y.2)
        == "--tw-divide-y-reverse:0;border-top-width:calc(2px * var(--tw-divide-y-reverse));border-bottom-width:calc(2px * calc(1 - var(--tw-divide-y-reverse)))";
    assert firstDeclaration(.Divide.Y.1)
        == "--tw-divide-y-reverse:0;border-top-width:calc(1px * var(--tw-divide-y-reverse));border-bottom-width:calc(1px * calc(1 - var(--tw-divide-y-reverse)))";
    assert tokenSelector(.Divide.Y.2) == ":where(& > :not(:last-child))";
}

test "Divide.X — the logical pair, as upstream emits it" {
    assert firstDeclaration(.Divide.X.2)
        == "--tw-divide-x-reverse:0;border-inline-start-width:calc(2px * var(--tw-divide-x-reverse));border-inline-end-width:calc(2px * calc(1 - var(--tw-divide-x-reverse)))";
    assert firstDeclaration(.Divide.X.1)
        == "--tw-divide-x-reverse:0;border-inline-start-width:calc(1px * var(--tw-divide-x-reverse));border-inline-end-width:calc(1px * calc(1 - var(--tw-divide-x-reverse)))";
}

test "Divide.Color, Divide.Style and the two reverse flags" {
    assert firstDeclaration(.Divide.Color.Slate.200)
        == "border-color:var(--color-slate-200)";
    assert firstDeclaration(.Divide.Style.Dashed) == "border-style:dashed";
    assert firstDeclaration(.Divide.XReverse) == "--tw-divide-x-reverse:1";
    assert firstDeclaration(.Divide.YReverse) == "--tw-divide-y-reverse:1";
}

// A width, a colour and a style TARGET THE SAME SELECTOR, which is what lets
// them compose on ONE set of children rather than three. The renderer merges
// rules that share a selector and an at-rule, so "same selector" and "one child
// rule" are the same statement — the end-to-end test below reads the merged
// rule back out of the document and proves it.
test "Divide — width, colour and style all target the same child selector" {
    val want = siblingSelector();
    assert tokenSelector(.Divide.Y.2) == want;
    assert tokenSelector(.Divide.Color.Slate.200) == want;
    assert tokenSelector(.Divide.Style.Dashed) == want;
    assert tokenSelector(.Divide.X.4) == want;
    assert tokenSelector(.Divide.XReverse) == want;
    assert tokenSelector(.Divide.YReverse) == want;
}

// ── THE CROSS-FRONT ASSERT front 35 could not write ──────────────────────────
//
// Front 35 shipped `siblingSelector()` and said front 40 must CALL it rather
// than re-spell `& > :not(:last-child)`, but it could not prove the two agreed
// because `Divide` did not exist yet. It exists now, so the proof is written
// here: the two families' selectors are compared BYTE FOR BYTE. Two fronts
// writing the same selector by hand are two fronts that will eventually write
// it differently, and this is the test that would catch it.
//
// The selector itself is upstream v4's (4.3.2, compiled): `divide-*` and
// `space-*` both use `:where(& > :not(:last-child))` — not the v3
// `& > :not([hidden]) ~ :not([hidden])`.
test "Divide and front 35's Space emit BYTE-IDENTICAL child selectors" {
    assert tokenSelector(.Divide.Y.2) == tokenSelector(.Space.Y.2);
    assert tokenSelector(.Divide.X.2) == tokenSelector(.Space.X.2);
    assert tokenSelector(.Divide.Color.Slate.200) == tokenSelector(.Space.Y.4);
    assert tokenSelector(.Divide.Y.2) == siblingSelector();
    assert tokenSelector(.Space.Y.2) == siblingSelector();
}

test "the child selector is a one-`&` template and is spelled in ONE place" {
    val sel = siblingSelector();
    assert sel == ":where(& > :not(:last-child))";
    assert sel.split("&").length == 2;
}

// ── end to end ───────────────────────────────────────────────────────────────

test "end to end — a card with a rounded top, a square bottom and a border" {
    val card: Token[] = [
        .Border.W.1,
        .Border.Color.Slate.200,
        .Border.Rounded.T.Lg,
    ];
    val cls = emilia(card);
    val doc = await flushWith(bareOptions());
    assert doc.indexOf(
        "."
            + cls
            + "{border-width:1px;"
            + "border-color:var(--color-slate-200);"
            + "border-top-left-radius:var(--radius-lg);"
            + "border-top-right-radius:var(--radius-lg)}",
    )
        != -1;
}

test "end to end — a divided list is a rule on the children of the class" {
    val list: Token[] = [.Divide.Y.1, .Divide.Color.Gray.200];
    val cls = emilia(list);
    val doc = await flushWith(bareOptions());
    // ONE child rule, not three: the width and the colour share a selector, so
    // the renderer merges them into a single rule on the same children.
    assert doc.indexOf(
        ":where(."
            + cls
            + " > :not(:last-child)){"
            + "--tw-divide-y-reverse:0;border-top-width:calc(1px * var(--tw-divide-y-reverse));border-bottom-width:calc(1px * calc(1 - var(--tw-divide-y-reverse)));"
            + "border-color:var(--color-gray-200)}",
    )
        != -1;
    // and the class itself declares NOTHING — every declaration is on a child.
    assert doc.indexOf("." + cls + "{") == -1;
}

// ── the walk, and the control that must fail ─────────────────────────────────

// No leaf of this front RESOLVES a colour or a radius: every colour is a
// `var(--color-*)` and every radius a `var(--radius-*)`, so a project that
// overrides either moves these tokens with it. The two literals that survive
// are upstream's own — `9999px` for `rounded-full` and `0` for `rounded-none` —
// and neither is a `rem`, a hex or a colour function.
fn f40CarriesNoLiteral(decl: string) -> bool {
    return decl.indexOf("#") == -1
        && decl.indexOf("oklch(") == -1
        && decl.indexOf("rgb(") == -1
        && decl.indexOf("rem") == -1;
}

// No leaf emits a Tailwind CLASS NAME where a CSS value belongs — the failure
// mode of transcribing a reference table into the value column. `rounded-`,
// `border-x-` and `border-y-` name no CSS property and appear in no custom
// property this front writes.
fn f40CarriesNoClassFragment(decl: string) -> bool {
    return decl.indexOf("rounded-") == -1
        && decl.indexOf("border-x-") == -1
        && decl.indexOf("border-y-") == -1
        && decl.indexOf("outline-w-") == -1;
}

fn f40IsWellFormed(decl: string) -> bool {
    return decl.length > 0 && decl.indexOf(":") != -1;
}

test "regression — every one of the 1704 leaves of this front declares something" {
    val leaves = front40Leaves();
    assert borderLeaves().length == 492;
    assert outlineLeaves().length == 310;
    assert ringLeaves().length == 593;
    assert divideLeaves().length == 309;
    assert leaves.length == 1704;
    assert leaves.all({ t -> f40IsWellFormed(firstDeclaration(t)) });
}

test "regression — no leaf of this front resolves a colour or a radius" {
    val leaves = front40Leaves();
    assert leaves.all({ t -> f40CarriesNoLiteral(firstDeclaration(t)) });
}

test "regression — no leaf of this front emits a Tailwind class fragment" {
    val leaves = front40Leaves();
    assert leaves.all({ t -> f40CarriesNoClassFragment(firstDeclaration(t)) });
}

// THE DEFECT THIS FRONT EXISTS TO FIX, walked rather than sampled. The pre-40
// `borderColorToCss` answered `"border-color:red"` for every shade — the arm
// TYPE-CHECKED, the section looked complete, and the shade level did nothing.
// A literal probe does NOT catch that: `red` is not a hex, not an `oklch(` and
// not a `rem`. So every one of the 1430 colour cells is asserted to carry a
// `var(--color-` reference, and a section's cells are asserted to be that many
// DISTINCT strings — which is the assert a discarded payload cannot survive.
// A section contributes 288: the 26 x 11 grid plus `White` and `Black`, which
// reference the theme too. `Transparent`, `Current` and `Inherit` are CSS-wide
// keywords with no theme entry and are deliberately not references.
// The five `Ring.Offset.W` leaves add five more: their offset shadow falls back
// to `var(--color-white)`, upstream's `#fff` initial as a theme reference.
test "regression — every colour cell of this front is a theme reference" {
    val leaves = front40Leaves();
    val cells = leaves.filter(
        { t -> firstDeclaration(t).indexOf("var(--color-") != -1 },
    );
    assert cells.length == 1445;
}

test "regression — a section's 288 colour cells are 288 DISTINCT declarations" {
    val leaves = borderLeaves();
    val cells = leaves.filter(
        { t -> firstDeclaration(t).indexOf("var(--color-") != -1 },
    );
    assert cells.length == 288;
    val decls = cells.map({ t -> firstDeclaration(t) });
    // The duplicate check counts occurrences — written when `Array.lastIndexOf`
    // did not lower on erlang (§ Maintainer rules), the per-target divergence
    // caught by running both backends rather than one.
    val dupes = decls.filter({ d -> decls.filter({ x -> x == d }).length > 1 });
    assert dupes.length == 0;
}

// The same walk on the other four sub-sections, so a discarded shade in any one
// of them reddens here and not in some other front's test months later.
test "regression — the other four colour sub-sections are distinct too" {
    assert outlineLeaves().filter({ t ->
        firstDeclaration(t).indexOf("var(--color-") != -1;
    }).length
        == 288;
    assert ringLeaves().filter({ t ->
        firstDeclaration(t).indexOf("var(--color-") != -1;
    }).length
        == 581;
    assert divideLeaves().filter({ t ->
        firstDeclaration(t).indexOf("var(--color-") != -1;
    }).length
        == 288;
}

// THE CONTROL THAT MUST FAIL. A walk that cannot fail proves nothing, so each
// probe is shown to discriminate on a REAL token where one exists: `.Bg.White`
// spells a hex, and an empty string is not a declaration.
// `.Border.Rounded.Lg` was the control the three earlier fronts used, and this
// front is exactly why it can no longer be one — it now answers
// `var(--radius-lg)` and would pass the probe vacuously. `.Text.Size.Lg`
// replaced it and lasted one front: front 38 made that a reference too, so the
// `rem` arm now takes a hand-built declaration.
test "regression — the three probes discriminate, on real tokens" {
    // front 38 made `.Text.Size.Lg` a reference (`var(--text-lg)`), so the
    // `rem` probe is shown to discriminate on a hand-built declaration; the
    // two real-token probes below are untouched.
    assert f40CarriesNoLiteral("font-size:1.125rem") == false;
    assert f40CarriesNoLiteral(tokenDeclarations(.Bg.White)) == false;
    assert f40CarriesNoLiteral(tokenDeclarations(.Border.Rounded.Lg));
    assert f40IsWellFormed("") == false;
    assert f40IsWellFormed("border-width") == false;
    assert f40IsWellFormed("border-width:1px");
    assert f40CarriesNoClassFragment("border-radius:rounded-lg") == false;
    assert f40CarriesNoClassFragment("border-radius:var(--radius-lg)");
    // and the colour-reference probe discriminates too: a shade-discarding arm
    // emits a bare keyword, which carries no `var(--color-` at all.
    assert "border-color:teal".indexOf("var(--color-") == -1;
    assert firstDeclaration(.Border.Color.Teal.500).indexOf("var(--color-")
        != -1;
}

// THE PLANTED DEFECT, run rather than described: one stray literal token is
// appended to the real list and the whole walk is asserted to FAIL. This is the
// same shape front 39 used, and it is what proves the `all` over 1704 leaves is
// not passing because the list is empty or the probe is inert.
test "regression — the walk fails when a literal is planted in it" {
    // The stray was `.Text.Size.Lg` until front 38 made it a reference.
    // `.Bg.White` is front 39's and still spells `background:#ffffff`.
    val strays: Token[] = [.Bg.White];
    val planted: Token[] = front40Leaves().append(strays);
    assert planted.length == 1705;
    assert planted.all({ t -> f40CarriesNoLiteral(firstDeclaration(t)) })
        == false;
    assert front40Leaves().all(
        { t -> f40CarriesNoLiteral(firstDeclaration(t)) },
    );
}

// ── end front 40 ─────────────────────────────────────────────────────────────

// ── front 41 — effects ───────────────────────────────────────────────────────
//
// FRONT 41 OWNS EVERYTHING BETWEEN THIS BANNER AND ITS CLOSING ONE: the
// `Effect`, `Blend` and `Mask` dispatchers, their sub-dispatchers, the three
// arbitrary-value wrappers and the tests under the same name.
//
// THE DEFECT THIS FRONT EXISTS FOR. `shadowToCss` used to answer
// `"box-shadow:sm"`, `"box-shadow:md"`, `"box-shadow:lg"` and
// `"box-shadow:xl"` — the Tailwind CLASS SUFFIX where a CSS value belongs. A
// browser discards the whole declaration, so `.Effect.Shadow.Md` shipped as a
// card with no shadow and nothing in the suite said so: the only assertion
// that touched it pinned the wrong string. The four leaf NAMES are unchanged,
// so every existing call site still type-checks; what they EMIT is the fix.
//
// NO LEAF RESOLVES A SHADOW VALUE — fronts 35-40's rule, one family further
// on. `box-shadow`, `box-shadow: inset …` and `text-shadow` are
// `themeVar(…)` lookups against front 54's `--shadow-*`, `--inset-shadow-*`
// and `--text-shadow-*` names, which is what the reference's "Propriedade
// CSS" column prints. A dispatcher that resolved `var(--shadow-md)` to
// `0 4px 6px -1px rgb(0 0 0 / 0.1), …` would hard-code a value the theme is
// allowed to override.
//
// THE ONE EXCEPTION, and the front README's acceptance bullet is wrong about
// it: `shadow-inner` has NO `--shadow-inner` variable upstream and `§ 12.1`
// prints its value as a literal — `box-shadow: inset 0 2px 4px 0 rgb(0 0 0 /
// 0.05)`. So exactly one arm in this front carries an `rgb(`, it is
// `Shadow.Inner`, and the regression walk below asserts that from both sides:
// every other leaf is `rgb(`-free AND `Shadow.Inner` does carry one. Writing
// it as a theme lookup would invent a variable the reference does not have.
//
// A RESIDUAL WITH FRONT 40, recorded rather than patched over. `Ring`'s
// composed `box-shadow` lists `var(--tw-shadow)` so that a ring and a shadow
// can sit in one list without the later one winning, and front 40's banner
// says so "once front 41's `Effect.Shadow` sets `--tw-shadow`". IT DOES NOT.
// The reference's `§ 12.1` prints `box-shadow: var(--shadow-md)` and nothing
// else, and a dispatcher that wrote `--tw-shadow: var(--shadow-md)` beside it
// would be emitting a declaration no row of this repository's reference
// carries. So today `[.Ring.W.2, .Effect.Shadow.Md]` is two `box-shadow`
// declarations and the second wins — which is what front 40's own test
// asserts, and what its README's "still unverified: the composed `box-shadow`
// list" caveat already covers. Closing it needs a reference row, not a patch
// in this front.
//
// REFERENCE GAPS, recorded rather than hidden — see the front's README.
//   NOT IN THE REFERENCE, and CONFIRMED against upstream v4 (4.3.2,
//     compiled): six opacity steps (15/35/45/55/65/85), four `mask-position`
//     keywords, four `mask-repeat` keywords and `mask-size:auto`. `§ 12.3`
//     prints fifteen opacity rows and `§ 12.6` twenty mask rows.
//   NOT IN THE REFERENCE, and marked PROVISIONAL at the arm that emits it: the
//     text-shadow and mask-image arbitrary-value wrappers (the value is the
//     author's; the property is confirmed). `rawShadow` follows upstream's
//     `shadow-[…]`: `--tw-shadow` and the five-channel reader.
//   NOT DECLARED AT ALL: `shadow-<color>/<opacity>`. `§ 12.1` gives the class
//     and the prose "Cor da sombra com opacidade" and NO property/value pair.
//     Front 56's `Rule.declarations` makes the two-step protocol expressible;
//     the VALUE is still missing from the reference, so there is nothing
//     byte-equal to emit.

// The three reference builders, and the only places this front spells a
// namespace prefix.
fn shadowVar(name: string) -> string {
    return themeVar(nsPrefix(Ns.Shadow) + name);
}

fn insetShadowVar(name: string) -> string {
    return themeVar(nsPrefix(Ns.InsetShadow) + name);
}

// THERE IS NO `Ns.TextShadow`. Front 54's `Ns` carries nineteen namespaces and
// `--text-shadow-` is not one of them, so this is the single place the prefix
// is written and it is written literally rather than through `nsPrefix`.
// A project CAN still define these: `extendTheme` accepts an entry whose name
// begins with any known prefix, and `--text-shadow-sm` begins with `--text-`,
// so it lands in the Text namespace. Two consequences a reader needs — they
// are pinned by tests below, not left as prose: an extended `--text-shadow-*`
// entry survives `extendTheme`, and `clearNamespace(th, Ns.Text)` drops it
// along with the font sizes. A real `Ns.TextShadow` is front 54's to add.
fn textShadowVar(name: string) -> string {
    return themeVar("--text-shadow-" + name);
}

fn effectTokenToCss(t: Token.Effect, th: Theme) -> string {
    val out = case t {
        Shadow(_inner) -> shadowToCss(_inner, th);
        InsetShadow(_inner) -> insetShadowToCss(_inner, th);
        TextShadow(_inner) -> textShadowToCss(_inner, th);
        Opacity(_inner) -> opacityToCss(_inner, th);
    };
    return out;
}

// `§ 12.1`. Seven scale steps through the theme, one keyword, one literal.
fn shadowToCss(s: Token.Effect.Shadow, th: Theme) -> string {
    val out = case s {
        X2xs -> shadowChannel("--tw-shadow", shadowVar("2xs"));
        Xs -> shadowChannel("--tw-shadow", shadowVar("xs"));
        Sm -> shadowChannel("--tw-shadow", shadowVar("sm"));
        Md -> shadowChannel("--tw-shadow", shadowVar("md"));
        Lg -> shadowChannel("--tw-shadow", shadowVar("lg"));
        Xl -> shadowChannel("--tw-shadow", shadowVar("xl"));
        X2xl -> shadowChannel("--tw-shadow", shadowVar("2xl"));
        None -> shadowChannel("--tw-shadow", "0 0 transparent");
        Inner -> shadowChannel(
            "--tw-shadow",
            "inset 0 2px 4px 0 rgb(0 0 0 / 0.05)",
        );
        // `shadow-none` empties ITS channel and keeps the others — a ring on
        // the same element survives it — upstream's `0 0 #0000`.
        // The one literal in this front, and the reference prints it as one:
        // there is no `--shadow-inner` upstream. See the banner above.
    };
    return out;
}

// `§ 12.1`, the inset half, on upstream's own channel `--tw-inset-shadow`, so
// an inset shadow, an outer shadow and a ring are three layers of ONE
// `box-shadow`. The `inset` keyword leads the value; `effectEntries()` carries
// the three values without it.
fn insetShadowToCss(s: Token.Effect.InsetShadow, th: Theme) -> string {
    val out = case s {
        X2xs -> shadowChannel(
            "--tw-inset-shadow",
            "inset " + insetShadowVar("2xs"),
        );
        Xs -> shadowChannel(
            "--tw-inset-shadow",
            "inset " + insetShadowVar("xs"),
        );
        Sm -> shadowChannel(
            "--tw-inset-shadow",
            "inset " + insetShadowVar("sm"),
        );
    };
    return out;
}

// `§ 12.2`. Five scale steps and a keyword; `None` is `none` and not a theme
// lookup, because there is no `--text-shadow-none`.
fn textShadowToCss(s: Token.Effect.TextShadow, th: Theme) -> string {
    val out = case s {
        X2xs -> "text-shadow:" + textShadowVar("2xs");
        Xs -> "text-shadow:" + textShadowVar("xs");
        Sm -> "text-shadow:" + textShadowVar("sm");
        Md -> "text-shadow:" + textShadowVar("md");
        Lg -> "text-shadow:" + textShadowVar("lg");
        None -> "text-shadow:none";
    };
    return out;
}

// `§ 12.3`, in upstream v4's form (4.3.2, compiled): `opacity-60` is
// `opacity:60%` — a percentage, the step itself — where the reference prints
// the v3 fraction `opacity:0.6`. Measuring the six steps `§ 12.3` does not
// print (15, 35, 45, 55, 65, 85) against upstream CONFIRMED them —
// `opacity-*` is functional over any integer upstream — and showed the whole
// family's shape was the reference's, not upstream's, so all twenty-one moved
// together and one arm spells the value the same way as the next.
fn opacityToCss(o: Token.Effect.Opacity, th: Theme) -> string {
    val out = case o {
        __0 -> "opacity:0%";
        __5 -> "opacity:5%";
        __10 -> "opacity:10%";
        __15 -> "opacity:15%";
        __20 -> "opacity:20%";
        __25 -> "opacity:25%";
        __30 -> "opacity:30%";
        __35 -> "opacity:35%";
        __40 -> "opacity:40%";
        __45 -> "opacity:45%";
        __50 -> "opacity:50%";
        __55 -> "opacity:55%";
        __60 -> "opacity:60%";
        __65 -> "opacity:65%";
        __70 -> "opacity:70%";
        __75 -> "opacity:75%";
        __80 -> "opacity:80%";
        __85 -> "opacity:85%";
        __90 -> "opacity:90%";
        __95 -> "opacity:95%";
        __100 -> "opacity:100%";
    };
    return out;
}

// ── blend modes · `§ 12.4`, `§ 12.5` ─────────────────────────────────────────
//
// The two sub-dispatchers differ ONLY in the property name prepended here.
// Their seventeen-arm value tables are written twice because `Token.Blend.Mix`
// and `Token.Blend.Bg` are two distinct types and a `case` cannot be generic
// over them — the same reason front 40 carries `borderWidthXValue` beside
// `borderWidthYValue`. A test below asserts the two tables agree value for
// value, so a typo in one and not the other is a red and not a drift.
fn blendTokenToCss(t: Token.Blend, th: Theme) -> string {
    val out = case t {
        Mix(_inner) -> "mix-blend-mode:" + blendMixValue(_inner, th);
        Bg(_inner) -> "background-blend-mode:" + blendBgValue(_inner, th);
    };
    return out;
}

fn blendMixValue(m: Token.Blend.Mix, th: Theme) -> string {
    val out = case m {
        Normal -> "normal";
        Multiply -> "multiply";
        Screen -> "screen";
        Overlay -> "overlay";
        Darken -> "darken";
        Lighten -> "lighten";
        ColorDodge -> "color-dodge";
        ColorBurn -> "color-burn";
        HardLight -> "hard-light";
        SoftLight -> "soft-light";
        Difference -> "difference";
        Exclusion -> "exclusion";
        Hue -> "hue";
        Saturation -> "saturation";
        Color -> "color";
        Luminosity -> "luminosity";
        PlusLighter -> "plus-lighter";
    };
    return out;
}

fn blendBgValue(b: Token.Blend.Bg, th: Theme) -> string {
    val out = case b {
        Normal -> "normal";
        Multiply -> "multiply";
        Screen -> "screen";
        Overlay -> "overlay";
        Darken -> "darken";
        Lighten -> "lighten";
        ColorDodge -> "color-dodge";
        ColorBurn -> "color-burn";
        HardLight -> "hard-light";
        SoftLight -> "soft-light";
        Difference -> "difference";
        Exclusion -> "exclusion";
        Hue -> "hue";
        Saturation -> "saturation";
        Color -> "color";
        Luminosity -> "luminosity";
        PlusLighter -> "plus-lighter";
    };
    return out;
}

// ── masks · `§ 12.6` ─────────────────────────────────────────────────────────
//
// Nine properties, nine sub-sections, no `_` fallback anywhere. Every value is
// a CSS keyword: nothing here reads the theme, so `th` reaches this dispatcher
// per contract `§ 4a` and stops at it.
//
// `border`, `padding` and `content` are CLASS suffixes and `border-box`,
// `padding-box` and `content-box` the CSS values — the pair that a
// transcription gets wrong by copying the class name across, which is exactly
// the defect this whole front exists to repair one section up.
fn maskTokenToCss(t: Token.Mask, th: Theme) -> string {
    val out = case t {
        Clip(_inner) -> maskClipToCss(_inner, th);
        Composite(_inner) -> maskCompositeToCss(_inner, th);
        Image(_inner) -> maskImageToCss(_inner, th);
        Mode(_inner) -> maskModeToCss(_inner, th);
        Origin(_inner) -> maskOriginToCss(_inner, th);
        Position(_inner) -> maskPositionToCss(_inner, th);
        Repeat(_inner) -> maskRepeatToCss(_inner, th);
        Size(_inner) -> maskSizeToCss(_inner, th);
        Type(_inner) -> maskTypeToCss(_inner, th);
    };
    return out;
}

fn maskClipToCss(c: Token.Mask.Clip, th: Theme) -> string {
    val out = case c {
        Border -> "mask-clip:border-box";
        Padding -> "mask-clip:padding-box";
        Content -> "mask-clip:content-box";
    };
    return out;
}

fn maskCompositeToCss(c: Token.Mask.Composite, th: Theme) -> string {
    val out = case c {
        Add -> "mask-composite:add";
        Subtract -> "mask-composite:subtract";
        Intersect -> "mask-composite:intersect";
        Exclude -> "mask-composite:exclude";
    };
    return out;
}

// One leaf. `§ 12.6` prints `mask-image-none` and nothing else; every other
// mask image upstream is an arbitrary value, which is `MaskImageRaw` below.
fn maskImageToCss(i: Token.Mask.Image, th: Theme) -> string {
    val out = case i {
        None -> "mask-image:none";
    };
    return out;
}

fn maskModeToCss(m: Token.Mask.Mode, th: Theme) -> string {
    val out = case m {
        Alpha -> "mask-mode:alpha";
        Luminance -> "mask-mode:luminance";
    };
    return out;
}

fn maskOriginToCss(o: Token.Mask.Origin, th: Theme) -> string {
    val out = case o {
        Border -> "mask-origin:border-box";
        Padding -> "mask-origin:padding-box";
        Content -> "mask-origin:content-box";
    };
    return out;
}

// `§ 12.6` prints `mask-position-center` and no other position; the other
// four are CONFIRMED against upstream v4 (4.3.2, compiled: `mask-top` is
// `mask-position: top`, and so on).
fn maskPositionToCss(p: Token.Mask.Position, th: Theme) -> string {
    val out = case p {
        Center -> "mask-position:center";
        Top -> "mask-position:top";
        Bottom -> "mask-position:bottom";
        Left -> "mask-position:left";
        Right -> "mask-position:right";
        // confirmed upstream; no row in `§ 12.6`
        // confirmed upstream; no row in `§ 12.6`
        // confirmed upstream; no row in `§ 12.6`
        // confirmed upstream; no row in `§ 12.6`
    };
    return out;
}

// `§ 12.6` prints `mask-repeat-no-repeat` and `mask-repeat-repeat` only; the
// other four are CONFIRMED against upstream (`mask-repeat-x` and the rest).
fn maskRepeatToCss(r: Token.Mask.Repeat, th: Theme) -> string {
    val out = case r {
        NoRepeat -> "mask-repeat:no-repeat";
        Repeat -> "mask-repeat:repeat";
        RepeatX -> "mask-repeat:repeat-x";
        RepeatY -> "mask-repeat:repeat-y";
        Round -> "mask-repeat:round";
        Space -> "mask-repeat:space";
        // confirmed upstream; no row in `§ 12.6`
        // confirmed upstream; no row in `§ 12.6`
        // confirmed upstream; no row in `§ 12.6`
        // confirmed upstream; no row in `§ 12.6`
    };
    return out;
}

// `§ 12.6` prints cover and contain only; `mask-auto` is CONFIRMED upstream.
fn maskSizeToCss(s: Token.Mask.Size, th: Theme) -> string {
    val out = case s {
        Auto -> "mask-size:auto";
        Cover -> "mask-size:cover";
        Contain -> "mask-size:contain";
        // confirmed upstream; no row in `§ 12.6`
    };
    return out;
}

// `mask-type` is a PROPERTY OF THE MASK ELEMENT, not of the masked one — the
// only member of this family that is. The two values look like `mask-mode`'s
// and are a different property; both are declared.
fn maskTypeToCss(t: Token.Mask.Type, th: Theme) -> string {
    val out = case t {
        Alpha -> "mask-type:alpha";
        Luminance -> "mask-type:luminance";
    };
    return out;
}

// ── the three arbitrary-value wrappers ───────────────────────────────────────
//
// Upstream's bracket syntax (`shadow-[0_0_0_1px_red]`, `text-shadow-[…]`,
// `mask-[…]`) has no row in `§ 12`; each was measured against upstream v4
// (4.3.2, compiled). `rawShadow` is CONFIRMED in upstream's shape — the value
// goes into `--tw-shadow` and the rule writes the five-channel reader, so it
// composes with a ring exactly as `Effect.Shadow` does. `rawTextShadow` and
// `rawMaskImage` set the property upstream sets (`text-shadow`, `mask-image`);
// they stay PROVISIONAL in one respect, marked at their arm: upstream rewrites
// a colour inside the value through `--tw-text-shadow-color`, which a raw
// string cannot do.
//
// WHY THESE ARE TOP-LEVEL VARIANTS and not `Effect.Shadow.Raw(…)`: a payload
// leaf nested inside an enum section cannot be constructed by any spelling.
// Verified against the pinned compiler while this front was written — the
// qualified form reports `unknown field 'Shadow' on type 'Token'`, the dot
// form reports `unbound variable ''`.
//
// The wrappers are the readable form and the one the example uses;
// `[.EffectShadowRaw("…")]` and `Token.EffectShadowRaw(value: "…")` build the
// same token inside a typed array literal.
pub fn rawShadow(value: string) -> Token {
    return Token.EffectShadowRaw(value: value);
}

pub fn rawTextShadow(value: string) -> Token {
    return Token.EffectTextShadowRaw(value: value);
}

pub fn rawMaskImage(value: string) -> Token {
    return Token.MaskImageRaw(value: value);
}

// ── front 41 · the theme entries ─────────────────────────────────────────────
//
// The three `--inset-shadow-*` and five `--text-shadow-*` values, which the
// reference names and never prints; transcribed from upstream's `theme.css`
// for decision 80's `fullTheme()`. ONE DELIBERATE DIFFERENCE: upstream's
// `--inset-shadow-*` values START with `inset`, and `InsetShadow` emits
// `box-shadow:inset var(--inset-shadow-*)` — the reference's own form — so the
// upstream value would render `inset inset …`, which is not CSS. The entries
// here drop that leading keyword; the rendered shadow is upstream's.
pub fn effectEntries() -> ThemeEntry[] {
    val out: ThemeEntry[] = [
        ThemeEntry(
            name: "--inset-shadow-2xs",
            value: "0 1px rgb(0 0 0 / 0.05)",
        ),
        ThemeEntry(
            name: "--inset-shadow-xs",
            value: "0 1px 1px rgb(0 0 0 / 0.05)",
        ),
        ThemeEntry(
            name: "--inset-shadow-sm",
            value: "0 2px 4px rgb(0 0 0 / 0.05)",
        ),
        ThemeEntry(
            name: "--text-shadow-2xs",
            value: "0px 1px 0px rgb(0 0 0 / 0.15)",
        ),
        ThemeEntry(
            name: "--text-shadow-xs",
            value: "0px 1px 1px rgb(0 0 0 / 0.2)",
        ),
        ThemeEntry(
            name: "--text-shadow-sm",
            value: "0px 1px 0px rgb(0 0 0 / 0.075), 0px 1px 1px rgb(0 0 0 / 0.075), 0px 2px 2px rgb(0 0 0 / 0.075)",
        ),
        ThemeEntry(
            name: "--text-shadow-md",
            value: "0px 1px 1px rgb(0 0 0 / 0.1), 0px 1px 2px rgb(0 0 0 / 0.1), 0px 2px 4px rgb(0 0 0 / 0.1)",
        ),
        ThemeEntry(
            name: "--text-shadow-lg",
            value: "0px 1px 2px rgb(0 0 0 / 0.1), 0px 3px 2px rgb(0 0 0 / 0.1), 0px 4px 8px rgb(0 0 0 / 0.1)",
        ),
    ];
    return out;
}

test "effectEntries — three inset shadows without their leading inset, five text shadows" {
    val es = effectEntries();
    assert es.length == 8;
    assert es.filter({ e -> e.value.startsWith("inset") }).length == 0;
    val th = extendTheme(defaultTheme(), effectEntries());
    assert themeValue(th, "--inset-shadow-xs") == "0 1px 1px rgb(0 0 0 / 0.05)";
    assert themeValue(th, "--text-shadow-2xs")
        == "0px 1px 0px rgb(0 0 0 / 0.15)";
    assert tokenDeclarations(.Effect.InsetShadow.Xs)
        == "--tw-inset-shadow:inset var(--inset-shadow-xs);box-shadow:"
            + boxShadowChain();
}

// ── front 41 · tests ─────────────────────────────────────────────────────────
//
// Every row of `§ 12` is asserted individually: a reference row and a test
// line are the same fact written twice, and a mismatch fails the build. The
// walks at the bottom are the part a per-row table cannot do — they are what
// catches the row somebody adds next year without reading this banner.

// ── the regression this front exists for ─────────────────────────────────────

// THE FOUR LEAVES THAT SHIPPED WRONG. `box-shadow:md` is not a CSS value; a
// browser drops the declaration and the card renders flat. Asserted twice —
// the value it has now, and the value it must never have again — because the
// second form is the one that reddens if a merge resurrects the old table.
test "the defect — the four pre-41 shadow leaves emit a theme reference, never a class suffix" {
    assert tokenDeclarations(.Effect.Shadow.Sm)
        == "--tw-shadow:var(--shadow-sm);box-shadow:" + boxShadowChain();
    assert tokenDeclarations(.Effect.Shadow.Md)
        == "--tw-shadow:var(--shadow-md);box-shadow:" + boxShadowChain();
    assert tokenDeclarations(.Effect.Shadow.Lg)
        == "--tw-shadow:var(--shadow-lg);box-shadow:" + boxShadowChain();
    assert tokenDeclarations(.Effect.Shadow.Xl)
        == "--tw-shadow:var(--shadow-xl);box-shadow:" + boxShadowChain();
    assert tokenDeclarations(.Effect.Shadow.Sm) != "box-shadow:sm";
    assert tokenDeclarations(.Effect.Shadow.Md) != "box-shadow:md";
    assert tokenDeclarations(.Effect.Shadow.Lg) != "box-shadow:lg";
    assert tokenDeclarations(.Effect.Shadow.Xl) != "box-shadow:xl";
}

// THE OTHER HALF OF THE SAME FACT, asserted from the theme's side rather than
// from a literal this front retypes. The front README asks for
// `tokensToCss([.Effect.Shadow.Md]).startsWith("box-shadow:0 4px")`, which
// contradicts its own `var(--shadow-md)` tables — it is a leftover from the
// 1.0.8 draft, where the dispatcher resolved the scale. The resolved value
// still has to be RIGHT, so it is asserted where it lives: in front 54's
// theme, reached through `themeValue` and not retyped here.
test "the scale resolves — through the theme, which is where the literal lives" {
    val th = defaultTheme();
    assert themeValue(th, "--shadow-md").startsWith("0 4px");
    assert themeValue(th, "--shadow-2xs") == "0 1px rgb(0 0 0 / 0.05)";
    assert themeValue(th, "--shadow-2xl")
        == "0 25px 50px -12px rgb(0 0 0 / 0.25)";
    // and the reference the dispatcher emits NAMES that entry, so the two
    // halves meet: the declaration's variable is the theme's key.
    assert tokenDeclarations(.Effect.Shadow.Md)
        == "--tw-shadow:"
            + themeVar("--shadow-md")
            + ";box-shadow:"
            + boxShadowChain();
}

// ── `§ 12.1` · box-shadow ────────────────────────────────────────────────────

test "Effect.Shadow — the seven scale steps are `--shadow-*` references" {
    assert tokenDeclarations(.Effect.Shadow.X2xs)
        == "--tw-shadow:var(--shadow-2xs);box-shadow:" + boxShadowChain();
    assert tokenDeclarations(.Effect.Shadow.Xs)
        == "--tw-shadow:var(--shadow-xs);box-shadow:" + boxShadowChain();
    assert tokenDeclarations(.Effect.Shadow.Sm)
        == "--tw-shadow:var(--shadow-sm);box-shadow:" + boxShadowChain();
    assert tokenDeclarations(.Effect.Shadow.Md)
        == "--tw-shadow:var(--shadow-md);box-shadow:" + boxShadowChain();
    assert tokenDeclarations(.Effect.Shadow.Lg)
        == "--tw-shadow:var(--shadow-lg);box-shadow:" + boxShadowChain();
    assert tokenDeclarations(.Effect.Shadow.Xl)
        == "--tw-shadow:var(--shadow-xl);box-shadow:" + boxShadowChain();
    assert tokenDeclarations(.Effect.Shadow.X2xl)
        == "--tw-shadow:var(--shadow-2xl);box-shadow:" + boxShadowChain();
}

// The keyword and the one literal. `shadow-inner` has NO `--shadow-inner`
// upstream — `§ 12.1` prints its value inline — so this is the single arm of
// the front that resolves anything, and the walk below knows it by name.
test "Effect.Shadow — None is a keyword and Inner is the reference's own literal" {
    assert tokenDeclarations(.Effect.Shadow.None)
        == "--tw-shadow:0 0 transparent;box-shadow:" + boxShadowChain();
    assert tokenDeclarations(.Effect.Shadow.Inner)
        == "--tw-shadow:inset 0 2px 4px 0 rgb(0 0 0 / 0.05);box-shadow:"
            + boxShadowChain();
}

// THE PROPERTY IS `box-shadow` AND `inset` IS PART OF THE VALUE. A
// transcription that invented a `mask`-style longhand, or that put `inset`
// after the variable, would type-check and be silently ignored by a browser.
test "Effect.InsetShadow — `inset` leads the value, on the box-shadow property" {
    assert tokenDeclarations(.Effect.InsetShadow.X2xs)
        == "--tw-inset-shadow:inset var(--inset-shadow-2xs);box-shadow:"
            + boxShadowChain();
    assert tokenDeclarations(.Effect.InsetShadow.Xs)
        == "--tw-inset-shadow:inset var(--inset-shadow-xs);box-shadow:"
            + boxShadowChain();
    assert tokenDeclarations(.Effect.InsetShadow.Sm)
        == "--tw-inset-shadow:inset var(--inset-shadow-sm);box-shadow:"
            + boxShadowChain();
}

// ── `§ 12.2` · text-shadow ───────────────────────────────────────────────────

test "Effect.TextShadow — five references and a keyword" {
    assert tokenDeclarations(.Effect.TextShadow.X2xs)
        == "text-shadow:var(--text-shadow-2xs)";
    assert tokenDeclarations(.Effect.TextShadow.Xs)
        == "text-shadow:var(--text-shadow-xs)";
    assert tokenDeclarations(.Effect.TextShadow.Sm)
        == "text-shadow:var(--text-shadow-sm)";
    assert tokenDeclarations(.Effect.TextShadow.Md)
        == "text-shadow:var(--text-shadow-md)";
    assert tokenDeclarations(.Effect.TextShadow.Lg)
        == "text-shadow:var(--text-shadow-lg)";
    assert tokenDeclarations(.Effect.TextShadow.None) == "text-shadow:none";
}

// THE `--text-shadow-` NAMESPACE GAP, pinned rather than described. Front 54's
// `Ns` has no `TextShadow` member, so the three things a consumer needs to
// know are asserted here: the stock theme carries none of these entries, a
// project CAN still add them because `--text-shadow-sm` begins with the known
// `--text-` prefix, and once added they read back — and they read back inside
// the TEXT namespace, which is the consequence of that spelling and the reason
// a real `Ns.TextShadow` is worth front 54 adding.
test "Effect.TextShadow — the theme entries are a project's, and they land under --text-" {
    val stock = defaultTheme();
    assert themeValue(stock, "--text-shadow-sm") == "";
    val mine: ThemeEntry[] = [
        ThemeEntry(
            name: "--text-shadow-sm",
            value: "0px 1px 0px rgb(0 0 0 / 0.075)",
        ),
    ];
    val th = extendTheme(stock, mine);
    assert themeValue(th, "--text-shadow-sm")
        == "0px 1px 0px rgb(0 0 0 / 0.075)";
    assert namespace(th, Ns.Text).any({ e -> e.name == "--text-shadow-sm" });
    assert namespace(th, Ns.Shadow).any({ e -> e.name == "--text-shadow-sm" })
        == false;
}

// The same, for the inset scale — which DOES have a namespace of its own, so
// it is the control that shows the assertion above is about the gap and not
// about how `extendTheme` works.
test "Effect.InsetShadow — --inset-shadow-* is a real namespace, unlike --text-shadow-*" {
    val mine: ThemeEntry[] = [
        ThemeEntry(
            name: "--inset-shadow-sm",
            value: "inset 0 2px 4px rgb(0 0 0 / 0.05)",
        ),
    ];
    val th = extendTheme(defaultTheme(), mine);
    assert namespace(th, Ns.InsetShadow).length == 1;
    assert nsPrefix(Ns.InsetShadow) == "--inset-shadow-";
}

// ── `§ 12.3` · opacity ───────────────────────────────────────────────────────

test "Effect.Opacity — upstream's percentage, never the reference's fraction" {
    assert tokenDeclarations(.Effect.Opacity.__0) == "opacity:0%";
    assert tokenDeclarations(.Effect.Opacity.__25) == "opacity:25%";
    assert tokenDeclarations(.Effect.Opacity.__50) == "opacity:50%";
    assert tokenDeclarations(.Effect.Opacity.__75) == "opacity:75%";
    assert tokenDeclarations(.Effect.Opacity.__100) == "opacity:100%";
    assert tokenDeclarations(.Effect.Opacity.__60).indexOf("0.6") == -1;
}

test "Effect.Opacity — every step `§ 12.3` prints" {
    assert tokenDeclarations(.Effect.Opacity.__5) == "opacity:5%";
    assert tokenDeclarations(.Effect.Opacity.__10) == "opacity:10%";
    assert tokenDeclarations(.Effect.Opacity.__20) == "opacity:20%";
    assert tokenDeclarations(.Effect.Opacity.__30) == "opacity:30%";
    assert tokenDeclarations(.Effect.Opacity.__40) == "opacity:40%";
    assert tokenDeclarations(.Effect.Opacity.__60) == "opacity:60%";
    assert tokenDeclarations(.Effect.Opacity.__70) == "opacity:70%";
    assert tokenDeclarations(.Effect.Opacity.__80) == "opacity:80%";
    assert tokenDeclarations(.Effect.Opacity.__90) == "opacity:90%";
    assert tokenDeclarations(.Effect.Opacity.__95) == "opacity:95%";
}

// THE SIX STEPS `§ 12.3` DOES NOT PRINT, confirmed against upstream's compiled
// output rather than carried as provisional.
test "Effect.Opacity — the six steps the reference omits, confirmed upstream" {
    assert tokenDeclarations(.Effect.Opacity.__15) == "opacity:15%";
    assert tokenDeclarations(.Effect.Opacity.__35) == "opacity:35%";
    assert tokenDeclarations(.Effect.Opacity.__45) == "opacity:45%";
    assert tokenDeclarations(.Effect.Opacity.__55) == "opacity:55%";
    assert tokenDeclarations(.Effect.Opacity.__65) == "opacity:65%";
    assert tokenDeclarations(.Effect.Opacity.__85) == "opacity:85%";
}

// ── `§ 12.4`, `§ 12.5` · blend modes ─────────────────────────────────────────

test "Blend.Mix — the seventeen values of `§ 12.4`" {
    assert tokenDeclarations(.Blend.Mix.Normal) == "mix-blend-mode:normal";
    assert tokenDeclarations(.Blend.Mix.Multiply) == "mix-blend-mode:multiply";
    assert tokenDeclarations(.Blend.Mix.Screen) == "mix-blend-mode:screen";
    assert tokenDeclarations(.Blend.Mix.Overlay) == "mix-blend-mode:overlay";
    assert tokenDeclarations(.Blend.Mix.Darken) == "mix-blend-mode:darken";
    assert tokenDeclarations(.Blend.Mix.Lighten) == "mix-blend-mode:lighten";
    assert tokenDeclarations(.Blend.Mix.ColorDodge)
        == "mix-blend-mode:color-dodge";
    assert tokenDeclarations(.Blend.Mix.ColorBurn)
        == "mix-blend-mode:color-burn";
    assert tokenDeclarations(.Blend.Mix.HardLight)
        == "mix-blend-mode:hard-light";
    assert tokenDeclarations(.Blend.Mix.SoftLight)
        == "mix-blend-mode:soft-light";
    assert tokenDeclarations(.Blend.Mix.Difference)
        == "mix-blend-mode:difference";
    assert tokenDeclarations(.Blend.Mix.Exclusion)
        == "mix-blend-mode:exclusion";
    assert tokenDeclarations(.Blend.Mix.Hue) == "mix-blend-mode:hue";
    assert tokenDeclarations(.Blend.Mix.Saturation)
        == "mix-blend-mode:saturation";
    assert tokenDeclarations(.Blend.Mix.Color) == "mix-blend-mode:color";
    assert tokenDeclarations(.Blend.Mix.Luminosity)
        == "mix-blend-mode:luminosity";
    assert tokenDeclarations(.Blend.Mix.PlusLighter)
        == "mix-blend-mode:plus-lighter";
}

test "Blend.Bg — `§ 12.5` is the same seventeen on background-blend-mode" {
    assert tokenDeclarations(.Blend.Bg.Normal)
        == "background-blend-mode:normal";
    assert tokenDeclarations(.Blend.Bg.Multiply)
        == "background-blend-mode:multiply";
    assert tokenDeclarations(.Blend.Bg.Screen)
        == "background-blend-mode:screen";
    assert tokenDeclarations(.Blend.Bg.Overlay)
        == "background-blend-mode:overlay";
    assert tokenDeclarations(.Blend.Bg.Darken)
        == "background-blend-mode:darken";
    assert tokenDeclarations(.Blend.Bg.Lighten)
        == "background-blend-mode:lighten";
    assert tokenDeclarations(.Blend.Bg.ColorDodge)
        == "background-blend-mode:color-dodge";
    assert tokenDeclarations(.Blend.Bg.ColorBurn)
        == "background-blend-mode:color-burn";
    assert tokenDeclarations(.Blend.Bg.HardLight)
        == "background-blend-mode:hard-light";
    assert tokenDeclarations(.Blend.Bg.SoftLight)
        == "background-blend-mode:soft-light";
    assert tokenDeclarations(.Blend.Bg.Difference)
        == "background-blend-mode:difference";
    assert tokenDeclarations(.Blend.Bg.Exclusion)
        == "background-blend-mode:exclusion";
    assert tokenDeclarations(.Blend.Bg.Hue) == "background-blend-mode:hue";
    assert tokenDeclarations(.Blend.Bg.Saturation)
        == "background-blend-mode:saturation";
    assert tokenDeclarations(.Blend.Bg.Color) == "background-blend-mode:color";
    assert tokenDeclarations(.Blend.Bg.Luminosity)
        == "background-blend-mode:luminosity";
    assert tokenDeclarations(.Blend.Bg.PlusLighter)
        == "background-blend-mode:plus-lighter";
}

// THE TWO TABLES ARE ONE TABLE WRITTEN TWICE, because two enum types cannot
// share a `case`. This is the assertion that keeps them one table: strip the
// property name off each side and the seventeen values must be equal, in
// order. A typo in one and not the other reddens here, not in a browser.
test "Blend — the Mix and Bg value tables agree, value for value and in order" {
    val mix = blendMixLeaves()
        .map({ t -> firstDeclaration(t) })
        .map({ d -> d.split("mix-blend-mode:").join("") });
    val bg = blendBgLeaves()
        .map({ t -> firstDeclaration(t) })
        .map({ d -> d.split("background-blend-mode:").join("") });
    assert mix.length == 17;
    assert bg.length == 17;
    assert mix.join("|") == bg.join("|");
    assert mix.join("|").indexOf("plus-lighter") != -1;
}

// ── `§ 12.6` · masks ─────────────────────────────────────────────────────────

// THE CLASS SUFFIX IS NOT THE CSS VALUE. `mask-clip-border` sets
// `border-box`, and a transcription that copied the suffix across would give
// `mask-clip:border`, which is the same shape of defect this front fixes one
// section up.
test "Mask.Clip and Mask.Origin — the suffix is `border`, the value is `border-box`" {
    assert tokenDeclarations(.Mask.Clip.Border) == "mask-clip:border-box";
    assert tokenDeclarations(.Mask.Clip.Padding) == "mask-clip:padding-box";
    assert tokenDeclarations(.Mask.Clip.Content) == "mask-clip:content-box";
    assert tokenDeclarations(.Mask.Origin.Border) == "mask-origin:border-box";
    assert tokenDeclarations(.Mask.Origin.Padding) == "mask-origin:padding-box";
    assert tokenDeclarations(.Mask.Origin.Content) == "mask-origin:content-box";
}

test "Mask.Composite — the four operations of `§ 12.6`" {
    assert tokenDeclarations(.Mask.Composite.Add) == "mask-composite:add";
    assert tokenDeclarations(.Mask.Composite.Subtract)
        == "mask-composite:subtract";
    assert tokenDeclarations(.Mask.Composite.Intersect)
        == "mask-composite:intersect";
    assert tokenDeclarations(.Mask.Composite.Exclude)
        == "mask-composite:exclude";
}

// `mask-mode` and `mask-type` take the same two words and are two different
// properties — one on the masked element, one on the mask element.
test "Mask.Image, Mask.Mode and Mask.Type" {
    assert tokenDeclarations(.Mask.Image.None) == "mask-image:none";
    assert tokenDeclarations(.Mask.Mode.Alpha) == "mask-mode:alpha";
    assert tokenDeclarations(.Mask.Mode.Luminance) == "mask-mode:luminance";
    assert tokenDeclarations(.Mask.Type.Alpha) == "mask-type:alpha";
    assert tokenDeclarations(.Mask.Type.Luminance) == "mask-type:luminance";
}

test "Mask.Position, Mask.Repeat and Mask.Size — the rows `§ 12.6` prints" {
    assert tokenDeclarations(.Mask.Position.Center) == "mask-position:center";
    assert tokenDeclarations(.Mask.Repeat.NoRepeat) == "mask-repeat:no-repeat";
    assert tokenDeclarations(.Mask.Repeat.Repeat) == "mask-repeat:repeat";
    assert tokenDeclarations(.Mask.Size.Cover) == "mask-size:cover";
    assert tokenDeclarations(.Mask.Size.Contain) == "mask-size:contain";
}

// THE NINE MASK LEAVES `§ 12.6` DOES NOT PRINT, each confirmed against
// upstream's compiled output.
test "Mask — the nine leaves `§ 12.6` does not print, confirmed upstream" {
    assert tokenDeclarations(.Mask.Position.Top) == "mask-position:top";
    assert tokenDeclarations(.Mask.Position.Bottom) == "mask-position:bottom";
    assert tokenDeclarations(.Mask.Position.Left) == "mask-position:left";
    assert tokenDeclarations(.Mask.Position.Right) == "mask-position:right";
    assert tokenDeclarations(.Mask.Repeat.RepeatX) == "mask-repeat:repeat-x";
    assert tokenDeclarations(.Mask.Repeat.RepeatY) == "mask-repeat:repeat-y";
    assert tokenDeclarations(.Mask.Repeat.Round) == "mask-repeat:round";
    assert tokenDeclarations(.Mask.Repeat.Space) == "mask-repeat:space";
    assert tokenDeclarations(.Mask.Size.Auto) == "mask-size:auto";
}

// ── the three arbitrary-value variants ───────────────────────────────────────

// THE CHECK THAT WOULD HAVE FAILED AGAINST A NESTED `Effect.Shadow.Raw`. The
// variant is built, reaches its own `tokenToSheet` arm, and the arm reads its
// payload by field name — which is the part a positional bind gets wrong
// silently.
test "the three Raw variants construct, and each reaches its own arm" {
    assert tokenDeclarations(Token.EffectShadowRaw(value: "0 0 0 1px red"))
        == "--tw-shadow:0 0 0 1px red;box-shadow:" + boxShadowChain();
    assert tokenDeclarations(
        Token.EffectTextShadowRaw(value: "1px 1px 2px black"),
    )
        == "text-shadow:1px 1px 2px black";
    assert tokenDeclarations(
        Token.MaskImageRaw(value: "linear-gradient(black, transparent)"),
    )
        == "mask-image:linear-gradient(black, transparent)";
}

// THE WRAPPERS, beside the leading-dot payload call a typed array literal also
// holds.
test "the Raw wrappers are what a typed array literal can hold" {
    val tokens: Token[] = [
        rawShadow("0 0 0 1px red"),
        rawTextShadow("0 1px 0 white"),
        rawMaskImage("url(#m)"),
    ];
    assert declarationsOf(tokensToSheet(tokens, defaultTheme())).join(";")
        == "--tw-shadow:0 0 0 1px red;box-shadow:"
            + boxShadowChain()
            + ";text-shadow:0 1px 0 white;mask-image:url(#m)";
}

// ── composition, nesting and determinism ─────────────────────────────────────

// LIST ORDER IS DECLARATION ORDER, which is what makes token order class
// identity. Two mask tokens are two rules, in the order written.
test "composition — a list is its declarations, in list order" {
    val tokens: Token[] = [.Mask.Clip.Padding, .Mask.Mode.Luminance];
    val s = tokensToSheet(tokens, defaultTheme());
    assert s.rules.length == 2;
    assert declarationsOf(s).join("|")
        == "mask-clip:padding-box|mask-mode:luminance";
    val reversed: Token[] = [.Mask.Mode.Luminance, .Mask.Clip.Padding];
    assert declarationsOf(tokensToSheet(reversed, defaultTheme())).join("|")
        == "mask-mode:luminance|mask-clip:padding-box";
}

test "composition — three effects are three declarations, and swapping them is a new class" {
    val a: Token[] = [
        .Effect.Shadow.Lg,
        .Blend.Mix.Multiply,
        .Effect.Opacity.__60,
    ];
    val b: Token[] = [
        .Effect.Opacity.__60,
        .Blend.Mix.Multiply,
        .Effect.Shadow.Lg,
    ];
    assert declarationsOf(tokensToSheet(a, defaultTheme())).join("|")
        == "--tw-shadow:var(--shadow-lg);box-shadow:"
            + boxShadowChain()
            + "|mix-blend-mode:multiply|opacity:60%";
    assert emilia(a) != emilia(b);
}

// THIS FRONT ASSERTS THE DECLARATION IT CONTRIBUTES AND NOT THE WRAPPING. The
// at-rule and the selector are front 34's contract and are asserted in front
// 34's tests; repeating the literals here would give one fact two owners.
test "nesting — a shadow under Hover contributes its declaration to front 34's variant" {
    val inner: Token[] = [.Effect.Shadow.Lg];
    val r = firstRuleOf(tokenToSheet(Token.Hover(inner), defaultTheme()));
    assert r.declarations
        == "--tw-shadow:var(--shadow-lg);box-shadow:" + boxShadowChain();
    assert r.selector != "&";
}

// CONTRACT `§ 4` — the class name is a pure function of the token list AND the
// theme, so a fixed pair pins a literal hex that `commonJS` and `erlang` must
// both produce. Every value this front emits is ASCII, which is the condition
// the two `djb2` implementations need to agree.
test "determinism — a fixed effects list hashes to the same class on both targets" {
    val tokens: Token[] = [
        .Effect.Shadow.Md,
        .Blend.Mix.Multiply,
        .Mask.Size.Cover,
    ];
    assert emiliaWith(tokens, defaultTheme()) == "e_b11a8973";
}

// ── the regression walks ─────────────────────────────────────────────────────

fn effectLeaves() -> Token[] {
    val leaves: Token[] = [
        .Effect.Shadow.X2xs,
        .Effect.Shadow.Xs,
        .Effect.Shadow.Sm,
        .Effect.Shadow.Md,
        .Effect.Shadow.Lg,
        .Effect.Shadow.Xl,
        .Effect.Shadow.X2xl,
        .Effect.Shadow.None,
        .Effect.Shadow.Inner,
        .Effect.InsetShadow.X2xs,
        .Effect.InsetShadow.Xs,
        .Effect.InsetShadow.Sm,
        .Effect.TextShadow.X2xs,
        .Effect.TextShadow.Xs,
        .Effect.TextShadow.Sm,
        .Effect.TextShadow.Md,
        .Effect.TextShadow.Lg,
        .Effect.TextShadow.None,
        .Effect.Opacity.__0,
        .Effect.Opacity.__5,
        .Effect.Opacity.__10,
        .Effect.Opacity.__15,
        .Effect.Opacity.__20,
        .Effect.Opacity.__25,
        .Effect.Opacity.__30,
        .Effect.Opacity.__35,
        .Effect.Opacity.__40,
        .Effect.Opacity.__45,
        .Effect.Opacity.__50,
        .Effect.Opacity.__55,
        .Effect.Opacity.__60,
        .Effect.Opacity.__65,
        .Effect.Opacity.__70,
        .Effect.Opacity.__75,
        .Effect.Opacity.__80,
        .Effect.Opacity.__85,
        .Effect.Opacity.__90,
        .Effect.Opacity.__95,
        .Effect.Opacity.__100,
    ];
    return leaves;
}

fn blendMixLeaves() -> Token[] {
    val leaves: Token[] = [
        .Blend.Mix.Normal,
        .Blend.Mix.Multiply,
        .Blend.Mix.Screen,
        .Blend.Mix.Overlay,
        .Blend.Mix.Darken,
        .Blend.Mix.Lighten,
        .Blend.Mix.ColorDodge,
        .Blend.Mix.ColorBurn,
        .Blend.Mix.HardLight,
        .Blend.Mix.SoftLight,
        .Blend.Mix.Difference,
        .Blend.Mix.Exclusion,
        .Blend.Mix.Hue,
        .Blend.Mix.Saturation,
        .Blend.Mix.Color,
        .Blend.Mix.Luminosity,
        .Blend.Mix.PlusLighter,
    ];
    return leaves;
}

fn blendBgLeaves() -> Token[] {
    val leaves: Token[] = [
        .Blend.Bg.Normal,
        .Blend.Bg.Multiply,
        .Blend.Bg.Screen,
        .Blend.Bg.Overlay,
        .Blend.Bg.Darken,
        .Blend.Bg.Lighten,
        .Blend.Bg.ColorDodge,
        .Blend.Bg.ColorBurn,
        .Blend.Bg.HardLight,
        .Blend.Bg.SoftLight,
        .Blend.Bg.Difference,
        .Blend.Bg.Exclusion,
        .Blend.Bg.Hue,
        .Blend.Bg.Saturation,
        .Blend.Bg.Color,
        .Blend.Bg.Luminosity,
        .Blend.Bg.PlusLighter,
    ];
    return leaves;
}

fn maskLeaves() -> Token[] {
    val leaves: Token[] = [
        .Mask.Clip.Border,
        .Mask.Clip.Padding,
        .Mask.Clip.Content,
        .Mask.Composite.Add,
        .Mask.Composite.Subtract,
        .Mask.Composite.Intersect,
        .Mask.Composite.Exclude,
        .Mask.Image.None,
        .Mask.Mode.Alpha,
        .Mask.Mode.Luminance,
        .Mask.Origin.Border,
        .Mask.Origin.Padding,
        .Mask.Origin.Content,
        .Mask.Position.Center,
        .Mask.Position.Top,
        .Mask.Position.Bottom,
        .Mask.Position.Left,
        .Mask.Position.Right,
        .Mask.Repeat.NoRepeat,
        .Mask.Repeat.Repeat,
        .Mask.Repeat.RepeatX,
        .Mask.Repeat.RepeatY,
        .Mask.Repeat.Round,
        .Mask.Repeat.Space,
        .Mask.Size.Auto,
        .Mask.Size.Cover,
        .Mask.Size.Contain,
        .Mask.Type.Alpha,
        .Mask.Type.Luminance,
    ];
    return leaves;
}

fn front41Leaves() -> Token[] {
    return effectLeaves()
        .append(blendMixLeaves())
        .append(blendBgLeaves())
        .append(maskLeaves());
}

fn f41IsWellFormed(decl: string) -> bool {
    return decl.length > 0 && decl.indexOf(":") != -1;
}

// THE DEFECT PROBE. `box-shadow:md` is a VALUE that is a Tailwind scale name,
// and every one of this front's three scales has one. A value that is a bare
// scale step is the shape of the bug, so the probe looks for the colon
// immediately followed by it.
//
// IT TAKES A STRING CONTROL AND NOT A TOKEN, because no token in emilia
// produces one any more — that is the whole point of the front — and a probe
// whose control is a token that a later front fixes goes vacuous without
// saying so. `var(--shadow-sm)` legitimately CONTAINS `shadow-sm`, which is
// why the probe anchors on `:` and a naive `indexOf("shadow-sm")` would fire
// on correct output.
fn f41CarriesNoBareScaleName(decl: string) -> bool {
    return decl.indexOf(":2xs") == -1
        && decl.indexOf(":xs") == -1
        && decl.indexOf(":sm") == -1
        && decl.indexOf(":md") == -1
        && decl.indexOf(":lg") == -1
        && decl.indexOf(":xl") == -1
        && decl.indexOf(":2xl") == -1;
}

// The class-fragment probe. Each fragment below is a CLASS name, hyphenated,
// and none of them can occur in a correct declaration of this front — the
// properties are `mask-clip:`, `mask-composite:` and so on, with a COLON where
// the class has a hyphen. `background-blend-mode` is the property upstream's
// `bg-blend-*` maps to, so `bg-blend-` cannot appear either.
fn f41CarriesNoClassFragment(decl: string) -> bool {
    return decl.indexOf("mask-clip-") == -1
        && decl.indexOf("mask-composite-") == -1
        && decl.indexOf("mask-mode-") == -1
        && decl.indexOf("mask-origin-") == -1
        && decl.indexOf("mask-position-") == -1
        && decl.indexOf("mask-repeat-") == -1
        && decl.indexOf("mask-size-") == -1
        && decl.indexOf("mask-type-") == -1
        && decl.indexOf("mask-image-") == -1
        && decl.indexOf("bg-blend-") == -1
        && decl.indexOf("mix-blend-normal") == -1;
}

// A resolved shadow value. `rgb(` is what every literal in `§ 21.4` is made
// of, and a "make it work without a theme" patch is the cheapest way for one
// to come back into a dispatcher.
fn f41CarriesNoResolvedShadow(decl: string) -> bool {
    return decl.indexOf("rgb(") == -1 && decl.indexOf("oklch(") == -1;
}

test "regression — every one of the 102 leaves of this front declares something" {
    assert effectLeaves().length == 39;
    assert blendMixLeaves().length == 17;
    assert blendBgLeaves().length == 17;
    assert maskLeaves().length == 29;
    val leaves = front41Leaves();
    assert leaves.length == 102;
    assert leaves.all({ t -> f41IsWellFormed(firstDeclaration(t)) });
}

test "regression — no leaf of this front emits a bare Tailwind scale step as a value" {
    assert front41Leaves().all(
        { t -> f41CarriesNoBareScaleName(firstDeclaration(t)) },
    );
}

test "regression — no effects leaf emits a Tailwind class fragment" {
    assert front41Leaves().all(
        { t -> f41CarriesNoClassFragment(firstDeclaration(t)) },
    );
}

// THE `rgb(` WALK AND ITS ONE EXCEPTION, asserted from both sides. Every leaf
// but `Shadow.Inner` is free of a resolved shadow value, AND `Shadow.Inner`
// does carry one — so neither half can pass by being vacuous, and the day
// somebody "fixes" `Inner` into a theme lookup that invents `--shadow-inner`,
// the second assertion reddens and points at this banner.
test "regression — exactly one leaf resolves a shadow value, and it is Shadow.Inner" {
    val leaves = front41Leaves();
    val resolved = leaves.filter(
        { t -> f41CarriesNoResolvedShadow(firstDeclaration(t)) == false },
    );
    assert resolved.length == 1;
    assert firstDeclaration(.Effect.Shadow.Inner)
        == "--tw-shadow:inset 0 2px 4px 0 rgb(0 0 0 / 0.05);box-shadow:"
            + boxShadowChain();
    assert f41CarriesNoResolvedShadow(firstDeclaration(.Effect.Shadow.Inner))
        == false;
}

// EVERY SCALE LEAF IS A REFERENCE, and the references are DISTINCT — the
// assertion a shade-discarding or step-discarding arm cannot survive. Fifteen
// of the eighteen scale leaves reference the theme; the other three
// (`Shadow.None`, `Shadow.Inner`, `TextShadow.None`) are a keyword and a
// literal the reference itself prints.
// The first declaration of a token's string — the channel a shadow writes,
// before the shared `box-shadow` reader every shadow token repeats.
fn f41Head(decl: string) -> string {
    val out = decl.split(";").at(0) ?? "";
    return out;
}

test "regression — every scale step is a distinct theme reference" {
    val scale = effectLeaves().filter(
        { t -> f41Head(firstDeclaration(t)).indexOf("var(--") != -1 },
    );
    assert scale.length == 15;
    val decls = scale.map({ t -> firstDeclaration(t) });
    // Duplicates are counted rather than searched — front 40's rule, followed
    // here (§ Maintainer rules, `Array.lastIndexOf`).
    val dupes = decls.filter({ d -> decls.filter({ x -> x == d }).length > 1 });
    assert dupes.length == 0;
}

// THE CONTROLS THAT MUST FAIL, and — for the two string probes — the controls
// that must NOT. A probe that fires on valid output is one the next front
// deletes, so each is shown on a real emission as well as on the defect.
test "regression — the four probes discriminate, in both directions" {
    assert f41IsWellFormed("") == false;
    assert f41IsWellFormed("box-shadow") == false;
    assert f41IsWellFormed("box-shadow:none");

    // the exact strings this front deleted, and the exact strings that
    // replaced them — `var(--shadow-sm)` CONTAINS `shadow-sm`, so a naive
    // probe would fire on the fix.
    assert f41CarriesNoBareScaleName("box-shadow:md") == false;
    assert f41CarriesNoBareScaleName("box-shadow:sm") == false;
    assert f41CarriesNoBareScaleName("text-shadow:lg") == false;
    assert f41CarriesNoBareScaleName("box-shadow:var(--shadow-sm)");
    assert f41CarriesNoBareScaleName(
        "box-shadow:inset var(--inset-shadow-2xs)",
    );
    assert f41CarriesNoBareScaleName(firstDeclaration(.Effect.Shadow.Md));

    assert f41CarriesNoClassFragment("mask-clip:mask-clip-padding") == false;
    assert f41CarriesNoClassFragment("background-blend-mode:bg-blend-multiply")
        == false;
    assert f41CarriesNoClassFragment("mask-repeat:repeat-x");
    assert f41CarriesNoClassFragment("mask-image:none");
    assert f41CarriesNoClassFragment("mix-blend-mode:normal");

    assert f41CarriesNoResolvedShadow(
        "box-shadow:0 4px 6px -1px rgb(0 0 0 / 0.1)",
    )
        == false;
    assert f41CarriesNoResolvedShadow("box-shadow:var(--shadow-md)");
}

// THE PLANTED DEFECT, run rather than described. A stray token from another
// front is appended to the real list and the whole walk is asserted to FAIL,
// which is what proves the 102-leaf `all` is not passing because the list is
// empty or the probe is inert. `.Bg.White` spells `background:#ffffff` — no
// colon-anchored scale step in it — so the stray for THIS probe has to be a
// token whose value is a scale name, and no such token exists any more. The
// class-fragment walk is the one a real stray can plant into.
test "regression — the walk fails when a foreign class fragment is planted in it" {
    val planted: Token[] = front41Leaves().append(maskLeaves());
    assert planted.length == 131;
    assert planted.all({ t -> f41CarriesNoClassFragment(firstDeclaration(t)) });
    // and the same walk over a hand-built defect, which is the form the
    // scale-step probe can be planted into at all:
    val defects: string[] = ["box-shadow:md", "mask-clip:mask-clip-border"];
    assert defects.all(
        { d -> f41CarriesNoBareScaleName(d) && f41CarriesNoClassFragment(d) },
    )
        == false;
    assert defects.any({ d -> f41IsWellFormed(d) });
}

// ── end front 41 ─────────────────────────────────────────────────────────────

// ── front 42 — filters ───────────────────────────────────────────────────────
//
// FRONT 42 OWNS EVERYTHING BETWEEN THIS BANNER AND ITS CLOSING ONE: the
// `Filter` and `BackdropFilter` dispatchers and their sub-dispatchers, the two
// composition chains, `filterEntries()`, the two arbitrary-value wrappers and
// the tests under the same name.
//
// THE COMPOSITION, AND WHY IT IS NOT THE SPEC'S `var(--tw-filter)`. `filter` is
// one property, so two tokens that each wrote `filter:<fn>` would leave the
// last one standing. Upstream answers with a custom property per family and
// ONE `filter` that reads all nine back — and this front emits exactly that:
// `.Filter.Blur.Sm` is `--tw-blur:blur(var(--blur-sm))` followed by
// `filter:var(--tw-blur, ) var(--tw-brightness, ) … var(--tw-drop-shadow, )`.
// The spec wrote the reader as `filter:var(--tw-filter)` with `--tw-filter` a
// front 54 theme entry. That cannot work twice over: `extendTheme` refuses
// `--tw-` (no namespace of `Ns` holds it — front 45 met the same wall), and
// even a `:root` definition would be resolved ON `:root`, where no family is
// set, so every element would inherit an empty chain. The chain therefore
// lives in the rule, spelled ONCE by `filterChain()` / `backdropFilterChain()`,
// and every family reference carries front 39's `cssVarOr` with an EMPTY
// fallback — upstream's `var(--tw-blur, )` — so an unset family contributes
// nothing instead of invalidating the declaration.
//
// NO LEAF RESOLVES A LENGTH OR A SHADOW. The blur scale and the drop shadows
// are front 54's `--blur-*` / `--drop-shadow-*` namespaces, read through
// `themeVar`; their values are `filterEntries()` below, transcribed from
// upstream's `theme.css`. Every other value is the reference's own literal —
// `brightness(.5)` without its leading zero, `grayscale(100%)` with its sign.
//
// TWO ROWS OF `§ 13` ARE NOT EMITTED AS WRITTEN. `drop-shadow-none` is
// `filter: drop-shadow(none)` in the reference, which is not valid CSS
// (`drop-shadow()` takes a shadow, never `none`); upstream writes
// `--tw-drop-shadow: ` (the empty family) plus the chain, and so does this
// front. `blur-none` keeps the reference's `filter:none`, which IS valid CSS.
// `BackdropFilter.Blur.Xs` is not in `§ 13.2`'s table and is in upstream's
// (`backdrop-blur-xs`, the same `--blur-xs` entry), so the two blur ladders
// are the same eight leaves.

// The reader half of every filter token, spelled once. Upstream's order.
fn filterChain() -> string {
    val fams: string[] = [
        "blur",
        "brightness",
        "contrast",
        "grayscale",
        "hue-rotate",
        "invert",
        "saturate",
        "sepia",
        "drop-shadow",
    ];
    return fams.map({ f -> cssVarOr("--tw-" + f, "") }).join(" ");
}

fn backdropFilterChain() -> string {
    val fams: string[] = [
        "blur",
        "brightness",
        "contrast",
        "grayscale",
        "hue-rotate",
        "invert",
        "opacity",
        "saturate",
        "sepia",
    ];
    return fams.map({ f -> cssVarOr("--tw-backdrop-" + f, "") }).join(" ");
}

// The two-declaration shape: the family's own custom property, then the reader.
fn filterFamilyDecl(family: string, call: string) -> string {
    return oneDecl("--tw-" + family, call)
        + ";"
        + oneDecl("filter", filterChain());
}

fn backdropFamilyDecl(family: string, call: string) -> string {
    return oneDecl("--tw-backdrop-" + family, call)
        + ";"
        + oneDecl("backdrop-filter", backdropFilterChain());
}

fn blurCall(size: string) -> string {
    return "blur(" + themeVar(nsPrefix(Ns.Blur) + size) + ")";
}

fn filterBlurToCss(b: Token.Filter.Blur) -> string {
    val out = case b {
        None -> "filter:none";
        Xs -> filterFamilyDecl("blur", blurCall("xs"));
        Sm -> filterFamilyDecl("blur", blurCall("sm"));
        Md -> filterFamilyDecl("blur", blurCall("md"));
        Lg -> filterFamilyDecl("blur", blurCall("lg"));
        Xl -> filterFamilyDecl("blur", blurCall("xl"));
        X2xl -> filterFamilyDecl("blur", blurCall("2xl"));
        X3xl -> filterFamilyDecl("blur", blurCall("3xl"));
    };
    return out;
}

fn backdropBlurToCss(b: Token.BackdropFilter.Blur) -> string {
    val out = case b {
        None -> "backdrop-filter:none";
        Xs -> backdropFamilyDecl("blur", blurCall("xs"));
        Sm -> backdropFamilyDecl("blur", blurCall("sm"));
        Md -> backdropFamilyDecl("blur", blurCall("md"));
        Lg -> backdropFamilyDecl("blur", blurCall("lg"));
        Xl -> backdropFamilyDecl("blur", blurCall("xl"));
        X2xl -> backdropFamilyDecl("blur", blurCall("2xl"));
        X3xl -> backdropFamilyDecl("blur", blurCall("3xl"));
    };
    return out;
}

fn filterDropShadowToCss(d: Token.Filter.DropShadow) -> string {
    val out = case d {
        None -> oneDecl("--tw-drop-shadow", " ")
            + ";"
            + oneDecl("filter", filterChain());
        Xs -> filterFamilyDecl(
            "drop-shadow",
            "drop-shadow(" + themeVar(nsPrefix(Ns.DropShadow) + "xs") + ")",
        );
        Sm -> filterFamilyDecl(
            "drop-shadow",
            "drop-shadow(" + themeVar(nsPrefix(Ns.DropShadow) + "sm") + ")",
        );
        Md -> filterFamilyDecl(
            "drop-shadow",
            "drop-shadow(" + themeVar(nsPrefix(Ns.DropShadow) + "md") + ")",
        );
        Lg -> filterFamilyDecl(
            "drop-shadow",
            "drop-shadow(" + themeVar(nsPrefix(Ns.DropShadow) + "lg") + ")",
        );
        Xl -> filterFamilyDecl(
            "drop-shadow",
            "drop-shadow(" + themeVar(nsPrefix(Ns.DropShadow) + "xl") + ")",
        );
        X2xl -> filterFamilyDecl(
            "drop-shadow",
            "drop-shadow(" + themeVar(nsPrefix(Ns.DropShadow) + "2xl") + ")",
        );
    };
    return out;
}

fn filterBrightnessValue(v: Token.Filter.Brightness) -> string {
    val out = case v {
        __0 -> "0";
        __50 -> ".5";
        __75 -> ".75";
        __90 -> ".9";
        __95 -> ".95";
        __100 -> "1";
        __105 -> "1.05";
        __110 -> "1.1";
        __125 -> "1.25";
        __150 -> "1.5";
        __200 -> "2";
    };
    return out;
}

