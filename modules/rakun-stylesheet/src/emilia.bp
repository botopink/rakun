import {hash, compiler.Span, compiler, failure.panic} from "std";

//// ═══ FRONT 56 · the host cells and the public entry points ═══════════════
////
//// Everything between this banner and the section sub-dispatchers below is
//// front 56's (`specs/1.0.10-beta/05-emilia/56-emilia-cascade-and-output/`).
//// The per-section sub-dispatchers under it are fronts 33-47's, 57's and
//// 58's, and this front does not touch them.

// ── host cells ────────────────────────────────────────────────────
//
// The `Stylesheet` host cell is a JS `Map` lazily created on `globalThis`
// (commonJS), or an ordered `[{Name, Body}]` list in the process dictionary
// under `'__emilia_sheet'` (erlang: `lists:keystore` keeps the Map's
// insertion order, `erase` clears it).
//
// THE CELL IS A DUMB STRING STORE AND NOTHING ELSE. It used to assemble the
// `<style>` document itself, twice — once in the commonJS template and once in
// the Erlang one — which is where the byte-level divergence risk lived and
// which nothing written in botopink could test. `drainRules()` hands the raw
// payloads back instead and `output.bp` renders them, in one place, on both
// targets. Every ordering decision, every brace and the `<style>` element
// itself now live in `renderDocument`.
//
// `register(name, body)` writes (name -> body). `drainRules()` returns the
// entries as `name + "\t" + payload` records joined by `"\n"`, in insertion
// order, and clears the cell — the per-render contract the old `flushSheet`
// had: two consecutive drains give two independent documents, and the second
// registers nothing.
//
// A payload is an `encodeSheet` string, whose own records are ALSO joined by
// `"\n"`, so the drain stream layers two separators on one character. It stays
// unambiguous because a payload record is tagged `R` or `B` and a registered
// name never is; `output.bp`'s `drainStep` is where that is written down.
//
// `drainRules` returns `Task<string>` — wrapped in `Promise.resolve(...)`
// so the public `flush()` surface is awaitable from any callsite (an SSR
// pipeline may chain it with `await renderToString(page)` symmetric to
// `await fetch(url)` from `std/http`). It cannot fail, so the Task carries no
// `Result` and a caller writes a bare `await`. Tests support `await` via the
// implicit await channel of a `test` block (`inferTestDecl`) + `async function`
// emission in `commonJS.emitTestFn`. The erlang backend's eager `Task<T>` = `T`
// rule makes `await` an identity there.
//
// Both commonJS and erlang carry the cells; beam/wasm are not ported.
#[compiler.external(
    .JavaScript("""(function(__N, __B){ (globalThis.__emilia_sheet ||= new Map()).set(__N, __B); })($0, $1)"""),
    .Erlang("""(fun(N__, B__) -> L__ = case get('__emilia_sheet') of undefined -> []; X__ -> X__ end, put('__emilia_sheet', lists:keystore(N__, 1, L__, {N__, B__})), ok end)($0, $1)"""),
)]
declare fn register(name: string, body: string) -> void;

#[compiler.external(
    .JavaScript("""Promise.resolve((function(){ var __M = (globalThis.__emilia_sheet ||= new Map()); var __S = Array.from(__M.entries()).map(function(__E){ return __E[0] + "\t" + __E[1]; }).join("\n"); __M.clear(); return __S; })())"""),
    .Erlang("""(fun() -> L__ = case erase('__emilia_sheet') of undefined -> []; X__ -> X__ end, iolist_to_binary(lists:join(<<"\n">>, [[K__, <<"\t">>, V__] || {K__, V__} <- L__])) end)()"""),
)]
declare fn drainRules() -> Task<string>;

// The payload registered under `name`, or "" when none is — read WITHOUT
// draining. Front 59's `named()` needs it to refuse a second, different
// registration under one author-written class name (the cell is keyed by name,
// so the loser would vanish silently). It lives here because a host cell
// cannot be imported across modules (§ Maintainer rules).
#[compiler.external(
    .JavaScript("""(function(__N){ var __M = (globalThis.__emilia_sheet ||= new Map()); return __M.has(__N) ? __M.get(__N) : ""; })($0)"""),
    .Erlang("""(fun(N__) -> L__ = case get('__emilia_sheet') of undefined -> []; X__ -> X__ end, case lists:keyfind(N__, 1, L__) of {_, B__} -> B__; false -> <<>> end end)($0)"""),
)]
declare fn lookupRule(name: string) -> string;

// Content-derived class id (decision 367, `contracts.md` § 4): `"e_"` and
// std's `hash.contentHash` (decision 116 — the djb2 fold, seed 5381, masked to
// 32 bits, over code points, lowercase hex, no padding) of the class's RULES as
// the document writes them, the class written `\u{1}` (`output.bp`
// `classRules`) — the text `styled` hashes for a component, so one class rule
// names every component and the `e_` prefix is emilia's layer's. Identical
// rules → identical class; a class body is ASCII (`assertAsciiBody`), so the
// two targets agree. The hash is a pure function of the token list AND THE
// THEME (a `md:` variant carries the theme's `--breakpoint-md`), token order is
// class identity (a selector variant keeps its place among the plain rules),
// and the `prefix` / `important` options never enter it. It was the codec
// payload (`encodeSheet`) until 34 step 5: the payload is still what the cell
// stores and `flush()` renders, it is no longer what is hashed.

// ── public API ───────────────────────────────────────────────────

// Walk a `Token[]` under a theme → name the class by its rules' hash → register
// the encoded `Sheet` under that name → return the class name.
pub fn emiliaWith(tokens: Token[], th: Theme) -> string {
    val rule = styleRule(tokens, th);
    register(rule._0, rule._1);
    return rule._0;
}

// The PURE half of `emiliaWith`: the class name and the encoded sheet it names
// (the cell's payload; the name hashes the sheet's `classRules`),
// with no host cell touched. A build step that reads `styleRule` fills its
// style map from it (decision 116 rule 7); `emiliaWith` is this, then `register`.
pub fn styleRule(tokens: Token[], th: Theme) -> #(string, string) {
    val sheet = tokensToSheet(tokens, th);
    return #("e_" + hash.contentHash(classRules(sheet)), encodeSheet(sheet));
}

// DECISION 80: the theme every contributing front's entries compose into, in
// front-number order — front 54's `defaultTheme()` extended by one line per
// front, each under its own banner's function. A front that contributes theme
// entries adds ONE line here. `defaultTheme()` itself stays front 54's and
// palette-free.
//
// `defaultOptions()` CANNOT CARRY IT, although the decision says so: it lives
// in `output.bp`, and `output.bp` cannot import this module (this module
// imports it — the cycle would not resolve). So the carrier is
// `fullOptions()` below, and `flush()` renders with it; `defaultOptions()`
// stays the theme-only baseline a test composes from.
pub fn fullTheme() -> Theme {
    val th = extendTheme(defaultTheme(), paletteEntries()); // front 33
    val t38 = extendTheme(th, typographyEntries()); // front 38
    val t41 = extendTheme(t38, effectEntries()); // front 41
    val t42 = extendTheme(t41, filterEntries()); // front 42
    val t44 = extendTheme(t42, transitionEntries()); // front 44
    val t45 = extendTheme(t44, transformEntries()); // front 45
    return t45;
}

// `defaultOptions()` under `fullTheme()` — what `flush()` renders with.
pub fn fullOptions() -> Options {
    return withTheme(defaultOptions(), fullTheme());
}

// ── front 59 · the named-class escape (`§ 3.7`'s `@layer components`) ─────
//
// The one registration that does NOT hash (see `compose.bp`'s header): the
// rules move to `components`, the name is checked, and a second DIFFERENT
// registration under one name is refused. It lives here, beside `register`,
// because `compose.bp` cannot import this module.

fn checkNamedClass(className: string) -> string {
    if (refusesIdent(className))
        panic(
            "emilia compose: a named class may contain only letters, digits, - and _: '"
                + className
                + "'",
        );
    if (className.startsWith("e_"))
        panic(
            "emilia compose: '"
                + className
                + "' is in emilia's generated e_ space — a named class may not start with e_",
        );
    return className;
}

fn toComponents(s: Sheet) -> Sheet {
    val rules = s.rules.map(
        { r -> Rule(layer: "components", atRules: r.atRules, selector: r.selector, declarations: r.declarations, important: r.important) },
    );
    return Sheet(rules: rules, blocks: s.blocks);
}

pub fn named(className: string, tokens: Token[]) -> string {
    val name = checkNamedClass(className);
    val payload = encodeSheet(
        toComponents(decodeSheet(styleRule(tokens, defaultTheme())._1)),
    );
    val existing = lookupRule(name);
    if (existing != "" && existing != payload)
        panic(
            "emilia compose: '"
                + name
                + "' is already registered with different tokens — a named class is registered once",
        );
    register(name, payload);
    return name;
}

// ── front 48 · the class slot ────────────────────────────────────────────────
//
// `attributes.bp` carries the contract (its header) and the two pure pieces;
// these hash a sheet, so they live beside the hash. Every one but the merge
// takes `th: Theme` — the theme is part of the class identity, and both halves
// of an app must pass the SAME value.

// Clause 3: a rule body that is not ASCII is refused at the call — naming the
// offending text — never hashed into a class the two targets disagree on.
pub fn assertAsciiBody(tokens: Token[], th: Theme) -> bool {
    val bad = nonAsciiIn(encodeSheet(tokensToSheet(tokens, th)));
    if (bad != "")
        panic(
            "emilia attributes: a class body must be ASCII (the JS and erlang hashes diverge above U+FFFF); this token list carries '"
                + bad
                + "'",
        );
    return true;
}

// The class name alone — the value an element's `class` attribute carries and
// a hydrator compares.
pub fn className(tokens: Token[], th: Theme) -> string {
    val ok = assertAsciiBody(tokens, th);
    return emiliaWith(tokens, th);
}

// `#("class", <the emilia class>)` — drops into any builder's `attrs:`.
pub fn styled(tokens: Token[], th: Theme) -> #(string, string) {
    return #("class", className(tokens, th));
}

// The static class first, then the emilia class — through `mergeClass`, the
// one implementation.
pub fn styledWith(
    base: string,
    tokens: Token[],
    th: Theme,
) -> #(string, string) {
    return #("class", mergeClass(base, className(tokens, th)));
}

// The class-name value's two short names: `className` and `mergeClass` under
// names short enough to bind inline.
pub fn cls(tokens: Token[], th: Theme) -> string {
    return className(tokens, th);
}

pub fn clsWith(base: string, tokens: Token[], th: Theme) -> string {
    return mergeClass(base, className(tokens, th));
}

// The single public emilia call, on the stock theme. The signature is the one
// it had before front 56, so no consumer changes.
pub fn emilia(tokens: Token[]) -> string {
    return emiliaWith(tokens, defaultTheme());
}

// Drain the cell and render the document under `o`. Per-render contract — two
// consecutive calls emit two independent documents; the second carries the
// theme and base layers `o` asks for and no `@layer utilities` body, because
// nothing registered in between.
//
// Async (`Task<string>` — the return is the effect) so the SSR caller can
// chain it with the other async pieces of a render pipeline
// (`await renderToString(page) + await flush()`). Tests resolve the Task
// inline via the implicit await channel of a `test {…}` block.
pub fn flushWith(o: Options) -> Task<string> {
    val raw = await drainRules();
    return renderDocument(raw, o);
}

// The stock render: `fullTheme()` (decision 80 — every front's entries, so
// no `var(--…)` a token emits is left undefined), no reset, no prefix,
// cascade layers on. The signature is the one it had before front 56.
pub fn flush() -> Task<string> {
    return await flushWith(fullOptions());
}

// ── the shared dispatcher ───────────────────────────────────────────

// Exhaustive dispatch over the V1 nested-section `Token` enum, and the ONE
// line each of fronts 33-47 owns. A section arm adapts its sub-dispatcher's
// declaration string with `declSheet(…)`; a modifier arm wraps the inner
// sheet in a `Variant`. A front whose tokens genuinely need a selector
// (`space-x-*`, `divide-*`) swaps its arm for `…TokenToSheet(_inner, th)` and
// says so in its own README: two shapes, one line each.
//
// THE THEME REACHES THIS DISPATCHER, NOT THE SUB-DISPATCHERS. The ten section
// sub-dispatchers keep their front 54 signature; the front that needs the
// theme adds the parameter to its own function and to its own line here. The
// spec of this front asks 56 to change all ten signatures at once, which would
// have front 56 editing ten functions three other fronts are rewriting in
// parallel for no gain — the arm is one line either way.
fn tokenToSheet(t: Token, th: Theme) -> Sheet {
    val out = case t {
        Color(_inner) -> declSheet(colorTokenToCss(_inner, th));
        Bg(_inner) -> declSheet(bgTokenToCss(_inner, th));
        Alpha(percent, inner) -> alphaSheet(tokensToSheet(inner, th), percent);
        Pad(_inner) -> declSheet(padTokenToCss(_inner, th));
        Margin(_inner) -> declSheet(marginTokenToCss(_inner, th));
        Size(_inner) -> declSheet(sizeTokenToCss(_inner, th));
        Space(_inner) -> spaceTokenToSheet(_inner, th);
        Layout(_inner) -> declSheet(layoutTokenToCss(_inner, th));
        Flex(_inner) -> declSheet(flexTokenToCss(_inner, th));
        Grid(_inner) -> declSheet(gridTokenToCss(_inner, th));
        Gap(_inner) -> declSheet(gapTokenToCss(_inner, th));
        Text(_inner) -> declSheet(textTokenToCss(_inner, th));
        Font(_inner) -> declSheet(fontTokenToCss(_inner, th));
        List(_inner) -> declSheet(listTokenToCss(_inner, th));
        Gradient(_inner) -> declSheet(gradientTokenToCss(_inner, th));
        Border(_inner) -> declSheet(borderTokenToCss(_inner, th));
        Outline(_inner) -> declSheet(outlineTokenToCss(_inner, th));
        Ring(_inner) -> ringTokenToSheet(_inner, th);
        Divide(_inner) -> divideTokenToSheet(_inner, th);
        Effect(_inner) -> declSheet(effectTokenToCss(_inner, th));
        Blend(_inner) -> declSheet(blendTokenToCss(_inner, th));
        Mask(_inner) -> declSheet(maskTokenToCss(_inner, th));
        EffectShadowRaw(value) -> declSheet(
            "--tw-shadow:" + value + ";box-shadow:" + boxShadowChain(),
        );
        EffectTextShadowRaw(value) -> declSheet("text-shadow:" + value);
        MaskImageRaw(value) -> declSheet("mask-image:" + value);
        Filter(_inner) -> declSheet(filterTokenToCss(_inner, th));
        BackdropFilter(_inner) -> declSheet(
            backdropFilterTokenToCss(_inner, th),
        );
        FilterRaw(value) -> declSheet("filter:" + value);
        BackdropRaw(value) -> declSheet("backdrop-filter:" + value);
        Table(_inner) -> declSheet(tableTokenToCss(_inner, th));
        TableSpacingRaw(value) -> declSheet("border-spacing:" + value);
        Transition(_inner) -> declSheet(transitionTokenToCss(_inner, th));
        Animate(_inner) -> animateTokenToSheet(_inner, th);
        TransitionProperty(value) -> declSheet(transitionPreset(value));
        AnimateRaw(value) -> declSheet("animation:" + value);
        Transform(_inner) -> transformSheet(_inner, th);
        TransformRotateRaw(value) -> declSheet("rotate:" + value);
        TransformTranslateRaw(value) -> declSheet("translate:" + value);
        Interact(_inner) -> declSheet(interactTokenToCss(_inner, th));
        InteractAccent(value) -> declSheet("accent-color:" + value);
        InteractCaret(value) -> declSheet("caret-color:" + value);
        InteractScrollbarColor(thumb, track) -> declSheet(
            "scrollbar-color:" + thumb + " " + track,
        );
        Svg(_inner) -> declSheet(svgTokenToCss(_inner, th));
        A11y(_inner) -> declSheet(a11yTokenToCss(_inner, th));
        SvgFill(value) -> declSheet("fill:" + value);
        SvgStroke(value) -> declSheet("stroke:" + value);
        SvgStrokeWidthRaw(value) -> declSheet("stroke-width:" + value);
        Arb(prop, value) -> arbValueToSheet(prop, value);
        ArbProp(name, value) -> arbPropToSheet(name, value);
        ArbVariant(selector, inner) -> arbVariantToSheet(
            selector,
            tokensToSheet(inner, th),
        );
        ArbAt(query, inner) -> arbAtToSheet(query, tokensToSheet(inner, th));
        ArbMin(px, inner) -> arbMinToSheet(px, tokensToSheet(inner, th));
        ArbMax(px, inner) -> arbMaxToSheet(px, tokensToSheet(inner, th));
        Container(_inner) -> declSheet(containerMarkerToCss(_inner));
        ContainerNamed(name) -> containerNamedToSheet(name);
        ContainerAt(size, inner) -> containerAtToSheet(
            size,
            "",
            tokensToSheet(inner, th),
            th,
        );
        ContainerAtNamed(size, name, inner) -> containerAtToSheet(
            size,
            name,
            tokensToSheet(inner, th),
            th,
        );
        Sm(inner) -> nestVariant(tokensToSheet(inner, th), smVariant(th));
        Md(inner) -> nestVariant(tokensToSheet(inner, th), mdVariant(th));
        Lg(inner) -> nestVariant(tokensToSheet(inner, th), lgVariant(th));
        Xl(inner) -> nestVariant(tokensToSheet(inner, th), xlVariant(th));
        X2xl(inner) -> nestVariant(tokensToSheet(inner, th), x2xlVariant(th));
        MaxSm(inner) -> nestVariant(tokensToSheet(inner, th), maxSmVariant(th));
        MaxMd(inner) -> nestVariant(tokensToSheet(inner, th), maxMdVariant(th));
        MaxLg(inner) -> nestVariant(tokensToSheet(inner, th), maxLgVariant(th));
        MaxXl(inner) -> nestVariant(tokensToSheet(inner, th), maxXlVariant(th));
        MaxX2xl(inner) -> nestVariant(
            tokensToSheet(inner, th),
            maxX2xlVariant(th),
        );
        Dark(inner) -> nestVariant(tokensToSheet(inner, th), darkVariant(th));
        Print(inner) -> nestVariant(tokensToSheet(inner, th), printVariant());
        Portrait(inner) -> nestVariant(
            tokensToSheet(inner, th),
            portraitVariant(),
        );
        Landscape(inner) -> nestVariant(
            tokensToSheet(inner, th),
            landscapeVariant(),
        );
        MotionSafe(inner) -> nestVariant(
            tokensToSheet(inner, th),
            motionSafeVariant(),
        );
        MotionReduce(inner) -> nestVariant(
            tokensToSheet(inner, th),
            motionReduceVariant(),
        );
        ContrastMore(inner) -> nestVariant(
            tokensToSheet(inner, th),
            contrastMoreVariant(),
        );
        ContrastLess(inner) -> nestVariant(
            tokensToSheet(inner, th),
            contrastLessVariant(),
        );
        ForcedColors(inner) -> nestVariant(
            tokensToSheet(inner, th),
            forcedColorsVariant(),
        );
        Hover(inner) -> nestVariant(tokensToSheet(inner, th), hoverVariant());
        Focus(inner) -> nestVariant(tokensToSheet(inner, th), focusVariant());
        FocusWithin(inner) -> nestVariant(
            tokensToSheet(inner, th),
            focusWithinVariant(),
        );
        FocusVisible(inner) -> nestVariant(
            tokensToSheet(inner, th),
            focusVisibleVariant(),
        );
        Active(inner) -> nestVariant(tokensToSheet(inner, th), activeVariant());
        Visited(inner) -> nestVariant(
            tokensToSheet(inner, th),
            visitedVariant(),
        );
        Target(inner) -> nestVariant(tokensToSheet(inner, th), targetVariant());
        Open(inner) -> nestVariant(tokensToSheet(inner, th), openVariant());
        Inert(inner) -> nestVariant(tokensToSheet(inner, th), inertVariant());
        Disabled(inner) -> nestVariant(
            tokensToSheet(inner, th),
            disabledVariant(),
        );
        Enabled(inner) -> nestVariant(
            tokensToSheet(inner, th),
            enabledVariant(),
        );
        Checked(inner) -> nestVariant(
            tokensToSheet(inner, th),
            checkedVariant(),
        );
        Indeterminate(inner) -> nestVariant(
            tokensToSheet(inner, th),
            indeterminateVariant(),
        );
        Default(inner) -> nestVariant(
            tokensToSheet(inner, th),
            defaultVariant(),
        );
        Optional(inner) -> nestVariant(
            tokensToSheet(inner, th),
            optionalVariant(),
        );
        Required(inner) -> nestVariant(
            tokensToSheet(inner, th),
            requiredVariant(),
        );
        Valid(inner) -> nestVariant(tokensToSheet(inner, th), validVariant());
        Invalid(inner) -> nestVariant(
            tokensToSheet(inner, th),
            invalidVariant(),
        );
        UserValid(inner) -> nestVariant(
            tokensToSheet(inner, th),
            userValidVariant(),
        );
        UserInvalid(inner) -> nestVariant(
            tokensToSheet(inner, th),
            userInvalidVariant(),
        );
        InRange(inner) -> nestVariant(
            tokensToSheet(inner, th),
            inRangeVariant(),
        );
        OutOfRange(inner) -> nestVariant(
            tokensToSheet(inner, th),
            outOfRangeVariant(),
        );
        PlaceholderShown(inner) -> nestVariant(
            tokensToSheet(inner, th),
            placeholderShownVariant(),
        );
        Autofill(inner) -> nestVariant(
            tokensToSheet(inner, th),
            autofillVariant(),
        );
        ReadOnly(inner) -> nestVariant(
            tokensToSheet(inner, th),
            readOnlyVariant(),
        );
        First(inner) -> nestVariant(tokensToSheet(inner, th), firstVariant());
        Last(inner) -> nestVariant(tokensToSheet(inner, th), lastVariant());
        Only(inner) -> nestVariant(tokensToSheet(inner, th), onlyVariant());
        Odd(inner) -> nestVariant(tokensToSheet(inner, th), oddVariant());
        Even(inner) -> nestVariant(tokensToSheet(inner, th), evenVariant());
        FirstOfType(inner) -> nestVariant(
            tokensToSheet(inner, th),
            firstOfTypeVariant(),
        );
        LastOfType(inner) -> nestVariant(
            tokensToSheet(inner, th),
            lastOfTypeVariant(),
        );
        OnlyOfType(inner) -> nestVariant(
            tokensToSheet(inner, th),
            onlyOfTypeVariant(),
        );
        Empty(inner) -> nestVariant(tokensToSheet(inner, th), emptyVariant());
        Nth(index, inner) -> nestVariant(
            tokensToSheet(inner, th),
            nthVariant(index),
        );
        NthLast(index, inner) -> nestVariant(
            tokensToSheet(inner, th),
            nthLastVariant(index),
        );
        Before(inner) -> nestVariant(tokensToSheet(inner, th), beforeVariant());
        After(inner) -> nestVariant(tokensToSheet(inner, th), afterVariant());
        FirstLetter(inner) -> nestVariant(
            tokensToSheet(inner, th),
            firstLetterVariant(),
        );
        FirstLine(inner) -> nestVariant(
            tokensToSheet(inner, th),
            firstLineVariant(),
        );
        Placeholder(inner) -> nestVariant(
            tokensToSheet(inner, th),
            placeholderVariant(),
        );
        File(inner) -> nestVariant(tokensToSheet(inner, th), fileVariant());
        Marker(inner) -> nestVariants(
            tokensToSheet(inner, th),
            markerVariants(),
        );
        Selection(inner) -> nestVariants(
            tokensToSheet(inner, th),
            selectionVariants(),
        );
        Backdrop(inner) -> nestVariant(
            tokensToSheet(inner, th),
            backdropVariant(),
        );
        GroupHover(inner) -> nestVariant(
            tokensToSheet(inner, th),
            groupHoverVariant(),
        );
        GroupFocus(inner) -> nestVariant(
            tokensToSheet(inner, th),
            groupFocusVariant(),
        );
        GroupActive(inner) -> nestVariant(
            tokensToSheet(inner, th),
            groupActiveVariant(),
        );
        GroupVisited(inner) -> nestVariant(
            tokensToSheet(inner, th),
            groupVisitedVariant(),
        );
        GroupDisabled(inner) -> nestVariant(
            tokensToSheet(inner, th),
            groupDisabledVariant(),
        );
        GroupOpen(inner) -> nestVariant(
            tokensToSheet(inner, th),
            groupOpenVariant(),
        );
        PeerHover(inner) -> nestVariant(
            tokensToSheet(inner, th),
            peerHoverVariant(),
        );
        PeerFocus(inner) -> nestVariant(
            tokensToSheet(inner, th),
            peerFocusVariant(),
        );
        PeerActive(inner) -> nestVariant(
            tokensToSheet(inner, th),
            peerActiveVariant(),
        );
        PeerChecked(inner) -> nestVariant(
            tokensToSheet(inner, th),
            peerCheckedVariant(),
        );
        PeerInvalid(inner) -> nestVariant(
            tokensToSheet(inner, th),
            peerInvalidVariant(),
        );
        PeerRequired(inner) -> nestVariant(
            tokensToSheet(inner, th),
            peerRequiredVariant(),
        );
        PeerDisabled(inner) -> nestVariant(
            tokensToSheet(inner, th),
            peerDisabledVariant(),
        );
        PeerPlaceholderShown(inner) -> nestVariant(
            tokensToSheet(inner, th),
            peerPlaceholderShownVariant(),
        );
        GroupNamed(name, inner) -> namedParentSheet(
            groupClassOf(name),
            inner,
            th,
        );
        PeerNamed(name, inner) -> namedParentSheet(
            peerClassOf(name),
            inner,
            th,
        );
        Rtl(inner) -> nestVariant(tokensToSheet(inner, th), rtlVariant());
        Ltr(inner) -> nestVariant(tokensToSheet(inner, th), ltrVariant());
        Children(inner) -> nestVariant(
            tokensToSheet(inner, th),
            childrenVariant(),
        );
        Descendants(inner) -> nestVariant(
            tokensToSheet(inner, th),
            descendantsVariant(),
        );
        Important(inner) -> markImportant(tokensToSheet(inner, th));
        // ── front 33 — colour palette ──────────────────────────
        // ── end front 33 ───────────────────────────────────────
        // ── front 35 — spacing and sizing ──────────────────────
        // ── end front 35 ───────────────────────────────────────
        // ── front 36 — layout ──────────────────────────────────
        // ── end front 36 ───────────────────────────────────────
        // ── front 37 — flexbox, grid and gap ───────────────────
        // ── end front 37 ───────────────────────────────────────
        // ── front 38 — typography ──────────────────────────────
        // ── end front 38 ───────────────────────────────────────
        // ── front 39 — backgrounds ─────────────────────────────
        // ── end front 39 ───────────────────────────────────────
        // ── front 40 — borders, outlines, rings and divides ────
        // ── end front 40 ───────────────────────────────────────
        // ── front 41 — effects ─────────────────────────────────
        // The three arbitrary-value variants are SIBLINGS of `Effect`, not
        // leaves inside it, so each needs an arm of its own. Each destructures
        // by its DECLARED FIELD NAME — a positional bind type-checks and is
        // `undefined` at run time.
        // PROVISIONAL in one respect: upstream's `text-shadow-[…]` wraps a
        // colour in the value in `var(--tw-text-shadow-color, …)`.
        // ── end front 41 ───────────────────────────────────────
        // ── front 42 — filters ─────────────────────────────────
        // The two arbitrary-value variants are SIBLINGS of `Filter` and
        // `BackdropFilter`, destructured by their DECLARED FIELD NAME.
        // ── end front 42 ───────────────────────────────────────
        // ── front 43 — tables ──────────────────────────────────
        // ── end front 43 ───────────────────────────────────────
        // ── front 44 — transitions and animation ───────────────
        // THE ONE ARM OF THIS FRONT THAT DOES NOT GO THROUGH `declSheet`: a
        // named animation needs a `@keyframes` block beside its rule, and a
        // keyframes rule is not a style rule, so the dispatcher answers a
        // `Sheet` (front 56's second shape) instead of a declaration string.
        // The two arbitrary-value variants are SIBLINGS of `Transition` and
        // `Animate`, not leaves inside them. `AnimateRaw` goes through
        // `declSheet` and NOT through `animateTokenToSheet`: a custom animation
        // names keyframes this front does not own, so it hoists no block.
        // ── end front 44 ───────────────────────────────────────
        // ── front 45 — transforms ──────────────────────────────
        // The two arbitrary-value variants are SIBLINGS of `Transform`, not
        // leaves inside it, so each needs an arm of its own. Each destructures
        // by its DECLARED FIELD NAME — a positional bind type-checks and is
        // `undefined` at run time.
        // ── end front 45 ───────────────────────────────────────
        // ── front 46 — interactivity ───────────────────────────
        // The three colour variants are SIBLINGS of `Interact`, destructured
        // by their DECLARED FIELD NAMES.
        // ── end front 46 ───────────────────────────────────────
        // ── front 47 — svg and accessibility ───────────────────
        // ── end front 47 ───────────────────────────────────────
        // ── front 57 — escape hatches ──────────────────────────
        // ── end front 57 ───────────────────────────────────────
        // ── front 58 — container queries ───────────────────────
        // ── end front 58 ───────────────────────────────────────
        // ── front 34 — modifiers ─────────────────────────────────────────
        // ── end front 34 ─────────────────────────────────────────────────
    };
    return out;
}

// Fold a token list into one sheet. LIST ORDER IS PRESERVED, which is what
// makes token order class identity and what makes the last token setting a
// property the one that wins.
fn tokensToSheet(tokens: Token[], th: Theme) -> Sheet {
    return tokens.fold(
        emptySheet(),
        { acc, t -> mergeSheet(acc, tokenToSheet(t, th)) },
    );
}

//// ═══ END FRONT 56 — everything below is fronts 33-47, 57 and 58 ═════════

//// ═══ FRONT 34 · the modifier variant table ═══════════════════════════════
////
//// A modifier is the only way a token reaches a state, a breakpoint or a
//// pseudo-element. There are eighty-three, and every one of them is the same
//// two things: a top-level `Token` variant carrying `inner: Token[]`
//// (`tokens.bp`, same banner), and ONE `Variant`-returning fn here.
////
//// THIS FRONT OWNS NO WRAPPING LOGIC. `Variant(atRule, selector)`,
//// `nestVariant` and the one-`&` nesting template are front 56's, and no
//// function below builds a `{` or a `}` or concatenates an inner sheet.
//// Two consequences worth stating, because they are what makes the two
//// fields enough for the whole reference table:
////
////   - a variant is nested by SUBSTITUTING the inner rule's `&` with the
////     outer variant's selector, so `:is(& > *)` and `:is(& *)` — where
////     the class is not leading — go through the same field as `&:focus`;
////   - an empty `atRule` means the variant is purely a selector, and a `"&"`
////     selector means it is purely an at-rule.
////
//// A BREAKPOINT READS THE THEME (decision 82), both ways round: `mdVariant`
//// and `maxMdVariant` both resolve `--breakpoint-md`, so a project that
//// overrides the ladder gets its own queries and its own class hashes.
//// `darkVariant` likewise consumes front 54's `darkAtRule`/`darkSelector`
//// rather than re-deciding the strategy: `DarkMode.Media` answers an at-rule
//// and a bare `&`, `DarkMode.Class` and `DarkMode.Attribute` answer no
//// at-rule and a `:where(…)` selector, and this front never learns which.
////
//// `Marker` and `Selection` are the two rows upstream writes as MORE THAN ONE
//// selector — the element's descendants AND the element itself (`& *::marker,
//// &::marker`). A one-`&` template cannot say "this and its descendants", so
//// each is a LIST of one-`&` variants (`markerVariants()`,
//// `selectionVariants()`), and `nestVariants` wraps the inner sheet once per
//// variant, in upstream's order. Front 56's rule is untouched.
////
//// `Important` is the one row that is not a variant at all — decision 81
//// gives front 34 upstream's per-utility `!`, and it is one line on top of
//// front 56's `markImportant`.

// ── the shapes a variant takes ────────────────────────────────────────────

// Purely a selector — the reference's `focus`, `before`, `rtl`, `group-*` rows.
fn selectorVariant(selector: string) -> Variant {
    return Variant(atRule: "", selector: selector);
}

// Purely an at-rule — the reference's `print`, `portrait`, `motion-*` rows.
// The selector is the bare `&`, so the rule it wraps keeps its own.
fn atRuleVariant(atRule: string) -> Variant {
    return Variant(atRule: atRule, selector: "&");
}

// `sm:` … `2xl:`, upstream's `width >= <breakpoint>` form. The width is the
// THEME's, never a literal: `--breakpoint-md` is `48rem` in the stock theme
// and whatever the project says otherwise.
fn breakpointVariant(th: Theme, name: string) -> Variant {
    return Variant(
        atRule: "@media (width >= " + themeValue(th, name) + ")",
        selector: "&",
    );
}

// `max-sm:` … `max-2xl:`, the same entry read as an exclusive upper bound. A
// RANGE is nesting and not a variant: `md:max-xl:` is `Md([MaxXl([…])])`.
fn maxBreakpointVariant(th: Theme, name: string) -> Variant {
    return Variant(
        atRule: "@media (width < " + themeValue(th, name) + ")",
        selector: "&",
    );
}

// The reference gives `group-*` as one template with the state substituted in,
// so it is written once. `.group` is a class the CONSUMER's markup carries;
// emilia never emits it.
fn groupVariant(state: string) -> Variant {
    return selectorVariant("&:is(:where(.group)" + state + " *)");
}

// The same, for the sibling form. `.peer` is the consumer's too.
fn peerVariant(state: string) -> Variant {
    return selectorVariant("&:is(:where(.peer)" + state + " ~ *)");
}

// ── named groups and peers (decision 401) ────────────────────────────────
//
// `group/card` and `peer/field`: the marker class carries the name after an
// escaped slash, `.group\/card`, and every state keeps the unnamed form's
// selector around it — upstream 4.3.2 writes `&:is(:where(.group\/card):hover *)`.
// `GroupNamed(name, inner)` names the `.group` of each unnamed group state
// token in `inner` (`GroupHover`, `GroupFocus`, …); `PeerNamed` the `.peer` of
// each peer state token. Any other token in `inner` is folded unchanged, and a
// state token of the other family is left unnamed.

fn checkParentName(kind: string, name: string) -> string {
    if (refusesIdent(name))
        panic(
            "emilia "
                + kind
                + ": a name may contain only letters, digits, - and _: '"
                + name
                + "'",
        );
    return name;
}

pub fn groupClassOf(name: string) -> string {
    return ".group\\/" + checkParentName("group", name);
}

pub fn peerClassOf(name: string) -> string {
    return ".peer\\/" + checkParentName("peer", name);
}

fn groupStateVariant(cls: string, state: string) -> Variant {
    return selectorVariant("&:is(:where(" + cls + ")" + state + " *)");
}

fn peerStateVariant(cls: string, state: string) -> Variant {
    return selectorVariant("&:is(:where(" + cls + ")" + state + " ~ *)");
}

// One token of a named parent's `inner`. `cls` is `.group\/name` or
// `.peer\/name`; a token of the family it names is rebuilt around it.
fn namedParentToken(cls: string, t: Token, th: Theme) -> Sheet {
    val isGroup = cls.startsWith(".group");
    val out = case t {
        GroupHover(inner) -> if (isGroup)
            nestVariant(
                tokensToSheet(inner, th),
                groupStateVariant(cls, ":hover"),
            )
        else
            tokenToSheet(t, th);
        GroupFocus(inner) -> if (isGroup)
            nestVariant(
                tokensToSheet(inner, th),
                groupStateVariant(cls, ":focus"),
            )
        else
            tokenToSheet(t, th);
        GroupActive(inner) -> if (isGroup)
            nestVariant(
                tokensToSheet(inner, th),
                groupStateVariant(cls, ":active"),
            )
        else
            tokenToSheet(t, th);
        GroupVisited(inner) -> if (isGroup)
            nestVariant(
                tokensToSheet(inner, th),
                groupStateVariant(cls, ":visited"),
            )
        else
            tokenToSheet(t, th);
        GroupDisabled(inner) -> if (isGroup)
            nestVariant(
                tokensToSheet(inner, th),
                groupStateVariant(cls, ":disabled"),
            )
        else
            tokenToSheet(t, th);
        GroupOpen(inner) -> if (isGroup)
            nestVariant(
                tokensToSheet(inner, th),
                groupStateVariant(cls, ":is([open], :popover-open, :open)"),
            )
        else
            tokenToSheet(t, th);
        PeerHover(inner) -> if (isGroup)
            tokenToSheet(t, th)
        else
            nestVariant(
                tokensToSheet(inner, th),
                peerStateVariant(cls, ":hover"),
            );
        PeerFocus(inner) -> if (isGroup)
            tokenToSheet(t, th)
        else
            nestVariant(
                tokensToSheet(inner, th),
                peerStateVariant(cls, ":focus"),
            );
        PeerActive(inner) -> if (isGroup)
            tokenToSheet(t, th)
        else
            nestVariant(
                tokensToSheet(inner, th),
                peerStateVariant(cls, ":active"),
            );
        PeerChecked(inner) -> if (isGroup)
            tokenToSheet(t, th)
        else
            nestVariant(
                tokensToSheet(inner, th),
                peerStateVariant(cls, ":checked"),
            );
        PeerInvalid(inner) -> if (isGroup)
            tokenToSheet(t, th)
        else
            nestVariant(
                tokensToSheet(inner, th),
                peerStateVariant(cls, ":invalid"),
            );
        PeerRequired(inner) -> if (isGroup)
            tokenToSheet(t, th)
        else
            nestVariant(
                tokensToSheet(inner, th),
                peerStateVariant(cls, ":required"),
            );
        PeerDisabled(inner) -> if (isGroup)
            tokenToSheet(t, th)
        else
            nestVariant(
                tokensToSheet(inner, th),
                peerStateVariant(cls, ":disabled"),
            );
        PeerPlaceholderShown(inner) -> if (isGroup)
            tokenToSheet(t, th)
        else
            nestVariant(
                tokensToSheet(inner, th),
                peerStateVariant(cls, ":placeholder-shown"),
            );
        _ -> tokenToSheet(t, th);
    };
    return out;
}

fn namedParentSheet(cls: string, inner: Token[], th: Theme) -> Sheet {
    return inner.fold(
        emptySheet(),
        { acc, t -> mergeSheet(acc, namedParentToken(cls, t, th)) },
    );
}

// A row upstream writes as a selector LIST: the inner sheet wrapped once per
// one-`&` variant, concatenated in the list's order.
fn nestVariants(s: Sheet, vs: Variant[]) -> Sheet {
    return vs.fold(
        emptySheet(),
        { acc, v -> mergeSheet(acc, nestVariant(s, v)) },
    );
}

// ── breakpoints — min-width, read from the theme's `--breakpoint-*` ladder ───

pub fn smVariant(th: Theme) -> Variant {
    return breakpointVariant(th, "--breakpoint-sm");
}

pub fn mdVariant(th: Theme) -> Variant {
    return breakpointVariant(th, "--breakpoint-md");
}

pub fn lgVariant(th: Theme) -> Variant {
    return breakpointVariant(th, "--breakpoint-lg");
}

pub fn xlVariant(th: Theme) -> Variant {
    return breakpointVariant(th, "--breakpoint-xl");
}

pub fn x2xlVariant(th: Theme) -> Variant {
    return breakpointVariant(th, "--breakpoint-2xl");
}

// ── breakpoints — max-width, the same ladder read the other way ──────────

pub fn maxSmVariant(th: Theme) -> Variant {
    return maxBreakpointVariant(th, "--breakpoint-sm");
}

pub fn maxMdVariant(th: Theme) -> Variant {
    return maxBreakpointVariant(th, "--breakpoint-md");
}

pub fn maxLgVariant(th: Theme) -> Variant {
    return maxBreakpointVariant(th, "--breakpoint-lg");
}

pub fn maxXlVariant(th: Theme) -> Variant {
    return maxBreakpointVariant(th, "--breakpoint-xl");
}

pub fn maxX2xlVariant(th: Theme) -> Variant {
    return maxBreakpointVariant(th, "--breakpoint-2xl");
}

// ── dark mode and the other media features ───────────────────────────────

pub fn darkVariant(th: Theme) -> Variant {
    return Variant(atRule: darkAtRule(th), selector: darkSelector(th));
}

pub fn printVariant() -> Variant {
    return atRuleVariant("@media print");
}

pub fn portraitVariant() -> Variant {
    return atRuleVariant("@media (orientation: portrait)");
}

pub fn landscapeVariant() -> Variant {
    return atRuleVariant("@media (orientation: landscape)");
}

pub fn motionSafeVariant() -> Variant {
    return atRuleVariant("@media (prefers-reduced-motion: no-preference)");
}

pub fn motionReduceVariant() -> Variant {
    return atRuleVariant("@media (prefers-reduced-motion: reduce)");
}

pub fn contrastMoreVariant() -> Variant {
    return atRuleVariant("@media (prefers-contrast: more)");
}

pub fn contrastLessVariant() -> Variant {
    return atRuleVariant("@media (prefers-contrast: less)");
}

pub fn forcedColorsVariant() -> Variant {
    return atRuleVariant("@media (forced-colors: active)");
}

// ── interaction state ────────────────────────────────────────────────────

pub fn hoverVariant() -> Variant {
    return Variant(atRule: "@media (hover: hover)", selector: "&:hover");
}

pub fn focusVariant() -> Variant {
    return selectorVariant("&:focus");
}

pub fn focusWithinVariant() -> Variant {
    return selectorVariant("&:focus-within");
}

pub fn focusVisibleVariant() -> Variant {
    return selectorVariant("&:focus-visible");
}

pub fn activeVariant() -> Variant {
    return selectorVariant("&:active");
}

pub fn visitedVariant() -> Variant {
    return selectorVariant("&:visited");
}

pub fn targetVariant() -> Variant {
    return selectorVariant("&:target");
}

// THE REFERENCE ROW DOES NOT SURVIVE FRONT 56. `§ 3.2` spells `open` as
// `&:open, &:popover-open`, which carries TWO `&` and is refused by
// `checkVariantSelector` with no opt-out — correctly, since the two-`&` form
// duplicates the rule it wraps. The two states go inside one `:is()` instead:
// one `&`, the same match set, and no selector list for front 56 to split.
//
// AND THE ROW IS A VERSION BEHIND, confirmed by the maintainer rather than
// guessed here: upstream v4 also carries the legacy `[open]` ATTRIBUTE
// (`&:is([open], :popover-open, :open)`), because that is what matches
// `<details open>` on an engine without `:open`. The local reference's table
// does not, and this front transcribed the table it could read. **The next
// front to touch this row with upstream in hand adds `[open]`** — it is
// recorded on the milestone's reference-coverage row, not left as a
// suspicion. The test below pins the current spelling, so the addition shows
// up as a change and not as a drift.
// Upstream v4's form, the legacy `[open]` attribute first: it is what matches
// `<details open>` on an engine without `:open`.
pub fn openVariant() -> Variant {
    return selectorVariant("&:is([open], :popover-open, :open)");
}

pub fn inertVariant() -> Variant {
    return selectorVariant("&:is([inert], [inert] *)");
}

// ── form state ───────────────────────────────────────────────────────────

pub fn disabledVariant() -> Variant {
    return selectorVariant("&:disabled");
}

pub fn enabledVariant() -> Variant {
    return selectorVariant("&:enabled");
}

pub fn checkedVariant() -> Variant {
    return selectorVariant("&:checked");
}

pub fn indeterminateVariant() -> Variant {
    return selectorVariant("&:indeterminate");
}

pub fn defaultVariant() -> Variant {
    return selectorVariant("&:default");
}

pub fn optionalVariant() -> Variant {
    return selectorVariant("&:optional");
}

pub fn requiredVariant() -> Variant {
    return selectorVariant("&:required");
}

pub fn validVariant() -> Variant {
    return selectorVariant("&:valid");
}

pub fn invalidVariant() -> Variant {
    return selectorVariant("&:invalid");
}

pub fn userValidVariant() -> Variant {
    return selectorVariant("&:user-valid");
}

pub fn userInvalidVariant() -> Variant {
    return selectorVariant("&:user-invalid");
}

pub fn inRangeVariant() -> Variant {
    return selectorVariant("&:in-range");
}

pub fn outOfRangeVariant() -> Variant {
    return selectorVariant("&:out-of-range");
}

pub fn placeholderShownVariant() -> Variant {
    return selectorVariant("&:placeholder-shown");
}

pub fn autofillVariant() -> Variant {
    return selectorVariant("&:autofill");
}

pub fn readOnlyVariant() -> Variant {
    return selectorVariant("&:read-only");
}

// ── structural position ──────────────────────────────────────────────────

pub fn firstVariant() -> Variant {
    return selectorVariant("&:first-child");
}

pub fn lastVariant() -> Variant {
    return selectorVariant("&:last-child");
}

pub fn onlyVariant() -> Variant {
    return selectorVariant("&:only-child");
}

pub fn oddVariant() -> Variant {
    return selectorVariant("&:nth-child(odd)");
}

pub fn evenVariant() -> Variant {
    return selectorVariant("&:nth-child(even)");
}

pub fn firstOfTypeVariant() -> Variant {
    return selectorVariant("&:first-of-type");
}

pub fn lastOfTypeVariant() -> Variant {
    return selectorVariant("&:last-of-type");
}

pub fn onlyOfTypeVariant() -> Variant {
    return selectorVariant("&:only-of-type");
}

pub fn emptyVariant() -> Variant {
    return selectorVariant("&:empty");
}

pub fn nthVariant(index: i32) -> Variant {
    return selectorVariant("&:nth-child(" + index.toString() + ")");
}

pub fn nthLastVariant(index: i32) -> Variant {
    return selectorVariant("&:nth-last-child(" + index.toString() + ")");
}

// ── pseudo-elements ──────────────────────────────────────────────────────

pub fn beforeVariant() -> Variant {
    return selectorVariant("&::before");
}

pub fn afterVariant() -> Variant {
    return selectorVariant("&::after");
}

pub fn firstLetterVariant() -> Variant {
    return selectorVariant("&::first-letter");
}

pub fn firstLineVariant() -> Variant {
    return selectorVariant("&::first-line");
}

pub fn placeholderVariant() -> Variant {
    return selectorVariant("&::placeholder");
}

pub fn fileVariant() -> Variant {
    return selectorVariant("&::file-selector-button");
}

// Upstream v4 (4.3.2, compiled): the descendants' marker AND the element's
// own, then WebKit's `<summary>` marker the same two ways — four one-`&`
// selectors where the reference's `& ::marker` reached descendants only.
pub fn markerVariants() -> Variant[] {
    val out: Variant[] = [
        selectorVariant("& *::marker"),
        selectorVariant("&::marker"),
        selectorVariant("& *::-webkit-details-marker"),
        selectorVariant("&::-webkit-details-marker"),
    ];
    return out;
}

// The same pair for `::selection`: the descendants' and the element's own.
pub fn selectionVariants() -> Variant[] {
    val out: Variant[] = [
        selectorVariant("& *::selection"),
        selectorVariant("&::selection"),
    ];
    return out;
}

pub fn backdropVariant() -> Variant {
    return selectorVariant("&::backdrop");
}

// ── parent state — the `.group` class is the consumer's, never emilia's ───

pub fn groupHoverVariant() -> Variant {
    return groupVariant(":hover");
}

pub fn groupFocusVariant() -> Variant {
    return groupVariant(":focus");
}

pub fn groupActiveVariant() -> Variant {
    return groupVariant(":active");
}

pub fn groupVisitedVariant() -> Variant {
    return groupVariant(":visited");
}

pub fn groupDisabledVariant() -> Variant {
    return groupVariant(":disabled");
}

pub fn groupOpenVariant() -> Variant {
    return groupVariant(":is([open], :popover-open, :open)");
}

// ── sibling state — the `.peer` class is the consumer's, never emilia's ───

pub fn peerHoverVariant() -> Variant {
    return peerVariant(":hover");
}

pub fn peerFocusVariant() -> Variant {
    return peerVariant(":focus");
}

pub fn peerActiveVariant() -> Variant {
    return peerVariant(":active");
}

pub fn peerCheckedVariant() -> Variant {
    return peerVariant(":checked");
}

pub fn peerInvalidVariant() -> Variant {
    return peerVariant(":invalid");
}

pub fn peerRequiredVariant() -> Variant {
    return peerVariant(":required");
}

pub fn peerDisabledVariant() -> Variant {
    return peerVariant(":disabled");
}

pub fn peerPlaceholderShownVariant() -> Variant {
    return peerVariant(":placeholder-shown");
}

// ── writing direction and descent ────────────────────────────────────────

// Upstream v4.1's form: the `:dir()` pseudo-class, the attribute on the
// element itself, and the attribute on an ancestor — one `&`, leading.
pub fn rtlVariant() -> Variant {
    return selectorVariant(
        "&:where(:dir(rtl), [dir=\"rtl\"], [dir=\"rtl\"] *)",
    );
}

pub fn ltrVariant() -> Variant {
    return selectorVariant(
        "&:where(:dir(ltr), [dir=\"ltr\"], [dir=\"ltr\"] *)",
    );
}

pub fn childrenVariant() -> Variant {
    return selectorVariant(":is(& > *)");
}

pub fn descendantsVariant() -> Variant {
    return selectorVariant(":is(& *)");
}

// ── front 34 · tests ─────────────────────────────────────────────────────
//
// Each family gets two: the `Variant` halves against the reference's two
// columns, and the CSS the row renders once front 56's `nestVariant` and
// `renderRule` have applied it. The rendered form is what a reader checks
// against upstream; the halves are what this front actually writes.

fn boldInner() -> Token[] {
    val out: Token[] = [.Text.Bold];
    return out;
}

// The CSS one modifier renders around `font-weight:bold`, on a class called
// `x` and with the theme layer switched off, so the assertion is the row.
fn modifierCssWith(t: Token, th: Theme) -> string {
    return renderRule("x", firstRuleOf(tokenToSheet(t, th)), bareOptions());
}

fn modifierCss(t: Token) -> string {
    return modifierCssWith(t, defaultTheme());
}

// Every rule a modifier produces, rendered in order — the two selector-list
// rows (`Marker`, `Selection`) produce more than one.
fn modifierCssAll(t: Token) -> string {
    return tokenToSheet(t, defaultTheme()).rules
        .map({ r -> renderRule("x", r, bareOptions()) })
        .join("");
}

test "breakpoints, min-width — the two halves of every Variant in the family" {
    val th = defaultTheme();
    assert smVariant(th).atRule == "@media (width >= 40rem)";
    assert smVariant(th).selector == "&";
    assert mdVariant(th).atRule == "@media (width >= 48rem)";
    assert mdVariant(th).selector == "&";
    assert lgVariant(th).atRule == "@media (width >= 64rem)";
    assert lgVariant(th).selector == "&";
    assert xlVariant(th).atRule == "@media (width >= 80rem)";
    assert xlVariant(th).selector == "&";
    assert x2xlVariant(th).atRule == "@media (width >= 96rem)";
    assert x2xlVariant(th).selector == "&";
}

test "breakpoints, min-width — the CSS each row renders around one declaration" {
    val inner = boldInner();
    assert modifierCss(Token.Sm(inner))
        == "@media (width >= 40rem){.x{font-weight:bold}}";
    assert modifierCss(Token.Md(inner))
        == "@media (width >= 48rem){.x{font-weight:bold}}";
    assert modifierCss(Token.Lg(inner))
        == "@media (width >= 64rem){.x{font-weight:bold}}";
    assert modifierCss(Token.Xl(inner))
        == "@media (width >= 80rem){.x{font-weight:bold}}";
    assert modifierCss(Token.X2xl(inner))
        == "@media (width >= 96rem){.x{font-weight:bold}}";
}

