// ── the walks ────────────────────────────────────────────────────────────
//
// The table is long, so the invariants are asserted over the WHOLE of it
// rather than row by row. `everyVariant` is every `Variant`-returning fn in
// this front; `everyModifier` is every top-level variant `tokens.bp`
// declares under the same banner, each wrapping one declaration.

fn everyVariant(th: Theme) -> Variant[] {
    val out: Variant[] = [
        smVariant(th),
        mdVariant(th),
        lgVariant(th),
        xlVariant(th),
        x2xlVariant(th),
        maxSmVariant(th),
        maxMdVariant(th),
        maxLgVariant(th),
        maxXlVariant(th),
        maxX2xlVariant(th),
        darkVariant(th),
        printVariant(),
        portraitVariant(),
        landscapeVariant(),
        motionSafeVariant(),
        motionReduceVariant(),
        contrastMoreVariant(),
        contrastLessVariant(),
        forcedColorsVariant(),
        hoverVariant(),
        focusVariant(),
        focusWithinVariant(),
        focusVisibleVariant(),
        activeVariant(),
        visitedVariant(),
        targetVariant(),
        openVariant(),
        inertVariant(),
        disabledVariant(),
        enabledVariant(),
        checkedVariant(),
        indeterminateVariant(),
        defaultVariant(),
        optionalVariant(),
        requiredVariant(),
        validVariant(),
        invalidVariant(),
        userValidVariant(),
        userInvalidVariant(),
        inRangeVariant(),
        outOfRangeVariant(),
        placeholderShownVariant(),
        autofillVariant(),
        readOnlyVariant(),
        firstVariant(),
        lastVariant(),
        onlyVariant(),
        oddVariant(),
        evenVariant(),
        firstOfTypeVariant(),
        lastOfTypeVariant(),
        onlyOfTypeVariant(),
        emptyVariant(),
        nthVariant(3),
        nthLastVariant(5),
        beforeVariant(),
        afterVariant(),
        firstLetterVariant(),
        firstLineVariant(),
        placeholderVariant(),
        fileVariant(),
        backdropVariant(),
        groupHoverVariant(),
        groupFocusVariant(),
        groupActiveVariant(),
        groupVisitedVariant(),
        groupDisabledVariant(),
        groupOpenVariant(),
        peerHoverVariant(),
        peerFocusVariant(),
        peerActiveVariant(),
        peerCheckedVariant(),
        peerInvalidVariant(),
        peerRequiredVariant(),
        peerDisabledVariant(),
        peerPlaceholderShownVariant(),
        rtlVariant(),
        ltrVariant(),
        childrenVariant(),
        descendantsVariant(),
    ];
    return out.append(markerVariants()).append(selectionVariants());
}

fn everyModifier() -> Token[] {
    val inner = boldInner();
    val out: Token[] = [
        Token.Sm(inner),
        Token.Md(inner),
        Token.Lg(inner),
        Token.Xl(inner),
        Token.X2xl(inner),
        Token.MaxSm(inner),
        Token.MaxMd(inner),
        Token.MaxLg(inner),
        Token.MaxXl(inner),
        Token.MaxX2xl(inner),
        Token.Dark(inner),
        Token.Print(inner),
        Token.Portrait(inner),
        Token.Landscape(inner),
        Token.MotionSafe(inner),
        Token.MotionReduce(inner),
        Token.ContrastMore(inner),
        Token.ContrastLess(inner),
        Token.ForcedColors(inner),
        Token.Hover(inner),
        Token.Focus(inner),
        Token.FocusWithin(inner),
        Token.FocusVisible(inner),
        Token.Active(inner),
        Token.Visited(inner),
        Token.Target(inner),
        Token.Open(inner),
        Token.Inert(inner),
        Token.Disabled(inner),
        Token.Enabled(inner),
        Token.Checked(inner),
        Token.Indeterminate(inner),
        Token.Default(inner),
        Token.Optional(inner),
        Token.Required(inner),
        Token.Valid(inner),
        Token.Invalid(inner),
        Token.UserValid(inner),
        Token.UserInvalid(inner),
        Token.InRange(inner),
        Token.OutOfRange(inner),
        Token.PlaceholderShown(inner),
        Token.Autofill(inner),
        Token.ReadOnly(inner),
        Token.First(inner),
        Token.Last(inner),
        Token.Only(inner),
        Token.Odd(inner),
        Token.Even(inner),
        Token.FirstOfType(inner),
        Token.LastOfType(inner),
        Token.OnlyOfType(inner),
        Token.Empty(inner),
        Token.Nth(index: 3, inner: inner),
        Token.NthLast(index: 5, inner: inner),
        Token.Before(inner),
        Token.After(inner),
        Token.FirstLetter(inner),
        Token.FirstLine(inner),
        Token.Placeholder(inner),
        Token.File(inner),
        Token.Marker(inner),
        Token.Selection(inner),
        Token.Backdrop(inner),
        Token.GroupHover(inner),
        Token.GroupFocus(inner),
        Token.GroupActive(inner),
        Token.GroupVisited(inner),
        Token.GroupDisabled(inner),
        Token.GroupOpen(inner),
        Token.PeerHover(inner),
        Token.PeerFocus(inner),
        Token.PeerActive(inner),
        Token.PeerChecked(inner),
        Token.PeerInvalid(inner),
        Token.PeerRequired(inner),
        Token.PeerDisabled(inner),
        Token.PeerPlaceholderShown(inner),
        Token.Rtl(inner),
        Token.Ltr(inner),
        Token.Children(inner),
        Token.Descendants(inner),
        Token.Important(inner),
    ];
    return out;
}

// 80 one-`Variant` fns, plus `markerVariants()`'s four and
// `selectionVariants()`'s two.
test "the table — 86 variants over 82 names, 83 modifier tokens, and no row is a copy" {
    assert everyVariant(defaultTheme()).length == 86;
    assert everyModifier().length == 83;
}

// The distinct-pair fold: two rows that resolved to the same at-rule and the
// same selector would be two names for one variant, which the reference has
// nowhere in its table.
fn pushDistinctString(acc: string[], s: string) -> string[] {
    val present = acc.any({ x -> x == s });
    val one: string[] = [s];
    val out = if (present) acc else acc.append(one);
    return out;
}

fn distinctStrings(xs: string[]) -> string[] {
    val seed: string[] = [];
    return xs.fold(seed, { acc, x -> pushDistinctString(acc, x) });
}

test "the walk — every selector template carries exactly one ampersand" {
    val vs = everyVariant(defaultTheme());
    assert vs.all({ v -> v.selector.split("&").length == 2 });
}

test "the walk — this front builds no brace, and every at-rule is an at-rule" {
    val vs = everyVariant(defaultTheme());
    assert vs.all({ v -> v.selector.split("{").length == 1 });
    assert vs.all({ v -> v.selector.split("}").length == 1 });
    assert vs.all({ v -> v.atRule.split("{").length == 1 });
    assert vs.all({ v -> v.atRule == "" || v.atRule.startsWith("@") });
}

test "the walk — no two rows resolve to the same pair" {
    val vs = everyVariant(defaultTheme());
    val pairs = vs.map({ v -> v.atRule + " <> " + v.selector });
    assert distinctStrings(pairs).length == pairs.length;
}

test "the walk — every modifier wraps its declaration, and none drops it" {
    val ms = everyModifier();
    val sheets = ms.map({ m -> tokenToSheet(m, defaultTheme()) });
    assert sheets.all({ s -> s.rules.length >= 1 });
    assert sheets.all(
        { s -> s.rules.all({ r -> r.declarations == "font-weight:bold" }) },
    );
    // one rule per modifier, but the two selector-list rows upstream writes
    assert sheets.filter({ s -> s.rules.length > 1 }).length == 2;
    assert sheets.map({ s -> s.rules.length }).fold(0, { acc, n -> acc + n })
        == 83 + 3 + 1;
}

test "the walk — no breakpoint query resolves a pixel, and none is min-width" {
    val vs = everyVariant(defaultTheme());
    assert vs.all({ v -> v.atRule.split("px").length == 1 });
    assert vs.all({ v -> v.atRule.split("min-width").length == 1 });
    assert vs.all({ v -> v.atRule.split("max-width").length == 1 });
}

test "the walk — no variant carries a codec separator" {
    val vs = everyVariant(defaultTheme());
    assert vs.all({ v -> carriesSeparator(v.selector) == false });
    assert vs.all({ v -> carriesSeparator(v.atRule) == false });
}

// ── dark mode — one cell per strategy, all three from front 54 ─────────────
//
// This front does not know which strategy is in force: it asks `darkAtRule`
// and `darkSelector` and hands the pair to `nestVariant`. The three tests
// below are the proof that the pair is enough — `Media` puts the whole
// strategy in the at-rule, `Class` and `Attribute` put it in the selector, and
// the `Dark` token is the same token in all three.

test "dark — the `Media` strategy is an at-rule over the bare ampersand" {
    val th = defaultTheme();
    assert darkVariant(th).atRule == "@media (prefers-color-scheme: dark)";
    assert darkVariant(th).selector == "&";
    val inner = boldInner();
    assert modifierCssWith(Token.Dark(inner), th)
        == "@media (prefers-color-scheme: dark){.x{font-weight:bold}}";
}

test "dark — the `Class` strategy is a selector and no at-rule at all" {
    val th = withDarkMode(defaultTheme(), DarkMode.Class(name: "dark"));
    assert darkVariant(th).atRule == "";
    assert darkVariant(th).selector == "&:where(.dark, .dark *)";
    val inner = boldInner();
    assert modifierCssWith(Token.Dark(inner), th)
        == ".x:where(.dark, .dark *){font-weight:bold}";
}

test "dark — the `Attribute` strategy is the same shape, on a data attribute" {
    val th = withDarkMode(
        defaultTheme(),
        DarkMode.Attribute(name: "data-theme", value: "dark"),
    );
    assert darkVariant(th).atRule == "";
    assert darkVariant(th).selector
        == "&:where([data-theme=dark], [data-theme=dark] *)";
    val inner = boldInner();
    assert modifierCssWith(Token.Dark(inner), th)
        == ".x:where([data-theme=dark], [data-theme=dark] *){font-weight:bold}";
}

test "dark — the strategy is an input to the class, because the rule differs" {
    val inner = boldInner();
    val tokens: Token[] = [Token.Dark(inner)];
    val byMedia = defaultTheme();
    val byClass = withDarkMode(byMedia, DarkMode.Class(name: "dark"));
    assert emiliaWith(tokens, byMedia) != emiliaWith(tokens, byClass);
    val _drop = await flush();
}

// ── ranges, order and depth ───────────────────────────────────────────────

test "a breakpoint RANGE is nesting, not a variant — `md:max-xl:`" {
    val inner = boldInner();
    val mid: Token[] = [Token.MaxXl(inner)];
    assert modifierCss(Token.Md(mid))
        == "@media (width >= 48rem){@media (width < 80rem){.x{font-weight:bold}}}";
}

test "the other range the reference shows — `sm:max-md:`" {
    val inner = boldInner();
    val mid: Token[] = [Token.MaxMd(inner)];
    assert modifierCss(Token.Sm(mid))
        == "@media (width >= 40rem){@media (width < 48rem){.x{font-weight:bold}}}";
}

test "three deep — `dark:md:hover:` comes out in source order" {
    val inner = boldInner();
    val hover: Token[] = [Token.Hover(inner)];
    val md: Token[] = [Token.Md(hover)];
    assert modifierCss(Token.Dark(md))
        == "@media (prefers-color-scheme: dark){@media (width >= 48rem){@media (hover: hover){.x:hover{font-weight:bold}}}}";
}

// THE OTHER ORDER: `md:dark:` puts the breakpoint outermost, and the blocks
// come out in source order both ways round.
test "`md:dark:` — Dark inside a breakpoint, the breakpoint outermost" {
    val inner = boldInner();
    val dark: Token[] = [Token.Dark(inner)];
    assert modifierCss(Token.Md(dark))
        == "@media (width >= 48rem){@media (prefers-color-scheme: dark){.x{font-weight:bold}}}";
    val md: Token[] = [Token.Md(inner)];
    assert modifierCss(Token.Dark(md))
        == "@media (prefers-color-scheme: dark){@media (width >= 48rem){.x{font-weight:bold}}}";
}

test "a pseudo-element under a state nests the right way round" {
    val inner = boldInner();
    val before: Token[] = [Token.Before(inner)];
    assert modifierCss(Token.Hover(before))
        == "@media (hover: hover){.x:hover::before{font-weight:bold}}";
}

test "a breakpoint override reaches both directions of the ladder" {
    val wide: ThemeEntry[] = [
        ThemeEntry(name: "--breakpoint-md", value: "50rem"),
    ];
    val th = extendTheme(defaultTheme(), wide);
    val inner = boldInner();
    assert modifierCssWith(Token.Md(inner), th)
        == "@media (width >= 50rem){.x{font-weight:bold}}";
    assert modifierCssWith(Token.MaxMd(inner), th)
        == "@media (width < 50rem){.x{font-weight:bold}}";
}

// ── the two indexed rows ──────────────────────────────────────────────────

test "Nth — three indices, including a two-digit one" {
    val inner = boldInner();
    assert modifierCss(Token.Nth(index: 1, inner: inner))
        == ".x:nth-child(1){font-weight:bold}";
    assert modifierCss(Token.Nth(index: 3, inner: inner))
        == ".x:nth-child(3){font-weight:bold}";
    assert modifierCss(Token.Nth(index: 12, inner: inner))
        == ".x:nth-child(12){font-weight:bold}";
    assert nthVariant(7).atRule == "";
    assert nthVariant(7).selector == "&:nth-child(7)";
}

test "NthLast — the same three, counted from the end" {
    val inner = boldInner();
    assert modifierCss(Token.NthLast(index: 1, inner: inner))
        == ".x:nth-last-child(1){font-weight:bold}";
    assert modifierCss(Token.NthLast(index: 5, inner: inner))
        == ".x:nth-last-child(5){font-weight:bold}";
    assert modifierCss(Token.NthLast(index: 12, inner: inner))
        == ".x:nth-last-child(12){font-weight:bold}";
    assert nthLastVariant(7).selector == "&:nth-last-child(7)";
}

// ── the rows whose text is easy to get wrong ──────────────────────────────

// The reference spells this row `&:open, &:popover-open` — two `&`, which
// front 56 refuses — and omits the legacy `[open]` attribute. Upstream v4
// writes `&:is([open], :popover-open, :open)`: one `&`, the three states
// inside `:is()`, so the comma is INSIDE one selector and never a separator
// emilia added. `group-open:` carries the same three states.

test "the three states of `open` live inside one selector, `[open]` first" {
    assert openVariant().selector == "&:is([open], :popover-open, :open)";
    val inner = boldInner();
    assert modifierCss(Token.Open(inner))
        == ".x:is([open], :popover-open, :open){font-weight:bold}";
    assert tokenToSheet(Token.Open(inner), defaultTheme()).rules.length == 1;
    assert modifierCss(Token.GroupOpen(inner))
        == ".x:is(:where(.group):is([open], :popover-open, :open) *){font-weight:bold}";
}

// THE REFERENCE'S `& ::marker` REACHED DESCENDANTS ONLY. Upstream writes the
// descendants' AND the element's own, as two one-`&` rules; the reference's
// spaced form is asserted absent.
test "`marker` and `selection` reach the element itself as well as its descendants" {
    val inner = boldInner();
    val marker = modifierCssAll(Token.Marker(inner));
    assert marker.indexOf(".x::marker{") != -1;
    assert marker.indexOf(".x *::marker{") != -1;
    assert marker.indexOf(".x ::marker") == -1;
    val selection = modifierCssAll(Token.Selection(inner));
    assert selection.indexOf(".x::selection{") != -1;
    assert selection.indexOf(".x *::selection{") != -1;
    assert selection.indexOf(".x ::selection") == -1;
    assert markerVariants().all({ v -> v.selector.split("&").length == 2 });
    assert beforeVariant().selector == "&::before";
}

// THE REFERENCE'S `[dir="rtl"] &` IS PRE-v4. Upstream v4.1 leads with the
// class and matches `:dir(rtl)`, the element's own attribute and an
// ancestor's, inside one `:where()` — zero added specificity.
test "`rtl` and `ltr` lead with the class, upstream v4.1's `:where(:dir(…), …)`" {
    val inner = boldInner();
    assert modifierCss(Token.Rtl(inner))
        == ".x:where(:dir(rtl), [dir=\"rtl\"], [dir=\"rtl\"] *){font-weight:bold}";
    assert modifierCss(Token.Ltr(inner))
        == ".x:where(:dir(ltr), [dir=\"ltr\"], [dir=\"ltr\"] *){font-weight:bold}";
    assert modifierCss(Token.Rtl(inner)).indexOf("[dir=\"rtl\"] .x") == -1;
}

test "`*:` and `**:` wrap the ampersand rather than following it" {
    val inner = boldInner();
    assert modifierCss(Token.Children(inner))
        == ":is(.x > *){font-weight:bold}";
    assert modifierCss(Token.Descendants(inner))
        == ":is(.x *){font-weight:bold}";
}

test "`inert` is the attribute pair the reference gives, not a pseudo-class" {
    assert inertVariant().selector == "&:is([inert], [inert] *)";
}

// ── Important — decision 81, and the one row that is not a variant ─────────

test "Important — the wrapper sets the flag; it adds no selector and no at-rule" {
    val inner = boldInner();
    val r = firstRuleOf(tokenToSheet(Token.Important(inner), defaultTheme()));
    assert r.important == true;
    assert r.selector == "&";
    assert r.atRules.length == 0;
    assert modifierCss(Token.Important(inner))
        == ".x{font-weight:bold!important}";
}

test "Important — every rule it wraps is flagged, and a variant nests over it" {
    val two: Token[] = [.Text.Bold, .Layout.Flex];
    val marked: Token[] = [Token.Important(two)];
    val s = tokenToSheet(Token.Hover(marked), defaultTheme());
    assert s.rules.length == 2;
    assert s.rules.all({ r -> r.important });
    val css = s.rules.map({ r -> renderRule("x", r, bareOptions()) }).join("");
    assert css
        == "@media (hover: hover){.x:hover{font-weight:bold!important}}"
            + "@media (hover: hover){.x:hover{display:flex!important}}";
}

// ── the empty list ────────────────────────────────────────────────────────

test "a modifier whose inner list is empty produces an empty sheet, and is dropped" {
    val none: Token[] = [];
    assert tokenToSheet(Token.Hover(none), defaultTheme()).rules.length == 0;
    assert tokenToSheet(Token.Dark(none), defaultTheme()).rules.length == 0;
    assert tokenToSheet(
        Token.Nth(index: 2, inner: none),
        defaultTheme(),
    ).rules.length
        == 0;
    assert tokenToSheet(Token.Important(none), defaultTheme()).rules.length
        == 0;
}

test "an empty modifier beside a real token leaves exactly the real rule" {
    val none: Token[] = [];
    val tokens: Token[] = [.Text.Bold, Token.Focus(none)];
    val cls = emilia(tokens);
    val styles = await flushWith(bareOptions());
    assert styles
        == "<style>@layer theme, base, components, utilities;@layer utilities{."
            + cls
            + "{font-weight:bold}}</style>";
}

// ── end to end ────────────────────────────────────────────────────────────

test "end to end — a light background and its dark override, as one document" {
    val dark: Token[] = [.Bg.Color.Slate.900];
    val tokens: Token[] = [.Bg.Color.White, Token.Dark(dark)];
    val cls = emilia(tokens);
    val styles = await flushWith(bareOptions());
    assert styles
        == "<style>@layer theme, base, components, utilities;@layer utilities{."
            + cls
            + "{background-color:var(--color-white)}@media (prefers-color-scheme: dark){."
            + cls
            + "{background-color:var(--color-slate-900)}}}</style>";
}

test "end to end — a responsive, stateful button is one class and four rules" {
    val hover: Token[] = [.Bg.Color.Blue.700];
    val focus: Token[] = [.Text.Underline];
    val md: Token[] = [.Text.Size.Lg];
    val tokens: Token[] = [
        .Bg.Color.Blue.600,
        Token.Hover(hover),
        Token.FocusVisible(focus),
        Token.Md(md),
    ];
    val cls = emilia(tokens);
    val styles = await flushWith(bareOptions());
    assert styles
        == "<style>@layer theme, base, components, utilities;@layer utilities{."
            + cls
            + "{background-color:var(--color-blue-600)}."
            + cls
            + ":focus-visible{text-decoration-line:underline}@media (hover: hover){."
            + cls
            + ":hover{background-color:var(--color-blue-700)}}@media (width >= 48rem){."
            + cls
            + "{font-size:var(--text-lg);line-height:var(--text-lg--line-height)}}}</style>";
}

test "end to end — a peer-driven error message reaches its sibling" {
    val peer: Token[] = [.Bg.Color.Red.600];
    val tokens: Token[] = [.Layout.Hidden, Token.PeerInvalid(peer)];
    val cls = emilia(tokens);
    val styles = await flushWith(bareOptions());
    assert styles
        == "<style>@layer theme, base, components, utilities;@layer utilities{."
            + cls
            + "{display:none}."
            + cls
            + ":is(:where(.peer):invalid ~ *){background-color:var(--color-red-600)}}</style>";
}

//// ═══ END FRONT 34 ═════════════════════════════════════════════════════════════════

// ── front 38 — typography ────────────────────────────────────────────────────
//
// FRONT 38 OWNS EVERYTHING BETWEEN THIS BANNER AND ITS CLOSING ONE: the `Text`,
// `Font` and `List` sections of `tokens.bp` and the three dispatchers they
// reach, with their sub-dispatchers, their value tables and `typographyEntries()`.
//
// ITS RULE IS FRONTS 35/36/37's RULE ONE LEVEL UP: no leaf resolves a FONT
// SIZE, a LEADING, a TRACKING, a COLOUR or an INDENT. `Size` answers front 54's
// `--text-*` namespace as a PAIR (upstream's `text-lg` changes leading too, and
// emilia used to drop that half on the floor); `Tracking` and `Leading` answer
// `--tracking-*` / `--leading-*`; `Decoration.Color` answers front 33's
// `paletteVar`, so this front holds no colour table; `Indent` answers front
// 54's `spacing(n)`. The eighth `rem` ladder — `textSizeToCss`, the one front
// 35 and front 37 left because `Text.Size` is this front's — IS DELETED HERE,
// and with it the last resolved `rem` in the library.
//
// THREE THINGS EXISTING TOKENS NOW EMIT DIFFERENTLY, each because what they
// emitted was not what Tailwind v4.3 emits:
//
//   - `.Text.Size.*` was `font-size:1.125rem` and is now the `var(--text-lg)`
//     pair with its `--text-lg--line-height` (`§ 9.2`);
//   - `.Font.Sans` was the literal `ui-sans-serif,system-ui,sans-serif` stack
//     and is now `var(--font-sans)` (`§ 9.1`) — the stack itself moved into
//     `typographyEntries()`, so no value was lost;
//   - `.Text.Underline` / `.Text.LineThrough` were the `text-decoration`
//     SHORTHAND and are now `text-decoration-line` (`§ 9.17`), which is what
//     makes `underline` compose with `decoration-dotted` instead of
//     overwriting it.
//
// `.Text.Bold` is NOT one of them. `font-weight:bold` is emilia's own leaf and
// not a transcription of a Tailwind utility; it is pinned by six assertions in
// this file and this front leaves every one of them alone.

// The reference form of a font size: `§ 9.2` emits the size AND its paired
// line-height from one utility, and the pair is the whole point — a `text-lg`
// in Tailwind changes leading, and before this front an emilia `.Text.Size.Lg`
// did not. Written once, over front 54's `--text-*` namespace, so the thirteen
// arms below carry a NAME and never a value.
fn textSizeDecl(name: string) -> string {
    val base = nsPrefix(Ns.Text) + name;
    return "font-size:"
        + themeVar(base)
        + ";line-height:"
        + themeVar(base + "--line-height");
}

// `§ 9.10`'s four declarations, in the order the reference prints them. `None`
// is the RESET and not an omission — it has to undo all four.
fn lineClampDecl(n: string) -> string {
    return "overflow:hidden;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:"
        + n;
}

fn textTokenToCss(t: Token.Text, th: Theme) -> string {
    val out = case t {
        Bold -> "font-weight:bold";
        Italic -> "font-style:italic";
        Underline -> "text-decoration-line:underline";
        LineThrough -> "text-decoration-line:line-through";
        Left -> "text-align:left";
        Center -> "text-align:center";
        Right -> "text-align:right";
        Justify -> "text-align:justify";
        Size(_inner) -> textSizeToCss(_inner, th);
        Overline -> "text-decoration-line:overline";
        NoUnderline -> "text-decoration-line:none";
        Start -> "text-align:start";
        End -> "text-align:end";
        Truncate -> "overflow:hidden;text-overflow:ellipsis;white-space:nowrap";
        Tracking(_inner) -> textTrackingToCss(_inner, th);
        Leading(_inner) -> textLeadingToCss(_inner, th);
        Clamp(_inner) -> textClampToCss(_inner, th);
        Transform(_inner) -> textTransformToCss(_inner, th);
        Overflow(_inner) -> textOverflowToCss(_inner, th);
        Wrap(_inner) -> textWrapToCss(_inner, th);
        Decoration(_inner) -> textDecorationToCss(_inner, th);
        Whitespace(_inner) -> textWhitespaceToCss(_inner, th);
        Break(_inner) -> textBreakToCss(_inner, th);
        OverflowWrap(_inner) -> textOverflowWrapToCss(_inner, th);
        Hyphens(_inner) -> textHyphensToCss(_inner, th);
        Indent(_inner) -> textIndentToCss(_inner, th);
        Align(_inner) -> textAlignToCss(_inner, th);
        Tab(_inner) -> textTabToCss(_inner, th);
        Content(_inner) -> textContentToCss(_inner, th);
    };
    return out;
}

// `§ 9.2` and `§ 21.3`. Thirteen sizes, each a NAME handed to `textSizeDecl`:
// the values live in front 54's theme (`--text-xs` = `0.75rem` with
// `--text-xs--line-height` = `calc(1 / 0.75)`, `--text-5xl` = `3rem` with a
// bare `1`) and never here.
fn textSizeToCss(s: Token.Text.Size, th: Theme) -> string {
    val out = case s {
        Xs -> textSizeDecl("xs");
        Sm -> textSizeDecl("sm");
        Base -> textSizeDecl("base");
        Lg -> textSizeDecl("lg");
        Xl -> textSizeDecl("xl");
        X2xl -> textSizeDecl("2xl");
        X3xl -> textSizeDecl("3xl");
        X4xl -> textSizeDecl("4xl");
        X5xl -> textSizeDecl("5xl");
        X6xl -> textSizeDecl("6xl");
        X7xl -> textSizeDecl("7xl");
        X8xl -> textSizeDecl("8xl");
        X9xl -> textSizeDecl("9xl");
    };
    return out;
}

// `§ 9.9`. The six values are `typographyEntries()`'s; this reads the namespace.
fn textTrackingToCss(t: Token.Text.Tracking, th: Theme) -> string {
    val out = case t {
        Tighter -> "letter-spacing:"
            + themeVar(nsPrefix(Ns.Tracking) + "tighter");
        Tight -> "letter-spacing:" + themeVar(nsPrefix(Ns.Tracking) + "tight");
        Normal -> "letter-spacing:"
            + themeVar(nsPrefix(Ns.Tracking) + "normal");
        Wide -> "letter-spacing:" + themeVar(nsPrefix(Ns.Tracking) + "wide");
        Wider -> "letter-spacing:" + themeVar(nsPrefix(Ns.Tracking) + "wider");
        Widest -> "letter-spacing:"
            + themeVar(nsPrefix(Ns.Tracking) + "widest");
    };
    return out;
}

// `§ 9.11`. `None` is the ONE leaf here that is a literal and not a reference —
// the reference prints `leading-none` as `line-height: 1`, with no
// `--leading-none` entry behind it, so there is none to read.
fn textLeadingToCss(t: Token.Text.Leading, th: Theme) -> string {
    val out = case t {
        None -> "line-height:1";
        Tight -> "line-height:" + themeVar(nsPrefix(Ns.Leading) + "tight");
        Snug -> "line-height:" + themeVar(nsPrefix(Ns.Leading) + "snug");
        Normal -> "line-height:" + themeVar(nsPrefix(Ns.Leading) + "normal");
        Relaxed -> "line-height:" + themeVar(nsPrefix(Ns.Leading) + "relaxed");
        Loose -> "line-height:" + themeVar(nsPrefix(Ns.Leading) + "loose");
    };
    return out;
}

// `§ 9.10`. Four declarations from one token, and `None` undoes all four.
fn textClampToCss(t: Token.Text.Clamp, th: Theme) -> string {
    val out = case t {
        __1 -> lineClampDecl("1");
        __2 -> lineClampDecl("2");
        __3 -> lineClampDecl("3");
        __4 -> lineClampDecl("4");
        __5 -> lineClampDecl("5");
        __6 -> lineClampDecl("6");
        None -> "overflow:visible;display:block;-webkit-box-orient:horizontal;-webkit-line-clamp:none";
    };
    return out;
}

// `§ 9.22`. `None` is the CSS value; the Tailwind name is `normal-case`.
fn textTransformToCss(t: Token.Text.Transform, th: Theme) -> string {
    val out = case t {
        Uppercase -> "text-transform:uppercase";
        Lowercase -> "text-transform:lowercase";
        Capitalize -> "text-transform:capitalize";
        None -> "text-transform:none";
    };
    return out;
}

// `§ 9.23`, the two single-declaration rows. `truncate` is the third and is a
// bare leaf of `Text`, because it sets three properties and not this one.
fn textOverflowToCss(t: Token.Text.Overflow, th: Theme) -> string {
    val out = case t {
        Ellipsis -> "text-overflow:ellipsis";
        Clip -> "text-overflow:clip";
    };
    return out;
}

// `§ 9.24`.
fn textWrapToCss(t: Token.Text.Wrap, th: Theme) -> string {
    val out = case t {
        Wrap -> "text-wrap:wrap";
        Nowrap -> "text-wrap:nowrap";
        Balance -> "text-wrap:balance";
        Pretty -> "text-wrap:pretty";
    };
    return out;
}

// `§ 9.19`-`§ 9.21` plus `§ 9.18`. Upstream spells all four families with one
// `decoration-*` prefix (`decoration-2` and `decoration-red-500` are the same
// prefix carrying different kinds of value); the token tree separates them by
// sub-section, which is a deliberate divergence from the class naming and the
// only way a typed surface can tell a thickness from a colour.
fn textDecorationToCss(t: Token.Text.Decoration, th: Theme) -> string {
    val out = case t {
        Style(_inner) -> textDecorationStyleToCss(_inner, th);
        Thickness(_inner) -> textDecorationThicknessToCss(_inner, th);
        Offset(_inner) -> textDecorationOffsetToCss(_inner, th);
        Color(_inner) -> textDecorationColorToCss(_inner, th);
    };
    return out;
}

// `§ 9.19`.
fn textDecorationStyleToCss(
    t: Token.Text.Decoration.Style,
    th: Theme,
) -> string {
    val out = case t {
        Solid -> "text-decoration-style:solid";
        Double -> "text-decoration-style:double";
        Dotted -> "text-decoration-style:dotted";
        Dashed -> "text-decoration-style:dashed";
        Wavy -> "text-decoration-style:wavy";
    };
    return out;
}

// `§ 9.20`. The ladder stops at `4` because the reference stops at `4`; the
// 1.0.8 draft's `8` step is not declared, and would be a `px` literal this
// front has no reference row for.
fn textDecorationThicknessToCss(
    t: Token.Text.Decoration.Thickness,
    th: Theme,
) -> string {
    val out = case t {
        Auto -> "text-decoration-thickness:auto";
        FromFont -> "text-decoration-thickness:from-font";
        __0 -> "text-decoration-thickness:0px";
        __1 -> "text-decoration-thickness:1px";
        __2 -> "text-decoration-thickness:2px";
        __4 -> "text-decoration-thickness:4px";
    };
    return out;
}

// `§ 9.21`. `0` is `0px` and not `0`, which is what the reference prints.
fn textDecorationOffsetToCss(
    t: Token.Text.Decoration.Offset,
    th: Theme,
) -> string {
    val out = case t {
        Auto -> "text-underline-offset:auto";
        __0 -> "text-underline-offset:0px";
        __1 -> "text-underline-offset:1px";
        __2 -> "text-underline-offset:2px";
        __4 -> "text-underline-offset:4px";
    };
    return out;
}

// `§ 9.18`. THIS FRONT HOLDS NO COLOUR TABLE: every cell goes through front
// 33's `paletteVar(family, shade)`, so `decoration-red-500` and `text-red-500`
// reference ONE custom property and cannot drift. The two named colours read
// the theme the way front 33's `Color.White`/`Black` do; the three CSS-wide
// keywords have no theme entry and stay literal.
fn textDecorationColorToCss(
    t: Token.Text.Decoration.Color,
    th: Theme,
) -> string {
    val out = case t {
        Red(_inner) -> "text-decoration-color:"
            + paletteVar("red", decorationRedShade(_inner));
        Orange(_inner) -> "text-decoration-color:"
            + paletteVar("orange", decorationOrangeShade(_inner));
        Amber(_inner) -> "text-decoration-color:"
            + paletteVar("amber", decorationAmberShade(_inner));
        Yellow(_inner) -> "text-decoration-color:"
            + paletteVar("yellow", decorationYellowShade(_inner));
        Lime(_inner) -> "text-decoration-color:"
            + paletteVar("lime", decorationLimeShade(_inner));
        Green(_inner) -> "text-decoration-color:"
            + paletteVar("green", decorationGreenShade(_inner));
        Emerald(_inner) -> "text-decoration-color:"
            + paletteVar("emerald", decorationEmeraldShade(_inner));
        Teal(_inner) -> "text-decoration-color:"
            + paletteVar("teal", decorationTealShade(_inner));
        Cyan(_inner) -> "text-decoration-color:"
            + paletteVar("cyan", decorationCyanShade(_inner));
        Sky(_inner) -> "text-decoration-color:"
            + paletteVar("sky", decorationSkyShade(_inner));
        Blue(_inner) -> "text-decoration-color:"
            + paletteVar("blue", decorationBlueShade(_inner));
        Indigo(_inner) -> "text-decoration-color:"
            + paletteVar("indigo", decorationIndigoShade(_inner));
        Violet(_inner) -> "text-decoration-color:"
            + paletteVar("violet", decorationVioletShade(_inner));
        Purple(_inner) -> "text-decoration-color:"
            + paletteVar("purple", decorationPurpleShade(_inner));
        Fuchsia(_inner) -> "text-decoration-color:"
            + paletteVar("fuchsia", decorationFuchsiaShade(_inner));
        Pink(_inner) -> "text-decoration-color:"
            + paletteVar("pink", decorationPinkShade(_inner));
        Rose(_inner) -> "text-decoration-color:"
            + paletteVar("rose", decorationRoseShade(_inner));
        Slate(_inner) -> "text-decoration-color:"
            + paletteVar("slate", decorationSlateShade(_inner));
        Gray(_inner) -> "text-decoration-color:"
            + paletteVar("gray", decorationGrayShade(_inner));
        Zinc(_inner) -> "text-decoration-color:"
            + paletteVar("zinc", decorationZincShade(_inner));
        Neutral(_inner) -> "text-decoration-color:"
            + paletteVar("neutral", decorationNeutralShade(_inner));
        Stone(_inner) -> "text-decoration-color:"
            + paletteVar("stone", decorationStoneShade(_inner));
        Mauve(_inner) -> "text-decoration-color:"
            + paletteVar("mauve", decorationMauveShade(_inner));
        Olive(_inner) -> "text-decoration-color:"
            + paletteVar("olive", decorationOliveShade(_inner));
        Mist(_inner) -> "text-decoration-color:"
            + paletteVar("mist", decorationMistShade(_inner));
        Taupe(_inner) -> "text-decoration-color:"
            + paletteVar("taupe", decorationTaupeShade(_inner));
        White -> "text-decoration-color:"
            + themeVar(nsPrefix(Ns.Color) + "white");
        Black -> "text-decoration-color:"
            + themeVar(nsPrefix(Ns.Color) + "black");
        Transparent -> "text-decoration-color:transparent";
        Current -> "text-decoration-color:currentColor";
        Inherit -> "text-decoration-color:inherit";
    };
    return out;
}

fn decorationRedShade(s: Token.Text.Decoration.Color.Red) -> string {
    val out = case s {
        __50 -> "50";
        __100 -> "100";
        __200 -> "200";
        __300 -> "300";
        __400 -> "400";
        __500 -> "500";
        __600 -> "600";
        __700 -> "700";
        __800 -> "800";
        __900 -> "900";
        __950 -> "950";
    };
    return out;
}

