// `ring-offset-*` IS A V3 CARRY-OVER: v4's documentation no longer carries the
// family at all. It is declared because the front's README specifies it and
// its acceptance asks that `Ring.Offset.Color` go through `paletteVar`; it is
// recorded as unverified rather than quietly dropped.
fn ringOffsetToCss(o: Token.Ring.Offset, th: Theme) -> string {
    val out = case o {
        W(_inner) -> ringOffsetDecls(ringOffsetWidthValue(_inner));
        Color(_inner) -> ringOffsetColorToCss(_inner, th);
    };
    return out;
}

fn ringOffsetWidthValue(s: Token.Ring.Offset.W) -> string {
    val out = case s {
        __0 -> "0px";
        __1 -> "1px";
        __2 -> "2px";
        __4 -> "4px";
        __8 -> "8px";
    };
    return out;
}

fn ringOffsetColorToCss(c: Token.Ring.Offset.Color, th: Theme) -> string {
    val out = case c {
        Red(_inner) -> "--tw-ring-offset-color:"
            + paletteVar("red", ringOffsetColorRedShade(_inner));
        Orange(_inner) -> "--tw-ring-offset-color:"
            + paletteVar("orange", ringOffsetColorOrangeShade(_inner));
