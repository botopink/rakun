// A SIDE FORM IS TWO CORNERS AND A CORNER FORM IS ONE. The logical eight
// (`S`/`E`/`Ss`/`Se`/`Es`/`Ee`) follow the writing direction where the
// physical four do not — `border-start-start-radius` is to `Tl` what
// `padding-inline-start` is to `padding-left`.
//
// `Sm`, `Md` and `Lg` CHANGE WHAT THEY EMIT — from a literal `rem` to
// `var(--radius-*)`. `Full` does not, because upstream prints `rounded-full`
// as the literal `9999px`, and `None` does not, for the same reason.
fn borderRoundedToCss(r: Token.Border.Rounded, th: Theme) -> string {
    val out = case r {
        None -> "border-radius:0";
        Xs -> oneDecl("border-radius", radiusVar("xs"));
        Sm -> oneDecl("border-radius", radiusVar("sm"));
        Md -> oneDecl("border-radius", radiusVar("md"));
        Lg -> oneDecl("border-radius", radiusVar("lg"));
        Xl -> oneDecl("border-radius", radiusVar("xl"));
        X2xl -> oneDecl("border-radius", radiusVar("2xl"));
        X3xl -> oneDecl("border-radius", radiusVar("3xl"));
        X4xl -> oneDecl("border-radius", radiusVar("4xl"));
        Full -> "border-radius:9999px";
        T(_inner) -> axisDecl(
            "border-top-left-radius",
            "border-top-right-radius",
            borderRoundedTValue(_inner),
        );
        R(_inner) -> axisDecl(
            "border-top-right-radius",
            "border-bottom-right-radius",
            borderRoundedRValue(_inner),
        );
        B(_inner) -> axisDecl(
            "border-bottom-right-radius",
            "border-bottom-left-radius",
            borderRoundedBValue(_inner),
        );
        L(_inner) -> axisDecl(
            "border-top-left-radius",
            "border-bottom-left-radius",
            borderRoundedLValue(_inner),
        );
        Tl(_inner) -> oneDecl(
            "border-top-left-radius",
            borderRoundedTlValue(_inner),
        );
        Tr(_inner) -> oneDecl(
            "border-top-right-radius",
            borderRoundedTrValue(_inner),
        );
        Br(_inner) -> oneDecl(
            "border-bottom-right-radius",
            borderRoundedBrValue(_inner),
        );
        Bl(_inner) -> oneDecl(
            "border-bottom-left-radius",
            borderRoundedBlValue(_inner),
        );
        S(_inner) -> axisDecl(
            "border-start-start-radius",
            "border-end-start-radius",
            borderRoundedSValue(_inner),
        );
        E(_inner) -> axisDecl(
            "border-start-end-radius",
            "border-end-end-radius",
            borderRoundedEValue(_inner),
        );
        Ss(_inner) -> oneDecl(
            "border-start-start-radius",
            borderRoundedSsValue(_inner),
        );
        Se(_inner) -> oneDecl(
            "border-start-end-radius",
            borderRoundedSeValue(_inner),
        );
        Es(_inner) -> oneDecl(
            "border-end-start-radius",
            borderRoundedEsValue(_inner),
        );
        Ee(_inner) -> oneDecl(
            "border-end-end-radius",
            borderRoundedEeValue(_inner),
        );
    };
    return out;
}

fn borderRoundedTValue(r: Token.Border.Rounded.T) -> string {
    val out = case r {
        None -> "0";
        Xs -> radiusVar("xs");
        Sm -> radiusVar("sm");
        Md -> radiusVar("md");
        Lg -> radiusVar("lg");
        Xl -> radiusVar("xl");
        X2xl -> radiusVar("2xl");
        X3xl -> radiusVar("3xl");
        X4xl -> radiusVar("4xl");
        Full -> "9999px";
    };
    return out;
}

