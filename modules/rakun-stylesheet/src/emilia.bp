// `outline-none` IS THE TRAP IN THIS FAMILY. Upstream prints it as two
// declarations of the SHORTHAND and an offset — a TRANSPARENT outline rather
// than an absent one, so a high-contrast mode still shows it — and never as
// `outline-style:none`. The token lives under `Style` because that is where
// upstream puts it; only the emission is special.
fn outlineTokenToCss(t: Token.Outline, th: Theme) -> string {
    val out = case t {
        W(_inner) -> oneDecl("outline-width", outlineWidthValue(_inner));
        Style(_inner) -> outlineStyleToCss(_inner);
        Color(_inner) -> outlineColorToCss(_inner, th);
        Offset(_inner) -> outlineOffsetToCss(_inner);
    };
    return out;
}

fn outlineWidthValue(s: Token.Outline.W) -> string {
    val out = case s {
        __0 -> "0px";
        __1 -> "1px";
        __2 -> "2px";
        __4 -> "4px";
        __8 -> "8px";
    };
    return out;
}

fn outlineStyleToCss(s: Token.Outline.Style) -> string {
    val out = case s {
        Solid -> "outline-style:solid";
        Dashed -> "outline-style:dashed";
        Dotted -> "outline-style:dotted";
        Double -> "outline-style:double";
        None -> "outline:2px solid transparent;outline-offset:2px";
    };
    return out;
}

fn outlineColorToCss(c: Token.Outline.Color, th: Theme) -> string {
    val out = case c {
        Red(_inner) -> "outline-color:"
            + paletteVar("red", outlineColorRedShade(_inner));
        Orange(_inner) -> "outline-color:"
            + paletteVar("orange", outlineColorOrangeShade(_inner));
        Amber(_inner) -> "outline-color:"
            + paletteVar("amber", outlineColorAmberShade(_inner));
        Yellow(_inner) -> "outline-color:"
            + paletteVar("yellow", outlineColorYellowShade(_inner));
        Lime(_inner) -> "outline-color:"
            + paletteVar("lime", outlineColorLimeShade(_inner));
        Green(_inner) -> "outline-color:"
            + paletteVar("green", outlineColorGreenShade(_inner));
        Emerald(_inner) -> "outline-color:"
            + paletteVar("emerald", outlineColorEmeraldShade(_inner));
        Teal(_inner) -> "outline-color:"
            + paletteVar("teal", outlineColorTealShade(_inner));
        Cyan(_inner) -> "outline-color:"
            + paletteVar("cyan", outlineColorCyanShade(_inner));
        Sky(_inner) -> "outline-color:"
            + paletteVar("sky", outlineColorSkyShade(_inner));
        Blue(_inner) -> "outline-color:"
            + paletteVar("blue", outlineColorBlueShade(_inner));
        Indigo(_inner) -> "outline-color:"
            + paletteVar("indigo", outlineColorIndigoShade(_inner));
        Violet(_inner) -> "outline-color:"
            + paletteVar("violet", outlineColorVioletShade(_inner));
        Purple(_inner) -> "outline-color:"
            + paletteVar("purple", outlineColorPurpleShade(_inner));
        Fuchsia(_inner) -> "outline-color:"
            + paletteVar("fuchsia", outlineColorFuchsiaShade(_inner));
        Pink(_inner) -> "outline-color:"
            + paletteVar("pink", outlineColorPinkShade(_inner));
        Rose(_inner) -> "outline-color:"
            + paletteVar("rose", outlineColorRoseShade(_inner));
        Slate(_inner) -> "outline-color:"
            + paletteVar("slate", outlineColorSlateShade(_inner));
        Gray(_inner) -> "outline-color:"
            + paletteVar("gray", outlineColorGrayShade(_inner));
        Zinc(_inner) -> "outline-color:"
            + paletteVar("zinc", outlineColorZincShade(_inner));
        Neutral(_inner) -> "outline-color:"
            + paletteVar("neutral", outlineColorNeutralShade(_inner));
        Stone(_inner) -> "outline-color:"
            + paletteVar("stone", outlineColorStoneShade(_inner));
        Mauve(_inner) -> "outline-color:"
            + paletteVar("mauve", outlineColorMauveShade(_inner));
        Olive(_inner) -> "outline-color:"
            + paletteVar("olive", outlineColorOliveShade(_inner));
        Mist(_inner) -> "outline-color:"
            + paletteVar("mist", outlineColorMistShade(_inner));
        Taupe(_inner) -> "outline-color:"
            + paletteVar("taupe", outlineColorTaupeShade(_inner));
        White -> "outline-color:" + themeVar(nsPrefix(Ns.Color) + "white");
        Black -> "outline-color:" + themeVar(nsPrefix(Ns.Color) + "black");
        Transparent -> "outline-color:transparent";
        Current -> "outline-color:currentColor";
        Inherit -> "outline-color:inherit";
    };
    return out;
}

