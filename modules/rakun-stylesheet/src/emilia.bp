// NO HEX, NO `rem`, and every leaf well-formed. The probe takes a STRING and
// its control is a hand-built declaration that must fail it.
fn f46CarriesNoLiteral(decl: string) -> bool {
    return decl.indexOf("#") == -1
        && decl.indexOf("oklch(") == -1
        && decl.indexOf("rgb(") == -1
        && decl.indexOf("rem") == -1
        && decl.indexOf("px") == -1;
}

test "front 46 — 161 leaves, every one well-formed, none resolving a length or a colour" {
    val decls = f46AllLeaves().map({ t -> tokenDeclarations(t) });
    assert decls.length == 161;
    assert decls.filter({ d -> d == "" || d.indexOf(":") == -1 }).length == 0;
    assert decls.filter({ d -> !f46CarriesNoLiteral(d) }).length == 0;
    assert f46CarriesNoLiteral("accent-color:oklch(51.1% 0.262 276.966)")
        == false;
    assert f46CarriesNoLiteral("scroll-margin-top:1rem") == false;
}

test "Interact — the class name is a literal, and both targets must agree" {
    val tokens: Token[] = [
        .Interact.Cursor.Grab,
        .Interact.Select.None,
        .Interact.Snap.Type.X,
    ];
    assert emiliaWith(tokens, defaultTheme()) == "e_7c211aa7";
}
// ── end front 46 ─────────────────────────────────────────────────────────────

// ── front 47 — svg and accessibility ─────────────────────────────────────────
//
// FRONT 47 OWNS EVERYTHING BETWEEN THIS BANNER AND ITS CLOSING ONE: the `Svg`
// and `A11y` dispatchers, the three payload wrappers and the tests under the
// same name.
//
// TWO VALUES ARE DERIVED, NOT TRANSCRIBED: `fill-current` / `stroke-current`
// are `currentcolor`, the one CSS value the suffix `current` can abbreviate
// (and upstream's own resolution of the colour `current`).
//
// THE `sr-only` GATE IS CLOSED. `§ 19.2` prints no CSS for either row, so the
// two bodies below were read from upstream on 2026-09-26 —
// https://github.com/tailwindlabs/tailwindcss/blob/main/packages/tailwindcss/src/utilities.ts
// (`staticUtility('sr-only', …)` / `staticUtility('not-sr-only', …)`) — and
// are pasted in upstream's declaration order. `not-sr-only` restores EIGHT of
// the nine properties: upstream leaves `border-width` alone, and so does this
// front, so a `NotSrOnly` over a bordered element keeps `sr-only`'s `0`.

fn svgFillToCss(f: Token.Svg.Fill) -> string {
    val out = case f {
        Current -> "fill:currentcolor";
        None -> "fill:none";
    };
    return out;
}

fn svgStrokeToCss(f: Token.Svg.Stroke) -> string {
    val out = case f {
        Current -> "stroke:currentcolor";
        None -> "stroke:none";
    };
    return out;
}

fn svgStrokeWidthToCss(w: Token.Svg.StrokeWidth) -> string {
    val out = case w {
        __0 -> "stroke-width:0";
        __1 -> "stroke-width:1";
        __2 -> "stroke-width:2";
    };
    return out;
}

// `§ 18`. `th` is the contract `§ 4a` parameter; nothing here reads it.
fn svgTokenToCss(t: Token.Svg, th: Theme) -> string {
    val out = case t {
        Fill(_inner) -> svgFillToCss(_inner);
        Stroke(_inner) -> svgStrokeToCss(_inner);
        StrokeWidth(_inner) -> svgStrokeWidthToCss(_inner);
    };
    return out;
}

fn srOnlyBody() -> string {
    val decls: string[] = [
        "position:absolute",
        "width:1px",
        "height:1px",
        "padding:0",
        "margin:-1px",
        "overflow:hidden",
        "clip-path:inset(50%)",
        "white-space:nowrap",
        "border-width:0",
    ];
    return decls.join(";");
}

fn notSrOnlyBody() -> string {
    val decls: string[] = [
        "position:static",
        "width:auto",
        "height:auto",
        "padding:0",
        "margin:0",
        "overflow:visible",
        "clip-path:none",
        "white-space:normal",
    ];
    return decls.join(";");
}

fn a11yForcedColorAdjustToCss(f: Token.A11y.ForcedColorAdjust) -> string {
    val out = case f {
        Auto -> "forced-color-adjust:auto";
        None -> "forced-color-adjust:none";
    };
    return out;
}

// `§ 19`. `sr-only` is a `;`-joined declaration string on the element's OWN
// class — it needs no selector outside it, so this stays the ordinary form.
fn a11yTokenToCss(t: Token.A11y, th: Theme) -> string {
    val out = case t {
        SrOnly -> srOnlyBody();
        NotSrOnly -> notSrOnlyBody();
        ForcedColorAdjust(_inner) -> a11yForcedColorAdjustToCss(_inner);
    };
    return out;
}

// The wrappers a typed list needs; each colour takes a `paletteVar` result.
pub fn fillColor(value: string) -> Token {
    return Token.SvgFill(value: value);
}

pub fn strokeColor(value: string) -> Token {
    return Token.SvgStroke(value: value);
}

pub fn rawStrokeWidth(value: string) -> Token {
    return Token.SvgStrokeWidthRaw(value: value);
}

// ── front 47 · tests ─────────────────────────────────────────────────────────

// `currentcolor` is DERIVED from the class suffix, not transcribed — the line
// to doubt if upstream ever disagrees.
test "Svg.Fill / Svg.Stroke — currentcolor and none" {
    assert tokenDeclarations(.Svg.Fill.Current) == "fill:currentcolor";
    assert tokenDeclarations(.Svg.Fill.None) == "fill:none";
    assert tokenDeclarations(.Svg.Stroke.Current) == "stroke:currentcolor";
    assert tokenDeclarations(.Svg.Stroke.None) == "stroke:none";
}

test "Svg.StrokeWidth — unitless, and zero is not none" {
    assert tokenDeclarations(.Svg.StrokeWidth.__0) == "stroke-width:0";
    assert tokenDeclarations(.Svg.StrokeWidth.__1) == "stroke-width:1";
    assert tokenDeclarations(.Svg.StrokeWidth.__2) == "stroke-width:2";
    assert tokenDeclarations(.Svg.StrokeWidth.__2).indexOf("px") == -1;
    assert tokenDeclarations(.Svg.Stroke.None) == "stroke:none";
}

test "SvgFill / SvgStroke / SvgStrokeWidthRaw — construct and emit" {
    val f = Token.SvgFill(value: paletteVar("red", "500"));
    assert tokenDeclarations(f) == "fill:var(--color-red-500)";
    val s = Token.SvgStroke(value: paletteVar("blue", "500"));
    assert tokenDeclarations(s) == "stroke:var(--color-blue-500)";
    val w = Token.SvgStrokeWidthRaw(value: "3");
    assert tokenDeclarations(w) == "stroke-width:3";
    assert tokenDeclarations(fillColor(paletteVar("emerald", "600")))
        == "fill:var(--color-emerald-600)";
    assert tokenDeclarations(strokeColor(paletteVar("slate", "900")))
        == "stroke:var(--color-slate-900)";
    assert tokenDeclarations(rawStrokeWidth("1.5")) == "stroke-width:1.5";
}

// The gated pair, asserted WHOLE — a later "tidy" of either body fails here.
test "A11y.SrOnly / NotSrOnly — upstream's bodies, whole" {
    assert tokenDeclarations(.A11y.SrOnly)
        == "position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border-width:0";
    assert tokenDeclarations(.A11y.NotSrOnly)
        == "position:static;width:auto;height:auto;padding:0;margin:0;overflow:visible;clip-path:none;white-space:normal";
}

// Side by side: `not-sr-only` names every property `sr-only` sets but the
// last, `border-width`, which upstream does not restore.
test "A11y.NotSrOnly — restores eight of sr-only's nine properties, as upstream" {
    val setProps = srOnlyBody()
        .split(";")
        .map({ d -> d.split(":").at(0) ?? "" });
    val undoneProps = notSrOnlyBody()
        .split(";")
        .map({ d -> d.split(":").at(0) ?? "" });
    assert setProps.length == 9;
    assert undoneProps.length == 8;
    assert setProps.filter({ p -> p != "border-width" }).join(",")
        == undoneProps.join(",");
}

test "A11y.ForcedColorAdjust — the two rows of `§ 19.1`" {
    assert tokenDeclarations(.A11y.ForcedColorAdjust.Auto)
        == "forced-color-adjust:auto";
    assert tokenDeclarations(.A11y.ForcedColorAdjust.None)
        == "forced-color-adjust:none";
}

// The close button's glyph: three properties, list order kept.
test "Svg — a stroked glyph composes in list order" {
    val tokens: Token[] = [
        .Svg.Stroke.Current,
        .Svg.StrokeWidth.__2,
        .Svg.Fill.None,
    ];
    val decls = declarationsOf(tokensToSheet(tokens, defaultTheme()));
    assert decls.join(";") == "stroke:currentcolor;stroke-width:2;fill:none";
}

test "SvgFill — a fill under Hover reaches front 34's variant" {
    val inner: Token[] = [Token.SvgFill(value: paletteVar("red", "500"))];
    val outer: Token[] = [Token.Hover(inner)];
    val s = tokensToSheet(outer, defaultTheme());
    assert declarationsOf(s).join(";") == "fill:var(--color-red-500)";
    assert firstRuleOf(s).selector == "&:hover";
}

// NO HEX: every leaf and every palette payload, walked; the control is not a
// hex either (the front's rule is that none appears in its tests).
test "front 47 — 11 leaves and two palette payloads well-formed, no resolved colour" {
    val leaves: Token[] = [
        .Svg.Fill.Current,
        .Svg.Fill.None,
        .Svg.Stroke.Current,
        .Svg.Stroke.None,
        .Svg.StrokeWidth.__0,
        .Svg.StrokeWidth.__1,
        .Svg.StrokeWidth.__2,
        .A11y.SrOnly,
        .A11y.NotSrOnly,
        .A11y.ForcedColorAdjust.Auto,
        .A11y.ForcedColorAdjust.None,
        Token.SvgFill(value: paletteVar("red", "500")),
        Token.SvgStroke(value: paletteVar("blue", "500")),
    ];
    val decls = leaves.map({ t -> tokenDeclarations(t) });
    assert decls.filter({ d -> d == "" || d.indexOf(":") == -1 }).length == 0;
    assert decls.filter(
        { d -> d.indexOf("#") != -1 || d.indexOf("oklch(") != -1 || d.indexOf("rgb(") != -1 },
    ).length
        == 0;
    assert "fill:oklch(63.7% 0.237 25.331)".indexOf("oklch(") != -1;
}

test "Svg / A11y — the class name is a literal, and both targets must agree" {
    val tokens: Token[] = [
        .Svg.Stroke.Current,
        .Svg.StrokeWidth.__2,
        .A11y.SrOnly,
    ];
    assert emiliaWith(tokens, defaultTheme()) == "e_4c10c0b1";
}
// ── end front 47 ─────────────────────────────────────────────────────────────

// ── front 57 — escape hatches ────────────────────────────────────────────────
//
// The six `Arb*` arms of `tokenToSheet` dispatch to `arbitrary.bp`, which owns
// the builders, the validators and the helpers; these are the rendering tests,
// which need `tokensToSheet` and so live here. The refusal tests live in
// `arbitrary.bp`.

fn f57Doc(tokens: Token[]) -> string {
    return renderDocument(
        "e_x\t" + encodeSheet(tokensToSheet(tokens, defaultTheme())),
        bareOptions(),
    );
}

test "Arb — `§ 3.1`'s `bg-[#316ff6]` row, as a known property with an arbitrary value" {
    val tokens: Token[] = [arbValue("background-color", "#316ff6")];
    assert f57Doc(tokens)
        == "<style>@layer theme, base, components, utilities;@layer utilities{.e_x{background-color:#316ff6}}</style>";
}

test "ArbProp — `§ 3.1`'s `[--gutter-width:1rem]` row, an arbitrary property" {
    val tokens: Token[] = [arbProp("--gutter-width", "1rem")];
    assert f57Doc(tokens).indexOf(".e_x{--gutter-width:1rem}") != -1;
}

test "ArbVariant — `§ 3.2`'s `[&.is-dragging]:` row, a sibling rule with the class for `&`" {
    val inner: Token[] = [.Interact.Cursor.Grabbing];
    val tokens: Token[] = [
        .Interact.Cursor.Grab,
        arbSel("&.is-dragging", inner),
    ];
    val doc = f57Doc(tokens);
    assert doc.indexOf(".e_x{cursor:grab}") != -1;
    assert doc.indexOf(".e_x.is-dragging{cursor:grabbing}") != -1;
    assert doc.indexOf(".e_x{cursor:grab}") < doc.indexOf(".e_x.is-dragging{");
}

test "ArbAt — `§ 3.2`'s `[@supports(display:grid)]:` row, the at-rule emilia prefixes" {
    val inner: Token[] = [.Layout.Grid];
    val tokens: Token[] = [arbAt("supports(display:grid)", inner)];
    assert f57Doc(tokens).indexOf("@supports(display:grid){.e_x{display:grid}}")
        != -1;
}

test "ArbMin / ArbMax — `§ 3.3`'s `min-[320px]:` and `max-[600px]:`, hoisted" {
    val inner: Token[] = [.Text.Bold];
    val min: Token[] = [arbMin("320px", inner)];
    val max: Token[] = [arbMax("600px", inner)];
    assert f57Doc(min)
        == "<style>@layer theme, base, components, utilities;@layer utilities{@media (width >= 320px){.e_x{font-weight:bold}}}</style>";
    assert f57Doc(max).indexOf("@media (width < 600px){.e_x{font-weight:bold}}")
        != -1;
}

// COMPOSITION, both orders: the outer modifier is outermost.
test "ArbVariant inside Md — the media query wraps the arbitrary selector" {
    val inner: Token[] = [.Text.Bold];
    val arb: Token[] = [arbSel("&.is-active", inner)];
    val tokens: Token[] = [Token.Md(arb)];
    assert f57Doc(tokens).indexOf(
        "@media (width >= 48rem){.e_x.is-active{font-weight:bold}}",
    )
        != -1;
    val md: Token[] = [Token.Md(inner)];
    val outer: Token[] = [arbSel("&.is-active", md)];
    assert f57Doc(outer).indexOf(
        "@media (width >= 48rem){.e_x.is-active{font-weight:bold}}",
    )
        != -1;
    val hover: Token[] = [Token.Hover(inner)];
    val dragged: Token[] = [arbSel("&.is-dragging", hover)];
    assert f57Doc(dragged).indexOf(".e_x.is-dragging:hover{font-weight:bold}")
        != -1;
}

// THE THEME INTERACTION: an arbitrary value reaches back into the theme by
// concatenation, and `calc(` / `var(` trip no reject set.
test "Arb — a value built from spacing() and themeVar() needs no validator change" {
    val a = arbValue("max-height", "calc(100dvh - " + spacing(6) + ")");
    assert tokenDeclarations(a)
        == "max-height:calc(100dvh - calc(var(--spacing) * 6))";
    val b = arbValue("color", themeVar("--color-brand"));
    assert tokenDeclarations(b) == "color:var(--color-brand)";
}

test "Arb — the class name is a literal, and both targets must agree" {
    val inner: Token[] = [.Text.Bold];
    val tokens: Token[] = [
        arbValue("background-color", "#316ff6"),
        arbMin("320px", inner),
    ];
    assert emiliaWith(tokens, defaultTheme()) == "e_5f5d2f44";
}
// ── end front 57 ─────────────────────────────────────────────────────────────

// ── front 58 — container queries ─────────────────────────────────────────────
//
// The four `Container*` arms dispatch to `container.bp`; these are the
// rendering tests, which need `tokensToSheet`.

test "Container — the three `container-type` markers, each alone" {
    val a: Token[] = [.Container.Inline];
    val b: Token[] = [.Container.Normal];
    val c: Token[] = [.Container.Size];
    assert f57Doc(a).indexOf(".e_x{container-type:inline-size}") != -1;
    assert f57Doc(b).indexOf(".e_x{container-type:normal}") != -1;
    assert f57Doc(c).indexOf(".e_x{container-type:size}") != -1;
}

test "ContainerNamed — one rule, the type then the name" {
    val tokens: Token[] = [containerName("main")];
    assert f57Doc(tokens).indexOf(
        ".e_x{container-type:inline-size;container-name:main}",
    )
        != -1;
}

test "ContainerAt — `@md:` is a hoisted `@container (width >= 28rem)` rule" {
    val inner: Token[] = [.Flex.Row];
    val tokens: Token[] = [containerAtMd(inner)];
    assert f57Doc(tokens)
        == "<style>@layer theme, base, components, utilities;@layer utilities{@container (width >= 28rem){.e_x{flex-direction:row}}}</style>";
}

test "ContainerAtNamed — `@sm/main:`, and a named and an unnamed query are two rules" {
    val inner: Token[] = [.Text.Bold];
    // `ContainerSize` is NOT imported here: an imported enum with an `Sm`
    // variant makes `Token.Sm(…)` elsewhere in this module resolve to it
    // (compiler finding, see AGENTS.md). `container.bp` tests the builder.
    val named = Token.ContainerAtNamed(size: "sm", name: "main", inner: inner);
    val tokens: Token[] = [named, containerAtSm(inner)];
    val doc = f57Doc(tokens);
    assert doc.indexOf(
        "@container main (width >= 24rem){.e_x{font-weight:bold}}",
    )
        != -1;
    assert doc.indexOf("@container (width >= 24rem){.e_x{font-weight:bold}}")
        != -1;
}

// THE ORDER IS PINNED, BOTH WAYS: the outer modifier's at-rule is outermost.
test "ContainerAt — nests with a breakpoint in both orders, and with a state" {
    val inner: Token[] = [.Text.Bold];
    val cq: Token[] = [containerAtSm(inner)];
    val md: Token[] = [Token.Md(inner)];
    assert f57Doc([Token.Md(cq)]).indexOf(
        "@media (width >= 48rem){@container (width >= 24rem){.e_x{font-weight:bold}}}",
    )
        != -1;
    assert f57Doc([containerAtSm(md)]).indexOf(
        "@container (width >= 24rem){@media (width >= 48rem){.e_x{font-weight:bold}}}",
    )
        != -1;
    assert f57Doc([Token.Hover(cq)]).indexOf(
        "@container (width >= 24rem){.e_x:hover{font-weight:bold}}",
    )
        != -1;
}

test "ContainerAt — wraps a front 57 arbitrary selector with no special case" {
    val inner: Token[] = [.Text.Bold];
    val arb: Token[] = [arbSel("&.is-open", inner)];
    assert f57Doc([containerAtSm(arb)]).indexOf(
        "@container (width >= 24rem){.e_x.is-open{font-weight:bold}}",
    )
        != -1;
}

// THE PAIR: a container with no query does nothing and a query with no
// container matches nothing — the parent and the child in one document.
test "Container — the parent and the child land in one utilities layer" {
    val drained = await flushWith(bareOptions());
    assert drained.startsWith("<style>");
    val parentTokens: Token[] = [.Container.Inline];
    val childInner: Token[] = [.Flex.Row];
    val childTokens: Token[] = [.Flex.Col, containerAtMd(childInner)];
    val parent = emilia(parentTokens);
    val child = emilia(childTokens);
    val doc = await flushWith(bareOptions());
    val body = doc.split("@layer utilities{").at(1) ?? "";
    assert body.indexOf("." + parent + "{container-type:inline-size}") != -1;
    assert body.indexOf(
        "@container (width >= 28rem){." + child + "{flex-direction:row}}",
    )
        != -1;
}

test "Container — the class name is a literal, and both targets must agree" {
    val inner: Token[] = [.Flex.Row];
    val tokens: Token[] = [.Container.Inline, containerAtMd(inner)];
    assert emiliaWith(tokens, defaultTheme()) == "e_ea3f0f2e";
}
// ── end front 58 ─────────────────────────────────────────────────────────────

// ── front 55 · tests that flush a real document ────────────────────────────
//
// Here rather than in `preflight.bp`: a sibling module importing `from
// "emilia"` does not resolve when emilia is a dependency.

test "preflight — Border.W.1 lands after the zero-width solid base rule" {
    val drained = await flushWith(bareOptions());
    assert drained.startsWith("<style>");
    val tokens: Token[] = [.Border.W.__1];
    val cls = emiliaWith(tokens, emptyTheme());
    val doc = await flushWith(withBase(bareOptions(), preflightRules()));
    val reset = doc.indexOf("border-width:0;border-style:solid");
    assert reset != -1;
    assert reset < doc.indexOf("." + cls + "{border-width:1px}");
}

// The difference the reset makes, recorded rather than assumed.
test "preflight — without it, the same class carries no border-style at all" {
    val drained = await flushWith(bareOptions());
    assert drained.startsWith("<style>");
    val tokens: Token[] = [.Border.W.__1];
    val cls = emiliaWith(tokens, emptyTheme());
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("." + cls + "{border-width:1px}") != -1;
    assert doc.indexOf("border-style") == -1;
}

// ── step 3 · the pseudo-element precondition ─────────────────────────────────

test "preflight — ::before,::after{content:\"\"} precedes the utilities" {
    val drained = await flushWith(bareOptions());
    assert drained.startsWith("<style>");
    val inner: Token[] = [.Text.Content.Empty];
    val tokens: Token[] = [Token.Before(inner)];
    val cls = emiliaWith(tokens, emptyTheme());
    val doc = await flushWith(withBase(bareOptions(), preflightRules()));
    val base = doc.indexOf("::before,::after{content:\"\"}");
    assert base != -1;
    assert base < doc.indexOf("@layer utilities");
    assert doc.indexOf("." + cls + "::before") > base;
}

// ── end front 55 tests ─────────────────────────────────────────────────────

// ── front 59 · tests ─────────────────────────────────────────────────────────
//
// The rendering half of front 59's tests: they need `emilia`, `flushWith` and
// `styleRule`, which `compose.bp` cannot import.

fn f59Bold() -> Token[] {
    val out: Token[] = [.Text.Bold];
    return out;
}

fn btn() -> Token[] {
    val out: Token[] = [.Pad.X.__4, .Pad.Y.__2, .Border.Rounded.Md];
    return out;
}

fn redBg() -> Token[] {
    val out: Token[] = [.Bg.Color.Red.__500];
    return out;
}

fn blueBg() -> Token[] {
    val out: Token[] = [.Bg.Color.Blue.__500];
    return out;
}

// `§ 20.4`'s `@utility scrollbar-hidden` body, declaration for declaration.
test "scrollbarHidden — `§ 20.4`'s body: scrollbar-width and the webkit pseudo-element" {
    val drained = await flushWith(bareOptions());
    assert drained.startsWith("<style>");
    val cls = emilia(scrollbarHidden());
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("." + cls + "{scrollbar-width:none}") != -1;
    assert doc.indexOf("." + cls + "::-webkit-scrollbar{display:none}") != -1;
}

test "append — the bundle's declarations, then the extra ones, in that order" {
    val drained = await flushWith(bareOptions());
    assert drained.startsWith("<style>");
    val cls = emilia(btn().append(redBg()));
    val doc = await flushWith(bareOptions());
    val pad = doc.indexOf("padding-left:");
    val bg = doc.indexOf("background-color:var(--color-red-500)");
    assert pad != -1;
    assert bg > pad;
    assert cls.startsWith("e_");
}

test "compose — equals chained append by class, and [] is the empty class" {
    val a = compose([btn(), redBg(), f59Bold()]);
    val b = btn().append(redBg()).append(f59Bold());
    assert styleRule(a, defaultTheme())._0 == styleRule(b, defaultTheme())._0;
    val none: Token[][] = [];
    val empty: Token[] = [];
    assert styleRule(compose(none), defaultTheme())._0
        == styleRule(empty, defaultTheme())._0;
}

// `§ 3.1`: the last rule wins, so the later bundle's colour is emitted second.
test "compose — two bundles on one property: the later one is emitted second (`§ 3.1`)" {
    val decls = decodeSheet(
        styleRule(compose([redBg(), blueBg()]), defaultTheme())._1,
    ).rules.map({ r -> r.declarations });
    assert decls.join("|")
        == "background-color:var(--color-red-500)|background-color:var(--color-blue-500)";
}

test "hocus — `§ 20.3`: two rules, :hover and :focus, one body" {
    val drained = await flushWith(bareOptions());
    assert drained.startsWith("<style>");
    val cls = emilia(hocus(f59Bold()));
    val doc = await flushWith(bareOptions());
    assert doc.indexOf(
        "@media (hover: hover){." + cls + ":hover{font-weight:bold}}",
    )
        != -1;
    assert doc.indexOf("." + cls + ":focus{font-weight:bold}") != -1;
}

test "a custom variant composes with a built-in one, both orders" {
    val midInMd: Token[] = [Token.Md(themeMidnight(f59Bold()))];
    val mdInMid = themeMidnight([Token.Md(f59Bold())]);
    val a = decodeSheet(styleRule(midInMd, defaultTheme())._1).rules.at(0);
    val b = decodeSheet(styleRule(mdInMid, defaultTheme())._1).rules.at(0);
    if (a == null || b == null) {
        assert false;
        return;
    }
    assert a.selector == "&:where([data-theme=\"midnight\"] *)";
    assert a.atRules.join(",") == "@media (width >= 48rem)";
    assert b.selector == a.selector;
    assert b.atRules.join(",") == a.atRules.join(",");
}

test "selector — an arbitrary Variant, with the class substituted for `&`" {
    val drained = await flushWith(bareOptions());
    assert drained.startsWith("<style>");
    val one: Token[] = [
        customVariant(
            Variant(
                atRule: "",
                selector: "&:where([data-theme=\"midnight\"] *)",
            ),
            f59Bold(),
        ),
    ];
    val cls = emilia(one);
    val doc = await flushWith(bareOptions());
    assert doc.indexOf(
        "." + cls + ":where([data-theme=\"midnight\"] *){font-weight:bold}",
    )
        != -1;
    val sup: Token[] = [
        customVariant(
            Variant(atRule: "@supports (display:grid)", selector: "&"),
            f59Bold(),
        ),
    ];
    val s2 = decodeSheet(styleRule(sup, defaultTheme())._1).rules.at(0);
    if (s2 == null) {
        assert false;
        return;
    }
    assert s2.atRules.join(",") == "@supports (display:grid)";
}

test "selector — a Variant with the wrong number of `&` is refused, no path around it" {
    assert panicMessage({ ->
        val t = customVariant(Variant(atRule: "", selector: "div"), f59Bold());
        0
    }).indexOf("exactly one &")
        != -1;
    assert panicMessage({ ->
        val t = customVariant(Variant(atRule: "", selector: "& &"), f59Bold());
        0
    }).indexOf("exactly one &")
        != -1;
}

test "named — `btn` lands in `@layer components`, beside the hashed class in utilities" {
    val drained = await flushWith(bareOptions());
    assert drained.startsWith("<style>");
    val n = named("btn", btn());
    val cls = emilia(btn());
    val doc = await flushWith(bareOptions());
    assert n == "btn";
    val comps = doc.split("@layer components{").at(1) ?? "";
    val utils = doc.split("@layer utilities{").at(1) ?? "";
    assert comps.startsWith(".btn{");
    assert utils.startsWith("." + cls + "{");
    assert doc.indexOf("@layer components{") < doc.indexOf("@layer utilities{");
}

// CONTRACT 4, RE-ASSERTED HERE: the only front that registers without hashing
// is the only place the class scheme could break unnoticed.
test "named — the hashed class of the same list is byte-identical either way" {
    val drained = await flushWith(bareOptions());
    assert drained.startsWith("<style>");
    val before = emilia(btn());
    val n = named("btn-contract", btn());
    val after = emilia(btn());
    assert before == after;
    assert before == "e_902d2502";
    val cleared = await flushWith(bareOptions());
    assert cleared.startsWith("<style>");
}

test "named — refuses the e_ space, a bad ident, and a second different registration" {
    assert panicMessage({ ->
        val n = named("e_abc", btn());
        0
    }).indexOf("generated e_ space")
        != -1;
    assert panicMessage({ ->
        val n = named("a b", btn());
        0
    }).indexOf("named class may contain only")
        != -1;
    assert panicMessage({ ->
        val n = named("x}</style>", btn());
        0
    }).indexOf("named class may contain only")
        != -1;
    val drained = await flushWith(bareOptions());
    assert drained.startsWith("<style>");
    val first = named("card", btn());
    val same = named("card", btn());
    assert panicMessage({ ->
        val n = named("card", redBg());
        0
    }).indexOf("already registered")
        != -1;
    val cleared = await flushWith(bareOptions());
    assert cleared.startsWith("<style>");
}

// The utility wins BECAUSE its layer is later — asserted as the order, not the
// outcome.
test "named — a named class and a utility on one element: the utilities layer is later" {
    val drained = await flushWith(bareOptions());
    assert drained.startsWith("<style>");
    val n = named("tag", redBg());
    val cls = emilia(blueBg());
    val doc = await flushWith(bareOptions());
    assert doc.startsWith("<style>@layer theme, base, components, utilities;");
    assert doc.indexOf(".tag{background-color:var(--color-red-500)}")
        < doc.indexOf("." + cls + "{background-color:var(--color-blue-500)}");
}

// ── end front 59 tests ─────────────────────────────────────────────────────

// ── front 48 · tests — the five ways the halves can disagree ─────────────────
//
// On the class name and the CSS string alone: nothing here renders HTML. The
// rendered-markup round trip belongs to a consumer that renders elements.

fn cardTokens() -> Token[] {
    val hovered: Token[] = [.Bg.Color.Gray.__100];
    val card: Token[] = [
        .Bg.White,
        .Pad.All.__4,
        .Text.Bold,
        Token.Hover(hovered),
    ];
    return card;
}

// THE SHARED FIXTURE — contract 4's emilia-side literal. The commonJS and the
// erlang rows run this one line; every reader of the contract-4 literal
// asserts the same value for the same list and theme.
test "class: attributes — the shared fixture" {
    val drained = await flushWith(bareOptions());
    assert drained.startsWith("<style>");
    val c = className(cardTokens(), defaultTheme());
    assert c == "e_f51c2501";
    assert classRules(tokensToSheet(cardTokens(), defaultTheme()))
        == "\u{1}{background:#ffffff;padding:calc(var(--spacing) * 4);font-weight:bold}@media (hover: hover){\u{1}:hover{background-color:var(--color-gray-100)}}";
    val sheet = await flushWith(bareOptions());
    assert sheet.indexOf("." + c + "{") != -1;
    assert sheet.indexOf("." + c + ":hover{") != -1;
}

test "styled — the attribute pair, and the same class the three names give" {
    val th = defaultTheme();
    val pair = styled(cardTokens(), th);
    assert pair._0 == "class";
    assert pair._1 == emiliaWith(cardTokens(), th);
    assert cls(cardTokens(), th) == className(cardTokens(), th);
    assert className(cardTokens(), th) == emiliaWith(cardTokens(), th);
    assert cls(cardTokens(), th).startsWith("e_");
    assert cls(cardTokens(), th).indexOf(" ") == -1;
}

test "purity — the same class twice, and after an unrelated emilia() call" {
    val th = defaultTheme();
    val first = className(cardTokens(), th);
    val other: Token[] = [.Text.Italic];
    val _o = emilia(other);
    assert className(cardTokens(), th) == first;
}

// Clause 1b: a theme that differs in an entry the tokens READ is another class.
test "the theme is an input — a moved breakpoint is another class" {
    val inner: Token[] = [.Text.Bold];
    val tokens: Token[] = [Token.Md(inner)];
    val wide: ThemeEntry[] = [
        ThemeEntry(name: "--breakpoint-md", value: "50rem"),
    ];
    val a = className(tokens, defaultTheme());
    val b = className(tokens, extendTheme(defaultTheme(), wide));
    assert a != b;
}

test "order is identity — two orders, two classes" {
    val one: Token[] = [.Text.Bold, .Color.Black];
    val two: Token[] = [.Color.Black, .Text.Bold];
    assert className(one, defaultTheme()) != className(two, defaultTheme());
}

test "merge order — styledWith is the static class, one space, then the emilia class" {
    val th = defaultTheme();
    val pair = styledWith("card", cardTokens(), th);
    assert pair._0 == "class";
    assert pair._1.startsWith("card ");
    assert pair._1.endsWith(className(cardTokens(), th));
    assert clsWith("card", cardTokens(), th) == pair._1;
    assert clsWith("", cardTokens(), th) == className(cardTokens(), th);
}

// Attribute order is argument order: the slot is APPENDED to the base array.
test "attribute order — the slot appends after the base attributes" {
    val base: #(string, string)[] = [#("id", "x")];
    val extra: #(string, string)[] = [styled(cardTokens(), defaultTheme())];
    val attrs = base.append(extra);
    assert attrs.length == 2;
    val first = attrs.at(0);
    val second = attrs.at(1);
    if (first == null || second == null) {
        assert false;
        return;
    }
    assert first._0 == "id";
    assert second._0 == "class";
}

// Clause 3: an ASCII body passes; a non-ASCII payload is refused, naming it.
test "the ASCII gate — refuses a non-ASCII payload instead of hashing it" {
    val th = defaultTheme();
    assert assertAsciiBody(cardTokens(), th);
    val bad: Token[] = [arbValue("content", "\"→\"")];
    val m = panicMessage({ ->
        val c = className(bad, th);
        0
    });
    assert m.indexOf("must be ASCII") != -1;
    assert m.indexOf("→") != -1;
}
// ── end front 48 tests ─────────────────────────────────────────────────────

// ── front 54 · the refusal, asserted ───────────────────────────────────────
//
// `theme.bp` cannot import `arbitrary`'s `panicMessage` (a sibling module
// importing the default module breaks every consumer, 05emilia-h), so the
// refusal front 54's acceptance asks for is asserted here. It is the REFUSAL
// that is read, never the entry's absence: an entry in no namespace aborts the
// build that wrote it, and there is no theme left afterwards to look inside.

test "front 54 — an entry in no namespace aborts, naming it and the nineteen prefixes" {
    val bad: ThemeEntry[] = [ThemeEntry(name: "--gutter", value: "1rem")];
    val m = panicMessage({ ->
        val th = extendTheme(defaultTheme(), bad);
        0
    });
    assert m.indexOf("'--gutter' is in no known namespace") != -1;
    assert m.indexOf("--spacing") != -1;
    // the refusal is by prefix, not by a list of names: a namespaced name the
    // stock theme does not carry is accepted
    val good: ThemeEntry[] = [
        ThemeEntry(name: "--spacing-gutter", value: "1rem"),
    ];
    assert themeValue(extendTheme(defaultTheme(), good), "--spacing-gutter")
        == "1rem";
}

test "front 54 — one bad entry among good ones still aborts the whole extension" {
    val mixed: ThemeEntry[] = [
        ThemeEntry(name: "--color-brand", value: "oklch(0.6 0.2 250)"),
        ThemeEntry(name: "--tw-translate-x", value: "0"),
    ];
    assert panicMessage({ ->
        val th = extendTheme(defaultTheme(), mixed);
        0
    }).indexOf("'--tw-translate-x'")
        != -1;
}

// ── front 56 · test helpers ───────────────────────────────────────────

// A document with no theme in it, so a cascade assertion reads as the rules
// the test registered rather than as the stock theme's hundred variables.
fn bareOptions() -> Options {
    return withTheme(defaultOptions(), emptyTheme());
}

// A sheet with no rule is a defect in the test that asked, and says so rather
// than answering a blank `Rule` every assertion would then misread.
fn firstRuleOf(s: Sheet) -> Rule {
    val r = s.rules.at(0);
    if (r == null) panic("firstRuleOf: the sheet has no rule");
    return r;
}

// What one token declares, ignoring where it declares it. The seven leaf tests
// below read this; anything about a selector or an at-rule reads the rule.
fn tokenDeclarations(t: Token) -> string {
    return declarationsOf(tokenToSheet(t, defaultTheme())).join(";");
}

// ── tests · styleRule and fullTheme ───────────────────────────────────────

test "styleRule — the class emiliaWith returns, and no registration" {
    val drained = await flush();
    assert drained.startsWith("<style>");
    val tokens: Token[] = [
        .Pad.All.__4,
        .Color.Red.__500,
        Token.Hover([.Text.Bold]),
    ];
    val pure = styleRule(tokens, defaultTheme());
    val after = await flush();
    assert after.indexOf("@layer utilities") == -1;
    assert pure._0 == emiliaWith(tokens, defaultTheme());
    assert pure._0.startsWith("e_");
    assert pure._1 == encodeSheet(tokensToSheet(tokens, defaultTheme()));
    val cleared = await flush();
    assert cleared.startsWith("<style>");
}

// Every theme variable a token emits, read out of a rendered document: the
// name after each `var(`, up to its `)` or `,`. `--tw-*` names are excluded —
// they are per-element channels a SIBLING token sets, never theme entries.
fn f56ThemeRefs(doc: string) -> string[] {
    val names = doc
        .split("var(")
        .drop(1)
        .map({ c -> (c.split(")").at(0) ?? "").split(",").at(0) ?? "" });
    return names.filter({ n -> n.startsWith("--") && !n.startsWith("--tw-") });
}

fn f56EveryThemedFamily() -> Token[] {
    val inner: Token[] = [.Bg.Color.Slate.__900];
    val out: Token[] = [
        .Color.Red.__500,
        .Bg.Color.Indigo.__500,
        .Pad.All.__4,
        .Size.MaxW.Md,
        .Text.Size.Lg,
        .Text.Tracking.Tight,
        .Text.Leading.Relaxed,
        .Font.Sans,
        .Font.Weight.Bold,
        .Border.Rounded.Lg,
        .Border.Color.Red.__500,
        .Effect.Shadow.Md,
        .Effect.InsetShadow.Xs,
        .Effect.TextShadow.Sm,
        .Filter.Blur.Sm,
        .Filter.DropShadow.Md,
        .BackdropFilter.Blur.Md,
        .Transition.Ease.InOut,
        .Animate.Spin,
        .Transform.Perspective.Near,
        .Gradient.From.Indigo.__500,
        Token.Md(inner),
    ];
    return out;
}

// DECISION 80: an undefined `var(--…)` is a FAILING TEST here, never a silent
// CSS no-op. The control is the same document under the palette-free
// `defaultTheme()`, which must leave references undefined — so the probe is
// known to fire.
test "fullTheme — every theme variable a themed token emits is defined" {
    val drained = await flush();
    assert drained.startsWith("<style>");
    val cls = emilia(f56EveryThemedFamily());
    val doc = await flush();
    val refs = f56ThemeRefs(doc);
    assert refs.length > 20;
    val th = fullTheme();
    assert refs.filter({ n -> themeValue(th, n) == "" }).length == 0;
    assert refs.filter({ n -> themeValue(defaultTheme(), n) == "" }).length > 0;
    assert doc.indexOf("--color-red-500:") != -1;
}

test "fullTheme — defaultTheme first, then one extendTheme per front" {
    val th = fullTheme();
    assert themeValue(th, "--spacing") == "0.25rem";
    assert themeValue(th, "--color-red-500") != "";
    assert themeValue(th, "--font-weight-bold") == "700";
    assert themeValue(th, "--blur-sm") == "8px";
    assert themeValue(th, "--ease-in") != "";
    assert themeValue(th, "--perspective-near") == "300px";
    assert themeValue(th, "--text-shadow-sm") != "";
    assert themeValue(defaultTheme(), "--color-red-500") == "";
}

// ── tests · the leaf dispatchers ────────────────────────────────────────
// V1 enum-section dispatch smoke, unchanged in substance by front 56: a
// section sub-dispatcher still answers a declaration string, and these pin
// that. What changed is that the string reaches the document through a `Rule`.

test "tokenToSheet — Text.Bold lowers to font-weight:bold" {
    assert tokenDeclarations(.Text.Bold) == "font-weight:bold";
}

test "tokenToSheet — Text.Size.Lg lowers to the --text-lg pair" {
    assert tokenDeclarations(.Text.Size.Lg)
        == "font-size:var(--text-lg);line-height:var(--text-lg--line-height)";
}

test "tokenToSheet — Color.Black lowers to the theme reference, not a hex" {
    assert tokenDeclarations(.Color.Black) == "color:var(--color-black)";
}

test "tokenToSheet — Bg.White lowers to background:#ffffff" {
    assert tokenDeclarations(.Bg.White) == "background:#ffffff";
}

test "tokenToSheet — Layout.Flex lowers to display:flex" {
    assert tokenDeclarations(.Layout.Flex) == "display:flex";
}

test "tokenToSheet — Border.Rounded.Full lowers to border-radius:9999px" {
    assert tokenDeclarations(.Border.Rounded.Full) == "border-radius:9999px";
}

// FRONT 41 CHANGED WHAT THIS ROW EMITS. It pinned `box-shadow:md` — the
// Tailwind class suffix where a CSS value belongs, which a browser discards —
// and the leaf name did not move, so the smoke test moved with the value.
test "tokenToSheet — Effect.Shadow.Md lowers to the --tw-shadow channel and the reader" {
    assert tokenDeclarations(.Effect.Shadow.Md)
        == "--tw-shadow:var(--shadow-md);box-shadow:" + boxShadowChain();
}

test "tokenToSheet — a section token is one utilities rule on the bare ampersand" {
    val r = firstRuleOf(tokenToSheet(.Text.Bold, defaultTheme()));
    assert r.layer == "utilities";
    assert r.selector == "&";
    assert r.atRules.length == 0;
    assert r.important == false;
}

// ── tests · the six modifiers, against the variant reference ────────────────
//
// Every expected selector below names the row of the reference's variant table
// it comes from. These six assertions used to read `":hover{…}"` and
// `"@media(min-width:768px){…}"`, both of which the table contradicts; front 56
// owns the break.

test "Hover — `§ 3.2`'s `hover` row is `@media (hover: hover) { &:hover }`, not a bare :hover" {
    val inner: Token[] = [.Color.Black];
    val r = firstRuleOf(tokenToSheet(Token.Hover(inner), defaultTheme()));
    assert r.selector == "&:hover";
    assert r.atRules.join("|") == "@media (hover: hover)";
    assert r.declarations == "color:var(--color-black)";
}

test "Focus and Active — `§ 3.2`'s `focus` and `active` rows are selector-only" {
    val inner: Token[] = [.Text.Bold];
    val f = firstRuleOf(tokenToSheet(Token.Focus(inner), defaultTheme()));
    assert f.selector == "&:focus";
    assert f.atRules.length == 0;
    val a = firstRuleOf(tokenToSheet(Token.Active(inner), defaultTheme()));
    assert a.selector == "&:active";
    assert a.atRules.length == 0;
}

test "Md, Lg and Xl — `§ 3.2`'s breakpoint rows are `@media (width >= <n>rem)`, read from the theme" {
    val inner: Token[] = [.Text.Bold];
    assert firstRuleOf(
        tokenToSheet(Token.Md(inner), defaultTheme()),
    ).atRules.join("|")
        == "@media (width >= 48rem)";
    assert firstRuleOf(
        tokenToSheet(Token.Lg(inner), defaultTheme()),
    ).atRules.join("|")
        == "@media (width >= 64rem)";
    assert firstRuleOf(
        tokenToSheet(Token.Xl(inner), defaultTheme()),
    ).atRules.join("|")
        == "@media (width >= 80rem)";
    assert firstRuleOf(tokenToSheet(Token.Md(inner), defaultTheme())).selector
        == "&";
}

test "tokensToSheet — a multi-token list is one rule per token, in order" {
    val list: Token[] = [.Text.Bold, .Color.Black];
    val s = tokensToSheet(list, defaultTheme());
    assert s.rules.length == 2;
    assert declarationsOf(s).join(";")
        == "font-weight:bold;color:var(--color-black)";
}

test "nested modifiers — `§ 3.2`'s `md` and `hover` rows, the outer one outermost in both halves" {
    val deepest: Token[] = [.Text.Bold];
    val mid: Token[] = [Token.Md(deepest)];
    val r = firstRuleOf(tokenToSheet(Token.Hover(mid), defaultTheme()));
    assert r.selector == "&:hover";
    assert r.atRules.join("|")
        == "@media (hover: hover)|@media (width >= 48rem)";
}

test "a breakpoint follows the theme, so the theme is an input to the class hash" {
    val wide: ThemeEntry[] = [
        ThemeEntry(name: "--breakpoint-md", value: "50rem"),
    ];
    val th = extendTheme(defaultTheme(), wide);
    val inner: Token[] = [.Text.Bold];
    assert firstRuleOf(tokenToSheet(Token.Md(inner), th)).atRules.join("|")
        == "@media (width >= 50rem)";
    val tokens: Token[] = [Token.Md(inner)];
    assert emiliaWith(tokens, th) != emiliaWith(tokens, defaultTheme());
    val _drop = await flush();
}

// ── tests · the codec assumption, over the dispatcher's own output ──────────

fn everySectionToken() -> Token[] {
    val hoverInner: Token[] = [.Color.Black];
    val mdInner: Token[] = [.Text.Bold];
    val out: Token[] = [
        .Text.Bold,
        .Text.Size.Lg,
        .Font.Sans,
        .Font.Weight.Bold,
        .Color.Black,
        .Bg.White,
        .Pad.All.__4,
        .Margin.Y.__2,
        .Layout.Flex,
        .Flex.Gap.__4,
        .Border.Rounded.Full,
        .Effect.Shadow.Md,
        Token.Hover(hoverInner),
        Token.Md(mdInner),
    ];
    return out;
}

test "codec — no declaration any dispatcher produces carries a codec separator" {
    val s = tokensToSheet(everySectionToken(), defaultTheme());
    assert s.rules.length == 14;
    assert declarationsOf(s).any({ d -> carriesSeparator(d) }) == false;
    assert s.rules.any({ r -> carriesSeparator(r.selector) }) == false;
    assert s.rules.any({ r -> carriesSeparator(r.atRules.join("")) }) == false;
}

// THE CODEC'S ASSUMPTION, CHECKED OVER EVERY FRONT'S LEAF WALK rather than a
// sample: no declaration, selector or at-rule any dispatcher produces carries
// `\n`, `\t` or `\r`. A front that lands a walk adds its list here.
fn f56EveryWalkedLeaf() -> Token[] {
    return everyModifier()
        .append(everySpacingToken())
        .append(everySizeToken())
        .append(layoutLeaves())
        .append(front37Leaves())
        .append(front38Leaves())
        .append(backgroundLeaves())
        .append(front40Leaves())
        .append(front41Leaves())
        .append(f42AllLeaves())
        .append(f43AllLeaves())
        .append(front44Leaves())
        .append(front45Leaves())
        .append(f46AllLeaves());
}

fn f56SheetCarriesSeparator(s: Sheet) -> bool {
    return s.rules.any({ r ->
        carriesSeparator(r.declarations)
            || carriesSeparator(r.selector)
            || carriesSeparator(r.atRules.join(""))
    });
}

test "codec — every walked leaf of fronts 34-46 carries no codec separator" {
    val all = f56EveryWalkedLeaf();
    assert all.length > 5000;
    val bad = all.filter(
        { t -> f56SheetCarriesSeparator(tokenToSheet(t, defaultTheme())) },
    );
    assert bad.length == 0;
    assert f56SheetCarriesSeparator(declSheet("color:red\n")) == true;
}

test "codec — a full dispatcher sheet round-trips through the cell encoding" {
    val s = tokensToSheet(everySectionToken(), defaultTheme());
    val raw = encodeSheet(s);
    assert encodeSheet(decodeSheet(raw)) == raw;
    assert decodeSheet(raw).rules.length == 14;
}

// ── tests · the host cell and the drain ────────────────────────────────
//
// The two templates are written twice, once per target, and the whole point of
// moving assembly out of them is that the divergence became testable: every
// assertion here runs on `--target commonJS` and on `--target erlang`, and a
// drain that is green on one only means the other is wrong.

test "drainRules — nothing registered drains to the empty string" {
    val raw = await drainRules();
    assert raw == "";
}

test "drainRules — the payloads come back verbatim, in insertion order" {
    register("e_a", "P1");
    register("e_b", "P2");
    val raw = await drainRules();
    assert raw == "e_a\tP1\ne_b\tP2";
}

test "drainRules — a drain clears the cell, so the second of two is empty" {
    register("e_a", "P1");
    val first = await drainRules();
    val second = await drainRules();
    assert first == "e_a\tP1";
    assert second == "";
}

test "drainRules — re-registering a name keeps its position and replaces its payload" {
    register("e_a", "P1");
    register("e_b", "P2");
    register("e_a", "P3");
    val raw = await drainRules();
    assert raw == "e_a\tP3\ne_b\tP2";
}

test "drainRules — the cell assembles nothing: no `<style>`, no brace, in what it hands back" {
    val tokens: Token[] = [.Bg.Black];
    val _cls = emilia(tokens);
    val raw = await drainRules();
    assert raw.indexOf("<") == -1;
    assert raw.indexOf("{") == -1;
    assert raw.indexOf("}") == -1;
}

// ── tests · the public surface ──────────────────────────────────────

test "emilia of an empty token list is a stable class that contributes no rule" {
    val empty: Token[] = [];
    val a = emilia(empty);
    val b = emilia(empty);
    assert a == b;
    assert a.startsWith("e_");
    val styles = await flushWith(bareOptions());
    assert styles
        == "<style>@layer theme, base, components, utilities;</style>";
}

test "emilia of one text token produces a single-declaration rule" {
    val tokens: Token[] = [.Text.Bold];
    val cls = emilia(tokens);
    val styles = await flushWith(bareOptions());
    assert styles
        == "<style>@layer theme, base, components, utilities;@layer utilities{."
            + cls
            + "{font-weight:bold}}</style>";
}

test "emilia of mixed tokens folds one class into one rule" {
    val tokens: Token[] = [.Bg.White, .Text.Size.Lg];
    val cls = emilia(tokens);
    val styles = await flushWith(bareOptions());
    assert styles
        == "<style>@layer theme, base, components, utilities;@layer utilities{."
            + cls
            + "{background:#ffffff;font-size:var(--text-lg);line-height:var(--text-lg--line-height)}}</style>";
}

test "two emilia sites with the same token list collapse to one class" {
    val tokens: Token[] = [.Bg.White];
    val a = emilia(tokens);
    val b = emilia(tokens);
    assert a == b;
    val styles = await flushWith(bareOptions());
    assert styles
        == "<style>@layer theme, base, components, utilities;@layer utilities{."
            + a
            + "{background:#ffffff}}</style>";
}

// A payload leaf nested inside an enum section (`[.Color.Hex("#abc")]`)
// cannot be constructed by any spelling (`language-gaps.md`), so no test here
// names one.

test "a modifier is a SIBLING rule now (`§ 3.2`'s `hover` row), not a block nested inside the class" {
    val inner: Token[] = [.Bg.White, .Text.Bold];
    val tokens: Token[] = [.Bg.Black, Token.Hover(inner)];
    val cls = emilia(tokens);
    val styles = await flushWith(bareOptions());
    assert styles
        == "<style>@layer theme, base, components, utilities;@layer utilities{."
            + cls
            + "{background:#000000}@media (hover: hover){."
            + cls
            + ":hover{background:#ffffff;font-weight:bold}}}</style>";
}

test "two consecutive flushes emit two independent documents" {
    val first: Token[] = [.Text.Bold];
    val _a = emilia(first);
    val s1 = await flushWith(bareOptions());
    val s2 = await flushWith(bareOptions());
    assert s1.indexOf("@layer utilities{") != -1;
    assert s2 == "<style>@layer theme, base, components, utilities;</style>";
}

test "flush — the stock render carries the theme layer and the stock keyframes" {
    val tokens: Token[] = [.Text.Bold];
    val cls = emilia(tokens);
    val styles = await flush();
    assert styles.startsWith(
        "<style>@layer theme, base, components, utilities;@layer theme{:root{--spacing:0.25rem;",
    );
    assert styles.indexOf("@layer utilities{." + cls + "{font-weight:bold}}")
        != -1;
    assert styles.endsWith(
        "@keyframes bounce{0%,100%{transform:translateY(-25%);animation-timing-function:cubic-bezier(0.8,0,1,1)}50%{transform:none;animation-timing-function:cubic-bezier(0,0,0.2,1)}}</style>",
    );
}

// ── tests · the conflict rule ───────────────────────────────────────
//
// The reference's conflict section: the LAST rule in the stylesheet wins, and
// its own worked example is `class="grid flex"` resolving to `display:flex`.
// Inside one `emilia()` call that is the token list order; across calls it is
// registration order. Before front 56 nothing said either.

test "conflict — `grid flex` renders in list order, so the last one wins" {
    val tokens: Token[] = [.Layout.Grid, .Layout.Flex];
    val cls = emilia(tokens);
    val styles = await flushWith(bareOptions());
    assert styles
        == "<style>@layer theme, base, components, utilities;@layer utilities{."
            + cls
            + "{display:grid;display:flex}}</style>";
}

test "conflict — reversing the list reverses the winner, and is a different class" {
    val a: Token[] = [.Layout.Grid, .Layout.Flex];
    val b: Token[] = [.Layout.Flex, .Layout.Grid];
    val clsA = emiliaWith(a, defaultTheme());
    val clsB = emiliaWith(b, defaultTheme());
    assert clsA != clsB;
    val styles = await flushWith(bareOptions());
    assert styles.indexOf("." + clsA + "{display:grid;display:flex}") != -1;
    assert styles.indexOf("." + clsB + "{display:flex;display:grid}") != -1;
}

test "conflict — two emilia calls setting the same property render in CALL order" {
    val first: Token[] = [.Layout.Grid];
    val second: Token[] = [.Layout.Flex];
    val clsA = emilia(first);
    val clsB = emilia(second);
    val styles = await flushWith(bareOptions());
    assert styles.indexOf("." + clsA + "{display:grid}")
        < styles.indexOf("." + clsB + "{display:flex}");
}

test "conflict — reordering an unrelated token moves no other rule" {
    val one: Token[] = [.Text.Bold, .Layout.Flex, .Color.Black];
    val two: Token[] = [.Layout.Flex, .Text.Bold, .Color.Black];
    val clsA = emilia(one);
    val clsB = emilia(two);
    val styles = await flushWith(bareOptions());
    assert styles.indexOf(
        "." + clsA + "{font-weight:bold;display:flex;color:var(--color-black)}",
    )
        != -1;
    assert styles.indexOf(
        "." + clsB + "{display:flex;font-weight:bold;color:var(--color-black)}",
    )
        != -1;
    assert styles.indexOf("." + clsA) < styles.indexOf("." + clsB);
}

test "conflict — a variant of a rule (`§ 3.2`'s `hover` row) follows the rule it varies" {
    val inner: Token[] = [.Layout.Grid];
    val tokens: Token[] = [Token.Md(inner), .Layout.Flex];
    val cls = emilia(tokens);
    val styles = await flushWith(bareOptions());
    assert styles
        == "<style>@layer theme, base, components, utilities;@layer utilities{."
            + cls
            + "{display:flex}@media (width >= 48rem){."
            + cls
            + "{display:grid}}}</style>";
}

//// ═══ FRONT 33 · the colour palette ═══════════════════════════════════════
////
//// The 26 families x 11 shades of `§ 3.6` / `§ 21.1` on `color` here, the
//// same grid on `background-color` under `Bg.Color`, the five named colours,
//// and the `Alpha` opacity wrapper.
////
//// THE TOKEN EMITS A REFERENCE, NEVER A VALUE. Upstream does not inline a
//// colour into a utility rule: it declares the shade once in the theme layer
//// and every utility names it — `--color-red-500: oklch(…)` inside `@theme`,
//// `color: var(--color-red-500)` inside `.text-red-500`. emilia mirrors that
//// exactly. It is what makes the utility half byte-equal with upstream
//// without holding 286 numbers at the call site, and what makes a project's
//// own `--color-red-500` override reach every rule that names it.
////
//// So THE PALETTE RESOLVES THROUGH THE THEME, never through a literal
//// ladder. `paletteVar(family, shade)` is one line over front 54's
//// `themeVar`, and the `--color-` prefix it builds on is front 54's
//// `nsPrefix(Ns.Color)` — the prefix has one author in this library and this
//// front is not a second one. The file used to carry `redPaletteHex`, a
//// correct nine-shade ladder of Tailwind v3 hex values that NOTHING CALLED,
//// beside a dispatcher that answered `"color:red"` for every shade; both are
//// gone.
////
//// The 286 numeric values are the other half, and they are data rather than
//// code: `paletteEntries()` hands them over as `ThemeEntry[]` for a consumer
//// to compose — `extendTheme(defaultTheme(), paletteEntries())`. Keeping them
//// a list rather than a rendered block is what lets a project that already
//// imports upstream's own theme leave them out and still use every colour
//// token. `emilia(...)` emits no `@theme` block of its own.

// `paletteVar("red", "500")` is `var(--color-red-500)` — the reference a
// utility emits, built from front 54's namespace prefix and front 54's
// `themeVar`. It takes two plain STRINGS and no token, and the property name
// lives in the dispatcher rather than in the value: the palette is a
// string-to-string mapping with the enum only at its edge, so front 57's
// escape hatch can hand it a family and a shade it did not get from a leaf and
// get the same well-formed reference back, without a second palette table and
// without this front changing shape.
pub fn paletteVar(family: string, shade: string) -> string {
    return themeVar(nsPrefix(Ns.Color) + family + "-" + shade);
}

// ── the `Color` section · the `text-*` colours ───────────────────────────────
//
// One arm per family, and NO ARM DISCARDS ITS PAYLOAD — which is the whole
// defect this front closes. `Red(_inner) -> "color:red"` rendered
// `.Color.Red.100` and `.Color.Red.900` byte-identically, so the shade level
// existed in the type and did nothing in the output.
//
// `White` and `Black` reference the theme too: `defaultTheme()` already
// carries `--color-white` / `--color-black`, and a project that overrides them
// expects `.Color.Black` to follow. That is a deliberate break with the two
// front-56 assertions that read `color:#000000` — the hex was the stub's, not
// a contract. `Transparent`, `Current` and `Inherit` are CSS-wide keywords
// with no theme entry, so those three stay literal. `Hex(value)` is retained
// unchanged, as the proof that a string payload splices (see the note under
// the tests).
//
// CLOSED — the six cells that were unreachable now resolve.
// `.Color.Red.100`, `.Color.Red.500`, `.Color.Red.700`, `.Color.Gray.100`,
// `.Color.Gray.500` and `.Color.Gray.700` used to compile in no spelling:
// `tryResolveEnumSectionPath` (compiler-core `comptime/infer.zig`) resolved a
// leading-dot path by iterating `env.typeDefs` — a hash map holding the
// SYNTHESISED SECTION ENUMS beside the real ones — and returned the first enum
// whose section tree carried the path, so `Token` and `__Token__Border` (front
// 40's `Border.Color` stub, whose Red and Gray also run 100/500/700) were
// decided between by hash order and the expected type was never consulted. It
// failed loudly at the call site rather than emitting the wrong CSS, and it
// flipped when the typedef set grew. The compiler now prefers the enum the
// expected type names, accepts the fully qualified `Token.Color.Red.500`, and
// refuses an ambiguous path naming both candidates instead of picking one.

fn colorTokenToCss(t: Token.Color, th: Theme) -> string {
    val out = case t {
        Red(_inner) -> "color:" + paletteVar("red", colorRedShade(_inner));
        Orange(_inner) -> "color:"
            + paletteVar("orange", colorOrangeShade(_inner));
        Amber(_inner) -> "color:"
            + paletteVar("amber", colorAmberShade(_inner));
        Yellow(_inner) -> "color:"
            + paletteVar("yellow", colorYellowShade(_inner));
        Lime(_inner) -> "color:" + paletteVar("lime", colorLimeShade(_inner));
        Green(_inner) -> "color:"
            + paletteVar("green", colorGreenShade(_inner));
        Emerald(_inner) -> "color:"
            + paletteVar("emerald", colorEmeraldShade(_inner));
        Teal(_inner) -> "color:" + paletteVar("teal", colorTealShade(_inner));
        Cyan(_inner) -> "color:" + paletteVar("cyan", colorCyanShade(_inner));
        Sky(_inner) -> "color:" + paletteVar("sky", colorSkyShade(_inner));
        Blue(_inner) -> "color:" + paletteVar("blue", colorBlueShade(_inner));
        Indigo(_inner) -> "color:"
            + paletteVar("indigo", colorIndigoShade(_inner));
        Violet(_inner) -> "color:"
            + paletteVar("violet", colorVioletShade(_inner));
        Purple(_inner) -> "color:"
            + paletteVar("purple", colorPurpleShade(_inner));
        Fuchsia(_inner) -> "color:"
            + paletteVar("fuchsia", colorFuchsiaShade(_inner));
        Pink(_inner) -> "color:" + paletteVar("pink", colorPinkShade(_inner));
        Rose(_inner) -> "color:" + paletteVar("rose", colorRoseShade(_inner));
        Slate(_inner) -> "color:"
            + paletteVar("slate", colorSlateShade(_inner));
        Gray(_inner) -> "color:" + paletteVar("gray", colorGrayShade(_inner));
        Zinc(_inner) -> "color:" + paletteVar("zinc", colorZincShade(_inner));
        Neutral(_inner) -> "color:"
            + paletteVar("neutral", colorNeutralShade(_inner));
        Stone(_inner) -> "color:"
            + paletteVar("stone", colorStoneShade(_inner));
        Mauve(_inner) -> "color:"
            + paletteVar("mauve", colorMauveShade(_inner));
        Olive(_inner) -> "color:"
            + paletteVar("olive", colorOliveShade(_inner));
        Mist(_inner) -> "color:" + paletteVar("mist", colorMistShade(_inner));
        Taupe(_inner) -> "color:"
            + paletteVar("taupe", colorTaupeShade(_inner));
        White -> "color:" + themeVar(nsPrefix(Ns.Color) + "white");
        Black -> "color:" + themeVar(nsPrefix(Ns.Color) + "black");
        Transparent -> "color:transparent";
        Current -> "color:currentColor";
        Inherit -> "color:inherit";
        Hex(value) -> "color:" + value;
    };
    return out;
}

fn colorRedShade(s: Token.Color.Red) -> string {
    val out = case s {
        __50 -> "50";
        __100 -> "100";
        __200 -> "200";
        __300 -> "300";
        __400 -> "400";
        __500 -> "500";
        __600 -> "600";
        __700 -> "700";
        __800 -> "800";
        __900 -> "900";
        __950 -> "950";
    };
    return out;
}

