        __80 -> spacing(80);
        __96 -> spacing(96);
        Px -> "1px";
        Auto -> "auto";
        Full -> "100%";
        Frac(_inner) -> insetFracS(_inner, th);
        Half(_inner) -> insetHalfS(_inner, th);
        Neg(_inner) -> insetNegS(_inner, th);
    };
    return out;
}

fn insetFracS(f: Token.Layout.Inset.S.Frac, th: Theme) -> string {
    val out = case f {
        Half -> fraction(1, 2);
        Third -> fraction(1, 3);
        TwoThirds -> fraction(2, 3);
    };
    return out;
}

fn insetHalfS(h: Token.Layout.Inset.S.Half, th: Theme) -> string {
    val out = case h {
        __0 -> spacingHalf(0);
        __1 -> spacingHalf(1);
        __2 -> spacingHalf(2);
        __3 -> spacingHalf(3);
    };
    return out;
}

fn insetNegS(s: Token.Layout.Inset.S.Neg, th: Theme) -> string {
    val out = case s {
        __1 -> spacing(-1);
        __2 -> spacing(-2);
        __3 -> spacing(-3);
        __4 -> spacing(-4);
        __5 -> spacing(-5);
        __6 -> spacing(-6);
        __7 -> spacing(-7);
        __8 -> spacing(-8);
        __9 -> spacing(-9);
        __10 -> spacing(-10);
        __11 -> spacing(-11);
        __12 -> spacing(-12);
        __14 -> spacing(-14);
        __16 -> spacing(-16);
        __20 -> spacing(-20);
        __24 -> spacing(-24);
        __28 -> spacing(-28);
        __32 -> spacing(-32);
        __36 -> spacing(-36);
        __40 -> spacing(-40);
        __44 -> spacing(-44);
        __48 -> spacing(-48);
        __52 -> spacing(-52);
        __56 -> spacing(-56);
        __60 -> spacing(-60);
        __64 -> spacing(-64);
        __72 -> spacing(-72);
        __80 -> spacing(-80);
        __96 -> spacing(-96);
        Px -> "-1px";
        Half(_inner) -> insetNegHalfS(_inner, th);
    };
    return out;
}

fn insetNegHalfS(h: Token.Layout.Inset.S.Neg.Half, th: Theme) -> string {
    val out = case h {
        __0 -> spacingNegHalf(0);
        __1 -> spacingNegHalf(1);
        __2 -> spacingNegHalf(2);
        __3 -> spacingNegHalf(3);
    };
    return out;
}

fn insetScaleE(s: Token.Layout.Inset.E, th: Theme) -> string {
    val out = case s {
        __0 -> spacing(0);
        __1 -> spacing(1);
        __2 -> spacing(2);
        __3 -> spacing(3);
        __4 -> spacing(4);
        __5 -> spacing(5);
        __6 -> spacing(6);
        __7 -> spacing(7);
        __8 -> spacing(8);
        __9 -> spacing(9);
        __10 -> spacing(10);
        __11 -> spacing(11);
        __12 -> spacing(12);
        __14 -> spacing(14);
        __16 -> spacing(16);
        __20 -> spacing(20);
        __24 -> spacing(24);
        __28 -> spacing(28);
        __32 -> spacing(32);
        __36 -> spacing(36);
        __40 -> spacing(40);
        __44 -> spacing(44);
        __48 -> spacing(48);
        __52 -> spacing(52);
        __56 -> spacing(56);
        __60 -> spacing(60);
        __64 -> spacing(64);
        __72 -> spacing(72);
        __80 -> spacing(80);
        __96 -> spacing(96);
        Px -> "1px";
        Auto -> "auto";
        Full -> "100%";
        Frac(_inner) -> insetFracE(_inner, th);
        Half(_inner) -> insetHalfE(_inner, th);
        Neg(_inner) -> insetNegE(_inner, th);
    };
    return out;
}

fn insetFracE(f: Token.Layout.Inset.E.Frac, th: Theme) -> string {
    val out = case f {
        Half -> fraction(1, 2);
        Third -> fraction(1, 3);
        TwoThirds -> fraction(2, 3);
    };
    return out;
}

fn insetHalfE(h: Token.Layout.Inset.E.Half, th: Theme) -> string {
    val out = case h {
        __0 -> spacingHalf(0);
        __1 -> spacingHalf(1);
        __2 -> spacingHalf(2);
        __3 -> spacingHalf(3);
    };
    return out;
}

fn insetNegE(s: Token.Layout.Inset.E.Neg, th: Theme) -> string {
    val out = case s {
        __1 -> spacing(-1);
        __2 -> spacing(-2);
        __3 -> spacing(-3);
        __4 -> spacing(-4);
        __5 -> spacing(-5);
        __6 -> spacing(-6);
        __7 -> spacing(-7);
        __8 -> spacing(-8);
        __9 -> spacing(-9);
        __10 -> spacing(-10);
        __11 -> spacing(-11);
        __12 -> spacing(-12);
        __14 -> spacing(-14);
        __16 -> spacing(-16);
        __20 -> spacing(-20);
        __24 -> spacing(-24);
        __28 -> spacing(-28);
        __32 -> spacing(-32);
        __36 -> spacing(-36);
        __40 -> spacing(-40);
        __44 -> spacing(-44);
        __48 -> spacing(-48);
        __52 -> spacing(-52);
        __56 -> spacing(-56);
        __60 -> spacing(-60);
        __64 -> spacing(-64);
        __72 -> spacing(-72);
        __80 -> spacing(-80);
        __96 -> spacing(-96);
        Px -> "-1px";
        Half(_inner) -> insetNegHalfE(_inner, th);
    };
    return out;
}

fn insetNegHalfE(h: Token.Layout.Inset.E.Neg.Half, th: Theme) -> string {
    val out = case h {
        __0 -> spacingNegHalf(0);
        __1 -> spacingNegHalf(1);
        __2 -> spacingNegHalf(2);
        __3 -> spacingNegHalf(3);
    };
    return out;
}

// `overflow` is a shorthand and `overflow-x` / `overflow-y` are the longhands,
// so the three are three properties rather than one property and an axis flag.
fn layoutOverflowToCss(o: Token.Layout.Overflow, th: Theme) -> string {
    val out = case o {
        Auto -> "overflow:auto";
        Hidden -> "overflow:hidden";
        Clip -> "overflow:clip";
        Visible -> "overflow:visible";
        Scroll -> "overflow:scroll";
        X(_inner) -> layoutOverflowXToCss(_inner, th);
        Y(_inner) -> layoutOverflowYToCss(_inner, th);
    };
    return out;
}

fn layoutOverflowXToCss(o: Token.Layout.Overflow.X, th: Theme) -> string {
    val out = case o {
        Auto -> "overflow-x:auto";
        Hidden -> "overflow-x:hidden";
        Clip -> "overflow-x:clip";
        Visible -> "overflow-x:visible";
        Scroll -> "overflow-x:scroll";
    };
    return out;
}

fn layoutOverflowYToCss(o: Token.Layout.Overflow.Y, th: Theme) -> string {
    val out = case o {
        Auto -> "overflow-y:auto";
        Hidden -> "overflow-y:hidden";
        Clip -> "overflow-y:clip";
        Visible -> "overflow-y:visible";
        Scroll -> "overflow-y:scroll";
    };
    return out;
}

fn layoutOverscrollToCss(o: Token.Layout.Overscroll, th: Theme) -> string {
    val out = case o {
        Auto -> "overscroll-behavior:auto";
        Contain -> "overscroll-behavior:contain";
        None -> "overscroll-behavior:none";
        X(_inner) -> layoutOverscrollXToCss(_inner, th);
        Y(_inner) -> layoutOverscrollYToCss(_inner, th);
    };
    return out;
}

fn layoutOverscrollXToCss(o: Token.Layout.Overscroll.X, th: Theme) -> string {
    val out = case o {
        Auto -> "overscroll-behavior-x:auto";
        Contain -> "overscroll-behavior-x:contain";
        None -> "overscroll-behavior-x:none";
    };
    return out;
}

fn layoutOverscrollYToCss(o: Token.Layout.Overscroll.Y, th: Theme) -> string {
    val out = case o {
        Auto -> "overscroll-behavior-y:auto";
        Contain -> "overscroll-behavior-y:contain";
        None -> "overscroll-behavior-y:none";
    };
    return out;
}

// `invisible` is the UTILITY name; `hidden` is the CSS value. The two differ,
// and a transcription that carried the utility name through would emit
// `visibility:invisible`, which no browser honours and no test would notice
// unless it said so. This one does.
fn layoutVisibilityToCss(v: Token.Layout.Visibility, th: Theme) -> string {
    val out = case v {
        Visible -> "visibility:visible";
        Invisible -> "visibility:hidden";
        Collapse -> "visibility:collapse";
    };
    return out;
}

// THE ONE NUMERIC FAMILY IN THIS FRONT THAT IS NOT A LENGTH. `z-50` is
// `z-index:50` — a bare integer — so it never reaches `spacing` and there is
// nothing here for a theme to resolve.
fn layoutZToCss(z: Token.Layout.Z, th: Theme) -> string {
    val out = case z {
        __0 -> "z-index:0";
        __10 -> "z-index:10";
        __20 -> "z-index:20";
        __30 -> "z-index:30";
        __40 -> "z-index:40";
        __50 -> "z-index:50";
        Auto -> "z-index:auto";
    };
    return out;
}

fn layoutIsolationToCss(i: Token.Layout.Isolation, th: Theme) -> string {
    val out = case i {
        Isolate -> "isolation:isolate";
        Auto -> "isolation:auto";
    };
    return out;
}

// ANOTHER NAME-VERSUS-VALUE TRAP. Tailwind v4 spells the logical floats
// `float-start` / `float-end`; CSS spells the values `inline-start` /
// `inline-end`. `float:start` is not a value and would be discarded silently.
fn layoutFloatToCss(f: Token.Layout.Float, th: Theme) -> string {
    val out = case f {
        Start -> "float:inline-start";
        End -> "float:inline-end";
        Right -> "float:right";
        Left -> "float:left";
        None -> "float:none";
    };
    return out;
}

fn layoutClearToCss(c: Token.Layout.Clear, th: Theme) -> string {
    val out = case c {
        Start -> "clear:inline-start";
        End -> "clear:inline-end";
        Left -> "clear:left";
        Right -> "clear:right";
        Both -> "clear:both";
        None -> "clear:none";
    };
    return out;
}

fn layoutObjectToCss(o: Token.Layout.Object, th: Theme) -> string {
    val out = case o {
        Fit(_inner) -> layoutObjectFitToCss(_inner, th);
        Pos(_inner) -> layoutObjectPosToCss(_inner, th);
    };
    return out;
}

fn layoutObjectFitToCss(f: Token.Layout.Object.Fit, th: Theme) -> string {
    val out = case f {
        Contain -> "object-fit:contain";
        Cover -> "object-fit:cover";
        Fill -> "object-fit:fill";
        None -> "object-fit:none";
        ScaleDown -> "object-fit:scale-down";
    };
    return out;
}

// The four two-word values are ONE SPACE, not a hyphen: `object-left-bottom` is
// `object-position:left bottom`. The hyphen belongs to the utility name and the
// space to the CSS value, and the two are not the same string.
fn layoutObjectPosToCss(p: Token.Layout.Object.Pos, th: Theme) -> string {
    val out = case p {
        Bottom -> "object-position:bottom";
        Center -> "object-position:center";
        Left -> "object-position:left";
        LeftBottom -> "object-position:left bottom";
        LeftTop -> "object-position:left top";
        Right -> "object-position:right";
        RightBottom -> "object-position:right bottom";
        RightTop -> "object-position:right top";
        Top -> "object-position:top";
    };
    return out;
}

// `§ 5.1` prints the ratios with spaces around the slash, so that is what is
// emitted: `aspect-ratio:1 / 1`, not `1/1`.
fn layoutAspectToCss(a: Token.Layout.Aspect, th: Theme) -> string {
    val out = case a {
        Auto -> "aspect-ratio:auto";
        Square -> "aspect-ratio:1 / 1";
        Video -> "aspect-ratio:16 / 9";
    };
    return out;
}

// THE NAMED COLUMN WIDTHS ARE THE THEME'S CONTAINER LADDER, not thirteen `rem`
// literals. `columns-md` and `max-w-md` are the same width by definition —
// front 54's theme carries `--container-md: 28rem` and front 35's `Size.MaxW.Md`
// already reads it — so this front reads it too, through the same
// `containerVar`. Spelling `columns:28rem` here would be byte-different from
// upstream and would make a project's `--container-md` override silently
// ineffective for `columns` while working for `max-width`, which is worse than
// either being wrong on its own.
//
// The three integers are NOT lengths: `columns-2` is `columns:2`, a column
// count, and nothing in the theme resolves it.
//
// REFERENCE GAP, recorded rather than hidden: `§ 5.2` prints `columns-1`, `-2`
// and `-3` and the named widths only. `columns-4` … `columns-12` resolve
// upstream through the bare-integer rule rather than through a theme key, so
// they are left out until that is confirmed rather than guessed at here.
fn layoutColumnsToCss(c: Token.Layout.Columns, th: Theme) -> string {
    val out = case c {
        __1 -> "columns:1";
        __2 -> "columns:2";
        __3 -> "columns:3";
        Auto -> "columns:auto";
        X3xs -> oneDecl("columns", containerVar("3xs"));
        X2xs -> oneDecl("columns", containerVar("2xs"));
        Xs -> oneDecl("columns", containerVar("xs"));
        Sm -> oneDecl("columns", containerVar("sm"));
        Md -> oneDecl("columns", containerVar("md"));
        Lg -> oneDecl("columns", containerVar("lg"));
        Xl -> oneDecl("columns", containerVar("xl"));
        X2xl -> oneDecl("columns", containerVar("2xl"));
        X3xl -> oneDecl("columns", containerVar("3xl"));
        X4xl -> oneDecl("columns", containerVar("4xl"));
        X5xl -> oneDecl("columns", containerVar("5xl"));
        X6xl -> oneDecl("columns", containerVar("6xl"));
        X7xl -> oneDecl("columns", containerVar("7xl"));
    };
    return out;
}

fn layoutBreakAfterToCss(b: Token.Layout.BreakAfter, th: Theme) -> string {
    val out = case b {
        Auto -> "break-after:auto";
        Avoid -> "break-after:avoid";
        All -> "break-after:all";
        Page -> "break-after:page";
        Left -> "break-after:left";
        Right -> "break-after:right";
        Column -> "break-after:column";
    };
    return out;
}

fn layoutBreakBeforeToCss(b: Token.Layout.BreakBefore, th: Theme) -> string {
    val out = case b {
        Auto -> "break-before:auto";
        Avoid -> "break-before:avoid";
        All -> "break-before:all";
        Page -> "break-before:page";
        Left -> "break-before:left";
        Right -> "break-before:right";
        Column -> "break-before:column";
    };
    return out;
}

// THE THREE BREAK SUB-SECTIONS ARE FLAT, and that is not a style choice. The
// spec spells them `Break { After, Before, Inside }`, and that spelling does
// not survive beside front 34: a section head whose name equals a top-level
// payload variant's name breaks THAT VARIANT's payload projection, so
// `Token.Before(inner)` built a record with no `inner` field and three of front
// 34's tests died on `undefined.fold` — in another front's block, with nothing
// pointing back here. `After` and `Before` were the only two collisions;
// `Columns.Md` and the other leaf-level ones are harmless. The 1.0.8 draft's
// flat spelling is the one that cannot collide, so it is the one used.
//
// `break-inside` carries a SHORTER leaf set than the other two — `§ 5.5` has no
// `all`, no `page`, no `left` and no `right` — so it is its own sub-section
// rather than a third caller of one shared list.
fn layoutBreakInsideToCss(b: Token.Layout.BreakInside, th: Theme) -> string {
    val out = case b {
        Auto -> "break-inside:auto";
        Avoid -> "break-inside:avoid";
        AvoidPage -> "break-inside:avoid-page";
        AvoidColumn -> "break-inside:avoid-column";
    };
    return out;
}

// `box-border` / `box-content` are the utility names and `border-box` /
// `content-box` are the CSS values; the suffix moves.
fn layoutBoxToCss(b: Token.Layout.Box, th: Theme) -> string {
    val out = case b {
        Border -> "box-sizing:border-box";
        Content -> "box-sizing:content-box";
    };
    return out;
}

fn layoutBoxDecorationToCss(
    b: Token.Layout.BoxDecoration,
    th: Theme,
) -> string {
    val out = case b {
        Clone -> "box-decoration-break:clone";
        Slice -> "box-decoration-break:slice";
    };
    return out;
}

// ── tests · front 36 ─────────────────────────────────────────────────────────
//
// The front's assertions live HERE, beside the dispatchers they cover, for the
// reason front 35 records: front 33 appends its block to the end of the file,
// and two fronts appending to the same line cannot be merged.

test "display — the eleven `§ 5.8` values, the six that predate front 36 first" {
    assert tokenDeclarations(.Layout.Block) == "display:block";
    assert tokenDeclarations(.Layout.InlineBlock) == "display:inline-block";
    assert tokenDeclarations(.Layout.Inline) == "display:inline";
    assert tokenDeclarations(.Layout.Hidden) == "display:none";
    assert tokenDeclarations(.Layout.Flex) == "display:flex";
    assert tokenDeclarations(.Layout.Grid) == "display:grid";
    assert tokenDeclarations(.Layout.InlineFlex) == "display:inline-flex";
    assert tokenDeclarations(.Layout.InlineGrid) == "display:inline-grid";
    assert tokenDeclarations(.Layout.Contents) == "display:contents";
    assert tokenDeclarations(.Layout.FlowRoot) == "display:flow-root";
    assert tokenDeclarations(.Layout.ListItem) == "display:list-item";
}

test "display — `hidden` is `display:none`, the one row whose name is not its value" {
    assert tokenDeclarations(.Layout.Hidden) == "display:none";
    assert tokenDeclarations(.Layout.Hidden).indexOf("hidden") == -1;
}

test "position — the five values of `§ 5.16`" {
    assert tokenDeclarations(.Layout.Position.Static) == "position:static";
    assert tokenDeclarations(.Layout.Position.Fixed) == "position:fixed";
    assert tokenDeclarations(.Layout.Position.Absolute) == "position:absolute";
    assert tokenDeclarations(.Layout.Position.Relative) == "position:relative";
    assert tokenDeclarations(.Layout.Position.Sticky) == "position:sticky";
}

test "inset — the nine directions, each with its own property and its own expansion" {
    assert tokenDeclarations(.Layout.Inset.All.4)
        == "inset:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Layout.Inset.X.4)
        == "left:calc(var(--spacing) * 4);right:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Layout.Inset.Y.4)
        == "top:calc(var(--spacing) * 4);bottom:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Layout.Inset.T.4)
        == "top:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Layout.Inset.R.4)
        == "right:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Layout.Inset.B.4)
        == "bottom:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Layout.Inset.L.4)
        == "left:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Layout.Inset.S.4)
        == "inset-inline-start:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Layout.Inset.E.4)
        == "inset-inline-end:calc(var(--spacing) * 4)";
}

// `inset` IS a CSS shorthand, so `All` is one declaration; `left`/`right` and
// `top`/`bottom` are not, which is why `§ 5.17` prints `inset-x-0` as two.
test "inset — `All` is the shorthand, `X` and `Y` are the two declarations CSS has no shorthand for" {
    assert tokenDeclarations(.Layout.Inset.All.0) == "inset:0";
    assert tokenDeclarations(.Layout.Inset.X.0) == "left:0;right:0";
    assert tokenDeclarations(.Layout.Inset.Y.0) == "top:0;bottom:0";
}

test "inset — the logical pair follows the writing direction where L/R do not" {
    assert tokenDeclarations(.Layout.Inset.S.0) == "inset-inline-start:0";
    assert tokenDeclarations(.Layout.Inset.E.0) == "inset-inline-end:0";
}

test "inset — the keyword and fraction leaves of `§ 5.17`" {
    assert tokenDeclarations(.Layout.Inset.T.Auto) == "top:auto";
    assert tokenDeclarations(.Layout.Inset.T.Full) == "top:100%";
    assert tokenDeclarations(.Layout.Inset.T.Frac.Half)
        == "top:calc(1 / 2 * 100%)";
    assert tokenDeclarations(.Layout.Inset.T.Frac.Third)
        == "top:calc(1 / 3 * 100%)";
    assert tokenDeclarations(.Layout.Inset.T.Frac.TwoThirds)
        == "top:calc(2 / 3 * 100%)";
    // front 35's `Size.*.Frac` and this are ONE convention: the same fraction
    // is the same string on both families
    assert tokenDeclarations(.Layout.Inset.T.Frac.Half).split(":").at(1) ?? ""
        == tokenDeclarations(.Size.W.Frac.Half).split(":").at(1) ?? "";
    assert tokenDeclarations(.Layout.Inset.T.Px) == "top:1px";
}

// `-top-4` is a real utility with no alternative spelling, so `Neg` carries it
// the same way `Margin.T.Neg` does — and through the same `spacing(-4)`.
test "inset — negatives go through `spacing(-n)`, never through a second calc" {
    assert tokenDeclarations(.Layout.Inset.T.Neg.4)
        == "top:calc(var(--spacing) * -4)";
    assert tokenDeclarations(.Layout.Inset.All.Neg.2)
        == "inset:calc(var(--spacing) * -2)";
    assert tokenDeclarations(.Layout.Inset.X.Neg.6)
        == "left:calc(var(--spacing) * -6);right:calc(var(--spacing) * -6)";
    assert tokenDeclarations(.Layout.Inset.T.Neg.Px) == "top:-1px";
    assert tokenDeclarations(.Layout.Inset.T.Neg.Half.1)
        == "top:calc(var(--spacing) * -1.5)";
}

test "inset — the half rungs answer `spacingHalf`, so `top-0.5` is reachable" {
    assert tokenDeclarations(.Layout.Inset.T.Half.0)
        == "top:calc(var(--spacing) * 0.5)";
    assert tokenDeclarations(.Layout.Inset.T.Half.3)
        == "top:calc(var(--spacing) * 3.5)";
}

// THE ARGUMENT OF THIS FRONT'S NUMERIC FAMILY, asserted rather than asserted
// about. The inset ladder and the padding ladder are the same ladder because
// both answer `spacing(n)`; nothing here is a second transcription that could
// drift. Strip the property name and the two are the same string.
test "inset and padding agree by construction — one scale, two properties" {
    val inset = tokenDeclarations(.Layout.Inset.T.4);
    val pad = tokenDeclarations(.Pad.T.4);
    assert inset == "top:" + spacing(4);
    assert pad == "padding-top:" + spacing(4);
    val insetValue = inset.split(":").at(1) ?? "";
    val padValue = pad.split(":").at(1) ?? "";
    assert insetValue == padValue;
    assert inset.indexOf("calc(var(--spacing) * 4)") != -1;
    assert pad.indexOf("calc(var(--spacing) * 4)") != -1;
}

test "overflow — the shorthand and both longhands, five values each" {
    assert tokenDeclarations(.Layout.Overflow.Auto) == "overflow:auto";
    assert tokenDeclarations(.Layout.Overflow.Hidden) == "overflow:hidden";
    assert tokenDeclarations(.Layout.Overflow.Clip) == "overflow:clip";
    assert tokenDeclarations(.Layout.Overflow.Visible) == "overflow:visible";
    assert tokenDeclarations(.Layout.Overflow.Scroll) == "overflow:scroll";
    assert tokenDeclarations(.Layout.Overflow.X.Auto) == "overflow-x:auto";
    assert tokenDeclarations(.Layout.Overflow.X.Hidden) == "overflow-x:hidden";
    assert tokenDeclarations(.Layout.Overflow.X.Clip) == "overflow-x:clip";
    assert tokenDeclarations(.Layout.Overflow.X.Visible)
        == "overflow-x:visible";
    assert tokenDeclarations(.Layout.Overflow.X.Scroll) == "overflow-x:scroll";
    assert tokenDeclarations(.Layout.Overflow.Y.Auto) == "overflow-y:auto";
    assert tokenDeclarations(.Layout.Overflow.Y.Hidden) == "overflow-y:hidden";
    assert tokenDeclarations(.Layout.Overflow.Y.Clip) == "overflow-y:clip";
    assert tokenDeclarations(.Layout.Overflow.Y.Visible)
        == "overflow-y:visible";
    assert tokenDeclarations(.Layout.Overflow.Y.Scroll) == "overflow-y:scroll";
}

test "overscroll — three values on the shorthand and three on each axis" {
    assert tokenDeclarations(.Layout.Overscroll.Auto)
        == "overscroll-behavior:auto";
    assert tokenDeclarations(.Layout.Overscroll.Contain)
        == "overscroll-behavior:contain";
    assert tokenDeclarations(.Layout.Overscroll.None)
        == "overscroll-behavior:none";
    assert tokenDeclarations(.Layout.Overscroll.X.Auto)
        == "overscroll-behavior-x:auto";
    assert tokenDeclarations(.Layout.Overscroll.X.Contain)
        == "overscroll-behavior-x:contain";
    assert tokenDeclarations(.Layout.Overscroll.X.None)
        == "overscroll-behavior-x:none";
    assert tokenDeclarations(.Layout.Overscroll.Y.Auto)
        == "overscroll-behavior-y:auto";
    assert tokenDeclarations(.Layout.Overscroll.Y.Contain)
        == "overscroll-behavior-y:contain";
    assert tokenDeclarations(.Layout.Overscroll.Y.None)
        == "overscroll-behavior-y:none";
}

// A NAME-VERSUS-VALUE TRAP, asserted on its own because it is a place a
// transcription slips: the Tailwind utility is `invisible`, the CSS value is
// `hidden`, and `visibility:invisible` is what a careless copy emits.
test "visibility — `invisible` is `visibility:hidden`, and the word does not survive" {
    assert tokenDeclarations(.Layout.Visibility.Visible)
        == "visibility:visible";
    assert tokenDeclarations(.Layout.Visibility.Invisible)
        == "visibility:hidden";
    assert tokenDeclarations(.Layout.Visibility.Collapse)
        == "visibility:collapse";
    assert tokenDeclarations(.Layout.Visibility.Invisible).indexOf("invisible")
        == -1;
}

test "z-index — a bare integer, never a length and never a calc" {
    assert tokenDeclarations(.Layout.Z.0) == "z-index:0";
    assert tokenDeclarations(.Layout.Z.10) == "z-index:10";
    assert tokenDeclarations(.Layout.Z.20) == "z-index:20";
    assert tokenDeclarations(.Layout.Z.30) == "z-index:30";
    assert tokenDeclarations(.Layout.Z.40) == "z-index:40";
    assert tokenDeclarations(.Layout.Z.50) == "z-index:50";
    assert tokenDeclarations(.Layout.Z.Auto) == "z-index:auto";
    assert tokenDeclarations(.Layout.Z.50).indexOf("calc") == -1;
    assert tokenDeclarations(.Layout.Z.50).indexOf("rem") == -1;
    assert tokenDeclarations(.Layout.Z.50).indexOf("px") == -1;
}

test "isolation — the two values of `§ 5.11`" {
    assert tokenDeclarations(.Layout.Isolation.Isolate) == "isolation:isolate";
    assert tokenDeclarations(.Layout.Isolation.Auto) == "isolation:auto";
}

// `float-start` / `clear-start` are the Tailwind v4 logical names and
// `inline-start` is the CSS value. `float:start` is not a value.
test "float and clear — the logical pair is `inline-start`, not `start`" {
    assert tokenDeclarations(.Layout.Float.Start) == "float:inline-start";
    assert tokenDeclarations(.Layout.Float.End) == "float:inline-end";
    assert tokenDeclarations(.Layout.Clear.Start) == "clear:inline-start";
    assert tokenDeclarations(.Layout.Clear.End) == "clear:inline-end";
    assert tokenDeclarations(.Layout.Float.Start) != "float:start";
    assert tokenDeclarations(.Layout.Clear.Start) != "clear:start";
}

test "float and clear — the physical values of `§ 5.9` and `§ 5.10`" {
    assert tokenDeclarations(.Layout.Float.Right) == "float:right";
    assert tokenDeclarations(.Layout.Float.Left) == "float:left";
    assert tokenDeclarations(.Layout.Float.None) == "float:none";
    assert tokenDeclarations(.Layout.Clear.Left) == "clear:left";
    assert tokenDeclarations(.Layout.Clear.Right) == "clear:right";
    assert tokenDeclarations(.Layout.Clear.Both) == "clear:both";
    assert tokenDeclarations(.Layout.Clear.None) == "clear:none";
}

test "object-fit — the five values of `§ 5.12`" {
    assert tokenDeclarations(.Layout.Object.Fit.Contain)
        == "object-fit:contain";
    assert tokenDeclarations(.Layout.Object.Fit.Cover) == "object-fit:cover";
    assert tokenDeclarations(.Layout.Object.Fit.Fill) == "object-fit:fill";
    assert tokenDeclarations(.Layout.Object.Fit.None) == "object-fit:none";
    assert tokenDeclarations(.Layout.Object.Fit.ScaleDown)
        == "object-fit:scale-down";
}

// The four two-word values are the trap here: the HYPHEN belongs to the utility
// name and the SPACE to the CSS value.
test "object-position — all nine, and the four two-word values are one space" {
    assert tokenDeclarations(.Layout.Object.Pos.Bottom)
        == "object-position:bottom";
    assert tokenDeclarations(.Layout.Object.Pos.Center)
        == "object-position:center";
    assert tokenDeclarations(.Layout.Object.Pos.Left) == "object-position:left";
    assert tokenDeclarations(.Layout.Object.Pos.Right)
        == "object-position:right";
    assert tokenDeclarations(.Layout.Object.Pos.Top) == "object-position:top";
    assert tokenDeclarations(.Layout.Object.Pos.LeftBottom)
        == "object-position:left bottom";
    assert tokenDeclarations(.Layout.Object.Pos.LeftTop)
        == "object-position:left top";
    assert tokenDeclarations(.Layout.Object.Pos.RightBottom)
        == "object-position:right bottom";
    assert tokenDeclarations(.Layout.Object.Pos.RightTop)
        == "object-position:right top";
    assert tokenDeclarations(.Layout.Object.Pos.LeftBottom).indexOf(
        "left-bottom",
    )
        == -1;
    assert tokenDeclarations(.Layout.Object.Pos.RightTop).indexOf("right-top")
        == -1;
}

// `§ 5.1` prints the ratios with spaces around the slash.
test "aspect-ratio — the slash keeps its spaces" {
    assert tokenDeclarations(.Layout.Aspect.Auto) == "aspect-ratio:auto";
    assert tokenDeclarations(.Layout.Aspect.Square) == "aspect-ratio:1 / 1";
    assert tokenDeclarations(.Layout.Aspect.Video) == "aspect-ratio:16 / 9";
    assert tokenDeclarations(.Layout.Aspect.Video).indexOf("16/9") == -1;
}

// The count is a plain integer; the named width is the THEME's, read through
// the same `containerVar` front 35's `Size.MaxW.Md` reads. `columns-md` and
// `max-w-md` are the same width by definition, so they are the same reference.
// ── the front's regression ───────────────────────────────────────────────────
//
// THE WHOLE ARGUMENT OF THIS FRONT'S NUMERIC FAMILY, walked rather than
// sampled. Every leaf `Layout` declares — all 776 of them — is mapped and the
// output is checked for the two shapes that would mean a value was resolved
// here instead of referenced:
//
//   - a `rem` ANYWHERE. `Inset` must answer `calc(var(--spacing) * n)` and the
//     named column widths must answer `var(--container-*)`; a `rem` in either
//     is front 35's defect reopened, and it would make a project's `--spacing`
//     or `--container-md` override silently ineffective.
//   - a CLASS FRAGMENT where a declaration belongs. `top-4`, `inset-x-0` and
//     `z-50` are utility names, not CSS; the shape that reaches the document is
//     `property:value`, so every leaf carries a `:` and none carries the
//     hyphenated utility spelling of its own scale.
//
// `Text.Size` USED TO spell `rem` — front 38 made it `var(--text-lg)`, and
// it is THE CONTROL below. `Border.Rounded` used to be the control and is no
// longer one: front 40 rewrote it to `var(--radius-*)`, so it would now pass
// the probe vacuously.
fn layoutLeaves() -> Token[] {
    val leaves: Token[] = [
        .Layout.Block,
        .Layout.InlineBlock,
        .Layout.Inline,
        .Layout.InlineFlex,
        .Layout.InlineGrid,
        .Layout.Contents,
        .Layout.FlowRoot,
        .Layout.ListItem,
        .Layout.Hidden,
        .Layout.Flex,
        .Layout.Grid,
        .Layout.Position.Static,
        .Layout.Position.Fixed,
        .Layout.Position.Absolute,
        .Layout.Position.Relative,
        .Layout.Position.Sticky,
        .Layout.Inset.All.0,
        .Layout.Inset.All.1,
        .Layout.Inset.All.2,
        .Layout.Inset.All.3,
        .Layout.Inset.All.4,
