// ── tests · the flex item ────────────────────────────────────────────────────

test "flex direction and wrap — the four that compile today, unchanged" {
    assert tokenDeclarations(.Flex.Row) == "flex-direction:row";
    assert tokenDeclarations(.Flex.Col) == "flex-direction:column";
    assert tokenDeclarations(.Flex.Wrap) == "flex-wrap:wrap";
    assert tokenDeclarations(.Flex.NoWrap) == "flex-wrap:nowrap";
}

test "flex direction and wrap — the three reverse rows `§ 6.2`/`§ 6.3` add" {
    assert tokenDeclarations(.Flex.RowReverse) == "flex-direction:row-reverse";
    assert tokenDeclarations(.Flex.ColReverse)
        == "flex-direction:column-reverse";
    assert tokenDeclarations(.Flex.WrapReverse) == "flex-wrap:wrap-reverse";
}

test "the flex shorthand keeps all three components, and `none` is a keyword" {
    assert tokenDeclarations(.Flex.Value.One) == "flex:1 1 0%";
    assert tokenDeclarations(.Flex.Value.Auto) == "flex:1 1 auto";
    assert tokenDeclarations(.Flex.Value.Initial) == "flex:0 1 auto";
    assert tokenDeclarations(.Flex.Value.None) == "flex:none";
    assert tokenDeclarations(.Flex.Value.None).indexOf("0 0 auto") == -1;
}

test "grow and shrink are bare numbers on their own properties" {
    assert tokenDeclarations(.Flex.Grow.1) == "flex-grow:1";
    assert tokenDeclarations(.Flex.Grow.0) == "flex-grow:0";
    assert tokenDeclarations(.Flex.Shrink.1) == "flex-shrink:1";
    assert tokenDeclarations(.Flex.Shrink.0) == "flex-shrink:0";
}

test "basis is the spacing ladder, not a second one" {
    assert tokenDeclarations(.Flex.Basis.0) == "flex-basis:0";
    assert tokenDeclarations(.Flex.Basis.1) == "flex-basis:" + spacing(1);
    assert tokenDeclarations(.Flex.Basis.4) == "flex-basis:" + spacing(4);
    assert tokenDeclarations(.Flex.Basis.96) == "flex-basis:" + spacing(96);
    assert tokenDeclarations(.Flex.Basis.Half.2)
        == "flex-basis:" + spacingHalf(2);
    assert tokenDeclarations(.Flex.Basis.Px) == "flex-basis:1px";
    assert tokenDeclarations(.Flex.Basis.Auto) == "flex-basis:auto";
    assert tokenDeclarations(.Flex.Basis.Full) == "flex-basis:100%";
}

// The fractions are compared to front 35's rather than to a literal: `basis-1/3`
// and `w-1/3` are the same fraction, so they must be the same string.
test "a basis fraction and a width fraction are the same fraction" {
    val basisThird = tokenDeclarations(.Flex.Basis.Frac.Third)
        .split(":")
        .at(1) ?? "";
    val widthThird = tokenDeclarations(.Size.W.Frac.Third)
        .split(":")
        .at(1) ?? "";
    assert basisThird == widthThird;
    assert tokenDeclarations(.Flex.Basis.Frac.Third)
        == "flex-basis:calc(1 / 3 * 100%)";
    assert tokenDeclarations(.Flex.Basis.Frac.Half)
        == "flex-basis:calc(1 / 2 * 100%)";
    assert tokenDeclarations(.Flex.Basis.Frac.TwoThirds)
        == "flex-basis:calc(2 / 3 * 100%)";
}

test "order — a count, the two sentinels, and the one that is not a keyword" {
    assert tokenDeclarations(.Flex.Order.1) == "order:1";
    assert tokenDeclarations(.Flex.Order.2) == "order:2";
    assert tokenDeclarations(.Flex.Order.12) == "order:12";
    assert tokenDeclarations(.Flex.Order.First) == "order:-9999";
    assert tokenDeclarations(.Flex.Order.Last) == "order:9999";
    assert tokenDeclarations(.Flex.Order.None) == "order:0";
    assert tokenDeclarations(.Flex.Order.None).indexOf("none") == -1;
}

// ── tests · the alignment family ─────────────────────────────────────────────

test "justify-content — all eight values of `§ 6.16`, three of them new" {
    assert tokenDeclarations(.Flex.Justify.Normal) == "justify-content:normal";
    assert tokenDeclarations(.Flex.Justify.Start)
        == "justify-content:flex-start";
    assert tokenDeclarations(.Flex.Justify.End) == "justify-content:flex-end";
    assert tokenDeclarations(.Flex.Justify.Center) == "justify-content:center";
    assert tokenDeclarations(.Flex.Justify.Between)
        == "justify-content:space-between";
    assert tokenDeclarations(.Flex.Justify.Around)
        == "justify-content:space-around";
    assert tokenDeclarations(.Flex.Justify.Evenly)
        == "justify-content:space-evenly";
    assert tokenDeclarations(.Flex.Justify.Stretch)
        == "justify-content:stretch";
}

test "align-items — all five values of `§ 6.20`, `baseline` included" {
    assert tokenDeclarations(.Flex.Items.Start) == "align-items:flex-start";
    assert tokenDeclarations(.Flex.Items.End) == "align-items:flex-end";
    assert tokenDeclarations(.Flex.Items.Center) == "align-items:center";
    assert tokenDeclarations(.Flex.Items.Stretch) == "align-items:stretch";
    assert tokenDeclarations(.Flex.Items.Baseline) == "align-items:baseline";
}

test "align-self and align-content — the two families that had no token" {
    assert tokenDeclarations(.Flex.AlignSelf.Auto) == "align-self:auto";
    assert tokenDeclarations(.Flex.AlignSelf.Start) == "align-self:flex-start";
    assert tokenDeclarations(.Flex.AlignSelf.End) == "align-self:flex-end";
    assert tokenDeclarations(.Flex.AlignSelf.Center) == "align-self:center";
    assert tokenDeclarations(.Flex.AlignSelf.Stretch) == "align-self:stretch";
    assert tokenDeclarations(.Flex.AlignSelf.Baseline) == "align-self:baseline";
    assert tokenDeclarations(.Flex.Content.Normal) == "align-content:normal";
    assert tokenDeclarations(.Flex.Content.Start) == "align-content:flex-start";
    assert tokenDeclarations(.Flex.Content.End) == "align-content:flex-end";
    assert tokenDeclarations(.Flex.Content.Center) == "align-content:center";
    assert tokenDeclarations(.Flex.Content.Between)
        == "align-content:space-between";
    assert tokenDeclarations(.Flex.Content.Around)
        == "align-content:space-around";
    assert tokenDeclarations(.Flex.Content.Evenly)
        == "align-content:space-evenly";
    assert tokenDeclarations(.Flex.Content.Stretch) == "align-content:stretch";
}

test "justify-items and justify-self — the grid-side pair of `§ 6.18`/`§ 6.19`" {
    assert tokenDeclarations(.Flex.JustifyItems.Start) == "justify-items:start";
    assert tokenDeclarations(.Flex.JustifyItems.End) == "justify-items:end";
    assert tokenDeclarations(.Flex.JustifyItems.Center)
        == "justify-items:center";
    assert tokenDeclarations(.Flex.JustifyItems.Stretch)
        == "justify-items:stretch";
    assert tokenDeclarations(.Flex.JustifySelf.Auto) == "justify-self:auto";
    assert tokenDeclarations(.Flex.JustifySelf.Start) == "justify-self:start";
    assert tokenDeclarations(.Flex.JustifySelf.End) == "justify-self:end";
    assert tokenDeclarations(.Flex.JustifySelf.Center) == "justify-self:center";
    assert tokenDeclarations(.Flex.JustifySelf.Stretch)
        == "justify-self:stretch";
}

test "the three `place-*` shorthands, and `place-content-between` spells space" {
    assert tokenDeclarations(.Flex.PlaceContent.Center)
        == "place-content:center";
    assert tokenDeclarations(.Flex.PlaceContent.Start) == "place-content:start";
    assert tokenDeclarations(.Flex.PlaceContent.End) == "place-content:end";
    assert tokenDeclarations(.Flex.PlaceContent.Between)
        == "place-content:space-between";
    assert tokenDeclarations(.Flex.PlaceContent.Around)
        == "place-content:space-around";
    assert tokenDeclarations(.Flex.PlaceContent.Evenly)
        == "place-content:space-evenly";
    assert tokenDeclarations(.Flex.PlaceContent.Stretch)
        == "place-content:stretch";
    assert tokenDeclarations(.Flex.PlaceItems.Start) == "place-items:start";
    assert tokenDeclarations(.Flex.PlaceItems.End) == "place-items:end";
    assert tokenDeclarations(.Flex.PlaceItems.Center) == "place-items:center";
    assert tokenDeclarations(.Flex.PlaceItems.Stretch) == "place-items:stretch";
    assert tokenDeclarations(.Flex.PlaceSelf.Auto) == "place-self:auto";
    assert tokenDeclarations(.Flex.PlaceSelf.Start) == "place-self:start";
    assert tokenDeclarations(.Flex.PlaceSelf.End) == "place-self:end";
    assert tokenDeclarations(.Flex.PlaceSelf.Center) == "place-self:center";
    assert tokenDeclarations(.Flex.PlaceSelf.Stretch) == "place-self:stretch";
}

// THE ASYMMETRY, ASSERTED RATHER THAN NORMALISED. `justify-content:flex-start`
// and `justify-items:start` are both correct and both emitted, from different
// tokens whose leaves share a name. A transcription that picked one spelling
// for the family would be wrong for four of the seven property groups.
test "`flex-start` and `start` are both right, and each from its own token" {
    assert tokenDeclarations(.Flex.Justify.Start)
        == "justify-content:flex-start";
    assert tokenDeclarations(.Flex.Items.Start) == "align-items:flex-start";
    assert tokenDeclarations(.Flex.AlignSelf.Start) == "align-self:flex-start";
    assert tokenDeclarations(.Flex.Content.Start) == "align-content:flex-start";
    assert tokenDeclarations(.Flex.JustifyItems.Start) == "justify-items:start";
    assert tokenDeclarations(.Flex.JustifySelf.Start) == "justify-self:start";
    assert tokenDeclarations(.Flex.PlaceContent.Start) == "place-content:start";
    assert tokenDeclarations(.Flex.PlaceItems.Start) == "place-items:start";
    assert tokenDeclarations(.Flex.PlaceSelf.Start) == "place-self:start";
    assert tokenDeclarations(.Flex.JustifyItems.Start).indexOf("flex-start")
        == -1;
    assert tokenDeclarations(.Flex.PlaceItems.Start).indexOf("flex-start")
        == -1;
}

// ── tests · grid ─────────────────────────────────────────────────────────────

test "a column template is a repeat built from the leaf, with its spaces" {
    assert tokenDeclarations(.Grid.Cols.1)
        == "grid-template-columns:repeat(1, minmax(0, 1fr))";
    assert tokenDeclarations(.Grid.Cols.6)
        == "grid-template-columns:repeat(6, minmax(0, 1fr))";
    assert tokenDeclarations(.Grid.Cols.12)
        == "grid-template-columns:repeat(12, minmax(0, 1fr))";
    assert tokenDeclarations(.Grid.Rows.3)
        == "grid-template-rows:repeat(3, minmax(0, 1fr))";
    assert tokenDeclarations(.Grid.Cols.12).indexOf("repeat(12,minmax") == -1;
    assert tokenDeclarations(.Grid.Cols.12).indexOf("minmax(0,1fr)") == -1;
}

test "`none` and `subgrid` are keywords, not a repeat of anything" {
    assert tokenDeclarations(.Grid.Cols.None) == "grid-template-columns:none";
    assert tokenDeclarations(.Grid.Cols.Subgrid)
        == "grid-template-columns:subgrid";
    assert tokenDeclarations(.Grid.Rows.None) == "grid-template-rows:none";
    assert tokenDeclarations(.Grid.Rows.Subgrid)
        == "grid-template-rows:subgrid";
    assert tokenDeclarations(.Grid.Cols.None).indexOf("repeat") == -1;
}

// `repeat(…, minmax(0, 1fr))` is spelled in `gridRepeat` and nowhere else, and
// the `minmax(0, 1fr)` inside it is `gridFr`'s — the same string the implicit
// `fr` tracks read. Comparing the emitted values to the functions is what makes
// a second spelling impossible rather than merely absent today.
test "`gridRepeat` and `gridFr` are the only places those two strings live" {
    val cols = tokenDeclarations(.Grid.Cols.12).split(":").at(1) ?? "";
    val rows = tokenDeclarations(.Grid.Rows.12).split(":").at(1) ?? "";
    assert cols == gridRepeat("12");
    assert rows == gridRepeat("12");
    assert cols == rows;
    val autoCols = tokenDeclarations(.Grid.AutoCols.Fr).split(":").at(1) ?? "";
    val autoRows = tokenDeclarations(.Grid.AutoRows.Fr).split(":").at(1) ?? "";
    assert autoCols == gridFr();
    assert autoRows == gridFr();
    assert gridRepeat("12").indexOf(gridFr()) != -1;
}

test "a span is doubled, and `full` is the line-based form instead" {
    assert tokenDeclarations(.Grid.Col.Auto) == "grid-column:auto";
    assert tokenDeclarations(.Grid.Col.Span.1) == "grid-column:span 1 / span 1";
    assert tokenDeclarations(.Grid.Col.Span.2) == "grid-column:span 2 / span 2";
    assert tokenDeclarations(.Grid.Col.Span.12)
        == "grid-column:span 12 / span 12";
    assert tokenDeclarations(.Grid.Col.Span.Full) == "grid-column:1 / -1";
    assert tokenDeclarations(.Grid.Row.Auto) == "grid-row:auto";
    assert tokenDeclarations(.Grid.Row.Span.2) == "grid-row:span 2 / span 2";
    assert tokenDeclarations(.Grid.Row.Span.Full) == "grid-row:1 / -1";
}

// A twelve-column grid has thirteen lines, so `Start` and `End` run one past
// `Cols` and `Span`.
test "the thirteenth line exists, on both axes and on both ends" {
    assert tokenDeclarations(.Grid.Col.Start.1) == "grid-column-start:1";
    assert tokenDeclarations(.Grid.Col.Start.13) == "grid-column-start:13";
    assert tokenDeclarations(.Grid.Col.Start.Auto) == "grid-column-start:auto";
    assert tokenDeclarations(.Grid.Col.End.7) == "grid-column-end:7";
    assert tokenDeclarations(.Grid.Col.End.13) == "grid-column-end:13";
    assert tokenDeclarations(.Grid.Col.End.Auto) == "grid-column-end:auto";
    assert tokenDeclarations(.Grid.Row.Start.13) == "grid-row-start:13";
    assert tokenDeclarations(.Grid.Row.End.3) == "grid-row-end:3";
}

// THE FOUR SETS FRONT 37 DECLARED BY INTERPOLATION, now CONFIRMED against
// upstream v4 (4.3.2, compiled): `grid-cols-*`, `col-span-*`, `col-start-*`
// and `order-*` are functional utilities over any positive integer upstream,
// so every interpolated step exists, and each endpoint below is upstream's
// compiled declaration byte for byte.
test "the four interpolated sets — confirmed against upstream's compiled output" {
    assert tokenDeclarations(.Grid.Cols.7)
        == "grid-template-columns:repeat(7, minmax(0, 1fr))";
    assert tokenDeclarations(.Grid.Cols.11)
        == "grid-template-columns:repeat(11, minmax(0, 1fr))";
    assert tokenDeclarations(.Grid.Col.Span.3) == "grid-column:span 3 / span 3";
    assert tokenDeclarations(.Grid.Col.Span.12)
        == "grid-column:span 12 / span 12";
    assert tokenDeclarations(.Grid.Col.Start.2) == "grid-column-start:2";
    assert tokenDeclarations(.Grid.Col.Start.13) == "grid-column-start:13";
    assert tokenDeclarations(.Flex.Order.3) == "order:3";
    assert tokenDeclarations(.Flex.Order.12) == "order:12";
}

test "auto-flow keeps one space, and `col` is `column` in the value" {
    assert tokenDeclarations(.Grid.Flow.Row) == "grid-auto-flow:row";
    assert tokenDeclarations(.Grid.Flow.Col) == "grid-auto-flow:column";
    assert tokenDeclarations(.Grid.Flow.Dense) == "grid-auto-flow:dense";
    assert tokenDeclarations(.Grid.Flow.RowDense) == "grid-auto-flow:row dense";
    assert tokenDeclarations(.Grid.Flow.ColDense)
        == "grid-auto-flow:column dense";
    assert tokenDeclarations(.Grid.Flow.RowDense).indexOf("row-dense") == -1;
    assert tokenDeclarations(.Grid.Flow.Col).indexOf("flow:col;") == -1;
}

test "the implicit tracks — `min`/`max` are `-content`, `fr` is a minmax" {
    assert tokenDeclarations(.Grid.AutoCols.Auto) == "grid-auto-columns:auto";
    assert tokenDeclarations(.Grid.AutoCols.Min)
        == "grid-auto-columns:min-content";
    assert tokenDeclarations(.Grid.AutoCols.Max)
        == "grid-auto-columns:max-content";
    assert tokenDeclarations(.Grid.AutoCols.Fr)
        == "grid-auto-columns:minmax(0, 1fr)";
    assert tokenDeclarations(.Grid.AutoRows.Auto) == "grid-auto-rows:auto";
    assert tokenDeclarations(.Grid.AutoRows.Min)
        == "grid-auto-rows:min-content";
    assert tokenDeclarations(.Grid.AutoRows.Max)
        == "grid-auto-rows:max-content";
    assert tokenDeclarations(.Grid.AutoRows.Fr)
        == "grid-auto-rows:minmax(0, 1fr)";
}

// ── tests · gap ──────────────────────────────────────────────────────────────

test "gap — the shorthand over the ladder, and zero is the literal 0" {
    assert tokenDeclarations(.Gap.All.0) == "gap:0";
    assert tokenDeclarations(.Gap.All.1) == "gap:" + spacing(1);
    assert tokenDeclarations(.Gap.All.2) == "gap:" + spacing(2);
    assert tokenDeclarations(.Gap.All.4) == "gap:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Gap.All.96) == "gap:" + spacing(96);
    assert tokenDeclarations(.Gap.All.Px) == "gap:1px";
    assert tokenDeclarations(.Gap.All.Half.1) == "gap:" + spacingHalf(1);
}

test "gap — the two axes are two different properties" {
    assert tokenDeclarations(.Gap.X.1) == "column-gap:" + spacing(1);
    assert tokenDeclarations(.Gap.X.2) == "column-gap:calc(var(--spacing) * 2)";
    assert tokenDeclarations(.Gap.Y.1) == "row-gap:" + spacing(1);
    assert tokenDeclarations(.Gap.Y.6) == "row-gap:calc(var(--spacing) * 6)";
    assert tokenDeclarations(.Gap.X.0) == "column-gap:0";
    assert tokenDeclarations(.Gap.Y.Px) == "row-gap:1px";
}

// THE SEVENTH LADDER, CLOSED. `flexGapScale` answered `__4 -> "1rem"` — the
// last of the seven hand-written `rem` ladders front 54 found in this file, and
// the one front 35 could not delete because `Gap` is this front's section. The
// two spellings are compared to EACH OTHER rather than each to its own expected
// string, so they cannot drift apart again.
test "`.Flex.Gap.N` and `.Gap.All.N` are one declaration by two names" {
    assert tokenDeclarations(.Flex.Gap.1) == tokenDeclarations(.Gap.All.1);
    assert tokenDeclarations(.Flex.Gap.2) == tokenDeclarations(.Gap.All.2);
    assert tokenDeclarations(.Flex.Gap.4) == tokenDeclarations(.Gap.All.4);
    assert tokenDeclarations(.Flex.Gap.8) == tokenDeclarations(.Gap.All.8);
    assert tokenDeclarations(.Flex.Gap.4) == "gap:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Flex.Gap.4).indexOf("1rem") == -1;
    assert tokenDeclarations(.Flex.Gap.1).indexOf("0.25rem") == -1;
    assert tokenDeclarations(.Flex.Gap.8).indexOf("2rem") == -1;
}

// `spacing` is CALLED, not copied: the same class comes out under a theme whose
// `--spacing` is halved, because the rule references the variable instead of
// resolving it.
test "gap reads front 54's ladder, so halving `--spacing` moves no rule" {
    val tokens: Token[] = [.Layout.Grid, .Grid.Cols.12, .Gap.All.4];
    val tighter: ThemeEntry[] = [
        ThemeEntry(name: "--spacing", value: "0.125rem"),
    ];
    val tight = extendTheme(defaultTheme(), tighter);
    assert emiliaWith(tokens, defaultTheme()) == emiliaWith(tokens, tight);
    val doc = await flushWith(bareOptions());
    assert doc.indexOf(
        "display:grid;grid-template-columns:repeat(12, minmax(0, 1fr));"
            + "gap:calc(var(--spacing) * 4)",
    )
        != -1;
}

// ── the front's regression ───────────────────────────────────────────────────
//
// THE WHOLE ARGUMENT OF THIS FRONT'S NUMERIC FAMILIES, walked rather than
// sampled. Every leaf `Flex`, `Grid` and `Gap` declare — all 356 of them — is
// mapped and the output is checked for the two shapes that would mean a value
// was resolved here instead of referenced:
//
//   - a `rem` ANYWHERE. `Basis` and `Gap` must answer `calc(var(--spacing) * n)`;
//     a `rem` in either is `flexGapScale` reopened, and it would make a
//     project's `--spacing` override silently ineffective. `Grid` is not a
//     length at all, so a `rem` there would be nonsense as well as wrong.
//   - a CLASS FRAGMENT where a declaration belongs. `gap-4`, `basis-1/2`,
//     `grid-cols-12`, `col-span-2`, `flex-1` and `order-first` are UTILITY
//     names, not CSS; what reaches the document is `property:value`, so every
//     leaf carries a `:` and none carries the hyphenated utility spelling.
//
// THE CONTROL, moved twice. It was `.Border.Rounded.Lg` until front 40 rewrote
// that leaf to `var(--radius-lg)`, then `.Text.Size.Lg` until front 38 did the
// same to the type scale — NO token in emilia resolves a `rem` any more, which
// is what these walks exist to bring about, so the control is a hand-built
// declaration beside the same fact asserted from the other side. A `0.25rem`
// planted in one `gapScaleAll` arm was confirmed to fail the walk before it was
// taken out again.
fn flexLeaves() -> Token[] {
    val leaves: Token[] = [
        .Flex.Row,
        .Flex.RowReverse,
        .Flex.Col,
        .Flex.ColReverse,
        .Flex.Wrap,
        .Flex.WrapReverse,
        .Flex.NoWrap,
        .Flex.Value.One,
        .Flex.Value.Auto,
        .Flex.Value.Initial,
        .Flex.Value.None,
        .Flex.Grow.0,
        .Flex.Grow.1,
        .Flex.Shrink.0,
        .Flex.Shrink.1,
        .Flex.Basis.0,
        .Flex.Basis.1,
        .Flex.Basis.2,
        .Flex.Basis.3,
        .Flex.Basis.4,
        .Flex.Basis.5,
        .Flex.Basis.6,
        .Flex.Basis.7,
