    val out = case a {
        Auto -> "auto";
        Min -> "min-content";
        Max -> "max-content";
        Fr -> gridFr();
    };
    return out;
}

// ── gap · `§ 6.15` ───────────────────────────────────────────────────────────
//
// `Gap` IS TOP LEVEL. `gap` applies to a grid container exactly as it applies
// to a flex one, so a sub-section of `Flex` would be the wrong home for it and
// `§ 6.15` treats it as one row of one chapter. It carries front 35's scale
// and answers `spacing(n)` / `spacingHalf(n)`, so `.Gap.All.4` and `.Pad.All.4`
// are the same length by construction rather than by two tables agreeing today.

fn gapTokenToCss(t: Token.Gap, th: Theme) -> string {
    val out = case t {
        All(_inner) -> oneDecl("gap", gapScaleAll(_inner, th));
        X(_inner) -> oneDecl("column-gap", gapScaleX(_inner, th));
        Y(_inner) -> oneDecl("row-gap", gapScaleY(_inner, th));
    };
    return out;
}

fn gapScaleAll(s: Token.Gap.All, th: Theme) -> string {
    val out = case s {
        __0 -> spacing(0);
        __1 -> spacing(1);
        __2 -> spacing(2);
        __3 -> spacing(3);
        __4 -> spacing(4);
        __5 -> spacing(5);
        __6 -> spacing(6);
        __7 -> spacing(7);
        __8 -> spacing(8);
        __9 -> spacing(9);
        __10 -> spacing(10);
        __11 -> spacing(11);
        __12 -> spacing(12);
        __14 -> spacing(14);
        __16 -> spacing(16);
        __20 -> spacing(20);
        __24 -> spacing(24);
        __28 -> spacing(28);
        __32 -> spacing(32);
        __36 -> spacing(36);
        __40 -> spacing(40);
        __44 -> spacing(44);
        __48 -> spacing(48);
        __52 -> spacing(52);
        __56 -> spacing(56);
        __60 -> spacing(60);
        __64 -> spacing(64);
        __72 -> spacing(72);
        __80 -> spacing(80);
        __96 -> spacing(96);
        Px -> "1px";
        Half(_inner) -> gapHalfAll(_inner, th);
    };
    return out;
}

fn gapHalfAll(h: Token.Gap.All.Half, th: Theme) -> string {
    val out = case h {
        __0 -> spacingHalf(0);
        __1 -> spacingHalf(1);
        __2 -> spacingHalf(2);
        __3 -> spacingHalf(3);
    };
    return out;
}

