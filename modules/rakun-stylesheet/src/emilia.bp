}

test "regression — every one of the 910 leaves declares something" {
    val leaves = backgroundLeaves();
    assert leaves.length == 910;
    assert leaves.all({ t -> bgIsWellFormed(tokenDeclarations(t)) });
}

test "regression — the well-formedness walk discriminates" {
    assert bgIsWellFormed("") == false;
    assert bgIsWellFormed("background-size") == false;
    assert bgIsWellFormed("background-size:cover");
    val leaves = backgroundLeaves();
    assert leaves.all({ t -> tokenDeclarations(t).indexOf("background") != -1 })
        == false;
    assert leaves.all({ t -> tokenDeclarations(t).indexOf(";") != -1 })
        == false;
}

test "regression — no background leaf resolves a colour or a length" {
    val leaves = backgroundLeaves();
    assert leaves.all({ t -> bgCarriesNoLiteral(tokenDeclarations(t)) });
}

test "regression — the literal walk discriminates, on real tokens" {
    assert bgCarriesNoLiteral(tokenDeclarations(.Bg.White)) == false;
    // front 38 made `.Text.Size.Lg` a reference; the `rem` arm of the probe
    // is shown to discriminate on a hand-built declaration instead.
    assert bgCarriesNoLiteral("font-size:1.125rem") == false;
    assert bgCarriesNoLiteral(tokenDeclarations(.Bg.Color.Red.500));
    val strays: Token[] = [.Bg.White];
    val planted: Token[] = backgroundLeaves().append(strays);
    assert planted.all({ t -> bgCarriesNoLiteral(tokenDeclarations(t)) })
        == false;
}

test "regression — no background leaf emits a Tailwind class fragment" {
    val leaves = backgroundLeaves();
    assert leaves.all({ t -> bgCarriesNoClassFragment(tokenDeclarations(t)) });
}

test "regression — the class-fragment walk discriminates" {
    assert bgCarriesNoClassFragment("background-image:bg-gradient-to-r")
        == false;
    assert bgCarriesNoClassFragment("background-clip:bg-clip-text") == false;
    assert bgCarriesNoClassFragment("--tw-gradient-from:from-indigo-500")
        == false;
    assert bgCarriesNoClassFragment("--tw-gradient-via:via-purple-500")
        == false;
    assert bgCarriesNoClassFragment("background-size:cover");
}

test "regression — every colour stop is a reference, and every one is distinct" {
    val cells: Token[] = [
        .Gradient.From.Red.50,
        .Gradient.From.Red.950,
        .Gradient.Via.Taupe.500,
        .Gradient.Stop.Mist.300,
    ];
    assert cells.all(
        { t -> tokenDeclarations(t).indexOf("var(--color-") != -1 },
    );
    assert tokenDeclarations(.Gradient.From.Red.50)
        != tokenDeclarations(.Gradient.From.Red.950);
    assert tokenDeclarations(.Gradient.From.Red.500)
        != tokenDeclarations(.Gradient.Via.Red.500);
    assert tokenDeclarations(.Gradient.Via.Red.500)
        != tokenDeclarations(.Gradient.Stop.Red.500);
}

