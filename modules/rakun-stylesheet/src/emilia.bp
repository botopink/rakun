// ── front 39 · tests · the stops ─────────────────────────────────────────────

test "gradient stops — `From` sets its colour and the two-stop list" {
    assert tokenDeclarations(.Gradient.From.Indigo.500)
        == "--tw-gradient-from:var(--color-indigo-500);"
            + "--tw-gradient-stops:var(--tw-gradient-from), var(--tw-gradient-to, transparent)";
}

test "gradient stops — `Via` sets its colour and the three-stop list" {
    assert tokenDeclarations(.Gradient.Via.Purple.500)
        == "--tw-gradient-via:var(--color-purple-500);"
            + "--tw-gradient-stops:var(--tw-gradient-from, transparent), var(--tw-gradient-via),"
            + " var(--tw-gradient-to, transparent)";
}

test "gradient stops — `Stop` sets the terminal colour AND NOTHING ELSE" {
    assert tokenDeclarations(.Gradient.Stop.Pink.500)
        == "--tw-gradient-to:var(--color-pink-500)";
    assert tokenDeclarations(.Gradient.Stop.Pink.500).indexOf(
        "--tw-gradient-stops",
    )
        == -1;
}

test "gradient stops — the five named colours, on each of the three stops" {
    assert tokenDeclarations(.Gradient.From.Transparent).indexOf(
        "--tw-gradient-from:transparent",
    )
        == 0;
    assert tokenDeclarations(.Gradient.Via.Current).indexOf(
        "--tw-gradient-via:currentColor",
    )
        == 0;
    assert tokenDeclarations(.Gradient.Stop.Transparent)
        == "--tw-gradient-to:transparent";
    assert tokenDeclarations(.Gradient.Stop.Current)
        == "--tw-gradient-to:currentColor";
    assert tokenDeclarations(.Gradient.Stop.Inherit)
        == "--tw-gradient-to:inherit";
    assert tokenDeclarations(.Gradient.Stop.White)
        == "--tw-gradient-to:var(--color-white)";
    assert tokenDeclarations(.Gradient.Stop.Black)
        == "--tw-gradient-to:var(--color-black)";
}

test "gradient stops — the stop and the background read ONE custom property" {
    val shared = paletteVar("indigo", "500");
    assert tokenDeclarations(.Gradient.From.Indigo.500).indexOf(shared) != -1;
    assert tokenDeclarations(.Bg.Color.Indigo.500).indexOf(shared) != -1;
    assert shared == "var(--color-indigo-500)";
    assert tokenDeclarations(.Gradient.Via.Indigo.500).indexOf(shared) != -1;
    assert tokenDeclarations(.Gradient.Stop.Indigo.500).indexOf(shared) != -1;
}

test "gradient stops — a project override reaches the stop, not just the background" {
    val brand: ThemeEntry[] = [
        ThemeEntry(name: "--color-indigo-500", value: "#4040ff"),
    ];
    val th = extendTheme(extendTheme(defaultTheme(), paletteEntries()), brand);
    assert themeValue(th, "--color-indigo-500") == "#4040ff";
    assert tokenDeclarations(.Gradient.From.Indigo.500).indexOf("#4040ff")
        == -1;
    assert tokenDeclarations(.Gradient.From.Indigo.500).indexOf(
        "var(--color-indigo-500)",
    )
        != -1;
}

test "gradient stops — `From` alone still paints, because the terminal has a fallback" {
    val decls = tokenDeclarations(.Gradient.From.Indigo.500);
    assert decls.indexOf("var(--tw-gradient-to, transparent)") != -1;
    assert decls.indexOf("var(--tw-gradient-to)") == -1;
}

test "gradient stops — `From` + `Stop` is a two-colour list" {
    val toks: Token[] = [
        .Gradient.To.R,
        .Gradient.From.Indigo.500,
        .Gradient.Stop.Pink.500,
    ];
    val decls = declarationsOf(tokensToSheet(toks, defaultTheme())).join(";");
    assert decls.indexOf("linear-gradient(to right, var(--tw-gradient-stops))")
        != -1;
    assert decls.indexOf("--tw-gradient-from:var(--color-indigo-500)") != -1;
    assert decls.indexOf("--tw-gradient-to:var(--color-pink-500)") != -1;
    assert decls.indexOf("--tw-gradient-via") == -1;
}

test "gradient stops — `From` + `Via` + `Stop` composes, and order is load-bearing" {
    val toks: Token[] = [
        .Gradient.From.Indigo.500,
        .Gradient.Via.Purple.500,
        .Gradient.Stop.Pink.500,
    ];
    val decls = declarationsOf(tokensToSheet(toks, defaultTheme())).join(";");
    val twoStop = "--tw-gradient-stops:var(--tw-gradient-from), var(--tw-gradient-to, transparent)";
    val threeStop = "--tw-gradient-stops:var(--tw-gradient-from, transparent), var(--tw-gradient-via),"
        + " var(--tw-gradient-to, transparent)";
    assert decls.indexOf(twoStop) != -1;
    assert decls.indexOf(threeStop) != -1;
    assert decls.indexOf(threeStop) > decls.indexOf(twoStop);
}

test "gradient stops — reversing the two lists reverses which one wins" {
    val forward: Token[] = [
        .Gradient.From.Indigo.500,
        .Gradient.Via.Purple.500,
    ];
    val backward: Token[] = [
        .Gradient.Via.Purple.500,
        .Gradient.From.Indigo.500,
    ];
    val a = declarationsOf(tokensToSheet(forward, defaultTheme())).join(";");
    val b = declarationsOf(tokensToSheet(backward, defaultTheme())).join(";");
    assert a != b;
    assert a.indexOf("--tw-gradient-via),") != -1;
    assert b.indexOf("--tw-gradient-via),") != -1;
    assert a.indexOf("var(--tw-gradient-from),") != -1;
    assert b.indexOf("var(--tw-gradient-from),") != -1;
    assert a.indexOf("--tw-gradient-via),")
        > a.indexOf("var(--tw-gradient-from),");
    assert b.indexOf("--tw-gradient-via),")
        < b.indexOf("var(--tw-gradient-from),");
}

test "end to end — a gradient call to action is one class and one rule" {
    val cta: Token[] = [
        .Gradient.To.R,
        .Gradient.From.Indigo.500,
        .Gradient.Stop.Pink.500,
    ];
    val cls = emilia(cta);
    val styles = await flushWith(bareOptions());
    assert styles
        == "<style>@layer theme, base, components, utilities;@layer utilities{."
            + cls
            + "{background-image:linear-gradient(to right, var(--tw-gradient-stops));"
            + "--tw-gradient-from:var(--color-indigo-500);"
            + "--tw-gradient-stops:var(--tw-gradient-from), var(--tw-gradient-to, transparent);"
            + "--tw-gradient-to:var(--color-pink-500)}}</style>";
}

test "end to end — gradient text is a clip and a gradient in one rule" {
    val heading: Token[] = [
        .Bg.Clip.Text,
        .Gradient.To.Br,
        .Gradient.From.Sky.400,
        .Gradient.Stop.Fuchsia.600,
        .Color.Transparent,
    ];
    val cls = emilia(heading);
    val styles = await flushWith(bareOptions());
    assert styles.indexOf("background-clip:text") != -1;
    assert styles.indexOf(
        "linear-gradient(to bottom right, var(--tw-gradient-stops))",
    )
        != -1;
    assert styles.indexOf("--tw-gradient-from:var(--color-sky-400)") != -1;
    assert styles.indexOf("--tw-gradient-to:var(--color-fuchsia-600)") != -1;
    assert styles.indexOf("." + cls + "{") != -1;
}

test "end to end — a hero photograph covers its box and is anchored to the top" {
    val hero: Token[] = [
        .Bg.Size.Cover,
        .Bg.Pos.Top,
        .Bg.Repeat.None,
        .Bg.Attachment.Fixed,
    ];
    val cls = emilia(hero);
    val styles = await flushWith(bareOptions());
    assert styles
        == "<style>@layer theme, base, components, utilities;@layer utilities{."
            + cls
            + "{background-size:cover;background-position:top;"
            + "background-repeat:no-repeat;background-attachment:fixed}}</style>";
}

// ── front 39 · the regression ────────────────────────────────────
//
// The three predicates below take a DECLARATION STRING rather than a token, so
// the same function that walks 910 leaves can be handed a string that is known
// to violate it. A walk that cannot be made to fail proves nothing, which is
// the lesson fronts 35 and 36 wrote down; the controls under each walk are it.
//
// `bgIsWellFormed` is not boilerplate: an arm whose pattern is SHADOWED does
// not red, it falls out of the `case` and the token declares the EMPTY STRING.
// Front 36 was bitten by the live form of that — a section head named like a
// top-level payload variant (`Layout.Break { After, Before }` beside front 34's
// `After`/`Before`), which broke the OTHER front's payload projection and
// showed up nowhere near the section that caused it. 910 leaves through this
// predicate is this front's guard against declaring nothing silently.

fn bgIsWellFormed(decl: string) -> bool {
    return decl.length > 0 && decl.indexOf(":") != -1;
}

// No background leaf resolves a colour or a length: a stop is a reference to
// front 33's palette and a keyword leaf is a CSS keyword. A `#`, an `oklch(`,
// an `rgb(` or a `rem` here is a literal that escaped the theme.
fn bgCarriesNoLiteral(decl: string) -> bool {
    return decl.indexOf("#") == -1
        && decl.indexOf("oklch(") == -1
        && decl.indexOf("rgb(") == -1
        && decl.indexOf("rem") == -1;
}

// No leaf emits a Tailwind CLASS NAME where a CSS value belongs — the failure
// mode of transcribing a reference table into the value column.
fn bgCarriesNoClassFragment(decl: string) -> bool {
    return decl.indexOf("bg-") == -1
        && decl.indexOf("from-") == -1
        && decl.indexOf("via-") == -1
        && decl.indexOf("gradient-to-") == -1;
}

// Every leaf of this front, in one list: the 29 keyword leaves of `Bg`, the
// eight directions, and the 873 stops (three stops over front 33's 286 cells
// plus its five named colours).
