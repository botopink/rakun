// Decision 401 · MEASURED AGAINST TAILWIND 4.3.2: `group-hover/card:underline`
// compiles to `.group-hover\\/card\\:underline { &:is(:where(.group\\/card):hover *)
// { … } }` (4.3.2 also wraps hover in `@media (hover: hover)`; the unnamed
// `GroupHover` here does not, and the named form keeps the unnamed form's
// shape), and `peer-checked/foo:underline` to
// `&:is(:where(.peer\\/foo):checked ~ *)`.
test "named groups — `group-<state>/card`, the unnamed selector with the name on the class" {
    val inner = boldInner();
    val hover: Token[] = [Token.GroupHover(inner)];
    assert modifierCss(Token.GroupNamed("card", hover))
        == ".x:is(:where(.group\\/card):hover *){font-weight:bold}";
    val open: Token[] = [Token.GroupOpen(inner)];
    assert modifierCss(Token.GroupNamed("card", open))
        == ".x:is(:where(.group\\/card):is([open], :popover-open, :open) *){font-weight:bold}";
    val every: Token[] = [
        Token.GroupFocus(inner),
        Token.GroupActive(inner),
        Token.GroupVisited(inner),
        Token.GroupDisabled(inner),
    ];
    val css = modifierCssAll(Token.GroupNamed("a-b_1", every));
    assert css.indexOf(":where(.group\\/a-b_1):focus *") != -1;
    assert css.indexOf(":where(.group\\/a-b_1):active *") != -1;
    assert css.indexOf(":where(.group\\/a-b_1):visited *") != -1;
    assert css.indexOf(":where(.group\\/a-b_1):disabled *") != -1;
    assert css.indexOf(":where(.group)") == -1;
}

test "named peers — `peer-<state>/field`, the unnamed selector with the name on the class" {
    val inner = boldInner();
    val checked: Token[] = [Token.PeerChecked(inner)];
    assert modifierCss(Token.PeerNamed("foo", checked))
        == ".x:is(:where(.peer\\/foo):checked ~ *){font-weight:bold}";
    val every: Token[] = [
        Token.PeerHover(inner),
        Token.PeerFocus(inner),
        Token.PeerActive(inner),
        Token.PeerInvalid(inner),
        Token.PeerRequired(inner),
        Token.PeerDisabled(inner),
        Token.PeerPlaceholderShown(inner),
    ];
    val css = modifierCssAll(Token.PeerNamed("foo", every));
    assert css.indexOf(":where(.peer\\/foo):hover ~ *") != -1;
    assert css.indexOf(":where(.peer\\/foo):focus ~ *") != -1;
    assert css.indexOf(":where(.peer\\/foo):active ~ *") != -1;
    assert css.indexOf(":where(.peer\\/foo):invalid ~ *") != -1;
    assert css.indexOf(":where(.peer\\/foo):required ~ *") != -1;
    assert css.indexOf(":where(.peer\\/foo):disabled ~ *") != -1;
    assert css.indexOf(":where(.peer\\/foo):placeholder-shown ~ *") != -1;
    assert css.indexOf(":where(.peer)") == -1;
}

test "named groups and peers — the other family and other tokens pass through, a bad name panics" {
    val inner = boldInner();
    val mixed: Token[] = [Token.PeerHover(inner), Token.Hover(inner)];
    val css = modifierCssAll(Token.GroupNamed("card", mixed));
    assert css.indexOf(":where(.peer):hover ~ *") != -1;
    assert css.indexOf(".x:hover{font-weight:bold}") != -1;
    val none: Token[] = [];
    val m = panicMessage({ ->
        val t = groupClassOf("a}b");
        0
    });
    assert m.indexOf("group: a name may contain") != -1;
    val p = panicMessage({ ->
        val t = peerClassOf("");
        0
    });
    assert p.indexOf("peer: a name may contain") != -1;
}

