        == -1;
}

test "BackdropFilter.Blur — the same eight leaves on backdrop-filter" {
    assert tokenDeclarations(.BackdropFilter.Blur.None)
        == "backdrop-filter:none";
    assert tokenDeclarations(.BackdropFilter.Blur.Xs)
