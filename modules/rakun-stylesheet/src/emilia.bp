// `divideTokenToSheet` IS THE SECOND `…ToSheet`. `divide-*` declares on the
// element's CHILDREN — a border on every child but the last — so it needs a
// selector outside the class, exactly as front 35's `space-*` does. It calls
// front 35's `childSheet`, which calls front 35's `siblingSelector()`: the
// child selector is spelled in ONE place for both fronts, and a test below
// asserts the two families emit byte-identical selectors. Writing
// `& > :not(:last-child)` again here is the one thing this front must not do.
//
// The pair is ordered zero-then-width, as upstream emits it: `divide-x-2` is
// `border-inline-start-width:0px;border-inline-end-width:2px`. Both the
// selector and the pair were VERIFIED against upstream v4 while writing this.
fn divideTokenToSheet(t: Token.Divide, th: Theme) -> Sheet {
    val out = case t {
        X(_inner) -> childSheet(
            reversePair(
                "--tw-divide-x-reverse",
                "border-inline-start-width",
                "border-inline-end-width",
                divideXValue(_inner),
            ),
        );
        Y(_inner) -> childSheet(
            reversePair(
                "--tw-divide-y-reverse",
                "border-top-width",
                "border-bottom-width",
                divideYValue(_inner),
            ),
        );
        Color(_inner) -> childSheet(divideColorToCss(_inner, th));
        Style(_inner) -> childSheet(divideStyleToCss(_inner));
        XReverse -> childSheet(oneDecl("--tw-divide-x-reverse", "1"));
        YReverse -> childSheet(oneDecl("--tw-divide-y-reverse", "1"));
    };
    return out;
}

// The leading edge is zeroed and the trailing edge carries the width, so a
// run of children shows exactly one rule between each pair.
fn divideXValue(s: Token.Divide.X) -> string {
    val out = case s {
        __0 -> "0px";
        __1 -> "1px";
        __2 -> "2px";
        __4 -> "4px";
        __8 -> "8px";
    };
    return out;
}

fn divideYValue(s: Token.Divide.Y) -> string {
    val out = case s {
        __0 -> "0px";
        __1 -> "1px";
        __2 -> "2px";
        __4 -> "4px";
        __8 -> "8px";
    };
    return out;
}

fn divideColorToCss(c: Token.Divide.Color, th: Theme) -> string {
    val out = case c {
        Red(_inner) -> "border-color:"
            + paletteVar("red", divideColorRedShade(_inner));
        Orange(_inner) -> "border-color:"
            + paletteVar("orange", divideColorOrangeShade(_inner));
        Amber(_inner) -> "border-color:"
            + paletteVar("amber", divideColorAmberShade(_inner));
        Yellow(_inner) -> "border-color:"
            + paletteVar("yellow", divideColorYellowShade(_inner));
        Lime(_inner) -> "border-color:"
            + paletteVar("lime", divideColorLimeShade(_inner));
        Green(_inner) -> "border-color:"
            + paletteVar("green", divideColorGreenShade(_inner));
        Emerald(_inner) -> "border-color:"
            + paletteVar("emerald", divideColorEmeraldShade(_inner));
        Teal(_inner) -> "border-color:"
            + paletteVar("teal", divideColorTealShade(_inner));
        Cyan(_inner) -> "border-color:"
            + paletteVar("cyan", divideColorCyanShade(_inner));
        Sky(_inner) -> "border-color:"
            + paletteVar("sky", divideColorSkyShade(_inner));
        Blue(_inner) -> "border-color:"
