//// The `rakun-stylesheet` package — module-tree root.
////
//// The test-helper member every library carries (front 95,
//// `specs/02-packaging/README.md` § 5): `assert<Subject>(loc, …)
//// -> Result<void, string>` snapshot helpers over compiled CSS, fixtures and
//// builders that know emilia's types, standing on std's asserts and
//// snapshots. Created empty by front 95; the helpers
//// (`specs/05-emilia/modules.md` § Verdict) are added by the
//// track-D fronts. A consumer adds `"rakun-stylesheet"` to its dependencies; it
//// re-exports nothing from std, and mocking is std's (decision 71).

import {spacing.spacing};

test "rakun-stylesheet: the core member resolves from the test member" {
    assert spacing(2) == "calc(var(--spacing) * 2)";
}
