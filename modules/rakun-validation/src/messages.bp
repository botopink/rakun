//// rakun-validation — message templates and their interpolation.
////
//// A violation's `message` is a TEMPLATE resolved at validation time, not a
//// string frozen at compile time, so an application can restate every
//// `sizeBetween` message once instead of per field. Resolution order:
////
////   1. `rakun.validation.messages.<locale>.<code>`
////   2. `rakun.validation.messages.<code>`
////   3. the built-in default for that code
////
//// The locale is the property `rakun.validation.locale` — front 05's table,
//// read through `rkProp`, which answers `""` for a key nothing set. Front 64
//// owns route-segment locale negotiation and does not exist yet; when it does,
//// it sets this key and nothing here changes.
////
//// Placeholders are `{field}`, `{value}` and the constraint's own parameters
//// (`{min}`, `{max}`, `{regex}`, `{name}`), substituted BY NAME. A template
//// naming a placeholder the constraint does not have is left as written rather
//// than blanked: a visible `{limit}` in an error message is a bug report, and
//// an empty string is not.

import {rkProp} from "rakun";

// One placeholder binding. `name` is written without the braces.
pub type Arg(
    name: string,
    value: string,
)

pub fn arg(name: string, value: string) -> Arg {
    return Arg(name: name, value: value);
}

pub fn messagePrefix() -> string {
    return "rakun.validation.messages.";
}

pub fn localeKey() -> string {
    return "rakun.validation.locale";
}

pub fn currentLocale() -> string {
    return rkProp(localeKey());
}

// The template for `code`, in resolution order. `builtIn` is step 3 and is
// always non-empty, so this never answers `""` for a known code.
pub fn templateFor(code: string, builtIn: string) -> string {
    val loc = currentLocale();
    val localized = if (loc == "") "" else rkProp(messagePrefix() + loc + "." + code);
    if (localized != "") return localized;
    val global = rkProp(messagePrefix() + code);
    if (global != "") return global else return builtIn;
}

// Substitution by name. Unknown placeholders survive verbatim because nothing
// here scans for braces — only the bindings the constraint actually passed are
// replaced.
pub fn interpolate(template: string, args: Array<Arg>) -> string {
    return args.fold(template, { acc, a -> acc.replaceAll("{" + a.name + "}", a.value) });
}

// The message a constraint reports: its template, resolved, with `{field}` and
// `{value}` always bound and the constraint's own parameters appended.
pub fn message(
    code: string,
    builtIn: string,
    field: string,
    value: string,
    params: Array<Arg>,
) -> string {
    val base: Array<Arg> = [arg("field", field), arg("value", value)];
    return interpolate(templateFor(code, builtIn), base.append(params));
}

pub fn noArgs() -> Array<Arg> {
    val none: Array<Arg> = [];
    return none;
}

// ── the built-in defaults ───────────────────────────────────────────────────
//
// One function rather than a table, because a decorator body cannot reach a
// table and a test can read every arm from here.

pub fn builtInTemplate(code: string) -> string {
    if (code == "notNull") return "must not be null";
    if (code == "notBlank") return "must not be blank";
    if (code == "notEmpty") return "must not be empty";
    if (code == "sizeBetween") return "size must be between {min} and {max}";
    if (code == "minValue") return "must be at least {min}";
    if (code == "maxValue") return "must be at most {max}";
    if (code == "positive") return "must be greater than 0";
    if (code == "positiveOrZero") return "must be greater than or equal to 0";
    if (code == "email") return "must be a well-formed email address";
    if (code == "pattern") return "must match {regex}";
    if (code == "pastDate") return "must be in the past";
    if (code == "futureDate") return "must be in the future";
    if (code == "unknownConstraint") return "names the constraint {name}, which is not registered - registered: [{registered}]";
    if (code == "typeMismatch") return "must be a {type}";
    if (code == "required") return "must be present";
    return "is not valid";
}

// An i32 rendered as a decimal string by `Array<i32>.join("")`: node's `join`
// calls `String(n)` per element and erlang's maps `is_integer(__E) ->
// integer_to_binary(__E)`, so the single-element array is a cross-backend
// `int_to_string` with no hand-rolled walk. The same shape answers for `i64`
// and `f64`.
pub fn showI32(n: i32) -> string {
    return [n].join("");
}

pub fn showI64(n: i64) -> string {
    return [n].join("");
}

pub fn showF64(n: f64) -> string {
    return [n].join("");
}
