import {html};
import {nav, section, h2, span, p, text, renderToString} from "jhonstart";

test "a tag from the element surface resolves inside an html template" {
    val bar = html "<nav><span>home</span></nav>";
    assert renderToString(bar) == "<nav><span>home</span></nav>";
    assert renderToString(bar)
        == renderToString(
            nav([span([text("home", attrs: [])], attrs: [])], attrs: []),
        );
}

test "a template mixing an element.bp tag with an elements.bp tag resolves both" {
    val page = html "<section><p>hi</p></section>";
    assert renderToString(page) == "<section><p>hi</p></section>";
    val deeper = html "<section><h2>Posts</h2><p>hi</p></section>";
    assert renderToString(deeper)
        == "<section><h2>Posts</h2><p>hi</p></section>";
}

test "an expression attribute reaches attrs on an elements.bp tag" {
    val c = "card";
    val bar = html "<nav class={c}><span>x</span></nav>";
    assert renderToString(bar) == "<nav class=\"card\"><span>x</span></nav>";
}
