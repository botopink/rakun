import {html};
import {Element, div, p, br, span, text, fragment, renderNode} from "jhonstart";

test "defect: a static attribute reaches the rendered tree" {
    assert renderNode(html """<div class="card"><p>x</p></div>""")
        == "<div class=\"card\"><p>x</p></div>";
}

test "defect: an attribute value with a space keeps both words" {
    assert renderNode(html """<p title="two words">x</p>""")
        == "<p title=\"two words\">x</p>";
}

test "defect: a nested self-closing tag renders where it is written" {
    assert renderNode(html "<p>a<br/>b</p>") == "<p>a<br>b</p>";
}

test "defect: an Element-valued hole is a child, not text" {
    val inner: Element = span([text("new", attrs: [])], attrs: []);
    assert renderNode(html "<p>{inner}</p>") == "<p><span>new</span></p>";
}
