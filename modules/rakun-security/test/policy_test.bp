//// rakun-security — the policy (front 10 step 2) and the context the entry
//// installs (step 1).
////
//// The chain here is driven through `runChain` with a terminal closure rather
//// than through the router: what is asserted is the entry's decision and the
//// context it hands the rest of the chain.

import {testing.asserts, async, regex.Regex} from "std";
import {Response, rkSetProp, rkReqSleep} from "rakun";
import {resetChain, runChain, rkChainSetTerminal, registerFilter, orderCors, orderProblem, orderRequestId, chainOrdering, errorEntry, withHeader, headerValue, Matcher} from "rakun-web";
import {Authentication, anonymous, authenticatedAs, currentAuthentication, withAuthentication, rkSecDecision, outsideRequestProblem} from "principal";
import {
    PathRule,
    SecurityPolicy,
    CompiledPolicy,
    CompiledRule,
    Decision,
    compilePolicy,
    compileOrFail,
    decide,
    defaultPolicy,
    admits,
    requiredAuthority,
    permissiveDefaultProblem,
} from "policy";
import {installSecurityWith, lastPrincipal} from "security_filter";
import {testToken} from "jwt";

fn secret() -> string {
    return "front-10-test-secret-0123456789abcdef";
}

fn rules() -> SecurityPolicy {
    return SecurityPolicy(
        rules: [
            PathRule(pattern: "/api/public/:path*", requirement: "permitAll"),
            PathRule(pattern: "/api/admin/:path*", requirement: "hasRole:ADMIN"),
            PathRule(pattern: "/api/:path*", requirement: "authenticated"),
        ],
        defaultRequirement: "authenticated",
    );
}

fn echoPrincipal() -> i32 {
    return rkChainSetTerminal({ method, path, headersWire, queryWire, body ->
        Response.ok("handled " + currentAuthentication().principal.name);
    });
}

fn chainWith(p: SecurityPolicy) -> i32 {
    val _r = resetChain();
    val _s = rkSetProp("rakun.security.jwt.secret", secret());
    val _i = installSecurityWith(p);
    return echoPrincipal();
}

fn bearerWire(token: string) -> string {
    return "authorization\tBearer " + token;
}

fn render(p: CompiledPolicy, path: string) -> string {
    val d: Decision = decide(p, path);
    return d.pattern + " " + d.requirement;
}

// ── step 2: the policy ──────────────────────────────────────────────────────

test "policy: rules match in declaration order and the first match wins" {
    val p: CompiledPolicy = compileOrFail(rules());
    assert render(p, "/api/admin/audit") == "/api/admin/:path* hasRole:ADMIN";
    assert render(p, "/api/orders/mine") == "/api/:path* authenticated";
    // The same two rules the other way round: the broad one now shadows the
    // narrow one, because order — not specificity — decides.
    val shadowed: CompiledPolicy = compileOrFail(SecurityPolicy(
        rules: [
            PathRule(pattern: "/api/:path*", requirement: "authenticated"),
            PathRule(pattern: "/api/admin/:path*", requirement: "hasRole:ADMIN"),
        ],
        defaultRequirement: "authenticated",
    ));
    assert render(shadowed, "/api/admin/audit") == "/api/:path* authenticated";
}

test "policy: /api/public/** before /api/** makes only the public subtree public" {
    val p: CompiledPolicy = compileOrFail(rules());
    assert render(p, "/api/public/health") == "/api/public/:path* permitAll";
    assert render(p, "/api/public") == "/api/public/:path* permitAll";
    assert render(p, "/api/publicity") == "/api/:path* authenticated";
    assert render(p, "/api/orders") == "/api/:path* authenticated";
    val _c = chainWith(rules());
    assert runChain("GET", "/api/public/health", "", "", "").status == 200;
    assert runChain("GET", "/api/orders", "", "", "").status == 401;
}

test "policy: a path with no rule requires authentication" {
    val p: CompiledPolicy = compileOrFail(rules());
    assert render(p, "/internal/metrics") == "default authenticated";
    val _c = chainWith(rules());
    val res: Response = runChain("GET", "/internal/metrics", "", "", "");
    assert res.status == 401;
    assert rkSecDecision() == "denied default authenticated";
}

test "policy: defaultRequirement permitAll fails at boot" {
    val open = SecurityPolicy(rules: [], defaultRequirement: "permitAll");
    assert compilePolicy(open).isError();
    try asserts.throwsWith({ ->
        val _i = installSecurityWith(open);
        0;
    }, "defaultRequirement is permitAll is refused");
    assert permissiveDefaultProblem().contains("no way to make it public by default");
}

test "policy: an unknown requirement or a pattern front 65 refuses fails at boot naming it" {
    val odd = SecurityPolicy(rules: [PathRule(pattern: "/x", requirement: "hasRole")], defaultRequirement: "authenticated");
    try asserts.throwsWith({ ->
        val _c = compileOrFail(odd);
        0;
    }, "the rule for `/x` has the requirement `hasRole`");
    val noSlash = SecurityPolicy(rules: [PathRule(pattern: "api", requirement: "permitAll")], defaultRequirement: "authenticated");
    try asserts.throwsWith({ ->
        val _c = compileOrFail(noSlash);
        0;
    }, "a rule source starts with a slash");
    val badRegex = SecurityPolicy(rules: [PathRule(pattern: "/(unclosed", requirement: "permitAll")], defaultRequirement: "authenticated");
    try asserts.throwsWith({ ->
        val _c = compileOrFail(badRegex);
        0;
    }, "is not a pattern");
}

test "policy: patterns are front 65's grammar - :name, :name* and a raw regex" {
    val p: CompiledPolicy = compileOrFail(SecurityPolicy(
        rules: [
            PathRule(pattern: "/users/:id", requirement: "permitAll"),
            PathRule(pattern: "/(v[0-9]+)/status", requirement: "permitAll"),
            PathRule(pattern: "/a.b", requirement: "permitAll"),
        ],
        defaultRequirement: "authenticated",
    ));
    assert render(p, "/users/7") == "/users/:id permitAll";
    assert render(p, "/users/7/orders") == "default authenticated";
    assert render(p, "/v2/status") == "/(v[0-9]+)/status permitAll";
    // A literal run is escaped by front 65's matcher: `.` is not a wildcard.
    assert render(p, "/axb") == "default authenticated";
}

test "policy: requirements admit by authentication and authority" {
    val ana: Authentication = authenticatedAs("ana", ["ROLE_USER"], "jwt");
    val root: Authentication = authenticatedAs("root", ["ROLE_ADMIN", "audit:read"], "jwt");
    assert admits("permitAll", anonymous());
    assert admits("authenticated", anonymous()) == false;
    assert admits("authenticated", ana);
    assert admits("hasRole:ADMIN", ana) == false;
    assert admits("hasRole:ADMIN", root);
    assert admits("hasAuthority:audit:read", root);
    assert requiredAuthority("hasRole:ADMIN") == "ROLE_ADMIN";
    assert requiredAuthority("hasAuthority:audit:read") == "audit:read";
    assert defaultPolicy().defaultRequirement == "authenticated";
}

// ── step 1: the entry and the context ───────────────────────────────────────

test "policy: the entry registers at -300 and runs before CORS and the error boundary" {
    val _c = chainWith(rules());
    val _i = registerFilter("request-id", orderRequestId(), { req, chain -> chain.next(req) });
    // A CORS stand-in that would stamp every response it sees.
    val _o = registerFilter("cors", orderCors(), { req, chain -> withHeader(chain.next(req), "Access-Control-Allow-Origin", "https://a.test") });
    val _e = registerFilter("problem", orderProblem(), { req, chain -> errorEntry(req, chain) });
    assert chainOrdering() == "request-id>security>cors>problem", chainOrdering();
    val res: Response = runChain("GET", "/api/orders", "origin\thttps://a.test", "", "");
    assert res.status == 401;
    // The refusal happened before CORS ever ran.
    assert headerValue("Access-Control-Allow-Origin") == "";
    val ok: Response = runChain("GET", "/api/public/x", "origin\thttps://a.test", "", "");
    assert ok.status == 200;
    assert headerValue("Access-Control-Allow-Origin") == "https://a.test";
}

test "policy: with no policy configured every path requires authentication" {
    val _c = chainWith(defaultPolicy());
    assert runChain("GET", "/", "", "", "").status == 401;
    assert runChain("GET", "/api/public/health", "", "", "").status == 401;
    assert runChain("GET", "/favicon.ico", "", "", "").status == 401;
    val t = testToken("ana", ["ROLE_USER"], 3600);
    val res: Response = runChain("GET", "/anything", bearerWire(t), "", "");
    assert res.status == 200;
    assert res.body == "handled ana";
}

test "policy: the context is readable inside a request and a hard failure outside one" {
    val _c = chainWith(rules());
    val anon: Response = runChain("GET", "/api/public/x", "", "", "");
    assert anon.body == "handled anonymous";
    try asserts.throwsWith({ ->
        val _a = currentAuthentication();
        0;
    }, "the security context was read outside a request");
    // `withAuthentication` is the explicit way in, and it restores on exit.
    val inside: string = withAuthentication(authenticatedAs("job", [], "jwt"), { -> currentAuthentication().principal.name });
    assert inside == "job";
    try asserts.throwsWith({ ->
        val _a = currentAuthentication();
        0;
    }, "outside a request");
}

fn boom(path: string) -> i32 {
    if (path == "/api/public/boom") @panic("handler failed");
    return 0;
}

test "policy: a handler that raises does not leave its context behind" {
    val _c = chainWith(rules());
    val _t = rkChainSetTerminal({ method, path, headersWire, queryWire, body ->
        val _x = boom(path);
        Response.ok("ok");
    });
    try asserts.throwsWith({ ->
        val _r = runChain("GET", "/api/public/boom", bearerWire(testToken("ana", [], 3600)), "", "");
        0;
    }, "handler failed");
    try asserts.throwsWith({ ->
        val _a = currentAuthentication();
        0;
    }, "outside a request");
}

fn servedAs(token: string, pause: i32) -> @Task<string> {
    val _t = echoAfter(pause);
    val res: Response = runChain("GET", "/api/orders", bearerWire(token), "", "");
    return res.body;
}

fn echoAfter(pause: i32) -> i32 {
    return rkChainSetTerminal({ method, path, headersWire, queryWire, body ->
        val _s = rkReqSleep(pause);
        Response.ok("handled " + currentAuthentication().principal.name);
    });
}

test "policy: two concurrent requests never observe each other's context" {
    val _c = chainWith(rules());
    val ana = testToken("ana", ["ROLE_USER"], 3600);
    val bob = testToken("bob", ["ROLE_USER"], 3600);
    // Each request is its own process; the first sleeps inside the handler
    // while the second is served, so their lifetimes overlap.
    val both = await async.runAll([
        { -> servedAs(ana, 60) },
        { -> servedAs(bob, 5) },
        { -> servedAs(ana, 30) },
    ]);
    assert both.join(",") == "handled ana,handled bob,handled ana", both.join(",");
}
