//// rakun-security — HS256 JWT (front 10 step 3). The positive case is one
//// cell; the NEGATIVE TABLE is the front: every entry is rejected by
//// `verifyJwtAt` without raising, and through the entry every entry answers
//// the same status with the byte-identical body.

import {testing.asserts, json, encoding} from "std";
import {rkSetProp} from "rakun";
import {Response, rkReqSleep} from "rakun";
import {resetChain, runChain, rkChainSetTerminal, problemLog} from "rakun-web";
import {Authentication, Principal, anonymous, currentAuthentication} from "principal";
import {SecurityPolicy, PathRule} from "policy";
import {
    JwtConfig,
    jwtConfig,
    jwtConfigProblem,
    verifyJwtAt,
    verifyJwt,
    nowSecondsF,
    signJwt,
    hs256Header,
    signatureOf,
    signatureMatches,
    skewOf,
    rkSecNowSeconds,
} from "jwt";
import {installSecurityWith, securityBoot} from "security_filter";

fn secret() -> string {
    return "front-10-test-secret-0123456789abcdef";
}

fn config(issuer: string, audience: string) -> JwtConfig {
    return JwtConfig(
        secret: secret(),
        algorithm: "HS256",
        skewSeconds: 30,
        issuer: issuer,
        audience: audience,
        authoritiesClaim: "roles",
        authorityPrefix: "",
    );
}

fn now() -> i32 {
    return rkSecNowSeconds();
}

// A claims object with `sub`, `roles`, `exp` and whatever `extra` adds.
fn claims(sub: string, exp: i32, extra: #(string, string)[]) -> string {
    var members: #(string, string)[] = [
        #("sub", json.quote(sub)),
        #("roles", json.array([json.quote("ROLE_USER")])),
        #("exp", exp.toString()),
    ];
    for (extra) { e -> members.push(e); };
    return json.object(members);
}

fn signed(body: string) -> string {
    return signJwt(secret(), hs256Header(), body);
}

fn valid() -> string {
    return signed(claims("ana", now() + 3600, []));
}

fn headerOf(alg: string) -> string {
    return json.object([#("alg", json.quote(alg)), #("typ", json.quote("JWT"))]);
}

fn parts(token: string) -> string[] {
    return token.split(".");
}

fn part(token: string, i: i32) -> string {
    return parts(token).at(i).unwrapOr("");
}

// The last character of a base64url signature, flipped to another letter —
// one byte different, same length.
fn mutateOne(sig: string) -> string {
    val last: string = sig.slice(sig.length() - 1, sig.length());
    val other: string = if (last == "A") "B" else "A";
    return sig.slice(0, sig.length() - 1) + other;
}

// ── the negative table ──────────────────────────────────────────────────────

fn negativeTable() -> #(string, string)[] {
    val t: string = valid();
    val sig: string = part(t, 2);
    val rs256Input: string = encoding.base64UrlEncode(headerOf("RS256")) + "." + part(t, 1);
    return [
        #("expired", signed(claims("ana", now() - 60, []))),
        #("not-yet-valid", signed(claims("ana", now() + 3600, [#("nbf", (now() + 120).toString())]))),
        #("alg none", encoding.base64UrlEncode(headerOf("none")) + "." + part(t, 1) + "."),
        #("alg RS256 with an HS256 signature", rs256Input + "." + signatureOf(secret(), rs256Input)),
        #("wrong issuer", signed(claims("ana", now() + 3600, [#("iss", json.quote("https://evil.test"))]))),
        #("wrong audience", signed(claims("ana", now() + 3600, [#("iss", json.quote("https://issuer.test")), #("aud", json.quote("other-api"))]))),
        #("one-byte-mutated signature", part(t, 0) + "." + part(t, 1) + "." + mutateOne(sig)),
        #("wholly different signature", part(t, 0) + "." + part(t, 1) + "." + signatureOf("another-secret-0123456789abcdef-xx", part(t, 0) + "." + part(t, 1))),
        #("tampered payload", part(t, 0) + "." + encoding.base64UrlEncode(claims("root", now() + 3600, [])) + "." + sig),
        #("two parts", part(t, 0) + "." + part(t, 1)),
        #("four parts", t + ".extra"),
        #("one part", "justonepart"),
        #("non-base64 payload", part(t, 0) + ".!!!*.@@" + "." + sig),
        #("non-JSON header", encoding.base64UrlEncode("not json") + "." + part(t, 1) + "." + sig),
        #("empty", ""),
    ];
}

// The issuer/audience-configured view the last two entries are judged by;
// every other entry fails under either configuration.
fn strict() -> JwtConfig {
    return config("https://issuer.test", "orders-api");
}

// ── cells ───────────────────────────────────────────────────────────────────

test "jwt: a valid HS256 token authenticates and its claims become the principal and authorities" {
    val body: string = json.object([
        #("sub", json.quote("ana")),
        #("roles", json.array([json.quote("ROLE_USER"), json.quote("ROLE_AUDIT")])),
        #("exp", (now() + 3600).toString()),
    ]);
    val r = verifyJwtAt(signed(body), config("", ""), nowSecondsF());
    assert r.isOk();
    val a: Authentication = r.unwrapOr(anonymous());
    assert a.principal.name == "ana";
    assert a.principal.authorities.join(",") == "ROLE_USER,ROLE_AUDIT", a.principal.authorities.join(",");
    assert a.method == "jwt";
    assert a.authenticated;
}

test "jwt: the authorities claim and the prefix are configurable" {
    val body: string = claims("ana", now() + 3600, [#("scope", json.quote("orders:read orders:write"))]);
    val c = JwtConfig(secret: secret(), algorithm: "HS256", skewSeconds: 30, issuer: "", audience: "", authoritiesClaim: "scope", authorityPrefix: "SCOPE_");
    val a: Authentication = verifyJwtAt(signed(body), c, nowSecondsF()).unwrapOr(anonymous());
    assert a.principal.authorities.join(",") == "SCOPE_orders:read,SCOPE_orders:write", a.principal.authorities.join(",");
}

test "jwt: every entry of the negative table is rejected without raising" {
    var accepted: string[] = [];
    for (negativeTable()) { row ->
        val r = verifyJwtAt(row.1, strict(), nowSecondsF());
        if (r.isOk()) accepted.push(row.0);
    };
    assert accepted.length == 0, accepted.join(", ");
    assert negativeTable().length == 15;
}

test "jwt: the issuer and audience rows fail only because they are configured" {
    val wrongIss: string = signed(claims("ana", now() + 3600, [#("iss", json.quote("https://evil.test"))]));
    assert verifyJwtAt(wrongIss, config("", ""), nowSecondsF()).isOk();
    assert verifyJwtAt(wrongIss, config("https://issuer.test", ""), nowSecondsF()).isError();
    val right: string = signed(claims("ana", now() + 3600, [#("iss", json.quote("https://issuer.test")), #("aud", json.array([json.quote("other"), json.quote("orders-api")]))]));
    assert verifyJwtAt(right, strict(), nowSecondsF()).isOk();
}

test "jwt: alg none is rejected before signature verification" {
    val t: string = valid();
    val none: string = encoding.base64UrlEncode(headerOf("none")) + "." + part(t, 1) + "." + part(t, 2);
    // The reason names the algorithm, not the signature: the signature was
    // never looked at (it would even have verified against another header).
    val r = verifyJwtAt(none, config("", ""), nowSecondsF());
    val why: string = case r {
        Ok(_) -> "accepted";
        Error(e) -> e;
    };
    assert why == "the token's alg is not the configured algorithm", why;
}

test "jwt: an alg the configuration does not name is rejected even when the signature would verify" {
    val input: string = encoding.base64UrlEncode(headerOf("HS512")) + "." + encoding.base64UrlEncode(claims("ana", now() + 3600, []));
    val token: string = input + "." + signatureOf(secret(), input);
    assert signatureMatches(secret(), input, part(token, 2));
    val why: string = case verifyJwtAt(token, config("", ""), nowSecondsF()) {
        Ok(_) -> "accepted";
        Error(e) -> e;
    };
    assert why == "the token's alg is not the configured algorithm", why;
}

test "jwt: an expired token is rejected and one expiring within the skew window is accepted" {
    val c = config("", "");
    assert verifyJwtAt(signed(claims("ana", now() - 60, [])), c, nowSecondsF()).isError();
    assert verifyJwtAt(signed(claims("ana", now() - 10, [])), c, nowSecondsF()).isOk();
    // A token with no exp at all lives forever and is refused.
    val noExp: string = signed(json.object([#("sub", json.quote("ana"))]));
    assert verifyJwtAt(noExp, c, nowSecondsF()).isError();
}

test "jwt: a nbf in the future is rejected and one within the skew is accepted" {
    val c = config("", "");
    assert verifyJwtAt(signed(claims("ana", now() + 3600, [#("nbf", (now() + 120).toString())])), c, nowSecondsF()).isError();
    assert verifyJwtAt(signed(claims("ana", now() + 3600, [#("nbf", (now() + 10).toString())])), c, nowSecondsF()).isOk();
    assert verifyJwtAt(signed(claims("ana", now() + 3600, [#("iat", (now() + 120).toString())])), c, nowSecondsF()).isError();
}

test "jwt: a one-byte-different signature and a wholly different one both fail the constant-time compare" {
    val t: string = valid();
    val input: string = part(t, 0) + "." + part(t, 1);
    assert signatureMatches(secret(), input, part(t, 2));
    assert signatureMatches(secret(), input, mutateOne(part(t, 2))) == false;
    assert signatureMatches(secret(), input, signatureOf("another-secret-0123456789abcdef-xx", input)) == false;
    assert signatureMatches(secret(), input, "") == false;
}

test "jwt: the configuration is read from rakun.security.jwt.* and refused at boot when unusable" {
    val _s = rkSetProp("rakun.security.jwt.secret", secret());
    val _i = rkSetProp("rakun.security.jwt.issuer", "");
    val _a = rkSetProp("rakun.security.jwt.audience", "");
    val c: JwtConfig = jwtConfig();
    assert c.algorithm == "HS256";
    assert c.skewSeconds == 30;
    assert c.authoritiesClaim == "roles";
    assert jwtConfigProblem(c) == "";
    assert skewOf("45s") == 45;
    assert skewOf("soon") == -1;
    val _r = rkSetProp("rakun.security.jwt.algorithm", "RS256");
    try asserts.throwsWith({ ->
        val _b = securityBoot();
        0;
    }, "verifies HS256 only");
    val _h = rkSetProp("rakun.security.jwt.algorithm", "");
    val _w = rkSetProp("rakun.security.jwt.secret", "short");
    try asserts.throwsWith({ ->
        val _b = securityBoot();
        0;
    }, "shorter than 32");
    val _k = rkSetProp("rakun.security.jwt.secret", secret());
    val _x = rkSetProp("rakun.security.jwt.clock-skew", "soon");
    try asserts.throwsWith({ ->
        val _b = securityBoot();
        0;
    }, "clock-skew is not a duration");
    val _y = rkSetProp("rakun.security.jwt.clock-skew", "");
    assert securityBoot() == 0;
}

// ── through the entry ───────────────────────────────────────────────────────

fn protectedChain() -> i32 {
    val _r = resetChain();
    val _s = rkSetProp("rakun.security.jwt.secret", secret());
    val _i = rkSetProp("rakun.security.jwt.issuer", "https://issuer.test");
    val _a = rkSetProp("rakun.security.jwt.audience", "orders-api");
    val _p = installSecurityWith(SecurityPolicy(rules: [], defaultRequirement: "authenticated"));
    return rkChainSetTerminal({ method, path, headersWire, queryWire, body ->
        Response.ok("handled " + currentAuthentication().principal.name);
    });
}

fn unsetIssuer() -> i32 {
    val _i = rkSetProp("rakun.security.jwt.issuer", "");
    return rkSetProp("rakun.security.jwt.audience", "");
}

test "jwt: every negative token answers 401 with the byte-identical body and never echoes the token" {
    val _c = protectedChain();
    val baseline: Response = runChain("GET", "/orders", "", "", "");
    assert baseline.status == 401;
    var odd: string[] = [];
    var leaked: string[] = [];
    for (negativeTable()) { row ->
        val res: Response = runChain("GET", "/orders", "authorization\tBearer " + row.1, "", "");
        if ((res.status != 401) || (res.body != baseline.body)) odd.push(row.0);
        if ((row.1 != "") && res.body.contains(row.1)) leaked.push(row.0);
    };
    val _u = unsetIssuer();
    assert odd.length == 0, odd.join(", ");
    assert leaked.length == 0, leaked.join(", ");
    try asserts.notContains(problemLog(), "Bearer");
}

test "jwt: a valid token through the entry reaches the handler as its principal" {
    val _c = protectedChain();
    val t: string = signed(claims("ana", now() + 3600, [#("iss", json.quote("https://issuer.test")), #("aud", json.quote("orders-api"))]));
    val res: Response = runChain("GET", "/orders", "authorization\tBearer " + t, "", "");
    val _u = unsetIssuer();
    assert res.status == 200;
    assert res.body == "handled ana";
    val _r = resetChain();
}
