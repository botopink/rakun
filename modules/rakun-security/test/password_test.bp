//// rakun-security — the password encoder (front 10 step 4) and the boot
//// refusals that guard it.
////
//// The timing property is asserted the one way a unit test honestly can: by
//// COUNTING PBKDF2 derivations (`rkSecEncodeCount`), not by reading a clock.
//// `basic_test.bp` asserts the unknown-user and wrong-password paths cost one
//// derivation each.

import {testing.asserts} from "std";
import {rkSetProp} from "rakun";
import {
    PasswordEncoder,
    Pbkdf2PasswordEncoder,
    pbkdf2Encoder,
    pbkdf2Encode,
    encodePassword,
    matchesStored,
    needsUpgrade,
    prefixOf,
    dummyVerify,
    encoderProblem,
    rkSecEncodeCount,
    rkSecEncodeReset,
} from "password";
import {usersProblem} from "users";
import {securityBoot} from "security_filter";

fn fieldsOf(stored: string) -> string[] {
    return stored.slice(8, stored.length()).split("$");
}

test "password: encode produces {pbkdf2}310000$<salt>$<hash> with a fresh salt each time" {
    val a: string = encodePassword("correct horse");
    val b: string = encodePassword("correct horse");
    assert a.startsWith("{pbkdf2}310000$"), a;
    assert prefixOf(a) == "pbkdf2";
    val fa: string[] = fieldsOf(a);
    val fb: string[] = fieldsOf(b);
    assert fa.length == 3;
    assert fa.at(0).unwrapOr("") == "310000";
    // 16 salt bytes and a 32-byte key, base64url without padding.
    assert fa.at(1).unwrapOr("").length() == 22, fa.at(1).unwrapOr("");
    assert fa.at(2).unwrapOr("").length() == 43, fa.at(2).unwrapOr("");
    assert fa.at(1).unwrapOr("") != fb.at(1).unwrapOr("");
}

test "password: two encodes of one password differ and both match" {
    val a: string = encodePassword("s3cret:with:colons");
    val b: string = encodePassword("s3cret:with:colons");
    assert a != b;
    assert matchesStored("s3cret:with:colons", a);
    assert matchesStored("s3cret:with:colons", b);
    assert matchesStored("s3cret:with:colon", a) == false;
    assert matchesStored("", a) == false;
}

test "password: the encoder behaves as the PasswordEncoder the README declares" {
    val e: Pbkdf2PasswordEncoder = pbkdf2Encoder();
    assert e.id() == "pbkdf2";
    assert e.iterations == 310000;
    val stored: string = e.encode("pw");
    assert e.matches("pw", stored);
    assert e.matches("pW", stored) == false;
}

test "password: a stored hash with an unknown prefix fails naming the prefix rather than answering false" {
    try asserts.throwsWith({ ->
        val _m = matchesStored("pw", "{bcrypt}$2a$10$abcdefghijklmnopqrstuv");
        0;
    }, "the prefix {bcrypt}, which names no encoder");
    try asserts.throwsWith({ ->
        val _m = matchesStored("pw", "plain-text-password");
        0;
    }, "no {id} prefix");
    try asserts.throwsWith({ ->
        val _m = matchesStored("pw", "{pbkdf2}not-the-format");
        0;
    }, "is not <iterations>$<salt>$<hash>");
}

test "password: an older iteration count still verifies and asks for an upgrade" {
    val weak: string = pbkdf2Encode("pw", 1000);
    assert weak.startsWith("{pbkdf2}1000$");
    assert matchesStored("pw", weak);
    assert needsUpgrade(weak);
    assert needsUpgrade(encodePassword("pw")) == false;
    assert needsUpgrade("{sha256}abc");
}

test "password: every derivation is counted, and the dummy costs exactly one" {
    val _r = rkSecEncodeReset();
    val stored: string = encodePassword("pw");
    assert rkSecEncodeCount() == 1;
    val _m = matchesStored("wrong", stored);
    assert rkSecEncodeCount() == 2;
    assert dummyVerify("anything") == false;
    assert rkSecEncodeCount() == 3;
}

test "password: configuring bcrypt fails at boot naming the missing NIF" {
    val _b = rkSetProp("rakun.security.password.encoder", "bcrypt");
    try asserts.throwsWith({ ->
        val _s = securityBoot();
        0;
    }, "rakun.security.password.encoder is bcrypt, which would require a NIF");
    assert encoderProblem().contains("never substituted silently");
    val _a = rkSetProp("rakun.security.password.encoder", "argon2");
    assert encoderProblem().contains("argon2, which would require a NIF");
    val _m = rkSetProp("rakun.security.password.encoder", "md5");
    assert encoderProblem().contains("md5, which is not an encoder");
    val _p = rkSetProp("rakun.security.password.encoder", "pbkdf2");
    assert encoderProblem() == "";
    val _d = rkSetProp("rakun.security.password.encoder", "");
    assert encoderProblem() == "";
}

test "password: rakun.security.users with a production profile active fails at boot" {
    val _u = rkSetProp("rakun.security.users[0].username", "ana");
    val _p = rkSetProp("rakun.security.users[0].password", encodePassword("pw"));
    val _a = rkSetProp("rakun.profiles.resolved", "production");
    try asserts.throwsWith({ ->
        val _s = securityBoot();
        0;
    }, "rakun.security.users is configured while a production profile is active");
    val _q = rkSetProp("rakun.profiles.resolved", "prod,eu");
    assert usersProblem().contains("production profile");
    val _d = rkSetProp("rakun.profiles.resolved", "dev");
    assert usersProblem() == "";
    // A plain password in the property is refused under any profile.
    val _x = rkSetProp("rakun.security.users[0].password", "pw");
    assert usersProblem().contains("never the password itself");
    val _c = rkSetProp("rakun.profiles.resolved", "");
    val _e = rkSetProp("rakun.security.users[0].username", "");
    assert usersProblem() == "";
}
