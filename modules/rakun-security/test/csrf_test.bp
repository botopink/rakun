//// rakun-security — CSRF, the double-submit token (front 10 step 7), through
//// the entry. Every path here is `permitAll`, so what refuses a request is
//// CSRF and nothing else.

import {testing.asserts} from "std";
import {Response, rkSetProp} from "rakun";
import {resetChain, runChain, rkChainSetTerminal, cookieLines, headerValue, webRequest} from "rakun-web";
import {rkSecDecision} from "principal";
import {SecurityPolicy, PathRule} from "policy";
import {encodePassword} from "password";
import {basicHeader} from "basic";
import {cookieValue, challenged, tokenMatches, csrfPasses, isSafeMethod, sessionCookieName} from "csrf";
import {installSecurityWith, csrfDetail} from "security_filter";
import {testToken} from "jwt";

fn secret() -> string {
    return "front-10-test-secret-0123456789abcdef";
}

fn chain() -> i32 {
    val _r = resetChain();
    val _s = rkSetProp("rakun.security.jwt.secret", secret());
    val _p = installSecurityWith(SecurityPolicy(
        rules: [PathRule(pattern: "/:rest*", requirement: "permitAll")],
        defaultRequirement: "authenticated",
    ));
    return rkChainSetTerminal({ method, path, headersWire, queryWire, body -> Response.ok("pong") });
}

fn post(headersWire: string) -> Response {
    return runChain("POST", "/api/public/ping", headersWire, "", "");
}

test "csrf: a POST with a session cookie and no X-CSRF-Token answers 403" {
    val _c = chain();
    val res: Response = post("cookie\tSESSION=sess-0001");
    assert res.status == 403;
    assert rkSecDecision() == "denied csrf";
    try asserts.contains(res.body, csrfDetail());
    assert headerValue("Content-Type") == "application/problem+json";
    // A header without the cookie it must match is the same refusal.
    assert post("cookie\tSESSION=sess-0001\nx-csrf-token\tcsrf-0001").status == 403;
}

test "csrf: a POST with a matching token succeeds" {
    val _c = chain();
    val res: Response = post("cookie\tSESSION=sess-0001; XSRF-TOKEN=csrf-0001\nx-csrf-token\tcsrf-0001");
    assert res.status == 200;
    assert res.body == "pong";
    assert post("cookie\tSESSION=sess-0001; XSRF-TOKEN=csrf-0001\nx-csrf-token\tcsrf-0002").status == 403;
}

test "csrf: PUT, PATCH and DELETE are challenged like POST" {
    val _c = chain();
    assert runChain("PUT", "/x", "cookie\tSESSION=s", "", "").status == 403;
    assert runChain("PATCH", "/x", "cookie\tSESSION=s", "", "").status == 403;
    assert runChain("DELETE", "/x", "cookie\tSESSION=s", "", "").status == 403;
}

test "csrf: a POST authenticated by a bearer token and no cookie is exempt" {
    val _c = chain();
    val t: string = testToken("ana", ["ROLE_USER"], 3600);
    val res: Response = post("authorization\tBearer " + t);
    assert res.status == 200;
    // The session cookie is ambient whatever else is present.
    assert post("authorization\tBearer " + t + "\ncookie\tSESSION=sess-0001").status == 403;
}

test "csrf: Basic credentials are ambient and are challenged" {
    val _u = rkSetProp("rakun.security.users[0].username", "ana");
    val _p = rkSetProp("rakun.security.users[0].password", encodePassword("pw"));
    val _c = chain();
    val res: Response = post("authorization\t" + basicHeader("ana", "pw"));
    val _x = rkSetProp("rakun.security.users[0].username", "");
    assert res.status == 403;
}

test "csrf: the token is compared in constant time" {
    // Asserted by the call (`tokenMatches` → std's hash.equalsConstantTime) and
    // by its answers: one byte different, a prefix, and an empty side all fail.
    assert tokenMatches("csrf-0001", "csrf-0001");
    assert tokenMatches("csrf-0001", "csrf-0002") == false;
    assert tokenMatches("csrf-0001", "csrf-000") == false;
    assert tokenMatches("", "") == false;
    assert tokenMatches("csrf-0001", "") == false;
}

test "csrf: GET and HEAD are never challenged" {
    val _c = chain();
    assert runChain("GET", "/x", "cookie\tSESSION=sess-0001", "", "").status == 200;
    assert runChain("HEAD", "/x", "cookie\tSESSION=sess-0001", "", "").status == 200;
    assert isSafeMethod("get");
    assert isSafeMethod("POST") == false;
    val get = webRequest("GET", "/x", "cookie\tSESSION=s", "", "");
    assert challenged(get, "basic") == false;
}

test "csrf: a request with the session cookie and no token cookie is issued one" {
    val _c = chain();
    val _g = runChain("GET", "/x", "cookie\tSESSION=sess-0001", "", "");
    val issued: string[] = cookieLines();
    assert issued.length == 1, issued.join(" | ");
    val line: string = issued.at(0).unwrapOr("");
    assert line.startsWith("XSRF-TOKEN=");
    try asserts.contains(line, "SameSite=Strict");
    // 32 random bytes, base64url.
    assert cookieValue(line.split(";").at(0).unwrapOr(""), "XSRF-TOKEN").length() == 43;
    val _h = runChain("GET", "/x", "cookie\tSESSION=sess-0001; XSRF-TOKEN=abc", "", "");
    assert cookieLines().length == 0;
    assert sessionCookieName() == "SESSION";
    val _r = resetChain();
}
