//// rakun-security — the host cells of front 79 (`rakun_oauth2.erl`).
//// Root-level on purpose: a sidecar called only from a module in a folder
//// (`oauth2/*.bp`) is never shipped (language-gaps.md), so every cell has a
//// wrapper here.

#[@External.Erlang("rakun_oauth2", "random_url")]
declare fn cRandom(bytes: i32) -> string;
#[@External.Erlang("rakun_oauth2", "s256")]
declare fn cS256(verifier: string) -> string;
#[@External.Erlang("rakun_oauth2", "state_put")]
declare fn cStatePut(state: string, payload: string) -> i32;
#[@External.Erlang("rakun_oauth2", "state_take")]
declare fn cStateTake(state: string) -> string;
#[@External.Erlang("rakun_oauth2", "state_count")]
declare fn cStateCount() -> i32;
#[@External.Erlang("rakun_oauth2", "jwks_put")]
declare fn cJwksPut(issuer: string, json: string) -> i32;
#[@External.Erlang("rakun_oauth2", "jwks_has")]
declare fn cJwksHas(issuer: string, kid: string) -> bool;
#[@External.Erlang("rakun_oauth2", "jwks_fetches")]
declare fn cJwksFetches(issuer: string) -> i32;
#[@External.Erlang("rakun_oauth2", "jwks_note_fetch")]
declare fn cJwksNoteFetch(issuer: string) -> i32;
#[@External.Erlang("rakun_oauth2", "jwks_may_refetch")]
declare fn cJwksMayRefetch(issuer: string, windowMs: i32) -> bool;
#[@External.Erlang("rakun_oauth2", "verify_rs256")]
declare fn cVerify(issuer: string, token: string) -> string;
#[@External.Erlang("rakun_oauth2", "check_claims")]
declare fn cCheckClaims(claimsJson: string, issuer: string, clientId: string, nonce: string, now: i32, skew: i32) -> string;
#[@External.Erlang("rakun_oauth2", "claim")]
declare fn cClaim(json: string, name: string) -> string;
#[@External.Erlang("rakun_oauth2", "token_put")]
declare fn cTokenPut(scope: string, key: string, value: string) -> i32;
#[@External.Erlang("rakun_oauth2", "token_get")]
declare fn cTokenGet(scope: string, key: string) -> string;
#[@External.Erlang("rakun_oauth2", "token_drop")]
declare fn cTokenDrop(scope: string, key: string) -> i32;
#[@External.Erlang("rakun_oauth2", "flight")]
declare fn cFlight<T>(key: string, work: fn() -> T) -> T;
#[@External.Erlang("rakun_oauth2", "counter_bump")]
declare fn cCounterBump(key: string) -> i32;
#[@External.Erlang("rakun_oauth2", "counter")]
declare fn cCounter(key: string) -> i32;
#[@External.Erlang("rakun_oauth2", "reset")]
declare fn cReset() -> i32;
#[@External.Erlang("rakun_oauth2", "now_seconds")]
declare fn cNow() -> i32;

pub fn oauthRandom(bytes: i32) -> string { return cRandom(bytes); }
pub fn oauthS256(verifier: string) -> string { return cS256(verifier); }
pub fn oauthStatePut(state: string, payload: string) -> i32 { return cStatePut(state, payload); }
pub fn oauthStateTake(state: string) -> string { return cStateTake(state); }
pub fn oauthStateCount() -> i32 { return cStateCount(); }
pub fn oauthJwksPut(issuer: string, json: string) -> i32 { return cJwksPut(issuer, json); }
pub fn oauthJwksHas(issuer: string, kid: string) -> bool { return cJwksHas(issuer, kid); }
pub fn oauthJwksFetches(issuer: string) -> i32 { return cJwksFetches(issuer); }
pub fn oauthJwksNoteFetch(issuer: string) -> i32 { return cJwksNoteFetch(issuer); }
pub fn oauthJwksMayRefetch(issuer: string, windowMs: i32) -> bool { return cJwksMayRefetch(issuer, windowMs); }
pub fn oauthVerify(issuer: string, token: string) -> string { return cVerify(issuer, token); }
pub fn oauthCheckClaims(claimsJson: string, issuer: string, clientId: string, nonce: string, now: i32, skew: i32) -> string { return cCheckClaims(claimsJson, issuer, clientId, nonce, now, skew); }
pub fn oauthClaim(json: string, name: string) -> string { return cClaim(json, name); }
pub fn oauthTokenPut(scope: string, key: string, value: string) -> i32 { return cTokenPut(scope, key, value); }
pub fn oauthTokenGet(scope: string, key: string) -> string { return cTokenGet(scope, key); }
pub fn oauthTokenDrop(scope: string, key: string) -> i32 { return cTokenDrop(scope, key); }
pub fn oauthFlight<T>(key: string, work: fn() -> T) -> T { return cFlight(key, work); }
pub fn oauthCounterBump(key: string) -> i32 { return cCounterBump(key); }
pub fn oauthCounter(key: string) -> i32 { return cCounter(key); }
pub fn oauthReset() -> i32 { return cReset(); }
pub fn oauthNow() -> i32 { return cNow(); }
