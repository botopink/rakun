//// rakun-security — password encoding. Front 10 step 4.
////
//// THE ONLY ENCODER IS PBKDF2-HMAC-SHA256, and the README says why rather than
//// listing bcrypt and hoping: bcrypt, scrypt and Argon2 are NIFs, and a sidecar
//// compiled at run time has no code path to load one. OTP ships
//// `crypto:pbkdf2_hmac/5`; that decides it. 310 000 iterations, a fresh 16-byte
//// salt from `crypto:strong_rand_bytes/1` per encode, a 32-byte derived key.
////
//// THE STORED FORM CARRIES ITS ALGORITHM — `{pbkdf2}310000$<salt>$<hash>`, salt
//// and hash base64url without padding (there is no byte type, so the stored
//// form is text). That is Spring's `DelegatingPasswordEncoder` idea: an old hash
//// is verified by whichever encoder its prefix names (`matchesStored`), and
//// `needsUpgrade` says when a successful login should re-encode it with the
//// current default. A hash whose prefix names an encoder nobody ships FAILS
//// naming the prefix — answering `false` would turn a migration mistake into a
//// locked-out user base with nothing in the log.
////
//// `rakun.security.password.encoder` may name `pbkdf2` (the default). `bcrypt`,
//// `scrypt` and `argon2` fail at boot naming the missing NIF, and anything else
//// fails naming the value — never a silent downgrade to PBKDF2.
////
//// `matches` IS CONSTANT-TIME (std's `hash.equalsConstantTime`), and the
//// unknown-user path runs a DUMMY verification (`dummyVerify`) so a missing
//// account and a wrong password cost the same. Every PBKDF2 derivation bumps a
//// host counter (`rkSecEncodeCount`): "the same time" asserted by a clock is a
//// flake, asserted by counting derivations it is a fact.

import {rkProp} from "rakun";
import {hash} from "std";

// ── host cells ──────────────────────────────────────────────────────────────

#[@External.Erlang("rakun_security", "pbkdf2")]
pub declare fn rkSecPbkdf2(raw: string, salt: string, iterations: i32) -> string;

#[@External.Erlang("rakun_security", "salt")]
pub declare fn rkSecSalt() -> string;

#[@External.Erlang("rakun_security", "encode_count")]
pub declare fn rkSecEncodeCount() -> i32;

#[@External.Erlang("rakun_security", "encode_reset")]
pub declare fn rkSecEncodeReset() -> i32;

// ── the behavior ────────────────────────────────────────────────────────────

pub behavior PasswordEncoder {
    fn id(self: Self) -> string;
    fn encode(self: Self, raw: string) -> string;
    fn matches(self: Self, raw: string, stored: string) -> bool;
}

pub fn pbkdf2Iterations() -> i32 {
    return 310000;
}

pub type Pbkdf2PasswordEncoder(iterations: i32) implement PasswordEncoder {
    pub fn id(self: Self) -> string {
        return "pbkdf2";
    }

    pub fn encode(self: Self, raw: string) -> string {
        return pbkdf2Encode(raw, self.iterations);
    }

    pub fn matches(self: Self, raw: string, stored: string) -> bool {
        return pbkdf2Matches(raw, stored);
    }
}

pub fn pbkdf2Encoder() -> Pbkdf2PasswordEncoder {
    return Pbkdf2PasswordEncoder(iterations: pbkdf2Iterations());
}

// ── the stored form ─────────────────────────────────────────────────────────

pub fn pbkdf2Encode(raw: string, iterations: i32) -> string {
    val salt: string = rkSecSalt();
    return "{pbkdf2}" + iterations.toString() + "$" + salt + "$" + rkSecPbkdf2(raw, salt, iterations);
}

// The `{id}` of a stored hash, `""` when it carries none.
pub fn prefixOf(stored: string) -> string {
    if (stored.startsWith("{") == false) return "";
    val close: i32 = stored.indexOf("}");
    if (close < 1) return "";
    return stored.slice(1, close);
}

fn bodyOf(stored: string) -> string {
    val close: i32 = stored.indexOf("}");
    return stored.slice(close + 1, stored.length());
}

fn digitsOnly(s: string) -> bool {
    if (s == "") return false;
    var ok = true;
    for (s.split("")) { c -> if ("0123456789".indexOf(c) < 0) ok = false; };
    return ok;
}

fn toInt(s: string) -> i32 {
    var n = 0;
    for (s.split("")) { c -> n = n * 10 + "0123456789".indexOf(c); };
    return n;
}

pub fn malformedHashProblem() -> string {
    return "rakun-security: a stored {pbkdf2} hash is not <iterations>$<salt>$<hash> - "
        + "it was not written by this encoder";
}

// Verifies against the stored iteration count, so a hash written with a
// different count still verifies (and `needsUpgrade` answers true for it).
pub fn pbkdf2Matches(raw: string, stored: string) -> bool {
    val parts: string[] = bodyOf(stored).split("$");
    val iterations: string = parts.at(0).unwrapOr("");
    val salt: string = parts.at(1).unwrapOr("");
    val expected: string = parts.at(2).unwrapOr("");
    val wellFormed: bool = (parts.length == 3) && digitsOnly(iterations) && (salt != "") && (expected != "");
    if (wellFormed == false) @panic(malformedHashProblem());
    return hash.equalsConstantTime(rkSecPbkdf2(raw, salt, toInt(iterations)), expected);
}

pub fn unknownPrefixProblem(prefix: string) -> string {
    val shown: string = if (prefix == "") "no {id} prefix" else "the prefix {" + prefix + "}";
    return "rakun-security: a stored password hash carries " + shown
        + ", which names no encoder this application ships - the only encoder is "
        + "{pbkdf2}; a hash from another system must be migrated, not guessed at";
}

// The delegating verification: the prefix picks the encoder.
pub fn matchesStored(raw: string, stored: string) -> bool {
    val prefix: string = prefixOf(stored);
    if (prefix != "pbkdf2") @panic(unknownPrefixProblem(prefix));
    return pbkdf2Matches(raw, stored);
}

// The current default's encoding.
pub fn encodePassword(raw: string) -> string {
    return pbkdf2Encode(raw, pbkdf2Iterations());
}

// True when a stored hash should be re-encoded after a successful login: it
// names another encoder, or fewer iterations than the current default.
pub fn needsUpgrade(stored: string) -> bool {
    if (prefixOf(stored) != "pbkdf2") return true;
    val iterations: string = bodyOf(stored).split("$").at(0).unwrapOr("");
    if (digitsOnly(iterations) == false) return true;
    return toInt(iterations) < pbkdf2Iterations();
}

// A fixed, well-formed hash of nothing anyone can type (the salt is fresh per
// call and the input is a token). Verifying against it costs exactly one
// derivation at the default iteration count — what a real account costs.
pub fn dummyVerify(raw: string) -> bool {
    val salt: string = rkSecSalt();
    val _d = rkSecPbkdf2(raw, salt, pbkdf2Iterations());
    return false;
}

// ── the boot check ──────────────────────────────────────────────────────────

pub fn encoderName() -> string {
    val configured: string = rkProp("rakun.security.password.encoder");
    if (configured == "") return "pbkdf2" else return configured.trim().toLower();
}

pub fn nifEncoderProblem(name: string) -> string {
    return "rakun-security: rakun.security.password.encoder is " + name + ", which "
        + "would require a NIF (a natively compiled library) - a rakun sidecar is "
        + "compiled at run time with no code path to load one. The only encoder is "
        + "pbkdf2 (PBKDF2-HMAC-SHA256 over crypto:pbkdf2_hmac/5); it is never "
        + "substituted silently.";
}

pub fn unknownEncoderProblem(name: string) -> string {
    return "rakun-security: rakun.security.password.encoder is " + name
        + ", which is not an encoder - the only one is pbkdf2";
}

// `""` when the configured encoder is usable.
pub fn encoderProblem() -> string {
    val name: string = encoderName();
    if (name == "pbkdf2") return "";
    val nif: bool = (name == "bcrypt") || (name == "scrypt") || (name == "argon2") || (name == "argon2id");
    if (nif) return nifEncoderProblem(name);
    return unknownEncoderProblem(name);
}
