//// rakun-security — the resource server (front 79 step 5).
////
//// `installResourceServer(providerId)` installs front 10's bearer verifier:
//// a `Bearer` token is verified RS256 against the provider's JWKS (fetched on
//// first use; a cached key and a present `kid` mean no network), its `iss`
//// and `exp` checked within the clock skew, and its `scope` (space-delimited)
//// and `roles` (an array) claims become `SCOPE_<s>` and `ROLE_<r>`
//// authorities. It authenticates; `#[secured]` and the policy authorize. A
//// request without `Authorization` stays anonymous; a malformed token is
//// front 10's 401 with `WWW-Authenticate: Bearer error="invalid_token"`.

import {toI32, rkProp} from "rakun";
import {principal.Authentication, principal.authenticatedAs};
import {security_filter.installBearerVerifier};
import {oauth2.provider.OAuth2Provider, oauth2.provider.ProviderEndpoints, oauth2.provider.provider, oauth2.provider.discover};
import {oauth2.flow.verifySigned};
import {oauth2_host.oauthCheckClaims, oauth2_host.oauthClaim, oauth2_host.oauthNow};

fn skew() -> i32 {
    val raw = rkProp("rakun.security.oauth2.clock-skew").trim();
    return if (raw == "") 60 else toI32(raw);
}

// The authorities a token's claims carry.
pub fn authoritiesOf(claims: string) -> string[] {
    var out: string[] = [];
    for (oauthClaim(claims, "scope").split(" ").filter({ s -> s != "" })) { s ->
        out.push("SCOPE_" + s);
    }
    for (oauthClaim(claims, "roles").split(" ").filter({ r -> r != "" })) { r ->
        out.push("ROLE_" + r);
    }
    return out;
}

pub fn verifyAccessToken(
    e: ProviderEndpoints,
    audience: string,
    token: string,
) -> @Result<Authentication, string> {
    val v = verifySigned(e, token);
    if (v.startsWith("error\t"))
        throw "rakun oauth2: the bearer token fails its "
            + v.slice(6, v.length())
            + " check";
    val claims = v.slice(3, v.length());
    val aud = if (audience == "") {
        oauthClaim(claims, "aud").split(" ").at(0) ?? "";
    } else audience;
    val bad = oauthCheckClaims(claims, e.issuer, aud, "", oauthNow(), skew());
    if (bad != "")
        throw "rakun oauth2: the bearer token's "
            + bad
            + " claim does not hold";
    return authenticatedAs(
        oauthClaim(claims, "sub"),
        authoritiesOf(claims),
        "bearer",
    );
}

// Bearer tokens are verified against provider `providerId`'s issuer; an
// empty `audience` accepts any audience the token names.
pub fn installResourceServer(providerId: string, audience: string) -> i32 {
    val p: ?OAuth2Provider = provider(providerId);
    if (p == null)
        @panic(
            "rakun oauth2: installResourceServer names `"
                + providerId
                + "`, which is not a registered provider",
        );
    val e = discover(p);
    return installBearerVerifier(
        { token -> verifyAccessToken(e, audience, token) },
    );
}
