//// rakun-security — client credentials for service-to-service calls (front
//// 79 step 6).
////
//// `registerClientCredentials(reg)` declares a token source; nothing is
//// fetched until a call needs it. `clientCredentialsToken(id)` answers the
//// cached token while it has more than the refresh margin left, else fetches
//// ONE — concurrent callers of a cold source share the fetch. `withClientToken
//// (id, call)` runs `call` with the token and, on a 401 from the downstream
//// service, drops the cached token and retries exactly once. A failure names
//// the registration and the status, never the token.

import {rkProp, toI32} from "rakun";
import {encoding} from "std";
import {RestClient, ClientResponse} from "rakun-client";
import {oauthClaim, oauthTokenPut, oauthTokenGet, oauthTokenDrop, oauthFlight, oauthCounterBump, oauthCounter, oauthNow} from "oauth2_host";

pub type ClientRegistration(
    id: string,
    tokenUri: string,
    clientId: string,
    clientSecret: string,
    scopes: string[],
)

#[@External.Erlang("""(fun(__R) -> persistent_term:put({rakun_oauth2_cc, element(2, __R)}, __R), 0 end)($0)""")]
declare fn storeRegistration(r: ClientRegistration) -> i32;

#[@External.Erlang("""(fun(__Id) -> persistent_term:get({rakun_oauth2_cc, __Id}, undefined) end)($0)""")]
declare fn loadRegistration(id: string) -> ?ClientRegistration;

pub fn registerClientCredentials(r: ClientRegistration) -> i32 {
    return storeRegistration(r);
}

pub fn tokenRequests(id: string) -> i32 {
    return oauthCounter("cc " + id);
}

fn margin() -> i32 {
    val raw = rkProp("rakun.security.oauth2.refresh-margin").trim();
    return if (raw == "") 30 else toI32(raw);
}

fn fetch(r: ClientRegistration) -> string {
    val _n = oauthCounterBump("cc " + r.id);
    val body = encoding.formStringify([#("grant_type", "client_credentials"), #("client_id", r.clientId), #("client_secret", r.clientSecret), #("scope", r.scopes.join(" "))]);
    val res: ClientResponse = RestClient.builder().defaultHeader("content-type", "application/x-www-form-urlencoded").build().post(r.tokenUri, body).retrieve();
    if (res.isOk() == false) @panic("rakun oauth2: the client-credentials token request of `" + r.id + "` failed with status " + res.status.toString());
    val token = oauthClaim(res.body, "access_token");
    val expires = toI32(if (oauthClaim(res.body, "expires_in") == "") "300" else oauthClaim(res.body, "expires_in"));
    val _p = oauthTokenPut("cc", r.id, token + "\t" + (oauthNow() + expires).toString());
    return token;
}

pub fn clientCredentialsToken(id: string) -> string {
    val r: ?ClientRegistration = loadRegistration(id);
    if (r == null) @panic("rakun oauth2: no client-credentials registration `" + id + "`");
    val reg = r ?? ClientRegistration(id: "", tokenUri: "", clientId: "", clientSecret: "", scopes: []);
    val cached = oauthTokenGet("cc", id);
    val parts = cached.split("\t");
    if (cached != "" && toI32(parts.at(1) ?? "0") - oauthNow() > margin()) return parts.at(0) ?? "";
    return oauthFlight("cc " + id, { -> fetch(reg) });
}

pub fn withClientToken(id: string, call: fn(token: string) -> ClientResponse) -> ClientResponse {
    val first = call(clientCredentialsToken(id));
    if (first.status != 401) return first;
    val _d = oauthTokenDrop("cc", id);
    return call(clientCredentialsToken(id));
}
