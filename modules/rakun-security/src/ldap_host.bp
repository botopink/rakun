//// rakun-security — the host cells of front 79's LDAP arm (`rakun_ldap.erl`).
//// Root-level for the reason `oauth2_host.bp` states.

#[@External.Erlang("rakun_ldap", "authenticate")]
declare fn cAuthenticate(
    host: string,
    port: i32,
    serviceDn: string,
    servicePassword: string,
    base: string,
    uidAttribute: string,
    userDnPattern: string,
    user: string,
    password: string,
) -> string;

#[@External.Erlang("rakun_ldap", "health")]
declare fn cHealth(
    host: string,
    port: i32,
    serviceDn: string,
    servicePassword: string,
) -> string;

#[@External.Erlang("rakun_ldap", "handles")]
declare fn cHandles() -> i32;

#[@External.Erlang("rakun_ldap", "test_server")]
declare fn cTestServer(
    entries: Array<#(string, string, string, string[])>,
) -> i32;

#[@External.Erlang("rakun_ldap", "test_stop")]
declare fn cTestStop() -> i32;

pub fn ldapBind(
    host: string,
    port: i32,
    serviceDn: string,
    servicePassword: string,
    base: string,
    uidAttribute: string,
    userDnPattern: string,
    user: string,
    password: string,
) -> string {
    return cAuthenticate(
        host,
        port,
        serviceDn,
        servicePassword,
        base,
        uidAttribute,
        userDnPattern,
        user,
        password,
    );
}

pub fn ldapHealthWire(
    host: string,
    port: i32,
    serviceDn: string,
    servicePassword: string,
) -> string {
    return cHealth(host, port, serviceDn, servicePassword);
}

pub fn ldapHandles() -> i32 {
    return cHandles();
}

pub fn ldapTestServer(
    entries: Array<#(string, string, string, string[])>,
) -> i32 {
    return cTestServer(entries);
}

pub fn ldapTestStop() -> i32 {
    return cTestStop();
}
