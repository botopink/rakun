//// rakun-security — the host cells of front 79's LDAP arm (`rakun_ldap.erl`).
//// Root-level for the reason `oauth2_host.bp` states.

import {compiler} from "std";

#[compiler.external(.Erlang("rakun_ldap:authenticate($0, $1, $2, $3, $4, $5, $6, $7, $8)"))]
declare fn cAuthenticate(
    host: string,
    port: i32,
    serviceDn: string,
    servicePassword: string,
    base: string,
    uidAttribute: string,
    userDnPattern: string,
    user: string,
    password: string,
) -> string;

#[compiler.external(.Erlang("rakun_ldap:health($0, $1, $2, $3)"))]
declare fn cHealth(
    host: string,
    port: i32,
    serviceDn: string,
    servicePassword: string,
) -> string;

#[compiler.external(.Erlang("rakun_ldap:handles()"))]
declare fn cHandles() -> i32;

#[compiler.external(.Erlang("rakun_ldap:test_server($0)"))]
declare fn cTestServer(
    entries: Array<#(string, string, string, string[])>,
) -> i32;

#[compiler.external(.Erlang("rakun_ldap:test_stop()"))]
declare fn cTestStop() -> i32;

pub fn ldapBind(
    host: string,
    port: i32,
    serviceDn: string,
    servicePassword: string,
    base: string,
    uidAttribute: string,
    userDnPattern: string,
    user: string,
    password: string,
) -> string {
    return cAuthenticate(
        host,
        port,
        serviceDn,
        servicePassword,
        base,
        uidAttribute,
        userDnPattern,
        user,
        password,
    );
}

pub fn ldapHealthWire(
    host: string,
    port: i32,
    serviceDn: string,
    servicePassword: string,
) -> string {
    return cHealth(host, port, serviceDn, servicePassword);
}

pub fn ldapHandles() -> i32 {
    return cHandles();
}

pub fn ldapTestServer(
    entries: Array<#(string, string, string, string[])>,
) -> i32 {
    return cTestServer(entries);
}

pub fn ldapTestStop() -> i32 {
    return cTestStop();
}
