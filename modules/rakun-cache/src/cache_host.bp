//// rakun-cache — the host cells over `src/sidecars/rakun_cache.erl` (`cache_host`,
//// not `host`: rakun-session, a dependency, already has a `host` module).
//// The ETS store and its owner, the names table, the customizers, single
//// flight, background refresh, the clock, the invalidation log and trace and
//// the RESP double. Everything that DECIDES — the key, the
//// lifetime, freshness, the provider, the kill switch, legality and every
//// refusal — is botopink, in `cache.bp`.

import {compiler} from "std";

// ── rows ────────────────────────────────────────────────────────────────────

#[compiler.external(.Erlang("rakun_cache:row_put($0, $1, $2, $3, $4)"))]
pub declare fn rkCacheRowPut<R>(
    name: string,
    key: string,
    row: R,
    tags: string[],
    expireAt: i64,
) -> i32;

#[compiler.external(.Erlang("rakun_cache:row_get($0, $1)"))]
declare fn rkCacheRowGetRaw(name: string, key: string) -> unknown;

// The row cached under `name` and `key`, as the `R` the caller names — `null`
// when there is none or it is no `R` (668).
pub fn rkCacheRowGet<R>(t: type<R>, name: string, key: string) -> ?R {
    val found = rkCacheRowGetRaw(name, key);
    if (found is t) return found;
    return null;
}

#[compiler.external(.Erlang("rakun_cache:row_marked($0, $1)"))]
pub declare fn rkCacheRowMarked(name: string, key: string) -> bool;

#[compiler.external(.Erlang("rakun_cache:row_delete($0, $1)"))]
pub declare fn rkCacheRowDelete(name: string, key: string) -> i32;

#[compiler.external(.Erlang("rakun_cache:clear_name($0)"))]
pub declare fn rkCacheClearName(name: string) -> i32;

#[compiler.external(.Erlang("rakun_cache:clear_all()"))]
pub declare fn rkCacheClearAll() -> i32;

#[compiler.external(.Erlang("rakun_cache:size($0)"))]
pub declare fn rkCacheSize(name: string) -> i32;

#[compiler.external(.Erlang("rakun_cache:keys_of($0)"))]
pub declare fn rkCacheKeysOf(name: string) -> string[];

#[compiler.external(.Erlang("rakun_cache:evict_one($0, $1, $2)"))]
pub declare fn rkCacheEvictOne(
    name: string,
    policy: string,
    keep: string,
) -> i32;

#[compiler.external(.Erlang("rakun_cache:mark_tag($0)"))]
pub declare fn rkCacheMarkTag(tag: string) -> i32;

#[compiler.external(.Erlang("rakun_cache:expire_tag($0)"))]
pub declare fn rkCacheExpireTag(tag: string) -> i32;

// ── names and customizers ───────────────────────────────────────────────────

#[compiler.external(.Erlang("rakun_cache:name_put($0, $1)"))]
pub declare fn rkCacheNamePut<S>(name: string, settings: S) -> i32;

#[compiler.external(.Erlang("rakun_cache:name_get($0)"))]
declare fn rkCacheNameGetRaw(name: string) -> unknown;

// The settings kept for `name`, as the `S` the caller names — `null` when none.
pub fn rkCacheNameGet<S>(t: type<S>, name: string) -> ?S {
    val found = rkCacheNameGetRaw(name);
    if (found is t) return found;
    return null;
}

#[compiler.external(.Erlang("rakun_cache:names()"))]
pub declare fn rkCacheNames() -> string[];

#[compiler.external(.Erlang("rakun_cache:names_clear()"))]
pub declare fn rkCacheNamesClear() -> i32;

#[compiler.external(.Erlang("rakun_cache:customizer_add($0)"))]
pub declare fn rkCacheCustomizerAdd<F>(customize: F) -> i32;

#[compiler.external(.Erlang("rakun_cache:customizers()"))]
pub declare fn rkCacheCustomizers() -> unknown[];

#[compiler.external(.Erlang("rakun_cache:customizers_clear()"))]
pub declare fn rkCacheCustomizersClear() -> i32;

// ── single flight and refresh ───────────────────────────────────────────────

#[compiler.external(.Erlang("rakun_cache:flight($0, $1)"))]
pub declare fn rkCacheFlight(flightKey: string, load: fn() -> string) -> string;

#[compiler.external(.Erlang("rakun_cache:flights_led()"))]
pub declare fn rkCacheFlightsLed() -> i32;

#[compiler.external(.Erlang("rakun_cache:refresh($0, $1)"))]
pub declare fn rkCacheRefresh(flightKey: string, work: fn() -> i32) -> i32;

#[compiler.external(.Erlang("rakun_cache:drain()"))]
pub declare fn rkCacheDrain() -> i32;

#[compiler.external(.Erlang("rakun_cache:spawn_many($0, $1)"))]
pub declare fn rkCacheSpawnMany(n: i32, work: fn(i: i32) -> string) -> string[];

// ── the clock ───────────────────────────────────────────────────────────────

#[compiler.external(.Erlang("rakun_cache:now()"))]
pub declare fn rkCacheNow() -> i64;

#[compiler.external(.Erlang("rakun_cache:clock_advance($0)"))]
pub declare fn rkCacheClockAdvance(ms: i64) -> i32;

#[compiler.external(.Erlang("rakun_cache:clock_reset()"))]
pub declare fn rkCacheClockReset() -> i32;

// An `i32` read as an `i64`: botopink has no widening conversion.
#[compiler.external(.Erlang("rakun_cache:wide($0)"))]
pub declare fn rkCacheWide(n: i32) -> i64;

