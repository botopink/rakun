#[compiler.external(.Erlang("rakun_cache:trace_on()"))]
pub declare fn rkCacheTraceOn() -> i32;

#[compiler.external(.Erlang("rakun_cache:trace_off()"))]
pub declare fn rkCacheTraceOff() -> i32;

#[compiler.external(.Erlang("rakun_cache:trace($0)"))]
pub declare fn rkCacheTraceLine(line: string) -> i32;

#[compiler.external(.Erlang("rakun_cache:traced()"))]
