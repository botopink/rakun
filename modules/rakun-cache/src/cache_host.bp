#[compiler.external(.Erlang("rakun_cache:log_add($0, $1)"))]
pub declare fn rkCacheLogAdd(kind: string, value: string) -> i32;

#[compiler.external(.Erlang("rakun_cache:logged($0)"))]
pub declare fn rkCacheLogged(kind: string) -> string[];

#[compiler.external(.Erlang("rakun_cache:log_clear($0)"))]
