//// rakun-cache — the host cells over `src/sidecars/rakun_cache.erl` (`cache_host`,
//// not `host`: rakun-session, a dependency, already has a `host` module).
//// The ETS store and its owner, the names table, the customizers, single
//// flight, background refresh, the clock, the invalidation log and trace and
//// the RESP double. Everything that DECIDES — the key, the
//// lifetime, freshness, the provider, the kill switch, legality and every
//// refusal — is botopink, in `cache.bp`.

// ── rows ────────────────────────────────────────────────────────────────────

#[@External.Erlang("rakun_cache", "row_put")]
pub declare fn rkCacheRowPut<R>(name: string, key: string, row: R, tags: string[], expireAt: i64) -> i32;

#[@External.Erlang("rakun_cache", "row_get")]
pub declare fn rkCacheRowGet<R>(name: string, key: string) -> ?R;

#[@External.Erlang("rakun_cache", "row_marked")]
pub declare fn rkCacheRowMarked(name: string, key: string) -> bool;

#[@External.Erlang("rakun_cache", "row_delete")]
pub declare fn rkCacheRowDelete(name: string, key: string) -> i32;

#[@External.Erlang("rakun_cache", "clear_name")]
pub declare fn rkCacheClearName(name: string) -> i32;

#[@External.Erlang("rakun_cache", "clear_all")]
pub declare fn rkCacheClearAll() -> i32;

#[@External.Erlang("rakun_cache", "size")]
pub declare fn rkCacheSize(name: string) -> i32;

#[@External.Erlang("rakun_cache", "keys_of")]
pub declare fn rkCacheKeysOf(name: string) -> string[];

#[@External.Erlang("rakun_cache", "evict_one")]
pub declare fn rkCacheEvictOne(name: string, policy: string, keep: string) -> i32;

#[@External.Erlang("rakun_cache", "mark_tag")]
pub declare fn rkCacheMarkTag(tag: string) -> i32;

#[@External.Erlang("rakun_cache", "expire_tag")]
pub declare fn rkCacheExpireTag(tag: string) -> i32;

