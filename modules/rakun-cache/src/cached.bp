//// rakun-cache — `#[cached]`, `#[cacheable]`, `#[cacheEvict]`. Front 12 step 4.
////
//// A decorator cannot wrap the body it annotates, so the Spring half is a
//// TWIN, the shape rakun-ssr's `#[mock]` and rakun-data's `#[transactional]` use.
//// `#[cached]` on a `behavior` reflects its methods and gives the behavior an
//// associated type (decision 216 of 1.0.11-beta):
////
////     ProductCatalog.Cached(inner: ProductCatalog) implement ProductCatalog {
////         pub fn productJson(self: Self, id: string) -> string {
////             return cacheMethod("products", ["productJson", id], { -> self.inner.productJson(id) });
////         }
////         pub fn reprice(self: Self, id: string, body: string) -> string {
////             val out = self.inner.reprice(id, body);
////             val _e = cacheEvictAll("products");
////             return out;
////         }
////         pub fn slugFor(self: Self, id: string) -> string {
////             return self.inner.slugFor(id);
////         }
////     }
////
//// constructed as `ProductCatalog.Cached(inner: real)` wherever a
//// `ProductCatalog` is wanted.
////
//// A method with no cache annotation is delegated unchanged and never touches
//// the store. Eviction runs AFTER the delegate returns, so a delegate that
//// raises leaves the cache alone. `#[cacheEvict(name, false)]` removes the
//// rows keyed `[<m>, args…]` for every `#[cacheable(name)]` method `m` of the
//// behavior — the key its own arguments build under each reader.
////
//// The module carrying `#[cached]` imports `cacheMethod`, `cacheEvictAll` and
//// `cacheEvictKeys` (the twin's bodies resolve names in that module). Another
//// module reaches `ProductCatalog.Cached(inner: …)` through `ProductCatalog`
//// alone — the twin travels with the behavior.
////
//// A decorator body can call no function, so the checks are inline.

import {compiler, compiler.DeclKind} from "std";

pub fn cached(syntax decl: unknown) {
    var readers: Array<string> = [];
    compiler.methods(decl).forEach({ m ->
        m.annotations.forEach({ a ->
            if (a.name == "cacheable")
                readers.push(
                    a.args.join("").replaceAll("\"", "").trim() + "|" + m.name,
                );
        });
    });
    var methods: Array<string> = [];
    var lossy = "";
    var badReturn = "";
    var twice = "";
    compiler.methods(decl).forEach({ m ->
        var readName = "";
        var evictName = "";
        var evictAll = false;
        var marks = 0;
        m.annotations.forEach({ a ->
            if (a.name == "cacheable") {
                readName = a.args.join("").replaceAll("\"", "").trim();
                marks = marks + 1;
            }
            if (a.name == "cacheEvict") {
                val first = a.args[0] ?? "";
                val second = a.args[1] ?? "false";
                evictName = first.replaceAll("\"", "").trim();
                evictAll = second.trim() == "true";
                marks = marks + 1;
            }
        });
        val two = if (marks > 1 && twice == "")
            compiler.name(decl)! + "." + m.name
        else
            twice;
        twice = two;
        var params: Array<string> = [];
        var args: Array<string> = [];
        var keyArgs: Array<string> = [];
        m.params.forEach({ p ->
            val lost = p.typeName == "";
            val note = if ((lost && p.name != "self" && lossy == ""))
                compiler.name(decl)! + "." + m.name + " parameter '" + p.name + "'"
            else
                lossy;
            lossy = note;
            if (p.name != "self") {
                params.push(p.name + ": " + p.typeName);
                args.push(p.name);
                keyArgs.push(
                    if (p.typeName == "string")
                        p.name
                    else
                        p.name + ".toString()",
                );
            }
        });
        val ret = m.returnType;
        val lostRet = false;
        val retNote = if ((lostRet && lossy == ""))
            compiler.name(decl)! + "." + m.name + " return type '" + ret + "'"
        else
            lossy;
        lossy = retNote;
        val badRet = if (readName != "" && ret != "string" && badReturn == "")
            compiler.name(decl)! + "." + m.name + " returns `" + ret + "`"
        else
            badReturn;
        badReturn = badRet;
        val call = "self.inner." + m.name + "(" + args.join(", ") + ")";
        val head = if (params.length > 0)
            "pub fn " + m.name + "(self: Self, " + params.join(", ") + ")"
        else
            "pub fn " + m.name + "(self: Self)";
        val sig = if (ret != "") head + " -> " + ret else head;
        val parts = if (keyArgs.length > 0)
            "[\"" + m.name + "\", " + keyArgs.join(", ") + "]"
        else
            "[\"" + m.name + "\"]";
        var evictKeys: Array<string> = [];
        readers.forEach({ r ->
            val bar = r.indexOf("|");
            val rname = r.slice(0, bar);
            val rmethod = r.slice(bar + 1, r.length());
            if (rname == evictName)
                evictKeys.push(
                    if (keyArgs.length > 0)
                        "[\"" + rmethod + "\", " + keyArgs.join(", ") + "]"
                    else
                        "[\"" + rmethod + "\"]",
                );
        });
        val evictCall = if (evictAll)
            "cacheEvictAll(\"" + evictName + "\")"
        else
            "cacheEvictKeys(\""
                + evictName
                + "\", ["
                + evictKeys.join(", ")
                + "])";
        val body = if (readName != "")
            "return cacheMethod(\""
                + readName
                + "\", "
                + parts
                + ", { -> "
                + call
                + " });"
        else if (evictName != "") {
            if (ret != "")
                "val out = "
                    + call
                    + ";\n        val _e = "
                    + evictCall
                    + ";\n        return out;"
            else
                call + ";\n        val _e = " + evictCall + ";";
        } else if (ret != "") "return " + call + ";" else call + ";";
        methods.push(sig + " {\n        " + body + "\n    }");
    });
    if (compiler.kind(decl) != DeclKind.Behavior)
        compiler.fail(
            "#[cached] must annotate a behavior - it reflects the behavior's method signatures and gives it the "
                + compiler.name(decl)!
                + ".Cached twin that implements it",
            at: decl,
        );
    if (twice != "")
        compiler.fail(
            "#[cached]: "
                + twice
                + " carries both #[cacheable] and #[cacheEvict] - one cache role per method",
            at: decl,
        );
    if (badReturn != "")
        compiler.fail(
            "#[cached]: "
                + badReturn
                + " - a #[cacheable] method returns string, the only value the store holds",
            at: decl,
        );
    if (lossy != "")
        compiler.fail(
            "#[cached] cannot forward "
                + lossy
                + ": reflection gave no type for it, so the twin cannot redeclare it",
            at: decl,
        );
    compiler.addType(
        "Cached",
        compiler.buildType("(inner: "
            + compiler.name(decl)!
            + ") implement "
            + compiler.name(decl)!
            + " {\n    "
            + methods.join("\n\n    ")
            + "\n}"),
    );
}

pub fn cacheable(syntax decl: unknown, comptime name: string) {
    if (compiler.kind(decl) != DeclKind.Method)
        compiler.fail(
            "#[cacheable] must annotate a method of a #[cached] behavior",
            at: decl,
        );
}

pub fn cacheEvict(
    syntax decl: unknown,
    comptime name: string,
    comptime allEntries: bool,
) {
    if (compiler.kind(decl) != DeclKind.Method)
        compiler.fail(
            "#[cacheEvict] must annotate a method of a #[cached] behavior",
            at: decl,
        );
}
