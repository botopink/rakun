//// rakun-cache — the boot check, the `caches` endpoint and the `cache`
//// health indicator (front 12 step 8).

import {io: {fs}} from "std";
import {rkSetProp, Response, rkDispatchHttp} from "rakun";
import {resetChain} from "rakun-web";
import {Health} from "rakun";
import {mountActuator, installExposure, clearExposure} from "rakun-actuator";
import {cache.CacheScope, cache.cachePolicy, cache.cacheLife, cache.cacheThrough, cache.cacheSize, cache.resetCaches};
import {cache_endpoint.installCache, cache_endpoint.cacheConfigProblem, cache_endpoint.cacheHealth, cache_endpoint.cachesListing};
import {cache_host.rkCacheRespDoubleStart, cache_host.rkCacheRespDoubleStop};

fn boot(names: string) -> i32 {
    val _r = resetChain();
    val _t = rkSetProp("rakun.cache.type", "ets");
    val _n = rkSetProp("rakun.cache.names", names);
    val _u = rkSetProp("rakun.cache.redis.url", "");
    val _z = resetCaches();
    val _a = mountActuator();
    return installCache();
}

fn fill(name: string, key: string) -> string {
    return cacheThrough(cachePolicy(CacheScope.Shared, name, cacheLife("hours"), []), [key], { -> key });
}

test "endpoint: GET lists the configured caches and the ones created on first use, with provider and size" {
    val _b = boot("ep-products, ep-prices");
    val _o = installExposure({ id -> true });
    val _f = fill("ep-products", "a");
    val _g = fill("ep-products", "b");
    val _h = fill("ep-lazy", "c");
    val res: Response = rkDispatchHttp("GET", "/actuator/caches", "{}", "{}", "");
    val _c = clearExposure();
    assert res.status == 200, res.body;
    assert res.body.contains("{\"name\":\"ep-products\",\"provider\":\"ets\",\"entries\":2}");
    assert res.body.contains("{\"name\":\"ep-prices\",\"provider\":\"ets\",\"entries\":0}");
    assert res.body.contains("{\"name\":\"ep-lazy\",\"provider\":\"ets\",\"entries\":1}");
}

test "endpoint: DELETE of one cache empties exactly it with 204, and an unknown name is 404" {
    val _b = boot("ep-one, ep-two");
    val _o = installExposure({ id -> true });
    val _f = fill("ep-one", "a");
    val _g = fill("ep-two", "b");
    val del: Response = rkDispatchHttp("DELETE", "/actuator/caches/ep-one", "{}", "{}", "");
    val missing: Response = rkDispatchHttp("DELETE", "/actuator/caches/nope", "{}", "{}", "");
    val _c = clearExposure();
    assert del.status == 204;
    assert missing.status == 404;
    assert cacheSize("ep-one") == 0 && cacheSize("ep-two") == 1;
}

test "endpoint: DELETE of the collection empties every cache" {
    val _b = boot("ep-a, ep-b");
    val _o = installExposure({ id -> true });
    val _f = fill("ep-a", "a");
    val _g = fill("ep-b", "b");
    val del: Response = rkDispatchHttp("DELETE", "/actuator/caches", "{}", "{}", "");
    val _c = clearExposure();
    assert del.status == 204;
    assert cacheSize("ep-a") == 0 && cacheSize("ep-b") == 0;
}

test "endpoint: unexposed, every route answers the host's 404 and nothing is cleared" {
    val _b = boot("ep-hidden");
    val _c = clearExposure();
    val _f = fill("ep-hidden", "a");
    val list: Response = rkDispatchHttp("GET", "/actuator/caches", "{}", "{}", "");
    val one: Response = rkDispatchHttp("DELETE", "/actuator/caches/ep-hidden", "{}", "{}", "");
    val all: Response = rkDispatchHttp("DELETE", "/actuator/caches", "{}", "{}", "");
    assert list.status == 404 && one.status == 404 && all.status == 404;
    assert cacheSize("ep-hidden") == 1;
}

test "endpoint: no key of this module opens the endpoint" {
    val text: string = fs.readText("src/cache_endpoint.bp").unwrapOr("");
    assert text.contains("exposed(\"caches\")");
    assert text.contains("rkProp(\"rakun.cache.endpoint") == false;
    assert text.contains("rakun.management") == false;
}

test "endpoint: health is UP on ets and DOWN naming redis when Redis does not answer" {
    val _b = boot("ep-h");
    val up: Health = cacheHealth();
    assert up.status == "UP", up.details;
    assert up.details == "{\"providers\":[\"ets\"]}";
    val _t = rkSetProp("rakun.cache.ep-remote.type", "redis");
    val _u = rkSetProp("rakun.cache.redis.url", "redis://127.0.0.1:1");
    val _n = rkSetProp("rakun.cache.names", "ep-h, ep-remote");
    val _i = installCache();
    val down: Health = cacheHealth();
    assert down.status == "DOWN";
    assert down.details.contains("\"provider\":\"redis\"");
    val port = rkCacheRespDoubleStart();
    val _v = rkSetProp("rakun.cache.redis.url", "redis://127.0.0.1:" + port.toString());
    val back: Health = cacheHealth();
    val _s = rkCacheRespDoubleStop();
    val _y = rkSetProp("rakun.cache.ep-remote.type", "");
    val _x = rkSetProp("rakun.cache.redis.url", "");
    assert back.status == "UP", back.details;
}

test "endpoint: the boot refuses an unknown provider and a Redis cache without a URL, naming the key" {
    val _t = rkSetProp("rakun.cache.type", "memcached");
    assert cacheConfigProblem().contains("rakun.cache.type is `memcached`");
    val _r = rkSetProp("rakun.cache.type", "redis");
    val _u = rkSetProp("rakun.cache.redis.url", "");
    assert cacheConfigProblem().contains("rakun.cache.redis.url is required");
    val _e = rkSetProp("rakun.cache.type", "ets");
    val _n = rkSetProp("rakun.cache.names", "ep-bad");
    val _v = rkSetProp("rakun.cache.ep-bad.eviction", "fifo");
    assert cacheConfigProblem().contains("rakun.cache.ep-bad.eviction is `fifo`");
    val _w = rkSetProp("rakun.cache.ep-bad.eviction", "");
    val _x = rkSetProp("rakun.cache.names", "");
    assert cacheConfigProblem() == "";
}
