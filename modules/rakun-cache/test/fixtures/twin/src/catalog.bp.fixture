import {service, rkScan, rkSingleton, rkEnter, rkDone, rkSetProp, rkPropInt} from "rakun";
import {cached, cacheable, cacheEvict, cacheMethod, cacheEvictAll, cacheEvictKeys} from "rakun-cache";

#[cached]
pub behavior ProductCatalog {
    #[cacheable("products")]
    fn productJson(self: Self, id: string) -> string;

    #[cacheable("products")]
    fn listJson(self: Self, page: i32) -> string;

    #[cacheEvict("products", true)]
    fn reprice(self: Self, id: string, body: string) -> string;

    #[cacheEvict("products", false)]
    fn forget(self: Self, id: string) -> string;

    fn slugFor(self: Self, id: string) -> string;
}

// The behavior's own module reaches the emitted factory directly.
pub fn readTwice(inner: ProductCatalog, id: string) -> string {
    val c = ProductCatalog.Cached(inner: inner);
    val _first = c.productJson(id);
    return c.productJson(id);
}

// The implementation lives beside the behavior and its twin: a call through
// a `ProductCatalog`-typed receiver dispatches on the value.
fn count(what: string) -> i32 {
    val n = rkPropInt("calls." + what) + 1;
    return rkSetProp("calls." + what, n.toString());
}

#[service]
pub type SqlProductCatalog() implement ProductCatalog {
    pub fn productJson(self: Self, id: string) -> string {
        val _c = count("productJson");
        return "{\"id\":\"" + id + "\",\"n\":" + rkPropInt("calls.productJson").toString() + "}";
    }

    pub fn listJson(self: Self, page: i32) -> string {
        val _c = count("listJson");
        return "{\"page\":" + page.toString() + "}";
    }

    pub fn reprice(self: Self, id: string, body: string) -> string {
        if (body == "boom") @panic("reprice failed");
        val _c = count("reprice");
        return "{\"id\":\"" + id + "\",\"repriced\":true}";
    }

    pub fn forget(self: Self, id: string) -> string {
        val _c = count("forget");
        return id;
    }

    pub fn slugFor(self: Self, id: string) -> string {
        val _c = count("slugFor");
        return "product-" + id;
    }
}

