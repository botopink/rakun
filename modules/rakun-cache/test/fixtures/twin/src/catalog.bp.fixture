import {cached, cacheable, cacheEvict, cacheMethod, cacheEvictAll, cacheEvictKeys} from "rakun-cache";

#[cached]
pub behavior ProductCatalog {
    #[cacheable("products")]
    fn productJson(self: Self, id: string) -> string;

    #[cacheable("products")]
    fn listJson(self: Self, page: i32) -> string;

    #[cacheEvict("products", true)]
    fn reprice(self: Self, id: string, body: string) -> string;

    #[cacheEvict("products", false)]
    fn forget(self: Self, id: string) -> string;

    fn slugFor(self: Self, id: string) -> string;
}

// The behavior's own module reaches the emitted factory directly.
pub fn readTwice(inner: ProductCatalog, id: string) -> string {
    val c = cachedProductCatalog(inner);
    val _first = c.productJson(id);
    return c.productJson(id);
}
