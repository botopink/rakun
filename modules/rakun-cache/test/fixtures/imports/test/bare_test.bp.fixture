import {revalidateTag, revalidatePath, cacheThrough, cachePolicy, cacheLife, CacheScope, revalidatedTags, clearRevalidated, resetCaches} from "rakun-cache";
import {rkSetProp} from "rakun";

test "import: the bare form" {
    val _t = rkSetProp("rakun.cache.type", "ets");
    val _r = resetCaches();
    val _c = clearRevalidated();
    val policy = cachePolicy(CacheScope.Shared, "imp-bare", cacheLife("hours"), ["b"]);
    assert cacheThrough(policy, ["k"], { -> "loaded" }) == "loaded";
    assert revalidateTag("b") == 1;
    assert revalidatedTags().join(",") == "b";
}
