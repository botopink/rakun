import {cache} from "rakun-cache";
import {rkSetProp} from "rakun";

test "import: the qualified form" {
    val _t = rkSetProp("rakun.cache.type", "ets");
    val _r = cache.resetCaches();
    val _c = cache.clearRevalidated();
    assert cache.revalidateTag("q") == 0;
    assert cache.revalidatedTags().join(",") == "q";
}
