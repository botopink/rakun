//// rakun — the file-convention route table (front 22): the registry that
//// holds it, the page renderers and route handlers registered beside it, and
//// the `app/` scan that keeps it honest.
////
//// `#[restController]` + `#[getMapping]` (`decorators.bp`) route by DECORATOR and
//// that model is untouched. This module is the other one: a URL that comes from
//// where a file sits. The table's records are `kind|pattern|slot|verb` lines;
//// the grammar, the wire and the matcher are the bundled library `routing`
//// (decision 115), which the browser's router imports too, so the two sides
//// cannot disagree about which route a URL is.
////
//// WHAT A RECORD HOLDS, AND WHO PUTS IT THERE (decisions 113, 114). The route
//// table is rakun's; what a UI convention file declares belongs to the HTML
//// library, and rakun names none of its types. The application's orchestrator
//// copies the UI records (`L`, `T`, `D`, `S`, `E`, `N`) into this table at boot
//// through `rkAppRegisterEntry`; a page reaches it through front 23's
//// `page(pattern, render)` → `rkAppRegisterPage`, with one OPAQUE renderer this
//// module stores and never calls; a `route.bp` handler reaches it through
//// front 25's `rkAppRegisterHandler`. The UI decorators, the page context, the
//// layout props and the per-route parameter accessors are the HTML library's
//// (its front 30).
////
//// THE REGISTRY LIVES IN THE HOST (`src/sidecars/rakun_file_router.erl`)
//// because botopink has no top-level mutable state and a registered renderer is
//// a closure no string store can hold — the reason `rkRegisterRoute`'s table
//// lives in `rakun_runtime.erl`. The atom is `rakun_file_router`, never
//// `file_router`: `shipErlSidecars` skips an atom matching an emitted module
//// basename, silently.
////
//// LANGUAGE NOTES this file is written around (measured, not guessed; the full
//// list is in `AGENTS.md` § Language notes):
////   * `&&` and `||` inside an `if (…)` head need their own parentheses.
////   * On erlang a `return` inside an `if` nested in an `if` block is dropped
////     (`language-gaps.md`): every early return here is at the top level.

import {io.fs} from "std";
import {Request} from "rakun";
import {rkProp} from "rakun";
import {
    segment: {parseSegment, parsePath, patternOf, slotOf, pathProblem, kindName},
    table: {RouteEntry, writeTable, parseTable},
    match: {RouteMatch, splitPath, matchPath, layoutChain},
} from "routing";

// ── step 2: the registry — table records and opaque page renderers ──────────

// Store one finished `kind|pattern|slot|verb` record, with the function that
// answers it (a page renderer, a route handler) or with none.
#[@External.Erlang("rakun_file_router", "store")]
pub declare fn rkAppStore<F>(record: string, fun: F) -> i32;

#[@External.Erlang("rakun_file_router", "store_entry")]
pub declare fn rkAppStoreEntry(record: string) -> i32;

#[@External.Erlang("rakun_file_router", "table")]
pub declare fn rkAppTable() -> string;

#[@External.Erlang("rakun_file_router", "count")]
pub declare fn rkAppCount() -> i32;

#[@External.Erlang("rakun_file_router", "has_render")]
pub declare fn rkAppHasRender(record: string) -> bool;

// The stored function, or `fallback` when nothing registered that record.
// Total and typed: front 23 needs a value it can call either way.
#[@External.Erlang("rakun_file_router", "render")]
pub declare fn rkAppRender<F>(record: string, fallback: F) -> F;

#[@External.Erlang("rakun_file_router", "reset")]
pub declare fn rkAppReset() -> i32;

// Where each registration was WRITTEN — the app-relative directory and the
// function that registered it — kept beside the table for the scan, which
// names that function when the directory does not exist.
#[@External.Erlang("rakun_file_router", "register_source")]
pub declare fn rkAppRegisterSource(seg: string, fnName: string) -> i32;

#[@External.Erlang("rakun_file_router", "sources")]
pub declare fn rkAppSources() -> string;

// The eight kind letters of the wire (contract 1).
pub fn entryKinds() -> string[] {
    return ["L", "T", "P", "D", "R", "S", "E", "N"];
}

pub fn unknownKindProblem(kind: string) -> string {
    return "rakun routing: `" + kind + "` is not a route kind - the kinds are " + entryKinds().join(", ");
}

pub fn duplicatePageProblem(pattern: string) -> string {
    return "rakun routing: a page is already registered for `" + pattern + "` - the table never holds two pages for one URL";
}

// The one place a kind, an app-relative segment, a slot and a verb become a
// wire record. It HALTS on a segment that may not be registered — a
// `_`-prefixed folder, a `|` or a newline — because a registration is a boot
// step and the program should stop there rather than serve something
// surprising. `slot` names the slot explicitly; `""` takes the one the segment
// spells (`@team`), if any.
pub fn entryLine(kind: string, seg: string, slot: string, verb: string) -> string {
    val segs = parsePath(seg);
    val slotName: string = if (slot == "") slotOf(segs) else slot;
    return writeTable([RouteEntry(kind: kind, pattern: patternOf(segs), slot: slotName, verb: verb)]);
}

// How the orchestrator copies one of the HTML library's UI records into the table.
pub fn rkAppRegisterEntry(kind: string, seg: string, slot: string) -> i32 {
    val known: bool = entryKinds().filter({ k -> k == kind }).length > 0;
    if (known == false) @panic(unknownKindProblem(kind));
    return rkAppStoreEntry(entryLine(kind, seg, slot, ""));
}

// What front 23's `page(pattern, render)` calls. The renderer is opaque here:
// stored beside its `P` record, handed back to the dispatch, never called.
pub fn rkAppRegisterPage<R>(seg: string, render: R) -> i32 {
    val record: string = entryLine("P", seg, "", "");
    if (rkAppHasRender(record)) @panic(duplicatePageProblem(parseTable(record).at(0).map({ e -> e.pattern }).unwrapOr(seg)));
    return rkAppStore(record, render);
}

// Front 25's `route.bp` handlers register into the SAME table as `R` records.
pub fn rkAppRegisterHandler<Res>(verb: string, seg: string, handle: fn(req: Request) -> Res) -> i32 {
    return rkAppStore(entryLine("R", seg, "", verb), handle);
}

// The registered table, parsed. The server reads it from its own registry and
// the client rebuilds it out of the payload's `t` with the same `parseTable`.
pub fn appTable() -> RouteEntry[] {
    return parseTable(rkAppTable());
}

// The route a pathname reaches in the registered table — a page or a handler —
// or `null`; and the layout chain above a pattern. Both are `routing`'s, over
// this registry's table: the orchestrator builds the HTML library's segment
// chain from `appLayoutChain`, never from a rakun type the library would have
// to name.
pub fn appMatch(pathname: string) -> ?RouteMatch {
    return matchPath(appTable(), pathname);
}

pub fn appLayoutChain(pattern: string) -> RouteEntry[] {
    return layoutChain(appTable(), pattern);
}

// ── step 5: the scan ────────────────────────────────────────────────────────
//
// The scan is the half that keeps the decorator argument HONEST. It reads
// `appDir` from front 05's property table, walks the real tree, and fails
// loudly rather than serving something surprising.
//
// IT IS WRITTEN IN BOTOPINK, over `std`'s `fs`, and not in the two host files
// the front's text puts it in. Two reasons, both front 05's. A scan written
// twice can disagree twice, and the whole point of this front is that the two
// sides cannot disagree; and an erlang-only cell cannot be asserted from a
// `.bp` test at all, so the acceptance list below would have had to be taken on
// trust. `fs.list`, `fs.exists` and `fs.stat` each carry both host forms, so one
// implementation answers identically on both rows — which is the only claim
// worth making about a port.
//
// The REFUSALS are strings rather than a halt, for the reason `durationProblem`
// is a function of its own: the CLI (front 50) prints them and stops, a server
// boot check prints them and stops, and a test reads them without the halt
// taking the test down.

pub fn noStrings() -> string[] {
    var out: string[] = [];
    return out;
}

// The eight convention filenames, in the order their kind letters are listed.
pub fn conventionFiles() -> string[] {
    return [
        "layout.bp",
        "template.bp",
        "page.bp",
        "default.bp",
        "route.bp",
        "loading.bp",
        "error.bp",
        "not-found.bp",
    ];
}

pub fn conventionKind(file: string) -> string {
    if (file == "layout.bp") return "L" else if (file == "template.bp") return "T" else if (file == "page.bp") return "P" else if (file == "default.bp") return "D" else if (file == "route.bp") return "R" else if (file == "loading.bp") return "S" else if (file == "error.bp") return "E" else if (file == "not-found.bp") return "N" else return "";
}

// `appDir` is CONFIGURATION, not a literal (front 05): `rakun.appDir`, `app` or
// `src/app` (`app` when unset), so moving the tree between the two layouts
// changes one config line and no source. The orchestrator writes the key at
// boot; rakun reads only `rakun.*` keys (decision 115 rule 4).
pub fn appDirOf() -> string {
    val configured = rkProp("rakun.appDir");
    if (configured == "") return "app" else return configured;
}

// A name is a directory when listing it succeeds. `fs.stat` would say so more
// directly, but its `FileStat` carries an `i64` field and an integer literal is
// `i32` with no widening, so a fallback value for the `catch` cannot be written.
pub fn isDir(path: string) -> bool {
    return fs.list(path).isOk();
}

pub fn childDirs(path: string) -> string[] {
    val names = try fs.list(path) catch noStrings();
    var out: string[] = [];
    for (names) { n ->
        if (isDir(path + "/" + n)) {
            out.push(n);
        };
    };
    return out;
}

// Every app-relative directory under `base`, depth first, with `_`-prefixed
// folders SKIPPED — nothing inside one is registered even if it holds a
// `page.bp`. The root itself is not in the list; `scanAppDir` adds it as `""`.
pub fn walkSegments(base: string, seg: string) -> string[] {
    val here = if (seg == "") base else base + "/" + seg;
    var out: string[] = [];
    for (childDirs(here)) { name ->
        if (name.startsWith("_").negate()) {
            val child = if (seg == "") name else seg + "/" + name;
            out.push(child);
            for (walkSegments(base, child)) { deeper ->
                out.push(deeper);
            };
        };
    };
    return out;
}

pub fn conventionsIn(base: string, seg: string) -> string[] {
    val dir = if (seg == "") base else base + "/" + seg;
    var out: string[] = [];
    for (conventionFiles()) { f ->
        if (fs.exists(dir + "/" + f)) {
            out.push(f);
        };
    };
    return out;
}

pub type ScanEntry(
    seg: string,
    pattern: string,
    slot: string,
    conventions: string[],
)

pub type ScanReport(
    appDir: string,
    entries: ScanEntry[],
    middleware: string,
    problems: string[],
)

// The table the tree implies, in walk order — the same records the markers
// register, derived from the directories instead of from the arguments. The two
// are compared by `registrationProblems`.
pub fn scanTable(report: ScanReport) -> RouteEntry[] {
    var out: RouteEntry[] = [];
    for (report.entries) { e ->
        for (e.conventions) { f ->
            val kind = conventionKind(f);
            val verb = if (kind == "R") "GET" else "";
            out.push(RouteEntry(kind: kind, pattern: e.pattern, slot: e.slot, verb: verb));
        };
    };
    return out;
}

pub fn scanAppDir(root: string, appDir: string) -> ScanReport {
    val base = if (root == "") appDir else root + "/" + appDir;
    var entries: ScanEntry[] = [];
    var problems: string[] = [];
    var segs: string[] = [""];
    for (walkSegments(base, "")) { s ->
        segs.push(s);
    };
    for (segs) { seg ->
        val found = conventionsIn(base, seg);
        if (found.length > 0) {
            val problem = pathProblem(seg);
            if (problem != "") {
                problems.push(problem);
            } else {
                val parsed = parsePath(seg);
                entries.push(
                    ScanEntry(
                        seg: seg,
                        pattern: patternOf(parsed),
                        slot: slotOf(parsed),
                        conventions: found,
                    ),
                );
            };
        };
    };
    for (conflictProblems(entries)) { p ->
        problems.push(p);
    };
    val middlewarePath = if (root == "") "middleware.bp" else root + "/middleware.bp";
    val middleware = if (fs.exists(middlewarePath)) middlewarePath else "";
    return ScanReport(
        appDir: appDir,
        entries: entries,
        middleware: middleware,
        problems: problems,
    );
}

// The top-level `(group)` a segment sits under, `""` when it sits under none.
pub fn rootGroupOf(seg: string) -> string {
    val parts = splitPath(seg);
    if (parts.length == 0) return "" else {
        val head = parts.at(0).unwrapOr("");
        if (kindName(parseSegment(head).kind) == "Group") return head else return "";
    };
}

pub fn hasConvention(e: ScanEntry, file: string) -> bool {
    var found = false;
    for (e.conventions) { f ->
        if (f == file) {
            found = true;
        };
    };
    return found;
}

// Two rules the tree can break on its own, both refused by name. The second is
// § 5 Múltiplos Root Layouts: two route groups may each own a root layout, and
// that is legal right up to the point where their subtrees claim one URL.
pub fn conflictProblems(entries: ScanEntry[]) -> string[] {
    var problems: string[] = [];
    for (entries) { e ->
        if ((hasConvention(e, "page.bp") && hasConvention(e, "route.bp"))) {
            problems.push(
                "rakun routing: `" + e.seg + "` holds both page.bp and route.bp — a segment is a page or an endpoint, never both",
            );
        };
    };
    var keys: string[] = [];
    var groups: string[] = [];
    for (entries) { e ->
        if (hasConvention(e, "page.bp")) {
            val key = e.pattern + "|" + e.slot;
            val group = rootGroupOf(e.seg);
            val prior = keys.indexOf(key);
            if (prior >= 0) {
                val priorGroup = groups.at(prior).unwrapOr("");
                if (priorGroup != group) {
                    problems.push(
                        "rakun routing: `" + e.pattern + "` is claimed by both `" + priorGroup + "` and `" + group + "` — two root layouts whose subtrees match one URL",
                    );
                };
            };
            keys.push(key);
            groups.push(group);
        };
    };
    return problems;
}

// ── the registered side of the scan ─────────────────────────────────────────

pub type SourceEntry(
    seg: string,
    fnName: string,
)

pub fn parseSources(wire: string) -> SourceEntry[] {
    var out: SourceEntry[] = [];
    if (wire == "") return out else {
        for (wire.split("\n")) { line ->
            if (line != "") {
                val f: string[] = line.split("|");
                out.push(SourceEntry(seg: f.at(0).unwrapOr(""), fnName: f.at(1).unwrapOr("")));
            };
        };
        return out;
    };
}

pub fn appSources() -> SourceEntry[] {
    return parseSources(rkAppSources());
}

// The check that keeps the decorator argument honest, in both directions: a
// registered segment with no directory under `appDir`, and a directory holding a
// convention file that registered nothing.
pub fn registrationProblems(report: ScanReport, sources: SourceEntry[]) -> string[] {
    var problems: string[] = [];
    var known: string[] = [];
    for (report.entries) { e ->
        known.push(e.seg);
    };
    for (sources) { src ->
        var found = false;
        for (known) { k ->
            if (k == src.seg) {
                found = true;
            };
        };
        if (found.negate()) {
            problems.push(
                "rakun routing: `" + src.seg + "` was registered by `" + src.fnName + "` but there is no directory `" + report.appDir + "/" + src.seg + "`",
            );
        };
    };
    for (report.entries) { e ->
        var registered = false;
        for (sources) { src ->
            if (src.seg == e.seg) {
                registered = true;
            };
        };
        if (registered.negate()) {
            problems.push(
                "rakun routing: `" + report.appDir + "/" + e.seg + "` holds " + e.conventions.join(
                    ", "
                ) + " but nothing registered it — the marker's argument is what puts a route in the table",
            );
        };
    };
    return problems;
}
