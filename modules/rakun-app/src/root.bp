//// rakun-app — the server half of the Next.js `app/` router.
////
//// Front 22's file-convention route registry and `app/` scan (`file_router`)
//// and front 23's SSR pipeline and page dispatch (`ssr`), relocated out of the
//// core by front 95 (`specs/1.0.10-beta/03-rakun/modules.md` § The cut): a
//// Spring-style REST service never loads them, and nothing in the core imports
//// either. Fronts 24, 25, 60, 61, 63, 64 and 66 land here too. Reached by a
//// consumer via `import {…} from "rakun-app"`; the core's surface (`Request`,
//// `Response`, `rkProp`, the request context) is imported `from "rakun"`.
////
//// The host halves ship beside the code: `sidecars/rakun_file_router.erl` /
//// `sidecars/rakun_ssr.erl` (erlang-only, decision 113).

// `file_router` before `ssr`: front 23's pipeline imports it, and the `files`
// ORDER in `botopink.json` is a dependency order a consumer's build reads
// literally.
pub mod file_router;
pub mod ssr;
// Front 63: navigation signals. It imports `file_router`, and front 25 captures them.
pub mod navigation;
// Front 25: `route.bp` handlers. It imports `file_router`, `ssr` and `navigation`.
pub mod route_handler;
// Front 24: server actions. It imports `ssr`, `navigation` and `route_handler`
// (the app fallback it stands in front of, and the handler writer).
pub mod actions;
// Front 60: static generation. `static_host` (the sidecar's cells) before
// `segment_config` before `static_gen`, which imports both, `ssr` and
// rakun-cache (the store the prerendered entries live in).
pub mod static_host;
pub mod segment_config;
pub mod static_gen;
// Front 61: parallel and intercepting routes, over front 22's table and
// `routing`'s matcher; nothing here imports a later module.
pub mod route_slots;
pub mod route_intercept;
// Front 64: locale routing. It imports rakun-web's chain and rakun-cache.
pub mod i18n;
// Front 66: metadata file routes, over front 25's `registerRoute` and front
// 23's renderer type.
pub mod metadata_routes;
