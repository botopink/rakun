//// rakun — the page path (front 23): the chunk writer, the page renderer and
//// the dispatch.
////
//// rakun BUILDS NO HTML (decision 113). A page's markup is the HTML library's
//// (its front 30): the walker, the escaping, the layout composition, the
//// document and the payload. The two never import each other; the
//// application's orchestrator hands this front one OPAQUE renderer per page
//// pattern (decision 114), and the renderer writes its status, its headers and
//// its chunks through the `ChunkWriter` rakun gives it. rakun writes them to
//// the socket in the order it was handed them and reads none of them.
////
//// THE PAGE PATH, END TO END, ON BEAM:
////
////     request
////       -> 22  matchPath(table, pathname)       `routing`; no page -> 404, no renderer runs
////       -> 22  the renderer registered for the matched pattern
////       -> 62  request scope, setPhase(Render)  headers, cookies, memo cache
////       -> 23  render(req, out)                 status, headers, chunks through `out`
////       -> 23  out.close() when the renderer's task resolves, unless it closed
////       -> 62  previous phase restored, scope closed
////
//// STATUS. 200 with `Content-Type: text/html; charset=utf-8` unless the
//// renderer said otherwise; `setStatus` / `setHeader` are legal before the
//// first `write` only, and a call after it fails the request naming the call
//// (decision 67). The head goes out with the first chunk, or with `close` when
//// nothing was written — a 307 with `location` and no body. A raise out of the
//// renderer — a navigation reason included, since page signals are the HTML
//// library's (decision 117 rule 1) — and an `Error(msg)` it answers are one
//// failed render (decision 130): 500 when nothing was written yet, the
//// response closed otherwise, the reason logged under a correlation digest and
//// never written. The response is closed exactly once.
////
//// THE WRITER (`src/sidecars/rakun_ssr.erl`) streams to the connection's socket
//// when the request came through front 04's listener (HTTP/1.1 chunked), and
//// buffers when it did not (`rkDispatchHttp` from a test): the dispatch then
//// answers the buffer as one `Response`.

import {collections.Dict, querystring} from "std";
import {Request, Response, rkProp} from "rakun";
import {
    RequestPhase,
    RequestScope,
    beginRequest,
    endRequest,
    requestLive,
    requestPhase,
    setPhase,
} from "rakun/request_context";
import {rkAppRegisterPage, rkAppTable, rkAppRender} from "file_router";
import {table: {RouteEntry, parseTable, writeTable}, match: {RouteMatch, matchPath}} from "routing";

// ── step 1: the seam ────────────────────────────────────────────────────────

pub type ChunkWriter(
    setStatus: fn(code: i32) -> void,
    setHeader: fn(name: string, value: string) -> void,
    write: fn(chunk: string) -> @Task<void>,
    close: fn() -> @Task<void>,
)

// A renderer's `Error(msg)` is answered like a raise (decision 130): 500 when
// nothing was written, otherwise the response is closed; the message goes to
// the log under a correlation digest, never on the wire.
pub type PageRenderer = fn(req: Request, out: ChunkWriter) -> @Task<@Result<void, string>>;

// The orchestrator's one call per page pattern, at boot. A second renderer for
// one pattern fails here, naming it (front 22's `rkAppRegisterPage`).
pub fn page(pattern: string, render: PageRenderer) -> i32 {
    return rkAppRegisterPage(pattern, render);
}

// The four doors as functions of this module. A module that IMPORTS
// `ChunkWriter` cannot call a function-typed field directly on the erlang
// backend today — `out.write(x)` there lowers to a method call `write/2`
// (`language-gaps.md`) — so a renderer written elsewhere goes through these.
pub fn writeTo(out: ChunkWriter, chunk: string) -> @Task<void> {
    await out.write(chunk);
}

pub fn setStatusOn(out: ChunkWriter, code: i32) -> i32 {
    out.setStatus(code);
    return code;
}

pub fn setHeaderOn(out: ChunkWriter, name: string, value: string) -> i32 {
    out.setHeader(name, value);
    return 0;
}

pub fn closeOut(out: ChunkWriter) -> @Task<void> {
    await out.close();
}

// ── the host cells ──────────────────────────────────────────────────────────

#[@External.Erlang("rakun_ssr", "begin_page")]
pub declare fn rkSsrBegin() -> i32;

#[@External.Erlang("rakun_ssr", "set_status")]
pub declare fn rkSsrSetStatus(code: i32) -> void;

#[@External.Erlang("rakun_ssr", "set_header")]
pub declare fn rkSsrSetHeader(name: string, value: string) -> void;

#[@External.Erlang("rakun_ssr", "write")]
pub declare fn rkSsrWrite(chunk: string) -> @Task<void>;

#[@External.Erlang("rakun_ssr", "close")]
pub declare fn rkSsrClose() -> @Task<void>;

#[@External.Erlang("rakun_ssr", "status")]
pub declare fn rkSsrStatus() -> i32;

#[@External.Erlang("rakun_ssr", "header")]
pub declare fn rkSsrHeader(name: string) -> string;

#[@External.Erlang("rakun_ssr", "closed")]
pub declare fn rkSsrClosed() -> bool;

#[@External.Erlang("rakun_ssr", "started")]
pub declare fn rkSsrStarted() -> bool;

#[@External.Erlang("rakun_ssr", "streamed")]
pub declare fn rkSsrStreamed() -> bool;

#[@External.Erlang("rakun_ssr", "body")]
pub declare fn rkSsrBody() -> string;

// Run `render`; the text it answers, or the reason it raised.
#[@External.Erlang("rakun_ssr", "guard")]
pub declare fn rkSsrGuard(render: fn() -> @Task<string>) -> string;

// A failed render's reason, to the log under a correlation digest; answers the
// digest.
#[@External.Erlang("rakun_ssr", "log_failure")]
pub declare fn rkSsrLogFailure(reason: string) -> string;

// The request a renderer is handed: the page pattern's parameters
// (`name\tvalue` lines), and a query read that marks the render dynamic.
#[@External.Erlang("rakun_ssr", "page_request")]
pub declare fn rkSsrPageRequest(req: Request, paramsWire: string) -> Request;

#[@External.Erlang("rakun_ssr", "set_fallback")]
pub declare fn rkSsrSetFallback(dispatch: fn(req: Request) -> @Task<Response>) -> i32;

#[@External.Erlang("rakun_ssr", "clear_fallback")]
pub declare fn rkSsrClearFallback() -> i32;

// The writer a dispatch hands its renderer: four doors onto `rakun_ssr.erl`.
pub fn chunkWriter() -> ChunkWriter {
    return ChunkWriter(
        setStatus: { code -> rkSsrSetStatus(code) },
        setHeader: { name, value -> rkSsrSetHeader(name, value) },
        write: { chunk -> rkSsrWrite(chunk) },
        close: { -> rkSsrClose() },
    );
}

// ── step 2: the dispatch ────────────────────────────────────────────────────

// The page a pathname reaches: its `P` record and its parameters, or an empty
// record when no page claims it (a pattern carrying only a layout is not
// public).
pub type PageMatch(
    record: string,
    params: string,
)

pub fn matchPage(pathname: string) -> PageMatch {
    val pages: RouteEntry[] = parseTable(rkAppTable()).filter({ e -> (e.kind == "P") && (e.slot == "") });
    val found = matchPath(pages, pathname);
    if (found == null) return PageMatch(record: "", params: "");
    val m: RouteMatch = found;
    var lines: string[] = [];
    for (m.params.keys()) { k ->
        lines.push(k + "\t" + m.params.at(k).unwrapOr(""));
    };
    return PageMatch(record: writeTable([m.entry]), params: lines.join("\n"));
}

fn missingRenderer() -> PageRenderer {
    return { req, out -> notFoundStatus(out) };
}

fn notFoundStatus(out: ChunkWriter) -> @Task<@Result<void, string>> {
    out.setStatus(404);
    return;
}

pub fn renderErrorProblem(message: string) -> string {
    return "rakun ssr: the page renderer answered Error: " + message;
}

// The renderer's outcome as text: `""` for `Ok`, the problem for `Error(msg)`.
fn renderOutcome(render: PageRenderer, req: Request, out: ChunkWriter) -> @Task<string> {
    val r: @Result<void, string> = await render(req, out);
    return case r {
        Ok(_) -> "";
        Error(msg) -> renderErrorProblem(msg);
    };
}

pub fn notFoundProblem(pathname: string) -> string {
    return "rakun ssr: no page claims `" + pathname + "` - a pattern carrying nothing but a layout is not public";
}

// The dispatch: one function, the status written. The renderer runs inside one
// request scope in phase `Render`; a renderer that raised before writing is a
// 500; the response is closed once.
pub fn servePage(req: Request, out: ChunkWriter) -> @Task<i32> {
    val found: PageMatch = matchPage(req.path);
    if (found.record == "") {
        out.setStatus(404);
        await out.close();
        return 404;
    };
    val render: PageRenderer = rkAppRender(found.record, missingRenderer());
    val pageReq: Request = rkSsrPageRequest(req, found.params);
    val opened: bool = requestLive() == false;
    val _b = if (opened) beginRequest(RequestScope(
        id: "page",
        phase: RequestPhase.Render,
        method: "GET",
        path: req.path,
        query: "",
        headersWire: "",
        strict: rkProp("rakun.render.strict") == "true",
    )) else 0;
    val previous: RequestPhase = requestPhase();
    val _p = setPhase(RequestPhase.Render);
    val failure: string = rkSsrGuard({ -> renderOutcome(render, pageReq, out) });
    val _l = if (failure != "") rkSsrLogFailure(failure) else "";
    val _r = setPhase(previous);
    val _e = if (opened) endRequest() else "";
    val failedEarly: bool = (failure != "") && (rkSsrStarted() == false) && (rkSsrClosed() == false);
    val _f = if (failedEarly) failRender(out) else 0;
    val _c = await closeIfOpen(out);
    return rkSsrStatus();
}

fn failRender(out: ChunkWriter) -> i32 {
    out.setStatus(500);
    return 0;
}

fn closeIfOpen(out: ChunkWriter) -> @Task<i32> {
    if (rkSsrClosed()) return 0;
    await out.close();
    return 0;
}

// The page path as the core router's fallback: a request no decorator route
// matched reaches `servePage` with a fresh writer. Over the socket the writer
// has already written everything; without one the buffer is the `Response`.
pub fn servePages() -> i32 {
    return rkSsrSetFallback({ req -> pageResponse(req) });
}

pub fn stopServingPages() -> i32 {
    return rkSsrClearFallback();
}

pub fn pageResponse(req: Request) -> @Task<Response> {
    val _b = rkSsrBegin();
    val status: i32 = await servePage(req, chunkWriter());
    return Response(status: status, body: rkSsrBody());
}

// ── the query dict and the build id ─────────────────────────────────────────
//
// The query codec is std's `querystring` (RFC 3986: split on `&`, each field
// on its FIRST `=`, both sides percent-decoded). A malformed component — a `%`
// not followed by two hex digits, an escape that is not UTF-8, a control
// character raw or escaped — is refused, never kept as written (03r-e,
// std-a). A later duplicate name wins. The build id is front 03's content hash
// the orchestrator stamps.

pub fn queryDict(query: string) -> @Result<Dict<string, string>, string> {
    val pairs = try querystring.parse(query);
    var d = Dict.empty();
    for (pairs) { pair ->
        d = d.insert(pair._0, pair._1);
    };
    return d;
}

pub fn buildId() -> string {
    return rkProp("rakun.build.id");
}
