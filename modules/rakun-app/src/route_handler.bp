// ── the dispatch ────────────────────────────────────────────────────────────

#[compiler.external(.Erlang("rakun_ssr:begin_handler()"))]
declare fn rkSsrBeginHandler() -> i32;

#[compiler.external(.Erlang("rakun_ssr:add_header($0, $1)"))]
declare fn rkSsrAddHeader(name: string, value: string) -> void;

#[compiler.external(.Erlang("rakun_ssr:stream($0)"))]
declare fn rkSsrStream(tasks: array<fn() -> Async<string>>) -> i32;

#[compiler.external(.Erlang("rakun_ssr:set_fallback($0)"))]
declare fn rkAppSetFallback(
    dispatch: fn(req: Request) -> Async<Response>,
) -> i32;

// The verbs registered at the pattern a request reached, in table order.
pub fn verbsAt(pattern: string) -> string[] {
    return parseTable(rkAppTable())
        .filter({ e -> (e.kind == "R") && (e.pattern == pattern) })
        .map({ e -> e.verb });
}

fn missingHandler() -> fn(req: Request) -> Async<HandlerResponse> {
    return { req -> noHandler(req) };
}

async fn noHandler(req: Request) -> Async<HandlerResponse> {
    return HandlerResponse.notFound();
}

fn paramsOfMatch(m: RouteMatch) -> string {
    var lines: string[] = [];
    for (m.params.keys()) { k ->
        lines.push(k + "\t" + m.params.at(k) ?? "");
    }
    return lines.join("\n");
}

fn methodOf(req: Request) -> string {
    return rkReqVerb(req);
}

// The verb a request came with, as the string the router matched on.
#[compiler.external(.Erlang("""(fun(__R) -> maps:get(verb, __R) end)($0)"""))]
declare fn rkReqVerb(req: Request) -> string;

// Write one handler response through the writer: status, headers (a repeated
// name twice), the chunks, or the spawned thunks; `bodyless` drops the body
// (HEAD). Answers the status.
pub fn writeHandlerResponse(
    h: HandlerResponse,
    bodyless: bool,
    cookies: string,
) -> i32 {
    val _s = rkSsrSetStatus(h.status);
    for (h.headers) { p ->
        val _h = rkSsrAddHeader(p._0, p._1);
    }
    for (cookies.split("\n")) { c ->
        if (c != "") val _c = rkSsrAddHeader("Set-Cookie", c);
    }
    val _w = if (bodyless) 0 else writeBody(h);
    val _x = if (rkSsrClosed()) 0 else closeWriter();
    return h.status;
}

fn writeBody(h: HandlerResponse) -> i32 {
    if (h.tasks.length > 0) return rkSsrStream(h.tasks);
    for (h.chunks) { c ->
        val _w = rkSsrWrite(c);
    }
    return h.chunks.length;
}

fn closeWriter() -> i32 {
    val _c = rkSsrClose();
    return 0;
}

fn allowHeader(pattern: string) -> string {
    return verbsAt(pattern).join(", ");
}

// A handler for a request that reached an `R` record at `pattern`.
pub async fn serveHandler(req: Request, m: RouteMatch) -> Async<i32> {
    val pattern: string = m.entry.pattern;
    val verb: string = methodOf(req);
    val verbs: string[] = verbsAt(pattern);
    val has: fn(string) -> bool = { v -> verbs.filter({ x -> x == v }).length > 0 };
    val explicit: bool = has(verb);
    val headFallback: bool = (verb == "HEAD")
        && (explicit == false)
        && has("GET");
    val chosen: string = if (headFallback) "GET" else verb;
    val _b = rkSsrBeginHandler();
    if ((explicit == false) && (headFallback == false))
        return writeNoHandler(verb, pattern);
    val record: string = writeTable(
        [RouteEntry(kind: "R", pattern: pattern, slot: "", verb: chosen)],
    );
    val handle: fn(req: Request) -> Async<HandlerResponse> = rkAppRender(
        record,
        missingHandler(),
    );
    val handlerReq: Request = rkSsrPageRequest(req, paramsOfMatch(m));
    if (isMultipart(req))
        return writeHandlerResponse(
            HandlerResponse.unsupportedMedia(
                "multipart/form-data is not accepted - botopink has no byte type",
            ),
            false,
            "",
        );
    val opened: bool = requestLive() == false;
    val _o = if (opened)
        beginRequest(
            RequestScope(
                id: "handler",
                phase: RequestPhase.Handler,
                method: verb,
                path: req.path,
                query: "",
                headersWire: "",
                strict: false,
            ),
        )
    else
        0;
    val previous: RequestPhase = requestPhase();
    val _p = setPhase(RequestPhase.Handler);
    // A navigation signal out of the handler (front 63) becomes a 404 or a 3xx
    // with `Location`; any other raise is a 500.
    val result = rkRunHandler(
        { -> captureSignals({ -> handle(handlerReq) }, signalled()) },
    );
    val out: NavOutcome = takeSignal();
    val _r = setPhase(previous);
    val cookies: string = if (opened) endRequest() else "";
    val answered: HandlerResponse = signalResponse(out, result);
    return writeHandlerResponse(answered, headFallback, cookies);
}

async fn signalled() -> Async<HandlerResponse> {
    return HandlerResponse.noContent();
}

// The response a captured signal answers, or the handler's own when there was
// none.
pub fn signalResponse(
    out: NavOutcome,
    own: HandlerResponse,
) -> HandlerResponse {
    val none: bool = case out.kind {
        None -> true;
        _ -> false;
    };
    if (none) return own;
    val bare: HandlerResponse = HandlerResponse(
        status: statusFor(out),
        headers: [],
        chunks: [],
        tasks: [],
    );
    val location: string = locationHeaderFor(out) ?? "";
    if (location == "")
        return bare
    else
        return bare.withHeader("Location", location);
}

fn writeNoHandler(verb: string, pattern: string) -> i32 {
    val allow: string = allowHeader(pattern);
    val h: HandlerResponse = if (verb == "OPTIONS")
        HandlerResponse.noContent().withHeader("Allow", allow)
    else
        HandlerResponse(
            status: 405,
            headers: [#("Allow", allow)],
            chunks: [],
            tasks: [],
        );
    return writeHandlerResponse(h, false, "");
}

// Run a handler; a raise is a 500 with no reason in the body.
#[compiler.external(
    .Erlang("""(fun(__F) -> try __F() catch _:_ -> {'rakun_app@route_handler@@HandlerResponse', 500, [], [], []} end end)($0)"""),
)]
declare fn rkRunHandler(
    work: fn() -> Async<HandlerResponse>,
) -> HandlerResponse;

// The app path — pages and handlers — as the core router's fallback.
pub fn serveApp() -> i32 {
    return rkAppSetFallback({ req -> appResponse(req) });
}

pub async fn appResponse(req: Request) -> Async<Response> {
    val found = matchPath(parseTable(rkAppTable()), req.path);
    if (found != null)
        if (found.entry.kind == "R") {
            val status: i32 = await serveHandler(req, found);
            return Response(status: status, body: rkSsrBody());
        }
    val _p = rkSsrBegin();
    val pageStatus: i32 = await servePage(req, chunkWriter());
    return Response(status: pageStatus, body: rkSsrBody());
}
