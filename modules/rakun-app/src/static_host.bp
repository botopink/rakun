//// rakun-app — the host cells over `src/sidecars/rakun_static_gen.erl`
//// (front 60): the two registries, the decided kinds, the bounded fan-out,
//// single-flight regeneration, and the counters, gauge and log tests read.

import {compiler} from "std";

#[compiler.external(.Erlang("rakun_static_gen:config_put($0, $1)"))]
pub declare fn rkStaticConfigPut<C>(pattern: string, config: C) -> i32;

#[compiler.external(.Erlang("rakun_static_gen:config_get($0)"))]
declare fn rkStaticConfigGetRaw(pattern: string) -> unknown;

// The config recorded for `pattern`, as the `C` the caller names (668).
pub fn rkStaticConfigGet<C>(t: type<C>, pattern: string) -> ?C {
    val found = rkStaticConfigGetRaw(pattern);
    if (found is t) return found;
    return null;
}

#[compiler.external(.Erlang("rakun_static_gen:params_put($0, $1)"))]
pub declare fn rkStaticParamsPut<F>(pattern: string, produce: F) -> i32;

#[compiler.external(.Erlang("rakun_static_gen:params_get($0)"))]
pub declare fn rkStaticParamsGet(pattern: string) -> unknown;

#[compiler.external(.Erlang("rakun_static_gen:kind_put($0, $1, $2)"))]
pub declare fn rkStaticKindPut(
    pattern: string,
    kind: string,
    reason: string,
) -> i32;

// `pattern|S|reason` / `pattern|D|reason`, sorted by pattern.
#[compiler.external(.Erlang("rakun_static_gen:kinds()"))]
pub declare fn rkStaticKinds() -> string[];

#[compiler.external(.Erlang("rakun_static_gen:reset()"))]
pub declare fn rkStaticReset() -> i32;

// Runs the unstarted thunks in at most `n` processes at once; each result is
// the thunk's string, or `raised|<reason>`.
#[compiler.external(.Erlang("rakun_static_gen:run_bounded($0, $1)"))]
pub declare fn rkStaticRunBounded(
    n: i32,
    thunks: Array<fn() -> string>,
) -> string[];

// 1 when this call started the regeneration of `path`, 0 when one runs.
#[compiler.external(.Erlang("rakun_static_gen:regenerate($0, $1)"))]
pub declare fn rkStaticRegenerate(path: string, work: fn() -> i32) -> i32;

#[compiler.external(.Erlang("rakun_static_gen:regenerating()"))]
pub declare fn rkStaticRegenerating() -> i32;

#[compiler.external(.Erlang("rakun_static_gen:drain()"))]
pub declare fn rkStaticDrain() -> i32;

#[compiler.external(.Erlang("rakun_static_gen:bump($0)"))]
pub declare fn rkStaticBump(key: string) -> i32;

#[compiler.external(.Erlang("rakun_static_gen:count($0)"))]
pub declare fn rkStaticCount(key: string) -> i32;

#[compiler.external(.Erlang("rakun_static_gen:gauge_enter($0)"))]
pub declare fn rkStaticGaugeEnter(key: string) -> i32;

#[compiler.external(.Erlang("rakun_static_gen:gauge_exit($0)"))]
pub declare fn rkStaticGaugeExit(key: string) -> i32;

#[compiler.external(.Erlang("rakun_static_gen:gauge_max($0)"))]
pub declare fn rkStaticGaugeMax(key: string) -> i32;

#[compiler.external(.Erlang("rakun_static_gen:logged()"))]
pub declare fn rkStaticLogged() -> string[];

#[compiler.external(.Erlang("rakun_static_gen:schedulers()"))]
pub declare fn rkStaticSchedulers() -> i32;

#[compiler.external(.Erlang("rakun_static_gen:ensure_dir($0)"))]
pub declare fn rkStaticEnsureDir(file: string) -> i32;

#[compiler.external(.Erlang("rakun_static_gen:now_ms()"))]
pub declare fn rkStaticNowMs() -> i64;

#[compiler.external(.Erlang("rakun_static_gen:wide($0)"))]
pub declare fn rkStaticWide(n: i32) -> i64;
