//// rakun-app — metadata file routes (front 66): `sitemap.xml`, `robots.txt`,
//// `manifest.webmanifest`, the icon family and the Open Graph / Twitter images.
////
//// Each registration adds ONE `R` entry with verb `GET` to front 22's table
//// through front 25's `registerRoute` — no new kind letter, no new field. The
//// renderers are pure botopink (the sitemap is XML with every value escaped by
//// std's `escape.html`, the manifest JSON is std's writers); only a file's
//// BYTES go through the sidecar (`rakun_metadata_routes.erl`: read, hash).
////
//// RESOLUTION is nearest-ancestor: an image or icon registered at `blog/[slug]`
//// answers for `/blog/hello` and one at the root for everything else.
//// `imagesFor` / `iconsFor` answer DATA — URL, size, content type — and front
//// 32 writes the tags: no HTML is built here.
////
//// URLS CARRY A CONTENT HASH (`?<16 hex of SHA-256>`) of the file's bytes or
//// the rendered body, and the routes answer with a one-year immutable cache.
////
//// THE SITEMAP BOUND is 50 000 URLs and 50 MB per document, not configurable:
//// above it `/sitemap.xml` is the index and `/sitemap/<n>.xml` the shards.
////
//// A dynamic image's body is an opaque `PageRenderer` onze hands in
//// (`setImageRenderer`); without one the route answers 501 naming front 70,
//// and its `ImageMeta` is still produced.

import {escape, path, json.object, json.quote, json.array} from "std";
import {io: {fs}} from "std";
import {Request, rkProp} from "rakun";
import {table: {RouteEntry, parseTable}, match: {attempt}} from "routing";
import {rkAppTable, appDirOf} from "file_router";
import {PageRenderer, chunkWriter, rkSsrBegin, rkSsrBody} from "ssr";
import {HandlerResponse, registerRoute} from "route_handler";

#[@External.Erlang("rakun_metadata_routes", "read")]
declare fn rkMetaRead(file: string) -> string;

#[@External.Erlang("rakun_metadata_routes", "hash")]
declare fn rkMetaHash(file: string) -> string;

#[@External.Erlang("rakun_metadata_routes", "hash_text")]
declare fn rkMetaHashText(text: string) -> string;

#[@External.Erlang("rakun_metadata_routes", "exists")]
declare fn rkMetaExists(file: string) -> bool;

// The registrations, one `persistent_term` list per family.
#[@External.Erlang("""(fun(__K, __V) -> persistent_term:put({rakun_meta, __K}, persistent_term:get({rakun_meta, __K}, []) ++ [__V]), 0 end)($0, $1)""")]
declare fn rkMetaAdd<T>(family: string, value: T) -> i32;

#[@External.Erlang("""persistent_term:get({rakun_meta, $0}, [])""")]
declare fn rkMetaAll<T>(family: string) -> T[];

#[@External.Erlang("""(fun() -> [persistent_term:erase(K) || {{rakun_meta, _} = K, _} <- persistent_term:get()], 0 end)()""")]
declare fn rkMetaReset() -> i32;

#[@External.Erlang("rakun_ssr", "begin_handler")]
declare fn rkMetaBeginHandler() -> i32;

#[@External.Erlang("""(fun(__W) -> __S = erase(rakun_conn_socket), try __W() after case __S of undefined -> ok; _ -> put(rakun_conn_socket, __S) end end end)($0)""")]
declare fn rkMetaHidden<T>(work: fn() -> T) -> T;

pub fn resetMetadataRoutes() -> i32 {
    return rkMetaReset();
}

// A family is claimed only once its value validated, so a refused
// registration leaves nothing behind.
fn notYet(family: string) -> i32 {
    val existing: string[] = rkMetaAll(family);
    if (existing.length > 0) @panic("rakun metadata: a " + family + " is already registered - one application, one " + family);
    return 0;
}

fn immutable(h: HandlerResponse) -> HandlerResponse {
    return h.withHeader("Cache-Control", "public, max-age=31536000, immutable");
}

fn typed(body: string, contentType: string) -> HandlerResponse {
    return HandlerResponse(status: 200, headers: [#("Content-Type", contentType)], chunks: [body], tasks: []);
}

fn noTask(h: HandlerResponse) -> @Task<HandlerResponse> {
    return h;
}

// ── step 1 — sitemap ────────────────────────────────────────────────────────

pub type SitemapEntry(
    loc: string,
    lastModified: string,
    changeFrequency: string,
    priority: string,
)

pub fn changeFrequencies() -> string[] {
    return ["always", "hourly", "daily", "weekly", "monthly", "yearly", "never"];
}

fn priorityOk(p: string) -> bool {
    if (p == "") return true;
    if (p == "1" || p == "1.0" || p == "0" || p == "0.0") return true;
    return p.length() == 3 && p.startsWith("0.") && "0123456789".contains(p.slice(2, 3));
}

pub fn sitemapEntryProblem(e: SitemapEntry) -> string {
    if (e.changeFrequency != "" && changeFrequencies().filter({ f -> f == e.changeFrequency }).length == 0) return "rakun metadata: changeFrequency `" + e.changeFrequency + "` is not one of " + changeFrequencies().join(", ");
    if (priorityOk(e.priority) == false) return "rakun metadata: priority `" + e.priority + "` is not between 0.0 and 1.0 in tenths";
    return "";
}

pub fn maxSitemapUrls() -> i32 {
    return 50000;
}

pub fn maxSitemapBytes() -> i32 {
    return 52428800;
}

fn xmlElement(name: string, value: string) -> string {
    return if (value == "") "" else "<" + name + ">" + escape.html(value) + "</" + name + ">\n";
}

pub fn renderSitemap(entries: SitemapEntry[]) -> string {
    val urls = entries.map({ e -> "<url>\n" + xmlElement("loc", e.loc) + xmlElement("lastmod", e.lastModified) + xmlElement("changefreq", e.changeFrequency) + xmlElement("priority", e.priority) + "</url>\n" }).join("");
    return "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n" + urls + "</urlset>\n";
}

// Shards of at most 50 000 entries whose rendered document stays under 50 MB.
pub fn shardEntries(entries: SitemapEntry[]) -> Array<SitemapEntry[]> {
    var shards: Array<SitemapEntry[]> = [];
    var current: SitemapEntry[] = [];
    var bytes = 0;
    for (entries) { e ->
        val size = renderSitemap([e]).length();
        if (current.length > 0 && (current.length >= maxSitemapUrls() || bytes + size > maxSitemapBytes())) {
            shards.push(current);
            current = [];
            bytes = 0;
        };
        current.push(e);
        bytes = bytes + size;
    };
    if (current.length > 0) shards.push(current);
    return shards;
}

pub fn renderSitemapIndex(shards: i32, origin: string) -> string {
    val items = Array.range(0, shards).map({ i -> "<sitemap>\n" + xmlElement("loc", origin + "/sitemap/" + i.toString() + ".xml") + "</sitemap>\n" }).join("");
    return "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<sitemapindex xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n" + items + "</sitemapindex>\n";
}

#[@External.Erlang("""(fun(__F) -> __F() end)($0)""")]
declare fn rkMetaRunSitemap(produce: fn() -> @Task<SitemapEntry[]>) -> SitemapEntry[];

fn sitemapShards() -> Array<SitemapEntry[]> {
    val producers: Array<fn() -> @Task<SitemapEntry[]>> = rkMetaAll("sitemap-producer");
    var entries: SitemapEntry[] = [];
    for (producers) { p -> for (rkMetaRunSitemap(p)) { e -> entries.push(e); }; };
    return shardEntries(entries);
}

fn sitemapRoot(req: Request) -> @Task<HandlerResponse> {
    val shards = sitemapShards();
    val body = if (shards.length > 1) renderSitemapIndex(shards.length, rkProp("rakun.metadata.origin")) else renderSitemap(shards.at(0) ?? []);
    return typed(body, "application/xml");
}

fn sitemapShard(req: Request) -> @Task<HandlerResponse> {
    val name = req.param("shard");
    val n = if (name.endsWith(".xml")) name.slice(0, name.length() - 4) else "";
    val shards = sitemapShards();
    val index = if (n != "" && n.split("").filter({ c -> "0123456789".contains(c) == false }).length == 0) toIndex(n) else -1;
    if (shards.length < 2 || index < 0 || index >= shards.length) return HandlerResponse.notFound();
    return typed(renderSitemap(shards.at(index) ?? []), "application/xml");
}

fn toIndex(s: string) -> i32 {
    var n = 0;
    for (s.split("")) { c -> n = n * 10 + "0123456789".indexOf(c); };
    return n;
}

pub fn registerSitemap(produce: fn() -> @Task<SitemapEntry[]>) -> i32 {
    val _o = notYet("sitemap");
    for (rkMetaRunSitemap(produce)) { e ->
        val p = sitemapEntryProblem(e);
        if (p != "") @panic(p);
    };
    val _c = rkMetaAdd("sitemap", "sitemap");
    val _p = rkMetaAdd("sitemap-producer", produce);
    val _a = registerRoute("GET", "sitemap.xml", "sitemap", { req -> sitemapRoot(req) });
    val _b = registerRoute("GET", "sitemap/[shard]", "sitemapShard", { req -> sitemapShard(req) });
    return rkMetaAdd("pattern", "/sitemap.xml");
}

// ── step 2 — robots.txt ─────────────────────────────────────────────────────

pub type RobotRule(userAgent: string, allow: string[], disallow: string[])

pub type Robots(rules: Array<RobotRule>, sitemap: string, host: string)

pub fn renderRobots(r: Robots) -> string {
    var lines: string[] = [];
    for (r.rules) { rule ->
        lines.push("User-Agent: " + rule.userAgent);
        for (rule.allow) { a -> lines.push("Allow: " + a); };
        for (rule.disallow) { d -> lines.push("Disallow: " + d); };
        lines.push("");
    };
    if (r.host != "") lines.push("Host: " + r.host);
    if (r.sitemap != "") lines.push("Sitemap: " + r.sitemap);
    return lines.join("\n") + "\n";
}

pub fn robotsProblem(r: Robots) -> string {
    var bad = "";
    for (r.rules) { rule ->
        var values: string[] = [rule.userAgent];
        for (rule.allow) { a -> values.push(a); };
        for (rule.disallow) { d -> values.push(d); };
        for (values) { v -> if (bad == "" && (v.contains("\n") || v.contains("\r"))) bad = v; };
    };
    if (bad == "" && (r.sitemap.contains("\n") || r.host.contains("\n"))) bad = r.sitemap + r.host;
    return if (bad == "") "" else "rakun metadata: a robots value holds a line break - an injected line is an injected rule";
}

#[@External.Erlang("""(fun(__F) -> __F() end)($0)""")]
declare fn rkMetaRunRobots(produce: fn() -> @Task<Robots>) -> Robots;

pub fn registerRobots(produce: fn() -> @Task<Robots>) -> i32 {
    val _o = notYet("robots");
    val p = robotsProblem(rkMetaRunRobots(produce));
    if (p != "") @panic(p);
    val _c = rkMetaAdd("robots", "robots");
    val _a = registerRoute("GET", "robots.txt", "robots", { req -> noTask(typed(renderRobots(rkMetaRunRobots(produce)), "text/plain")) });
    return rkMetaAdd("pattern", "/robots.txt");
}

// ── step 3 — the web manifest ───────────────────────────────────────────────

pub type ManifestIcon(src: string, sizes: string, contentType: string)

pub type WebManifest(
    name: string,
    shortName: string,
    startUrl: string,
    display: string,
    backgroundColor: string,
    themeColor: string,
    icons: Array<ManifestIcon>,
)

pub fn displays() -> string[] {
    return ["fullscreen", "standalone", "minimal-ui", "browser"];
}

pub fn renderManifest(m: WebManifest) -> string {
    val icons = m.icons.map({ i -> object([#("src", quote(i.src)), #("sizes", quote(i.sizes)), #("type", quote(i.contentType))]) });
    return object([
        #("name", quote(m.name)),
        #("short_name", quote(m.shortName)),
        #("start_url", quote(m.startUrl)),
        #("display", quote(m.display)),
        #("background_color", quote(m.backgroundColor)),
        #("theme_color", quote(m.themeColor)),
        #("icons", array(icons)),
    ]);
}

#[@External.Erlang("""(fun(__F) -> __F() end)($0)""")]
declare fn rkMetaRunManifest(produce: fn() -> @Task<WebManifest>) -> WebManifest;

pub fn registerManifest(produce: fn() -> @Task<WebManifest>) -> i32 {
    val _o = notYet("manifest");
    val m = rkMetaRunManifest(produce);
    if (displays().filter({ d -> d == m.display }).length == 0) @panic("rakun metadata: display `" + m.display + "` is not one of " + displays().join(", "));
    val _c = rkMetaAdd("manifest", "manifest");
    val _a = registerRoute("GET", "manifest.webmanifest", "manifest", { req -> noTask(typed(renderManifest(rkMetaRunManifest(produce)), "application/manifest+json")) });
    return rkMetaAdd("pattern", "/manifest.webmanifest");
}

// What front 32 links: `/manifest.webmanifest`, or `""` when none is registered.
pub fn manifestHref() -> string {
    val m: string[] = rkMetaAll("manifest");
    return if (m.length > 0) "/manifest.webmanifest" else "";
}

// ── resolution ──────────────────────────────────────────────────────────────

fn patternOfSeg(seg: string) -> string {
    val trimmed = seg.split("/").filter({ s -> s != "" });
    return "/" + trimmed.join("/");
}

// The concrete ancestor of `pathname` a registration at `pattern` answers
// for, `""` when none: the pathname itself or one of its prefixes.
fn anchorOf(pattern: string, pathname: string) -> string {
    val parts = pathname.split("/").filter({ s -> s != "" });
    var found = "";
    var i = parts.length;
    while (i >= 0) {
        val prefix = "/" + parts.slice(0, i).join("/");
        if (found == "" && attempt(pattern, prefix).ok) found = prefix;
        i = i - 1;
    };
    return found;
}

fn depth(pattern: string) -> i32 {
    return pattern.split("/").filter({ s -> s != "" }).length;
}

fn fileOf(appDir: string, file: string) -> string {
    return appDir + "/" + file;
}

fn checkFile(file: string) -> string {
    val appDir = appDirOf();
    val full = fileOf(appDir, file);
    if (path.isInside(appDir, file) == false) @panic("rakun metadata: `" + file + "` escapes the app directory `" + appDir + "`");
    if (rkMetaExists(full) == false) @panic("rakun metadata: `" + file + "` does not exist under `" + appDir + "`");
    return full;
}

fn baseName(file: string) -> string {
    return file.split("/").at(-1) ?? file;
}

// ── step 4 — the icon family ────────────────────────────────────────────────

pub type IconKind {
    Favicon,
    Icon,
    AppleIcon,
}

pub type IconRef(kind: IconKind, href: string, contentType: string, sizes: string)

pub type IconFile(kind: IconKind, pattern: string, href: string, full: string, contentType: string, sizes: string)

pub fn iconKindName(k: IconKind) -> string {
    val n = case k {
        IconKind.Favicon -> "favicon";
        IconKind.Icon -> "icon";
        IconKind.AppleIcon -> "apple-icon";
    };
    return n;
}

pub fn registerIconFile(kind: IconKind, seg: string, file: string, contentType: string, sizes: string) -> i32 {
    val full = checkFile(file);
    val pattern = patternOfSeg(seg);
    val route = (if (pattern == "/") "" else pattern) + "/" + baseName(file);
    val hashed = if (iconKindName(kind) == "favicon") route else route + "?" + rkMetaHash(full);
    val _r = registerRoute("GET", route, iconKindName(kind), { req -> noTask(serveFile(full, contentType, iconKindName(kind) != "favicon")) });
    val _p = rkMetaAdd("pattern", route);
    return rkMetaAdd("icon", IconFile(kind: kind, pattern: pattern, href: hashed, full: full, contentType: contentType, sizes: sizes));
}

fn serveFile(full: string, contentType: string, cached: bool) -> HandlerResponse {
    val h = typed(rkMetaRead(full), contentType);
    return if (cached) immutable(h) else h;
}

// The nearest registration of each kind at or above `pattern`.
pub fn iconsFor(pattern: string) -> Array<IconRef> {
    val all: IconFile[] = rkMetaAll("icon");
    var out: Array<IconRef> = [];
    for (["favicon", "icon", "apple-icon"]) { k ->
        var best = "";
        var chosen: IconFile[] = [];
        for (all) { f ->
            val applies = iconKindName(f.kind) == k && (f.pattern == "/" || pattern == f.pattern || pattern.startsWith(f.pattern + "/"));
            if (applies && (chosen.length == 0 || depth(f.pattern) > depth(best))) {
                best = f.pattern;
                chosen = [f];
            };
        };
        for (chosen) { f -> out.push(IconRef(kind: f.kind, href: f.href, contentType: f.contentType, sizes: f.sizes)); };
    };
    return out;
}

// ── step 5 — Open Graph and Twitter images ──────────────────────────────────

pub type ImageKind {
    OpenGraph,
    Twitter,
}

pub type ImageRoute(kind: ImageKind, pattern: string, width: i32, height: i32, contentType: string)

pub type ImageMeta(kind: ImageKind, url: string, width: i32, height: i32, contentType: string)

// A registration: the route, and the file (static) or `""` (dynamic).
pub type ImageReg(route: ImageRoute, file: string)

pub fn imageFileName(k: ImageKind) -> string {
    val n = case k {
        ImageKind.OpenGraph -> "opengraph-image";
        ImageKind.Twitter -> "twitter-image";
    };
    return n;
}

fn imageRouteOf(pattern: string, kind: ImageKind) -> string {
    return (if (pattern == "/") "" else pattern) + "/" + imageFileName(kind);
}

#[@External.Erlang("""(fun(__K, __R) -> persistent_term:put({rakun_meta_renderer, __K}, __R), 0 end)($0, $1)""")]
declare fn rkMetaPutRenderer(key: string, render: PageRenderer) -> i32;

#[@External.Erlang("""persistent_term:get({rakun_meta_renderer, $0}, undefined)""")]
declare fn rkMetaRenderer(key: string) -> ?PageRenderer;

fn rendererKey(kind: ImageKind, pattern: string) -> string {
    return imageFileName(kind) + "|" + pattern;
}

pub fn registerImageFile(kind: ImageKind, seg: string, file: string, contentType: string, width: i32, height: i32) -> i32 {
    val full = checkFile(file);
    val pattern = patternOfSeg(seg);
    val route = imageRouteOf(pattern, kind);
    val _r = registerRoute("GET", route, imageFileName(kind), { req -> noTask(serveFile(full, contentType, true)) });
    val _p = rkMetaAdd("pattern", route);
    return rkMetaAdd("image", ImageReg(route: ImageRoute(kind: kind, pattern: pattern, width: width, height: height, contentType: contentType), file: full));
}

pub fn registerImageRoute(kind: ImageKind, seg: string, width: i32, height: i32, contentType: string) -> i32 {
    val pattern = patternOfSeg(seg);
    val route = imageRouteOf(pattern, kind);
    val _r = registerRoute("GET", route, imageFileName(kind), { req -> noTask(serveDynamic(kind, pattern, contentType, req.path)) });
    val _p = rkMetaAdd("pattern", route);
    return rkMetaAdd("image", ImageReg(route: ImageRoute(kind: kind, pattern: pattern, width: width, height: height, contentType: contentType), file: ""));
}

pub fn setImageRenderer(kind: ImageKind, seg: string, render: PageRenderer) -> i32 {
    val pattern = patternOfSeg(seg);
    val regs: ImageReg[] = rkMetaAll("image");
    val known = regs.filter({ r -> imageFileName(r.route.kind) == imageFileName(kind) && r.route.pattern == pattern && r.file == "" }).length > 0;
    if (known == false) @panic("rakun metadata: no dynamic " + imageFileName(kind) + " is registered at `" + pattern + "` - registerImageRoute it first");
    return rkMetaPutRenderer(rendererKey(kind, pattern), render);
}

fn renderedBody(kind: ImageKind, pattern: string, pagePath: string) -> ?string {
    val found: ?PageRenderer = rkMetaRenderer(rendererKey(kind, pattern));
    if (found == null) return null;
    val render: PageRenderer = found ?? { req, out -> noWrite() };
    return rkMetaHidden({ -> renderInto(render, pagePath) });
}

fn noWrite() -> @Task<void> {
    return;
}

fn renderInto(render: PageRenderer, pagePath: string) -> string {
    val _b = rkSsrBegin();
    val _r = render(rkMakeReq(pagePath), chunkWriter());
    val body = rkSsrBody();
    val _h = rkMetaBeginHandler();
    return body;
}

#[@External.Erlang("""rakun_runtime:make_request(<<"GET">>, $0, <<"{}">>, <<"{}">>, <<"{}">>, <<>>)""")]
declare fn rkMakeReq(pathname: string) -> Request;

fn serveDynamic(kind: ImageKind, pattern: string, contentType: string, routePath: string) -> HandlerResponse {
    val pagePath = routePath.slice(0, routePath.length() - imageFileName(kind).length() - 1);
    val body: ?string = renderedBody(kind, pattern, if (pagePath == "") "/" else pagePath);
    if (body == null) return HandlerResponse(status: 501, headers: [#("Content-Type", "text/plain")], chunks: ["rakun metadata: no renderer is set for this " + imageFileName(kind) + " - front 70 (onze-og) renders dynamic images"], tasks: []);
    return immutable(typed(body ?? "", contentType));
}

fn nearestImage(kind: ImageKind, pathname: string) -> ?ImageReg {
    val regs: ImageReg[] = rkMetaAll("image");
    var best: ImageReg[] = [];
    for (regs) { r ->
        val applies = imageFileName(r.route.kind) == imageFileName(kind) && anchorOf(r.route.pattern, pathname) != "";
        val deeper = best.length == 0 || depth(r.route.pattern) > depth((best.at(0) ?? r).route.pattern);
        if (applies && deeper) best = [r];
    };
    if (best.length == 0) return null;
    return best.at(0) ?? null;
}

// The registration answering at `pattern` (a page pattern), nearest ancestor.
pub fn resolveImage(kind: ImageKind, pattern: string) -> ?ImageRoute {
    val regs: ImageReg[] = rkMetaAll("image");
    var best: ImageRoute[] = [];
    for (regs) { r ->
        val p = r.route.pattern;
        val applies = imageFileName(r.route.kind) == imageFileName(kind) && (p == "/" || pattern == p || pattern.startsWith(p + "/"));
        val deeper = best.length == 0 || depth(p) > depth((best.at(0) ?? r.route).pattern);
        if (applies && deeper) best = [r.route];
    };
    if (best.length == 0) return null;
    return best.at(0) ?? null;
}

fn hashOf(reg: ImageReg, pathname: string) -> string {
    if (reg.file != "") return rkMetaHash(reg.file);
    val body: ?string = renderedBody(reg.route.kind, reg.route.pattern, pathname);
    return rkMetaHashText(body ?? "no-renderer");
}

// `/blog/hello/opengraph-image?<hash>` for a page at `/blog/hello`, `null`
// with no registration at any ancestor.
pub fn imageUrlFor(kind: ImageKind, pathname: string) -> ?string {
    val found: ?ImageReg = nearestImage(kind, pathname);
    if (found == null) return null;
    val reg: ImageReg = found ?? ImageReg(route: ImageRoute(kind: kind, pattern: "/", width: 0, height: 0, contentType: ""), file: "");
    val anchor = anchorOf(reg.route.pattern, pathname);
    val base = if (anchor == "/") "" else anchor;
    return base + "/" + imageFileName(kind) + "?" + hashOf(reg, pathname);
}

pub fn imagesFor(pathname: string, pattern: string) -> Array<ImageMeta> {
    var out: Array<ImageMeta> = [];
    for ([ImageKind.OpenGraph, ImageKind.Twitter]) { k ->
        val r: ?ImageRoute = resolveImage(k, patternOfSeg(pattern));
        val url: ?string = imageUrlFor(k, pathname);
        if (r != null && url != null) {
            val route: ImageRoute = r ?? ImageRoute(kind: k, pattern: "", width: 0, height: 0, contentType: "");
            out.push(ImageMeta(kind: k, url: url ?? "", width: route.width, height: route.height, contentType: route.contentType));
        };
    };
    return out;
}

// ── step 6 — the table and the scan ─────────────────────────────────────────

pub fn metadataRoutePatterns() -> string[] {
    return rkMetaAll("pattern");
}

pub fn metadataFileNames() -> string[] {
    return ["favicon", "icon", "apple-icon", "opengraph-image", "twitter-image"];
}

// Every metadata file under `appDir` (relative paths, sorted), none inside a
// `_private` folder.
pub fn scanMetadataFiles(appDir: string) -> string[] {
    var out: string[] = [];
    for (metadataFileNames()) { n ->
        for (["**/" + n + ".*", n + ".*"]) { pattern ->
            val hits: string[] = fs.glob(pattern, appDir).unwrapOr([]);
            for (hits) { f -> if (out.filter({ x -> x == f }).length == 0) out.push(f); };
        };
    };
    return out.filter({ f -> f.split("/").filter({ s -> s.startsWith("_") }).length == 0 });
}

