//// rakun — the page path (front 23): `ChunkWriter`, `PageRenderer`, `page`
//// and `servePage`.
////
//// Every renderer here writes fixed plain-text chunks: the assertions are about
//// dispatch, scope, phase, status and the bytes written — never about markup,
//// which rakun does not build (decision 113). The first half drives the
//// dispatch without a socket (the writer buffers, and the dispatch answers the
//// buffer); the second half over front 04's listener, where the writer streams
//// HTTP/1.1 chunks and a raw client reads them as bytes.

import {testing.asserts, async} from "std";
import {Request, Response, rkSetProp, rkDispatchHttp, rkServe} from "rakun";
import {rkAppReset} from "file_router";
import {
    ChunkWriter,
    PageRenderer,
    page,
    servePage,
    servePages,
    stopServingPages,
    chunkWriter,
    writeTo,
    setStatusOn,
    setHeaderOn,
    closeOut,
    rkSsrBegin,
    rkSsrHeader,
    splitQuery,
    encodeQuery,
} from "ssr";
import {RequestPhase, requestPhase, isDynamic, cookies} from "rakun/request_context";

// ── renderers ───────────────────────────────────────────────────────────────

// Every renderer body is a named fn over a typed `ChunkWriter` and writes
// through `writeTo` / `setStatusOn` / `setHeaderOn` / `closeOut`: a module that
// imports `ChunkWriter` cannot call its function-typed fields directly on the
// erlang backend (a compiler gap, recorded).
fn chunks(parts: string[]) -> PageRenderer {
    return { req, out -> writeAll(out, parts) };
}

fn writeAll(out: ChunkWriter, parts: string[]) -> @Task<void> {
    for (parts) { p ->
        val _w = writeTo(out, p);
    };
}

fn redirecting() -> PageRenderer {
    return { req, out -> redirectBody(out) };
}

fn redirectBody(out: ChunkWriter) -> @Task<void> {
    val _st = setStatusOn(out, 307);
    val _sh = setHeaderOn(out, "location", "/login");
    await closeOut(out);
}

fn ownNotFound() -> PageRenderer {
    return { req, out -> notFoundBody(out) };
}

fn notFoundBody(out: ChunkWriter) -> @Task<void> {
    val _st = setStatusOn(out, 404);
    await writeTo(out, "nothing here");
}

fn lateStatus() -> PageRenderer {
    return { req, out -> lateBody(out) };
}

fn lateBody(out: ChunkWriter) -> @Task<void> {
    await writeTo(out, "first");
    val _st = setStatusOn(out, 500);
}

fn afterClose() -> PageRenderer {
    return { req, out -> afterCloseBody(out) };
}

fn afterCloseBody(out: ChunkWriter) -> @Task<void> {
    await closeOut(out);
    await writeTo(out, "too late");
}

fn phaseProbe() -> PageRenderer {
    return { req, out -> phaseBody(out) };
}

fn phaseBody(out: ChunkWriter) -> @Task<void> {
    val inRender: bool = requestPhase() == RequestPhase.Render;
    await writeTo(out, if (inRender) "render" else "other");
}

fn cookieWriter() -> PageRenderer {
    return { req, out -> cookieBody(out) };
}

fn cookieBody(out: ChunkWriter) -> @Task<void> {
    val _c = setCookieNow();
    await writeTo(out, "unreachable");
}

fn setCookieNow() -> i32 {
    return cookies().set("s", "1");
}

fn navRaiser() -> PageRenderer {
    return { req, out -> navBody(out) };
}

fn navBody(out: ChunkWriter) -> @Task<void> {
    val _n = raiseNav();
    await writeTo(out, "unreachable");
}

#[@External.Erlang("""erlang:error({nav, <<"nav:not-found">>})""")]
declare fn raiseNav() -> i32;

fn paramsEcho() -> PageRenderer {
    return { req, out -> paramsBody(req, out) };
}

fn paramsBody(req: Request, out: ChunkWriter) -> @Task<void> {
    await writeTo(out, req.param("slug") + "|" + req.query("tab"));
}

fn slowSecond() -> PageRenderer {
    return { req, out -> slowBody(out) };
}

fn slowBody(out: ChunkWriter) -> @Task<void> {
    await writeTo(out, "shell;");
    val _s = sleepMs(400);
    await writeTo(out, "tail");
}

fn plainText() -> PageRenderer {
    return { req, out -> plainBody(out) };
}

fn plainBody(out: ChunkWriter) -> @Task<void> {
    val _sh = setHeaderOn(out, "content-type", "text/plain");
    await writeTo(out, "x");
}

#[@External.Erlang("rakun_request_context", "sleep")]
declare fn sleepMs(ms: i32) -> i32;

fn fresh() -> i32 {
    val _r = rkAppReset();
    return servePages();
}

fn get(path: string) -> Response {
    return rkDispatchHttp("GET", path, "{}", "{}", "");
}

// ── step 1 and step 2, without a socket ─────────────────────────────────────

test "rakun ssr: a URL with no page answers 404 and no renderer runs" {
    val _f = fresh();
    val _p = page("", chunks(["home"]));
    val res: Response = get("/missing");
    assert res.status == 404;
    assert res.body == "";
}

test "rakun ssr: a page's chunks are the body, in the order written" {
    val _f = fresh();
    val _p = page("docs", chunks(["a", "b", "c"]));
    val res: Response = get("/docs");
    assert res.status == 200;
    assert res.body == "abc";
}

test "rakun ssr: a second page for one pattern is refused naming it" {
    val _f = fresh();
    val _p = page("docs", chunks(["a"]));
    try asserts.throwsWith({ ->
        val _q = page("docs", chunks(["b"]));
        0;
    }, "a page is already registered for `/docs`");
}

test "rakun ssr: a renderer's own 307 with location and no body" {
    val _f = fresh();
    val _p = page("private", redirecting());
    val res: Response = get("/private");
    assert res.status == 307;
    assert res.body == "";
    assert rkSsrHeader("location") == "/login";
}

test "rakun ssr: a renderer's own 404 with a body" {
    val _f = fresh();
    val _p = page("gone", ownNotFound());
    val res: Response = get("/gone");
    assert res.status == 404;
    assert res.body == "nothing here";
}

test "rakun ssr: setStatus after the first write fails the request and the status stays" {
    val _f = fresh();
    val _p = page("late", lateStatus());
    val res: Response = get("/late");
    assert res.status == 200;
    assert res.body == "first";
}

test "rakun ssr: a call on the writer after close fails the request, and it is closed once" {
    val _f = fresh();
    val _p = page("closed", afterClose());
    val res: Response = get("/closed");
    assert res.status == 200;
    assert res.body == "";
}

test "rakun ssr: a raised navigation reason is a failed render, 500 - not 404" {
    val _f = fresh();
    val _p = page("nav", navRaiser());
    val res: Response = get("/nav");
    assert res.status == 500;
}

test "rakun ssr: the render runs in phase Render, where a cookie write raises" {
    val _f = fresh();
    val _p = page("phase", phaseProbe());
    val _c = page("cookie", cookieWriter());
    assert get("/phase").body == "render";
    assert get("/cookie").status == 500;
}

test "rakun ssr: the renderer reads the pattern's params and the query, and the query read marks the render dynamic" {
    val _f = fresh();
    val _p = page("blog/[slug]", paramsEcho());
    val res: Response = rkDispatchHttp("GET", "/blog/hello", "{}", "{\"tab\":\"comments\"}", "");
    assert res.body == "hello|comments";
}

test "rakun ssr: a strict render raises on a query read instead of marking it" {
    val _f = fresh();
    val _p = page("blog/[slug]", paramsEcho());
    val _s = rkSetProp("rakun.render.strict", "true");
    val res: Response = rkDispatchHttp("GET", "/blog/hello", "{}", "{\"tab\":\"x\"}", "");
    val _u = rkSetProp("rakun.render.strict", "");
    assert res.status == 500;
}

// ── step 3, over the socket ─────────────────────────────────────────────────

// One raw exchange: the head and the chunked body, as bytes, plus how long the
// first body chunk took to arrive and how long the whole response took.
#[@External.Erlang("""(fun(__Port, __Path) -> {ok, __S} = gen_tcp:connect("127.0.0.1", __Port, [binary, {active, false}]), __T0 = erlang:monotonic_time(millisecond), ok = gen_tcp:send(__S, [<<"GET ">>, __Path, <<" HTTP/1.1", 13, 10, "Host: x", 13, 10, 13, 10>>]), __Loop = fun __Loop(__Acc, __First) -> case binary:match(__Acc, <<"0", 13, 10, 13, 10>>) of nomatch -> case gen_tcp:recv(__S, 0, 3000) of {ok, __M} -> __F2 = case {__First, binary:match(<<__Acc/binary, __M/binary>>, <<"shell;">>)} of {undefined, {_, _}} -> erlang:monotonic_time(millisecond) - __T0; _ -> __First end, __Loop(<<__Acc/binary, __M/binary>>, __F2); _ -> {__Acc, __First} end; _ -> {__Acc, __First} end end, {__All, __FirstAt} = __Loop(<<>>, undefined), __Total = erlang:monotonic_time(millisecond) - __T0, gen_tcp:close(__S), iolist_to_binary([__All, <<"|first=">>, integer_to_binary(case __FirstAt of undefined -> -1; __X -> __X end), <<"|total=">>, integer_to_binary(__Total)]) end)($0, $1)""")]
declare fn rawGet(port: i32, path: string) -> string;

fn start() -> i32 {
    val _k = rkSetProp("rakun.main.keep-alive", "false");
    return rkServe(0, { m, p, h, q, b -> rkDispatchHttp(m, p, h, q, b) });
}

test "rakun ssr: over the socket the chunks arrive in order, byte for byte, with the default head" {
    val _f = fresh();
    val _p = page("docs", chunks(["<p>a</p>", "<p>b</p>"]));
    val raw: string = rawGet(start(), "/docs");
    assert raw.startsWith("HTTP/1.1 200 OK\r\nContent-Type: text/html; charset=utf-8\r\nTransfer-Encoding: chunked\r\n");
    assert raw.contains("\r\n\r\n8\r\n<p>a</p>\r\n8\r\n<p>b</p>\r\n0\r\n\r\n");
}

test "rakun ssr: a header the renderer set replaces the default by name" {
    val _f = fresh();
    val _p = page("plain", plainText());
    val raw: string = rawGet(start(), "/plain");
    assert raw.contains("content-type: text/plain\r\n");
    assert raw.contains("text/html") == false;
}

test "rakun ssr: the first chunk reaches the socket before the second is written" {
    val _f = fresh();
    val _p = page("stream", slowSecond());
    val raw: string = rawGet(start(), "/stream");
    val afterFirst: string = raw.split("|first=").at(1) ?? "-1";
    val first: i32 = toInt(afterFirst.split("|").at(0) ?? "-1");
    val total: i32 = toInt(raw.split("|total=").at(1) ?? "-1");
    val _s = stopServingPages();
    assert first >= 0;
    assert total - first >= 300;
}

#[@External.Erlang("""binary_to_integer($0)""")]
declare fn toInt(s: string) -> i32;

// ── the query codec ─────────────────────────────────────────────────────────

test "rakun ssr: splitQuery / encodeQuery percent-code, which std's querystring does not" {
    val pairs = splitQuery("?a=%20b&c=d=e&flag");
    assert pairs.length == 3;
    assert pairs.map({ p -> p._0 + "=" + p._1 }).join("&") == "a= b&c=d=e&flag=";
    assert encodeQuery([#("a b", "c;d")]) == "a%20b=c%3Bd";
}
