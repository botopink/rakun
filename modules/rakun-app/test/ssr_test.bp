//// rakun — the page path (front 23): `ChunkWriter`, `PageRenderer`, `page`
//// and `servePage`.
////
//// Every renderer here writes fixed plain-text chunks: the assertions are about
//// dispatch, scope, phase, status and the bytes written — never about markup,
//// which rakun does not build (decision 113). The first half drives the
//// dispatch without a socket (the writer buffers, and the dispatch answers the
//// buffer); the second half over front 04's listener, where the writer streams
//// HTTP/1.1 chunks and a raw client reads them as bytes.

import {testing.asserts, async, async.Gate, collections.Dict} from "std";
import {Request, Response, rkSetProp, rkDispatchHttp, rkServe} from "rakun";
import {rkAppReset} from "file_router";
import {
    ChunkWriter,
    PageRenderer,
    page,
    servePage,
    servePages,
    stopServingPages,
    chunkWriter,
    writeTo,
    setStatusOn,
    setHeaderOn,
    closeOut,
    rkSsrBegin,
    rkSsrHeader,
    queryDict,
    renderErrorProblem,
} from "ssr";
import {RequestPhase, requestPhase, isDynamic, cookies, cookieDefaults} from "rakun/request_context";

// ── renderers ───────────────────────────────────────────────────────────────

// Every renderer body is a named fn over a typed `ChunkWriter` and writes
// through `writeTo` / `setStatusOn` / `setHeaderOn` / `closeOut`: a module that
// imports `ChunkWriter` cannot call its function-typed fields directly on the
// erlang backend (a compiler gap, recorded).
fn chunks(parts: string[]) -> PageRenderer {
    return { req, out -> writeAll(out, parts) };
}

fn writeAll(out: ChunkWriter, parts: string[]) -> @Task<@Result<void, string>> {
    for (parts) { p ->
        val _w = writeTo(out, p);
    };
    return;
}

fn redirecting() -> PageRenderer {
    return { req, out -> redirectBody(out) };
}

fn redirectBody(out: ChunkWriter) -> @Task<@Result<void, string>> {
    val _st = setStatusOn(out, 307);
    val _sh = setHeaderOn(out, "location", "/login");
    await closeOut(out);
    return;
}

fn ownNotFound() -> PageRenderer {
    return { req, out -> notFoundBody(out) };
}

fn notFoundBody(out: ChunkWriter) -> @Task<@Result<void, string>> {
    val _st = setStatusOn(out, 404);
    await writeTo(out, "nothing here");
    return;
}

fn lateStatus() -> PageRenderer {
    return { req, out -> lateBody(out) };
}

fn lateBody(out: ChunkWriter) -> @Task<@Result<void, string>> {
    await writeTo(out, "first");
    val _st = setStatusOn(out, 500);
    return;
}

fn afterClose() -> PageRenderer {
    return { req, out -> afterCloseBody(out) };
}

fn afterCloseBody(out: ChunkWriter) -> @Task<@Result<void, string>> {
    await closeOut(out);
    await writeTo(out, "too late");
    return;
}

fn phaseProbe() -> PageRenderer {
    return { req, out -> phaseBody(out) };
}

fn phaseBody(out: ChunkWriter) -> @Task<@Result<void, string>> {
    val inRender: bool = requestPhase() == RequestPhase.Render;
    await writeTo(out, if (inRender) "render" else "other");
    return;
}

fn cookieWriter() -> PageRenderer {
    return { req, out -> cookieBody(out) };
}

fn cookieBody(out: ChunkWriter) -> @Task<@Result<void, string>> {
    val _c = setCookieNow();
    await writeTo(out, "unreachable");
    return;
}

fn setCookieNow() -> i32 {
    return cookies().set("s", "1", cookieDefaults());
}

fn navRaiser() -> PageRenderer {
    return { req, out -> navBody(out) };
}

fn navBody(out: ChunkWriter) -> @Task<@Result<void, string>> {
    val _n = raiseNav();
    await writeTo(out, "unreachable");
    return;
}

#[@External.Erlang("""erlang:error({nav, <<"nav:not-found">>})""")]
declare fn raiseNav() -> i32;

fn erroring() -> PageRenderer {
    return { req, out -> erroringBody(out) };
}

fn erroringBody(out: ChunkWriter) -> @Task<@Result<void, string>> {
    throw "the post store is down: secret-dsn";
}

fn lateErroring() -> PageRenderer {
    return { req, out -> lateErroringBody(out) };
}

fn lateErroringBody(out: ChunkWriter) -> @Task<@Result<void, string>> {
    await writeTo(out, "shell");
    throw "the tail is down: secret-dsn";
}

fn paramsEcho() -> PageRenderer {
    return { req, out -> paramsBody(req, out) };
}

fn paramsBody(req: Request, out: ChunkWriter) -> @Task<@Result<void, string>> {
    await writeTo(out, req.param("slug") + "|" + req.query("tab"));
    return;
}

// Writes the second chunk only once `released` opens — which the test does
// after its client has READ the first one off the socket. A renderer whose
// first chunk sat in a buffer would leave the client waiting, the gate shut,
// and write "never-released" after the gate's budget.
fn slowSecond(released: Gate) -> PageRenderer {
    return { req, out -> slowBody(out, released) };
}

fn slowBody(out: ChunkWriter, released: Gate) -> @Task<@Result<void, string>> {
    await writeTo(out, "shell;");
    val opened = await async.awaitGate(released, 10000);
    await writeTo(out, if (opened) "tail" else "never-released");
    return;
}

fn plainText() -> PageRenderer {
    return { req, out -> plainBody(out) };
}

fn plainBody(out: ChunkWriter) -> @Task<@Result<void, string>> {
    val _sh = setHeaderOn(out, "content-type", "text/plain");
    await writeTo(out, "x");
    return;
}

fn fresh() -> i32 {
    val _r = rkAppReset();
    return servePages();
}

fn get(path: string) -> Response {
    return rkDispatchHttp("GET", path, "{}", "{}", "");
}

// ── step 1 and step 2, without a socket ─────────────────────────────────────

test "rakun ssr: a URL with no page answers 404 and no renderer runs" {
    val _f = fresh();
    val _p = page("", chunks(["home"]));
    val res: Response = get("/missing");
    assert res.status == 404;
    assert res.body == "";
}

test "rakun ssr: a page's chunks are the body, in the order written" {
    val _f = fresh();
    val _p = page("docs", chunks(["a", "b", "c"]));
    val res: Response = get("/docs");
    assert res.status == 200;
    assert res.body == "abc";
}

test "rakun ssr: a second page for one pattern is refused naming it" {
    val _f = fresh();
    val _p = page("docs", chunks(["a"]));
    try asserts.throwsWith({ ->
        val _q = page("docs", chunks(["b"]));
        0;
    }, "a page is already registered for `/docs`");
}

test "rakun ssr: a renderer's own 307 with location and no body" {
    val _f = fresh();
    val _p = page("private", redirecting());
    val res: Response = get("/private");
    assert res.status == 307;
    assert res.body == "";
    assert rkSsrHeader("location") == "/login";
}

test "rakun ssr: a renderer's own 404 with a body" {
    val _f = fresh();
    val _p = page("gone", ownNotFound());
    val res: Response = get("/gone");
    assert res.status == 404;
    assert res.body == "nothing here";
}

test "rakun ssr: setStatus after the first write fails the request and the status stays" {
    val _f = fresh();
    val _p = page("late", lateStatus());
    val res: Response = get("/late");
    assert res.status == 200;
    assert res.body == "first";
}

test "rakun ssr: a call on the writer after close fails the request, and it is closed once" {
    val _f = fresh();
    val _p = page("closed", afterClose());
    val res: Response = get("/closed");
    assert res.status == 200;
    assert res.body == "";
}

test "rakun ssr: a raised navigation reason is a failed render, 500 - not 404" {
    val _f = fresh();
    val _p = page("nav", navRaiser());
    val res: Response = get("/nav");
    assert res.status == 500;
}

test "rakun ssr: a renderer's Error before the first chunk is a 500, its message never on the wire" {
    val _f = fresh();
    val _p = page("erroring", erroring());
    val res: Response = get("/erroring");
    assert res.status == 500;
    assert res.body.contains("secret-dsn") == false;
    assert res.body.contains("post store") == false;
}

test "rakun ssr: a renderer's Error after the first chunk closes the response it began" {
    val _f = fresh();
    val _p = page("late-error", lateErroring());
    val res: Response = get("/late-error");
    assert res.status == 200;
    assert res.body == "shell";
}

test "rakun ssr: the Error text names the renderer's message for the log" {
    assert renderErrorProblem("boom") == "rakun ssr: the page renderer answered Error: boom";
}

test "rakun ssr: the render runs in phase Render, where a cookie write raises" {
    val _f = fresh();
    val _p = page("phase", phaseProbe());
    val _c = page("cookie", cookieWriter());
    assert get("/phase").body == "render";
    assert get("/cookie").status == 500;
}

test "rakun ssr: the renderer reads the pattern's params and the query, and the query read marks the render dynamic" {
    val _f = fresh();
    val _p = page("blog/[slug]", paramsEcho());
    val res: Response = rkDispatchHttp("GET", "/blog/hello", "{}", "{\"tab\":\"comments\"}", "");
    assert res.body == "hello|comments";
}

test "rakun ssr: a strict render raises on a query read instead of marking it" {
    val _f = fresh();
    val _p = page("blog/[slug]", paramsEcho());
    val _s = rkSetProp("rakun.render.strict", "true");
    val res: Response = rkDispatchHttp("GET", "/blog/hello", "{}", "{\"tab\":\"x\"}", "");
    val _u = rkSetProp("rakun.render.strict", "");
    assert res.status == 500;
}

// ── step 3, over the socket ─────────────────────────────────────────────────

// One raw exchange: the head and the chunked body, as bytes.
#[@External.Erlang("""(fun(__Port, __Path) -> {ok, __S} = gen_tcp:connect("127.0.0.1", __Port, [binary, {active, false}]), ok = gen_tcp:send(__S, [<<"GET ">>, __Path, <<" HTTP/1.1", 13, 10, "Host: x", 13, 10, 13, 10>>]), __Loop = fun __Loop(__Acc) -> case binary:match(__Acc, <<"0", 13, 10, 13, 10>>) of nomatch -> case gen_tcp:recv(__S, 0, 10000) of {ok, __M} -> __Loop(<<__Acc/binary, __M/binary>>); _ -> __Acc end; _ -> __Acc end end, __All = __Loop(<<>>), gen_tcp:close(__S), __All end)($0, $1)""")]
declare fn rawGet(port: i32, path: string) -> string;

// The first half of a raw exchange: connect, send the request, and read until
// `marker` has arrived (or the socket stays quiet for ten seconds). Answers the
// open connection and the bytes read so far, for `rawRest`.
#[@External.Erlang("""(fun(__Port, __Path, __Marker) -> {ok, __S} = gen_tcp:connect("127.0.0.1", __Port, [binary, {active, false}]), ok = gen_tcp:send(__S, [<<"GET ">>, __Path, <<" HTTP/1.1", 13, 10, "Host: x", 13, 10, 13, 10>>]), __Loop = fun __Loop(__Acc) -> case binary:match(__Acc, __Marker) of nomatch -> case gen_tcp:recv(__S, 0, 10000) of {ok, __M} -> __Loop(<<__Acc/binary, __M/binary>>); _ -> __Acc end; _ -> __Acc end end, {__S, __Loop(<<>>)} end)($0, $1, $2)""")]
declare fn rawUntil(port: i32, path: string, marker: string) -> any;

// Whether the bytes `rawUntil` read already hold `marker`.
#[@External.Erlang("""(binary:match(element(2, $0), $1) =/= nomatch)""")]
declare fn rawSaw(conn: any, marker: string) -> bool;

// The rest of the exchange `rawUntil` started, to the last chunk: every byte
// read, the first half included.
#[@External.Erlang("""(fun({__S, __Acc0}) -> __Loop = fun __Loop(__Acc) -> case binary:match(__Acc, <<"0", 13, 10, 13, 10>>) of nomatch -> case gen_tcp:recv(__S, 0, 10000) of {ok, __M} -> __Loop(<<__Acc/binary, __M/binary>>); _ -> __Acc end; _ -> __Acc end end, __All = __Loop(__Acc0), gen_tcp:close(__S), __All end)($0)""")]
declare fn rawRest(conn: any) -> string;

fn start() -> i32 {
    val _k = rkSetProp("rakun.main.keep-alive", "false");
    return rkServe(0, { m, p, h, q, b -> rkDispatchHttp(m, p, h, q, b) });
}

test "rakun ssr: over the socket the chunks arrive in order, byte for byte, with the default head" {
    val _f = fresh();
    val _p = page("docs", chunks(["<p>a</p>", "<p>b</p>"]));
    val raw: string = rawGet(start(), "/docs");
    assert raw.startsWith("HTTP/1.1 200 OK\r\nContent-Type: text/html; charset=utf-8\r\nTransfer-Encoding: chunked\r\n");
    assert raw.contains("\r\n\r\n8\r\n<p>a</p>\r\n8\r\n<p>b</p>\r\n0\r\n\r\n");
}

test "rakun ssr: a header the renderer set replaces the default by name" {
    val _f = fresh();
    val _p = page("plain", plainText());
    val raw: string = rawGet(start(), "/plain");
    assert raw.contains("content-type: text/plain\r\n");
    assert raw.contains("text/html") == false;
}

test "rakun ssr: the first chunk reaches the socket before the second is written" {
    val _f = fresh();
    val released = async.newGate();
    val _p = page("stream", slowSecond(released));
    val conn = rawUntil(start(), "/stream", "shell;");
    // The client holds the first chunk while the renderer is still waiting to
    // write the second.
    val sawFirst: bool = rawSaw(conn, "shell;");
    val sawSecond: bool = rawSaw(conn, "tail");
    async.openGate(released);
    val raw: string = rawRest(conn);
    val _s = stopServingPages();
    assert sawFirst;
    assert sawSecond == false;
    assert raw.contains("shell;");
    assert raw.contains("tail");
    assert raw.contains("never-released") == false;
}

// ── the query codec ─────────────────────────────────────────────────────────

fn queryProblem(query: string) -> string {
    return case queryDict(query) {
        Ok(_d) -> "";
        Error(e) -> e;
    };
}

test "rakun ssr: the query dict is std's querystring, first `=` splits, last duplicate wins" {
    val d = queryDict("?a=%20b&c=d=e&flag&a=2").unwrapOr(Dict.empty());
    assert d.size() == 3;
    assert (d.at("a") ?? "?") == "2";
    assert (d.at("c") ?? "?") == "d=e";
    assert (d.at("flag") ?? "?") == "";
    assert (queryDict("x=a+b").unwrapOr(Dict.empty()).at("x") ?? "?") == "a+b";
}

test "rakun ssr: a malformed query component is refused, never kept as written" {
    assert queryProblem("a=%zz") == "querystring.parse: a `%` not followed by two hex digits";
    assert queryProblem("a=100%") == "querystring.parse: a `%` not followed by two hex digits";
    assert queryProblem("a=%0A") == "querystring.parse: an escape that decodes to a control character";
    assert queryProblem("a=%C3") == "querystring.parse: an escape sequence that is not UTF-8";
    assert queryProblem("a=%7E") == "";
}
