//// rakun-app — static generation (front 60 steps 2–5, 7). Step 6's codec is
//// `routing`'s and asserted there on both targets; `routeKinds()` is here.

import {testing.asserts} from "std";
import {io.fs, io.env} from "std";
import {Request, rkSetProp, rkProp, beginRequest, endRequest, RequestScope, RequestPhase, rkReqPutSlot, cookies} from "rakun";
import {file_router.rkAppReset, file_router.rkAppRegisterPage, route_handler.registerRoute};
import {ssr.PageRenderer, ssr.ChunkWriter, ssr.writeTo};

fn textBody(out: ChunkWriter, text: string) -> @Task<@Result<void, string>> {
    await writeTo(out, text);
    return;
}

import {route_kinds.RouteKind, route_kinds.routeKindOf} from "routing";
import {CacheScope, cachePolicy, cacheLifeOf, cachePeek, revalidateTag} from "rakun-cache/cache";
import {segment_config.SegmentConfig, segment_config.DynamicMode, segment_config.FetchCache, segment_config.defaultSegmentConfig, segment_config.registerSegmentConfig};
import {static_gen.KindDecision, static_gen.decideKind, static_gen.kindLetter, static_gen.ParamBinding, static_gen.StaticParams, static_gen.registerStaticParams, static_gen.expandParams, static_gen.PrerenderEntry, static_gen.PrerenderReport, static_gen.prerenderAll, static_gen.prerenderPath, static_gen.lookupPrerendered, static_gen.serveStatic, static_gen.isStale, static_gen.regenerate, static_gen.regenerationFailures, static_gen.routeKinds, static_gen.staticExport, static_gen.exportFileOf, static_gen.payloadFileName, static_gen.prerenderPolicy};
import {static_host.rkStaticReset, static_host.rkStaticBump, static_host.rkStaticCount, static_host.rkStaticGaugeEnter, static_host.rkStaticGaugeExit, static_host.rkStaticGaugeMax, static_host.rkStaticDrain, static_host.rkStaticRunBounded, static_host.rkStaticNowMs};

#[@External.Erlang("""(fun(__Ms) -> receive after __Ms -> 0 end end)($0)""")]
declare fn sleepMs(ms: i32) -> i32;

// ── renderers ───────────────────────────────────────────────────────────────

fn textPage(label: string) -> PageRenderer {
    return { req, out -> textBody(out, label) };
}

fn propPage(key: string) -> PageRenderer {
    return { req, out -> propBody(out, key) };
}

fn propBody(out: ChunkWriter, key: string) -> @Task<@Result<void, string>> {
    val _c = rkStaticBump("renders:" + key);
    if (rkProp(key + ".fail") == "1") @panic("regeneration failed on purpose");
    val slow = rkProp(key + ".slow");
    val _s = if (slow != "") sleepMs(3000) else 0;
    await writeTo(out, "v=" + rkProp(key));
    return;
}

fn cookiePage() -> PageRenderer {
    return { req, out -> cookieBody(out) };
}

fn cookieBody(out: ChunkWriter) -> @Task<@Result<void, string>> {
    val c = cookies().get("session");
    await writeTo(out, "session");
    return;
}

fn sleepyPage(ms: i32) -> PageRenderer {
    return { req, out -> sleepyBody(out, ms) };
}

fn sleepyBody(out: ChunkWriter, ms: i32) -> @Task<@Result<void, string>> {
    val _g = rkStaticGaugeEnter("renders");
    val _s = sleepMs(ms);
    val _x = rkStaticGaugeExit("renders");
    await writeTo(out, "slept");
    return;
}

fn fresh() -> i32 {
    val _r = rkAppReset();
    val _s = rkStaticReset();
    val _t = rkSetProp("rakun.cache.type", "");
    return rkSetProp("rakun.static.concurrency", "");
}

fn tmpRoot() -> string {
    val dir: string = env.read("BOTOPINK_TEST_TMPDIR") ?? "";
    if (dir == "")
        @panic(
            "BOTOPINK_TEST_TMPDIR is not set - botopink test sets it, and a test writes nowhere else",
        );
    return dir;
}

fn row(name: string, value: string) -> StaticParams {
    return StaticParams(bindings: [ParamBinding(name: name, value: value)]);
}

fn cfg(
    mode: DynamicMode,
    dynamicParams: bool,
    revalidate: i32,
) -> SegmentConfig {
    return SegmentConfig(
        dynamic: mode,
        dynamicParams: dynamicParams,
        revalidate: revalidate,
        fetchCache: FetchCache.Auto,
    );
}

// ── step 2 — the truth table ────────────────────────────────────────────────

fn modeOf(name: string) -> DynamicMode {
    if (name == "ForceStatic") return DynamicMode.ForceStatic;
    if (name == "ForceDynamic") return DynamicMode.ForceDynamic;
    if (name == "ErrorOnDynamic") return DynamicMode.ErrorOnDynamic;
    return DynamicMode.Auto;
}

fn holds(line: string) -> bool {
    val f = line.split("|");
    val mode: string = f.at(0) ?? "";
    val dp: string = f.at(1) ?? "";
    val hp: string = f.at(2) ?? "";
    val pd: string = f.at(3) ?? "";
    val td: string = f.at(4) ?? "";
    val k: string = f.at(5) ?? "";
    val r: string = f.at(6) ?? "";
    val d: KindDecision = decideKind(
        cfg(modeOf(mode), dp == "true", -1),
        hp == "true",
        pd == "true",
        td == "true",
        "cookies",
    );
    return kindLetter(d.kind) == k && d.reason == r;
}

test "static: the decision's full truth table, every row" {
    val table = [
        "Auto|true|true|true|true|D|cookies",
        "Auto|true|true|true|false|S|",
        "Auto|true|true|false|true|D|cookies",
        "Auto|true|true|false|false|S|",
        "Auto|true|false|true|true|D|dynamic segment without generateStaticParams",
        "Auto|true|false|true|false|D|dynamic segment without generateStaticParams",
        "Auto|true|false|false|true|D|cookies",
        "Auto|true|false|false|false|S|",
        "Auto|false|true|true|true|D|cookies",
        "Auto|false|true|true|false|S|",
        "Auto|false|true|false|true|D|cookies",
        "Auto|false|true|false|false|S|",
        "Auto|false|false|true|true|S|dynamicParams false: no path is enumerated",
        "Auto|false|false|true|false|S|dynamicParams false: no path is enumerated",
        "Auto|false|false|false|true|D|cookies",
        "Auto|false|false|false|false|S|",
        "ForceStatic|true|true|true|true|S|force-static over cookies",
        "ForceStatic|true|true|true|false|S|force-static",
        "ForceStatic|true|true|false|true|S|force-static over cookies",
        "ForceStatic|true|true|false|false|S|force-static",
        "ForceStatic|true|false|true|true|S|force-static over cookies",
        "ForceStatic|true|false|true|false|S|force-static",
        "ForceStatic|true|false|false|true|S|force-static over cookies",
        "ForceStatic|true|false|false|false|S|force-static",
        "ForceStatic|false|true|true|true|S|force-static over cookies",
        "ForceStatic|false|true|true|false|S|force-static",
        "ForceStatic|false|true|false|true|S|force-static over cookies",
        "ForceStatic|false|true|false|false|S|force-static",
        "ForceStatic|false|false|true|true|S|force-static over cookies",
        "ForceStatic|false|false|true|false|S|force-static",
        "ForceStatic|false|false|false|true|S|force-static over cookies",
        "ForceStatic|false|false|false|false|S|force-static",
        "ForceDynamic|true|true|true|true|D|force-dynamic",
        "ForceDynamic|true|true|true|false|D|force-dynamic",
        "ForceDynamic|true|true|false|true|D|force-dynamic",
        "ForceDynamic|true|true|false|false|D|force-dynamic",
        "ForceDynamic|true|false|true|true|D|force-dynamic",
        "ForceDynamic|true|false|true|false|D|force-dynamic",
        "ForceDynamic|true|false|false|true|D|force-dynamic",
        "ForceDynamic|true|false|false|false|D|force-dynamic",
        "ForceDynamic|false|true|true|true|D|force-dynamic",
        "ForceDynamic|false|true|true|false|D|force-dynamic",
        "ForceDynamic|false|true|false|true|D|force-dynamic",
        "ForceDynamic|false|true|false|false|D|force-dynamic",
        "ForceDynamic|false|false|true|true|D|force-dynamic",
        "ForceDynamic|false|false|true|false|D|force-dynamic",
        "ForceDynamic|false|false|false|true|D|force-dynamic",
        "ForceDynamic|false|false|false|false|D|force-dynamic",
        "ErrorOnDynamic|true|true|true|true|S|force-static over cookies",
        "ErrorOnDynamic|true|true|true|false|S|force-static",
        "ErrorOnDynamic|true|true|false|true|S|force-static over cookies",
        "ErrorOnDynamic|true|true|false|false|S|force-static",
        "ErrorOnDynamic|true|false|true|true|S|force-static over cookies",
        "ErrorOnDynamic|true|false|true|false|S|force-static",
        "ErrorOnDynamic|true|false|false|true|S|force-static over cookies",
        "ErrorOnDynamic|true|false|false|false|S|force-static",
        "ErrorOnDynamic|false|true|true|true|S|force-static over cookies",
        "ErrorOnDynamic|false|true|true|false|S|force-static",
        "ErrorOnDynamic|false|true|false|true|S|force-static over cookies",
        "ErrorOnDynamic|false|true|false|false|S|force-static",
        "ErrorOnDynamic|false|false|true|true|S|force-static over cookies",
        "ErrorOnDynamic|false|false|true|false|S|force-static",
        "ErrorOnDynamic|false|false|false|true|S|force-static over cookies",
        "ErrorOnDynamic|false|false|false|false|S|force-static",
    ];
    assert table.length == 64;
    for (table) { line ->
