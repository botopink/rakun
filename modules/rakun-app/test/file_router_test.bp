//// rakun — the file-convention registry (front 22 steps 2 and 6): table
//// records and opaque page renderers.
////
//// A page is registered the way the orchestrator registers one — a renderer
//// that writes plain text through a `ChunkWriter` (front 23) — and a UI record
//// the way the orchestrator copies one in. Nothing here names an element: the
//// registry holds a renderer it never calls.

import {testing.asserts} from "std";
import {Request} from "rakun";
import {
    rkAppRegisterEntry,
    rkAppRegisterPage,
    rkAppRegisterHandler,
    rkAppTable,
    rkAppCount,
    rkAppHasRender,
    rkAppReset,
    entryLine,
    appTable,
    unknownKindProblem,
    duplicatePageProblem,
} from "file_router";
import {ChunkWriter, PageRenderer, matchPage, writeTo} from "ssr";
import {match.matchPath} from "routing";

fn textPage(label: string) -> PageRenderer {
    return { req, out -> writeText(out, label) };
}

// The body as a named fn writing through `writeTo`: a module that imports
// `ChunkWriter` cannot call its function-typed fields directly on the erlang
// backend (a compiler gap, recorded).
fn writeText(out: ChunkWriter, label: string) -> @Task<void> {
    await writeTo(out, label);
}

fn noop(req: Request) -> string {
    return "";
}

test "rakun routing: an entry becomes one line of the host table" {
    val _r = rkAppReset();
    val _a = rkAppRegisterEntry("L", "blog", "");
    assert rkAppTable() == "L|/blog";
    val _b = rkAppRegisterEntry("L", "", "");
    assert rkAppTable() == "L|/blog\nL|/";
    val _c = rkAppRegisterEntry("S", "dashboard/@team", "");
    assert rkAppTable().endsWith("\nS|/dashboard|team");
    val _z = rkAppReset();
}

test "rakun routing: a kind outside the eight letters is refused naming the letter" {
    val _r = rkAppReset();
    try asserts.throwsWith({ ->
        val _x = rkAppRegisterEntry("Q", "blog", "");
        0;
    }, unknownKindProblem("Q"));
    assert rkAppCount() == 0;
}

test "rakun routing: a page is a P record whose renderer the dispatch finds" {
    val _r = rkAppReset();
    val _p = rkAppRegisterPage("blog/[slug]", textPage("post"));
    assert rkAppTable() == "P|/blog/[slug]";
    assert rkAppHasRender("P|/blog/[slug]");
    val m = matchPage("/blog/hello");
    assert m.record == "P|/blog/[slug]";
    assert m.params == "slug\thello";
    val _z = rkAppReset();
}

test "rakun routing: a second renderer for one pattern is refused naming the pattern" {
    val _r = rkAppReset();
    val _p = rkAppRegisterPage("blog/[slug]", textPage("one"));
    try asserts.throwsWith({ ->
        val _q = rkAppRegisterPage("blog/[slug]", textPage("two"));
        0;
    }, duplicatePageProblem("/blog/[slug]"));
    assert rkAppCount() == 1;
    val _z = rkAppReset();
}

test "rakun routing: a handler is an R record in the same table" {
    val _r = rkAppReset();
    val _h = rkAppRegisterHandler("GET", "api/posts", { req -> noop(req) });
    assert rkAppTable() == "R|/api/posts||GET";
    assert rkAppHasRender("R|/api/posts||GET");
    val _z = rkAppReset();
}

test "rakun routing: the host table and the bundled matcher agree" {
    val _r = rkAppReset();
    val _a = rkAppRegisterEntry("L", "", "");
    val _b = rkAppRegisterPage("", textPage("home"));
    val _c = rkAppRegisterPage("(marketing)/about", textPage("about"));
    val found = matchPath(appTable(), "/about");
    assert found.map({ m -> m.entry.pattern }).unwrapOr("") == "/about";
    assert matchPage("/nowhere").record == "";
    assert entryLine("P", "(marketing)/about", "", "") == "P|/about";
    val _z = rkAppReset();
}
