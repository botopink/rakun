//// rakun-app — route segment config (front 60 step 1).

import {testing.asserts} from "std";
import {Request} from "rakun";
import {rkAppReset, rkAppRegisterPage} from "file_router";
import {PageRenderer, ChunkWriter, writeTo} from "ssr";

fn textBody(out: ChunkWriter, text: string) -> @Task<@Result<void, string>> {
    await writeTo(out, text);
    return;
}

import {SegmentConfig, DynamicMode, FetchCache, defaultSegmentConfig, registerSegmentConfig, configFor, modeName, fetchCacheName} from "segment_config";
import {rkStaticReset} from "static_host";

fn plain() -> PageRenderer {
    return { req, out -> textBody(out, "x") };
}

fn fresh() -> i32 {
    val _r = rkAppReset();
    val _s = rkStaticReset();
    val _b = rkAppRegisterPage("blog", plain());
    return rkAppRegisterPage("blog/[slug]", plain());
}

fn cfg(
    mode: DynamicMode,
    dynamicParams: bool,
    revalidate: i32,
) -> SegmentConfig {
    return SegmentConfig(
        dynamic: mode,
        dynamicParams: dynamicParams,
        revalidate: revalidate,
        fetchCache: FetchCache.Auto,
    );
}

test "segment config: the default is Auto, dynamicParams, never revalidate, fetch cache Auto" {
    val d = defaultSegmentConfig();
    assert modeName(d.dynamic) == "auto"
        && d.dynamicParams
        && d.revalidate == -1
        && fetchCacheName(d.fetchCache) == "auto";
}

test "segment config: a revalidate declared at /blog reaches /blog/[slug], which declares nothing" {
    val _f = fresh();
    val _c = registerSegmentConfig("blog", cfg(DynamicMode.Auto, true, 3600));
    assert configFor("/blog/[slug]").revalidate == 3600;
}

test "segment config: a child overrides field by field, keeping what it leaves at the default" {
    val _f = fresh();
    val _a = registerSegmentConfig(
        "blog",
        cfg(DynamicMode.ForceStatic, false, 3600),
    );
    val _b = registerSegmentConfig(
        "blog/[slug]",
        cfg(DynamicMode.Auto, true, 60),
    );
    val c = configFor("/blog/[slug]");
    assert c.revalidate == 60;
    assert modeName(c.dynamic) == "force-static";
    assert c.dynamicParams == false;
}

test "segment config: revalidate 0 is normalised to ForceDynamic at registration" {
    val _f = fresh();
    val _c = registerSegmentConfig("blog", cfg(DynamicMode.Auto, true, 0));
    assert modeName(configFor("/blog").dynamic) == "force-dynamic";
}

test "segment config: a pattern the table does not hold is refused, naming it" {
    val _f = fresh();
    try asserts.throwsWith(
        { -> registerSegmentConfig("nowhere", defaultSegmentConfig()) },
        "`/nowhere`",
    );
}

test "segment config: a second config for one pattern is refused, not taken" {
    val _f = fresh();
    val _a = registerSegmentConfig("blog", cfg(DynamicMode.Auto, true, 60));
    try asserts.throwsWith(
        { -> registerSegmentConfig("/blog", cfg(DynamicMode.Auto, true, 120)) },
        "already has a segment config",
    );
    assert configFor("/blog").revalidate == 60;
}
