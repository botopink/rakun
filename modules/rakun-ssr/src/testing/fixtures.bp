//// rakun-ssr — fixture builders (`test-snap.md` § Fixture conventions).
////
//// `fixtureTree(text)` reads a multi-line string where a line `== <path>`
//// opens a file and every following line, up to the next `==`, is that
//// file's content.

pub type FixtureFile(path: string, content: string)

pub type Fixture(files: array<FixtureFile>) {
    // The content of `path`, `""` when the fixture has no such file.
    pub fn read(self: Self, path: string) -> string {
        val hit = self.files.filter({ f -> f.path == path });
        return (hit.at(0) ?? FixtureFile(path: "", content: "")).content;
    }

    pub fn paths(self: Self) -> string[] {
        return self.files.map({ f -> f.path });
    }
}

pub fn fixtureTree(text: string) -> Fixture {
    var files: array<FixtureFile> = [];
    var path = "";
    var lines: string[] = [];
    var open = false;
    for line in text.split("\n") {
        if (line.startsWith("== ")) {
            if (open)
                files.push(FixtureFile(path: path, content: lines.join("\n")));
            path = line.slice(3).trim();
            lines = [];
            open = true;
        } else if (open) lines.push(line);
    }
    if (open) files.push(FixtureFile(path: path, content: lines.join("\n")));
    return Fixture(files: files);
}
