//// rakun-ssr — the core helpers (front 49): the resolved config, the
//// routing-file classification, alias resolution and the public-env filter,
//// each rendered by the core's own `describe*` so `rakun-ssr info`, the core's
//// suites and these helpers print one text.

import {assertAs} from "snap";
import {config.loadConfig, config.describeConfig, config.describePublicEnv};
import {types.loadAliases, types.describeAliases, types.describeAppFiles};

// The resolved configuration of a `botopink.json` + `rakun-ssr.json` pair, or the
// error the load names.
pub fn assertConfig(loc: SourceLocation, botopinkJson: string, onzeJson: string) -> Result<void, string> {
    val text = case loadConfig(botopinkJson, onzeJson) {
        Ok(cfg) -> describeConfig(cfg);
        Error(message) -> "error: " + message;
    };
    try assertAs(loc, "config", text);
    return;
}

// The classification table of `paths` under the default `app/`.
pub fn assertAppFiles(loc: SourceLocation, paths: string[]) -> Result<void, string> {
    try assertAs(loc, "app files", describeAppFiles("app", paths));
    return;
}

// Each spec resolved through the `alias` object `aliasJson`, or the error
// the load names.
pub fn assertAlias(loc: SourceLocation, aliasJson: string, specs: string[]) -> Result<void, string> {
    val text = case loadAliases("{ \"name\": \"fixture\", \"alias\": "
        + aliasJson
        + " }") {
        Ok(map) -> describeAliases(map, specs);
        Error(message) -> "error: " + message;
    };
    try assertAs(loc, "aliases", text);
    return;
}

// The filtered env table of `names` over the pairs `env`.
pub fn assertPublicEnv(loc: SourceLocation, env: Array<#(string, string)>, names: string[]) -> Result<void, string> {
    try assertAs(loc, "env", describePublicEnv(env, names));
    return;
}
