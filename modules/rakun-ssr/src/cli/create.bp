//// rakun-ssr — `create` (front 50 step 5).
////
//// One set of defaults, stated once (`createDefaults`) and read by the option
//// parser, the help text and `docs.md`'s table, so the three cannot drift:
////
////   --port <n>              3000     written into rakun-ssr.json
////   --[no-]src-dir          off      app/ (and components/, lib/) under src/,
////                                    or at the project root (`"src": "."`)
////   --emilia / --no-emilia  on       emilia tokens in the layout, or none
////   --example <name>        (none)   copy examples/<name> instead
////   --lang <tag>            en       the document's `<html lang>`, written into
////                                    rakun-ssr.json (rakun-bpp's `app(…, lang:)`)
////   --libs <dir>            (none)   depend on a rakun checkout by path
////                                    (its modules/<package>) instead of git
////   --yes                   off      take every default, no prompts
////
//// No parser drops a token: an unknown flag or a second positional is a
//// usage error. `create` refuses a non-empty directory, and `--yes` does not
//// override that — it means "take the defaults", not "overwrite my files".

import {io.fs, path, compiler} from "std";

pub type CreateOpts(
    name: string,
    port: i32,
    srcDir: bool,
    emilia: bool,
    example: string,
    lang: string,
    libs: string,
    yes: bool,
)

pub fn createDefaults() -> CreateOpts {
    return CreateOpts(name: "", port: 3000, srcDir: false, emilia: true, example: "", lang: "en", libs: "", yes: false);
}

// The flag table as text: `rakun-ssr create --help` and `docs.md` both print it.
pub fn createHelp() -> string {
    val d = createDefaults();
    return [
        "usage: rakun-ssr create <name> [options]",
        "",
        "  --port <n>              "
            + d.port.toString().padEnd(9, " ")
            + "written into rakun-ssr.json",
        "  --[no-]src-dir          off      app/, components/ and lib/ under src/, or at the project root",
        "  --emilia / --no-emilia  on       emilia tokens in the layout, or none",
        "  --example <name>        (none)   copy examples/<name> instead of the scaffold",
        "  --lang <tag>            "
            + d.lang.padEnd(9, " ")
            + "the document's <html lang>, written into rakun-ssr.json",
        "  --libs <dir>            (none)   depend on a rakun checkout (its modules/<package>) by path",
        "  --yes                   off      take every default and skip the prompts",
    ].join("\n");
}

#[compiler.external(
    .JavaScript("""(/^[0-9]+$/.test($0) ? Number($0) : -1)"""),
    .Erlang("""(fun(__S) -> try binary_to_integer(__S) catch _:_ -> -1 end end)($0)"""),
)]
declare fn digits(s: string) -> i32;

fn withField(o: CreateOpts, key: string, value: string) -> CreateOpts {
    return CreateOpts(
        name: if (key == "name") value else o.name,
        port: if (key == "port") digits(value) else o.port,
        srcDir: if (key == "srcDir") value == "on" else o.srcDir,
        emilia: if (key == "emilia") value == "on" else o.emilia,
        example: if (key == "example") value else o.example,
        lang: if (key == "lang") value else o.lang,
        libs: if (key == "libs") value else o.libs,
        yes: if (key == "yes") true else o.yes,
    );
}

pub fn parseCreateOpts(args: string[]) -> Result<CreateOpts, string> {
    var o = createDefaults();
    var i = 0;
    var named = false;
    while (i < args.length) {
        val a = args.at(i) ?? "";
        val next = args.at(i + 1) ?? "";
        val takesValue = a == "--port"
            || a == "--example"
            || a == "--lang"
            || a == "--libs";
        if (takesValue) {
            if (next == "" || next.startsWith("--"))
                throw "rakun-ssr create: " + a + " needs a value";
            val key = if (a == "--port")
                "port"
            else if (a == "--example")
                "example"
            else if (a == "--lang")
                "lang"
            else
                "libs";
            o = withField(o, key, next);
            if (key == "port" && (o.port < 1 || o.port > 65535))
                throw "rakun-ssr create: --port " + next + " is not a port";
            i = i + 2;
        } else {
            if (a == "--src-dir")
                o = withField(o, "srcDir", "on")
            else if (a == "--no-src-dir")
                o = withField(o, "srcDir", "off")
            else if (a == "--emilia")
                o = withField(o, "emilia", "on")
            else if (a == "--no-emilia")
                o = withField(o, "emilia", "off")
            else if (a == "--yes")
                o = withField(o, "yes", "")
            else if (a.startsWith("-"))
                throw "rakun-ssr create: unknown flag "
                    + a
                    + "\n"
                    + createHelp()
            else if (named)
                throw "rakun-ssr create: a second name \""
                    + a
                    + "\" (the name is \""
                    + o.name
                    + "\")"
            else {
                o = withField(o, "name", a);
                named = true;
            }
            i = i + 1;
        }
    }
    if (o.name == "")
        throw "rakun-ssr create: which directory? usage: rakun-ssr create <name>";
    val badName = o.name
        .split("")
        .any({ c -> "abcdefghijklmnopqrstuvwxyz0123456789-_".contains(c) == false });
    if (badName)
        throw "rakun-ssr create: a project name is [a-z0-9_-]+, not \""
            + o.name
            + "\"";
    return o;
}

fn quote(s: string) -> string {
    return "\"" + s.replaceAll("\\", "\\\\").replaceAll("\"", "\\\"") + "\"";
}

// The libraries a scaffold depends on — the ones its sources import, and
// rakun-ssr, whose server package `rakun-ssr build` stages the app into (dependencies
// load transitively, decision 143): `#(import name, repository path, member
// path)`. emilia only when the layout calls it.
pub fn scaffoldLibraries(o: CreateOpts) -> array<#(string, string, string)> {
    val emilia: array<#(string, string, string)> = if (o.emilia)
        [#("rakun-stylesheet", "rakun", "modules/rakun-stylesheet")]
    else
        [];
    return [#("rakun-bpp", "rakun", "modules/rakun-bpp")]
        .append(emilia)
        .append([#("rakun-ssr", "rakun", "modules/rakun-ssr")]);
}

// Inside the rakun workspace itself (an `examples/<package>/*` member) the
// libraries are sibling members, which the compiler requires as
// `{ "workspace": true }`.
pub fn insideOnzeWorkspace(parentDir: string) -> bool {
    var dir = parentDir;
    var guard = 0;
    var found = false;
    while (found == false && guard < 4) {
        val manifest = fs
            .readText(path.join([dir, "botopink.json"]))
            .unwrapOr("");
        found = manifest.contains("\"workspaces\"")
            && manifest.contains("\"name\": \"rakun\"");
        dir = path.join([dir, ".."]);
        guard = guard + 1;
    }
    return found;
}

fn dependencyOf(o: CreateOpts, lib: #(string, string, string), member: bool) -> string {
    val sibling = member;
    if (sibling) return quote(lib._0) + ": { \"workspace\": true }";
    if (o.libs != "")
        return quote(lib._0)
            + ": { \"path\": "
            + quote(path.join([o.libs, lib._2]))
            + " }";
    return quote(lib._0)
        + ": { \"git\": "
        + quote("https://github.com/botopink/" + lib._1 + ".git")
        + ", \"branch\": \"feat\" }";
}

fn layoutSource(o: CreateOpts) -> string {
    val imports = "import {layout, jhLayout, LayoutProps, Element, ElementBase, main} from \"rakun-bpp\";";
    val emiliaImport = if (o.emilia)
        "\nimport {emilia.emilia, Token} from \"rakun-stylesheet\";"
    else
        "";
    val cls = if (o.emilia) "    val shell = emilia([.Gap.All.4]);\n" else "";
    val attrs = if (o.emilia) "[#(\"class\", shell)]" else "[]";
    return imports
        + emiliaImport
        + "\n\n// The root layout: every page renders inside it.\n#[layout(\"\")]\npub fn rootLayout(props: LayoutProps) -> Component<Element> {\n"
        + cls
        + "    return main([props.children], attrs: "
        + attrs
        + ");\n}\n";
}

fn pageSource(o: CreateOpts) -> string {
    return "import {page, jhPage, ctxParam, ctxRest, PageContext, Element, ElementBase, h1, p, text} from \"rakun-bpp\";\n\n#[page(\"\")]\npub fn home(route: PageContext) -> Component<Element> {\n    return h1([text("
        + quote("Welcome to " + o.name)
        + ", attrs: [])], attrs: []);\n}\n";
}

// The scaffold, as `#(path relative to the project, text)`.
pub fn scaffoldFiles(o: CreateOpts) -> array<#(string, string)> {
    return scaffoldFilesIn(o, false);
}

// The scaffold, `member` when it is created as a member of the rakun-ssr
// workspace (its `rakun-ssr` dependency is then `{ "workspace": true }`).
pub fn scaffoldFilesIn(o: CreateOpts, member: bool) -> array<#(string, string)> {
    val src = if (o.srcDir) "src/" else "";
    val deps = scaffoldLibraries(o).map({ l -> "    " + dependencyOf(o, l, member) });
    val manifest = [
        "{",
        "  \"name\": " + quote(o.name) + ",",
        "  \"version\": \"0.1.0\",",
        "  \"src\": " + quote(if (o.srcDir) "src/" else ".") + ",",
        "  \"entry\": \"root.bp\",",
        "  \"target\": \"erlang\",",
        "  \"files\": [\"root.bp\", \"app/mod.bp\", \"app/layout.bp\", \"app/page.bp\"],",
        "  \"targets\": [\"erlang\", \"commonJS\"],",
        "  \"dependencies\": {",
        deps.join(",\n"),
        "  }",
        "}",
    ].join("\n")
        + "\n";
    val ssrJson = "{\n  \"name\": "
        + quote(o.name)
        + ",\n  \"port\": "
        + o.port.toString()
        + ",\n  \"basePath\": \"\",\n  \"appDir\": "
        + quote(src + "app")
        + ",\n  \"publicDir\": \"public\",\n  \"outDir\": \".onze\",\n  \"lang\": "
        + quote(o.lang)
        + "\n}\n";
    return [
        #("botopink.json", manifest),
        #("rakun-ssr.json", ssrJson),
        #(src + "root.bp", "//// "
            + o.name
            + " — a rakun-ssr app. `rakun-ssr build` stages app/ and generates its module tree; `rakun-ssr start` serves the build.\n\npub mod app;\n"),
        #(src + "app/mod.bp", "pub mod layout;\npub mod page;\n"),
        #(src + "app/layout.bp", layoutSource(o)),
        #(src + "app/page.bp", pageSource(o)),
        #("public/.gitkeep", ""),
    ];
}

// Writes the scaffold into `dir`, refusing a directory that exists and is not
// empty. Answers the files written.
pub fn writeScaffold(dir: string, files: array<#(string, string)>) -> Result<array<string>, string> {
    val existing = if (fs.exists(dir)) fs.list(dir).unwrapOr([]) else [];
    if (existing.length > 0)
        throw "rakun-ssr create: "
            + dir
            + " is not empty - pick another name or empty it; --yes does not overwrite files";
    var written: string[] = [];
    for (files) { f ->
        val target = path.join([dir, f._0]);
        try mkdirs(path.dirname(target));
        val w = try fs.writeText(target, f._1);
        written.push(f._0);
    }
    return written;
}

// `mkdir -p`, over std's non-recursive `fs.mkdir`.
pub fn mkdirs(dir: string) -> Result<void, string> {
    if (dir == "" || dir == "." || dir == "/" || fs.exists(dir)) return;
    try mkdirs(path.dirname(dir));
    val made = try fs.mkdir(dir);
    return;
}

// What `create` prints before writing: the resolved options.
fn onOff(flag: bool) -> string {
    return if (flag) "on" else "off";
}

fn dependenciesText(libs: string) -> string {
    return if (libs == "") "git (feat)" else "path " + libs;
}

pub fn describeCreate(o: CreateOpts) -> string {
    return [
        "name          " + o.name,
        "port          " + o.port.toString(),
        "src-dir       " + onOff(o.srcDir),
        "emilia        " + onOff(o.emilia),
        "lang          " + o.lang,
        "dependencies  " + dependenciesText(o.libs),
    ].join("\n");
}
