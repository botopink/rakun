//// rakun-ssr — `start` (front 50 step 8) and the server's generated main.
////
//// `rakun-ssr build` stages the server package with one more module,
//// `onze_main.bp` (`serverMainSource`): the configuration `build` resolved,
//// written as a literal, and `main()` calling rakun-ssr's `Onze.run` with
//// the port `PORT` names. It imports `onze_routes`, which imports every
//// decorated app module and registers the conventions without a decorator,
//// and it registers every `#[page]` / `#[layout]` / `#[template]` /
//// `#[defaultView]` function itself, from the program's catalogue —
//// `jhRegisterRoutes(@TypeInfo.all(with: page), …)` (decision 216): a module
//// reading `@TypeInfo.all` is imported by nobody, and this one is the entry.
////
//// `start` compiles nothing. With no `<outDir>/build-id` it exits non-zero
//// naming the directory; otherwise it runs
////
////     erl -noshell -pa <outDir>/server/beam -eval '<package>@onze_main':main([])
////
//// from the project root with `PORT` set — `-p`, else `PORT`, else
//// `rakun-ssr.json`'s `port` (`startPort`) — and the server's output in
//// `<outDir>/server.log`.

import {io.fs, io.env, io.process, path, json.quote} from "std";
import {config.OnzeConfig, config.parsePort, config.packageName};
import {cli.resolve.Project};

// The configuration as botopink source: an `OnzeConfig(…)` literal.
pub fn configLiteral(c: OnzeConfig) -> string {
    val redirects = "["
        + c.allowedRedirects.map({ r -> quote(r) }).join(", ")
        + "]";
    val dev = if (c.dev) "true" else "false";
    return "OnzeConfig(name: "
        + quote(c.name)
        + ", port: "
        + c.port.toString()
        + ", basePath: "
        + quote(c.basePath)
        + ", appDir: "
        + quote(c.appDir)
        + ", publicDir: "
        + quote(c.publicDir)
        + ", outDir: "
        + quote(c.outDir)
        + ", dev: "
        + dev
        + ", actionsBodyLimit: "
        + c.actionsBodyLimit.toString()
        + ", allowedRedirects: "
        + redirects
        + ", lang: "
        + quote(c.lang)
        + ")";
}

// The server package's `onze_main.bp`.
pub fn serverMainSource(c: OnzeConfig) -> string {
    return [
        "// GENERATED by rakun-ssr build — do not edit.",
        "",
        "import {io.env, failure.panic} from \"std\";",
        "import {OnzeConfig, withPort, parsePort} from \"rakun-ssr\";",
        "import {Onze} from \"onze-server\";",
        "import {page, layout, template, defaultView, jhRegisterRoutes} from \"rakun-bpp\";",
        "import {onze_routes.routeModules};",
        "",
        "pub fn onzeConfig() -> OnzeConfig {",
        "    return " + configLiteral(c) + ";",
        "}",
        "",
        "fn refuse(problem: string) -> i32 {",
        "    panic(problem);",
        "}",
        "",
        "fn portOr(fallback: i32) -> i32 {",
        "    val raw = env.read(\"PORT\") ?? \"\";",
        "    if (raw == \"\") return fallback;",
        "    return case parsePort(raw, \"PORT\") {",
        "        Ok(n) -> n;",
        "        Error(e) -> refuse(e);",
        "    };",
        "}",
        "",
        "val routes = jhRegisterRoutes(",
        "    @TypeInfo.all(with: page),",
        "    @TypeInfo.all(with: layout),",
        "    @TypeInfo.all(with: template),",
        "    @TypeInfo.all(with: defaultView),",
        ");",
        "",
        "pub fn main() {",
        "    val loaded = routeModules();",
        "    val c = onzeConfig();",
        "    Onze.run(withPort(c, portOr(c.port)));",
        "}",
    ].join("\n")
        + "\n";
}

// The port `start` serves on: `-p <n>`, else `PORT`, else the config's.
pub fn startPort(args: string[], envPort: string, configPort: i32) -> Result<i32, string> {
    val at = args.indexOf("-p");
    if (at >= 0) {
        val given = args.at(at + 1) ?? "";
        return try parsePort(given, "rakun-ssr start -p");
    }
    if (envPort != "") return try parsePort(envPort, "PORT");
    return configPort;
}

// The arguments `start` takes: `-p <port>` and nothing else.
pub fn startArgsProblem(args: string[]) -> string {
    var i = 0;
    var problem = "";
    while (i < args.length && problem == "") {
        val a = args.at(i) ?? "";
        if (a == "-p") i = i + 2 else {
            problem = "rakun-ssr start: unexpected argument " + a;
            i = args.length;
        }
    }
    return problem;
}

// Where `build` wrote the output: `outDir` against the project root.
pub fn outDirOf(p: Project) -> string {
    return if (path.isAbsolute(p.config.outDir))
        p.config.outDir
    else
        path.join([p.root, p.config.outDir]);
}

fn shellQuote(s: string) -> string {
    return "'" + s.replaceAll("'", "'\\''") + "'";
}

// The package name `botopink.json` gives — the first part of every module
// atom of the staged server (`rakun-ssr.json`'s `name` renames the app, not the
// package).
pub fn packageOf(p: Project) -> string {
    val manifest = fs
        .readText(path.join([p.root, "botopink.json"]))
        .unwrapOr("");
    return packageName(manifest).unwrapOr(p.config.name);
}

// The command line that serves the build: from the project root, `PORT`
// set, the server's output into `<outDir>/server.log`. The entry is
// `main/1`, the one `botopink run` calls (`main([])`): on the BEAM it runs
// every imported module's body — the `#[page]` / `#[layout]` registrations
// `onze_routes` imports for — before `main`; a bare `main()` (`main/0`) runs
// none of them and every page is a 404.
pub fn serverCommand(p: Project, port: i32) -> string {
    val out = outDirOf(p);
    val entry = "'" + packageOf(p) + "@onze_main':main([])";
    return "cd "
        + shellQuote(p.root)
        + " && PORT="
        + port.toString()
        + " exec erl -noshell -pa "
        + shellQuote(path.join([out, "server", "beam"]))
        + " -eval "
        + shellQuote(entry)
        + " > "
        + shellQuote(path.join([out, "server.log"]))
        + " 2>&1";
}

// Refuses a project that was never built, naming the missing directory.
pub fn builtOutput(p: Project) -> Result<string, string> {
    val out = outDirOf(p);
    if (fs.exists(path.join([out, "build-id"])) == false)
        throw "rakun-ssr start: "
            + out
            + " holds no build (no build-id) - run `rakun-ssr build` first; start compiles nothing";
    if (fs.exists(path.join([out, "server", "beam"])) == false)
        throw "rakun-ssr start: "
            + path.join([out, "server", "beam"])
            + " does not exist - run `rakun-ssr build` first; start compiles nothing";
    return out;
}

// A decimal process id; `-1` for any other text.
pub fn pidOf(text: string) -> i32 {
    val digits = text.trim();
    if (digits == "") return 0 - 1;
    var n = 0;
    var ok = true;
    for (digits.split("")) { c ->
        val d = "0123456789".indexOf(c);
        if (d < 0) ok = false;
        n = n * 10 + d;
    }
    return if (ok) n else 0 - 1;
}

// Starts the server in the background and answers its process id — the
// half of `start` a test drives (the other half waits on it).
pub fn spawnServer(p: Project, port: i32) -> Result<i32, string> {
    val out = try builtOutput(p);
    val r = try process.run("sh", ["-c", serverCommand(p, port)
        + " & echo $!"]);
    val pid = pidOf(r.stdout);
    if (pid < 0)
        throw "rakun-ssr start: the server did not start: " + r.stdout.trim();
    return pid;
}

// `rakun-ssr start`: serve the build in the foreground until the server exits.
pub fn startProject(p: Project, args: string[]) -> Result<string, string> {
    val problem = startArgsProblem(args);
    if (problem != "") throw problem;
    val port = try startPort(args, env.read("PORT") ?? "", p.config.port);
    val out = try builtOutput(p);
    val r = try process.run("sh", ["-c", serverCommand(p, port)]);
    if (r.status != 0)
        throw "rakun-ssr start: the server exited with status "
            + r.status.toString()
            + " - "
            + path.join([out, "server.log"]);
    return "rakun-ssr start: the server stopped";
}
