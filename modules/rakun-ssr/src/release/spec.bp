//// rakun-ssr — the descriptor and the build id (front 71 step 1).
////
//// The build id is derived ONCE — std's `contentHash` over the sorted list
//// of every compiled module's hash plus the client manifest's hash, six hex
//// digits — and stamped in four places that `verifyBuildId` asserts equal:
//// `BUILD_ID`, the release directory, the client manifest's `buildId` and the
//// payload's `b`. A user-supplied id (`generateBuildId` in Next's terms)
//// replaces the derivation but must match `[A-Za-z0-9_-]{1,64}` — it ends up
//// in a URL path.

import {hash} from "std";

pub type ReleaseSpec(
    name: string,
    version: string,
    buildId: string,
    apps: array<#(string, string)>,
    includeErts: bool,
    ertsVersion: string,
    otpRelease: string,
    outDir: string,
)

// The applications every rakun-ssr release carries before the app itself: the OTP names of the
// packages (a hyphen is no part of an atom, so `rakun-bpp` is the application `rakun_bpp`).
pub fn baseApps() -> array<#(string, string)> {
    return [#("rakun", "0.0.1"), #("rakun_bpp", "0.0.1"), #("rakun_stylesheet", "0.0.1"), #("rakun_ssr", "0.0.1")];
}

pub fn releaseSpec(name: string, version: string, buildId: string) -> ReleaseSpec {
    return ReleaseSpec(name: name, version: version, buildId: buildId, apps: baseApps().append([#(name, version)]), includeErts: true, ertsVersion: "16.0", otpRelease: "28", outDir: ".onze");
}

pub fn withErts(spec: ReleaseSpec, include: bool) -> ReleaseSpec {
    return ReleaseSpec(name: spec.name, version: spec.version, buildId: spec.buildId, apps: spec.apps, includeErts: include, ertsVersion: spec.ertsVersion, otpRelease: spec.otpRelease, outDir: spec.outDir);
}

pub fn withRuntime(spec: ReleaseSpec, ertsVersion: string, otpRelease: string) -> ReleaseSpec {
    return ReleaseSpec(name: spec.name, version: spec.version, buildId: spec.buildId, apps: spec.apps, includeErts: spec.includeErts, ertsVersion: ertsVersion, otpRelease: otpRelease, outDir: spec.outDir);
}

pub fn sortedText(xs: string[]) -> string[] {
    var out: string[] = [];
    for x in xs {
        var placed = false;
        var next: string[] = [];
        for y in out {
            val before = placed == false && x < y;
            if (before) {
                next.push(x);
                placed = true;
            }
            next.push(y);
        }
        if (placed == false) next.push(x);
        out = next;
    }
    return out;
}

// Six hex digits of std's `contentHash` over the sorted module hashes and the
// manifest's hash: the same inputs in any order give the same id.
pub fn generateBuildId(moduleHashes: array<string>, manifestHash: string) -> string {
    val material = sortedText(moduleHashes).join("\n")
        + "\n--\n"
        + manifestHash;
    return hash.contentHash(material).padStart(8, "0").slice(0, 6);
}

// The problems of a build id, `[]` when it is usable.
pub fn validateBuildId(id: string) -> array<string> {
    if (id == "") return ["build id is empty"];
    if (id.length() > 64)
        return ["build id is "
            + id.length().toString()
            + " characters; the limit is 64"];
    val bad = id
        .split("")
        .any({ c -> "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-".contains(c) == false });
    if (bad) return ["build id \"" + id + "\" is not [A-Za-z0-9_-]{1,64}"];
    return [];
}

// The disagreements between the release's id and the ids the manifest and
// the payload carry, each naming the two sides.
pub fn verifyBuildId(spec: ReleaseSpec, manifestBuildId: string, payloadBuildId: string) -> array<string> {
    var out: string[] = [];
    if (spec.buildId != manifestBuildId)
        out.push("release and manifest build ids disagree ("
            + spec.buildId
            + " vs "
            + manifestBuildId
            + ")");
    if (spec.buildId != payloadBuildId)
        out.push("release and payload build ids disagree ("
            + spec.buildId
            + " vs "
            + payloadBuildId
            + ")");
    val third = manifestBuildId != payloadBuildId
        && spec.buildId == manifestBuildId
        && spec.buildId == payloadBuildId;
    if (third)
        out.push("manifest and payload build ids disagree ("
            + manifestBuildId
            + " vs "
            + payloadBuildId
            + ")");
    return out;
}
