//// rakun-ssr — packaging the asset tree (front 71 step 3).
////
//// Every chunk front 68's manifest names and every stylesheet front 69's `Y`
//// records name must exist in `<outDir>/static/<buildId>/`; a missing one
//// fails packaging naming it. `public/` is copied verbatim. The last check
//// before the artifact leaves the building: a non-public environment value
//// present verbatim in any packaged asset fails packaging naming the
//// variable — behind front 68's refusal, one scan.

import {io.fs, io.process, path} from "std";
import {bundler.manifest.ClientBundleManifest, bundler.manifest.ChunkRef, bundler.manifest.parseManifest};
import {config.isPublicEnvName};
import {release.spec.ReleaseSpec};

// The file name of a chunk URL: its last path segment.
pub fn fileOfUrl(url: string) -> string {
    val parts = url.split("/");
    return parts.at(parts.length - 1) ?? url;
}

// The static files the manifest promises: every chunk, the entry and every
// stylesheet, by file name.
pub fn promisedFiles(m: ClientBundleManifest) -> string[] {
    val refs = [m.entry]
        .append(m.shared)
        .append(m.chunks.filter({ c -> c.url.startsWith("/_onze/static/") }))
        .append(m.styles);
    return refs.filter({ c -> c.url != "" }).map({ c -> fileOfUrl(c.url) });
}

// The promised files absent from `present`, as messages.
pub fn missingAssets(m: ClientBundleManifest, present: string[]) -> array<string> {
    return promisedFiles(m)
        .filter({ f -> present.contains(f) == false })
        .map({ f -> "release refused — the manifest names static/" + m.buildId + "/" + f + ", which the build did not produce" });
}

// Every `#(name, value)` among `secrets` whose name is not public and whose
// value appears verbatim in an asset of `assetTree` (`#(path, text)`).
pub fn scanForSecrets(assetTree: array<#(string, string)>, secrets: array<#(string, string)>) -> array<string> {
    var out: string[] = [];
    for (secrets.filter({ s -> isPublicEnvName(s._0) == false && s._1.length() >= 4 })) { s ->
        for (assetTree) { a ->
            if (a._1.contains(s._1))
                out.push("release refused — value of "
                    + s._0
                    + " found in "
                    + a._0);
        }
    }
    return out;
}

fn copyTree(source: string, target: string) -> Result<void, string> {
    val made = try process.run("mkdir", ["-p", target]);
    if (fs.exists(source) == false) return;
    val copied = try process.run("cp", ["-R", source + "/.", target]);
    if (copied.status != 0)
        throw "copy "
            + source
            + " -> "
            + target
            + " failed: "
            + (copied.stdout + copied.stderr).trim();
    return;
}

// Copies the static tree and `public/` into `<releaseDir>`, after checking
// the manifest's promises and scanning for secrets. Answers the packaged
// static files.
pub fn packageAssets(spec: ReleaseSpec, manifestText: string, staticDir: string, publicDir: string, releaseDir: string, secrets: array<#(string, string)>) -> Result<array<string>, string> {
    val m = try parseManifest(manifestText);
    val present = if (fs.exists(staticDir)) try fs.list(staticDir) else [];
    val missing = missingAssets(m, present);
    if (missing.length > 0) throw missing.join("\n");
    var tree: array<#(string, string)> = [];
    for (present) { f ->
        tree.push(#("static/" + spec.buildId + "/" + f, fs
            .readText(path.join([staticDir, f]))
            .unwrapOr("")));
    }
    val leaks = scanForSecrets(tree, secrets);
    if (leaks.length > 0) throw leaks.join("\n");
    try copyTree(staticDir, path.join([releaseDir, "static", spec.buildId]));
    try copyTree(publicDir, path.join([releaseDir, "public"]));
    val w = try fs.writeText(path.join([releaseDir, "BUILD_ID"]), spec.buildId
        + "\n");
    return present;
}
