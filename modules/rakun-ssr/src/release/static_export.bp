//// rakun-ssr — static export (front 71 step 7): `output: 'export'`.
////
//// Every route is prerendered (front 60) and written as
//// `<route>/index.html` beside the static assets and `public/`; no boot
//// script, no `releases/`. A route that cannot be prerendered — a dynamic
//// segment with no static params — fails the export naming it: never a
//// silently partial site.

pub type ExportRoute(pattern: string, authoredPath: string, html: string, prerenderable: bool)

pub fn exportPathOf(pattern: string) -> string {
    return if (pattern == "/")
        "index.html"
    else
        pattern.slice(1) + "/index.html";
}

// The exported tree, `#(path, text)`, or the refusal naming every route that
// cannot be prerendered.
pub fn staticExport(routes: Array<ExportRoute>, assets: Array<#(string, string)>) -> Result<Array<#(string, string)>, string> {
    val refused = routes.filter({ r -> r.prerenderable == false });
    if (refused.length > 0)
        throw refused
            .map({ r -> "static export refused — route " + r.pattern + " (" + r.authoredPath + ") cannot be prerendered: no static params registered" })
            .join("\n");
    return routes
        .map({ r -> #(exportPathOf(r.pattern), r.html) })
        .append(assets);
}
