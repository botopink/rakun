//// rakun-ssr — the OTP release (front 71 steps 2 and 5).
////
//// The release is OTP's own layout, assembled by `systools` through std's
//// `process.run` (`erl -noshell -eval …`) — not rebar3, a second build
//// system. Every file `systools` needs is text generated here: the `.rel`,
//// `sys.config` (DEFAULTS only — a deployment's values are environment
//// variables read at boot), `vm.args` (the cookie is `${RELEASE_COOKIE}`,
//// never a literal: a baked cookie is a remote shell for anyone who reads the
//// image) and the boot script `bin/rakun-ssr`, which checks the build id and the
//// cookie and then `exec`s the VM so the container's PID 1 is the VM.

import {io.process, io.process.Exit} from "std";
import {release.spec.ReleaseSpec};

fn quote(s: string) -> string {
    return "\"" + s + "\"";
}

// The OTP applications a release boots first, with their versions for OTP 28.
pub fn otpApps() -> Array<#(string, string)> {
    return [#("kernel", "10.3"), #("stdlib", "7.0"), #("sasl", "4.3")];
}

pub fn relFileText(spec: ReleaseSpec) -> string {
    val apps = otpApps()
        .append(spec.apps)
        .map({ a -> "{" + a._0 + ", " + quote(a._1) + "}" });
    return "{release, {"
        + quote(spec.name)
        + ", "
        + quote(spec.version)
        + "}, {erts, "
        + quote(spec.ertsVersion)
        + "},\n ["
        + apps.join(", ")
        + "]}.\n";
}

// `sys.config`: the app's static defaults as `{Key, Value}` terms, each
// value written as the Erlang literal the pair carries.
pub fn sysConfigText(spec: ReleaseSpec, defaults: Array<#(string, string)>) -> string {
    return "[{"
        + spec.name
        + ", ["
        + defaults.map({ d -> "{" + d._0 + ", " + d._1 + "}" }).join(", ")
        + "]}].\n";
}

pub fn defaultSysConfig() -> Array<#(string, string)> {
    return [#("port", "3000"), #("base_path", "\"\"")];
}

// A shell/`vm.args` variable reference, `${NAME}` — spelled apart because
// `${` opens an interpolation in a botopink string.
pub fn shellVar(name: string) -> string {
    return "$" + "{" + name + "}";
}

pub fn vmArgsText(spec: ReleaseSpec) -> string {
    return "-name "
        + spec.name
        + "@127.0.0.1\n-setcookie "
        + shellVar("RELEASE_COOKIE")
        + "\n+K true\n";
}

fn here(rest: string) -> string {
    return "\"$(dirname \"$0\")/../" + rest + "\"";
}

pub fn bootScriptText(spec: ReleaseSpec) -> string {
    val erl = if (spec.includeErts)
        here("erts-" + spec.ertsVersion + "/bin/erl")
    else
        "erl";
    return [
        "#!/bin/sh",
        "set -e",
        "BUILD_ID=\"$(cat " + here("BUILD_ID") + ")\"",
        "[ \"$BUILD_ID\" = \""
            + spec.buildId
            + "\" ] || { echo \"build id mismatch: $BUILD_ID != "
            + spec.buildId
            + "\" >&2; exit 1; }",
        "[ -n \"$RELEASE_COOKIE\" ] || { echo \"RELEASE_COOKIE is not set\" >&2; exit 1; }",
        "export PORT=\"" + shellVar("PORT:-3000") + "\"",
        "exec "
            + erl
            + " -boot "
            + here("releases/" + spec.buildId + "/start")
            + " -config "
            + here("releases/" + spec.buildId + "/sys")
            + " -args_file "
            + here("releases/" + spec.buildId + "/vm.args")
            + " -noshell",
    ].join("\n")
        + "\n";
}

// Runs `systools:make_script/2` over `<relDir>/rakun-ssr` (the `.rel` written
// there), with `libDirs` the code paths of the release's applications.
// Answers the boot script's path, or an error carrying `erl`'s output.
pub fn assembleRelease(relDir: string, libDirs: string[]) -> Result<string, string> {
    val paths = libDirs.map({ d -> "\"" + d + "\"" }).join(",");
    val expr = "case systools:make_script(\""
        + relDir
        + "/rakun-ssr\", [{path, ["
        + paths
        + "]}, silent, no_warn_sasl]) of ok -> halt(0); {ok, _, _} -> halt(0); E -> io:format(\"~p~n\", [E]), halt(1) end.";
    val ran = process.run("erl", ["-noshell", "-eval", expr]);
    val failed = ran.isError();
    if (failed) throw "assembleRelease: erl could not run";
    val exit = ran.unwrapOr(Exit(status: 1, stdout: "", stderr: ""));
    if (exit.status != 0)
        throw "assembleRelease: systools failed: "
            + (exit.stdout + exit.stderr).trim();
    return relDir + "/rakun-ssr.boot";
}

// The version of an installed OTP application, and of ERTS, as the local
// `erl` reports them — what a `.rel` must name for `systools` to accept it.
pub fn installedVersion(app: string) -> Result<string, string> {
    val expr = if (app == "erts")
        "io:format(\"~s\", [erlang:system_info(version)]), halt()."
    else
        "application:load("
            + app
            + "), {ok, V} = application:get_key("
            + app
            + ", vsn), io:format(\"~s\", [V]), halt().";
    val ran = process.run("erl", ["-noshell", "-eval", expr]);
    if (ran.isError()) throw "erl is not on PATH";
    val exit = ran.unwrapOr(Exit(status: 1, stdout: "", stderr: ""));
    if (exit.status != 0) throw "no installed application " + app;
    return exit.stdout.trim();
}
