//// rakun-ssr — layout (front 70 step 3): a card's box tree.
////
//// A small flexbox: `flexDirection` row or column, `justifyContent`
//// (`flex-start`, `center`, `flex-end`, `space-between`), `alignItems`
//// (`flex-start`, `center`, `flex-end`, `stretch`), `gap`, `padding`,
//// `width` / `height` in `px` or `%`, and `position: absolute` with `top` /
//// `left` (out of flow — its siblings ignore it). An element whose children
//// are all text is a text box: its lines come from `wrapText` over the face's
//// metrics, breaking at spaces only — a word wider than the box overflows
//// rather than being cut — and `maxLines` ends the last line with `…` that
//// fits. The text style (`fontSize`, `fontFamily`, `fontWeight`, `color`,
//// `lineHeight`, `textAlign`, `maxLines`) inherits down the tree.
//// Deterministic: integers throughout.

import {Element} from "rakun-bpp";
import {og.card_style.Style, og.card_style.parseStyle, og.card_style.emptyStyle, og.card_style.pxOf};
import {og.metrics.FontMetrics, og.metrics.measure};

pub type LayoutBox(
    tag: string,
    x: i32,
    y: i32,
    width: i32,
    height: i32,
    style: Style,
    text: string,
    lines: array<string>,
    children: array<LayoutBox>,
)

pub type ImageSize(width: i32, height: i32)

fn attrOf(e: Element, name: string) -> string {
    val hit = e.attrs.filter({ a -> a._0 == name });
    if (hit.length == 0) return "";
    val pair = hit.at(0) ?? #("", "");
    return pair._1;
}

pub fn styleOfElement(e: Element) -> Style {
    return parseStyle(attrOf(e, "style"));
}

// The style `child` lays out with: its own, the text properties it does not
// set taken from `parent`.
pub fn inherit(parent: Style, own: Style, declared: string) -> Style {
    return Style(
        display: own.display,
        flexDirection: own.flexDirection,
        justifyContent: own.justifyContent,
        alignItems: own.alignItems,
        gap: own.gap,
        width: own.width,
        height: own.height,
        padding: own.padding,
        margin: own.margin,
        background: own.background,
        color: if (own.color == "") parent.color else own.color,
        fontSize: if (own.fontSize == 0) parent.fontSize else own.fontSize,
        fontWeight: if (own.fontWeight == 0)
            parent.fontWeight
        else
            own.fontWeight,
        fontFamily: if (own.fontFamily == "")
            parent.fontFamily
        else
            own.fontFamily,
        lineHeight: if (own.lineHeight == 0)
            parent.lineHeight
        else
            own.lineHeight,
        textAlign: own.textAlign,
        borderRadius: own.borderRadius,
        border: own.border,
        opacity: own.opacity,
        position: own.position,
        top: own.top,
        left: own.left,
        right: own.right,
        bottom: own.bottom,
        maxLines: if (own.maxLines == 0) parent.maxLines else own.maxLines,
    );
}

fn rootStyle() -> Style {
    val e = emptyStyle();
    return Style(display: e.display, flexDirection: e.flexDirection, justifyContent: e.justifyContent, alignItems: e.alignItems, gap: e.gap, width: e.width, height: e.height, padding: e.padding, margin: e.margin, background: e.background, color: "#000000", fontSize: 16, fontWeight: 400, fontFamily: "", lineHeight: 0, textAlign: e.textAlign, borderRadius: e.borderRadius, border: e.border, opacity: e.opacity, position: e.position, top: e.top, left: e.left, right: e.right, bottom: e.bottom, maxLines: 0);
}

// The face for a family and weight; the first face when none matches; a
// 1000-unit, 500-advance stand-in when there are none.
pub fn faceFor(faces: array<FontMetrics>, family: string, weight: i32) -> FontMetrics {
    val exact = faces.filter({ f -> f.family == family && f.weight == weight });
    val byFamily = faces.filter({ f -> f.family == family });
    val stand = FontMetrics(family: "", weight: 400, unitsPerEm: 1000, ascent: 800, descent: 200, notdef: 500, advances: []);
    if (exact.length > 0) return exact.at(0) ?? stand;
    if (byFamily.length > 0) return byFamily.at(0) ?? stand;
    return faces.at(0) ?? stand;
}

pub fn lineHeightOf(s: Style) -> i32 {
    return if (s.lineHeight > 0) s.lineHeight else ((s.fontSize * 6 + 4) / 5);
}

// Greedy wrapping at spaces; `maxLines > 0` truncates with an ellipsis that
// fits.
pub fn wrapText(text: string, widthPx: i32, m: FontMetrics, fontSize: i32, maxLines: i32) -> array<string> {
    var lines: string[] = [];
    var cur = "";
    for word in (text.split(" ").filter({ w -> w != "" })) {
        val candidate = if (cur == "") word else cur + " " + word;
        val fits = measure(m, candidate, fontSize) <= widthPx;
        if (fits || cur == "") cur = candidate else {
            lines.push(cur);
            cur = word;
        }
    }
    if (cur != "") lines.push(cur);
    val over = maxLines > 0 && lines.length > maxLines;
    if (over == false) return lines;
    val kept = lines.take(maxLines);
    var last = kept.at(maxLines - 1) ?? "";
    while (last != "" && measure(m, last + "…", fontSize) > widthPx) {
        last = last.slice(0, last.length() - 1).trimEnd();
    }
    return kept.take(maxLines - 1).append([last + "…"]);
}

fn allText(e: Element) -> bool {
    return e.children.length > 0 && e.children.all({ c -> c.tag == "#text" });
}

fn textOfElement(e: Element) -> string {
    return e.children.map({ c -> c.value }).join("");
}

// `value` against `whole`: `50%` of it, a px length, or `fallback`.
fn lengthOf(value: string, whole: i32, fallback: i32) -> i32 {
    if (value == "") return fallback;
    if (value.endsWith("%"))
        return ((whole * pxOf(value.slice(0, value.length() - 1))) / 100);
    val n = pxOf(value);
    return if (n == -2147483648) fallback else n;
}

// Padding as top, right, bottom, left.
pub fn paddingOf(s: Style) -> #(i32, i32, i32, i32) {
    val parts = s.padding
        .split(" ")
        .filter({ p -> p != "" })
        .map({ p -> pxOf(p) })
        .map({ n -> if (n == -2147483648) 0 else n });
    if (parts.length == 0) return #(0, 0, 0, 0);
    val a = parts.at(0) ?? 0;
    val b = parts.at(1) ?? a;
    val c = parts.at(2) ?? a;
    val d = parts.at(3) ?? b;
    return #(a, b, c, d);
}

fn isAbsolute(s: Style) -> bool {
    return s.position == "absolute";
}

fn styled(parent: Style, e: Element) -> Style {
    return inherit(parent, styleOfElement(e), attrOf(e, "style"));
}

// The size an element asks for inside `availW` × `availH`.
pub fn intrinsic(e: Element, s: Style, availW: i32, availH: i32, faces: array<FontMetrics>) -> #(i32, i32) {
    val pad = paddingOf(s);
    val padW = pad._1 + pad._3;
    val padH = pad._0 + pad._2;
    if (allText(e)) {
        val face = faceFor(faces, s.fontFamily, s.fontWeight);
        val limit = lengthOf(s.width, availW, availW) - padW;
        val lines = wrapText(textOfElement(e), limit, face, s.fontSize, s.maxLines);
        var widest = 0;
        for l in lines {
            val w = measure(face, l, s.fontSize);
            if (w > widest) widest = w;
        }
        return #(lengthOf(s.width, availW, widest
            + padW), lengthOf(s.height, availH, lines.length * lineHeightOf(s)
            + padH));
    }
    val flow = e.children.filter({ c -> isAbsolute(styleOfElement(c)) == false });
    val sizes: array<#(i32, i32)> = flow.map({ c -> intrinsic(c, styled(s, c), availW - padW, availH - padH, faces) });
    val gaps = if (sizes.length > 1) s.gap * (sizes.length - 1) else 0;
    val row = s.flexDirection != "column";
    var sumW = 0;
    var sumH = 0;
    var maxW = 0;
    var maxH = 0;
    for z in sizes {
        sumW = sumW + z._0;
        sumH = sumH + z._1;
        if (z._0 > maxW) maxW = z._0;
        if (z._1 > maxH) maxH = z._1;
    }
    val w = if (row) sumW + gaps + padW else maxW + padW;
    val h = if (row) maxH + padH else sumH + gaps + padH;
    return #(lengthOf(s.width, availW, w), lengthOf(s.height, availH, h));
}

// Places `e` (styled `s`) in the box `x, y, w, h`.
pub fn place(e: Element, s: Style, x: i32, y: i32, w: i32, h: i32, faces: array<FontMetrics>) -> LayoutBox {
    val pad = paddingOf(s);
    val cx = x + pad._3;
    val cy = y + pad._0;
    val cw = w - pad._1 - pad._3;
    val ch = h - pad._0 - pad._2;
    if (allText(e)) {
        val face = faceFor(faces, s.fontFamily, s.fontWeight);
        return LayoutBox(tag: e.tag, x: x, y: y, width: w, height: h, style: s, text: textOfElement(e), lines: wrapText(textOfElement(e), cw, face, s.fontSize, s.maxLines), children: []);
    }
    val flow = e.children.filter({ c -> isAbsolute(styleOfElement(c)) == false });
    val row = s.flexDirection != "column";
    val sizes: array<#(i32, i32)> = flow.map({ c -> intrinsic(c, styled(s, c), cw, ch, faces) });
    var used = 0;
    for z in sizes {
        val main = if (row) z._0 else z._1;
        used = used + main;
    }
    val n = sizes.length;
    val main = if (row) cw else ch;
    val gaps = if (n > 1) s.gap * (n - 1) else 0;
    val free = main - used - gaps;
    val between = s.justifyContent == "space-between" && n > 1;
    val step = if (between) s.gap + (free / (n - 1)) else s.gap;
    val start = if (s.justifyContent == "center")
        (free / 2)
    else if (s.justifyContent == "flex-end")
        free
    else
        0;
    var offset = start;
    var boxes: array<LayoutBox> = [];
    var i = 0;
    for c in flow {
        val z = sizes.at(i) ?? #(0, 0);
        val cs = styled(s, c);
        val cross = if (row) ch else cw;
        val own = if (row) z._1 else z._0;
        val crossSize = if (row) cs.height else cs.width;
        val stretch = s.alignItems == "stretch"
            && allText(c) == false
            && crossSize == "";
        val size = if (stretch) cross else own;
        val crossAt = if (s.alignItems == "center")
            ((cross - size) / 2)
        else if (s.alignItems == "flex-end")
            cross - size
        else
            0;
        val bx = if (row) cx + offset else cx + crossAt;
        val by = if (row) cy + crossAt else cy + offset;
        val bw = if (row) z._0 else size;
        val bh = if (row) size else z._1;
        boxes.push(place(c, cs, bx, by, bw, bh, faces));
        val advance = if (row) z._0 else z._1;
        offset = offset + advance + step;
        i = i + 1;
    }
    for c in (e.children.filter({ c -> isAbsolute(styleOfElement(c)) })) {
        val cs = styled(s, c);
        val z = intrinsic(c, cs, cw, ch, faces);
        boxes.push(place(c, cs, x + lengthOf(cs.left, w, 0), y
            + lengthOf(cs.top, h, 0), z._0, z._1, faces));
    }
    return LayoutBox(tag: e.tag, x: x, y: y, width: w, height: h, style: s, text: "", lines: [], children: boxes);
}

// The card's box tree: the root fills the image.
pub fn layout(tree: Element, size: ImageSize, faces: array<FontMetrics>) -> LayoutBox {
    val s = styled(rootStyle(), tree);
    return place(tree, s, 0, 0, size.width, size.height, faces);
}

pub fn describeLayout(b: LayoutBox, depth: i32) -> string {
    val lead = "  ".repeat(depth);
    val lines = if (b.lines.length > 0)
        "   lines: " + b.lines.join(" / ")
    else
        "";
    val head = lead
        + b.tag.padEnd(5, " ")
        + "x="
        + b.x.toString().padEnd(5, " ")
        + "y="
        + b.y.toString().padEnd(5, " ")
        + "w="
        + b.width.toString().padEnd(6, " ")
        + "h="
        + b.height.toString()
        + lines;
    return [head]
        .append(b.children.map({ c -> describeLayout(c, depth + 1) }))
        .join("\n");
}
