//// rakun-ssr — the route surface and the cache key (front 70 steps 1 and 7).
////
//// An image route answers an `ImageResponse`: the tree, the size, the
//// content type and the faces its text uses — never bytes (there is no type
//// they could have: the rasterizer writes a file and the HTTP layer streams
//// it). `size` / `contentType` default to 1200×630 and `image/png`
//// (`NEXTJS-DOCS.md § 18`). They are functions a route exports (`pub fn
//// size()`), the answer front 32's `metadata` gives too.
////
//// A card is rendered once: its key is the content hash of the route
//// pattern, the params, the SVG document, the face set and the size — hashing
//// the SVG means a template change invalidates the card with no version bump.

import {hash, io.fs} from "std";
import {Element} from "rakun-bpp";
import {og.layout.ImageSize};
import {og.svg.FontRef};

pub type ImageResponse(tree: Element, size: ImageSize, contentType: string, fonts: Array<FontRef>)

pub fn defaultSize() -> ImageSize {
    return ImageSize(width: 1200, height: 630);
}

pub fn defaultContentType() -> string {
    return "image/png";
}

pub fn imageResponse(tree: Element, size: ImageSize) -> ImageResponse {
    return ImageResponse(tree: tree, size: size, contentType: defaultContentType(), fonts: []);
}

pub fn withFonts(r: ImageResponse, fonts: Array<FontRef>) -> ImageResponse {
    return ImageResponse(tree: r.tree, size: r.size, contentType: r.contentType, fonts: fonts);
}

pub fn withContentType(r: ImageResponse, contentType: string) -> ImageResponse {
    return ImageResponse(tree: r.tree, size: r.size, contentType: contentType, fonts: r.fonts);
}

fn hasText(e: Element) -> bool {
    if (e.tag == "#text" && e.value != "") return true;
    return e.children.any({ c -> hasText(c) });
}

// The build's problems with a route's response: text with no face, a face
// with no metrics sidecar.
pub fn checkResponse(route: string, r: ImageResponse) -> Array<string> {
    var out: string[] = [];
    val textless = r.fonts.length == 0 && hasText(r.tree);
    if (textless) out.push("route " + route + " draws text and names no font");
    for (r.fonts) { f ->
        if (fs.exists(f.metricsPath) == false)
            out.push("route "
                + route
                + ": face "
                + f.family
                + " "
                + f.weight.toString()
                + " has no metrics sidecar at "
                + f.metricsPath);
    }
    return out;
}

pub fn cardKey(pattern: string, params: Array<#(string, string)>, svg: string, fonts: Array<FontRef>, size: ImageSize) -> string {
    val material = [pattern, params
        .map({ p -> p._0 + "=" + p._1 })
        .join("&"), fonts
        .map({ f -> f.family + "/" + f.weight.toString() + "/" + f.path })
        .join(","), size.width.toString()
        + "x"
        + size.height.toString(), svg].join("\n");
    return hash.contentHash(material).padStart(8, "0")
        + hash.contentHash(svg).padStart(8, "0");
}
