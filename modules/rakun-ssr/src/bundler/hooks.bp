//// rakun-ssr — the bundle's tags as rakun-bpp's `RenderHooks` (front 68).
////
//// `headScriptTags` / `scriptTags` wrapped as the two tag fields rakun-bpp's
//// render keeps; `Onze.run` (front 49's `bootSite`) installs them. rakun-bpp
//// writes the strings without knowing where they came from, and its payload
//// script stays its own, before them.

import {RenderHooks} from "rakun-bpp";
import {bundler.manifest.ClientBundleManifest, bundler.manifest.ChunkRef, bundler.manifest.headScriptTags, bundler.manifest.scriptTags};

pub fn bundleRenderHooks(m: ClientBundleManifest) -> RenderHooks {
    return RenderHooks(headExtra: { route -> headScriptTags(m) }, bodyExtra: { route -> scriptTags(m, route) });
}
