//// rakun-ssr — linking compiled JavaScript (front 68 step 4, the file
//// level).
////
//// `botopink build --target commonJS` writes one `.js` per module, requiring
//// its imports by relative path (`require("../rakun-bpp/element.js")`), and
//// ships each package's `.mjs` sidecars beside them, required the same way.
//// A browser has neither `require` nor ES-module `require`, so the chunk is
//// the `__onze_require` prelude over one factory per FILE: the closure of the
//// relative `require`s from the chunk's roots, each `.mjs` sidecar turned
//// into a factory (`export function f` → `function f` + `exports.f = f`).
////
//// The client build resolves rakun-bpp's `hooks` to its `client_runtime`
//// (rakun-bpp `client_runtime.bp`: "the substitution is the client bundler's
//// step") — `substitutions` maps a compiled path to the file that replaces it.

import {io.fs, path} from "std";
import {bundler.chunk.prelude};

// The relative specs `require("…")` names in `js`, in order.
pub fn requiresOf(js: string) -> string[] {
    var out: string[] = [];
    for (js.split("require(\"").drop(1)) { piece ->
        val close = piece.indexOf("\"");
        if (close > 0) {
            val spec = piece.slice(0, close);
            val relative = spec.startsWith("./") || spec.startsWith("../");
            if (relative && out.contains(spec) == false) out.push(spec);
        }
    }
    return out;
}

// `spec` resolved against the file `from` (both relative to the output root).
pub fn resolveFrom(fromFile: string, spec: string) -> string {
    var parts: string[] = fromFile.split("/");
    parts = parts.take(parts.length - 1);
    for (spec.split("/")) { seg ->
        if (seg == "..")
            parts = parts.take(parts.length - 1)
        else if (seg != "." && seg != "")
            parts.push(seg);
    }
    return parts.join("/");
}

// An ES-module sidecar as a CommonJS body: every `export function` /
// `export const` / `export let` / `export class` keeps its declaration and
// is added to `exports`.
pub fn esmToFactoryBody(source: string) -> string {
    var names: string[] = [];
    var lines: string[] = [];
    for (source.split("\n")) { line ->
        val forms = ["export function ", "export async function ", "export const ", "export let ", "export class "];
        var rewritten = line;
        for (forms) { f ->
            if (line.startsWith(f)) {
                rewritten = line.slice(7);
                val rest = line.slice(f.length());
                var name = "";
                var open = true;
                for (rest.split("")) { c ->
                    val word = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_$".contains(c);
                    if (open && word) name = name + c else open = false;
                }
                if (name != "") names.push(name);
            }
        }
        lines.push(rewritten);
    }
    return lines.join("\n")
        + "\n"
        + names.map({ n -> "exports." + n + " = " + n + ";" }).join("\n");
}

// The closure of relative requires from `roots` over the compiled tree at
// `outDir`, each file once, roots first. `substitutions` replace a path
// before it is read.
pub fn jsClosure(outDir: string, roots: string[], substitutions: Array<#(string, string)>) -> Result<Array<string>, string> {
    var seen: string[] = [];
    var queue: string[] = roots;
    while (queue.length > 0) {
        val file = queue.at(0) ?? "";
        queue = queue.drop(1);
        if (seen.contains(file) == false) {
            seen.push(file);
            val actual = substituted(file, substitutions);
            val text = try fs.readText(path.join([outDir, actual]));
            for (requiresOf(text)) { spec ->
                val next = resolveFrom(file, spec);
                if (seen.contains(next) == false) queue.push(next);
            }
        }
    }
    return seen;
}

fn substituted(file: string, substitutions: Array<#(string, string)>) -> string {
    val hit = substitutions.filter({ s -> s._0 == file });
    if (hit.length == 0) return file;
    val pair = hit.at(0) ?? #(file, file);
    return pair._1;
}

// One chunk of whole files: the prelude, then a factory per file keyed by its
// compiled path, `.mjs` files converted.
pub fn linkFiles(outDir: string, files: string[], substitutions: Array<#(string, string)>) -> Result<string, string> {
    var parts: string[] = [prelude()];
    for (files) { f ->
        val actual = substituted(f, substitutions);
        val raw = try fs.readText(path.join([outDir, actual]));
        val body = if (actual.endsWith(".mjs")) esmToFactoryBody(raw) else raw;
        parts.push("(globalThis.__onze_factories = globalThis.__onze_factories || {})[\""
            + f
            + "\"] = function (module, exports, require) {\n"
            + body
            + "\n};");
    }
    return parts.join("\n") + "\n";
}

// The rakun-bpp hooks substitution for a compiled tree.
pub fn clientSubstitutions() -> Array<#(string, string)> {
    return [#("rakun-bpp/hooks.js", "rakun-bpp/client_runtime.mjs")];
}

// The line that runs the entry once its chunk has loaded.
pub fn bootLine(entryFile: string) -> string {
    return "globalThis.__onze_require(\""
        + entryFile
        + "\").onzeEntryMain();\n";
}
