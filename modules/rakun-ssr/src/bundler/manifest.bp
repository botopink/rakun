//// rakun-ssr — the bundle contract (front 68 step 5).
////
//// One record and one text format, compiled for BOTH targets: the build host
//// writes `<outDir>/client-manifest.txt`, and the BEAM server reads it back on
//// every render to emit the script tags for the matched route. One parser, two
//// targets, one round-trip test.
////
////     V|1|<buildId>
////     E|entry|/_onze/static/<buildId>/entry.<hash>.js|<hash>|<bytes>
////     S|shared|/_onze/static/<buildId>/shared.<hash>.js|<hash>|<bytes>
////     C|route:/blog/[slug]|/_onze/static/<buildId>/r1.<hash>.js|<hash>|<bytes>
////     H|script:analytics|/a.js|<hash>|<bytes>
////     R|/blog/[slug]|route:/blog/[slug]
////     Y|styles|/_onze/static/<buildId>/app.<hash>.css|<hash>|<bytes>
////     P|ONZE_PUBLIC_API_URL|https%3A%2F%2Fapi.example.com
////
//// Every field is escaped — `%`, `|`, line feed and carriage return become
//// `%25`, `%7C`, `%0A`, `%0D` — and read back with std's
//// `encoding.percentDecode`, so `|` and a newline never appear inside one and
//// a URL stays readable. A line whose kind is unknown is
//// ignored — fronts 69 and 71 may add kinds without breaking a reader. A `V`
//// line with a version other than `1` is an error, not a best effort. `H`
//// records are the `beforeInteractive` script chunks (step 7), the only tags
//// `headScriptTags` emits.
////
//// The payload script (`window.__bp0 = …`) is rakun-bpp's render's and is
//// written before the bundle; nothing here formats any part of it.

import {encoding} from "std";

pub type ChunkRef(id: string, url: string, hash: string, bytes: i32)

pub type ClientBundleManifest(
    version: string,
    buildId: string,
    entry: ChunkRef,
    shared: Array<ChunkRef>,
    chunks: Array<ChunkRef>,
    routes: Array<#(string, string)>,
    styles: Array<ChunkRef>,
    publicEnv: Array<#(string, string)>,
)

pub val manifestVersion: string = "1";

pub fn emptyChunk() -> ChunkRef {
    return ChunkRef(id: "", url: "", hash: "", bytes: 0);
}

pub fn emptyManifest(buildId: string) -> ClientBundleManifest {
    return ClientBundleManifest(version: manifestVersion, buildId: buildId, entry: emptyChunk(), shared: [], chunks: [], routes: [], styles: [], publicEnv: []);
}

// The URL a static file of this build is served at.
pub fn staticUrl(buildId: string, fileName: string) -> string {
    return "/_onze/static/" + buildId + "/" + fileName;
}

// The four characters a field may not carry raw, escaped: `%` first, then
// `|`, line feed and carriage return. Decoding is std's `percentDecode`.
pub fn escapeField(s: string) -> string {
    return s
        .replaceAll("%", "%25")
        .replaceAll("|", "%7C")
        .replaceAll("\n", "%0A")
        .replaceAll("\r", "%0D");
}

fn enc(s: string) -> string {
    return escapeField(s);
}

fn chunkLine(kind: string, c: ChunkRef) -> string {
    return [kind, enc(c.id), enc(c.url), enc(c.hash), c.bytes.toString()].join("|");
}

// `id` of a script chunk: `script:<id>` for the head (H), the rest are C.
fn isHeadScript(c: ChunkRef) -> bool {
    return c.id.startsWith("script:");
}

pub fn formatManifest(m: ClientBundleManifest) -> string {
    var lines: string[] = [["V", enc(m.version), enc(m.buildId)].join("|")];
    lines.push(chunkLine("E", m.entry));
    for (m.shared) { c ->
        lines.push(chunkLine("S", c));
    }
    for (m.chunks) { c ->
        lines.push(chunkLine(if (isHeadScript(c)) "H" else "C", c));
    }
    for (m.routes) { r ->
        lines.push(["R", enc(r._0), enc(r._1)].join("|"));
    }
    for (m.styles) { c ->
        lines.push(chunkLine("Y", c));
    }
    for (m.publicEnv) { p ->
        lines.push(["P", enc(p._0), enc(p._1)].join("|"));
    }
    return lines.join("\n") + "\n";
}

fn dec(s: string) -> @Result<string, string> {
    return try encoding.percentDecode(s);
}

#[@external(
    .Node("""(Number.isInteger(Number($0)) && /^[0-9]+$/.test($0) ? Number($0) : -1)"""),
    .Erlang("""(fun(__S) -> try binary_to_integer(__S) catch _:_ -> -1 end end)($0)"""),
)]
declare fn digitsToI32(s: string) -> i32;

fn fieldAt(fields: string[], i: i32) -> string {
    return fields.at(i) ?? "";
}

fn chunkOf(line: string, fields: string[]) -> @Result<ChunkRef, string> {
    if (fields.length != 5)
        throw "client-manifest: a chunk record has 5 fields, not "
            + fields.length.toString()
            + ": "
            + line;
    val bytes = digitsToI32(fieldAt(fields, 4));
    if (bytes < 0) throw "client-manifest: bytes is not a count: " + line;
    val id = try dec(fieldAt(fields, 1));
    val url = try dec(fieldAt(fields, 2));
    val hash = try dec(fieldAt(fields, 3));
    return ChunkRef(id: id, url: url, hash: hash, bytes: bytes);
}

fn pairOf(line: string, fields: string[]) -> @Result<#(string, string), string> {
    if (fields.length != 3)
        throw "client-manifest: a pair record has 3 fields, not "
            + fields.length.toString()
            + ": "
            + line;
    val a = try dec(fieldAt(fields, 1));
    val b = try dec(fieldAt(fields, 2));
    return #(a, b);
}

// The manifest `text` holds. The first non-empty line must be `V|1|…`.
pub fn parseManifest(text: string) -> @Result<ClientBundleManifest, string> {
    var version = "";
    var buildId = "";
    var entry = emptyChunk();
    var shared: Array<ChunkRef> = [];
    var chunks: Array<ChunkRef> = [];
    var routes: Array<#(string, string)> = [];
    var styles: Array<ChunkRef> = [];
    var publicEnv: Array<#(string, string)> = [];
    for (text.split("\n")) { raw ->
        val line = raw.trimEnd();
        if (line != "") {
            val fields = line.split("|");
            val kind = fieldAt(fields, 0);
            if (version == "" && kind != "V")
                throw "client-manifest: the first record must be V, not "
                    + kind;
            if (kind == "V") {
                val v = try pairOf(line, fields);
                if (v._0 != manifestVersion)
                    throw "client-manifest version "
                        + v._0
                        + " is not supported (this reader understands "
                        + manifestVersion
                        + ")";
                version = v._0;
                buildId = v._1;
            } else if (kind == "E")
                entry = try chunkOf(line, fields)
            else if (kind == "S")
                shared.push(try chunkOf(line, fields))
            else if (kind == "C" || kind == "H")
                chunks.push(try chunkOf(line, fields))
            else if (kind == "R")
                routes.push(try pairOf(line, fields))
            else if (kind == "Y")
                styles.push(try chunkOf(line, fields))
            else if (kind == "P")
                publicEnv.push(try pairOf(line, fields));
        }
    }
    if (version == "") throw "client-manifest: no V record";
    return ClientBundleManifest(version: version, buildId: buildId, entry: entry, shared: shared, chunks: chunks, routes: routes, styles: styles, publicEnv: publicEnv);
}

// The route chunk of `route`, `emptyChunk()` when the route has none.
pub fn chunkFor(m: ClientBundleManifest, route: string) -> ChunkRef {
    val hit = m.routes.filter({ r -> r._0 == route });
    if (hit.length == 0) return emptyChunk();
    val id = (hit.at(0) ?? #("", ""))._1;
    val found = m.chunks.filter({ c -> c.id == id });
    return found.at(0) ?? emptyChunk();
}

fn deferTag(url: string) -> string {
    return "<script src=\"" + url + "\" defer></script>";
}

// Group 1 of the emission order: the `beforeInteractive` script chunks,
// blocking, in `<head>` — never `defer`.
pub fn headScriptTags(m: ClientBundleManifest) -> string {
    return m.chunks
        .filter({ c -> isHeadScript(c) })
        .map({ c -> "<script src=\"" + c.url + "\"></script>" })
        .join("\n");
}

// Groups 4–6: `shared`, the route chunk for `route`, then the entry — each
// `defer`, written after rakun-bpp's payload script. A route with no chunk
// gets shared and entry, never an empty `src`.
pub fn scriptTags(m: ClientBundleManifest, route: string) -> string {
    var tags: string[] = m.shared.map({ c -> deferTag(c.url) });
    val own = chunkFor(m, route);
    if (own.url != "") tags.push(deferTag(own.url));
    if (m.entry.url != "") tags.push(deferTag(m.entry.url));
    return tags.join("\n");
}

// Two manifests are the same when their text forms are.
pub fn sameManifest(a: ClientBundleManifest, b: ClientBundleManifest) -> bool {
    return formatManifest(a) == formatManifest(b);
}
