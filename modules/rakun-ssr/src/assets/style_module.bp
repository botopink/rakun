//// rakun-ssr — CSS Modules (front 69 step 1).
////
//// A `*.module.css` file becomes a GENERATED botopink module, because the
//// compiler cannot import a `.css` file: `app/blog/blog.module.css` →
//// `.onze/styles/app_blog_blog.bp`, one accessor per class it defines. A
//// class is DEFINED when it begins a selector (`.title:hover .container`
//// defines `title`); every defined class is renamed
//// `<file>_<class>_<hash>` — `<hash>` the first six hex digits of std's
//// `contentHash` of the file — in the selectors, never inside a declaration
//// block. A class used but not defined is left as written and reported once.
//// `scopeName` is the one function that decides a scoped name, which is what
//// makes "the generated module and the rewritten CSS agree" a test.
////
//// The accessors are `pub val`s (decision 140: a module-level `pub val`
//// crosses modules on every backend). `:global(…)` is out of scope for this
//// milestone.
//// A file containing `</style` is refused — module CSS may reach a `<style>`
//// body.

import {hash} from "std";

pub type StyleModule(sourcePath: string, hash: string, names: Array<#(string, string)>, css: string, undefinedUses: Array<string>)

// Six hex digits of std's `contentHash`.
pub fn shortHash(text: string) -> string {
    return hash.contentHash(text).padStart(8, "0").slice(0, 6);
}

// The file's stem: `app/blog/blog.module.css` → `blog`.
pub fn moduleStem(sourcePath: string) -> string {
    val file = sourcePath
        .split("/")
        .at(sourcePath.split("/").length - 1) ?? sourcePath;
    return if (file.endsWith(".module.css"))
        file.slice(0, file.length() - 11)
    else
        file;
}

pub fn scopeName(sourcePath: string, className: string, hash: string) -> string {
    return moduleStem(sourcePath) + "_" + className + "_" + hash;
}

// The generated module's path: `app/blog/blog.module.css` →
// `.onze/styles/app_blog_blog.bp`.
pub fn generatedPath(outDir: string, sourcePath: string) -> string {
    val base = if (sourcePath.endsWith(".module.css"))
        sourcePath.slice(0, sourcePath.length() - 11)
    else
        sourcePath;
    return outDir
        + "/styles/"
        + base.replaceAll("/", "_").replaceAll(".", "_")
        + ".bp";
}

fn isNameChar(c: string) -> bool {
    return "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-".contains(c)
        && c != "";
}

// Every `.name` token of a selector, in order.
fn classesOfSelector(sel: string) -> string[] {
    var out: string[] = [];
    var cur = "";
    var open = false;
    for (sel.split("").append([" "])) { c ->
        if (open)
            if (isNameChar(c)) cur = cur + c else {
                if (cur != "") out.push(cur);
                cur = "";
                open = false;
            }
        if (c == ".") open = true;
    }
    return out;
}

// The selector texts of `css` — the text before each `{`, outside blocks.
fn selectorsOf(css: string) -> string[] {
    var out: string[] = [];
    var depth = 0;
    var cur = "";
    for (css.split("")) { c ->
        if (c == "{") {
            if (depth == 0) out.push(cur.trim());
            cur = "";
            depth = depth + 1;
        } else if (c == "}")
            depth = depth - 1
        else if (depth == 0)
            cur = cur + c;
    }
    return out;
}

fn definedClasses(css: string) -> string[] {
    var out: string[] = [];
    for (selectorsOf(css)) { sel ->
        for (sel.split(",")) { item ->
            val t = item.trim();
            if (t.startsWith(".")) {
                val first = classesOfSelector(t).at(0) ?? "";
                if (first != "" && out.contains(first) == false)
                    out.push(first);
            }
        }
    }
    return out;
}

fn scopedOr(names: Array<#(string, string)>, cls: string) -> string {
    val hit = names.filter({ n -> n._0 == cls });
    if (hit.length == 0) return cls;
    val pair = hit.at(0) ?? #(cls, cls);
    return pair._1;
}

fn rewriteSelector(sel: string, names: Array<#(string, string)>) -> string {
    var out = "";
    var cur = "";
    var open = false;
    for (sel.split("").append([""])) { c ->
        if (open)
            if (isNameChar(c)) cur = cur + c else {
                out = out + "." + scopedOr(names, cur);
                cur = "";
                open = false;
            }
        if (open == false) if (c == ".") open = true else out = out + c;
    }
    return out;
}

fn rewriteCss(css: string, names: Array<#(string, string)>) -> string {
    var out = "";
    var depth = 0;
    var cur = "";
    for (css.split("")) { c ->
        if (depth == 0 && c != "{") cur = cur + c else if (c == "{") {
            if (depth == 0) {
                out = out + rewriteSelector(cur, names);
                cur = "";
            }
            out = out + c;
            depth = depth + 1;
        } else {
            if (c == "}") depth = depth - 1;
            out = out + c;
        }
    }
    return out + cur;
}

fn sortedNames(names: string[]) -> string[] {
    var out: string[] = [];
    for (names) { n ->
        var placed = false;
        var next: string[] = [];
        for (out) { m ->
            val before = placed == false && n < m;
            if (before) {
                next.push(n);
                placed = true;
            }
            next.push(m);
        }
        if (placed == false) next.push(n);
        out = next;
    }
    return out;
}

pub fn compileStyleModule(sourcePath: string, source: string) -> @Result<StyleModule, string> {
    if (source.toLower().contains("</style"))
        throw sourcePath
            + ": contains \"</style\", which would end the <style> element it is written into";
    val h = shortHash(source);
    val defined = definedClasses(source);
    val names = sortedNames(defined).map({ c -> #(c, scopeName(sourcePath, c, h)) });
    var used: string[] = [];
    for (selectorsOf(source)) { sel ->
        for (classesOfSelector(sel)) { c ->
            val fresh = defined.contains(c) == false
                && used.contains(c) == false;
            if (fresh) used.push(c);
        }
    }
    return StyleModule(sourcePath: sourcePath, hash: h, names: names, css: rewriteCss(source, names), undefinedUses: used);
}

// The generated botopink module: one accessor per defined class, sorted.
pub fn generateStyleModuleSource(m: StyleModule) -> string {
    var lines: string[] = ["// generated from "
        + m.sourcePath
        + " by rakun-ssr build — do not edit"];
    for (m.names) { n ->
        lines.push("");
        lines.push("pub val "
            + n._0.replaceAll("-", "_")
            + ": string = \""
            + n._1
            + "\";");
    }
    return lines.join("\n") + "\n";
}

pub fn reportOf(m: StyleModule) -> string[] {
    return m.undefinedUses.map({ c -> m.sourcePath + ": class \"" + c + "\" is used but not defined; left unscoped" });
}
