//// rakun-ssr — `Image` (front 51 steps 1–3): the props, the source rules
//// and the component.
////
//// The component validates its `src` — a `/`-rooted path must stay inside
//// `publicDir` after normalization; an absolute URL must match the remote
//// allowlist, which is EMPTY by default; a relative path, a `data:` or a
//// `file:` URL is refused — then renders an `<img>` whose URLs go through the
//// `/_onze/image` handler, a `srcset` (one candidate per device width up to the
//// declared width with `sizes`, every device width with `fill`, the 1× and 2×
//// pair otherwise — each snapped to a configured width, the only widths the
//// handler serves), the box reserved
//// by `width`/`height` or, with `fill`, by a style, and the loading policy
//// (`priority` → eager + high priority; otherwise lazy + async decoding).
//// A refused source renders nothing and is reported — never fetched
//// unoptimized. The allowlist is a control: `hostname: "*"` is refused at
//// config load, `*.example.com` matches exactly one label.

import {Element, img} from "rakun-bpp";
import {path, encoding, compiler} from "std";

pub type ImageProps(
    src: string,
    alt: string,
    width: i32,
    height: i32,
    fill: bool,
    sizes: string,
    priority: bool,
    quality: i32,
    placeholder: string,
    blurDataURL: string,
    loading: string,
)

pub fn defaultImageProps(src: string, alt: string, width: i32, height: i32) -> ImageProps {
    return ImageProps(src: src, alt: alt, width: width, height: height, fill: false, sizes: "", priority: false, quality: 75, placeholder: "empty", blurDataURL: "", loading: "");
}

pub type RemotePattern(protocol: string, hostname: string, pathPrefix: string, port: string)

pub type ImageConfig(
    remotePatterns: array<RemotePattern>,
    formats: array<string>,
    deviceWidths: array<i32>,
    encoder: string,
    encoderTimeoutMs: i32,
)

pub fn defaultImageConfig() -> ImageConfig {
    return ImageConfig(remotePatterns: [], formats: ["image/webp"], deviceWidths: [640, 750, 828, 1080, 1200, 1920, 2048, 3840], encoder: "vips", encoderTimeoutMs: 5000);
}

// The configuration's own problems, at load: a `*` host, an unknown format.
pub fn validateConfig(cfg: ImageConfig) -> array<string> {
    var out: string[] = [];
    for (cfg.remotePatterns) { p ->
        if (p.hostname == "*" || p.hostname == "")
            out.push("images: remotePatterns hostname \""
                + p.hostname
                + "\" would allow any host — name the host");
        val proto = p.protocol == "https" || p.protocol == "http";
        if (proto == false)
            out.push("images: remotePatterns protocol \""
                + p.protocol
                + "\" is not https or http");
    }
    for (cfg.formats) { f ->
        val known = f == "image/webp" || f == "image/avif";
        if (known == false)
            out.push("images: format \""
                + f
                + "\" is not image/webp or image/avif");
    }
    return out;
}

// The problems of a props record; `[]` when it renders.
pub fn validateProps(p: ImageProps) -> array<string> {
    var out: string[] = [];
    if (p.quality < 1 || p.quality > 100)
        out.push("Image "
            + p.src
            + ": quality "
            + p.quality.toString()
            + " is outside 1..100");
    val blurless = p.placeholder == "blur" && p.blurDataURL == "";
    if (blurless)
        out.push("Image "
            + p.src
            + ": placeholder \"blur\" needs a blurDataURL");
    val both = p.fill && (p.width != 0 || p.height != 0);
    if (both)
        out.push("Image " + p.src + ": fill and width/height are exclusive");
    val eagerLazy = p.priority && p.loading == "lazy";
    if (eagerLazy)
        out.push("Image " + p.src + ": priority with loading \"lazy\"");
    return out;
}

// Collapses `.` and `..`; `null` when `..` climbs above the root.
pub fn normalizeUrlPath(p: string) -> ?string {
    var parts: string[] = [];
    var escaped = false;
    for (p.split("/")) { seg ->
        if (seg == "..") {
            if (parts.length == 0)
                escaped = true
            else
                parts = parts.take(parts.length - 1);
        } else if (seg != "." && seg != "") parts.push(seg);
    }
    if (escaped) return null;
    return "/" + parts.join("/");
}

fn hostMatches(pattern: string, host: string) -> bool {
    if (pattern.startsWith("*.") == false) return pattern == host;
    val suffix = pattern.slice(1);
    if (host.endsWith(suffix) == false) return false;
    val label = host.slice(0, host.length() - suffix.length());
    return label != "" && label.contains(".") == false;
}

// `protocol://host[:port]/path` split, `null` when it is not one.
fn splitUrl(src: string) -> ?#(string, string, string, string) {
    val sep = src.indexOf("://");
    if (sep <= 0) return null;
    val protocol = src.slice(0, sep);
    val rest = src.slice(sep + 3, src.length());
    val slash = rest.indexOf("/");
    val authority = if (slash < 0) rest else rest.slice(0, slash);
    val pathPart = if (slash < 0) "/" else rest.slice(slash, rest.length());
    val colon = authority.indexOf(":");
    val host = if (colon < 0) authority else authority.slice(0, colon);
    val port = if (colon < 0)
        ""
    else
        authority.slice(colon + 1, authority.length());
    return #(protocol, host, port, pathPart.split("?").at(0) ?? pathPart);
}

// The accepted source, or the refusal naming it.
pub fn validateSource(cfg: ImageConfig, publicDir: string, src: string) -> Result<string, string> {
    if (src.startsWith("data:") || src.startsWith("file:"))
        throw "Image: "
            + src.slice(0, 5)
            + " sources are refused ("
            + src.slice(0, 24)
            + "…)";
    if (src.startsWith("/")) {
        val norm = normalizeUrlPath(src);
        if (norm == null) throw "Image: " + src + " escapes " + publicDir;
        return norm;
    }
    val parts = splitUrl(src);
    if (parts == null)
        throw "Image: "
            + src
            + " is neither a /-rooted public path nor an absolute URL";
    val none: #(string, string, string, string) = #("", "", "", "");
    val u = parts;
    val cleanPath = normalizeUrlPath(u._3);
    if (cleanPath == null) throw "Image: " + src + " escapes its host's root";
    val clean = cleanPath;
    val ok = cfg.remotePatterns.any({ p -> p.protocol == u._0 && hostMatches(p.hostname, u._1) && p.port == u._2 && clean.startsWith(p.pathPrefix) });
    val portSuffix = if (u._2 == "") "" else ":" + u._2;
    if (ok == false)
        throw "Image: host "
            + u._1
            + portSuffix
            + " not in remotePatterns ("
            + src
            + ")";
    return u._0 + "://" + u._1 + portSuffix + clean;
}

// The handler URL for one width.
pub fn optimizedUrl(src: string, width: i32, quality: i32, format: string) -> string {
    return "/_onze/image?"
        + encoding.formStringify([#("src", src), #("w", width.toString()), #("q", quality.toString()), #("f", format)]);
}

// The configured width the handler serves for `w`: the smallest device width
// at least `w`, else the largest — the handler refuses any other.
pub fn servedWidth(cfg: ImageConfig, w: i32) -> i32 {
    val atLeast = cfg.deviceWidths.filter({ d -> d >= w });
    val largest = cfg.deviceWidths.at(cfg.deviceWidths.length - 1) ?? w;
    return atLeast.at(0) ?? largest;
}

fn widthsFor(cfg: ImageConfig, p: ImageProps) -> array<i32> {
    if (p.fill) return cfg.deviceWidths;
    val within = cfg.deviceWidths.filter({ w -> w <= p.width });
    return if (within.length == 0) [servedWidth(cfg, p.width)] else within;
}

// The `srcset`: one candidate per device width up to `width` with `sizes`,
// the 1× and 2× pair without.
pub fn srcsetOf(cfg: ImageConfig, p: ImageProps, src: string) -> string {
    val format = cfg.formats.at(0) ?? "image/webp";
    val responsive = p.sizes != "" || p.fill;
    if (responsive)
        return widthsFor(cfg, p)
            .map({ w -> optimizedUrl(src, w, p.quality, format) + " " + w.toString() + "w" })
            .join(", ");
    return optimizedUrl(src, servedWidth(cfg, p.width), p.quality, format)
        + " 1x, "
        + optimizedUrl(src, servedWidth(cfg, p.width * 2), p.quality, format)
        + " 2x";
}

#[compiler.external(
    .JavaScript("""((globalThis.__onzeRefusedImages = (globalThis.__onzeRefusedImages || []).concat([$0])), 0)"""),
    .Erlang("""(fun(__E) -> put(onze_refused_images, (case get(onze_refused_images) of undefined -> []; __L -> __L end) ++ [__E]), 0 end)($0)"""),
)]
declare fn reportRefused(message: string) -> i32;

#[compiler.external(
    .JavaScript("""(globalThis.__onzeRefusedImages || [])"""),
    .Erlang("""(fun() -> case get(onze_refused_images) of undefined -> []; __L -> __L end end)()"""),
)]
declare fn refusedImagesCell() -> array<string>;

// What this render refused (a render reads it to report the URLs).
pub fn refusedImages() -> array<string> {
    return refusedImagesCell();
}

fn nothing() -> Element {
    return Element(tag: "#fragment", value: "", children: [], attrs: []);
}

fn sourceError(r: Result<string, string>) -> string {
    return case r {
        Ok(v) -> "";
        Error(e) -> e;
    };
}

pub fn Image(p: ImageProps, cfg: ImageConfig, publicDir: string) -> Element {
    val problems = validateProps(p);
    if (problems.length > 0) {
        reportRefused(problems.join("; "));
        return nothing();
    }
    val checked = validateSource(cfg, publicDir, p.src);
    if (checked.isError()) {
        reportRefused(sourceError(checked));
        return nothing();
    }
    val src = checked.unwrapOr(p.src);
    val format = cfg.formats.at(0) ?? "image/webp";
    val mainWidth = if (p.fill)
        servedWidth(cfg, 1920)
    else
        servedWidth(cfg, p.width);
    val main = optimizedUrl(src, mainWidth, p.quality, format);
    val blur = p.placeholder == "blur";
    var attrs: array<#(string, string)> = [#("alt", p.alt)];
    if (blur) {
        attrs.push(#("src", p.blurDataURL));
        attrs.push(#("data-src", main));
    } else attrs.push(#("src", main));
    attrs.push(#("srcset", srcsetOf(cfg, p, src)));
    if (p.sizes != "") attrs.push(#("sizes", p.sizes));
    if (p.fill)
        attrs.push(#("style", "position:absolute;inset:0;width:100%;height:100%;object-fit:cover"))
    else {
        attrs.push(#("width", p.width.toString()));
        attrs.push(#("height", p.height.toString()));
    }
    val eager = p.priority || p.loading == "eager";
    attrs.push(#("loading", if (eager) "eager" else "lazy"));
    attrs.push(#("decoding", if (eager) "sync" else "async"));
    if (p.priority) attrs.push(#("fetchpriority", "high"));
    return img([], attrs: attrs);
}
