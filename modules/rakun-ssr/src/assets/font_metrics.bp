//// rakun-ssr — the committed font-metrics table (front 52 step 2).
////
//// Family → `FontMetrics(unitsPerEm, ascent, descent, lineGap,
//// avgCharWidth)` and the local face its adjusted fallback uses. Reading a
//// binary font is not something botopink does (no byte type), so the table
//// is data, the way `next/font` ships it.
////
//// PROVENANCE — read before extending: the rows below were TRANSCRIBED
//// (unitsPerEm / hhea ascender / descender / lineGap from the published
//// families; `avgCharWidth` the capsize-style average advance), not generated
//// on this machine: the generator — `fontTools` over each family's `.woff2`,
//// writing this file — is owed (`specs/1.0.10-beta/06-onze/52-onze-font/`
//// § Where it stands). Until it runs, treat a row as a measurement to be
//// re-derived, and add no row by hand. Transcribed 2026-09-26.

pub type FontMetrics(
    unitsPerEm: i32,
    ascent: i32,
    descent: i32,
    lineGap: i32,
    avgCharWidth: i32,
)

pub type MetricsRow(family: string, category: string, metrics: FontMetrics, localFallback: string)

pub fn metricsTable() -> array<MetricsRow> {
    return [
        MetricsRow(family: "Arial", category: "sans-serif", metrics: FontMetrics(unitsPerEm: 2048, ascent: 1854, descent: 434, lineGap: 67, avgCharWidth: 904), localFallback: "Arial"),
        MetricsRow(family: "Times New Roman", category: "serif", metrics: FontMetrics(unitsPerEm: 2048, ascent: 1825, descent: 443, lineGap: 87, avgCharWidth: 819), localFallback: "Times New Roman"),
        MetricsRow(family: "Inter", category: "sans-serif", metrics: FontMetrics(unitsPerEm: 2816, ascent: 2728, descent: 680, lineGap: 0, avgCharWidth: 1330), localFallback: "Arial"),
        MetricsRow(family: "Roboto", category: "sans-serif", metrics: FontMetrics(unitsPerEm: 2048, ascent: 1900, descent: 500, lineGap: 0, avgCharWidth: 911), localFallback: "Arial"),
        MetricsRow(family: "Merriweather", category: "serif", metrics: FontMetrics(unitsPerEm: 2000, ascent: 1968, descent: 546, lineGap: 0, avgCharWidth: 1010), localFallback: "Times New Roman"),
    ];
}

pub fn metricsOf(family: string) -> ?MetricsRow {
    val hit = metricsTable().filter({ r -> r.family == family });
    if (hit.length == 0) return null;
    return hit.at(0) ?? MetricsRow(family: "", category: "", metrics: FontMetrics(unitsPerEm: 1, ascent: 0, descent: 0, lineGap: 0, avgCharWidth: 0), localFallback: "");
}

// The sidecar front 70 reads beside a face: one `key value` line each.
pub fn metricsSidecar(m: FontMetrics) -> string {
    return ["unitsPerEm " + m.unitsPerEm.toString(), "ascent "
        + m.ascent.toString(), "descent " + m.descent.toString(), "lineGap "
        + m.lineGap.toString(), "avgCharWidth "
        + m.avgCharWidth.toString()].join("\n")
        + "\n";
}
