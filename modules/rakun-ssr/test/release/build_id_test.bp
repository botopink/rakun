// `botopink test` suite for `src/spec.bp` (front 71 step 1) — both rows.

import {release.spec.ReleaseSpec, release.spec.releaseSpec, release.spec.generateBuildId, release.spec.validateBuildId, release.spec.verifyBuildId};
import {assertAs} from "snap";
import {compiler} from "std";

fn shown(problems: Array<string>) -> string {
    return if (problems.length == 0) "ok" else "error: " + problems.join("; ");
}

test "release: build id ---- derived once, sort-independent, sensitive" {
    val a = generateBuildId(["4f21ab", "7e0055", "9c1d40"], "41ab08");
    val b = generateBuildId(["9c1d40", "4f21ab", "7e0055"], "41ab08");
    val c = generateBuildId(["4f21ab", "7e0055", "9c1d41"], "41ab08");
    assert a == b;
    assert a != c;
    assert validateBuildId(a).length == 0;
    val spec = releaseSpec("blog", "0.1.0", a);
    try assertAs(comptime compiler.src(), "build id", [
        "generateBuildId([4f21ab, 7e0055, 9c1d40], 41ab08) = " + a,
        "generateBuildId([9c1d40, 4f21ab, 7e0055], 41ab08) = " + b,
        "generateBuildId([4f21ab, 7e0055, 9c1d41], 41ab08) = " + c,
        "validateBuildId(\"\")          " + shown(validateBuildId("")),
        "validateBuildId(\"has/slash\") " + shown(validateBuildId("has/slash")),
        "validateBuildId(65 chars)    "
            + shown(validateBuildId("a".repeat(65))),
        "verifyBuildId("
            + a
            + ", "
            + a
            + ", "
            + a
            + ") "
            + shown(verifyBuildId(spec, a, a)),
        "verifyBuildId("
            + a
            + ", "
            + a
            + ", stale)  "
            + shown(verifyBuildId(spec, a, "stale")),
        "verifyBuildId("
            + a
            + ", other, "
            + a
            + ")  "
            + shown(verifyBuildId(spec, "other", a)),
    ].join("\n"));
}
