botopink-snap 1
test: release: dockerfile ---- two stages, non-root, erts bundled and not
subject: dockerfile

== includeErts: true
FROM erlang:28-alpine AS build
WORKDIR /src
COPY . .
RUN rakun-ssr build

FROM alpine:3.20 AS runner
RUN addgroup -S rakun-ssr && adduser -S -G rakun-ssr rakun-ssr
WORKDIR /app
COPY --from=build --chown=rakun-ssr:rakun-ssr /src/.onze/release ./
USER rakun-ssr
ENV PORT=3000
EXPOSE 3000
CMD ["bin/rakun-ssr", "start"]
== includeErts: false — runner line
FROM erlang:28-alpine AS runner
== .dockerignore
.git
.onze
.botopinkbuild
test/
