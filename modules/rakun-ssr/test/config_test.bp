// `botopink test` suite for `src/config.bp` (front 49 steps 2 and 7). Imports
// only std and the package's own modules, so a red here is rakun-ssr's.

import {config.OnzeConfig, config.defaultConfig, config.withPort, config.withDev, config.loadConfig, config.describeConfig, config.publicEnvPrefix, config.isPublicEnvName, config.publicEnvFrom, config.describePublicEnv, config.defaultActionField, config.defaultActionHeader, config.defaultActionsBodyLimit, config.parsePort};
import {assertAs} from "snap";
import {compiler} from "std";

fn lookupIn(pairs: array<#(string, string)>, name: string) -> ?string {
    val hit = pairs.filter({ p -> p._0 == name });
    if (hit.length == 0) return null;
    return (hit.at(0) ?? #("", ""))._1;
}

fn errorOf(r: Result<OnzeConfig, string>) -> string {
    return case r {
        Ok(v) -> "ok";
        Error(message) -> message;
    };
}

test "config: the defaults are the values the scaffold writes" {
    val c = defaultConfig();
    assert c.port == 3000;
    assert c.basePath == "";
    assert c.appDir == "app";
    assert c.publicDir == "public";
    assert c.outDir == ".onze";
    assert c.dev == false;
    assert c.actionsBodyLimit == 1048576;
    assert c.allowedRedirects.length == 0;
}

test "config: withPort copies every other field" {
    val c = withPort(defaultConfig(), 4000);
    assert c.appDir == defaultConfig().appDir;
    assert c.outDir == ".onze";
    assert c.actionsBodyLimit == defaultActionsBodyLimit;
    assert c.origin() == "http://localhost:4000";
    assert withDev(c, true).port == 4000;
    assert withDev(c, true).dev;
}

test "config: defaults ---- every field rakun-ssr.json may omit" {
    val c = try loadConfig("{ \"name\": \"fixture\" }", "{}");
    try assertAs(comptime compiler.src(), "config", describeConfig(c));
}

test "config: override ---- port from rakun-ssr.json and basePath through" {
    val c = try loadConfig("{ \"name\": \"docs\" }", "{ \"port\": 4000, \"basePath\": \"/docs\", \"appDir\": \"src/app\", \"allowedRedirects\": [\"https://auth.example.com\"] }");
    try assertAs(comptime compiler.src(), "config", describeConfig(c));
}

test "config: refusals ---- every malformed rakun-ssr.json names its key" {
    val cases = [
        "{ \"prot\": 4000 }",
        "{ \"port\": \"4000\" }",
        "{ \"port\": 70000 }",
        "{ \"port\": 40.5 }",
        "{ \"dev\": 1 }",
        "{ \"allowedRedirects\": [1] }",
        "{ \"port\": 1, \"port\": 2 }",
        "[]",
    ];
    val out = cases.map({ text -> text + "\n  " + errorOf(loadConfig("{ \"name\": \"x\" }", text)) });
    try assertAs(comptime compiler.src(), "errors", out.join("\n"));
}

test "config: the action wire names are rakun-ssr's defaults" {
    assert defaultActionField == "__bp_action";
    assert defaultActionHeader == "X-Bp-Action";
}

test "env: the prefix is case-sensitive" {
    assert publicEnvPrefix == "ONZE_PUBLIC_";
    assert isPublicEnvName("ONZE_PUBLIC_API_URL");
    assert isPublicEnvName("DATABASE_URL") == false;
    assert isPublicEnvName("onze_public_x") == false;
    assert isPublicEnvName("Onze_Public_Secret") == false;
    assert isPublicEnvName("ONZE_PUBLIC_") == false;
}

test "env: publicEnv never returns a non-public name" {
    val env = [#("ONZE_PUBLIC_A", "a"), #("SECRET_B", "b")];
    val got = publicEnvFrom(["ONZE_PUBLIC_A", "SECRET_B"], { n -> lookupIn(env, n) });
    assert got.length == 1;
    assert (got.at(0) ?? #("", ""))._0 == "ONZE_PUBLIC_A";
    assert (got.at(0) ?? #("", ""))._1 == "a";
}

test "env: public prefix ---- case-sensitive filter" {
    val env = [
        #("ONZE_PUBLIC_API_URL", "https://api.example.com"),
        #("onze_public_x", "leak"),
        #("Onze_Public_Secret", "leak"),
        #("DATABASE_URL", "postgres://db"),
    ];
    try assertAs(comptime compiler.src(), "env", describePublicEnv(env, ["ONZE_PUBLIC_API_URL", "onze_public_x", "Onze_Public_Secret", "DATABASE_URL", "ONZE_PUBLIC_MISSING"]));
}

test "config: a port given as text ---- digits in 1..65535, the source named" {
    assert parsePort("8080", "PORT").unwrapOr(0) == 8080;
    assert parsePort(" 4000 ", "-p").unwrapOr(0) == 4000;
    val refusals = ["", "80a", "-1", "0", "65536", "080"].map({ t ->
        case parsePort(t, "PORT") {
            Ok(n) -> "ok " + n.toString();
            Error(e) -> e;
        }
    });
    assert refusals.join("\n")
        == "PORT: \"\" is not a port number\nPORT: \"80a\" is not a port number\nPORT: \"-1\" is not a port number\nPORT: 0 is outside 1..65535\nPORT: 65536 is outside 1..65535\nPORT: \"080\" is not a port number";
}
