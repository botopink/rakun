// `botopink test` suite for rakun-ssr's own helpers (front 49).

import {testing.core.assertConfig, testing.core.assertAppFiles, testing.core.assertAlias, testing.core.assertPublicEnv};
import {testing.fixtures.fixtureTree};
import {compiler} from "std";

test "helpers: fixtureTree splits on == headers" {
    val f = fixtureTree("== a.bp\nline 1\nline 2\n== b/c.bp\n\n== empty");
    assert f.paths().join(",") == "a.bp,b/c.bp,empty";
    assert f.read("a.bp") == "line 1\nline 2";
    assert f.read("b/c.bp") == "";
    assert f.read("missing") == "";
}

test "config: defaults ---- every field rakun-ssr.json may omit" {
    try assertConfig(comptime compiler.src, "{ \"name\": \"fixture\" }", "{}");
}

test "config: refused ---- an unknown key names itself" {
    try assertConfig(comptime compiler.src, "{ \"name\": \"fixture\" }", "{ \"prot\": 4000 }");
}

test "types: app files ---- the group and the private folder" {
    try assertAppFiles(comptime compiler.src, ["app/(marketing)/about/page.bp", "app/_components/card.bp"]);
}

test "alias: longest prefix ---- @/lib and @/lib/db" {
    try assertAlias(comptime compiler.src, "{ \"@/lib\": \"lib\", \"@/lib/db\": \"lib/store\" }", ["@/lib.actions", "@/lib/db.posts", "rakun-bpp"]);
}

test "alias: escape ---- a target outside the root is refused at load" {
    try assertAlias(comptime compiler.src, "{ \"@/up\": \"..\", \"@/ok\": \"lib\" }", ["@/ok.x"]);
}

test "env: public prefix ---- case-sensitive filter" {
    try assertPublicEnv(comptime compiler.src, [#("ONZE_PUBLIC_API_URL", "https://api.example.com"), #("DATABASE_URL", "postgres://db")], ["ONZE_PUBLIC_API_URL", "DATABASE_URL", "ONZE_PUBLIC_MISSING"]);
}
