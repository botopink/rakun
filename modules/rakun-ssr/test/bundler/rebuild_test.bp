// `botopink test` suite for `src/rebuild.bp` (front 68 step 8), over the
// frozen fixture app and stand-in compiled sources.

import {bundler.scan.parseFixture, bundler.scan.ImportRef};
import {bundler.graph.AppModule, bundler.graph.ClientGraph, bundler.graph.GraphNode, bundler.graph.loadModules};
import {bundler.chunk.ChunkPlan};
import {bundler.refusal.BuildRefusal, bundler.refusal.BuildReport};
import {bundler.rebuild.BundleState, bundler.rebuild.BundleSetup, bundler.rebuild.RebuildResult, bundler.rebuild.initialState, bundler.rebuild.rebuild};
import {bundler.fixture.fixtureApp};
import {config.OnzeConfig, config.defaultConfig};

fn setup() -> BundleSetup {
    return BundleSetup(appDir: "app", runtime: ["jhonstart.client_runtime"], entryModule: "onze_entry", config: defaultConfig());
}

fn compiledOf(modules: array<AppModule>) -> array<#(string, string)> {
    var out: array<#(string, string)> = modules.map({ m -> #(m.id, "// " + m.id) });
    out.push(#("jhonstart.client_runtime", "// runtime"));
    out.push(#("onze_entry", "// entry"));
    return out;
}

fn noEnv(name: string) -> string {
    return "";
}

fn start() -> Result<BundleState, string> {
    val modules = try loadModules(parseFixture(fixtureApp()));
    return try initialState(setup(), modules, compiledOf(modules));
}

fn failure(r: Result<RebuildResult, string>) -> string {
    return case r {
        Ok(v) -> "ok";
        Error(e) -> e;
    };
}

test "rebuild: a body change relinks only the chunks containing the module" {
    val s = try start();
    val r = try rebuild(setup(), s, "components/like_button.bp", "import { lib.format.plural };\nimport { io.env } from \"std\";\n#[client]\npub fn LikeButton(props: LikeProps) -> Element { return button([text(\"like\")]); }", "// like v2", { n -> noEnv(n) });
    assert r.rewalked == false;
    assert r.changed.join(",") == "route:/blog/[slug]";
    assert r.steps.join(" | ")
        == "write chunk route:/blog/[slug] | write client-manifest.txt | push route:/blog/[slug]";
}

test "rebuild: an import change re-walks the graph" {
    val s = try start();
    val r = try rebuild(setup(), s, "components/like_button.bp", "#[client]\npub fn LikeButton(props: LikeProps) -> Element { return button([]); }", "// like v3", { n -> noEnv(n) });
    assert r.rewalked;
    assert r.state.graph.nodes.length == 3;
}

test "rebuild: a server-only import fails dev with the build's message" {
    val s = try start();
    val msg = failure(rebuild(setup(), s, "components/like_button.bp", "import { serverOnly } from \"rakun-bpp\";\n#[client]\npub fn LikeButton(props: LikeProps) -> Element { return button([]); }", "// x", { n -> noEnv(n) }));
    assert msg.contains("refused: server-only module components.like_button reached from client root components.like_button");
    assert msg.endsWith("build failed: 1 refusal");
}

test "rebuild: a non-public env read fails dev with the build's message" {
    val s = try start();
    val msg = failure(rebuild(setup(), s, "lib/format.bp", "import { io.env } from \"std\";\npub fn plural(n: i32, word: string) -> string { val k = env.read(\"DATABASE_URL\"); return word; }", "// x", { n -> noEnv(n) }));
    assert msg.contains("env-non-public");
    assert msg.contains("DATABASE_URL");
}

test "rebuild: an unchanged save changes nothing and pushes nothing" {
    val s = try start();
    val same = s.modules
        .filter({ m -> m.path == "lib/format.bp" })
        .at(0) ?? AppModule(id: "", path: "", source: "", refs: [], client: false);
    val r = try rebuild(setup(), s, "lib/format.bp", same.source, "// lib.format", { n -> noEnv(n) });
    assert r.changed.length == 0;
    assert r.steps.length == 0;
}
