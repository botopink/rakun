// `botopink test` suite for `src/font.bp` and `src/font_metrics.bp` (front
// 52) — both rows. The network is a fixture: a checked-in copy of the shape
// of one Google CSS response, and a download seam that writes a stand-in
// file, so the suite never reaches the network.

import {assets.font.Font, assets.font.GoogleFontOptions, assets.font.GoogleFace, assets.font.FontBuild, assets.font.LocalFontSource, assets.font.LocalFontOptions, assets.font.googleFontWith, assets.font.googleCssUrl, assets.font.parseGoogleCss, assets.font.fallbackFace, assets.font.fontHead, assets.font.localFont};
import {assets.font_metrics.FontMetrics, assets.font_metrics.MetricsRow, assets.font_metrics.metricsOf, assets.font_metrics.metricsSidecar};
import {io.fs, io.process, io.clock, path, io.env, compiler} from "std";
import {assertAs} from "snap";

// The run's own scratch directory — `botopink test` names it in
// `BOTOPINK_TEST_TMPDIR`, and it is the one place a test writes.
fn testTmp() -> string {
    val root = env.read("BOTOPINK_TEST_TMPDIR") ?? "";
    assert root
        != "", "BOTOPINK_TEST_TMPDIR is not set: run this suite under `botopink test`";
    return root;
}

fn googleCss() -> string {
    return [
        "/* cyrillic */",
        "@font-face {",
        "  font-family: 'Inter';",
        "  font-style: normal;",
        "  font-weight: 400;",
        "  font-display: swap;",
        "  src: url(https://fonts.gstatic.com/s/inter/v13/cyr400.woff2) format('woff2');",
        "  unicode-range: U+0301, U+0400-045F;",
        "}",
        "/* latin */",
        "@font-face {",
        "  font-family: 'Inter';",
        "  font-style: normal;",
        "  font-weight: 400;",
        "  font-display: swap;",
        "  src: url(https://fonts.gstatic.com/s/inter/v13/lat400.woff2) format('woff2');",
        "  unicode-range: U+0000-00FF, U+0131, U+2000-206F;",
        "}",
        "/* latin */",
        "@font-face {",
        "  font-family: 'Inter';",
        "  font-style: normal;",
        "  font-weight: 700;",
        "  font-display: swap;",
        "  src: url(https://fonts.gstatic.com/s/inter/v13/lat700.woff2) format('woff2');",
        "  unicode-range: U+0000-00FF, U+0131, U+2000-206F;",
        "}",
    ].join("\n");
}

fn fixtureCss(url: string) -> Result<string, string> {
    if (url.startsWith("https://fonts.googleapis.com/css2?family=Inter:")
        == false)
        throw "unexpected url " + url;
    return googleCss();
}

fn fixtureDownload(url: string, dest: string) -> Result<void, string> {
    val w = try fs.writeText(dest, "woff2 bytes of " + url);
    return;
}

fn scratch() -> string {
    val dir = path.join([testTmp(), "font-" + clock.nowMillis().toString()]);
    val made = process.run("mkdir", ["-p", dir]);
    return dir;
}

fn build(dir: string) -> FontBuild {
    return FontBuild(buildId: "b7f2a1", outDir: dir, fetchCss: { url -> fixtureCss(url) }, download: { url, dest -> fixtureDownload(url, dest) });
}

fn interOpts() -> GoogleFontOptions {
    return GoogleFontOptions(weights: ["400", "700"], styles: ["normal"], subsets: ["latin"], display: "swap", preload: true, variable: "--font-inter", fallback: ["system-ui", "sans-serif"], adjustFontFallback: true);
}

fn errorOf(r: Result<Font, string>) -> string {
    return case r {
        Ok(f) -> "ok";
        Error(e) -> "error: " + e;
    };
}

fn noProbe(file: string) -> ?FontMetrics {
    return null;
}

#[compiler.external(
    .JavaScript("""((globalThis.__onzeFontLog = (globalThis.__onzeFontLog || []).concat([$0])), 0)"""),
    .Erlang("""(fun(__E) -> put(onze_font_log, (case get(onze_font_log) of undefined -> []; __L -> __L end) ++ [__E]), 0 end)($0)"""),
)]
declare fn logLine(line: string) -> i32;

#[compiler.external(
    .JavaScript("""(globalThis.__onzeFontLog || [])"""),
    .Erlang("""(fun() -> case get(onze_font_log) of undefined -> []; __L -> __L end end)()"""),
)]
declare fn logged() -> Array<string>;

test "font: google ---- Inter 400 and 700, latin, swap, adjusted" {
    val dir = scratch();
    val f = try googleFontWith("Inter", interOpts(), build(dir));
    val all = [f.css, f.preload, f.style].join("\n");
    assert all.contains("fonts.googleapis.com") == false;
    assert all.contains("fonts.gstatic.com") == false;
    assert f.css.split("@font-face{font-family:\"Inter\";").length == 3;
    val sidecars = fs
        .list(path.join([dir, "static", "b7f2a1", "fonts"]))
        .unwrapOr([])
        .filter({ n -> n.endsWith(".metrics.txt") });
    assert sidecars.length == 2;
    try assertAs(comptime compiler.src(), "font", ["== family / className / variable", f.family
        + " / "
        + f.className
        + " / "
        + f.variable, "== css", f.css, "== style", f.style, "== preload", f.preload].join("\n"));
    val gone = process.run("rm", ["-rf", dir]);
}

test "font: head ---- preload before faces, one face per family and weight" {
    val dir = scratch();
    val a = try googleFontWith("Inter", interOpts(), build(dir));
    val b = try googleFontWith("Inter", interOpts(), build(dir));
    val head = fontHead([a, b]);
    assert head.indexOf("<link rel=\"preload\"") < head.indexOf("<style>");
    assert head.split("@font-face").length - 1 == 3;
    try assertAs(comptime compiler.src(), "head", head);
    val gone = process.run("rm", ["-rf", dir]);
}

test "font: refusals ---- empty subsets, unknown display, unknown family" {
    val dir = scratch();
    val base = interOpts();
    try assertAs(comptime compiler.src(), "refusals", [
        "#1 Inter              "
            + errorOf(googleFontWith("Inter", GoogleFontOptions(weights: ["400"], styles: ["normal"], subsets: [], display: "swap", preload: false, variable: "", fallback: [], adjustFontFallback: false), build(dir))),
        "#2 Inter              "
            + errorOf(googleFontWith("Inter", GoogleFontOptions(weights: ["400"], styles: ["normal"], subsets: ["latin"], display: "eventually", preload: false, variable: "", fallback: [], adjustFontFallback: false), build(dir))),
        "#3 Nonexistent Sans   "
            + errorOf(googleFontWith("Nonexistent Sans", base, build(dir))),
    ].join("\n"));
    val gone = process.run("rm", ["-rf", dir]);
}

test "font: the fallback descriptors ---- Inter over Arial, and identity" {
    val inter = FontMetrics(unitsPerEm: 2816, ascent: 2728, descent: 680, lineGap: 0, avgCharWidth: 1330);
    val arial = FontMetrics(unitsPerEm: 2048, ascent: 1854, descent: 434, lineGap: 67, avgCharWidth: 904);
    val face = fallbackFace("Inter", "Arial", inter, arial);
    assert face.contains("ascent-override:96.88%");
    assert face.contains("descent-override:24.15%");
    assert face.contains("line-gap-override:0.00%");
    val same = fallbackFace("Arial", "Arial", arial, arial);
    assert same.contains("size-adjust:100.00%");
    try assertAs(comptime compiler.src(), "fallback", face + "\n" + same);
}

test "font: without adjustFontFallback the family list is the configured one" {
    val dir = scratch();
    val f = try googleFontWith("Inter", GoogleFontOptions(weights: ["400"], styles: ["normal"], subsets: ["latin"], display: "optional", preload: false, variable: "", fallback: ["serif"], adjustFontFallback: false), build(dir));
    assert f.style == "font-family:\"Inter\",serif";
    assert f.css.contains("Fallback") == false;
    assert f.css.contains("font-display:optional");
    assert f.preload == "";
    assert f.css.contains(":root") == false;
    val gone = process.run("rm", ["-rf", dir]);
}

test "font: local ---- copied under its hash, refused outside the root, degraded without a probe" {
    val dir = scratch();
    val w = fs.writeText(path.join([dir, "Brand-Bold.woff2"]), "brand bytes");
    val opts = LocalFontOptions(sources: [LocalFontSource(path: "Brand-Bold.woff2", weight: "700", style: "normal")], display: "swap", preload: false, variable: "--font-brand", fallback: ["sans-serif"], adjustFontFallback: true);
    val f = try localFont("Brand", opts, dir, "b7f2a1", path.join([dir, ".onze"]), { file -> noProbe(file) }, { line -> logLine(line) });
    val copied = fs
        .list(path.join([dir, ".onze", "static", "b7f2a1", "fonts"]))
        .unwrapOr([]);
    assert copied.length == 1;
    assert f.css.contains("/_onze/static/b7f2a1/fonts/" + copied.at(0) ?? "");
    assert logged().any({ l -> l.startsWith("font Brand: no metrics probe") });
    val outside = LocalFontOptions(sources: [LocalFontSource(path: "../../etc/passwd", weight: "400", style: "normal")], display: "swap", preload: false, variable: "", fallback: [], adjustFontFallback: false);
    assert errorOf(localFont("Brand", outside, dir, "b7f2a1", dir, { file -> noProbe(file) }, { line -> logLine(line) })).contains("outside the project root");
    val missing = LocalFontOptions(sources: [LocalFontSource(path: "Nope.woff2", weight: "400", style: "normal")], display: "swap", preload: false, variable: "", fallback: [], adjustFontFallback: false);
    assert errorOf(localFont("Brand", missing, dir, "b7f2a1", dir, { file -> noProbe(file) }, { line -> logLine(line) })).contains("Nope.woff2 does not exist");
    val gone = process.run("rm", ["-rf", dir]);
}

test "font: the Google CSS parser keeps each face's subset" {
    val faces = parseGoogleCss(googleCss());
    assert faces.map({ f -> f.subset + ":" + f.weight }).join(",")
        == "cyrillic:400,latin:400,latin:700";
    assert googleCssUrl("Open Sans", GoogleFontOptions(weights: ["400"], styles: ["normal", "italic"], subsets: ["latin"], display: "swap", preload: false, variable: "", fallback: [], adjustFontFallback: false))
        == "https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,400;1,400&display=swap";
    assert metricsSidecar(FontMetrics(unitsPerEm: 1000, ascent: 800, descent: 200, lineGap: 0, avgCharWidth: 500)).startsWith("unitsPerEm 1000\n");
}
