// `botopink test` suite for `src/style_module.bp` (front 69 step 1).

import {assets.style_module.StyleModule, assets.style_module.compileStyleModule, assets.style_module.generateStyleModuleSource, assets.style_module.scopeName, assets.style_module.generatedPath, assets.style_module.reportOf};
import {assertAs} from "snap";

fn blog() -> string {
    return [
        ".container { padding: 24px; }",
        ".title { font-size: 2rem; }",
        ".title:hover .container { color: red; }",
        ".external { color: blue; }",
        ".container .missing { margin: 0; }",
    ].join("\n");
}

fn errorOf(r: @Result<StyleModule, string>) -> string {
    return case r {
        Ok(m) -> "ok";
        Error(e) -> e;
    };
}

test "css module: scoped names ---- blog.module.css" {
    val m = try compileStyleModule("app/blog/blog.module.css", blog());
    try assertAs(@src(), "css module", [
        "== hash",
        m.hash,
        "== " + generatedPath(".onze", m.sourcePath),
        generateStyleModuleSource(m).trimEnd(),
        "== rewritten css",
        m.css,
        "== reported",
        reportOf(m).join("\n"),
    ].join("\n"));
}

test "css module: two files defining .container get two names; a rebuild the same" {
    val a = try compileStyleModule("app/blog/blog.module.css", ".container { padding: 24px; }");
    val b = try compileStyleModule("app/ui/card.module.css", ".container { display: flex; }");
    val a2 = try compileStyleModule("app/blog/blog.module.css", ".container { padding: 24px; }");
    val na = (a.names.at(0) ?? #("", ""))._1;
    assert na != (b.names.at(0) ?? #("", ""))._1;
    assert na == (a2.names.at(0) ?? #("", ""))._1;
    assert na == scopeName("app/blog/blog.module.css", "container", a.hash);
}

test "css module: the generated names and the rewritten CSS are the same set" {
    val m = try compileStyleModule("app/blog/blog.module.css", blog());
    for (m.names) { n ->
        assert m.css.contains("." + n._1);
        assert generateStyleModuleSource(m).contains("\"" + n._1 + "\"");
    }
    var scopedInCss = 0;
    for (m.css.split(".")) { piece ->
        if (piece.startsWith("blog_")) scopedInCss = scopedInCss + 1;
    }
    assert scopedInCss == 6;
    assert m.names.length == 3;
    assert reportOf(m).length == 1;
}

test "css module: </style is refused, naming the file" {
    assert errorOf(compileStyleModule("app/x.module.css", ".a { content: \"</STYLE>\"; }"))
        == "app/x.module.css: contains \"</style\", which would end the <style> element it is written into";
}
