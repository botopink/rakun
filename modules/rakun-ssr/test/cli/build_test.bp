// `botopink test` suite for `src/build.bp` (front 50 step 7): `rakun-ssr build`
// over the committed scaffold, twice, and a refusal that fails the build
// before anything compiles.

import {cli.build.BuildResult, cli.build.buildProject, cli.build.srcDirOf, cli.build.workspaceMembers};
import {cli.resolve.Project, cli.resolve.resolveProject};
import {config.OnzeConfig, types.AliasMap};
import {cli.main.Outcome, cli.main.run};
import {io.fs, io.process, io.clock, path, io.env} from "std";

// The run's own scratch directory — `botopink test` names it in
// `BOTOPINK_TEST_TMPDIR`, and it is the one place a test writes.
fn testTmp() -> string {
    val root = env.read("BOTOPINK_TEST_TMPDIR") ?? "";
    assert root
        != "", "BOTOPINK_TEST_TMPDIR is not set: run this suite under `botopink test`";
    return root;
}

// The compiler the fixtures build with: `BOTOPINK_BIN` when the caller names
// one (the hook and CI do — the same binary that runs this suite), else the
// ancestor checkout's `repository/botopink-lang/zig-out/bin/botopink`.
fn botopinkBin() -> string {
    val named = env.read("BOTOPINK_BIN") ?? "";
    if (named != "" && fs.exists(named)) return named;
    var dir = process.cwd();
    var found = "";
    var guard = 0;
    while (found == "" && guard < 12) {
        val cand = path.join([dir, "repository", "botopink-lang", "zig-out", "bin", "botopink"]);
        if (fs.exists(cand)) found = cand;
        dir = path.dirname(dir);
        guard = guard + 1;
    }
    return found;
}

fn repositoryDir() -> string {
    return path.normalize(path.join([process.cwd(), "..", ".."]));
}

fn failure(r: @Result<BuildResult, string>) -> string {
    return case r {
        Ok(b) -> "ok";
        Error(e) -> e;
    };
}

test "build: srcDirOf and the workspace members" {
    assert srcDirOf("{ \"name\": \"x\", \"src\": \"src/\" }") == "src";
    assert srcDirOf("{ \"name\": \"x\" }") == "src";
    val members = workspaceMembers(path.join([process.cwd(), "..", "..", "examples", "rakun-ssr", "scaffold"]));
    assert members.any({ m -> m._0 == "rakun-ssr" });
}

// The project at `dir`, its `outDir` moved under the run's scratch directory:
// a build writes nothing into the checkout.
fn projectInto(dir: string, outDir: string) -> @Result<Project, string> {
    val p = try resolveProject(dir);
    val c = p.config;
    return Project(root: p.root, config: OnzeConfig(..c, outDir: outDir), aliases: p.aliases);
}

test "build: the scaffold ---- the staged server, its BEAM, a stable build id, no server started" {
    val bin = botopinkBin();
    assert bin != "";
    val dir = path.normalize(path.join([process.cwd(), "..", "..", "examples", "rakun-ssr", "scaffold"]));
    val out = path.join([testTmp(), "scaffold-out"]);
    val p = try projectInto(dir, out);
    val first = try buildProject(p, bin);
    for (["src", "server/erl", "server/beam", "static", "client-manifest.txt", "build-id"]) { entry ->
        assert fs.exists(path.join([out, entry]));
    }
    assert fs.exists(path.join([out, "src", "onze_main.bp"]));
    assert fs.exists(path.join([out, "server", "beam", "scaffold@onze_main.beam"]));
    assert fs.exists(path.join([dir, ".onze"])) == false;
    assert fs.readText(path.join([out, "build-id"])).unwrapOr("")
        == first.buildId + "\n";
    assert first.manifest.startsWith("V|1|" + first.buildId + "\n");
    val second = try buildProject(p, bin);
    assert second.buildId == first.buildId;
}

test "build: a client module reading a non-public variable fails the build, naming both" {
    val dir = path.join([testTmp(), "build-" + clock.nowMillis().toString()]);
    val made = process.run("mkdir", ["-p", dir]);
    val created = run(dir, ["create", "leaky", "--yes", "--src-dir", "--libs", repositoryDir()], "test");
    assert created.code == 0;
    val app = path.join([dir, "leaky"]);
    val c = fs.writeText(path.join([app, "src", "app", "widget.bp"]), "import {Element, p} from \"rakun-bpp\";\nimport {io.env} from \"std\";\n\n#[client]\npub fn Widget() -> Element {\n    val secret = env.read(\"DATABASE_URL\");\n    return p([], attrs: []);\n}\n");
    val pg = fs.writeText(path.join([app, "src", "app", "page.bp"]), "import {page, jhPage, ctxParam, ctxRest, PageContext, Element, ElementBase, h1, text} from \"rakun-bpp\";\nimport {app.widget.Widget};\n\n#[page(\"\")]\npub fn home(route: PageContext) -> @Component<Element> {\n    return h1([text(\"x\", attrs: [])], attrs: []);\n}\n");
    val p = try resolveProject(app);
    val msg = failure(buildProject(p, botopinkBin()));
    assert msg.contains("env-non-public");
    assert msg.contains("DATABASE_URL");
    assert msg.contains("app.widget");
    assert fs.exists(path.join([app, ".onze"])) == false;
    val gone = process.run("rm", ["-rf", dir]);
}

test "build: a client emilia call is evaluated by both backends ---- the contract-4 fixture's class" {
    val dir = path.join([testTmp(), "probe-" + clock.nowMillis().toString()]);
    val made = process.run("mkdir", ["-p", dir]);
    val created = run(dir, ["create", "probed", "--yes", "--src-dir", "--libs", repositoryDir()], "test");
    assert created.code == 0;
    val app = path.join([dir, "probed"]);
    val card = fs.writeText(path.join([app, "src", "app", "card.bp"]), "import {Element, p, text} from \"rakun-bpp\";\nimport {emilia, Token} from \"rakun-stylesheet\";\n\n#[client]\npub fn Card() -> Element {\n    val cls = emilia([.Bg.White, .Pad.All.__4, .Text.Bold, Token.Hover([.Bg.Color.Gray.__100])]);\n    return p([text(\"card\", attrs: [])], attrs: [#(\"class\", cls)]);\n}\n");
    val pg = fs.writeText(path.join([app, "src", "app", "page.bp"]), "import {page, jhPage, ctxParam, ctxRest, PageContext, Element, ElementBase, h1, text} from \"rakun-bpp\";\nimport {app.card.Card};\n\n#[page(\"\")]\npub fn home(route: PageContext) -> @Component<Element> {\n    return h1([text(\"x\", attrs: [])], attrs: []);\n}\n");
    val p = try resolveProject(app);
    val b = try buildProject(p, botopinkBin());
    assert b.styles.map({ s -> s._0 + " " + s._1 }).join(",")
        == "app.card#1 e_f51c2501";
}

// The blog, copied under the run's scratch directory with its dependencies
// made absolute, so a test may change a file of it.
fn blogCopy(name: string) -> @Result<string, string> {
    val examples = path.normalize(path.join([process.cwd(), "..", "..", "examples", "rakun-ssr"]));
    val dir = path.join([testTmp(), name]);
    val copied = try process.run("sh", ["-c", "mkdir -p '"
        + dir
        + "' && cp -r '"
        + path.join([examples, "blog"])
        + "'/. '"
        + dir
        + "' && rm -rf '"
        + path.join([dir, ".botopinkbuild"])
        + "'"]);
    val manifest = try fs.readText(path.join([dir, "botopink.json"]));
    val repo = repositoryDir();
    var absolute = manifest;
    for (["rakun-bpp", "rakun-stylesheet", "rakun-ssr"]) { n ->
        absolute = absolute.replaceAll("\""
            + n
            + "\": {\n      \"workspace\": true\n    }", "\""
            + n
            + "\": {\n      \"path\": \""
            + path.join([repo, "modules", n])
            + "\"\n    }");
    }
    assert absolute.contains("\"workspace\"") == false;
    val w = try fs.writeText(path.join([dir, "botopink.json"]), absolute);
    return dir;
}

test "build: a client component importing the blog's lib/db fails the build ---- the server-only module stays out of the client graph" {
    val dir = try blogCopy("blog-leak");
    val button = path.join([dir, "src", "components", "like_button.bp"]);
    val source = try fs.readText(button);
    val leaky = source.replace("import {Element, button, text, client, clientProps} from \"rakun-bpp\";", "import {Element, button, text, client, clientProps} from \"rakun-bpp\";\nimport {listPosts} from \"@/lib.db\";");
    val w = try fs.writeText(button, leaky);
    val p = try resolveProject(dir);
    val msg = failure(buildProject(p, botopinkBin()));
    assert msg.contains("server-only module lib.db");
    assert msg.contains("components.like_button");
    assert fs.exists(path.join([dir, ".onze"])) == false;
}

test "build: a CSS module's generated accessors compile and its rules reach the stylesheet" {
    val dir = path.join([testTmp(), "styled-" + clock.nowMillis().toString()]);
    val made = process.run("mkdir", ["-p", dir]);
    val created = run(dir, ["create", "cssapp", "--yes", "--src-dir", "--no-emilia", "--libs", repositoryDir()], "test");
    assert created.code == 0;
    val app = path.join([dir, "cssapp"]);
    val css = fs.writeText(path.join([app, "src", "app", "home.module.css"]), ".card { padding: 8px; }\n");
    val globals = fs.writeText(path.join([app, "src", "app", "globals.css"]), "body { margin: 0; }\n");
    val pg = fs.writeText(path.join([app, "src", "app", "page.bp"]), "import {page, jhPage, ctxParam, ctxRest, PageContext, Element, ElementBase, h1, text} from \"rakun-bpp\";\nimport {styles.app_home.card};\n\n#[page(\"\")]\npub fn home(route: PageContext) -> @Component<Element> {\n    return h1([text(\"x\", attrs: [])], attrs: [#(\"class\", card)]);\n}\n");
    val p = try resolveProject(app);
    val b = try buildProject(p, botopinkBin());
    assert b.stylesheet.startsWith("body { margin: 0; }\n.home_card_");
    assert b.staged.contains("src/styles/app_home.bp");
    val gone = process.run("rm", ["-rf", dir]);
}
