// `botopink test` suite for `src/generate.bp` (front 50 step 4): the check,
// the staged tree, and a round trip — stage, write, `botopink check`.

import {cli.scan.RouteEntry, cli.scan.scanFiles};
import {cli.generate.checkTree, cli.generate.stage, cli.generate.stagedPath, cli.generate.rewriteImports, cli.generate.modFiles, cli.generate.routesModule, cli.generate.banner};
import {types.AliasMap};
import {io.fs, io.process, io.clock, path, io.env, compiler, io.terminal.print} from "std";
import {assertAs} from "snap";

// The run's own scratch directory — `botopink test` names it in
// `BOTOPINK_TEST_TMPDIR`, and it is the one place a test writes.
fn testTmp() -> string {
    val root = env.read("BOTOPINK_TEST_TMPDIR") ?? "";
    assert root
        != "", "BOTOPINK_TEST_TMPDIR is not set: run this suite under `botopink test`";
    return root;
}

fn aliases() -> AliasMap {
    return AliasMap(entries: [#("@/components", "components"), #("@/lib", "lib")]);
}

fn jh() -> string {
    return "import {page, layout, jhPage, jhLayout, ctxParam, ctxRest, pageParams, PageContext, LayoutProps, Element, ElementBase, div, p, text} from \"rakun-bpp\";";
}

// The app of the round trip, as `#(path under src/, text)`.
fn sources() -> array<#(string, string)> {
    return [
        #("root.bp", "pub mod lib;"),
        #("lib/mod.bp", "pub mod format;"),
        #("lib/format.bp", "pub fn plural(n: i32, word: string) -> string {\n    return if (n == 1) word else word + \"s\";\n}"),
        #("app/layout.bp", jh()
            + "\n\n#[layout(\"\")]\npub fn rootLayout(props: LayoutProps) -> Component<Element> {\n    return div([props.children], attrs: []);\n}"),
        #("app/page.bp", jh()
            + "\nimport {plural} from \"@/lib.format\";\n\n#[page(\"\")]\npub fn home(route: PageContext) -> Component<Element> {\n    return p([text(plural(2, \"post\"), attrs: [])], attrs: []);\n}"),
        #("app/blog/[slug]/page.bp", jh()
            + "\n\n#[page(\"blog/[slug]\")]\npub fn post(route: PageContext) -> Component<Element> {\n    val ps = pageParams(route);\n    return p([text(ps.get(\"slug\"), attrs: [])], attrs: []);\n}"),
        #("app/blog/[slug]/loading.bp", jh()
            + "\n\npub fn Loading() -> Element {\n    return p([text(\"loading\", attrs: [])], attrs: []);\n}"),
        #("app/blog/[slug]/not-found.bp", jh()
            + "\n\npub fn NotFound() -> Element {\n    return p([text(\"no such post\", attrs: [])], attrs: []);\n}"),
        #("app/(marketing)/about/page.bp", jh()
            + "\n\n#[page(\"(marketing)/about\")]\npub fn about(route: PageContext) -> Component<Element> {\n    return p([text(\"about\", attrs: [])], attrs: []);\n}"),
    ];
}

fn entries() -> Result<array<RouteEntry>, string> {
    val appFiles = sources()
        .filter({ s -> s._0.startsWith("app/") })
        .map({ s -> #("src/" + s._0, s._1) });
    return try scanFiles("src", "src/app", appFiles);
}

// The botopink binary: `BOTOPINK_BIN`, else the checkout's zig-out, found by
// walking up from the working directory.
// The compiler the fixtures build with: `BOTOPINK_BIN` when the caller names
// one (the hook and CI do — the same binary that runs this suite), else the
// ancestor checkout's `repository/botopink-lang/zig-out/bin/botopink`.
fn botopinkBin() -> string {
    val named = env.read("BOTOPINK_BIN") ?? "";
    if (named != "" && fs.exists(named)) return named;
    var dir = process.cwd();
    var found = "";
    var guard = 0;
    while (found == "" && guard < 12) {
        val cand = path.join([dir, "repository", "botopink-lang", "zig-out", "bin", "botopink"]);
        if (fs.exists(cand)) found = cand;
        dir = path.dirname(dir);
        guard = guard + 1;
    }
    return found;
}

fn repositoryDir() -> string {
    return path.normalize(path.join([process.cwd(), "..", ".."]));
}

fn dep(name: string, rel: string) -> string {
    return "\""
        + name
        + "\": { \"path\": \""
        + path.join([repositoryDir(), rel])
        + "\" }";
}

fn manifest() -> string {
    return "{ \"name\": \"demo\", \"src\": \"src/\", \"entry\": \"root.bp\", \"target\": \"commonJS\", \"alias\": { \"@/lib\": \"lib\" }, \"dependencies\": { "
        + dep("rakun-bpp", "modules/rakun-bpp")
        + " } }";
}

test "generate: check ---- a decorator that disagrees with its directory" {
    val es = try scanFiles("", "app", [#("app/blog/[slug]/page.bp", "#[page(\"posts/[slug]\")] pub fn post(route: PageContext) -> Component<Element> { return p([]); }")]);
    val problems = checkTree("app", es);
    assert problems.length == 1;
    assert (problems.at(0) ?? "").contains("app/blog/[slug]/page.bp");
    assert (problems.at(0) ?? "").contains("posts/[slug]");
    assert (problems.at(0) ?? "").contains("\"blog/[slug]\"");
}

test "generate: staged ---- the tree, sorted, deterministic" {
    val es = try entries();
    assert checkTree("src/app", es).length == 0;
    val a = try stage(aliases(), "app", "src/app", sources(), es, manifest());
    val b = try stage(aliases(), "app", "src/app", sources(), es, manifest());
    assert a.map({ f -> f._0 + f._1 }).join("")
        == b.map({ f -> f._0 + f._1 }).join("");
    val generated = a.filter({ f -> (f._0.endsWith("mod.bp") && f._0 != "src/lib/mod.bp") || f._0.endsWith("onze_routes.bp") || f._0 == "src/root.bp" });
    assert generated.all({ f -> f._1.contains(banner()) });
    val listing = a.map({ f -> f._0 }).join("\n");
    val shown = generated
        .filter({ f -> f._0 != "src/lib/mod.bp" })
        .map({ f -> "== " + f._0 + "\n" + f._1.trimEnd() })
        .join("\n");
    try assertAs(comptime compiler.src(), "tree", listing + "\n" + shown);
}

test "generate: round trip ---- stage, write, botopink check" {
    val bin = botopinkBin();
    assert bin != "";
    val es = try entries();
    val staged = try stage(aliases(), "app", "src/app", sources(), es, manifest());
    val dir = path.join([testTmp(), "gen-" + clock.nowMillis().toString()]);
    for f in staged {
        val made = process.run("mkdir", ["-p", path.dirname(path.join([dir, f._0]))]);
        val w = fs.writeText(path.join([dir, f._0]), f._1);
    }
    val checked = try process.run("sh", ["-c", "cd '"
        + dir
        + "' && '"
        + bin
        + "' check 2>&1"]);
    if (checked.status != 0) print(checked.stdout);
    assert checked.status == 0;
    val gone = process.run("rm", ["-rf", dir]);
}

test "generate: stagedPath renames directories and convention stems" {
    assert stagedPath("app/blog/[slug]/not-found.bp")
        == "app/blog/d_slug/not_found.bp";
    assert stagedPath("app/(marketing)/about/page.bp")
        == "app/g_marketing/about/page.bp";
    assert stagedPath("app/default.bp") == "app/default_view.bp";
    assert rewriteImports(aliases(), "import {x} from \"@/lib.format\";")
        == "import {lib.format.x};";
    assert rewriteImports(aliases(), "import {x, y as z} from \"@/lib.format\"; // kept")
        == "import {lib.format.x, lib.format.y as z}; // kept";
    assert rewriteImports(aliases(), "import {\n    x,\n    y,\n} from \"@/lib.format\";\npub fn f() -> i32 { return 1; }")
        == "import {lib.format.x, lib.format.y};\npub fn f() -> i32 { return 1; }";
    assert rewriteImports(aliases(), "import {Element} from \"rakun-bpp\";")
        == "import {Element} from \"rakun-bpp\";";
}
