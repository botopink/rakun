//// rakun-restclient — HTTP service interfaces: `#[httpExchange]` (front 13 step 5).
////
//// Spring's `@HttpExchange` turns an interface into a generated client. Here
//// the same comptime twin-type mechanism `rakun-ssr`'s `#[mock]` uses: the decorator
//// reflects a `behavior` and adds an associated type implementing it
//// (`compiler.addType` over `compiler.buildType`) plus a static factory member
//// (`compiler.addMember`).
////
////     #[httpExchange("echo")]
////     pub behavior EchoService {
////         #[getExchange("/users/:id")]
////         fn user(self: Self, id: string) -> string;
////
////         #[postExchange("/echo")]
////         fn echo(self: Self, body: string) -> string;
////     }
////
//// adds
////
////     EchoService.Http(client: RestClient) implement EchoService {
////         fn user(self: Self, id: string) -> string {
////             return self.client.exchange("GET", "/users/:id", ["id"], [id], "");
////         }
////         fn echo(self: Self, body: string) -> string {
////             return self.client.exchange("POST", "/echo", [], [], body);
////         }
////     }
////     EchoService.http()    — { -> EchoService.Http(client: RestClient.forGroup("echo")) }
////
//// The type names only `RestClient` (a method call and a static call on
//// it), so the application site imports `RestClient` — with its type closure,
//// `HttpClientSettings`, `CacheLife` and `ClientResponse`, because importing a
//// type re-checks its declaration at the importing site (rakun AGENTS.md,
//// "unknown type") — and nothing else of this member. The group's client reads
//// `rakun.http.serviceclient.<group>.base-url` (required) and the group's
//// timeouts, redirects and bundle, each falling back to the global key; two
//// groups never share settings.
////
//// THE RULES, each a located build failure (never a generated type that cannot
//// work):
////   * `:name` in a path must be a parameter of the method — both names are in
////     the message;
////   * GET, DELETE (and HEAD/OPTIONS) take no body: every parameter must be a
////     path parameter;
////   * POST, PUT, PATCH take exactly one parameter that is not a path
////     parameter, and it is the body;
////   * every parameter and the return type are `string` — std has no derivation
////     from its `Json` value to a record (language gap), so a typed body cannot
////     be decoded or encoded here;
////   * exactly one exchange annotation per method; a method without one fails;
////   * `#[getExchange]`…`#[deleteExchange]` on anything but a method fail, and
////     `#[httpExchange]` on anything but a behavior fails.
////
//// A decorator body is comptime and cannot call a sibling function, which is
//// why `httpExchange` is one long function.

import {compiler, compiler.DeclKind} from "std";
import {client.RestClient};

pub fn httpExchange(expr decl: unknown, comptime group: string) {
    val g = group.replaceAll("\"", "").trim();
    var problems: Array<string> = [];
    var methods: Array<string> = [];
    compiler.methods(decl).forEach({ m ->
        var verb = "";
        var path = "";
        var count = 0;
        m.annotations.forEach({ a ->
            val v = if (a.name == "getExchange")
                "GET"
            else if (a.name == "postExchange")
                "POST"
            else if (a.name == "putExchange")
                "PUT"
            else if (a.name == "patchExchange")
                "PATCH"
            else if (a.name == "deleteExchange")
                "DELETE"
            else
                "";
            val isExchange = v != "";
            val nextVerb = if (isExchange) v else verb;
            verb = nextVerb;
            val nextPath = if (isExchange)
                a.args.join("").replaceAll("\"", "").trim()
            else
                path;
            path = nextPath;
            val nextCount = if (isExchange) count + 1 else count;
            count = nextCount;
        });
        val label = compiler.name(decl)! + "." + m.name;
        if (count == 0)
            problems.push(
                label
                    + " has no exchange annotation - add #[getExchange], #[postExchange], #[putExchange], #[patchExchange] or #[deleteExchange]",
            );
        if (count > 1)
            problems.push(label + " has more than one exchange annotation");
        if (m.returnType != "string")
            problems.push(
                label
                    + " returns `"
                    + m.returnType
                    + "`, but an exchange method returns the body as string: std has no JSON value model to decode a response into a record (language gap), so a typed return cannot work",
            );
        var params: Array<string> = [];
        var args: Array<string> = [];
        m.params.forEach({ p ->
            if (p.name != "self") {
                params.push(p.name);
                args.push(p.name + ": " + p.typeName);
                if (p.typeName != "string")
                    problems.push(
                        label
                            + " parameter `"
                            + p.name
                            + "` is `"
                            + p.typeName
                            + "`, but exchange parameters are string",
                    );
            }
        });
        var pathNames: Array<string> = [];
        path
            .split("/")
            .forEach({ seg ->
                if (seg.startsWith(":")) {
                    val name = seg.replaceAll(":", "");
                    pathNames.push(name);
                    if (params.contains(name) == false)
                        problems.push(
                            label
                                + " path "
                                + path
                                + " names `:"
                                + name
                                + "`, but the method has no parameter `"
                                + name
                                + "` (parameters: "
                                + params.join(", ")
                                + ")",
                        );
                }
            });
        var rest: Array<string> = [];
        params.forEach({ p ->
            if (pathNames.contains(p) == false) rest.push(p);
        });
        val bodied = verb == "POST" || verb == "PUT" || verb == "PATCH";
        if (bodied && rest.length != 1)
            problems.push(
                label
                    + " is a "
                    + verb
                    + ": exactly one parameter that is not a path parameter carries the body, and it has "
                    + rest.length.toString()
                    + " ("
                    + rest.join(", ")
                    + ")",
            );
        if ((bodied == false) && verb != "" && rest.length > 0)
            problems.push(
                label
                    + " is a "
                    + verb
                    + " and takes no body, but parameter `"
                    + rest.join("`, `")
                    + "` is not in the path "
                    + path,
            );
        val body = if (bodied) rest.join("") else "\"\"";
        val names = "["
            + pathNames.map({ n -> "\"" + n + "\"" }).join(", ")
            + "]";
        val values = "[" + pathNames.join(", ") + "]";
        val sig = if (args.length > 0)
            "self: Self, " + args.join(", ")
        else
            "self: Self";
        val call = "self.client.exchange(\""
            + verb
            + "\", \""
            + path
            + "\", "
            + names
            + ", "
            + values
            + ", "
            + body
            + ")";
        methods.push(
            "fn "
                + m.name
                + "("
                + sig
                + ") -> string {\n        return "
                + call
                + ";\n    }",
        );
    });
    if (compiler.kind(decl) != DeclKind.Behavior)
        compiler.fail(
            "#[httpExchange] must annotate a behavior - the generated client is a type implementing it",
            at: decl,
        );
    if (g == "")
        compiler.fail(
            "#[httpExchange] needs a group name: #[httpExchange(\"<group>\")] reads rakun.http.serviceclient.<group>.*",
            at: decl,
        );
    if (problems.length > 0)
        compiler.fail(
            "#[httpExchange(\""
                + g
                + "\")] on "
                + compiler.name(decl)!
                + ": "
                + problems.join("; "),
            at: decl,
        );
    compiler.addType(
        "Http",
        compiler.buildType(
            "(client: RestClient) implement "
                + compiler.name(decl)!
                + " {\n    "
                + methods.join("\n\n    ")
                + "\n}",
        ),
    );
    compiler.addMember("http", { -> decl.Http(client: RestClient.forGroup(g)) });
}

pub fn getExchange(expr decl: unknown, comptime path: string) {
    if (compiler.kind(decl) != DeclKind.Method)
        compiler.fail(
            "#[getExchange] must annotate a method of a #[httpExchange] behavior",
            at: decl,
        );
}

pub fn postExchange(expr decl: unknown, comptime path: string) {
    if (compiler.kind(decl) != DeclKind.Method)
        compiler.fail(
            "#[postExchange] must annotate a method of a #[httpExchange] behavior",
            at: decl,
        );
}

pub fn putExchange(expr decl: unknown, comptime path: string) {
    if (compiler.kind(decl) != DeclKind.Method)
        compiler.fail(
            "#[putExchange] must annotate a method of a #[httpExchange] behavior",
            at: decl,
        );
}

pub fn patchExchange(expr decl: unknown, comptime path: string) {
    if (compiler.kind(decl) != DeclKind.Method)
        compiler.fail(
            "#[patchExchange] must annotate a method of a #[httpExchange] behavior",
            at: decl,
        );
}

pub fn deleteExchange(expr decl: unknown, comptime path: string) {
    if (compiler.kind(decl) != DeclKind.Method)
        compiler.fail(
            "#[deleteExchange] must annotate a method of a #[httpExchange] behavior",
            at: decl,
        );
}
