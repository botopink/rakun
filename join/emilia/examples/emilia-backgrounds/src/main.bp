// emilia-backgrounds — what fills a box behind its content.
//
// Before front 39, `Bg` could set a colour and nothing else. No image, no
// gradient, no size, no position, no repeat — which ruled out every hero, every
// card overlay and every gradient call to action, three shapes real Tailwind
// markup is mostly made of. This example is the other side of that: `§ 10.1`–
// `§ 10.8` as a typed surface, ending in the three compositions the gap was
// blocking.
//
// TWO THINGS IN THIS FILE ARE THE FRONT'S ARGUMENT, and they are the last two
// tests. The first is that a gradient stop and a background colour reference
// ONE custom property: `.Gradient.From.Indigo.500` and `.Bg.Color.Indigo.500`
// both go through front 33's `paletteVar`, so a project that overrides
// `--color-indigo-500` moves both, and neither can drift from the other. The
// second is that nothing here resolves a colour or a length — no `#`, no
// `oklch(`, no `rem` — because every value either references the theme or is a
// CSS keyword.
//
// TOKEN ORDER IS LOAD-BEARING in one place, and it is the only place in emilia
// where that is true by design. `Gradient.Via` writes a three-stop list and
// `Gradient.From` a two-stop one; whichever is listed LAST wins. `Gradient.Stop`
// writes no list at all, which is what lets a `From` + `Via` + `Stop` triple
// keep the three-colour list.
//
// Upstream: https://tailwindcss.com/docs/background-attachment · /background-clip ·
// /background-origin · /background-position · /background-repeat ·
// /background-size · /background-image

import {emilia, flushWith, Token} from "emilia";
import {Theme, ThemeEntry, DarkMode, defaultTheme, extendTheme} from "emilia";
import {Rule, Block, Sheet, Options} from "emilia";
import {defaultOptions, withTheme, emptyTheme} from "emilia";

// A document with no theme in it, so the assertions below read as the rules
// this example registered rather than as the stock theme's hundred variables.
fn bareOptions() -> Options {
    return withTheme(defaultOptions(), emptyTheme());
}

// ── the keyword sub-sections ─────────────────────────────────────────────────
//
// Seven property groups, 29 leaves, one declaration each. Three names read
// differently from upstream's and each has a reason: `Pos` rather than
// `Position`, so `.Bg.Pos.*` does not read like `.Layout.Position.*`;
// `Repeat.None` rather than `Repeat.NoRepeat`, because the CSS value keeps its
// `no-` prefix and the token does not repeat its section's word; and
// `Clip.Text`, the one clip value that is not a `*-box`.

pub fn attachmentValues() -> Token[] {
    val out: Token[] = [
        .Bg.Attachment.Fixed,
        .Bg.Attachment.Local,
        .Bg.Attachment.Scroll,
    ];
    return out;
}

pub fn clipValues() -> Token[] {
    val out: Token[] = [
        .Bg.Clip.Border,
        .Bg.Clip.Padding,
        .Bg.Clip.Content,
        .Bg.Clip.Text,
    ];
    return out;
}

pub fn originValues() -> Token[] {
    val out: Token[] = [
        .Bg.Origin.Border,
        .Bg.Origin.Padding,
        .Bg.Origin.Content,
    ];
    return out;
}

// The four corner positions are two CSS keywords with exactly one space
// between them — `left bottom`, never `left-bottom`, which is not a value.
pub fn positionValues() -> Token[] {
    val out: Token[] = [
        .Bg.Pos.Top,
        .Bg.Pos.Bottom,
        .Bg.Pos.Left,
        .Bg.Pos.Right,
        .Bg.Pos.Center,
        .Bg.Pos.LeftTop,
        .Bg.Pos.LeftBottom,
        .Bg.Pos.RightTop,
        .Bg.Pos.RightBottom,
    ];
    return out;
}

pub fn repeatValues() -> Token[] {
    val out: Token[] = [
        .Bg.Repeat.Repeat,
        .Bg.Repeat.None,
        .Bg.Repeat.X,
        .Bg.Repeat.Y,
        .Bg.Repeat.Round,
        .Bg.Repeat.Space,
    ];
    return out;
}

pub fn sizeAndImage() -> Token[] {
    val out: Token[] = [
        .Bg.Size.Auto,
        .Bg.Size.Cover,
        .Bg.Size.Contain,
        .Bg.Image.None,
    ];
    return out;
}

// ── the eight directions ─────────────────────────────────────────────────────

pub fn directions() -> Token[] {
    val out: Token[] = [
        .Gradient.To.T,
        .Gradient.To.Tr,
        .Gradient.To.R,
        .Gradient.To.Br,
        .Gradient.To.B,
        .Gradient.To.Bl,
        .Gradient.To.L,
        .Gradient.To.Tl,
    ];
    return out;
}

// ── the compositions the gap was blocking ────────────────────────────────────

// A hero whose photograph COVERS its box rather than tiling, is anchored to the
// top so a face is not cropped off, and does not scroll with the page.
pub fn heroPanel() -> string {
    val tokens: Token[] = [
        .Bg.Size.Cover,
        .Bg.Pos.Top,
        .Bg.Repeat.None,
        .Bg.Attachment.Fixed,
        .Pad.All.12,
    ];
    return emilia(tokens);
}

// A call to action: a direction and two stops. Nothing below the direction is a
// `background-image` at all — the two stops set custom properties the gradient
// reads.
pub fn gradientCta() -> string {
    val tokens: Token[] = [
        .Gradient.To.R,
        .Gradient.From.Indigo.500,
        .Gradient.Stop.Pink.500,
        .Pad.X.6,
        .Pad.Y.3,
        .Border.Rounded.Full,
    ];
    return emilia(tokens);
}

// The three-stop form. `Via` is listed after `From`, so its three-colour list is
// the one that survives; `Stop` writes no list, so it cannot undo that.
pub fn gradientBanner() -> string {
    val tokens: Token[] = [
        .Gradient.To.Br,
        .Gradient.From.Indigo.500,
        .Gradient.Via.Purple.500,
        .Gradient.Stop.Pink.500,
    ];
    return emilia(tokens);
}

// Gradient text: the gradient paints the box, `bg-clip-text` clips the paint to
// the glyphs, and a transparent text colour lets it through. `Clip.Text` is the
// reason this idiom needs `§ 10.2` and not just `§ 10.4`.
pub fn gradientHeading() -> string {
    val tokens: Token[] = [
        .Bg.Clip.Text,
        .Color.Transparent,
        .Gradient.To.Br,
        .Gradient.From.Sky.400,
        .Gradient.Stop.Fuchsia.600,
        .Text.Size.X3xl,
        .Font.Weight.Bold,
    ];
    return emilia(tokens);
}

// A texture that tiles on one axis only and sits inside the padding box — the
// pair `§ 10.5` and `§ 10.7` exist for.
pub fn tiledTexture() -> string {
    val tokens: Token[] = [
        .Bg.Repeat.X,
        .Bg.Origin.Padding,
        .Bg.Clip.Padding,
        .Bg.Pos.LeftTop,
    ];
    return emilia(tokens);
}

// A theme whose indigo is the project's, not upstream's. Nothing in the token
// lists above changes; the `:root` block does.
fn brandTheme() -> Theme {
    val brand: ThemeEntry[] = [ThemeEntry(name: "--color-indigo-500", value: "#4040ff")];
    return extendTheme(defaultTheme(), brand);
}

fn main() -> @Task<void> {
    @print(heroPanel());
    @print(gradientCta());
    @print(gradientBanner());
    @print(gradientHeading());
    @print(tiledTexture());
    @print(await flushWith(defaultOptions()));
}

// ── tests ────────────────────────────────────────────────────────────────────

test "attachment, clip and origin are one rule of ten declarations" {
    val a = emilia(attachmentValues());
    val c = emilia(clipValues());
    val o = emilia(originValues());
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + a
        + "{background-attachment:fixed;background-attachment:local;"
        + "background-attachment:scroll}")
        != -1;
    assert doc.indexOf("."
        + c
        + "{background-clip:border-box;background-clip:padding-box;"
        + "background-clip:content-box;background-clip:text}")
        != -1;
    assert doc.indexOf("."
        + o
        + "{background-origin:border-box;background-origin:padding-box;"
        + "background-origin:content-box}")
        != -1;
}

test "the four corner positions are two keywords, with exactly one space" {
    val p = emilia(positionValues());
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("background-position:left top") != -1;
    assert doc.indexOf("background-position:left bottom") != -1;
    assert doc.indexOf("background-position:right top") != -1;
    assert doc.indexOf("background-position:right bottom") != -1;
    assert doc.indexOf("left-top") == -1;
    assert doc.indexOf("right-bottom") == -1;
    assert doc.indexOf("." + p + "{") != -1;
}

test "`bg-no-repeat` keeps the `no-` in the value and drops it from the name" {
    val r = emilia(repeatValues());
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + r
        + "{background-repeat:repeat;background-repeat:no-repeat;"
        + "background-repeat:repeat-x;background-repeat:repeat-y;"
        + "background-repeat:round;background-repeat:space}")
        != -1;
}

test "size and `bg-none`, and `.Bg.Size` is not the `Size` section" {
    val z = emilia(sizeAndImage());
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + z
        + "{background-size:auto;background-size:cover;"
        + "background-size:contain;background-image:none}")
        != -1;
    assert doc.indexOf("width:") == -1;
}

test "the eight directions, each a phrase and not a hyphenated name" {
    val d = emilia(directions());
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("linear-gradient(to top, var(--tw-gradient-stops))")
        != -1;
    assert doc.indexOf("linear-gradient(to top right, var(--tw-gradient-stops))")
        != -1;
    assert doc.indexOf("linear-gradient(to bottom left, var(--tw-gradient-stops))")
        != -1;
    assert doc.indexOf("linear-gradient(to left, var(--tw-gradient-stops))")
        != -1;
    assert doc.indexOf("to top-right") == -1;
    assert doc.indexOf("to bottom-left") == -1;
    assert doc.indexOf("." + d + "{") != -1;
}

test "the hero covers its box and anchors to the top" {
    val cls = heroPanel();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + "{background-size:cover;background-position:top;"
        + "background-repeat:no-repeat;background-attachment:fixed;"
        + "padding:calc(var(--spacing) * 12)}")
        != -1;
}

test "the call to action is a direction and two stops, in one rule" {
    val cls = gradientCta();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + "{background-image:linear-gradient(to right, "
        + "var(--tw-gradient-stops));"
        + "--tw-gradient-from:var(--color-indigo-500);"
        + "--tw-gradient-stops:var(--tw-gradient-from), var(--tw-gradient-to, transparent);"
        + "--tw-gradient-to:var(--color-pink-500);"
        + "padding-left:calc(var(--spacing) * 6);padding-right:calc(var(--spacing) * 6);"
        + "padding-top:calc(var(--spacing) * 3);padding-bottom:calc(var(--spacing) * 3);"
        + "border-radius:9999px}")
        != -1;
}

// THE ORDER TEST. `Via` is listed after `From`, so the three-stop list is the
// one a browser reads; `Stop` adds no list of its own, which is what keeps it
// that way.
test "the banner keeps the three-colour list, because `Via` is listed after `From`" {
    val cls = gradientBanner();
    val doc = await flushWith(bareOptions());
    val twoStop = "--tw-gradient-stops:var(--tw-gradient-from), var(--tw-gradient-to, transparent)";
    val threeStop = "--tw-gradient-stops:var(--tw-gradient-from, transparent), "
        + "var(--tw-gradient-via), var(--tw-gradient-to, transparent)";
    assert doc.indexOf(twoStop) != -1;
    assert doc.indexOf(threeStop) != -1;
    assert doc.indexOf(threeStop) > doc.indexOf(twoStop);
    assert doc.indexOf("." + cls + "{") != -1;
}

test "gradient text needs `bg-clip-text` and a transparent colour" {
    val cls = gradientHeading();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + "{background-clip:text;color:transparent;"
        + "background-image:linear-gradient(to bottom right, var(--tw-gradient-stops));"
        + "--tw-gradient-from:var(--color-sky-400);"
        + "--tw-gradient-stops:var(--tw-gradient-from), var(--tw-gradient-to, transparent);"
        + "--tw-gradient-to:var(--color-fuchsia-600);"
        + "font-size:var(--text-3xl);line-height:var(--text-3xl--line-height);font-weight:700}")
        != -1;
}

test "a texture tiles on one axis, inside the padding box" {
    val cls = tiledTexture();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + "{background-repeat:repeat-x;"
        + "background-origin:padding-box;background-clip:padding-box;"
        + "background-position:left top}")
        != -1;
}

// THE FIRST HALF OF THE FRONT'S ARGUMENT. A stop and a background colour are
// the same custom property, so a project override moves both. The rule does not
// change — only the `:root` block does.
test "a project's indigo reaches the gradient stop and the background alike" {
    val stop: Token[] = [.Gradient.From.Indigo.500];
    val fill: Token[] = [.Bg.Color.Indigo.500];
    val stopCls = emilia(stop);
    val fillCls = emilia(fill);
    val doc = await flushWith(withTheme(defaultOptions(), brandTheme()));
    assert doc.indexOf("--color-indigo-500:#4040ff") != -1;
    assert doc.indexOf("."
        + stopCls
        + "{--tw-gradient-from:var(--color-indigo-500);")
        != -1;
    assert doc.indexOf("."
        + fillCls
        + "{background-color:var(--color-indigo-500)}")
        != -1;
}

// THE SECOND HALF. Nothing this example emits resolves a colour or a length,
// and nothing carries a Tailwind class name where a CSS value belongs. The two
// `rem` allowance is front 42's type scale, which is not this front's, so this
// walk drops it by using only this front's tokens. `Border.Rounded` used to be
// the second allowance and no longer is: front 40 rewrote it to
// `var(--radius-*)`.
test "no background token in this example resolves a colour or a length" {
    val _a = emilia(attachmentValues());
    val _b = emilia(clipValues());
    val _c = emilia(originValues());
    val _d = emilia(positionValues());
    val _e = emilia(repeatValues());
    val _f = emilia(sizeAndImage());
    val _g = emilia(directions());
    val stops: Token[] = [.Gradient.From.Indigo.500, .Gradient.Via.Purple.500, .Gradient.Stop.Pink.500, .Gradient.From.White, .Gradient.Stop.Transparent];
    val _h = emilia(stops);
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("#") == -1;
    assert doc.indexOf("oklch(") == -1;
    assert doc.indexOf("rem") == -1;
    assert doc.indexOf("bg-") == -1;
    assert doc.indexOf("from-") == -1;
    assert doc.indexOf("left-bottom") == -1;
}
