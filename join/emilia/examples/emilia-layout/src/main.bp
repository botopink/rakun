// emilia-layout — where a box sits, what it clips, and what it stacks over.
//
// Before front 36 the whole of emilia's layout vocabulary was six display
// values. Nothing could be positioned, clipped, stacked or floated, which ruled
// out every overlay, every sticky header and every scroll container — the three
// shapes a real page cannot be built without. This example is the other side of
// that: `§ 5.1`–`§ 5.19` as a typed surface, ending in the two compositions the
// gap was blocking.
//
// ONE RULE GOVERNS THE ONE NUMERIC FAMILY HERE. `Inset` is a MULTIPLIER of
// `--spacing`, exactly like front 35's `Pad` and `Margin`, and it reaches the
// same `spacing(n)`: `.Layout.Inset.T.4` and `.Pad.T.4` carry the same length
// text because they call the same function, not because two tables agree today.
// The named column widths are the theme's container ladder for the same reason
// — `.Layout.Columns.Md` and `.Size.MaxW.Md` are the same width by definition,
// so they are the same `var(--container-md)`. The last test in this file is the
// whole argument: nothing here emits a `rem`.
//
// `Z` is the exception that proves it: `z-50` is `z-index:50`, a bare integer
// and not a length, so there is nothing in it for a theme to resolve.
//
// Upstream: https://tailwindcss.com/docs/display · /position ·
// /top-right-bottom-left · /overflow · /visibility · /z-index · /float ·
// /object-fit · /aspect-ratio · /columns · /box-sizing

import {emilia, emiliaWith, flushWith, Token} from "emilia";
import {Theme, ThemeEntry, DarkMode, defaultTheme, extendTheme} from "emilia";
import {Rule, Block, Sheet, Options} from "emilia";
import {defaultOptions, withTheme, emptyTheme} from "emilia";

// A document with no theme in it, so the assertions below read as the rules
// this example registered rather than as the stock theme's hundred variables.
fn bareOptions() -> Options {
    return withTheme(defaultOptions(), emptyTheme());
}

// ── display ──────────────────────────────────────────────────────────────────
//
// The eleven values of `§ 5.8` are the section's OWN leaves, not a sub-section,
// which is what keeps `.Layout.Flex` spelled the way it was before front 36.
// `hidden` is the one row whose Tailwind name is not its CSS value.

pub fn displayValues() -> Token[] {
    val out: Token[] = [
        .Layout.Block,
        .Layout.InlineBlock,
        .Layout.Inline,
        .Layout.Flex,
        .Layout.InlineFlex,
        .Layout.Grid,
        .Layout.InlineGrid,
        .Layout.Contents,
        .Layout.FlowRoot,
        .Layout.ListItem,
        .Layout.Hidden,
    ];
    return out;
}

// ── the inset family ─────────────────────────────────────────────────────────
//
// Nine directions, the same nine `Pad` and `Margin` carry. `inset` is a real
// CSS shorthand so `All` is one declaration; `left`/`right` and `top`/`bottom`
// have none, so `X` and `Y` expand to two — which is how `§ 5.17` prints
// `inset-x-0`. `S`/`E` are `inset-inline-start`/`inset-inline-end`, which
// follow the writing direction where left and right do not.

pub fn insetDirections() -> Token[] {
    val out: Token[] = [
        .Layout.Inset.All.0,
        .Layout.Inset.X.2,
        .Layout.Inset.Y.4,
        .Layout.Inset.T.1,
        .Layout.Inset.R.2,
        .Layout.Inset.B.3,
        .Layout.Inset.L.4,
        .Layout.Inset.S.5,
        .Layout.Inset.E.5,
    ];
    return out;
}

// A fraction is carried BY NAME because `1/2` is neither an identifier nor a
// run of digits; `Full` is `100%`; `Auto` is `auto`; and `Neg` is upstream's
// `-top-4`, the one form with no alternative spelling.
pub fn insetShapes() -> Token[] {
    val out: Token[] = [
        .Layout.Inset.T.Frac.Half,
        .Layout.Inset.R.Full,
        .Layout.Inset.B.Auto,
        .Layout.Inset.L.Neg.4,
        .Layout.Inset.S.Half.0,
    ];
    return out;
}

// ── clipping, stacking, flow ─────────────────────────────────────────────────

pub fn scrollBox() -> Token[] {
    val out: Token[] = [
        .Layout.Overflow.Y.Auto,
        .Layout.Overflow.X.Hidden,
        .Layout.Overscroll.Contain,
    ];
    return out;
}

pub fn flowValues() -> Token[] {
    val out: Token[] = [
        .Layout.Visibility.Invisible,
        .Layout.Isolation.Isolate,
        .Layout.Float.Start,
        .Layout.Clear.Both,
        .Layout.Box.Border,
        .Layout.BoxDecoration.Clone,
    ];
    return out;
}

// ── the column-width ladder is the container ladder ──────────────────────────
//
// `columns-md` and `max-w-md` are the same width by definition, so emilia does
// not spell it twice: both read `var(--container-md)`, and a project that
// overrides the variable moves both.

pub fn columnLadder() -> Token[] {
    val out: Token[] = [
        .Layout.Columns.2,
        .Layout.Columns.Md,
        .Layout.Columns.Auto,
        .Layout.BreakInside.AvoidColumn,
        .Layout.BreakAfter.Page,
    ];
    return out;
}

// ── a media card that crops its image and clips its overflow ─────────────────
//
// The card clips, isolates a stacking context of its own and rounds its
// corners; the image inside it holds a 16:9 box and is cropped to fill it
// rather than squashed into it. Neither composition was expressible before this
// front: there was no `overflow`, no `isolation`, no `aspect-ratio` and no
// `object-fit`.

pub fn mediaCard() -> string {
    val tokens: Token[] = [
        .Layout.Overflow.Hidden,
        .Layout.Isolation.Isolate,
        .Border.Rounded.Lg,
    ];
    return emilia(tokens);
}

pub fn mediaImage() -> string {
    val tokens: Token[] = [
        .Layout.Aspect.Video,
        .Layout.Object.Fit.Cover,
        .Layout.Object.Pos.Center,
        .Size.W.Full,
    ];
    return emilia(tokens);
}

// ── a sticky header over a scrolling panel, with a pinned badge ──────────────
//
// The header sticks to the top of its scroll container and stacks over the
// content; the panel scrolls on one axis and does not chain its overscroll to
// the page; the badge hangs off the corner of a relative box on a NEGATIVE
// inset. All four are `§ 5.16`/`§ 5.17`/`§ 5.14`/`§ 5.19`, and all four were
// absent.

pub fn stickyHeader() -> string {
    val tokens: Token[] = [
        .Layout.Position.Sticky,
        .Layout.Inset.T.0,
        .Layout.Z.50,
        .Bg.White,
    ];
    return emilia(tokens);
}

pub fn scrollPanel() -> string {
    val tokens: Token[] = [
        .Layout.Overflow.Y.Auto,
        .Layout.Overscroll.Contain,
        .Size.MaxH.Screen,
    ];
    return emilia(tokens);
}

pub fn pinnedBadge() -> string {
    val tokens: Token[] = [
        .Layout.Position.Absolute,
        .Layout.Inset.T.Neg.2,
        .Layout.Inset.R.Neg.2,
        .Layout.Z.10,
    ];
    return emilia(tokens);
}

pub fn relativeCard() -> string {
    val tokens: Token[] = [.Layout.Position.Relative, .Pad.All.4];
    return emilia(tokens);
}

// A theme whose spacing base is half the stock value. Nothing in this file
// resolves a length, so every rule above is byte-identical under it.
pub fn tightTheme() -> Theme {
    val tighter: ThemeEntry[] = [ThemeEntry(name: "--spacing", value: "0.125rem")];
    return extendTheme(defaultTheme(), tighter);
}

fn main() -> @Task<void> {
    @print(mediaCard());
    @print(mediaImage());
    @print(stickyHeader());
    @print(scrollPanel());
    @print(relativeCard());
    @print(pinnedBadge());
    @print(await flushWith(defaultOptions()));
}

// ── tests ────────────────────────────────────────────────────────────────────
// emilia is target-independent, so every assertion runs on `--target commonJS`
// and on `--target erlang`.

test "the eleven display values, with the six that predate front 36 first" {
    val cls = emilia(displayValues());
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + "{display:block;display:inline-block;display:inline;"
        + "display:flex;display:inline-flex;display:grid;display:inline-grid;"
        + "display:contents;display:flow-root;display:list-item;display:none}")
        != -1;
}

test "an axis inset is two declarations, because CSS has no `inset-x`" {
    val cls = emilia(insetDirections());
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + "{inset:0;"
        + "left:calc(var(--spacing) * 2);right:calc(var(--spacing) * 2);"
        + "top:calc(var(--spacing) * 4);bottom:calc(var(--spacing) * 4);"
        + "top:calc(var(--spacing) * 1);right:calc(var(--spacing) * 2);"
        + "bottom:calc(var(--spacing) * 3);left:calc(var(--spacing) * 4);"
        + "inset-inline-start:calc(var(--spacing) * 5);"
        + "inset-inline-end:calc(var(--spacing) * 5)}")
        != -1;
}

test "the four shapes of an inset leaf — fraction, keyword, negative, half step" {
    val cls = emilia(insetShapes());
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + "{top:calc(1 / 2 * 100%);right:100%;bottom:auto;"
        + "left:calc(var(--spacing) * -4);"
        + "inset-inline-start:calc(var(--spacing) * 0.5)}")
        != -1;
}

// The inset ladder IS the padding ladder — one function, two properties — so
// the two values are compared to each other rather than each to its own
// expected string.
test "`.Layout.Inset.T.4` and `.Pad.T.4` differ only in the property name" {
    val insetCls = emilia([.Layout.Inset.T.4]);
    val padCls = emilia([.Pad.T.4]);
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("." + insetCls + "{top:calc(var(--spacing) * 4)}") != -1;
    assert doc.indexOf("." + padCls + "{padding-top:calc(var(--spacing) * 4)}")
        != -1;
}

test "overflow is three properties, not one property and an axis flag" {
    val cls = emilia(scrollBox());
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + "{overflow-y:auto;overflow-x:hidden;"
        + "overscroll-behavior:contain}")
        != -1;
}

// Two name-versus-value traps in one rule: `invisible` is the utility and
// `hidden` the CSS value; `float-start` is the utility and `inline-start` the
// CSS value. A transcription that carried either name through would emit a
// declaration the browser discards in silence.
test "the utility name is not the CSS value, twice in one rule" {
    val cls = emilia(flowValues());
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + "{visibility:hidden;isolation:isolate;"
        + "float:inline-start;clear:both;box-sizing:border-box;"
        + "box-decoration-break:clone}")
        != -1;
    assert doc.indexOf("visibility:invisible") == -1;
    assert doc.indexOf("float:start") == -1;
}

test "a column count is an integer; a column width is the theme's container" {
    val cls = emilia(columnLadder());
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + "{columns:2;columns:var(--container-md);columns:auto;"
        + "break-inside:avoid-column;break-after:page}")
        != -1;
}

test "the media card clips and isolates; its image is cropped, not squashed" {
    val cardCls = mediaCard();
    val imageCls = mediaImage();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cardCls
        + "{overflow:hidden;isolation:isolate;"
        + "border-radius:var(--radius-lg)}")
        != -1;
    assert doc.indexOf("."
        + imageCls
        + "{aspect-ratio:16 / 9;object-fit:cover;"
        + "object-position:center;width:100%}")
        != -1;
}

test "the sticky header stacks over a panel that scrolls on one axis" {
    val headerCls = stickyHeader();
    val panelCls = scrollPanel();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + headerCls
        + "{position:sticky;top:0;z-index:50;"
        + "background:#ffffff}")
        != -1;
    assert doc.indexOf("."
        + panelCls
        + "{overflow-y:auto;overscroll-behavior:contain;"
        + "max-height:100vh}")
        != -1;
}

test "the badge hangs off the corner on a negative inset" {
    val cardCls = relativeCard();
    val badgeCls = pinnedBadge();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cardCls
        + "{position:relative;"
        + "padding:calc(var(--spacing) * 4)}")
        != -1;
    assert doc.indexOf("."
        + badgeCls
        + "{position:absolute;"
        + "top:calc(var(--spacing) * -2);right:calc(var(--spacing) * -2);"
        + "z-index:10}")
        != -1;
}

// THE POINT OF THE FRONT. The same token list under a theme whose `--spacing`
// is half the stock value is the SAME CLASS with the SAME DECLARATIONS — the
// rule references the variable, it does not resolve it — and only the `:root`
// block moves.
test "halving the spacing base moves the theme and not one byte of the rule" {
    val tokens: Token[] = [.Layout.Position.Absolute, .Layout.Inset.T.4, .Layout.Z.50];
    val stock = emiliaWith(tokens, defaultTheme());
    val tight = emiliaWith(tokens, tightTheme());
    assert stock == tight;
    val doc = await flushWith(withTheme(defaultOptions(), tightTheme()));
    assert doc.indexOf("--spacing:0.125rem") != -1;
    assert doc.indexOf("."
        + stock
        + "{position:absolute;top:calc(var(--spacing) * 4);"
        + "z-index:50}")
        != -1;
}

// EVERY token in this document references the theme, this front's and the one
// `Border.Rounded.Lg` beside them: front 40 rewrote the radius ladder from a
// literal `rem` to `var(--radius-*)`, so the card that used to be this walk's
// one allowed length no longer is one.
test "no layout token in this example resolves a length" {
    val _a = emilia(displayValues());
    val _b = emilia(insetDirections());
    val _c = emilia(insetShapes());
    val _d = emilia(scrollBox());
    val _e = emilia(flowValues());
    val _f = emilia(columnLadder());
    val _g = stickyHeader();
    val _h = pinnedBadge();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("rem") == -1;
    assert doc.indexOf("inset-x") == -1;
    assert doc.indexOf("visibility:invisible") == -1;
    assert doc.indexOf("float:start") == -1;
    assert doc.indexOf("16/9") == -1;
}
