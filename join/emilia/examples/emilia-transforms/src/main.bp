// emilia-transforms — `§ 16`, and the property front 44 could animate and no
// token could set.
//
// Front 44 shipped `Transition.Transform`, which emits
// `transition-property:transform`. Until this front there was nothing in the
// library that wrote `transform`, `rotate`, `scale`, `translate`,
// `transform-origin`, `perspective` or `backface-visibility`, so that token
// named a transition over a property emilia could not produce. A card that
// lifts under the pointer, a chevron that flips when its disclosure opens, a
// toast that slides in from the edge and a modal that scales in are all one
// property, and emilia had a token for none of them.
//
// FIVE THINGS THIS FILE IS HERE TO SHOW, beyond the catalogue:
//
//   - `rotate`, `scale` AND `translate` ARE INDEPENDENT PROPERTIES IN v4.
//     Three tokens in one list are three declarations in one rule and none of
//     them overwrites another — which is why the 1.0.8 draft's
//     `transform:rotate(45deg) scale(1.1)` shape is superseded.
//   - THE AXES COMPOSE THROUGH `--tw-*` VARIABLES, as upstream v4's do: a
//     translate axis writes `--tw-translate-<axis>` and reads both, a skew axis
//     writes `--tw-skew-<axis>` and the five-variable `transform` chain, so
//     `translate-x` beside `translate-y` moves diagonally and two skews skew
//     on both axes.
//   - THE TWO DECIMAL CONVENTIONS ARE THE REFERENCE'S. `scale-50` is `.5` and
//     `zoom-50` is `0.5`, four subsections apart in the same section. Both are
//     copied; neither is remembered.
//   - THE PERSPECTIVE FAMILY IS A THEME NAMESPACE. Five `--perspective-*`
//     references and the `none` keyword, so a project that redefines
//     `--perspective-near` moves every rule that names it and not one byte of
//     any rule body.
//   - THE VARIABLES ARE REGISTERED. Each translate and skew class carries
//     upstream's `@property` blocks (the translate axes at `0`), and the flush
//     writes upstream's `properties` layer for an engine without `@property`.
//
// THIS FILE IS A CONSUMER PACKAGE, not a test inside the library: a consumer
// re-emits its own copy of the enum classes, so a `case` that crossed the
// package boundary used to fall through every arm (§ Maintainer rules).
// Asserting the full class bodies from outside is what catches that.
//
// Upstream: https://tailwindcss.com/docs/rotate · /scale · /skew · /translate ·
// /transform-origin · /perspective · /backface-visibility · /zoom

import {emilia, emiliaWith, flushWith, Token} from "emilia";
import {rawRotate, rawTranslate, transformEntries} from "emilia";
import {Theme, ThemeEntry, DarkMode, defaultTheme, extendTheme} from "emilia";
import {Rule, Block, Sheet, Options} from "emilia";
import {defaultOptions, withTheme, emptyTheme, themeValue} from "emilia";

// A document with no theme in it, so the assertions below read as the rules
// this example registered rather than as the stock theme's hundred variables.
fn bareOptions() -> Options {
    return withTheme(defaultOptions(), emptyTheme());
}

// The theme a project that uses `perspective-*` actually builds: the stock
// theme plus this front's five `--perspective-*` entries, which
// `defaultTheme()` does not carry.
fn deepTheme() -> Theme {
    return extendTheme(defaultTheme(), transformEntries());
}

// ── `§ 16.4` · rotate, both signs ────────────────────────────────────────────

// The five positive steps, one rule. `rotate` is a PROPERTY here, not a
// function inside `transform`.
pub fn everyRotation() -> string {
    val tokens: Token[] = [
        .Transform.Rotate.__0,
        .Transform.Rotate.__1,
        .Transform.Rotate.__45,
        .Transform.Rotate.__90,
        .Transform.Rotate.__180,
    ];
    return emilia(tokens);
}

// THE NEGATIVE HALF IS A SUB-SECTION AND NOT A SIGN. There is no spelling for a
// negative numeric leaf, so `-rotate-12` is `.Transform.Rotate.Neg.__12` —
// front 35's `Margin.*.Neg` convention, third use.
pub fn everyNegativeRotation() -> string {
    val tokens: Token[] = [
        .Transform.Rotate.Neg.__1,
        .Transform.Rotate.Neg.__12,
        .Transform.Rotate.Neg.__45,
        .Transform.Rotate.Neg.__90,
        .Transform.Rotate.Neg.__180,
    ];
    return emilia(tokens);
}

// ── `§ 16.5` · scale, three ladders ──────────────────────────────────────────

pub fn theScaleLadder() -> string {
    val tokens: Token[] = [
        .Transform.Scale.__0,
        .Transform.Scale.__50,
        .Transform.Scale.__75,
        .Transform.Scale.__90,
        .Transform.Scale.__95,
        .Transform.Scale.__100,
        .Transform.Scale.__105,
        .Transform.Scale.__110,
        .Transform.Scale.__125,
        .Transform.Scale.__150,
    ];
    return emilia(tokens);
}

// The two-value `scale`, the other axis pinned at `1`. A copy-paste between
// these two is invisible to a one-sided assertion.
pub fn theTwoAxes() -> string {
    val tokens: Token[] = [.Transform.ScaleX.__50, .Transform.ScaleY.__150];
    return emilia(tokens);
}

// ── `§ 16.10` · translate ────────────────────────────────────────────────────

pub fn theHorizontalLadder() -> string {
    val tokens: Token[] = [
        .Transform.TranslateX.__0,
        .Transform.TranslateX.Px,
        .Transform.TranslateX.__1,
        .Transform.TranslateX.Half,
        .Transform.TranslateX.Full,
    ];
    return emilia(tokens);
}

pub fn theVerticalLadder() -> string {
    val tokens: Token[] = [
        .Transform.TranslateY.__0,
        .Transform.TranslateY.Px,
        .Transform.TranslateY.__1,
        .Transform.TranslateY.Half,
        .Transform.TranslateY.Full,
    ];
    return emilia(tokens);
}

// ── `§ 16.6` · skew ──────────────────────────────────────────────────────────

// UPSTREAM's FORM, not the reference file's. `§ 16.6`'s column says
// `skew-x: 3deg`, which is not a registered CSS property; upstream v4 writes
// `--tw-skew-x: skewX(3deg)` and the `transform` chain, and so does this.
pub fn aSkewedPanel() -> string {
    val tokens: Token[] = [.Transform.SkewX.__3];
    return emilia(tokens);
}

// TWO SKEWS COMPOSE: each writes its own variable, and the chain reads both.
pub fn twoSkewsInOneRule() -> string {
    val tokens: Token[] = [.Transform.SkewX.__3, .Transform.SkewY.__6];
    return emilia(tokens);
}

// ── `§ 16.8`, `§ 16.9`, `§ 16.1` · origin, style, backface ───────────────────

pub fn everyOrigin() -> string {
    val tokens: Token[] = [
        .Transform.Origin.Center,
        .Transform.Origin.Top,
        .Transform.Origin.TopRight,
        .Transform.Origin.Right,
        .Transform.Origin.BottomRight,
        .Transform.Origin.Bottom,
        .Transform.Origin.BottomLeft,
        .Transform.Origin.Left,
        .Transform.Origin.TopLeft,
    ];
    return emilia(tokens);
}

// The 3-D surface the reference DOES enumerate: `transform-style` and
// `backface-visibility`. The name-versus-value trap is here —
// `transform-3d` emits `preserve-3d`.
pub fn aFlippableCardFace() -> string {
    val tokens: Token[] = [.Transform.Style.Preserve3d, .Transform.Backface.Hidden];
    return emilia(tokens);
}

// ── `§ 16.2`, `§ 16.3` · perspective ─────────────────────────────────────────

// FIVE REFERENCES AND ONE KEYWORD. The lengths the reference prints in
// parentheses are `transformEntries()`, composed into `deepTheme()`.
pub fn everyPerspective() -> string {
    val tokens: Token[] = [
        .Transform.Perspective.Dramatic,
        .Transform.Perspective.Near,
        .Transform.Perspective.Normal,
        .Transform.Perspective.Midrange,
        .Transform.Perspective.Distant,
    ];
    return emiliaWith(tokens, deepTheme());
}

pub fn flatOnPurpose() -> string {
    val tokens: Token[] = [.Transform.Perspective.None];
    return emiliaWith(tokens, deepTheme());
}

pub fn aSceneViewedFromBelow() -> string {
    val tokens: Token[] = [
        .Transform.Perspective.Near,
        .Transform.PerspectiveOrigin.Bottom,
        .Transform.Style.Preserve3d,
    ];
    return emiliaWith(tokens, deepTheme());
}

// The same scene under a project's own `--perspective-near`. The class does not
// move, because the rule names the variable and never its value.
pub fn theSameSceneUnderAProjectTheme() -> string {
    val mine: ThemeEntry[] = [ThemeEntry(name: "--perspective-near", value: "42px")];
    val tokens: Token[] = [
        .Transform.Perspective.Near,
        .Transform.PerspectiveOrigin.Bottom,
        .Transform.Style.Preserve3d,
    ];
    return emiliaWith(tokens, extendTheme(deepTheme(), mine));
}

// ── `§ 16.11` · zoom, and `§ 16.7` · the shorthand ───────────────────────────

pub fn theZoomLadder() -> string {
    val tokens: Token[] = [
        .Transform.Zoom.__0,
        .Transform.Zoom.__50,
        .Transform.Zoom.__75,
        .Transform.Zoom.__100,
        .Transform.Zoom.__125,
        .Transform.Zoom.__150,
        .Transform.Zoom.__200,
    ];
    return emilia(tokens);
}

// `transform-none` is the one row of `§ 16.7` that reads nothing, and the one
// a `prefers-reduced-motion` branch reaches for.
pub fn noTransform() -> string {
    val tokens: Token[] = [.Transform.Shorthand.None];
    return emilia(tokens);
}

// `transform-gpu`: upstream v4's `translateZ(0)` in front of the chain the skew
// leaves write.
pub fn theGpuShorthand() -> string {
    val tokens: Token[] = [.Transform.Shorthand.Gpu];
    return emilia(tokens);
}

// ── the escape hatches ───────────────────────────────────────────────────────

// `rotate-[17deg]` IS IN THE REFERENCE — `§ 16.4`'s HTML example prints it. The
// wrapper is the readable spelling of `.TransformRotateRaw("17deg")`.
pub fn anArbitraryRotation() -> string {
    val tokens: Token[] = [rawRotate("17deg")];
    return emilia(tokens);
}

// The centring idiom the five steps cannot spell: both axes at once.
pub fn pulledBackByHalfOfItself() -> string {
    val tokens: Token[] = [rawTranslate("-50% -50%")];
    return emilia(tokens);
}

// ── the two compositions this front exists for ───────────────────────────────

// A CARD THAT LIFTS AND GROWS UNDER THE POINTER, with front 44's transition
// making the motion visible rather than instantaneous. Three v4 properties in
// the hover rule, none overwriting another.
pub fn aLiftingCard() -> string {
    val lifted: Token[] = [
        .Transform.TranslateY.Px,
        .Transform.Scale.__105,
        .Effect.Shadow.Lg,
    ];
    val tokens: Token[] = [
        .Bg.Color.White,
        .Border.Rounded.Lg,
        .Effect.Shadow.Sm,
        .Transition.Base,
        .Transition.Duration.__200,
        Token.Hover(lifted),
    ];
    return emilia(tokens);
}

// A DISCLOSURE CHEVRON THAT FLIPS WHEN ITS PARENT OPENS. The rotation is front
// 45's, the `.group` selector is front 34's and the 200ms is front 44's; the
// origin is what stops it orbiting instead of spinning.
pub fn aFlippingChevron() -> string {
    val flipped: Token[] = [.Transform.Rotate.__180];
    val tokens: Token[] = [
        .Transition.Transform,
        .Transition.Duration.__200,
        .Transform.Origin.Center,
        Token.GroupOpen(flipped),
    ];
    return emilia(tokens);
}

pub fn main() -> void {
    return;
}

// ── tests ────────────────────────────────────────────────────────────────────

// THE FIVE POSITIVE STEPS AND THE FIVE NEGATIVE ONES, asserted WHOLE from
// outside the library. Five tokens in one list are five declarations of ONE
// property, so the last wins in a browser — what is being pinned here is the
// mapping, one row at a time, which is what a catalogue rule is for.

// The composed `box-shadow` every shadow and ring token writes beside its own
// channel (emilia front 40/41: upstream's five channels, each with its null
// shadow as a fallback), spelled once for this example's assertions.
fn chain() -> string {
    return "var(--tw-inset-shadow, 0 0 transparent), var(--tw-inset-ring-shadow, 0 0 transparent), var(--tw-ring-offset-shadow, 0 0 transparent), var(--tw-ring-shadow, 0 0 transparent), var(--tw-shadow, 0 0 transparent)";
}

test "rotate — the five steps of `§ 16.4`, and the property is `rotate`" {
    val cls = everyRotation();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + "{rotate:0deg;rotate:1deg;rotate:45deg;"
        + "rotate:90deg;rotate:180deg}")
        != -1;
    // the v4 property, never the v3 `transform:` function the 1.0.8 draft used
    assert doc.indexOf("transform:rotate(") == -1;
}

test "rotate — the negative half is a `Neg` sub-section, upstream's `calc(Ndeg * -1)`" {
    val cls = everyNegativeRotation();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + "{rotate:calc(1deg * -1);rotate:calc(12deg * -1);rotate:calc(45deg * -1);"
        + "rotate:calc(90deg * -1);rotate:calc(180deg * -1)}")
        != -1;
    assert doc.indexOf("rotate:-12deg") == -1;
    assert doc.indexOf("rotate:--") == -1;
}

fn scaled() -> string {
    return ";scale:var(--tw-scale-x) var(--tw-scale-y)";
}

fn scaleStep(v: string) -> string {
    return "--tw-scale-x:"
        + v
        + ";--tw-scale-y:"
        + v
        + ";--tw-scale-z:"
        + v
        + scaled();
}

// UPSTREAM v4's SCALE: a percentage in `--tw-scale-{x,y,z}` and one reader.
// The reference file's `scale:.5` is v3's shape and is absent.
test "scale — the ten steps, each a percentage in the three variables" {
    val cls = theScaleLadder();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + "{"
        + scaleStep("0%")
        + ";"
        + scaleStep("50%")
        + ";"
        + scaleStep("75%")
        + ";"
        + scaleStep("90%")
        + ";"
        + scaleStep("95%")
        + ";"
        + scaleStep("100%")
        + ";"
        + scaleStep("105%")
        + ";"
        + scaleStep("110%")
        + ";"
        + scaleStep("125%")
        + ";"
        + scaleStep("150%")
        + "}")
        != -1;
    assert doc.indexOf("scale:.5") == -1;
    assert doc.indexOf("@property --tw-scale-x{syntax:\"*\";inherits:false;initial-value:1}")
        != -1;
}

// EACH AXIS WRITES ITS OWN VARIABLE, so the two compose into one scale.
test "scale — the two axes, in one rule, each writing its own variable" {
    val cls = theTwoAxes();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + "{--tw-scale-x:50%"
        + scaled()
        + ";--tw-scale-y:150%"
        + scaled()
        + "}")
        != -1;
}

fn composed() -> string {
    return ";translate:var(--tw-translate-x) var(--tw-translate-y)";
}

// EVERY ROW WRITES ITS AXIS AND READS BOTH — upstream v4's form — and the
// document registers the three variables once, with the `0` upstream gives them.
test "translate — the five `x` rows, each writing `--tw-translate-x`" {
    val cls = theHorizontalLadder();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + "{--tw-translate-x:0"
        + composed()
        + ";--tw-translate-x:1px"
        + composed()
        + ";--tw-translate-x:calc(var(--spacing) * 1)"
        + composed()
        + ";--tw-translate-x:calc(1 / 2 * 100%)"
        + composed()
        + ";--tw-translate-x:100%"
        + composed()
        + "}")
        != -1;
    // `translate-x-1` is front 54's spacing ladder and never a resolved `rem`
    assert doc.indexOf("rem") == -1;
    assert doc.indexOf("@property --tw-translate-y{syntax:\"*\";inherits:false;initial-value:0}")
        != -1;
    assert doc.indexOf("@layer properties{") != -1;
}

test "translate — the five `y` rows, writing the other variable" {
    val cls = theVerticalLadder();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + "{--tw-translate-y:0"
        + composed()
        + ";--tw-translate-y:1px"
        + composed()
        + ";--tw-translate-y:calc(var(--spacing) * 1)"
        + composed()
        + ";--tw-translate-y:calc(1 / 2 * 100%)"
        + composed()
        + ";--tw-translate-y:100%"
        + composed()
        + "}")
        != -1;
}

fn skewChain() -> string {
    return "transform:var(--tw-rotate-x,) var(--tw-rotate-y,) var(--tw-rotate-z,) var(--tw-skew-x,) var(--tw-skew-y,)";
}

// UPSTREAM's FORM, and the reference file's column asserted ABSENT — the half
// that makes the divergence deliberate rather than a typo nobody noticed.
test "skew — `--tw-skew-x:skewX(3deg)` and the chain, and never the reference file's `skew-x:`" {
    val a = aSkewedPanel();
    val b = twoSkewsInOneRule();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + a
        + "{--tw-skew-x:skewX(3deg);"
        + skewChain()
        + "}")
        != -1;
    assert doc.indexOf("."
        + b
        + "{--tw-skew-x:skewX(3deg);"
        + skewChain()
        + ";--tw-skew-y:skewY(6deg);"
        + skewChain()
        + "}")
        != -1;
    assert doc.indexOf("{skew-x:") == -1;
    assert doc.indexOf(";skew-y:") == -1;
}

test "transform-origin — the nine rows, and a corner is two keywords" {
    val cls = everyOrigin();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + "{transform-origin:center;transform-origin:top;"
        + "transform-origin:top right;transform-origin:right;"
        + "transform-origin:bottom right;transform-origin:bottom;"
        + "transform-origin:bottom left;transform-origin:left;"
        + "transform-origin:top left}")
        != -1;
    assert doc.indexOf("top-right") == -1;
    assert doc.indexOf("bottom-left") == -1;
}

// THE NAME-VERSUS-VALUE TRAP: the class is `transform-3d` and the value is
// `preserve-3d`.
test "transform-style and backface — `transform-3d` emits `preserve-3d`" {
    val cls = aFlippableCardFace();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + "{transform-style:preserve-3d;backface-visibility:hidden}")
        != -1;
    assert doc.indexOf("transform-style:3d") == -1;
}

// FIVE REFERENCES AND NO LENGTH. The values live in the theme layer this
// example composes, which is the whole argument of the row.
test "perspective — five references, one keyword, and no `px` in any rule" {
    val a = everyPerspective();
    val b = flatOnPurpose();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + a
        + "{perspective:var(--perspective-dramatic);"
        + "perspective:var(--perspective-near);"
        + "perspective:var(--perspective-normal);"
        + "perspective:var(--perspective-midrange);"
        + "perspective:var(--perspective-distant)}")
        != -1;
    assert doc.indexOf("." + b + "{perspective:none}") != -1;
    assert doc.indexOf("perspective:100px") == -1;
    assert doc.indexOf("perspective:1200px") == -1;
    // and the values ARE in the library — in the theme, which is where they go
    assert themeValue(deepTheme(), "--perspective-dramatic") == "100px";
    assert themeValue(deepTheme(), "--perspective-distant") == "1200px";
}

test "perspective-origin — a scene viewed from below, three declarations" {
    val cls = aSceneViewedFromBelow();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + "{perspective:var(--perspective-near);"
        + "perspective-origin:bottom;transform-style:preserve-3d}")
        != -1;
}

// THE FRONT'S ARGUMENT FOR A REFERENCE OVER A LITERAL, asserted from a CONSUMER
// package: a project's own `--perspective-near` gives the SAME class and the
// SAME rule. Only the theme layer moves.
test "perspective — a project's own value moves the theme layer and not one rule" {
    val stock = aSceneViewedFromBelow();
    val mine = theSameSceneUnderAProjectTheme();
    assert stock == mine;
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("42px") == -1;
}

// TWO CONVENTIONS, ASSERTED TOGETHER: a scale step is upstream's percentage,
// and `§ 16.11`'s zoom keeps the reference's bare number with its leading zero.
test "zoom — the seven rows, with the leading zero the reference prints" {
    val z = theZoomLadder();
    val s = theScaleLadder();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + z
        + "{zoom:0;zoom:0.5;zoom:0.75;zoom:1;zoom:1.25;"
        + "zoom:1.5;zoom:2}")
        != -1;
    assert doc.indexOf("." + s + "{--tw-scale-x:0%;") != -1;
}

// UPSTREAM v4's `transform-gpu`: `translateZ(0)` and the chain a skew writes.
test "the shorthand — `translateZ(0)` in front of the skew chain" {
    val g = theGpuShorthand();
    val n = noTransform();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + g
        + "{transform:translateZ(0) var(--tw-rotate-x,) var(--tw-rotate-y,) "
        + "var(--tw-rotate-z,) var(--tw-skew-x,) var(--tw-skew-y,)}")
        != -1;
    assert doc.indexOf("." + n + "{transform:none}") != -1;
}

test "the escape hatches — the arbitrary rotation `§ 16.4` prints, and a centring translate" {
    val r = anArbitraryRotation();
    val t = pulledBackByHalfOfItself();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("." + r + "{rotate:17deg}") != -1;
    assert doc.indexOf("." + t + "{translate:-50% -50%}") != -1;
    // the raw translate writes BOTH axes and reads neither variable
    assert doc.indexOf("." + t + "{translate:-50% -50%}") != -1;
}

// END TO END — the card the front exists for. Three v4 properties in the hover
// rule, none overwriting another, with front 44's transition in the base rule
// making the motion visible.
test "end to end — a card that lifts, grows and deepens its shadow on hover" {
    val cls = aLiftingCard();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + "{background-color:var(--color-white);"
        + "border-radius:var(--radius-lg);"
        + "--tw-shadow:var(--shadow-sm);box-shadow:"
        + chain()
        + ";"
        + "transition-property:color, background-color, border-color, "
        + "text-decoration-color, fill, stroke, opacity, box-shadow, transform, "
        + "filter, backdrop-filter;"
        + "transition-timing-function:var(--ease-out);transition-duration:150ms;"
        + "transition-duration:200ms}")
        != -1;
    assert doc.indexOf("@media (hover: hover){."
        + cls
        + ":hover{--tw-translate-y:1px"
        + composed()
        + ";"
        + scaleStep("105%")
        + ";"
        + "--tw-shadow:var(--shadow-lg);box-shadow:"
        + chain()
        + "}}")
        != -1;
}

// END TO END — the chevron. The rotation is this front's, the `.group` selector
// front 34's and the duration front 44's.
test "end to end — a chevron that flips 180° when its disclosure opens" {
    val cls = aFlippingChevron();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("."
        + cls
        + "{transition-property:transform;"
        + "transition-timing-function:var(--ease-out);transition-duration:150ms;"
        + "transition-duration:200ms;transform-origin:center}")
        != -1;
    assert doc.indexOf(":is(:where(.group):is([open], :popover-open, :open) *)")
        != -1;
    assert doc.indexOf("rotate:180deg}") != -1;
}

// THE FRONT'S ARGUMENT, asserted over everything this example emits: nothing it
// renders resolves a length, and the composed properties really are three
// separate declarations rather than one `transform:` chain. The probe is shown
// to discriminate — the document is not empty and does carry the references
// those literals would have replaced.
test "no token in this example resolves a length, and the v4 properties compose" {
    val _a = everyRotation();
    val _b = theScaleLadder();
    val _c = theHorizontalLadder();
    val _d = everyPerspective();
    val _e = aLiftingCard();
    val doc = await flushWith(bareOptions());
    assert doc.indexOf("rem") == -1;
    assert doc.indexOf("perspective:300px") == -1;
    assert doc.indexOf("var(--perspective-near)") != -1;
    assert doc.indexOf("calc(var(--spacing) * 1)") != -1;
    // the composition: three properties, three declarations, one rule
    assert doc.indexOf("--tw-translate-y:1px"
        + composed()
        + ";"
        + scaleStep("105%"))
        != -1;
    // the only `1px` in the document is `translate-*-px`'s, which is the
    // reference's own literal value and not a theme lookup
    assert doc.indexOf("--tw-translate-x:1px" + composed()) != -1;
}
