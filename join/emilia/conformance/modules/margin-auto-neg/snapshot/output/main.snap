botopink-cell 1
out Margin.All.Auto -> margin:auto
out Margin.X.Auto -> margin-left:auto;margin-right:auto
out Margin.T.Neg.4 -> margin-top:calc(var(--spacing) * -4)
out Margin.X.Neg.2 -> margin-left:calc(var(--spacing) * -2);margin-right:calc(var(--spacing) * -2)
out Margin.T.Neg.Px -> margin-top:-1px
