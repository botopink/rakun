import {Token, styleRule, decodeSheet, declarationsOf, defaultTheme} from "emilia";

fn show(name: string, tokens: Token[]) {
    val sheet = decodeSheet(styleRule(tokens, defaultTheme())._1);
    @print(name + " -> " + declarationsOf(sheet).join(" | "));
}

pub fn main() {
    show("Size.W.64", [.Size.W.64]);
    show("Size.W.Px", [.Size.W.Px]);
    show("Size.W.Frac.Half", [.Size.W.Frac.Half]);
    show("Size.W.Frac.Third", [.Size.W.Frac.Third]);
    show("Size.W.Full", [.Size.W.Full]);
    show("Size.W.Min", [.Size.W.Min]);
    show("Size.W.Auto", [.Size.W.Auto]);
}
