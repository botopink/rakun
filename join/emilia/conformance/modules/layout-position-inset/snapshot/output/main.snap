botopink-cell 1
out Layout.Position.Absolute -> position:absolute
out Layout.Position.Sticky -> position:sticky
out Layout.Inset.All.0 -> inset:0
out Layout.Inset.X.0 -> left:0;right:0
out Layout.Inset.Y.0 -> top:0;bottom:0
out Layout.Inset.T.4 -> top:calc(var(--spacing) * 4)
out Layout.Inset.T.Neg.4 -> top:calc(var(--spacing) * -4)
out Layout.Inset.T.Half.0 -> top:calc(var(--spacing) * 0.5)
out Layout.Inset.T.Frac.Half -> top:calc(1 / 2 * 100%)
out Layout.Inset.T.Full -> top:100%
out Layout.Inset.T.Auto -> top:auto
out Layout.Inset.S.0 -> inset-inline-start:0
out Layout.Inset.E.0 -> inset-inline-end:0
