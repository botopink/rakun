import {Token, styleRule, decodeSheet, declarationsOf, defaultTheme} from "emilia";

fn show(name: string, tokens: Token[]) {
    val sheet = decodeSheet(styleRule(tokens, defaultTheme())._1);
    @print(name + " -> " + declarationsOf(sheet).join(" | "));
}

pub fn main() {
    show("Bg.Color.Red.500", [.Bg.Color.Red.500]);
    show("Bg.Color.Sky.100", [.Bg.Color.Sky.100]);
    show("Bg.Color.Slate.900", [.Bg.Color.Slate.900]);
    show("Bg.Color.Taupe.950", [.Bg.Color.Taupe.950]);
    show("Bg.Color.White", [.Bg.Color.White]);
    show("Bg.Color.Black", [.Bg.Color.Black]);
    show("Bg.Color.Transparent", [.Bg.Color.Transparent]);
    show("Bg.Color.Current", [.Bg.Color.Current]);
    show("Bg.Color.Inherit", [.Bg.Color.Inherit]);
}
