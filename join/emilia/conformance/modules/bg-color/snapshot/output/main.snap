botopink-cell 1
out Bg.Color.Red.500 -> background-color:var(--color-red-500)
out Bg.Color.Sky.100 -> background-color:var(--color-sky-100)
out Bg.Color.Slate.900 -> background-color:var(--color-slate-900)
out Bg.Color.Taupe.950 -> background-color:var(--color-taupe-950)
out Bg.Color.White -> background-color:var(--color-white)
out Bg.Color.Black -> background-color:var(--color-black)
out Bg.Color.Transparent -> background-color:transparent
out Bg.Color.Current -> background-color:currentColor
out Bg.Color.Inherit -> background-color:inherit
