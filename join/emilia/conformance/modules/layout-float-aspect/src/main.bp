import {Token, styleRule, decodeSheet, declarationsOf, defaultTheme} from "emilia";

fn show(name: string, tokens: Token[]) {
    val sheet = decodeSheet(styleRule(tokens, defaultTheme())._1);
    @print(name + " -> " + declarationsOf(sheet).join(" | "));
}

pub fn main() {
    show("Layout.Float.Start", [.Layout.Float.Start]);
    show("Layout.Float.Left", [.Layout.Float.Left]);
    show("Layout.Clear.Start", [.Layout.Clear.Start]);
    show("Layout.Clear.Both", [.Layout.Clear.Both]);
    show("Layout.Object.Fit.Cover", [.Layout.Object.Fit.Cover]);
    show("Layout.Object.Pos.LeftBottom", [.Layout.Object.Pos.LeftBottom]);
    show("Layout.Aspect.Square", [.Layout.Aspect.Square]);
    show("Layout.Aspect.Video", [.Layout.Aspect.Video]);
}
