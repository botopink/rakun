botopink-cell 1
out Text.Underline -> text-decoration-line:underline
out Text.Overline -> text-decoration-line:overline
out Text.LineThrough -> text-decoration-line:line-through
out Text.NoUnderline -> text-decoration-line:none
out Text.Decoration.Style.Wavy -> text-decoration-style:wavy
out Text.Decoration.Thickness.2 -> text-decoration-thickness:2px
out Text.Decoration.Thickness.FromFont -> text-decoration-thickness:from-font
out Text.Decoration.Offset.4 -> text-underline-offset:4px
out Text.Decoration.Color.Sky.500 -> text-decoration-color:var(--color-sky-500)
