import {defaultTheme, extendTheme, transformEntries, themeValue} from "emilia";

pub fn main() {
    val th = extendTheme(defaultTheme(), transformEntries());
    @print(themeValue(th, "--perspective-dramatic"));
    @print(themeValue(th, "--perspective-near"));
    @print(themeValue(th, "--perspective-normal"));
    @print(themeValue(th, "--perspective-midrange"));
    @print(themeValue(th, "--perspective-distant"));
}
