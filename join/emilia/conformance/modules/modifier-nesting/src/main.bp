import {Token, emilia, flushWith, defaultOptions, withTheme, emptyTheme} from "emilia";

fn doc(name: string, tokens: Token[]) -> @Task<void> {
    emilia(tokens);
    @print(name);
    @print(await flushWith(withTheme(defaultOptions(), emptyTheme())));
}

pub fn main() -> @Task<void> {
    await doc("nested", [Token.Dark([Token.Md([Token.Hover([.Text.Bold])])])]);
}
