import {Token, styleRule, decodeSheet, declarationsOf, defaultTheme, rawRotate, rawTranslate} from "emilia";

fn show(name: string, tokens: Token[]) {
    val sheet = decodeSheet(styleRule(tokens, defaultTheme())._1);
    @print(name + " -> " + declarationsOf(sheet).join(" | "));
}

pub fn main() {
    show("raw-rotate", [rawRotate("17deg")]);
    show("raw-translate", [rawTranslate("-50% -50%")]);
}
