import {Token, styleRule, decodeSheet, declarationsOf, defaultTheme} from "emilia";

fn show(name: string, tokens: Token[]) {
    val sheet = decodeSheet(styleRule(tokens, defaultTheme())._1);
    @print(name + " -> " + declarationsOf(sheet).join(" | "));
}

pub fn main() {
    show("Layout.Block", [.Layout.Block]);
    show("Layout.InlineBlock", [.Layout.InlineBlock]);
    show("Layout.Inline", [.Layout.Inline]);
    show("Layout.Flex", [.Layout.Flex]);
    show("Layout.InlineFlex", [.Layout.InlineFlex]);
    show("Layout.Grid", [.Layout.Grid]);
    show("Layout.InlineGrid", [.Layout.InlineGrid]);
    show("Layout.Contents", [.Layout.Contents]);
    show("Layout.FlowRoot", [.Layout.FlowRoot]);
    show("Layout.ListItem", [.Layout.ListItem]);
    show("Layout.Hidden", [.Layout.Hidden]);
}
