botopink-cell 1
out Border.W.1 -> border-width:1px
out Border.W.0 -> border-width:0
out Border.W.8 -> border-width:8px
out Border.W.X.1 -> border-left-width:1px;border-right-width:1px
out Border.W.Y.2 -> border-top-width:2px;border-bottom-width:2px
out Border.W.T.4 -> border-top-width:4px
out Border.W.S.1 -> border-inline-start-width:1px
out Border.W.E.1 -> border-inline-end-width:1px
out Border.Style.Solid -> border-style:solid
out Border.Style.Dashed -> border-style:dashed
out Border.Style.Hidden -> border-style:hidden
out Border.Style.None -> border-style:none
out Border.Color.Slate.200 -> border-color:var(--color-slate-200)
out Border.Color.White -> border-color:var(--color-white)
out Border.Color.Transparent -> border-color:transparent
out Border.Color.Current -> border-color:currentColor
