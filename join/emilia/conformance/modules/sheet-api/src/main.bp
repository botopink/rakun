import {Rule, Block, Sheet, Variant, Options, emptySheet, declSheet, staticSheet, blockSheet, mergeSheet, declarationsOf, layerNames, nestVariant, markImportant, encodeSheet, decodeSheet, carriesSeparator, defaultOptions, withTheme, withBase, withPrefix, withImportant, withLayers, renderRule, renderDocument} from "emilia";

fn render(s: Sheet, o: Options) -> string {
    return s.rules.map({ r -> renderRule("c", r, o) }).join("");
}

pub fn main() {
    @print(layerNames().join(","));
    @print(declarationsOf(emptySheet()).length);
    @print(declarationsOf(declSheet("")).length);
    val both = mergeSheet(declSheet("color:red"), declSheet("margin:0"));
    @print(declarationsOf(both).join(" | "));
    @print(declarationsOf(markImportant(both)).join(" | "));
    @print(render(markImportant(both), defaultOptions()));
    @print(render(both, withPrefix(defaultOptions(), "tw_")));
    val literal = staticSheet("base", "html", "line-height:1.5");
    @print(render(literal, withPrefix(defaultOptions(), "tw_")));
    val kf = blockSheet("@keyframes spin", "{to{transform:rotate(360deg)}}");
    @print(kf.blocks.length);
    @print(kf.rules.length);
    val round = decodeSheet(encodeSheet(both));
    @print(declarationsOf(round).join(" | "));
    @print(carriesSeparator("a;b"));
}
