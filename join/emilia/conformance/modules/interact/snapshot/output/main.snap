botopink-cell 1
out carousel
out <style>@layer theme, base, components, utilities;@layer utilities{.e_7e9f2825{scroll-snap-type:x var(--tw-scroll-snap-strictness, proximity);--tw-scroll-snap-strictness:mandatory;scroll-behavior:smooth}}</style>
out handle
out <style>@layer theme, base, components, utilities;@layer utilities{.e_603278c6{cursor:grab;user-select:none}.e_603278c6:active{cursor:grabbing}}</style>
out overlay
out <style>@layer theme, base, components, utilities;@layer utilities{.e_5d078e2b{pointer-events:none}}</style>
out checkbox
out <style>@layer theme, base, components, utilities;@layer utilities{.e_d2b30ecf{accent-color:var(--color-indigo-600)}}</style>
