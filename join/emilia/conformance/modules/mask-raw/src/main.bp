import {Token, emilia, flushWith, defaultOptions, withTheme, emptyTheme, rawMaskImage} from "emilia";

fn doc(name: string, tokens: Token[]) -> @Task<void> {
    emilia(tokens);
    @print(name);
    @print(await flushWith(withTheme(defaultOptions(), emptyTheme())));
}

pub fn main() -> @Task<void> {
    val tokens: Token[] = [
        rawMaskImage("linear-gradient(to bottom, black 60%, transparent)"),
        .Mask.Repeat.NoRepeat,
    ];
    await doc("mask", tokens);
}
