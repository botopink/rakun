import {ThemeEntry, defaultTheme, extendTheme, themeValue} from "emilia";

// The vendor package's entries — a function in its module.
fn vendorEntries() -> ThemeEntry[] {
    val out: ThemeEntry[] = [ThemeEntry(name: "--radius-pill", value: "9999px")];
    return out;
}

pub fn main() {
    val composed = extendTheme(defaultTheme(), vendorEntries());
    assert themeValue(composed, "--radius-pill") == "9999px"; // the vendor's
    assert themeValue(composed, "--radius-lg") == "0.5rem"; // emilia's
    @print(themeValue(composed, "--radius-pill"));
    @print(themeValue(composed, "--radius-lg"));
}
