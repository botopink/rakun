botopink-cell 1
out Outline.W.2 -> outline-width:2px
out Outline.Style.Solid -> outline-style:solid
out Outline.Style.Dashed -> outline-style:dashed
out Outline.Color.Blue.500 -> outline-color:var(--color-blue-500)
out Outline.Offset.2 -> outline-offset:2px
out Outline.Offset.Neg.1 -> outline-offset:-1px
out Outline.Style.None -> outline:2px solid transparent;outline-offset:2px
