botopink-cell 1
out Border.Rounded.None -> border-radius:0
out Border.Rounded.Sm -> border-radius:var(--radius-sm)
out Border.Rounded.Lg -> border-radius:var(--radius-lg)
out Border.Rounded.X2xl -> border-radius:var(--radius-2xl)
out Border.Rounded.Full -> border-radius:9999px
out Border.Rounded.T.Lg -> border-top-left-radius:var(--radius-lg);border-top-right-radius:var(--radius-lg)
out Border.Rounded.Tl.Lg -> border-top-left-radius:var(--radius-lg)
out Border.Rounded.B.None -> border-bottom-right-radius:0;border-bottom-left-radius:0
out Border.Rounded.Ss.Md -> border-start-start-radius:var(--radius-md)
