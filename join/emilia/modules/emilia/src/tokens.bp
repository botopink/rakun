        // ── front 39 — backgrounds ────────────────────────────────
        //
        // Appended AFTER front 33's `Color` block and the legacy leaves, never
        // interleaved with them: two fronts write into these braces and an
        // additive tail is the only diff that merges. Every sub-section below
        // is keyword-only — one declaration, no theme lookup, no length — and
        // the gradient half of `§ 10.4` lives in the top-level `Gradient`
        // section rather than under `Image`, because a stop sets a custom
        // property and not `background-image` at all.
        Attachment {
            Fixed,
            Local,
            Scroll,
        }
        Clip {
            Border,
            Padding,
            Content,
            Text,
        }
