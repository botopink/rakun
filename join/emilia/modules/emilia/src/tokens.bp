    // ── end front 39 ────────────────────────────────────────

    // front 33 — the `/N` opacity wrapper (see the banner above `Color`).
    Alpha(percent: i32, inner: Token[]),
    // ── end front 33 ─────────────────────────────────────────────────────────

    // ── front 34 — modifiers ─────────────────────────────────────────────────
    //
    // Every variant below wraps OTHER fronts' declarations; this front adds
    // none of its own. Each answers one `Variant` — an at-rule and a selector
    // template with exactly one `&` — and `nestVariant` in `output.bp` applies
    // it. The map from a name to its emitted CSS is the table in the module
    // docblock above; the functions are in `emilia.bp` under the same banner.
    //
    // breakpoints — min-width, read from the theme's `--breakpoint-*` ladder
    Sm(inner: Token[]),
    Md(inner: Token[]),
    Lg(inner: Token[]),
    Xl(inner: Token[]),
    X2xl(inner: Token[]),
    //
    // breakpoints — max-width, the same ladder read the other way
    MaxSm(inner: Token[]),
    MaxMd(inner: Token[]),
    MaxLg(inner: Token[]),
    MaxXl(inner: Token[]),
    MaxX2xl(inner: Token[]),
    //
    // dark mode and the other media features
    Dark(inner: Token[]),
    Print(inner: Token[]),
    Portrait(inner: Token[]),
    Landscape(inner: Token[]),
    MotionSafe(inner: Token[]),
    MotionReduce(inner: Token[]),
    ContrastMore(inner: Token[]),
    ContrastLess(inner: Token[]),
    ForcedColors(inner: Token[]),
    //
    // interaction state
    Hover(inner: Token[]),
    Focus(inner: Token[]),
    FocusWithin(inner: Token[]),
    FocusVisible(inner: Token[]),
    Active(inner: Token[]),
    Visited(inner: Token[]),
    Target(inner: Token[]),
    Open(inner: Token[]),
    Inert(inner: Token[]),
    //
    // form state
    Disabled(inner: Token[]),
    Enabled(inner: Token[]),
    Checked(inner: Token[]),
    Indeterminate(inner: Token[]),
    Default(inner: Token[]),
    Optional(inner: Token[]),
    Required(inner: Token[]),
    Valid(inner: Token[]),
    Invalid(inner: Token[]),
    UserValid(inner: Token[]),
    UserInvalid(inner: Token[]),
    InRange(inner: Token[]),
    OutOfRange(inner: Token[]),
    PlaceholderShown(inner: Token[]),
    Autofill(inner: Token[]),
    ReadOnly(inner: Token[]),
    //
    // structural position
    First(inner: Token[]),
    Last(inner: Token[]),
    Only(inner: Token[]),
    Odd(inner: Token[]),
    Even(inner: Token[]),
    FirstOfType(inner: Token[]),
    LastOfType(inner: Token[]),
    OnlyOfType(inner: Token[]),
    Empty(inner: Token[]),
    Nth(index: i32, inner: Token[]),
    NthLast(index: i32, inner: Token[]),
    //
    // pseudo-elements
    Before(inner: Token[]),
    After(inner: Token[]),
    FirstLetter(inner: Token[]),
    FirstLine(inner: Token[]),
    Placeholder(inner: Token[]),
    File(inner: Token[]),
    Marker(inner: Token[]),
    Selection(inner: Token[]),
    Backdrop(inner: Token[]),
    //
    // parent state — the `.group` class is the consumer's, never emilia's
    GroupHover(inner: Token[]),
    GroupFocus(inner: Token[]),
    GroupActive(inner: Token[]),
    GroupVisited(inner: Token[]),
    GroupDisabled(inner: Token[]),
    GroupOpen(inner: Token[]),
    //
    // sibling state — the `.peer` class is the consumer's, never emilia's
    PeerHover(inner: Token[]),
    PeerFocus(inner: Token[]),
    PeerActive(inner: Token[]),
    PeerChecked(inner: Token[]),
    PeerInvalid(inner: Token[]),
    PeerRequired(inner: Token[]),
    PeerDisabled(inner: Token[]),
    PeerPlaceholderShown(inner: Token[]),
    //
    // named groups and peers (decision 401) — `group/card`, `peer/field`. The
    // payload is the list of unnamed group / peer state tokens whose `.group` /
    // `.peer` it names: `GroupNamed("card", [.GroupHover(…)])` is
    // `group-hover/card:`. Every unnamed state is thereby available named.
    GroupNamed(name: string, inner: Token[]),
    PeerNamed(name: string, inner: Token[]),
    //
    // writing direction and descent
    Rtl(inner: Token[]),
    Ltr(inner: Token[]),
    Children(inner: Token[]),
    Descendants(inner: Token[]),
    //
    // the priority wrapper — not a variant, a flag on every rule it wraps
    Important(inner: Token[]),
    // ── end front 34 ─────────────────────────────────────────────────────────

    // ── front 57 — escape hatches ────────────────────────────────────────────
    //
    // Six TOP-LEVEL variants, builtin-typed fields only; built through
    // `arbitrary.bp`'s validating builders (`arbValue`, `arbProp`, `arbSel`,
    // `arbAt`, `arbMin`, `arbMax`), and every payload re-checked when it is
    // dispatched.
    Arb(prop: string, value: string),
    ArbProp(name: string, value: string),
    ArbVariant(selector: string, inner: Token[]),
    ArbAt(query: string, inner: Token[]),
    ArbMin(px: string, inner: Token[]),
    ArbMax(px: string, inner: Token[]),
    // ── end front 57 ─────────────────────────────────────────────────────────

    // ── front 58 — container queries ─────────────────────────────────────────
    //
    // The payload-free markers are a section; everything carrying a payload is
    // top-level and built through `container.bp` (`containerName`,
    // `containerAtMd(inner)` …, `containerNamed(size, name, inner)`).
    Container {
        Inline,
        Normal,
        Size,
    }
    ContainerNamed(name: string),
    ContainerAt(size: string, inner: Token[]),
    ContainerAtNamed(size: string, name: string, inner: Token[]),
    // ── end front 58 ─────────────────────────────────────────────────────────
}
