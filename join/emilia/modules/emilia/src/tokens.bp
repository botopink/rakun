    // Colour-carrying variants are TOP-LEVEL, never section leaves; each field
    // carries front 33's `paletteVar(family, shade)`.
    InteractAccent(value: string),
    InteractCaret(value: string),
    InteractScrollbarColor(thumb: string, track: string),
    // ── end front 46 ─────────────────────────────────────────────────────────

    // ── front 47 — svg and accessibility ─────────────────────────────────────
    //
    // `§ 18` and `§ 19`. HEAD AUDIT: `Svg`, `Fill`, `Stroke`, `StrokeWidth`,
    // `A11y`, `ForcedColorAdjust` repeat no top-level payload variant.
    Svg {
