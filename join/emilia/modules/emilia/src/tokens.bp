            ZoomIn,
            ZoomOut,
        }
        Appearance {
            None,
            Auto,
        }
        FieldSizing {
            Fixed,
            Content,
        }
        ColorScheme {
            Normal,
            Light,
            Dark,
            LightDark,
            OnlyDark,
            OnlyLight,
        }
        PointerEvents {
            None,
            Auto,
        }
        Resize {
            None,
            Y,
            X,
            Both,
        }
        Select {
            None,
            Text,
            All,
            Auto,
        }
        WillChange {
            Auto,
