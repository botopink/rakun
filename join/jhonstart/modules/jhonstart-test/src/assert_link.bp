//// jhonstart-test/assert_link — a `Link` and a client transition (front 27).

import {Element} from "jhonstart";
import {harness.Navigation};
import {assert_html.htmlText};
import {assertAs} from "snap";

// `from`, `to` (the layout keys, space-joined), `shared` (the depth), `keep`
// (the keys kept mounted), `remount` (the keys replaced).
pub fn navigationText(n: Navigation) -> string {
    val lines: string[] = [
        "from: " + n.fromKeys.join(" "),
        "to: " + n.toKeys.join(" "),
        "shared: " + n.shared.toString(),
        "keep: " + n.keep.join(" "),
        "remount: " + n.remount.join(" "),
    ];
    return lines.join("\n");
}

pub fn assertLink(loc: SourceLocation, l: Element) -> @Result<void, string> {
    try assertAs(loc, "link", htmlText(l));
    return;
}

pub fn assertNavigation(loc: SourceLocation, n: Navigation) -> @Result<void, string> {
    try assertAs(loc, "navigation", navigationText(n));
    return;
}
