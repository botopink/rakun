//// jhonstart-test/assert_html — an `Element` as snapshot text (front 94).
////
//// `renderToString` is the frozen renderer every snapshot of a built tree reads
//// (a void element renders `<input …></input>` here; front 30's `renderNode`
//// is the shipping renderer, snapshotted through `assertText`).

import {Element, renderToString} from "jhonstart";
import {assertAs} from "snap";

// `renderToString(e)`, one line.
pub fn htmlText(e: Element) -> string {
    return renderToString(e);
}

// `renderToString(e)` with every `><` boundary broken into `>\n<` — one tag
// per line, for documents and forms.
pub fn htmlLinesText(e: Element) -> string {
    return tagPerLine(renderToString(e));
}

// A markup string, one tag per line.
pub fn tagPerLine(markup: string) -> string {
    return markup.split("><").join(">\n<");
}

pub fn assertHtml(loc: SourceLocation, e: Element) -> @Result<void, string> {
    try assertAs(loc, "html", htmlText(e));
    return;
}

pub fn assertHtmlLines(loc: SourceLocation, e: Element) -> @Result<void, string> {
    try assertAs(loc, "html", htmlLinesText(e));
    return;
}
