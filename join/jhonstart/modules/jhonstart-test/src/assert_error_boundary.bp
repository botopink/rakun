//// jhonstart-test/assert_error_boundary — a boundary's outcome (front 31).

import {ErrorBoundary, renderBoundaryChecked, renderToString} from "jhonstart";
import {assertAs} from "snap";

// `outcome: ok` and the markup on the next line, or `outcome: error <reason>`.
pub fn errorBoundaryText(b: ErrorBoundary) -> string {
    val out = renderBoundaryChecked(b);
    return case out {
        Ok(tree) -> "outcome: ok\n" + renderToString(tree);
        Error(reason) -> "outcome: error " + reason;
    };
}

pub fn assertErrorBoundary(loc: SourceLocation, b: ErrorBoundary) -> @Result<void, string> {
    try assertAs(loc, "boundary", errorBoundaryText(b));
    return;
}
