//// jhonstart-test/assert_metadata — the head and the viewport (front 32).

import {Metadata, Viewport, renderHead, renderViewport} from "jhonstart";
import {assert_html.tagPerLine};
import {assertAs} from "snap";

// `renderHead(m)`, one tag per line; an empty head is the empty text.
pub fn metadataText(m: Metadata) -> string {
    return tagPerLine(renderHead(m));
}

pub fn viewportText(v: Viewport) -> string {
    return tagPerLine(renderViewport(v));
}

pub fn assertMetadata(loc: SourceLocation, m: Metadata) -> @Result<void, string> {
    try assertAs(loc, "metadata", metadataText(m));
    return;
}

pub fn assertViewport(loc: SourceLocation, v: Viewport) -> @Result<void, string> {
    try assertAs(loc, "viewport", viewportText(v));
    return;
}
