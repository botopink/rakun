//// jhonstart-test/assert_route — a route snapshot and an active nav (front 26).

import {Element, RouterState} from "jhonstart";
import {encoding} from "std";
import {assertAs} from "snap";

// Seven `key: value` lines: `path`, `pattern`, `params` and `search`
// (querystring), `selected`, `segments` (space-joined, the bracket spelling
// kept), `segment`.
pub fn routeText(r: RouterState) -> string {
    val lines: string[] = [
        "path: " + r.path,
        "pattern: " + r.pattern,
        "params: " + encoding.formStringify(r.params),
        "search: " + encoding.formStringify(r.search),
        "selected: " + r.selected.toString(),
        "segments: " + r.segments().join(" "),
        "segment: " + r.segment(),
    ];
    return lines.join("\n");
}

fn attrOf(e: Element, name: string) -> string {
    var out = "";
    for (e.attrs) { a ->
        if (a._0 == name) out = a._1;
    }
    return out;
}

fn anchorsOf(e: Element) -> Array<Element> {
    var out: Array<Element> = [];
    if (e.tag == "a") out = out.append([e]);
    for (e.children) { c ->
        out = out.append(anchorsOf(c));
    }
    return out;
}

fn anchorLine(a: Element) -> string {
    val cls = attrOf(a, "class");
    val active = cls.split(" ").contains("active");
    val mark = if (active) "[*]" else "[ ]";
    return mark + " " + attrOf(a, "href") + " " + cls;
}

// Line 1 `path: <path>`, then one line per `a` in tree order: `[*]` when its
// `class` holds `active`, else `[ ]`, then the `href` and the `class`.
pub fn activeLinkText(nav: Element, path: string) -> string {
    var lines: string[] = ["path: " + path];
    for (anchorsOf(nav)) { a ->
        lines.push(anchorLine(a));
    }
    return lines.join("\n");
}

pub fn assertRoute(loc: SourceLocation, r: RouterState) -> @Result<void, string> {
    try assertAs(loc, "route", routeText(r));
    return;
}

pub fn assertActiveLink(loc: SourceLocation, nav: Element, path: string) -> @Result<void, string> {
    try assertAs(loc, "route", activeLinkText(nav, path));
    return;
}
