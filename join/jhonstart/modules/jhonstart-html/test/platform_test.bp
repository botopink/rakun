// What a template body may write (front 118 step 0). Each test below runs a
// small template function whose body uses one construct, on both evaluators
// (`botopink test --target commonJS` evaluates comptime on the wat runtime,
// `--target erlang` on BEAM). `html.bp`'s header and `../src/AGENTS.md`
// § Comptime constraints are written from these results.
//
// A body calls functions — its module's, private or `pub`, recursive or not,
// and imported ones: the template module carries what the body reaches
// (decision 331). A lambda still cannot name itself (`val go = { n -> go(n -
// 1) }` is `unbound variable 'go'`, a `language-gaps.md` row); a recursion
// goes through a function.

import {html.classIf};

fn bang(s: string) -> string {
    return s + "!";
}

pub fn twice(s: string) -> string {
    return s + s;
}

fn depth(n: i32) -> i32 {
    return if (n <= 0) 0 else 1 + depth(n - 1);
}

fn probeHelperLambda(comptime t: @Expr<string>) -> @Expr<string> {
    val helper = { s -> s + "!" };
    return t.build("\"" + helper(t.text()) + "\"");
}

fn probeModuleFunctions(comptime t: @Expr<string>) -> @Expr<string> {
    return t.build("\"" + twice(bang(t.text())) + classIf(true, "on") + "\"");
}

fn probeRecursion(comptime t: @Expr<string>) -> @Expr<string> {
    return t.build("\"" + depth(t.text().length()).toString() + "\"");
}

fn probeTupleLabel(comptime t: @Expr<string>) -> @Expr<string> {
    val x: #(kind: string, n: i32) = #(t.text(), 2);
    return t.build("\"" + x.kind + x.n.toString() + "\"");
}

fn probeExplicitStack(comptime t: @Expr<string>) -> @Expr<string> {
    var stack: Array<string> = [];
    var depth = 0;
    var deepest = 0;
    for (t.text().split("")) { c ->
        if (c == "(") {
            stack = stack.append([c]);
            depth = depth + 1;
            if (depth > deepest) deepest = depth;
        }
        if (c == ")") {
            stack = stack.slice(0, stack.length - 1);
            depth = depth - 1;
        }
    }
    return t.build("\"" + deepest.toString() + "\"");
}

fn probeAt(comptime t: @Expr<string>) -> @Expr<string> {
    val xs = t.text().split("");
    var out = "";
    var i = 0;
    while (i < xs.length) {
        out = out + (xs.at(xs.length - 1 - i) ?? "");
        i = i + 1;
    }
    return t.build("\"" + out + "\"");
}

fn probeOptional(comptime t: @Expr<string>) -> @Expr<string> {
    val o: ?string = if (t.text() == "a") "yes" else null;
    val r = o ?? "no";
    return t.build("\"" + r + "\"");
}

fn probeNestedCounter(comptime t: @Expr<string>) -> @Expr<string> {
    var n = 0;
    t
        .text()
        .split(",")
        .forEach({ word ->
            word
                .split("")
                .forEach({ c ->
                    n = n + 1;
                });
        });
    return t.build("\"" + n.toString() + "\"");
}

fn probeComment(comptime t: @Expr<string>) -> @Expr<string> {
    // a comment on its own line
    val s = t.text().toUpper(); // and a trailing one
    return t.build("\"" + s + "\"");
}

test "a template body calls a helper written as a lambda in the body" {
    assert probeHelperLambda "ab" == "ab!";
}

test "a template body calls its module's functions, private and pub, and an imported one" {
    assert probeModuleFunctions "ab" == "ab!ab!on";
}

test "a template body recurses through a function" {
    assert probeRecursion "abcd" == "4";
}

test "a template body walks a nested grammar with an explicit stack" {
    assert probeExplicitStack "(a(b(c))(d))" == "3";
}

test "a template body reads a labelled tuple element by its label" {
    assert probeTupleLabel "ab" == "ab2";
}

test "a template body reads xs.at(i)" {
    assert probeAt "abc" == "cba";
}

test "a template body binds a ?T and reads it with ??" {
    assert probeOptional "a" == "yes";
    assert probeOptional "b" == "no";
}

test "a template body reassigns an i32 inside a nested lambda" {
    assert probeNestedCounter "ab,cde" == "5";
}

test "a template body may carry // comments" {
    assert probeComment "abc" == "ABC";
}
