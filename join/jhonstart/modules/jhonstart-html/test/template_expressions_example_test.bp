// specs/1.0.12-beta/08-bpp/118-bpp-components/examples/template-expressions-example.bp,
// landed: steps 1–3 — attributes that render, holes of any renderable type,
// markup inside `if`, `case` and a lambda. Three changes from the spec's text:
// `html` comes from this member (the core takes it at `05-jhonstart/26` step
// 0); the markup is rendered through `renderNode`, the walker that knows void
// tags and comments; `em` is declared here, as the core has no builder for it
// (a tag resolves in the caller's scope).

import {html};
import {Element, a, div, h1, li, p, span, ul, br, img, el, renderNode} from "jhonstart";

type Status { Draft, Live }

fn em(children: Children, attrs: Array<#(string, string)> = []) -> Element {
    return el("em", children, attrs);
}

pub fn Greeting(name: string, href: string, external: bool) -> Element {
    return html """
      <div class="greeting" data-kind="hello">
        <h1>Hello {name}!</h1>
        <a href={href} target={if (external) { "_blank" } else { "_self" }} hidden={name == ""}>
          two words work: <span title="more than one word">hover</span>
        </a>
      </div>
    """;
}

pub fn Menu(items: Array<string>, visible: bool, status: Status) -> Element {
    return html """
      <ul>
        {items.map({ item -> <li>{item}</li> })}
      </ul>
      {if (visible) { <p>Show me!</p> }}
      {if (visible) { <p>Show me!</p> } else { <p>Else show me!</p> }}
      {case status { Draft -> <em>draft</em>; Live -> <span>live</span>; }}
    """;
}

pub fn Counter(count: i32, label: ?string, extra: Element) -> Element {
    return html """
      <p>
        {count} items
        {if (label) { text -> <span>{text}</span> }}
        {extra}
        <br/>
        <img src="/dot.png" alt="" />
      </p>
    """;
}

pub fn Pair(left: string, right: string) -> Element {
    return html """
      <!-- an HTML comment is rendered -->
      <>
        <p>{left}</p>
        <p>{right}</p>
      </>
    """;
}

test "a static attribute reaches the rendered tree" {
    val markup = renderNode(Greeting("Astro", "/about", false));
    assert markup.contains("<div class=\"greeting\" data-kind=\"hello\">");
    assert markup.contains("title=\"more than one word\"");
    assert markup.contains("<h1>Hello Astro!</h1>");
}

test "an expression attribute is escaped, and a false bool attribute is absent" {
    val markup = renderNode(Greeting("Astro", "/a?b=1&c=2", true));
    assert markup.contains("href=\"/a?b=1&amp;c=2\"");
    assert markup.contains("target=\"_blank\"");
    assert markup.contains("hidden") == false;
}

test "a list maps to elements, in order" {
    val markup = renderNode(
        Menu(["Dog", "Cat", "Platypus"], true, Status.Draft),
    );
    assert markup.contains(
        "<ul><li>Dog</li><li>Cat</li><li>Platypus</li></ul>",
    );
    assert markup.contains("<em>draft</em>");
}

test "an if without else renders nothing when false" {
    val markup = renderNode(Menu([], false, Status.Live));
    assert markup.contains("Show me!") == false;
    assert markup.contains("<p>Else show me!</p>");
    assert markup.contains("<span>live</span>");
}

test "text in a hole is escaped; an Element in a hole is not; a number is its text" {
    val extra = html "<em>new</em>";
    val markup = renderNode(Counter(3, "<b>", extra));
    assert markup.contains("3 items");
    assert markup.contains("<span>&lt;b&gt;</span>");
    assert markup.contains("<em>new</em>");
}

test "a void tag stays where it was written" {
    val markup = renderNode(Counter(0, null, html "<em>x</em>"));
    assert markup.contains("<br><img src=\"/dot.png\" alt=\"\"></p>");
}

test "several roots and a fragment need no wrapper element" {
    val markup = renderNode(Pair("a", "b"));
    assert markup == "<!-- an HTML comment is rendered --><p>a</p><p>b</p>";
}
