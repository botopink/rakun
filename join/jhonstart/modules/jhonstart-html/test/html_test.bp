import {html};
import {div, span, p, h1, ul, li, text, fragment, renderToString} from "jhonstart";

test "markup lowers to the builder pipeline and renders" {
    val page = html "<div><p>hi</p></div>";
    assert renderToString(page) == "<div><p>hi</p></div>";
}

test "expression attribute parses and renders" {
    val cls = "card";
    val el = html "<div class={cls}><p>hi</p></div>";
    assert renderToString(el) == "<div class=\"card\"><p>hi</p></div>";
}
