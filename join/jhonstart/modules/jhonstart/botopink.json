{
  "name": "jhonstart",
  "version": "0.0.1",
  "description": "jhonstart core \u2014 the Element tree + builders + SSR renderer, the state/effect/memo/ref/reducer hooks, the route snapshot, the request record and the server-component convention \u2014 commonJS and erlang",
  "src": "src/",
  "entry": "root.bp",
  "target": "commonJS",
  "files": [
    "root.bp",
    "element.bp",
    "hooks.bp",
    "router.bp",
    "server.bp",
    "globals.bp",
    "client.bp",
    "error_boundary.bp",
    "metadata.bp",
    "elements.bp",
    "suspense.bp",
    "plugin.bp",
    "routes.bp",
    "styled_sheet.bp",
    "render.bp",
    "streaming.bp",
    "client_app.bp",
    "client_runtime.bp",
    "html_attrs.bp",
    "node.bp",
    "prelude.bp"
  ],
  "dependencies": {
    "actions": {
      "git": "https://github.com/botopink/actions.git",
      "branch": "feat"
    },
    "routing": {
      "git": "https://github.com/botopink/routing.git",
      "branch": "feat"
    },
    "styled": {
      "git": "https://github.com/botopink/styled.git",
      "branch": "feat"
    }
  }
}
