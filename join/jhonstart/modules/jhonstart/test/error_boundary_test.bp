// `botopink test` flat suite for `src/error_boundary.bp` (front 31).
//
// Written from a consumer's position: the module under test is reached by its
// module name. The front's assigned target is erlang; every assertion also
// RUNS on the commonJS row, because the catch goes through one host cell
// (`__jhCapture`) that ships both halves.
//
// No local below is named after an imported builder (`p`, `text`, `body`, …)
// — a reading convention; the checker defect that forced it (a binding leaking
// into every later declaration's scope) is closed.

import {error_boundary.ErrorInfo, error_boundary.ErrorBoundary, error_boundary.digestOf, error_boundary.infoFor, error_boundary.serverInfoFor, error_boundary.wrap, error_boundary.resetAttr, error_boundary.outcomeOf, error_boundary.renderBoundary, error_boundary.renderBoundaryChecked, error_boundary.isSignal, error_boundary.notFound, error_boundary.redirect, error_boundary.notFoundReason, error_boundary.redirectReason, error_boundary.catchError};
import {element.Element, element.div, element.p, element.text, element.renderToString};
import {elements.button, elements.htmlTag, elements.head, elements.body, elements.title, elements.meta, elements.h2};
import {router.push, router.lastNavigation};
import {navigation.signalPrefixes} from "routing";

// ── fixtures ────────────────────────────────────────────────────────────────

fn okChild() -> @Result<Element, string> {
    return div([text("metrics", attrs: [])], attrs: []);
}

fn failingChild() -> @Result<Element, string> {
    throw "db down: password=hunter2";
}

fn notFoundChild() -> @Result<Element, string> {
    throw notFound();
}

fn redirectChild() -> @Result<Element, string> {
    throw redirect("/login");
}

// A child that answers the reason as an `Error` VALUE rather than raising it —
// the same signal through the other door.
fn notFoundValueChild() -> @Result<Element, string> {
    throw notFoundReason();
}

fn crashingChild() -> @Result<Element, string> {
    assert false, "component crashed";
    return div([], attrs: []);
}

// The `error.bp` a developer writes: `ErrorPage`, never `Error` (the `@Result`
// variant), activating nothing, so a plain `-> Element`.
fn ErrorPage(info: ErrorInfo) -> Element {
    return div(
        [
            h2([text("Something went wrong", attrs: [])], attrs: []),
            p(
                [text("ref " + info.digest + info.message, attrs: [])],
                attrs: [],
            ),
            button([text("Retry", attrs: [])], attrs: [resetAttr("dash")]),
        ],
        attrs: [],
    );
}

fn boundaryOf(child: fn() -> @Result<Element, string>) -> ErrorBoundary {
    return ErrorBoundary(
        id: "dash",
        fallback: { info -> ErrorPage(info) },
        child: child,
    );
}

// ── step 1: the digest and the two infos ────────────────────────────────────

test "error: infoFor carries no message and a non-empty digest" {
    val info = infoFor("boom");
    assert info.message == "";
    assert info.digest != "";
}

test "error: serverInfoFor keeps the message and the SAME digest" {
    val server = serverInfoFor("boom");
    assert server.message == "boom";
    assert server.digest == infoFor("boom").digest;
    assert digestOf("boom") == server.digest;
    assert digestOf("boom") != digestOf("bang");
}

// ── step 2: the catch ───────────────────────────────────────────────────────

test "error: an Ok child renders inside the boundary wrapper" {
    val out = renderToString(renderBoundary(boundaryOf({ -> okChild() })));
    assert out == "<div data-jh-e=\"dash\"><div>metrics</div></div>";
}

test "error: a throwing child renders the fallback, and the child's markup is absent" {
    val out = renderToString(renderBoundary(boundaryOf({ -> failingChild() })));
    assert out.contains("Something went wrong");
    assert out.contains("metrics") == false;
    assert out.startsWith("<div data-jh-e=\"dash\">");
}

test "error: the fallback's ErrorInfo has an empty message — nothing leaks" {
    val out = renderToString(renderBoundary(boundaryOf({ -> failingChild() })));
    assert out.contains("hunter2") == false;
    assert out.contains("db down") == false;
    assert out.contains("ref " + digestOf("db down: password=hunter2"));
}

test "error: a child that crashes is caught like one that answered Error" {
    val out = renderToString(
        renderBoundary(boundaryOf({ -> crashingChild() })),
    );
    assert out.contains("Something went wrong");
}

// The thunk runs exactly once: it appends a mark to the router's navigation
// record each time it is called, and the record shows one mark.
fn countingChild() -> @Result<Element, string> {
    val before = lastNavigation();
    push(before + "|");
    return div([], attrs: []);
}

test "error: renderBoundary calls the thunk exactly once" {
    push("0");
    val once = renderBoundary(boundaryOf({ -> countingChild() }));
    assert lastNavigation() == "push push 0|";
}

// ── step 3: signals pass through ────────────────────────────────────────────

test "error: notFound and redirect are routing's reasons, spelled nowhere here" {
    assert notFoundReason() == "nav:not-found";
    assert redirectReason("/login") == "nav:redirect:/login";
    assert redirectReason("/a:b") == "nav:redirect:/a:b";
}

test "error: a nav:not-found child is not caught — the result is Error, unchanged" {
    val raised = renderBoundaryChecked(boundaryOf({ -> notFoundChild() }));
    val raisedMessage = case raised {
        Ok(tree) -> "caught";
        Error(message) -> message;
    };
    assert raisedMessage == "nav:not-found";
    val answered = renderBoundaryChecked(
        boundaryOf({ -> notFoundValueChild() }),
    );
    val answeredMessage = case answered {
        Ok(tree) -> "caught";
        Error(message) -> message;
    };
    assert answeredMessage == "nav:not-found";
}

test "error: redirect passes through uncaught, the target kept whole" {
    val outcome = renderBoundaryChecked(boundaryOf({ -> redirectChild() }));
    val message = case outcome {
        Ok(tree) -> "caught";
        Error(reason) -> reason;
    };
    assert message == "nav:redirect:/login";
}

// `renderBoundary` re-raises a signal: a nested boundary does not swallow it,
// and the enclosing checked boundary answers it as `Error`, unchanged.
fn nestedNotFound() -> @Result<Element, string> {
    return renderBoundary(boundaryOf({ -> notFoundChild() }));
}

test "error: a nested renderBoundary re-raises a signal to the enclosing boundary" {
    val outer = renderBoundaryChecked(boundaryOf({ -> nestedNotFound() }));
    val message = case outer {
        Ok(tree) -> "caught";
        Error(reason) -> reason;
    };
    assert message == "nav:not-found";
}

test "error: an ordinary failure is caught and yields Ok of the fallback" {
    val outcome = renderBoundaryChecked(boundaryOf({ -> failingChild() }));
    val markup = case outcome {
        Ok(tree) -> renderToString(tree);
        Error(reason) -> "raised " + reason;
    };
    assert markup.contains("Something went wrong");
}

test "error: isSignal recognises every routing prefix and nothing else" {
    for (signalPrefixes()) { prefix ->
        assert isSignal(prefix + "x") || isSignal(prefix);
    }
    assert isSignal("nav:") == false;
    assert isSignal("boom") == false;
    assert isSignal("nav:not-found");
}

// ── the js-half rules, asserted on the markup this front produces ───────────

// Rule 2: an event handler is an attribute naming a handler — outside the
// boundary's `@Result` channel by construction, so the boundary renders `Ok`
// and the handler name survives into the markup.
fn handlerChild() -> @Result<Element, string> {
    return button(
        [text("Like", attrs: [])],
        attrs: [#("data-jh-on-click", "LikeButton:like")],
    );
}

test "error: an event handler is outside the boundary — Ok, handler name kept" {
    val outcome = renderBoundaryChecked(boundaryOf({ -> handlerChild() }));
    val markup = case outcome {
        Ok(tree) -> renderToString(tree);
        Error(reason) -> "raised";
    };
    assert markup
        == "<div data-jh-e=\"dash\"><button data-jh-on-click=\"LikeButton:like\">Like</button></div>";
}

// Rule 3: a transition failure is routed by front 68's runtime to the nearest
// `data-jh-e` — the anchor and its id are what this front owes it.
test "error: the boundary's anchor carries data-jh-e with its id" {
    val anchor = wrap("seg-2", div([], attrs: []));
    assert anchor.attrs.length == 1;
    assert (anchor.attrs.at(0) ?? #("", ""))._0 == "data-jh-e";
    assert renderToString(anchor)
        == "<div data-jh-e=\"seg-2\"><div></div></div>";
}

test "error: the fallback's reset control is data-jh-reset, inert on the server" {
    val out = renderToString(renderBoundary(boundaryOf({ -> failingChild() })));
    assert out.contains("<button data-jh-reset=\"dash\">Retry</button>");
}

// ── step 4: catchError ──────────────────────────────────────────────────────

test "error: catchError is the constructor under a readable name" {
    val b = catchError("dash", { info -> ErrorPage(info) }, { -> okChild() });
    assert b.id == "dash";
    assert renderToString(renderBoundary(b))
        == "<div data-jh-e=\"dash\"><div>metrics</div></div>";
}

// ── the three file conventions ──────────────────────────────────────────────

// `global-error.bp` owns its document: front 94's `htmlTag` and `body`.
fn GlobalError(info: ErrorInfo) -> Element {
    return htmlTag(
        [
            head(
                [
                    title([text("Error", attrs: [])], attrs: []),
                    meta([], attrs: [#("charset", "utf-8")]),
                ],
                attrs: [],
            ),
            body(
                [
                    h2([text("Something went wrong", attrs: [])], attrs: []),
                    p([text(info.digest, attrs: [])], attrs: []),
                ],
                attrs: [],
            ),
        ],
        attrs: [#("lang", "en")],
    );
}

test "error: global-error renders its own html and body, each exactly once" {
    val out = renderToString(GlobalError(infoFor("root failed")));
    assert out.split("<html").length == 2;
    assert out.split("<body").length == 2;
    assert out.startsWith("<html lang=\"en\">");
    assert out.contains(digestOf("root failed"));
}

// `not-found.bp`: `NotFound()`, activating nothing.
fn NotFound() -> Element {
    return div([h2([text("Not found", attrs: [])], attrs: [])], attrs: []);
}

test "error: a not-found boundary is an ordinary component" {
    assert renderToString(NotFound()) == "<div><h2>Not found</h2></div>";
}
