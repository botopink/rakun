// jhonstart/metadata — the head a page declares, merged down the segment chain
// (front 32 of 1.0.10-beta).
//
// Metadata is the one part of a page whose value is COMPOSED down the layout
// chain rather than nested: the root layout sets the site name and the card
// type, a section sets its own title, the page sets its title, and the result
// is one merged record with a rule per field kind (upstream's § 18).
//
// ── The absence convention ──────────────────────────────────────────────────
//
// No field is optional. An absent string is `""` and an absent list is `[]` —
// the convention front 26's route and front 28's request use, and rakun's
// `Request`. `emptyMetadata()` is what a segment starts from, so a page that
// sets only a title writes one field's worth of difference.
//
// ── The export contract front 30's render resolves against ──────────────────
//
// A segment exports `pub fn metadata() -> Metadata` (static — a zero-argument
// function, not a `pub val`: a `pub val` of a user record type is unexercised
// in the tree) or `pub fn generateMetadata(params, parent) -> @Task<Metadata>`
// (dynamic). Exporting both is a render error. `viewport()` /
// `generateViewport(params)` are a SECOND, independent export.
//
// ── Rendering ───────────────────────────────────────────────────────────────
//
// `renderHead(m)` writes the tags in ONE fixed order, one per line, so two
// renders of equal metadata are byte-identical — what makes an ETag over the
// page worth anything. Every value goes through std's `escape.html` (element
// text) or `escape.attribute` (attribute values), and a `""` field emits no
// tag. This is head MARKUP, not the payload: the payload script's escaping is
// front 30's `escape.scriptJson`, a different problem.
//
// `sitemap`, `robots`, `manifest` and `opengraph-image` are FILE ROUTES —
// rakun front 66's. What this front owes them is the `openGraph.images` and
// `icons` paths: rakun resolves them as data, onze copies them into the
// segment's `Metadata`, and `renderHead` writes the tags (decision 116).

import {escape} from "std";

pub type OpenGraph(
    title: string,
    description: string,
    url: string,
    ogType: string,
    siteName: string,
    images: string[],
)

pub type TwitterCard(
    card: string,
    title: string,
    description: string,
    images: string[],
)

pub type Icons(icon: string, apple: string)

// `ogType`, not `type`: `type` is a keyword.
pub type Metadata(
    title: string,
    titleTemplate: string,
    description: string,
    openGraph: OpenGraph,
    twitter: TwitterCard,
    icons: Icons,
)

// Viewport and theme colour are a separate record and a separate export: they
// merge independently, so a page that sets a theme colour does not inherit a
// title template it never asked for.
pub type Viewport(width: string, initialScale: string, themeColor: string)

// ── step 1: the empty records ───────────────────────────────────────────────

pub fn emptyOpenGraph() -> OpenGraph {
    return OpenGraph(
        title: "",
        description: "",
        url: "",
        ogType: "",
        siteName: "",
        images: [],
    );
}

pub fn emptyTwitter() -> TwitterCard {
    return TwitterCard(card: "", title: "", description: "", images: []);
}

pub fn emptyIcons() -> Icons {
    return Icons(icon: "", apple: "");
}

pub fn emptyMetadata() -> Metadata {
    return Metadata(
        title: "",
        titleTemplate: "",
        description: "",
        openGraph: emptyOpenGraph(),
        twitter: emptyTwitter(),
        icons: emptyIcons(),
    );
}

pub fn emptyViewport() -> Viewport {
    return Viewport(width: "", initialScale: "", themeColor: "");
}

// ── step 2: the merge ───────────────────────────────────────────────────────
//
//   | field kind    | rule                                                     |
//   |---------------|----------------------------------------------------------|
//   | string        | a non-empty child replaces; an empty child inherits      |
//   | array         | a non-empty child replaces WHOLESALE; empty inherits     |
//   | nested record | merged field by field, by the same two rules             |
//   | titleTemplate | applied by the parent to the CHILD's title, once         |

pub fn pick(parent: string, child: string) -> string {
    if (child != "") return child;
    return parent;
}

pub fn pickList(parent: string[], child: string[]) -> string[] {
    if (child.length > 0) return child;
    return parent;
}

// `"%s | botopink"` + `"Hello"` → `"Hello | botopink"`. No template leaves the
// title alone; no title stays no title.
pub fn applyTemplate(template: string, title: string) -> string {
    if (template == "") return title;
    if (title == "") return "";
    return template.replace("%s", title);
}

pub fn mergeOpenGraph(parent: OpenGraph, child: OpenGraph) -> OpenGraph {
    return OpenGraph(
        title: pick(parent.title, child.title),
        description: pick(parent.description, child.description),
        url: pick(parent.url, child.url),
        ogType: pick(parent.ogType, child.ogType),
        siteName: pick(parent.siteName, child.siteName),
        images: pickList(parent.images, child.images),
    );
}

pub fn mergeTwitter(parent: TwitterCard, child: TwitterCard) -> TwitterCard {
    return TwitterCard(
        card: pick(parent.card, child.card),
        title: pick(parent.title, child.title),
        description: pick(parent.description, child.description),
        images: pickList(parent.images, child.images),
    );
}

pub fn mergeIcons(parent: Icons, child: Icons) -> Icons {
    return Icons(
        icon: pick(parent.icon, child.icon),
        apple: pick(parent.apple, child.apple),
    );
}

// The title is templated ONLY when the child sets one: a child with an empty
// title inherits the parent's, untemplated — the template belongs to the
// parent's children, not to the parent. The result's `titleTemplate` is the
// CHILD's, so it applies to the next level down and never composes into
// "Hello | Docs | botopink | botopink".
pub fn mergeMetadata(parent: Metadata, child: Metadata) -> Metadata {
    val title = if (child.title == "")
        parent.title
    else
        applyTemplate(parent.titleTemplate, child.title);
    return Metadata(
        title: title,
        titleTemplate: child.titleTemplate,
        description: pick(parent.description, child.description),
        openGraph: mergeOpenGraph(parent.openGraph, child.openGraph),
        twitter: mergeTwitter(parent.twitter, child.twitter),
        icons: mergeIcons(parent.icons, child.icons),
    );
}

pub fn mergeViewport(parent: Viewport, child: Viewport) -> Viewport {
    return Viewport(
        width: pick(parent.width, child.width),
        initialScale: pick(parent.initialScale, child.initialScale),
        themeColor: pick(parent.themeColor, child.themeColor),
    );
}

// ── step 3: the head ────────────────────────────────────────────────────────

fn metaName(name: string, content: string) -> string {
    if (content == "") return "";
    return "<meta name=\""
        + name
        + "\" content=\""
        + escape.attribute(content)
        + "\">";
}

fn metaProperty(property: string, content: string) -> string {
    if (content == "") return "";
    return "<meta property=\""
        + property
        + "\" content=\""
        + escape.attribute(content)
        + "\">";
}

fn linkRel(rel: string, href: string) -> string {
    if (href == "") return "";
    return "<link rel=\"" + rel + "\" href=\"" + escape.attribute(href) + "\">";
}

fn titleTag(value: string) -> string {
    if (value == "") return "";
    return "<title>" + escape.html(value) + "</title>";
}

fn joinTags(tags: string[]) -> string {
    return tags.filter({ t -> t != "" }).join("\n");
}

// The fixed order: title, description, Open Graph (title, description, url,
// type, site name, one `og:image` per image in list order), the Twitter card
// (card, title, description, one `twitter:image` per image), then the icons.
pub fn renderHead(m: Metadata) -> string {
    var tags: string[] = [
        titleTag(m.title),
        metaName("description", m.description),
        metaProperty("og:title", m.openGraph.title),
        metaProperty("og:description", m.openGraph.description),
        metaProperty("og:url", m.openGraph.url),
        metaProperty("og:type", m.openGraph.ogType),
        metaProperty("og:site_name", m.openGraph.siteName),
    ];
    for (m.openGraph.images) { image ->
        tags.push(metaProperty("og:image", image));
    }
    tags.push(metaName("twitter:card", m.twitter.card));
    tags.push(metaName("twitter:title", m.twitter.title));
    tags.push(metaName("twitter:description", m.twitter.description));
    for (m.twitter.images) { image ->
        tags.push(metaName("twitter:image", image));
    }
    tags.push(linkRel("icon", m.icons.icon));
    tags.push(linkRel("apple-touch-icon", m.icons.apple));
    return joinTags(tags);
}

// ── step 4: the viewport ────────────────────────────────────────────────────

pub fn renderViewport(v: Viewport) -> string {
    var content = "";
    if (v.width != "") content = "width=" + v.width;
    if (v.initialScale != "") {
        val scale = "initial-scale=" + v.initialScale;
        content = if (content == "") scale else content + ", " + scale;
    }
    return joinTags(
        [metaName("viewport", content), metaName("theme-color", v.themeColor)],
    );
}
