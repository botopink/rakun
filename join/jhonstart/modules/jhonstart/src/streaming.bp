// jhonstart/streaming — the fill, the response, and the render entries
// (front 30, decisions 114, 115 and 117).
//
// Streaming is a change in what the render PRODUCES: a shell plus an ordered
// sequence of chunks, each keyed to a hole in the shell. A boundary holds an
// UNSTARTED thunk (`suspense.bp`), and progressive flush is driven by the
// completion of spawned work — one BEAM process per boundary, each value handed
// back in completion order (`eachCompleted`, `sidecars/jhonstart_render.erl`) —
// never by awaiting a list of Tasks, which on the eager erlang row is a list of
// results that have all already run.
//
// `render` / `renderStream` live here rather than in `render.bp` because they
// need `resolve` and `fillHtml`, and `resolve` needs `render.bp`'s walker: one
// file each way would be two modules importing each other.
//
// ── The response — contract 5d ──────────────────────────────────────────────
//
// The render writes to a `Response` onze built over rakun's `ChunkWriter`
// (`status`, `header`, `write`, `close`); jhonstart never sees the
// `ChunkWriter`. `status` / `header` are legal only before the first `write`
// (`guarded` enforces it, naming the call), and `close` is called exactly once
// on every path.
//
// ── Navigation signals are translated here and nowhere else ─────────────────
//
//   | a signal raised                | the render writes                                                      |
//   |--------------------------------|------------------------------------------------------------------------|
//   | `redirect(to)`, before a chunk | `status(307)`, `header("location", to)`, `close()` — no body           |
//   | `notFound()`, before a chunk   | `status(404)`, a document whose body is the nearest not-found boundary |
//   | either, after the first chunk  | `data-jh-g` markup as the last chunk, no later fill; status stays 200  |
//
// A redirect target is checked the same way before and after the first chunk:
// a relative target must be found by `routing`'s `matchPath` in the table the
// render was handed (`PageInput.table`), an absolute one must be listed in
// `app(allowedRedirects: [...])` (empty by default: every absolute target is
// refused), and anything else FAILS the render — no status, no `location`, no
// markup (decision 67). The reasons are read with `routing`'s `navigation`;
// this file spells no `nav:` literal.
//
// ── What a render answers ───────────────────────────────────────────────────
//
// `-> @Task<@Result<void, string>>` (front 24 open point 8, option (a)): `Ok`
// when the response was closed normally or with a signal, `Error(message)` for
// a failed render — a refused redirect target, a plugin whose `close` answered
// `Error`, a plugin key clash, a raw-text body that would close its element, a
// component that crashed with no error boundary around it.

import {element.Element, element.ElementBase};
import {encoding} from "std";
import {table.parseTable, table.RouteEntry, match.matchPath, match.RouteMatch, navigation.NavKind, navigation.NavOutcome, navigation.signalFromReason} from "routing";
import {server.RequestData, server.enterRequest, server.leaveRequest};
import {router.fill, router.renderIsDynamic, router.markDynamic, router.resetDynamic};
import {error_boundary.ErrorInfo, error_boundary.isSignal, error_boundary.notFoundReason};
import {suspense.Boundary};
import {render.renderNode, render.compose, render.Payload, render.renderKeys, render.documentStart, render.documentEnd, render.isLangTag, render.__jhStateReset, render.__jhIslands, render.__jhStashedNotFound, render.componentOutcome, render.attemptRender, render.Fill};
import {globals.globals};
import {plugin.RenderPlugin, plugin.Json};
import {routes.PageContext, routes.LayoutProps, routes.UiSegment};
import {metadata.Metadata, metadata.Viewport, metadata.emptyMetadata, metadata.emptyViewport, metadata.mergeMetadata, metadata.mergeViewport, metadata.renderHead, metadata.renderViewport};
import {escape} from "std";
import {context.RenderScope} from "std";

// ── step 2: the chunk and the fill ──────────────────────────────────────────

pub type Chunk(id: string, html: string)

// Awaits the boundary's child EXACTLY ONCE, at statement level, and renders it
// through the escaping walker.
pub fn resolve(b: Boundary) -> @Task<Chunk> {
    val child = b.child;
    val tree = await child();
    return Chunk(id: b.id, html: renderNode(tree));
}

// `css` is what the plugins' `chunk(c.id)` returned, `""` when none: it goes
// FIRST inside the template, with no marker of its own, so a fill's style and
// markup enter the document together.
pub fn fillHtml(c: Chunk, css: string) -> string {
    return "<template data-jh-f=\""
        + c.id
        + "\">"
        + css
        + c.html
        + "</template><script>"
        + globals.fill
        + "(\""
        + c.id
        + "\")</script>";
}

// The late-signal markup (contract 2's `data-jh-g`), each followed by the call
// of `globals.signal`.
pub fn redirectSignalHtml(to: string) -> string {
    return "<template data-jh-g=\"redirect\" data-jh-to=\""
        + escape.attribute(to)
        + "\"></template><script>"
        + globals.signal
        + "()</script>";
}

pub fn notFoundSignalHtml(css: string, html: string) -> string {
    return "<template data-jh-g=\"not-found\">"
        + css
        + html
        + "</template><script>"
        + globals.signal
        + "()</script>";
}

// ── the response ────────────────────────────────────────────────────────────

pub type Response(
    status: fn(code: i32),
    header: fn(name: string, value: string),
    write: fn(chunk: string) -> @Task<void>,
    close: fn() -> @Task<void>,
)

#[@External.Node("./render.mjs", "markWrite")]
#[@External.Erlang("jhonstart_render", "mark_write")]
declare fn __jhMarkWrite() -> i32;

#[@External.Node("./render.mjs", "writes")]
#[@External.Erlang("jhonstart_render", "writes")]
declare fn __jhWrites() -> i32;

#[@External.Node("./render.mjs", "setLate")]
#[@External.Erlang("jhonstart_render", "set_late")]
declare fn __jhSetLate(state: string) -> i32;

#[@External.Node("./render.mjs", "late")]
#[@External.Erlang("jhonstart_render", "late")]
declare fn __jhLate() -> string;

#[@External.Node("./render.mjs", "eachCompleted")]
#[@External.Erlang("jhonstart_render", "each_completed")]
declare fn __jhEachCompleted(
    tasks: Array<fn() -> @Task<Resolved>>,
    onDone: fn(index: i32, r: Resolved) -> @Task<i32>,
) -> @Task<i32>;

fn guardStatus(res: Response, code: i32) -> void {
    assert __jhWrites() == 0, "render: status("
        + code.toString()
        + ") after the first write";
    val status = res.status;
    status(code);
}

fn guardHeader(res: Response, name: string, value: string) -> void {
    assert __jhWrites() == 0, "render: header(\""
        + name
        + "\") after the first write";
    val header = res.header;
    header(name, value);
}

fn guardWrite(res: Response, chunk: string) -> @Task<void> {
    __jhMarkWrite();
    val write = res.write;
    await write(chunk);
}

// `res`, with `status` / `header` refused after the first `write`.
pub fn guarded(res: Response) -> Response {
    return Response(
        status: { code -> guardStatus(res, code) },
        header: { name, value -> guardHeader(res, name, value) },
        write: { chunk -> guardWrite(res, chunk) },
        close: res.close,
    );
}

// ── the app ─────────────────────────────────────────────────────────────────

// What onze hands the render for one request (decision 114 item 5). `params`
// and `query` are `encoding.formStringify`-encoded, as the payload's `m` / `q`
// carry them; `table` (contract 1's wire), `actions` and `build` are written
// into the payload verbatim. `metadata` / `viewports` are the segments'
// resolved exports, root-first, the page's last (front 32's contract: onze
// calls `metadata()` / awaits `generateMetadata`), merged here.
pub type PageInput(
    build: string,
    pathname: string,
    pattern: string,
    params: string,
    query: string,
    table: string,
    actions: Array<#(string, string)>,
    chain: Array<UiSegment>,
    page: fn() -> @Component<Element>,
    metadata: Array<Metadata>,
    viewports: Array<Viewport>,
)

// `lang` is the document's `<html lang>`, written once by every render of this
// app; a value that is not a language tag (`isLangTag`) is refused here.
pub fn app(
    plugins: Array<RenderPlugin>,
    allowedRedirects: string[] = [],
    lang: string = "en",
) -> App {
    assert isLangTag(lang), "jhonstart: app(lang: \""
        + lang
        + "\") is not a language tag - letters, digits and '-', starting with a letter";
    return App(
        plugins: plugins,
        allowedRedirects: allowedRedirects,
        lang: lang,
    );
}

// ── the redirect-target check ───────────────────────────────────────────────

fn isAbsolute(to: string) -> bool {
    return to.startsWith("//") || to.contains("://");
}

fn pathOf(to: string) -> string {
    val q = to.split("?").at(0) ?? to;
    return q.split("#").at(0) ?? q;
}

// A relative target is accepted when `routing`'s `matchPath` finds it in the
// table; an absolute one only when listed. Anything else is refused.
pub fn redirectAllowed(table: string, allowed: string[], to: string) -> bool {
    if (isAbsolute(to)) return allowed.contains(to);
    if (to.startsWith("/") == false) return false;
    var hit = false;
    if (matchPath(parseTable(table), pathOf(to))) {
        m ->
        hit = true;
    }
    return hit;
}

fn kindWordOf(out: NavOutcome) -> string {
    return case out.kind {
        None -> "none";
        NotFound -> "not-found";
        Redirect -> "redirect";
    };
}

fn refusedTarget(to: string) -> string {
    return "render: redirect target `"
        + to
        + "` refused - a relative target must be in the route table, an absolute one listed in app(allowedRedirects: [...])";
}

// ── the resolution of one boundary (in its own process on erlang) ───────────

// `dynamic` is the boundary process's own DYNAMIC mark (router.bp): on the
// erlang row a boundary renders in its own process, so a `searchParams()` or
// `request()` read inside it marks that process, and the render ORs the mark
// back in (`carryDynamic`) before the payload's `d` is written.
pub type Resolved(id: string, kind: string, html: string, reason: string, css: string, dynamic: bool)

fn defaultNotFound() -> Element {
    return Element(
        tag: "h1",
        value: "",
        children: [
            Element(tag: "#text", value: "Not found", children: [], attrs: []),
        ],
        attrs: [],
    );
}

fn renderOrFail(tree: Element) -> @Result<string, string> {
    val out = attemptRender({ -> renderNode(tree) });
    return try out;
}

// Resolves one boundary IN THE PROCESS THAT RENDERED IT — its own process on
// the erlang row — including the plugins' `chunk(id)`: a stylesheet library
// that registers per process only sees the classes the boundary's render
// registered from inside that process.
fn resolveIn(
    plugins: Array<RenderPlugin>,
    req: RequestData,
    route: PageContext,
    query: string,
    f: Fill,
) -> @Task<Resolved> {
    val b = f.boundary;
    enterRequest(req);
    fill(
        route.pathname,
        encoding.formStringify(route.params),
        query,
        route.pattern,
        0,
    );
    val outcome = await componentOutcome(b.child, f.scope);
    val failure = case outcome {
        Ok(w) -> "";
        Error(message) -> message;
    };
    if (failure == notFoundReason()) {
        val nf = attemptRender(
            { -> renderNode(__jhStashedNotFound(defaultNotFound())) },
        );
        val nfCss = await chunksFrom(plugins, 0, b.id);
        return case nf {
            Ok(html) -> Resolved(
                id: b.id,
                kind: "signal",
                html: html,
                reason: failure,
                css: nfCss,
                dynamic: renderIsDynamic(),
            );
            Error(message) -> Resolved(
                id: b.id,
                kind: "error",
                html: "",
                reason: message,
                css: "",
                dynamic: renderIsDynamic(),
            );
        };
    }
    if (isSignal(failure))
        return Resolved(
            id: b.id,
            kind: "signal",
            html: "",
            reason: failure,
            css: "",
            dynamic: renderIsDynamic(),
        );
    if (failure != "")
        return Resolved(
            id: b.id,
            kind: "error",
            html: "",
            reason: failure,
            css: "",
            dynamic: renderIsDynamic(),
        );
    val tree = case outcome {
        Ok(w) -> w.tree;
        Error(message) -> defaultNotFound();
    };
    val html = renderOrFail(tree);
    val css = await chunksFrom(plugins, 0, b.id);
    return case html {
        Ok(h) -> Resolved(
            id: b.id,
            kind: "fill",
            html: h,
            reason: "",
            css: css,
            dynamic: renderIsDynamic(),
        );
        Error(message) -> Resolved(
            id: b.id,
            kind: "error",
            html: "",
            reason: message,
            css: "",
            dynamic: renderIsDynamic(),
        );
    };
}

// ── the plugins, in the order `app` received them ───────────────────────────

fn pluginAt(ps: Array<RenderPlugin>, i: i32) -> RenderPlugin {
    var found = ps.at(0) ?? noPlugin();
    var n = 0;
    for (ps) { p ->
        if (n == i) found = p;
        n = n + 1;
    }
    return found;
}

fn emptyText() -> @Task<string> {
    return "";
}

fn emptyChunk(holeId: string) -> @Task<string> {
    return "";
}

fn closedOk() -> @Task<@Result<void, string>> {
    return;
}

fn noPayload() -> @Task<Array<#(string, Json)>> {
    return [];
}

fn noPlugin() -> RenderPlugin {
    return RenderPlugin(
        name: "",
        head: { -> emptyText() },
        chunk: { id -> emptyChunk(id) },
        close: { -> closedOk() },
        payload: { -> noPayload() },
    );
}

fn headsFrom(ps: Array<RenderPlugin>, i: i32) -> @Task<string> {
    if (i >= ps.length) return "";
    val p = pluginAt(ps, i);
    val head = p.head;
    val mine = await head();
    val rest = await headsFrom(ps, i + 1);
    return mine + rest;
}

fn chunksFrom(
    ps: Array<RenderPlugin>,
    i: i32,
    holeId: string,
) -> @Task<string> {
    if (i >= ps.length) return "";
    val p = pluginAt(ps, i);
    val chunk = p.chunk;
    val mine = await chunk(holeId);
    val rest = await chunksFrom(ps, i + 1, holeId);
    return mine + rest;
}

fn closeFrom(ps: Array<RenderPlugin>, i: i32) -> @Task<string> {
    if (i >= ps.length) return "";
    val p = pluginAt(ps, i);
    val close = p.close;
    val outcome = await close();
    val failure = case outcome {
        Ok(v) -> "";
        Error(message) -> "render: plugin `"
            + p.name
            + "` failed to close: "
            + message;
    };
    if (failure != "") return failure;
    val rest = await closeFrom(ps, i + 1);
    return rest;
}

// Each plugin's `payload()` contribution, `#(pluginName, #(key, json))`.
fn payloadsFrom(
    ps: Array<RenderPlugin>,
    i: i32,
) -> @Task<Array<#(string, string, string)>> {
    if (i >= ps.length) return [];
    val p = pluginAt(ps, i);
    val payload = p.payload;
    val mine = await payload();
    val rest = await payloadsFrom(ps, i + 1);
    var out: Array<#(string, string, string)> = [];
    for (mine) { kv ->
        out.push(#(p.name, kv._0, kv._1));
    }
    for (rest) { r ->
        out.push(r);
    }
    return out;
}

// `""`, or the message naming the key (and the two plugins) a plugin may not
// give.
pub fn extrasProblem(extras: Array<#(string, string, string)>) -> string {
    var problem = "";
    var seen: Array<#(string, string)> = [];
    for (extras) { e ->
        if (problem == "") {
            if (renderKeys().contains(e._1))
                problem = "render: plugin `"
                    + e._0
                    + "` gave the payload key `"
                    + e._1
                    + "`, which the render writes itself";
            for (seen) { s ->
                if (problem == "")
                    if (s._1 == e._1)
                        problem = "render: plugins `"
                            + s._0
                            + "` and `"
                            + e._0
                            + "` both gave the payload key `"
                            + e._1
                            + "`";
            }
            seen.push(#(e._0, e._1));
        }
    }
    return problem;
}

// ── the head front 32 contributes ───────────────────────────────────────────

fn mergedHead(input: PageInput) -> string {
    var m = emptyMetadata();
    for (input.metadata) { x ->
        m = mergeMetadata(m, x);
    }
    var v = emptyViewport();
    for (input.viewports) { x ->
        v = mergeViewport(v, x);
    }
    val viewport = renderViewport(v);
    val head = renderHead(m);
    if (viewport == "") return head;
    if (head == "") return viewport;
    return viewport + "\n" + head;
}

// ── step 8: the render ──────────────────────────────────────────────────────

fn routeOf(input: PageInput) -> PageContext {
    return PageContext(
        pathname: input.pathname,
        pattern: input.pattern,
        params: encoding.formParse(input.params),
        rest: [],
    );
}

fn payloadOf(
    input: PageInput,
    holes: string[],
    extras: Array<#(string, Json)>,
) -> Payload {
    return Payload(
        build: input.build,
        pathname: input.pathname,
        pattern: input.pattern,
        params: input.params,
        query: input.query,
        table: input.table,
        islands: __jhIslands(),
        actions: input.actions,
        holes: holes,
        dynamic: renderIsDynamic(),
        extras: extras,
    );
}

fn closeRes(res: Response) -> @Task<void> {
    val close = res.close;
    await close();
}

fn finish(res: Response, failure: string) -> @Task<@Result<void, string>> {
    await closeRes(res);
    leaveRequest();
    if (failure != "") throw failure;
    return;
}

// A signal (or a failure) met before the first chunk.
fn early(
    site: App,
    input: PageInput,
    res: Response,
    reason: string,
) -> @Task<@Result<void, string>> {
    if (isSignal(reason) == false) {
        val failed = await finish(res, reason);
        return try failed;
    }
    val out = signalFromReason(reason);
    val kind = kindWordOf(out);
    if (kind == "redirect") {
        if (redirectAllowed(input.table, site.allowedRedirects, out.location)
            == false) {
            val refused = await finish(res, refusedTarget(out.location));
            return try refused;
        }
        val status = res.status;
        status(out.status);
        val header = res.header;
        header("location", out.location);
        val done = await finish(res, "");
        return try done;
    }
    val status404 = res.status;
    status404(404);
    val header404 = res.header;
    header404("content-type", "text/html; charset=utf-8");
    val body = renderOrFail(__jhStashedNotFound(defaultNotFound()));
    val bodyHtml = case body {
        Ok(h) -> h;
        Error(message) -> "";
    };
    val pluginHead = await headsFrom(site.plugins, 0);
    val doc = documentStart(
        site.lang,
        mergedHead(input),
        pluginHead,
        input.pattern,
    )
        + bodyHtml
        + "</div>"
        + documentEnd(payloadOf(input, [], []), input.pattern);
    val write = res.write;
    await write(doc);
    val closed = await finish(res, "");
    return try closed;
}

pub fn renderWith(
    site: App,
    input: PageInput,
    req: RequestData,
    res: Response,
    streaming: bool,
) -> @Task<@Result<void, string>> {
    __jhStateReset();
    resetDynamic();
    enterRequest(req);
    val route = routeOf(input);
    fill(route.pathname, input.params, input.query, route.pattern, 0);
    val page = input.page;
    val chain = input.chain;
    val outcome = await componentOutcome(
        { -> compose(chain, route, page) },
        RenderScope.root(),
    );
    val failure = case outcome {
        Ok(w) -> "";
        Error(message) -> message;
    };
    if (failure != "") {
        val e = await early(site, input, res, failure);
        return try e;
    }
    val tree = case outcome {
        Ok(w) -> w.tree;
        Error(message) -> defaultNotFound();
    };
    val shell = renderOrFail(tree);
    val shellFailure = case shell {
        Ok(h) -> "";
        Error(message) -> message;
    };
    if (shellFailure != "") {
        val s = await finish(res, shellFailure);
        return try s;
    }
    val shellHtml = case shell {
        Ok(h) -> h;
        Error(message) -> "";
    };
    val boundaries = case outcome {
        Ok(w) -> w.fills;
        Error(message) -> [];
    };
    if (streaming) {
        val streamOutcome = await streamed(
            site,
            input,
            req,
            route,
            res,
            shellHtml,
            boundaries,
        );
        return try streamOutcome;
    }
    val wholeOutcome = await whole(
        site,
        input,
        req,
        route,
        res,
        shellHtml,
        boundaries,
    );
    return try wholeOutcome;
}

fn holeIds(boundaries: Array<Fill>) -> string[] {
    return boundaries.map({ f -> f.boundary.id });
}

fn thunksOf(
    plugins: Array<RenderPlugin>,
    req: RequestData,
    route: PageContext,
    query: string,
    boundaries: Array<Fill>,
) -> Array<fn() -> @Task<Resolved>> {
    return boundaries.map(
        { b -> boundaryThunk(plugins, req, route, query, b) },
    );
}

fn boundaryThunk(
    plugins: Array<RenderPlugin>,
    req: RequestData,
    route: PageContext,
    query: string,
    f: Fill,
) -> fn() -> @Task<Resolved> {
    return { -> resolveIn(plugins, req, route, query, f) };
}

// The late half: after the first write a signal is markup, a failure ends the
// stream, and nothing after either is written. Every branch returns what it
// wrote (`-> @Task<i32>`), the value `completion`'s callback type answers.
// A boundary's DYNAMIC mark joins the render's before anything else, so a
// boundary resolved after a late signal still counts.
fn carryDynamic(r: Resolved) -> i32 {
    if (r.dynamic) return markDynamic();
    return 0;
}

fn onResolved(
    site: App,
    input: PageInput,
    res: Response,
    r: Resolved,
) -> @Task<i32> {
    carryDynamic(r);
    if (__jhLate() != "") return 0;
    if (r.kind == "fill") {
        val wrote = await writeFill(site, res, r);
        return wrote;
    }
    if (r.kind == "error") return __jhSetLate("fail:" + r.reason);
    val signalled = await writeLateSignal(site, input, res, r);
    return signalled;
}

fn writeFill(site: App, res: Response, r: Resolved) -> @Task<i32> {
    val write = res.write;
    await write(fillHtml(Chunk(id: r.id, html: r.html), r.css));
    return 1;
}

fn writeLateSignal(
    site: App,
    input: PageInput,
    res: Response,
    r: Resolved,
) -> @Task<i32> {
    val out = signalFromReason(r.reason);
    val isRedirect = kindWordOf(out) == "redirect";
    if (isRedirect
        && redirectAllowed(input.table, site.allowedRedirects, out.location)
            == false)
        return __jhSetLate("fail:" + refusedTarget(out.location));
    if (isRedirect) {
        val writeRedirect = res.write;
        await writeRedirect(redirectSignalHtml(out.location));
        return __jhSetLate("signal");
    }
    val writeNotFound = res.write;
    await writeNotFound(notFoundSignalHtml(r.css, r.html));
    return __jhSetLate("signal");
}

fn completion(
    site: App,
    input: PageInput,
    res: Response,
) -> fn(index: i32, r: Resolved) -> @Task<i32> {
    return { index, r -> onResolved(site, input, res, r) };
}

fn lateFailure() -> string {
    val state = __jhLate();
    if (state.startsWith("fail:")) return state.replace("fail:", "");
    return "";
}

fn closing(
    site: App,
    input: PageInput,
    res: Response,
    holes: string[],
) -> @Task<@Result<void, string>> {
    val closeFailure = await closeFrom(site.plugins, 0);
    if (closeFailure != "") {
        val failed = await finish(res, closeFailure);
        return try failed;
    }
    val contributions = await payloadsFrom(site.plugins, 0);
    val problem = extrasProblem(contributions);
    if (problem != "") {
        val clash = await finish(res, problem);
        return try clash;
    }
    val extras = contributions.map({ c -> #(c._1, c._2) });
    val write = res.write;
    await write(documentEnd(payloadOf(input, holes, extras), input.pattern));
    val done = await finish(res, "");
    return try done;
}

fn streamed(
    site: App,
    input: PageInput,
    req: RequestData,
    route: PageContext,
    res: Response,
    shellHtml: string,
    boundaries: Array<Fill>,
) -> @Task<@Result<void, string>> {
    val pluginHead = await headsFrom(site.plugins, 0);
    val status = res.status;
    status(200);
    val header = res.header;
    header("content-type", "text/html; charset=utf-8");
    val write = res.write;
    await write(
        documentStart(site.lang, mergedHead(input), pluginHead, input.pattern)
            + shellHtml
            + "</div>",
    );
    await __jhEachCompleted(
        thunksOf(site.plugins, req, route, input.query, boundaries),
        completion(site, input, res),
    );
    val failure = lateFailure();
    if (failure != "") {
        val failed = await finish(res, failure);
        return try failed;
    }
    val closed = await closing(site, input, res, holeIds(boundaries));
    return try closed;
}

// Every boundary resolves first — a signal among them is still before the
// first chunk — and the whole document is one write, the fills in shell order.
fn whole(
    site: App,
    input: PageInput,
    req: RequestData,
    route: PageContext,
    res: Response,
    shellHtml: string,
    boundaries: Array<Fill>,
) -> @Task<@Result<void, string>> {
    await __jhEachCompleted(
        thunksOf(site.plugins, req, route, input.query, boundaries),
        { index, r -> collectResolved(r) },
    );
    val resolved = takeResolved();
    for (resolved) { r ->
        carryDynamic(r);
    }
    var failure = "";
    for (resolved) { r ->
        if (failure == "") if (r.kind != "fill") failure = r.reason;
    }
    if (failure != "") {
        val e = await early(site, input, res, failure);
        return try e;
    }
    val pluginHead = await headsFrom(site.plugins, 0);
    val fills = await fillsInOrder(site, boundaries, resolved, 0);
    val closeFailure = await closeFrom(site.plugins, 0);
    if (closeFailure != "") {
        val failed = await finish(res, closeFailure);
        return try failed;
    }
    val contributions = await payloadsFrom(site.plugins, 0);
    val problem = extrasProblem(contributions);
    if (problem != "") {
        val clash = await finish(res, problem);
        return try clash;
    }
    val extras = contributions.map({ c -> #(c._1, c._2) });
    val status = res.status;
    status(200);
    val header = res.header;
    header("content-type", "text/html; charset=utf-8");
    val doc = documentStart(
        site.lang,
        mergedHead(input),
        pluginHead,
        input.pattern,
    )
        + shellHtml
        + "</div>"
        + fills
        + documentEnd(payloadOf(input, [], extras), input.pattern);
    val write = res.write;
    await write(doc);
    val done = await finish(res, "");
    return try done;
}

#[@External.Node("./render.mjs", "collectResolved")]
#[@External.Erlang("jhonstart_render", "collect_resolved")]
declare fn __jhCollectResolved(r: Resolved) -> i32;

#[@External.Node("./render.mjs", "takeResolved")]
#[@External.Erlang("jhonstart_render", "take_resolved")]
declare fn __jhTakeResolved() -> Array<Resolved>;

fn collectResolved(r: Resolved) -> @Task<i32> {
    return __jhCollectResolved(r);
}

fn takeResolved() -> Array<Resolved> {
    return __jhTakeResolved();
}

fn resolvedFor(resolved: Array<Resolved>, id: string) -> Resolved {
    var found = Resolved(
        id: id,
        kind: "fill",
        html: "",
        reason: "",
        css: "",
        dynamic: false,
    );
    for (resolved) { r ->
        if (r.id == id) found = r;
    }
    return found;
}

fn fillsInOrder(
    site: App,
    boundaries: Array<Fill>,
    resolved: Array<Resolved>,
    i: i32,
) -> @Task<string> {
    if (i >= boundaries.length) return "";
    val id = holeIds(boundaries).at(i) ?? "";
    val r = resolvedFor(resolved, id);
    val mine = fillHtml(Chunk(id: id, html: r.html), r.css);
    val rest = await fillsInOrder(site, boundaries, resolved, i + 1);
    return mine + rest;
}

// ── the app ─────────────────────────────────────────────────────────────────
//
// The free functions above take the app as `site`, never `self`: `self`
// names a method's receiver, and the checker refuses it on a free function
// (`self-param-outside-type`).

pub type App(plugins: Array<RenderPlugin>, allowedRedirects: string[], lang: string) {
    // The non-streaming form: every boundary resolves before anything is
    // written, and the whole document goes to `res.write` once.
    pub fn render(
        self: Self,
        input: PageInput,
        req: RequestData,
        res: Response,
    ) -> @Task<@Result<void, string>> {
        return renderWith(self, input, req, guarded(res), false);
    }

    // The streaming form: the shell first, then one fill per boundary in
    // COMPLETION order.
    pub fn renderStream(
        self: Self,
        input: PageInput,
        req: RequestData,
        res: Response,
    ) -> @Task<@Result<void, string>> {
        return renderWith(self, input, req, guarded(res), true);
    }
}
