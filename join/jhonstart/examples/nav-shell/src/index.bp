// nav-shell/index — a long archive switches prefetch off for its rows, and the
// two header links keep it on (front 27's `withPrefetch`).

import {Element, div, nav, ul, li, text} from "jhonstart";
import {Link, linkProps, withPrefetch} from "jhonstart-link";

pub type Page(slug: string, title: string)

fn archiveRow(page: Page) -> Element {
    return li([Link(withPrefetch(linkProps("/docs/"
        + page.slug), false), [text(page.title)])]);
}

pub fn DocsIndex(pages: Array<Page>) -> Element {
    val rows = pages.map({ page -> archiveRow(page) });
    return div([
        nav([Link(linkProps("/"), [text("Home")]), Link(linkProps("/docs"), [text("Docs")])]),
        ul(rows, attrs: [#("class", "archive")]),
    ], attrs: [#("class", "index")]);
}
