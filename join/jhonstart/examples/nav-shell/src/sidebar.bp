// nav-shell/sidebar — the docs sidebar marks the section the reader is in
// (front 26's `selectedLayoutSegment` shape, read off the route snapshot), and
// every row is a `Link` (front 27).

import {Element, nav, ul, li, text, RouterState} from "jhonstart";
import {Link, linkProps, withClass} from "jhonstart-link";

fn row(href: string, label: string, active: bool) -> Element {
    val cls = if (active) "row active" else "row";
    return li([Link(withClass(linkProps(href), cls), [text(label)])]);
}

pub fn Sidebar(r: RouterState) -> Element {
    val section = r.segment();
    return nav([ul([
        row("/docs/api", "API", section == "api"),
        row("/docs/guides", "Guides", section == "guides"),
        row("/docs/faq", "FAQ", section == "faq"),
    ])], attrs: [#("class", "sidebar")]);
}
