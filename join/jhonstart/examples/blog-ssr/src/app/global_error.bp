// blog-ssr/app/global-error — the root error fallback owns its whole document:
// by the time it runs, the layout that would have written `<html>` failed.

import {Element, htmlTag, head, body, title, main, h1, p, button, text, ErrorInfo, resetAttr} from "jhonstart";

pub fn GlobalError(info: ErrorInfo) -> Element {
    return htmlTag([
        head([title([text("Something went wrong")])]),
        body([main([
            h1([text("Something went wrong")]),
            p([text("Reference: " + info.digest)]),
            button([text("Reload")], attrs: [resetAttr("root")]),
        ], attrs: [#("class", "global-error")])]),
    ], attrs: [#("lang", "en")]);
}
