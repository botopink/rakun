// blog-ssr/app/not-found — what front 30's render shows for `notFound()`.

import {Element, section, h2, p, a, text} from "jhonstart";

pub fn NotFound() -> Element {
    return section([
        h2([text("No such post")]),
        p([a([text("Back to the index")], attrs: [#("href", "/blog")])]),
    ], attrs: [#("class", "not-found")]);
}
