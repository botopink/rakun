// islands/theme — a provider island whose children are server-rendered: the
// subtree sits in a `serverSlot` (`data-jh-s`), which the client never
// re-renders.

import {Element, Island, div, client, clientProps} from "jhonstart";

#[clientProps]
pub type ThemeProps(theme: string)

#[client]
pub fn ThemeProvider(props: ThemeProps) -> Element {
    return div([], attrs: [#("data-theme", props.theme)]);
}

pub fn themeIsland(id: string, theme: string) -> Island {
    return Island(id: id, component: "ThemeProvider", props: [#("theme", theme)]);
}
