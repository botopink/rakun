// A template is a component (decision 117): a `@Task<Element>` return (a
// server component that only loads data) is refused, located at the annotation.
import {template, jhTemplate, LayoutProps, Element, div} from "jhonstart";

#[template("")]
pub fn Shell(props: LayoutProps) -> @Task<Element> {
    return div([props.children], attrs: []);
}
