// Content inside the tag of a component that takes no `children` is refused.
import {html, isRaw} from "jhonstart-html";
import {Element, Node, div, p, span, article} from "jhonstart";

pub fn Badge(label: string) -> Element {
    return html "<span>{label}</span>";
}

pub fn Page() -> Element {
    return html """<div><Badge label="x"><p>no slot here</p></Badge></div>""";
}
