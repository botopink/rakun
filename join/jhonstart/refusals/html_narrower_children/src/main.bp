// A `children` parameter narrower than `Node` refuses what it does not name.
import {html, isRaw} from "jhonstart-html";
import {Element, Node, div, p, span, article} from "jhonstart";

pub fn One(children: Element) -> Element {
    return html "<div>{children}</div>";
}

pub fn Page() -> Element {
    return html "<One><p>a</p><p>b</p></One>";
}
