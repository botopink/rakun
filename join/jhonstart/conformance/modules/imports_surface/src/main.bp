import {Element, div, p, text, state, effect, renderToString} from "jhonstart";
import {html} from "jhonstart-html"; // the markup DSL is its own member

fn Hello(who: string) -> @Component<Element> {
    val greeted = use state(who);
    return html """<p>hello, ${greeted.value}</p>""";
}

pub fn main() -> @Task<void> {
    @print(renderToString(div([await Hello("jhonstart"), text("!", [])], [])));
}
