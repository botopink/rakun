import {RouterState, fill, snapshot, pairValue} from "jhonstart";

pub fn main() {
    fill("/blog/hi", "slug=hi", "sort=new", "/blog/[slug]", 1);
    val s = snapshot();
    @println(s.path);
    @println(s.pattern);
    @println(s.selected.toString());
    @println(pairValue(s.params, "slug"));
    @println(pairValue(s.search, "sort"));
    @println(pairValue(s.params, "missing"));
}
