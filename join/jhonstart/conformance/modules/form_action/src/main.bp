import {text, input, button, renderToString} from "jhonstart";
import {formAction, actionForm, setWireNames} from "jhonstart-forms";

pub fn main() {
    val actionField = "_action";
    setWireNames(actionField, "x-action");
    val binding = formAction("a_9f2c1b7e0d4a6c8e1f3b5d7a", "/blog/new", actionField);
    @println(renderToString(actionForm(binding, [input([], attrs: [#("name", "title")]), button([text("Save", attrs: [])], attrs: [])])));
}
