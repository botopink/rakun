//// onze-content/collections — content collections (front 121, steps 4–5).
////
//// A collection is a value: a name, a loader and the parse its entries' data
//// decode with — a `#[validated]` type's `parse` (validation, decisions 306,
//// 327: the type is the only schema).
////
////     pub fn authors() -> Collection<Author> {
////         return defineCollection("authors", file("content/authors.json"), { d -> Author.parse(d) });
////     }
////
//// A loader is `fn() -> @Task<@Result<Array<RawEntry>, string>>` — `glob`
//// and `file` build one, an application may write its own. A `RawEntry` is
//// what a loader read: an id, the entry's data as a `Json` document, a body
//// and the file it came from. Nothing is typed until the parse decodes the
//// data.
////
//// TWO TIMES. At build, `writeStore(collections, outDir)` — what `onze sync`
//// runs — loads every collection from its files, decodes every entry, checks
//// ids and references, and refuses with every problem as
//// `<file>: <path>: <message>`; with none it writes
//// `<outDir>/content/<name>.json`. At run time `getCollection` reads that
//// store once `useStore(outDir)` named it (the server's boot), and the files
//// otherwise (`onze dev`, a test). A store entry keeps the data as the file
//// wrote it and decodes it again on read, so the store needs no encoder.
////
//// FAIL, NEVER SKIP. A violation, a repeated id, a reference to a missing
//// entry and a file the loader cannot read are problems of the sync. A read at
//// run time that meets one (only possible without a store) panics naming it:
//// an entry is never dropped from a collection.
////
//// `glob` reads `.json` entries — one object per file. A `.md` entry needs a
//// frontmatter reader, which is step 3's (decision `08-f`, pending): until it
//// lands a `.md` file under a `glob` is a problem naming the step.

import {markdown.parse, markdown.headings, markdown.slug, markdown.TocEntry} from "markdown";
import {element.toElement};
import {Element} from "jhonstart";
import {report.ValidationReport, report.Violation} from "validation";
import {json, json.Json, io.fs, io.env, path} from "std";

// What a loader read: the entry's id, its data, its body (Markdown; `""` for a
// data entry) and the file it came from, as the loader spells it.
pub type RawEntry(
    id: string,
    data: Json,
    body: string,
    filePath: string,
)

// Reads a collection's entries. `glob` and `file` build one; an application
// writes its own as any function of this type.
pub type Loader = fn() -> @Task<@Result<Array<RawEntry>, string>>;

// `field` of every entry names an entry of `collection` (`Str`, or an `Arr`
// of `Str`): checked by the sync once every collection loaded.
pub type Reference(
    field: string,
    collection: string,
)

// One typed entry.
pub type Entry<T>(
    id: string,
    collection: string,
    data: T,
    body: string,
    filePath: string,
)

// What `render` answers: the body as an element tree and its headings.
pub type Rendered(
    content: Element,
    headings: Array<TocEntry>,
)

pub type Collection<T>(
    name: string,
    loader: Loader,
    parse: fn(data: Json) -> @Result<T, ValidationReport>,
    references: Array<Reference>,
) {
    // LANGUAGE GAP: A field marker cannot be read by the library that takes the type — `#[reference("authors")] author: string` is the form; the collection names the field until step 10's type decorator reads its fields' markers.
    pub fn reference(
        self: Self<T>,
        field: string,
        collection: string,
    ) -> Collection<T> {
        return Collection(
            name: self.name,
            loader: self.loader,
            parse: self.parse,
            references: self.references.append(
                [Reference(field: field, collection: collection)],
            ),
        );
    }

    // The collection with its entry type erased — what a list of collections
    // of different types holds (`writeStore`, `syncProblems`).
    pub fn erased(self: Self<T>) -> AnyCollection {
        val parse = self.parse;
        return AnyCollection(
            name: self.name,
            loader: self.loader,
            check: { data -> violationsFor(parse, data) },
            references: self.references,
        );
    }
}

// A collection whose entry type is erased: its parse survives as `check`,
// the violations of one entry's data.
pub type AnyCollection(
    name: string,
    loader: Loader,
    check: fn(data: Json) -> Array<Violation>,
    references: Array<Reference>,
)

fn violationsFor<T>(
    parse: fn(data: Json) -> @Result<T, ValidationReport>,
    data: Json,
) -> Array<Violation> {
    val none: Array<Violation> = [];
    return case parse(data) {
        Ok(_) -> none;
        Error(report) -> report.violations;
    };
}

pub fn defineCollection<T>(
    name: string,
    loader: Loader,
    parse: fn(data: Json) -> @Result<T, ValidationReport>,
) -> Collection<T> {
    val none: Array<Reference> = [];
    return Collection(
        name: name,
        loader: loader,
        parse: parse,
        references: none,
    );
}

// ── loaders ─────────────────────────────────────────────────────────────────

// Every file under `base` matching `pattern` (std's `fs.glob`, sorted) is one
// entry. Its id is its path under `base` without the extension, each segment
// slugged (`2026/Hello World.json` → `2026/hello-world`); a `slug` member of
// its data, a string, overrides it.
pub fn glob(base: string, pattern: string) -> Loader {
    return { -> loadGlob(base, pattern) };
}

fn loadGlob(
    base: string,
    pattern: string,
) -> @Task<@Result<Array<RawEntry>, string>> {
    val listed = fs.glob(pattern, base);
    if (listed.isError())
        throw base
            + ": "
            + pattern
            + ": cannot be listed - "
            + errorText(listed);
    val found = try listed;
    var out: Array<RawEntry> = [];
    var problems: Array<string> = [];
    for (found) { rel ->
        val file = path.join([base, rel]);
        val read = globEntry(file, rel);
        out = case read {
            Ok(entry) -> out.append([entry]);
            Error(_) -> out;
        };
        problems = case read {
            Ok(_) -> problems;
            Error(problem) -> problems.append([problem]);
        };
    }
    if (problems.length > 0) throw problems.join("\n");
    return out;
}

fn globEntry(file: string, rel: string) -> @Result<RawEntry, string> {
    val ext = path.extname(rel);
    if (ext == ".md")
        throw file
            + ": a Markdown entry needs the frontmatter reader of front 121 step 3 (decision 08-f)";
    if (ext != ".json")
        throw file
            + ": a glob entry is a .json file, and this is `"
            + ext
            + "`";
    val text = try readFile(file);
    val data = try decodeFile(file, text);
    if (!data.isObject())
        throw file
            + ": an entry is a JSON object, and this is "
            + data.kindName();
    val own = case data.field("slug") ?? Json.Null {
        Str(value) -> value;
        _ -> "";
    };
    val id = if (own != "") own else idOf(path.withoutExtension(rel));
    if (id == "" || id.split("/").contains(""))
        throw file
            + ": its path slugs to an empty id - name the file or give it a `slug`";
    return RawEntry(id: id, data: data, body: "", filePath: file);
}

fn readFile(file: string) -> @Result<string, string> {
    val read = fs.readText(file);
    if (read.isError()) throw file + ": cannot be read";
    return try read;
}

fn decodeFile(file: string, text: string) -> @Result<Json, string> {
    val decoded = json.decode(text);
    if (decoded.isError())
        throw file + ": not a JSON document - " + errorText(decoded);
    return try decoded;
}

fn errorText<T>(r: @Result<T, string>) -> string {
    return case r {
        Ok(_) -> "";
        Error(reason) -> reason;
    };
}

// The id of a path under a loader's base: each segment slugged.
fn idOf(stem: string) -> string {
    return stem.split("/").map({ s -> slug(s) }).join("/");
}

// One JSON file holding every entry: an array of objects, each with a
// non-empty string `id`, unique in the file. The `id` member is the entry's id
// and is not part of its data.
pub fn file(source: string) -> Loader {
    return { -> loadFile(source) };
}

fn loadFile(file: string) -> @Task<@Result<Array<RawEntry>, string>> {
    val text = try readFile(file);
    val doc = try decodeFile(file, text);
    val isList = case doc {
        Arr(_) -> true;
        _ -> false;
    };
    if (!isList)
        throw file
            + ": a file loader reads an array of entries, and this is "
            + doc.kindName();
    var out: Array<RawEntry> = [];
    var seen: Array<string> = [];
    var problems: Array<string> = [];
    var i = 0;
    for (doc.items()) { item ->
        val at = "[" + i.toString() + "]";
        val id = case item.field("id") ?? Json.Null {
            Str(value) -> value;
            _ -> "";
        };
        val problem = if (!item.isObject())
            "an entry is a JSON object, and this is " + item.kindName()
        else if (id == "")
            "an entry needs an `id`, a non-empty string"
        else if (seen.contains(id))
            "id \""
                + id
                + "\" repeats entry ["
                + seen.indexOf(id).toString()
                + "]"
        else
            "";
        if (problem != "")
            problems = problems.append([file + ": " + at + ": " + problem]);
        seen = seen.append([id]);
        val data = Json.Obj(
            members: item.members().filter({ m -> m._0 != "id" }),
        );
        out = out.append(
            [RawEntry(id: id, data: data, body: "", filePath: file)],
        );
        i = i + 1;
    }
    if (problems.length > 0) throw problems.join("\n");
    return out;
}

// ── the store ───────────────────────────────────────────────────────────────

// The variable that names the store's directory to every reader of this
// process — set by `useStore`, read by `getCollection`.
fn storeVariable() -> string {
    return "ONZE_CONTENT_STORE";
}

// From now on `getCollection` reads `<outDir>/content/<name>.json` and never
// a content file — what the server does at boot over the build's output.
pub fn useStore(outDir: string) -> void {
    env.write(storeVariable(), outDir);
}

// From now on `getCollection` loads from the content files (`onze dev`).
pub fn useFiles() -> void {
    env.clear(storeVariable());
}

// The store file of `name` under `outDir`.
pub fn storeFile(outDir: string, name: string) -> string {
    return path.join([outDir, "content", name + ".json"]);
}

fn storeText(name: string, entries: Array<RawEntry>) -> string {
    val rows = entries.map({ e ->
        json.object(
            [
                #("id", json.quote(e.id)),
                #("filePath", json.quote(e.filePath)),
                #("body", json.quote(e.body)),
                #("data", jsonText(e.data)),
            ],
        );
    });
    return json.object(
        [#("collection", json.quote(name)), #("entries", json.array(rows))],
    );
}

// A `Json` value as JSON text — the store keeps every entry's data as its
// file wrote it.
fn jsonText(value: Json) -> string {
    return case value {
        Null -> "null";
        Bool(flag) -> if (flag) "true" else "false";
        Num(n) -> n.toString();
        Str(text) -> json.quote(text);
        Arr(items) -> json.array(items.map({ i -> jsonText(i) }));
        Obj(members) -> json.object(
            members.map({ m -> #(m._0, jsonText(m._1)) }),
        );
    };
}

fn readStore(file: string, name: string) -> @Result<Array<RawEntry>, string> {
    val text = try readFile(file);
    val doc = try decodeFile(file, text);
    val stored = case doc.field("collection") ?? Json.Null {
        Str(value) -> value;
        _ -> "";
    };
    if (stored != name)
        throw file
            + ": the store of collection \""
            + stored
            + "\", not \""
            + name
            + "\"";
    return (doc.field("entries") ?? Json.Null)
        .items()
        .map({ e ->
            RawEntry(
                id: (e.field("id") ?? Json.Null).str(),
                data: e.field("data") ?? Json.Null,
                body: (e.field("body") ?? Json.Null).str(),
                filePath: (e.field("filePath") ?? Json.Null).str(),
            );
        });
}

fn rawEntriesOf(
    name: string,
    loader: Loader,
) -> @Task<@Result<Array<RawEntry>, string>> {
    val store = env.read(storeVariable()) ?? "";
    if (store != "") return try readStore(storeFile(store, name), name);
    val loaded = await loader();
    return try loaded;
}

// ── reading at run time ─────────────────────────────────────────────────────

// Every entry of `c`, in the loader's order, its data decoded by the
// collection's parse. A collection that cannot be read or an entry that does
// not decode panics, naming it.
pub fn getCollection<T>(c: Collection<T>) -> @Task<Array<Entry<T>>> {
    val raw = await rawEntriesOf(c.name, c.loader);
    val entries = case raw {
        Ok(found) -> found;
        Error(problem) -> failRead(c.name, problem);
    };
    return entries.map({ e -> typedEntry(c, e) });
}

fn failRead(name: string, problem: string) -> Array<RawEntry> {
    @panic("collection \"" + name + "\": " + problem);
}

fn typedEntry<T>(c: Collection<T>, e: RawEntry) -> Entry<T> {
    val parse = c.parse;
    val decoded = parse(e.data);
    return case decoded {
        Ok(data) -> Entry(
            id: e.id,
            collection: c.name,
            data: data,
            body: e.body,
            filePath: e.filePath,
        );
        Error(report) -> failDecode(e, report);
    };
}

fn failDecode<T>(e: RawEntry, report: ValidationReport) -> Entry<T> {
    @panic(violationLines(e.filePath, report.violations).join("\n"));
}

// The entries of `c` that `keep` answers `true` for.
pub fn getCollectionWhere<T>(
    c: Collection<T>,
    keep: fn(entry: Entry<T>) -> bool,
) -> @Task<Array<Entry<T>>> {
    val all = await getCollection(c);
    return all.filter({ e -> keep(e) });
}

// The entry of `c` whose id is `id`, `null` when there is none.
pub fn getEntry<T>(c: Collection<T>, id: string) -> @Task<?Entry<T>> {
    val all = await getCollection(c);
    val hit = all.filter({ e -> e.id == id });
    if (hit.length == 0) return null;
    return hit.at(0);
}

// The entry's body as an element tree, and its headings.
pub fn render<T>(entry: Entry<T>) -> Rendered {
    val doc = parse(entry.body);
    return Rendered(content: toElement(doc), headings: headings(doc));
}

// ── the sync ────────────────────────────────────────────────────────────────

// One collection as the sync read it.
type Loaded(
    collection: AnyCollection,
    entries: Array<RawEntry>,
)

// What one pass over every collection found.
type Gathered(
    loaded: Array<Loaded>,
    problems: Array<string>,
)

fn violationLines(file: string, violations: Array<Violation>) -> Array<string> {
    return violations.map({ v ->
        if (v.field == "")
            file + ": " + v.message
        else
            file + ": " + v.field + ": " + v.message;
    });
}

// The problems of one collection's entries: every violation of every entry
// and every id two entries share.
fn entryProblems(c: AnyCollection, entries: Array<RawEntry>) -> Array<string> {
    val check = c.check;
    var out: Array<string> = [];
    var ids: Array<string> = [];
    for (entries) { e ->
        out = out.append(violationLines(e.filePath, check(e.data)));
        val first = ids.indexOf(e.id);
        if (first >= 0)
            out = out.append(
                [
                    e.filePath
                        + ": id \""
                        + e.id
                        + "\" is also the id of "
                        + (entries.at(first) ?? e).filePath,
                ],
            );
        ids = ids.append([e.id]);
    }
    return out;
}

fn idsOf(loaded: Array<Loaded>, name: string) -> ?Array<string> {
    val hit = loaded.filter({ l -> l.collection.name == name });
    if (hit.length == 0) return null;
    var ids: Array<string> = [];
    for (hit) { l ->
        ids = ids.append(l.entries.map({ e -> e.id }));
    }
    return ids;
}

fn referenceProblems(loaded: Array<Loaded>) -> Array<string> {
    var out: Array<string> = [];
    for (loaded) { l ->
        for (l.collection.references) { r ->
            val targets = idsOf(loaded, r.collection);
            if (targets == null)
                out = out.append(
                    [
                        "collection \""
                            + l.collection.name
                            + "\": `"
                            + r.field
                            + "` references collection \""
                            + r.collection
                            + "\", which is not synced",
                    ],
                )
            else {
                val ids = targets;
                for (l.entries) { e ->
                    for (referencedIds(
                        e.data.field(r.field) ?? Json.Null,
                    )) { id ->
                        if (!ids.contains(id))
                            out = out.append(
                                [
                                    e.filePath
                                        + ": "
                                        + r.field
                                        + ": no entry \""
                                        + id
                                        + "\" in collection \""
                                        + r.collection
                                        + "\"",
                                ],
                            );
                    }
                }
            }
        }
    }
    return out;
}

// The ids a reference member names: a string, or an array of strings. Any
// other value is the schema's to refuse.
fn referencedIds(value: Json) -> Array<string> {
    return case value {
        Str(id) -> [id];
        Arr(items) -> items
            .filter({ i -> i.str() != "" })
            .map({ i -> i.str() });
        _ -> [];
    };
}

fn gather(collections: Array<AnyCollection>) -> @Task<Gathered> {
    var loaded: Array<Loaded> = [];
    var problems: Array<string> = [];
    var names: Array<string> = [];
    for (collections) { c ->
        if (names.contains(c.name))
            problems = problems.append(
                ["collection \"" + c.name + "\" is defined twice"],
            );
        names = names.append([c.name]);
        val load = c.loader;
        val read = await load();
        problems = case read {
            Ok(entries) -> problems.append(entryProblems(c, entries));
            Error(problem) -> problems.append([problem]);
        };
        loaded = case read {
            Ok(entries) -> loaded.append(
                [Loaded(collection: c, entries: entries)],
            );
            Error(_) -> loaded;
        };
    }
    return Gathered(
        loaded: loaded,
        problems: problems.append(referenceProblems(loaded)),
    );
}

// Every problem of `collections`, read from their files: each violation as
// `<file>: <path>: <message>`, a repeated id, a reference to a missing entry,
// a file the loader could not read. Empty when the content is sound.
pub fn syncProblems(collections: Array<AnyCollection>) -> @Task<Array<string>> {
    val found = await gather(collections);
    return found.problems;
}

// `dir` and every missing parent.
fn makeDirs(dir: string) -> @Result<i32, string> {
    if (fs.exists(dir)) return 0;
    try makeDirs(path.dirname(dir));
    val made = fs.mkdir(dir);
    if (made.isError()) throw dir + ": cannot be created - " + errorText(made);
    return 0;
}

// `onze sync`: refuses with every problem, one per line; with none, writes
// `<outDir>/content/<name>.json` for every collection and answers how many
// entries it wrote.
pub fn writeStore(
    collections: Array<AnyCollection>,
    outDir: string,
) -> @Task<@Result<i32, string>> {
    val found = await gather(collections);
    if (found.problems.length > 0) throw found.problems.join("\n");
    try makeDirs(path.join([outDir, "content"]));
    var count = 0;
    for (found.loaded) { l ->
        val name = l.collection.name;
        val written = fs.writeText(
            storeFile(outDir, name),
            storeText(name, l.entries),
        );
        if (written.isError())
            throw storeFile(outDir, name) + ": cannot be written";
        count = count + l.entries.length;
    }
    return count;
}
