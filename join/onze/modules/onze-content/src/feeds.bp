//// onze-content/feeds — an RSS 2.0 document (front 121, step 5).
////
//// `rssFeed(feed)` writes one channel with one `<item>` per `RssItem`. Every
//// text node goes through std's `escape.html` (`&`, `<`, `>`), so no title or
//// description closes its element. A link rooted at `/` is made absolute
//// against the feed's `site`; any other link is written as given. A date is
//// epoch milliseconds, written as RFC 822 (`Sat, 10 Jan 2026 12:00:00 GMT`),
//// the form RSS 2.0 requires.
////
//// Reference: https://www.rssboard.org/rss-specification

import {escape, io.clock} from "std";

pub type RssItem(
    title: string,
    link: string,
    description: ?string = null,
    pubDate: ?i64 = null,
)

pub type RssFeed(
    title: string,
    description: string,
    site: string,
    items: Array<RssItem>,
)

pub fn rssFeed(feed: RssFeed) -> string {
    val items = feed.items.map({ i -> itemXml(feed.site, i) }).join("");
    return [
        "<?xml version=\"1.0\" encoding=\"UTF-8\"?><rss version=\"2.0\"><channel>",
        element("title", feed.title),
        element("description", feed.description),
        element("link", feed.site),
        items,
        "</channel></rss>",
    ].join("");
}

fn itemXml(site: string, item: RssItem) -> string {
    val link = absolute(site, item.link);
    val description = if (item.description != null)
        element("description", item.description ?? "")
    else
        "";
    val date = if (item.pubDate != null)
        element("pubDate", rfc822(item.pubDate ?? clock.nowMillis()))
    else
        "";
    return [
        "<item>",
        element("title", item.title),
        element("link", link),
        "<guid isPermaLink=\"true\">",
        escape.html(link),
        "</guid>",
        description,
        date,
        "</item>",
    ].join("");
}

fn element(name: string, text: string) -> string {
    return ["<", name, ">", escape.html(text), "</", name, ">"].join("");
}

fn absolute(site: string, link: string) -> string {
    if (!link.startsWith("/")) return link;
    val base = if (site.endsWith("/")) site.slice(0, site.length - 1) else site;
    return base + link;
}

fn twoDigits(n: i32) -> string {
    return if (n < 10) "0" + n.toString() else n.toString();
}

// RFC 822 (with RFC 1123's four-digit year), in GMT.
pub fn rfc822(epochMillis: i64) -> string {
    val c = clock.toCivil(epochMillis);
    val days = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
    val months = [
        "Jan",
        "Feb",
        "Mar",
        "Apr",
        "May",
        "Jun",
        "Jul",
        "Aug",
        "Sep",
        "Oct",
        "Nov",
        "Dec",
    ];
    return [
        days.at(c.weekday - 1) ?? "",
        ", ",
        twoDigits(c.day),
        " ",
        months.at(c.month - 1) ?? "",
        " ",
        c.year.toString(),
        " ",
        twoDigits(c.hour),
        ":",
        twoDigits(c.minute),
        ":",
        twoDigits(c.second),
        " GMT",
    ].join("");
}
