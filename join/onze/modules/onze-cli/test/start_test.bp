// `botopink test` suite for `src/start.bp` (front 50 step 8): the port's
// precedence, the refusal of a project never built, and `onze build` then
// the server `start` runs — the scaffold's `/`, and the blog's
// `/blog/hello-world` and `/about` (front 53 step 2), over a real socket.
// Every build goes under the run's `BOTOPINK_TEST_TMPDIR`.

import {build.buildProject};
import {resolve.Project, resolve.resolveProject};
import {start.startPort, start.spawnServer, start.serverCommand, start.pidOf, start.serverMainSource};
import {OnzeConfig, AliasMap, defaultConfig} from "onze";
import {main.Outcome, main.run};
import {io.fs, io.process, io.env, path} from "std";

fn testTmp() -> string {
    val root = env.read("BOTOPINK_TEST_TMPDIR") ?? "";
    assert root
        != "", "BOTOPINK_TEST_TMPDIR is not set: run this suite under `botopink test`";
    return root;
}

// The compiler the fixtures build with: `BOTOPINK_BIN` when the caller names
// one (the hook and CI do — the same binary that runs this suite), else the
// ancestor checkout's `repository/botopink-lang/zig-out/bin/botopink`.
fn botopinkBin() -> string {
    val named = env.read("BOTOPINK_BIN") ?? "";
    if (named != "" && fs.exists(named)) return named;
    var dir = process.cwd();
    var found = "";
    var guard = 0;
    while (found == "" && guard < 12) {
        val cand = path.join(
            [dir, "repository", "botopink-lang", "zig-out", "bin", "botopink"],
        );
        if (fs.exists(cand)) found = cand;
        dir = path.dirname(dir);
        guard = guard + 1;
    }
    return found;
}

fn repositoryDir() -> string {
    return path.normalize(path.join([process.cwd(), "..", "..", ".."]));
}

fn projectInto(dir: string, outDir: string) -> @Result<Project, string> {
    val p = try resolveProject(dir);
    val c = p.config;
    return Project(
        root: p.root,
        config: OnzeConfig(..c, outDir: outDir),
        aliases: p.aliases,
    );
}

fn portText(r: @Result<i32, string>) -> string {
    return case r {
        Ok(n) -> n.toString();
        Error(e) -> e;
    };
}

// GET `pathname` on 127.0.0.1:`port`, retrying while the node boots:
// `<status>\n<body>`.
fn get(port: i32, pathname: string) -> @Result<string, string> {
    return try getWith(port, pathname, []);
}

// `get` with extra curl arguments (a header).
fn getWith(
    port: i32,
    pathname: string,
    extra: string[],
) -> @Result<string, string> {
    val r = try process.run(
        "curl",
        [
            "-s",
            "-o",
            "-",
            "-w",
            "\n%{http_code}",
            "--retry",
            "180",
            "--retry-connrefused",
            "--retry-delay",
            "1",
            "--max-time",
            "120",
        ]
            .append(extra)
            .append(["http://127.0.0.1:" + port.toString() + pathname]),
    );
    val lines = r.stdout.split("\n");
    val status = lines.at(lines.length - 1) ?? "";
    return status + "\n" + lines.take(lines.length - 1).join("\n");
}

// A port the OS hands out on 127.0.0.1 — a listener on port 0, closed at
// once. The gate runs this suite's commonJS and erlang cells side by side (and
// two gates may share the machine), so no port is written into the test: a
// fixed one let a request reach the other cell's server. `node` asks — the one
// host both cells drive (`build` runs it for the styleMap probe).
fn freePort() -> @Result<i32, string> {
    val r = try process.run(
        "node",
        [
            "-e",
            "const s = require('net').createServer(); s.listen(0, '127.0.0.1', () => { process.stdout.write(String(s.address().port)); s.close(); });",
        ],
    );
    val text = r.stdout.trim();
    val n = case text.parseInt() {
        Ok(v) -> v.toI32();
        Error(_) -> 0;
    };
    if (r.status != 0 || n < 1 || n > 65535)
        throw "no free port from the OS: status "
            + r.status.toString()
            + ", \""
            + text
            + "\" "
            + r.stderr.trim();
    return n;
}

fn stop(pid: i32) -> i32 {
    val k = process.run("kill", [pid.toString()]);
    return pid;
}

test "start: the port ---- -p, then PORT, then onze.json" {
    assert portText(startPort(["-p", "4000"], "5000", 3000)) == "4000";
    assert portText(startPort([], "5000", 3000)) == "5000";
    assert portText(startPort([], "", 3000)) == "3000";
    assert portText(startPort(["-p", "x"], "", 3000))
        == "onze start -p: \"x\" is not a port number";
    assert portText(startPort([], "70000", 3000))
        == "PORT: 70000 is outside 1..65535";
    assert pidOf("4242\n") == 4242;
    assert pidOf("") == 0 - 1;
}

test "start: the server's main ---- the config build resolved, PORT over it" {
    val src = serverMainSource(defaultConfig());
    assert src.contains(
        "OnzeConfig(name: \"\", port: 3000, basePath: \"\", appDir: \"app\", publicDir: \"public\", outDir: \".onze\", dev: false, actionsBodyLimit: 1048576, allowedRedirects: [], lang: \"en\")",
    );
    assert src.contains("import {Onze} from \"onze-server\";");
    assert src.contains("import {onze_routes.routeModules};");
    assert src.contains(
        "import {page, layout, template, defaultView, jhRegisterRoutes} from \"jhonstart\";",
    );
    assert src.contains("    @TypeInfo" + ".all(with: page),");
    assert src.contains("Onze.run(withPort(c, portOr(c.port)));");
}

test "start: a project never built exits non-zero naming the directory" {
    val dir = path.join([testTmp(), "unbuilt"]);
    val made = process.run("mkdir", ["-p", dir]);
    val created = run(
        dir,
        ["create", "fresh", "--yes", "--libs", repositoryDir()],
        "test",
    );
    assert created.code == 0;
    val out = run(path.join([dir, "fresh"]), ["start"], "test");
    assert out.code != 0;
    assert out.text.contains(path.join([dir, "fresh", ".onze"]));
    assert out.text.contains("run `onze build` first");
}

test "start: onze build && onze start serves the scaffold's /" {
    val dir = path.normalize(
        path.join([process.cwd(), "..", "..", "examples", "scaffold"]),
    );
    val p = try projectInto(dir, path.join([testTmp(), "scaffold-start"]));
    val built = try buildProject(p, botopinkBin());
    val port = try freePort();
    assert serverCommand(p, port).contains(
        "PORT=" + port.toString() + " exec erl -noshell",
    );
    val pid = try spawnServer(p, port);
    val home = get(port, "/");
    val missing = get(port, "/nowhere");
    val stopped = stop(pid);
    val page = try home;
    assert page.startsWith("200\n");
    assert page.contains("Welcome to scaffold");
    assert page.contains("<html lang=\"en\">");
    val missingPage = try missing;
    assert missingPage.startsWith("404\n");
}

test "start: the blog through onze build && onze start ---- its pages, not-found boundary, dashboard gate, bundle tags and chunk" {
    val dir = path.normalize(
        path.join([process.cwd(), "..", "..", "examples", "blog"]),
    );
    val out = path.join([testTmp(), "blog-start"]);
    val p = try projectInto(dir, out);
    val built = try buildProject(p, botopinkBin());
    assert fs.exists(path.join([out, "client-manifest.txt"]));
    assert fs.exists(path.join([out, "client", "src", "onze_entry.bp"]));
    assert fs.exists(path.join([out, "client-js", "onze_entry.js"]));
    val sharedChunk = fs
        .readText(
            path.join([out, "static", built.buildId, built.chunks.at(0) ?? ""]),
        )
        .unwrapOr("");
    // A chunk registers each module it carries as `["<path>.js"] = function`;
    // the module table is what is asserted, not any text a comment may hold.
    assert sharedChunk.contains("[\"components/like_button.js\"] = function");
    assert sharedChunk.contains("[\"lib/db.js\"]") == false;
    val entryChunk = built.chunks.at(1) ?? "";
    val sheet = built.chunks.at(2) ?? "";
    val port = try freePort();
    val pid = try spawnServer(p, port);
    val post = get(port, "/blog/hello-world");
    val about = get(port, "/about");
    val grouped = get(port, "/marketing/about");
    val chunk = get(port, "/_onze/static/" + built.buildId + "/" + entryChunk);
    val missingPost = get(port, "/blog/does-not-exist");
    val gated = getWith(port, "/dashboard", ["-D", "-"]);
    val signedIn = getWith(port, "/dashboard", ["-H", "Cookie: session=s1"]);
    val stopped = stop(pid);
    val postPage = try post;
    assert postPage.startsWith("200\n");
    assert postPage.contains("<h1>Hello, world</h1>");
    assert postPage.contains("The first post of the blog. It says hello.");
    assert postPage.contains("data-jh-i=\"i0\"");
    assert postPage.contains(
        "/_onze/static/" + built.buildId + "/" + entryChunk,
    );
    assert postPage.contains("/_onze/static/" + built.buildId + "/" + sheet);
    val chunkBody = try chunk;
    assert chunkBody.startsWith("200\n");
    assert chunkBody.contains("onzeEntryMain");
    val aboutPage = try about;
    assert aboutPage.startsWith("200\n");
    assert aboutPage.contains("A blog that exercises every onze seam at once.");
    val groupedPage = try grouped;
    assert groupedPage.startsWith("404\n");
    val missing = try missingPost;
    assert missing.startsWith("404\n");
    assert missing.contains("No such post.");
    assert missing.contains("Nothing lives at this address.") == false;
    val gate = try gated;
    assert gate.startsWith("307\n");
    assert gate.contains("location: /login");
    val dashboard = try signedIn;
    assert dashboard.startsWith("200\n");
    assert dashboard.contains("<h1>Your posts</h1>");
}
