//// The `onze-test` package — module-tree root (front 49 owns it; each
//// track-E front hands it its `pub mod` line).
////
//// The test-helper member every library carries (front 95,
//// `specs/1.0.10-beta/02-packaging/README.md` § 5): `assert<Subject>(loc, …)
//// -> @Result<void, string>` helpers that render a domain value to one
//// canonical text and hand it to `snap`'s `assertAs` with the
//// CALLER's `@src()`, and the fixture builders. It re-exports nothing from
//// std, and mocking is std's (decision 71).

pub mod core;
pub mod fixtures;
pub mod cli;
pub mod bundler;
pub mod assets;
pub mod og;
pub mod release;
pub mod e2e;
