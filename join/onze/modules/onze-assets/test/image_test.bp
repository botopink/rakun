// `botopink test` suite for `src/image.bp` and `src/image_handler.bp` (front
// 51) — both rows. The encoder is a stand-in script (it copies the input to
// the output), a failing one and a slow one, so the port protocol and the
// failure paths are asserted without `vips` installed.

import {image.ImageProps, image.RemotePattern, image.ImageConfig, image.defaultImageProps, image.defaultImageConfig, image.validateSource, image.validateConfig, image.validateProps, image.Image, image.srcsetOf, image.refusedImages};
import {image_handler.EncodeRequest, image_handler.ImageOutcome, image_handler.encode, image_handler.encoderArgs, image_handler.imageResponse, image_handler.negotiate, image_handler.cacheKey};
import {Element, renderNode} from "jhonstart";
import {io.fs, io.process, io.process.Exit, io.clock, path, io.env} from "std";
import {assertAs} from "snap";

// The run's own scratch directory — `botopink test` names it in
// `BOTOPINK_TEST_TMPDIR`, and it is the one place a test writes.
fn testTmp() -> string {
    val root = env.read("BOTOPINK_TEST_TMPDIR") ?? "";
    assert root
        != "", "BOTOPINK_TEST_TMPDIR is not set: run this suite under `botopink test`";
    return root;
}

fn cdn() -> ImageConfig {
    val d = defaultImageConfig();
    return ImageConfig(remotePatterns: [RemotePattern(protocol: "https", hostname: "*.example.com", pathPrefix: "/photos/", port: "")], formats: d.formats, deviceWidths: d.deviceWidths, encoder: d.encoder, encoderTimeoutMs: d.encoderTimeoutMs);
}

fn verdict(cfg: ImageConfig, src: string) -> string {
    return case validateSource(cfg, "public", src) {
        Ok(v) -> "ok       " + v;
        Error(e) -> "refused  " + e;
    };
}

fn withEncoder(cfg: ImageConfig, encoder: string, timeoutMs: i32) -> ImageConfig {
    return ImageConfig(remotePatterns: cfg.remotePatterns, formats: cfg.formats, deviceWidths: cfg.deviceWidths, encoder: encoder, encoderTimeoutMs: timeoutMs);
}

fn scratch() -> string {
    val dir = path.join([testTmp(), "img-" + clock.nowMillis().toString()]);
    val made = process.run("mkdir", ["-p", path.join([dir, "public", "images"])]);
    return dir;
}

fn script(dir: string, name: string, body: string) -> string {
    val file = path.join([dir, name]);
    val w = fs.writeText(file, "#!/bin/sh\n" + body + "\n");
    val x = process.run("chmod", ["+x", file]);
    return file;
}

fn html(e: Element) -> string {
    return renderNode(e);
}

test "image: allowlist ---- the matrix" {
    val d = defaultImageConfig();
    try assertAs(@src(), "allowlist", [
        verdict(d, "https://cdn.example.com/photos/a.jpg"),
        verdict(cdn(), "https://cdn.example.com/photos/a.jpg"),
        verdict(cdn(), "http://cdn.example.com/photos/a.jpg"),
        verdict(cdn(), "https://cdn.example.com:8443/photos/a.jpg"),
        verdict(cdn(), "https://cdn.example.com/other/a.jpg"),
        verdict(cdn(), "https://example.com/photos/a.jpg"),
        verdict(cdn(), "https://a.b.example.com/photos/a.jpg"),
        verdict(cdn(), "https://cdn.example.com/photos/../../etc/passwd"),
        verdict(d, "/images/hero.jpg"),
        verdict(d, "/photos/../../../etc/passwd"),
        verdict(d, "images/relative.jpg"),
        verdict(d, "data:image/png;base64,iVBORw0KGgo="),
        verdict(d, "file:///etc/passwd"),
    ].join("\n"));
}

test "image: config ---- a * host is refused at load" {
    val any = ImageConfig(remotePatterns: [RemotePattern(protocol: "https", hostname: "*", pathPrefix: "", port: "")], formats: ["image/webp"], deviceWidths: [640], encoder: "vips", encoderTimeoutMs: 5000);
    assert validateConfig(any).length == 1;
    assert validateConfig(defaultImageConfig()).length == 0;
    assert defaultImageConfig().remotePatterns.length == 0;
}

test "image: props ---- quality, blur, fill and priority refusals" {
    val base = defaultImageProps("/images/hero.jpg", "hero", 1200, 630);
    assert validateProps(base).length == 0;
    assert (validateProps(ImageProps(src: base.src, alt: "", width: 1200, height: 630, fill: false, sizes: "", priority: false, quality: 101, placeholder: "empty", blurDataURL: "", loading: "")).at(0) ?? "").contains("quality 101");
    assert validateProps(ImageProps(src: base.src, alt: "x", width: 1200, height: 630, fill: false, sizes: "", priority: false, quality: 75, placeholder: "blur", blurDataURL: "", loading: "")).length
        == 1;
    assert validateProps(ImageProps(src: base.src, alt: "x", width: 1200, height: 630, fill: true, sizes: "", priority: false, quality: 75, placeholder: "empty", blurDataURL: "", loading: "")).length
        == 1;
    assert validateProps(ImageProps(src: base.src, alt: "x", width: 1200, height: 630, fill: false, sizes: "", priority: true, quality: 75, placeholder: "empty", blurDataURL: "", loading: "lazy")).length
        == 1;
}

test "image: markup ---- lazy with sizes, priority, fill, blur" {
    val cfg = defaultImageConfig();
    val lazy = ImageProps(src: "/images/card.jpg", alt: "card", width: 828, height: 400, fill: false, sizes: "(max-width: 768px) 100vw, 50vw", priority: false, quality: 75, placeholder: "empty", blurDataURL: "", loading: "");
    val hero = ImageProps(src: "/images/hero.jpg", alt: "hero", width: 1200, height: 630, fill: false, sizes: "", priority: true, quality: 80, placeholder: "empty", blurDataURL: "", loading: "");
    val fill = ImageProps(src: "/images/bg.jpg", alt: "", width: 0, height: 0, fill: true, sizes: "100vw", priority: false, quality: 75, placeholder: "empty", blurDataURL: "", loading: "");
    val blurred = ImageProps(src: "/images/hero.jpg", alt: "hero", width: 640, height: 320, fill: false, sizes: "", priority: false, quality: 75, placeholder: "blur", blurDataURL: "data:image/png;base64,AAAA", loading: "");
    val lazyHtml = html(Image(lazy, cfg, "public"));
    assert lazyHtml.contains("loading=\"lazy\"");
    assert lazyHtml.contains("decoding=\"async\"");
    assert lazyHtml.split(" 640w").length == 2;
    assert lazyHtml.contains(" 1080w") == false;
    val heroHtml = html(Image(hero, cfg, "public"));
    assert heroHtml.contains("fetchpriority=\"high\"");
    assert heroHtml.contains(" 2x");
    assert heroHtml.contains("sizes=") == false;
    val fillHtml = html(Image(fill, cfg, "public"));
    assert fillHtml.contains("width=") == false;
    try assertAs(@src(), "image", [lazyHtml, heroHtml, fillHtml, html(Image(blurred, cfg, "public"))].join("\n"));
}

test "image: a refused source renders nothing and is reported" {
    val e = Image(defaultImageProps("https://evil.test/x.jpg", "x", 640, 480), defaultImageConfig(), "public");
    assert html(e) == "";
    assert refusedImages().any({ r -> r.contains("evil.test") });
}

test "image: encoder ---- an argument vector, pass-through, a timeout, a failure" {
    val dir = scratch();
    val copyEnc = script(dir, "copy-enc", "in=\"$2\"; out=\"$(printf %s \"$3\" | sed 's/\\[.*//')\"; cp \"$in\" \"$out\"");
    val slowEnc = script(dir, "slow-enc", "sleep 5");
    val failEnc = script(dir, "fail-enc", "echo 'bad header in input' >&2; exit 3");
    val w = fs.writeText(path.join([dir, "public", "images", "hero.jpg"]), "jpeg bytes");
    val cfg = withEncoder(defaultImageConfig(), copyEnc, 5000);
    val args = encoderArgs("vips", EncodeRequest(inputPath: "/a b.jpg", outputPath: "/o.webp", width: 640, quality: 75, format: "image/webp"));
    assert args.join("|") == "thumbnail|/a b.jpg|/o.webp[Q=75]|640";
    val q = [#("src", "/images/hero.jpg"), #("w", "640"), #("q", "75"), #("f", "image/webp")];
    val miss = imageResponse(cfg, q, "image/webp,*/*", dir, "public", path.join([dir, ".onze"]), "1");
    assert miss.status == 200;
    assert miss.message == "miss";
    val hit = imageResponse(cfg, q, "image/webp,*/*", dir, "public", path.join([dir, ".onze"]), "1");
    assert hit.message == "hit";
    val slow = encode(withEncoder(defaultImageConfig(), slowEnc, 1000), EncodeRequest(inputPath: "x", outputPath: "y", width: 640, quality: 75, format: "image/webp"));
    assert slow.isError();
    val failed = encode(withEncoder(defaultImageConfig(), failEnc, 5000), EncodeRequest(inputPath: "x", outputPath: "y", width: 640, quality: 75, format: "image/webp"));
    assert failed.isError();
    val missingCfg = withEncoder(defaultImageConfig(), "no-such-encoder-onze", 5000);
    val pass = imageResponse(missingCfg, q, "image/webp", dir, "public", path.join([dir, ".onze"]), "1");
    assert pass.status == 200;
    assert pass.file.endsWith("hero.jpg");
    try assertAs(@src(), "handler", [
        "#1 "
            + miss.status.toString()
            + "  "
            + miss.headers
                .map({ h -> h._0 + ": " + h._1 })
                .join("  ")
                .replace(cacheKey("/images/hero.jpg", 640, 75, "image/webp", "1"), "<key>"),
        "#2 " + hit.status.toString() + "  " + hit.message,
        "#3 "
            + imageResponse(cfg, [#("src", "/images/hero.jpg"), #("w", "999"), #("q", "75")], "image/webp", dir, "public", dir, "1").message,
        "#4 "
            + imageResponse(cfg, [#("src", "/images/hero.jpg"), #("w", "640"), #("q", "101")], "image/webp", dir, "public", dir, "1").message,
        "#5 "
            + imageResponse(cfg, [#("src", "https://cdn.example.com/a.jpg"), #("w", "640"), #("q", "75")], "image/webp", dir, "public", dir, "1").status.toString(),
        "#6 " + pass.message,
        "#7 "
            + negotiate(cfg, "image/avif", "image/webp")
            + " (avif not configured)",
    ].join("\n"));
    val gone = process.run("rm", ["-rf", dir]);
}

// The deadline kills the encoder's process group, not only the encoder: a
// child it started (`sleep 30 &`) is gone after the timeout. `kill -0` is
// retried for a moment — a killed child is a zombie until its new parent
// reaps it.
test "image: encoder ---- a timeout kills what the encoder started" {
    val dir = scratch();
    val pidFile = path.join([dir, "child.pid"]);
    val spawning = script(dir, "spawning-enc", "sleep 30 &\necho $! > \""
        + pidFile
        + "\"\nsleep 30");
    val t0 = clock.nowMillis();
    val r = encode(withEncoder(defaultImageConfig(), spawning, 1000), EncodeRequest(inputPath: "x", outputPath: "y", width: 640, quality: 75, format: "image/webp"));
    assert encodeErrorOf(r).contains("exceeded 1000 ms and was killed");
    assert clock.nowMillis() - t0 < 10000;
    val pid = fs.readText(pidFile).unwrapOr("").trim();
    assert pid != "";
    val alive = process.run("sh", ["-c", "i=0; while [ $i -lt 50 ]; do kill -0 \"$1\" 2>/dev/null || exit 1; sleep 0.1; i=$((i + 1)); done; exit 0", "probe", pid]);
    assert alive.unwrapOr(Exit(status: 0, stdout: "", stderr: "")).status == 1;
    val gone = process.run("rm", ["-rf", dir]);
}

fn encodeErrorOf(r: @Result<i32, string>) -> string {
    return case r {
        Ok(v) -> "ok";
        Error(e) -> e;
    };
}

test "image: no NIF anywhere in onze-assets" {
    for (["image.bp", "image_handler.bp"]) { f ->
        val text = fs.readText(path.join(["src", f])).unwrapOr("");
        assert text.contains("erlang:load_nif") == false;
        assert text.contains("load_nif(") == false;
    }
}
