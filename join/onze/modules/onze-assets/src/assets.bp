//// onze-assets — the static roots onze hands rakun-web front 82 (front 69
//// step 3).
////
//// onze serves no file: rakun-web front 82 is the static-file server (its
//// content types, `ETag` / `304`, traversal refusal). This front decides
//// WHICH roots exist and how they are cached — exactly two, and no
//// configuration adds a third:
////
////   /_onze/static/<buildId>/**  -> <outDir>/static/<buildId>/  immutable, 1 year
////   /**                         -> <publicDir>                 no-cache
////
//// Every other directory of a project — `app/`, `src/`, `content/`, `lib/`,
//// `.onze/` — is unreachable over HTTP: no root points at it. `AssetRoot` is
//// the record front 82's `StaticRoot` is to take field for field; front 49's
//// boot registers each with `registerStaticRoot` once front 82 lands.

pub type AssetRoot(pattern: string, directory: string, immutable: bool, cacheSeconds: i32)

pub val staticPrefix: string = "/_onze/static/";

pub fn staticRoots(publicDir: string, outDir: string, buildId: string) -> Array<AssetRoot> {
    return [
        AssetRoot(pattern: staticPrefix + buildId + "/**", directory: outDir
            + "/static/"
            + buildId
            + "/", immutable: true, cacheSeconds: 31536000),
        AssetRoot(pattern: "/**", directory: publicDir, immutable: false, cacheSeconds: 0),
    ];
}

fn describeRoot(r: AssetRoot) -> string {
    val immutable = if (r.immutable) "1" else "0";
    return r.pattern.padEnd(26, " ")
        + "-> "
        + r.directory.padEnd(23, " ")
        + "immutable="
        + immutable
        + "  cacheSeconds="
        + r.cacheSeconds.toString();
}

pub fn describeRoots(roots: Array<AssetRoot>) -> string {
    return roots.map({ r -> describeRoot(r) }).join("\n");
}
