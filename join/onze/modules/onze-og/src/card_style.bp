//// onze-og — the card style subset (front 70 step 2).
////
//// A card's `style` attribute is `name:value;` pairs in camelCase. The
//// supported set is CLOSED — `supportedProperties()` is the one list, cited by
//// the tests — and `parseStyle` is total: an unsupported property is reported
//// by `unsupportedProperties`, a malformed declaration by `malformedDeclarations`,
//// and neither is guessed at. The build refuses a card with either (the route
//// names it). Property order does not matter; a later duplicate wins.

pub type Style(
    display: string,
    flexDirection: string,
    justifyContent: string,
    alignItems: string,
    gap: i32,
    width: string,
    height: string,
    padding: string,
    margin: string,
    background: string,
    color: string,
    fontSize: i32,
    fontWeight: i32,
    fontFamily: string,
    lineHeight: i32,
    textAlign: string,
    borderRadius: i32,
    border: string,
    opacity: i32,
    position: string,
    top: string,
    left: string,
    right: string,
    bottom: string,
    maxLines: i32,
)

pub fn supportedProperties() -> string[] {
    return ["display", "flexDirection", "justifyContent", "alignItems", "gap", "width", "height", "padding", "margin", "background", "color", "fontSize", "fontWeight", "fontFamily", "lineHeight", "textAlign", "borderRadius", "border", "opacity", "position", "top", "left", "right", "bottom", "maxLines"];
}

// The properties a card may not use, each known by name so the report can
// say so rather than "unknown".
pub fn refusedProperties() -> string[] {
    return ["alignSelf", "flexWrap", "order", "letterSpacing", "textTransform", "textShadow", "filter", "boxShadow", "transform", "zIndex"];
}

pub fn emptyStyle() -> Style {
    return Style(display: "flex", flexDirection: "row", justifyContent: "flex-start", alignItems: "stretch", gap: 0, width: "", height: "", padding: "", margin: "", background: "", color: "", fontSize: 0, fontWeight: 0, fontFamily: "", lineHeight: 0, textAlign: "left", borderRadius: 0, border: "", opacity: 100, position: "relative", top: "", left: "", right: "", bottom: "", maxLines: 0);
}

// The declarations of a style attribute, `#(name, value)`, trimmed.
pub fn declarations(value: string) -> Array<#(string, string)> {
    var out: Array<#(string, string)> = [];
    var depth = 0;
    var cur = "";
    for (value.split("").append([";"])) { c ->
        if (c == "(") depth = depth + 1;
        if (c == ")") depth = depth - 1;
        val ends = c == ";" && depth == 0;
        if (ends) {
            val t = cur.trim();
            if (t != "") {
                val colon = t.indexOf(":");
                val name = if (colon < 0) t else t.slice(0, colon).trim();
                val v = if (colon < 0)
                    ""
                else
                    t.slice(colon + 1, t.length()).trim();
                out.push(#(name, v));
            }
            cur = "";
        } else cur = cur + c;
    }
    return out;
}

#[@External.Node("""(/^-?[0-9]+([.][0-9]+)?$/.test($0) ? Math.round(Number($0)) : -2147483648)""")]
#[@External.Erlang("""(fun(__S) -> try binary_to_integer(__S) catch _:_ -> try round(binary_to_float(__S)) catch _:_ -> -2147483648 end end end)($0)""")]
declare fn numberOf(s: string) -> i32;

// A length in px (or a bare number) as an integer; `-2147483648` when the
// value is not one.
pub fn pxOf(value: string) -> i32 {
    val bare = if (value.endsWith("px"))
        value.slice(0, value.length() - 2)
    else
        value;
    return numberOf(bare.trim());
}

// `0.5` → 50, a percentage of full opacity.
#[@External.Node("""(/^[0-9]*[.]?[0-9]+$/.test($0) ? Math.round(Number($0) * 100) : 100)""")]
#[@External.Erlang("""(fun(__S) -> try round(binary_to_float(__S) * 100) catch _:_ -> try binary_to_integer(__S) * 100 catch _:_ -> 100 end end end)($0)""")]
declare fn hundredths(s: string) -> i32;

fn intOr(value: string, fallback: i32) -> i32 {
    val n = pxOf(value);
    return if (n == -2147483648) fallback else n;
}

fn withProp(s: Style, name: string, v: string) -> Style {
    return Style(
        display: if (name == "display") v else s.display,
        flexDirection: if (name == "flexDirection") v else s.flexDirection,
        justifyContent: if (name == "justifyContent") v else s.justifyContent,
        alignItems: if (name == "alignItems") v else s.alignItems,
        gap: if (name == "gap") intOr(v, s.gap) else s.gap,
        width: if (name == "width") v else s.width,
        height: if (name == "height") v else s.height,
        padding: if (name == "padding") v else s.padding,
        margin: if (name == "margin") v else s.margin,
        background: if (name == "background") v else s.background,
        color: if (name == "color") v else s.color,
        fontSize: if (name == "fontSize") intOr(v, s.fontSize) else s.fontSize,
        fontWeight: if (name == "fontWeight")
            intOr(v, s.fontWeight)
        else
            s.fontWeight,
        fontFamily: if (name == "fontFamily") v else s.fontFamily,
        lineHeight: if (name == "lineHeight")
            intOr(v, s.lineHeight)
        else
            s.lineHeight,
        textAlign: if (name == "textAlign") v else s.textAlign,
        borderRadius: if (name == "borderRadius")
            intOr(v, s.borderRadius)
        else
            s.borderRadius,
        border: if (name == "border") v else s.border,
        opacity: if (name == "opacity") hundredths(v) else s.opacity,
        position: if (name == "position") v else s.position,
        top: if (name == "top") v else s.top,
        left: if (name == "left") v else s.left,
        right: if (name == "right") v else s.right,
        bottom: if (name == "bottom") v else s.bottom,
        maxLines: if (name == "maxLines") intOr(v, s.maxLines) else s.maxLines,
    );
}

pub fn parseStyle(value: string) -> Style {
    var s = emptyStyle();
    for (declarations(value)) { d ->
        val known = supportedProperties().contains(d._0) && d._1 != "";
        if (known) s = withProp(s, d._0, d._1);
    }
    return s;
}

// The declared properties outside the supported set, each once.
pub fn unsupportedProperties(value: string) -> Array<string> {
    var out: string[] = [];
    for (declarations(value)) { d ->
        val outside = supportedProperties().contains(d._0) == false
            && out.contains(d._0) == false;
        if (outside) out.push(d._0);
    }
    return out;
}

// The declarations with no value (`padding:`), as they were written.
pub fn malformedDeclarations(value: string) -> Array<string> {
    return declarations(value)
        .filter({ d -> d._1 == "" })
        .map({ d -> d._0 + ":" });
}

// The report `og` snapshots record: each supported declaration and its
// parsed value, then what was refused.
pub fn describeStyle(value: string) -> string {
    val s = parseStyle(value);
    var rows: string[] = [];
    for (declarations(value).filter({ d -> supportedProperties().contains(d._0) && d._1 != "" })) { d ->
        rows.push(d._0.padEnd(15, " ") + d._1);
    }
    val unsupported = unsupportedProperties(value);
    if (unsupported.length > 0)
        rows.push("unsupported: " + unsupported.join(", "));
    val malformed = malformedDeclarations(value);
    if (malformed.length > 0)
        rows.push("malformed: "
            + malformed.map({ m -> "\"" + m + "\" (empty value)" }).join(", "));
    return rows.join("\n");
}
