//// `/dashboard` — the author's landing page, behind the layout's gate.

import {page, jhPage, ctxParam, ctxRest, PageContext, Element, ElementBase, section, h1, text} from "jhonstart";

#[page("dashboard")]
pub fn dashboardHome(route: PageContext) -> @Component<Element> {
    return section([h1([text("Your posts", attrs: [])], attrs: [])], attrs: []);
}
