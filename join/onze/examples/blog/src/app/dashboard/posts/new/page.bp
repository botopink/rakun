//// `/dashboard/posts/new` — the new-post page. It checks no session: the
//// dashboard layout is the gate, and `newPostRenders()` counts the renders
//// that reached this function.

import {page, jhPage, ctxParam, ctxRest, PageContext, Element, ElementBase, section, h1, text} from "jhonstart";

#[@External.Node("""((globalThis.__blogNewPost = (globalThis.__blogNewPost || 0) + 1), 0)""")]
#[@External.Erlang("""(fun() -> persistent_term:put(blog_new_post, persistent_term:get(blog_new_post, 0) + 1), 0 end)()""")]
declare fn countRender() -> i32;

#[@External.Node("""(globalThis.__blogNewPost || 0)""")]
#[@External.Erlang("""persistent_term:get(blog_new_post, 0)""")]
declare fn renders() -> i32;

// How many renders reached `newPostPage` since the process started.
pub fn newPostRenders() -> i32 {
    return renders();
}

#[page("dashboard/posts/new")]
pub fn newPostPage(route: PageContext) -> @Component<Element> {
    val counted = countRender();
    return section([h1([text("New post", attrs: [])], attrs: [])], attrs: []);
}
