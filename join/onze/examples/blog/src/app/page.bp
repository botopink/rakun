//// `/` — the hero (front 51's Image, eager) and the latest post.

import {page, layout, jhPage, jhLayout, ctxParam, ctxRest, PageContext, LayoutProps, Element, ElementBase, main, section, article, h1, h2, p, text, notFound} from "jhonstart";
import {Image, ImageProps, defaultImageConfig} from "onze-assets";

#[page("")]
pub fn home(route: PageContext) -> @Component<Element> {
    val hero = ImageProps(src: "/images/hero.jpg", alt: "A notebook on a desk", width: 1200, height: 630, fill: false, sizes: "", priority: true, quality: 80, placeholder: "empty", blurDataURL: "", loading: "");
    return section([h1([text("Notes on building onze", attrs: [])], attrs: []), Image(hero, defaultImageConfig(), "public")], attrs: []);
}
