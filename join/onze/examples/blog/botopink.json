{
  "name": "blog",
  "version": "0.0.1",
  "description": "onze's acceptance app (front 53) — a blog with an author dashboard: every seam of rakun, jhonstart and emilia at once",
  "src": "src/",
  "entry": "root.bp",
  "target": "commonJS",
  "files": [
    "root.bp",
    "lib/mod.bp",
    "lib/db.bp",
    "components/mod.bp",
    "components/nav.bp",
    "components/post_card.bp",
    "components/like_button.bp",
    "app/mod.bp",
    "app/layout.bp",
    "app/page.bp",
    "app/blog/mod.bp",
    "app/blog/layout.bp",
    "app/blog/page.bp",
    "app/dashboard/mod.bp",
    "app/dashboard/layout.bp",
    "app/dashboard/page.bp",
    "app/dashboard/posts/mod.bp",
    "app/dashboard/posts/new/mod.bp",
    "app/dashboard/posts/new/page.bp",
    "app/login/mod.bp",
    "app/login/page.bp"
  ],
  "alias": {
    "@/components": "components",
    "@/lib": "lib"
  },
  "dependencies": {
    "jhonstart": {
      "path": "../../../jhonstart/modules/jhonstart"
    },
    "jhonstart-link": {
      "path": "../../../jhonstart/modules/jhonstart-link"
    },
    "emilia": {
      "path": "../../../emilia/modules/emilia"
    },
    "onze": {
      "workspace": true
    },
    "onze-assets": {
      "workspace": true
    }
  }
}
