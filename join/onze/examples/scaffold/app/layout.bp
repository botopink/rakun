import {layout, jhLayout, LayoutProps, Element, ElementBase, main} from "jhonstart";
import {emilia, Token} from "emilia";

// The root layout: every page renders inside it.
#[layout("")]
pub fn rootLayout(props: LayoutProps) -> @Component<Element> {
    val shell = emilia([.Gap.All.4]);
    return main([props.children], attrs: [#("class", shell)]);
}
